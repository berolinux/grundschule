  Else If _Y < 1024
    OpenW Hidden # 2, Int(xxxxx% / 2) - 577, Int(yyyyy% / 2) - 433, 1154, 866, 0000000000      '  1152x864, Schreiben
    Win_2.AutoRedraw = 1
    OpenW Hidden # 1, Int(xxxxx% / 2) - 577, Int(yyyyy% / 2) - 433, 1154, 866, 0000000000
    Win_1.AutoRedraw = 1
