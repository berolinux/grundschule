  OpenW Full Hidden # 1, , , , , 0000000000
  Win_1.AutoRedraw = 1
Else If _Y / _X < 0.74                                 ' Breitbild
'##B#
  xxxxx% = _X
  yyyyy% = _Y
  OpenW # 3, 0, 0, xxxxx% , yyyyy%, 0000000000      '  Hintergrundfenster
  Win_3.AutoRedraw = 1
  Win_3.Disable
  Output = Win_3
  DefLine 0, 1
  DefFill 0
  RGBColor RGB(30, 0, 0) ' dunkelbraun
  PBox 0, 0, _X, _Y
  If _Y < 600
    OpenW Hidden # 2, Int(xxxxx% / 2) - 321, Int(yyyyy% / 2) - 241, 642, 482, 0000000000      '  640x480, Schreiben
    Win_2.AutoRedraw = 1
    OpenW Hidden # 1, Int(xxxxx% / 2) - 321, Int(yyyyy% / 2) - 241, 642, 482, 0000000000
    Win_1.AutoRedraw = 1
    Set tastatur = LoadPicture("bild\tastatur1.bmp")
  Else If _Y < 768
    OpenW Hidden # 2, Int(xxxxx% / 2) - 401, Int(yyyyy% / 2) - 301, 802, 602, 0000000000      '  800x600, Schreiben
    Win_2.AutoRedraw = 1
    OpenW Hidden # 1, Int(xxxxx% / 2) - 401, Int(yyyyy% / 2) - 301, 802, 602, 0000000000
    Win_1.AutoRedraw = 1
    Set tastatur = LoadPicture("bild\tastatur2.bmp")
  Else If _Y < 864
    OpenW Hidden # 2, Int(xxxxx% / 2) - 513, Int(yyyyy% / 2) - 385, 1026, 770, 0000000000      ' 1024x768, Schreiben
    Win_2.AutoRedraw = 1
    OpenW Hidden # 1, Int(xxxxx% / 2) - 513, Int(yyyyy% / 2) - 385, 1026, 770, 0000000000
    Win_1.AutoRedraw = 1
