'##B#
>Procedure a12  ' Texte
  Color RGB(255, 255, 255) ' weiß
  SetFont schrift0%
  Text (_X - TxtLen(nam$)) / 2, 464 * fy, nam$
  SetFont schrift3%
  DefMouse 0
  If anfang| = 0
    text1$ = "Texte\Text" + Trim$(Str$(schreib|)) + "_" + Trim$(Str$(art| - (schreib| - 1) * 13)) + ".TXT"
    If Exist(text1$) = 0
      Repeat
        PeekEvent
      Until _Mess = 0
      If einzelner| = 1
        alert1("Der Text existiert nicht,", "wähle einen anderen!", "OK")
      Else
        alert1("Der Text existiert nicht,", "wählt einen anderen!", "OK")
      EndIf
      Repeat
        PeekEvent
      Until _Mess = 0
      hauptmenue
    Else
      Open text1$ for Input As # 1
      Line Input # 1, txt$(1)
      iii% = Val(txt$(1))
      For i% = 1 To iii%
        Line Input # 1, txt$(i%)
      Next i%
      Close # 1
      For i% = 1 To iii%
        Repeat
          aa% = InStr(txt$(i%), " " + Chr$(34)) ' Suchen: Leerzeichen+Anführungszeichen
          If aa% > 0
            Mid$(txt$(i%), aa%) = " " + Chr$(132) ' Einsetzen: Leerzeichen+Anführungszeichen unten
          EndIf
        Until aa% <= 0
        Repeat
          aa% = InStr(txt$(i%), Chr$(34)) ' Suchen: Anführungszeichen (ohne Leerzeichen davor)
          If aa% = 1
            Mid$(txt$(i%), aa%) = Chr$(132) ' Einsetzen: Anführungszeichen unten
          Else If aa% > 1
            Mid$(txt$(i%), aa%) = Chr$(147) ' Einsetzen: Anführungszeichen oben
          EndIf
        Until aa% <= 0
      Next i%
    EndIf
    zeile% = iii%
    Repeat
      PeekEvent
    Until _Mess = 0
    If einzelner| = 1
      alert1("Lies den Text genau durch!", "Wenn du fertig bist, drücke die Leertaste!", "OK")
    Else
      alert1("Lest den Text genau durch!", "Wenn ihr fertig seid, drückt die Leertaste!", "OK")
    EndIf
    Repeat
      PeekEvent
    Until _Mess = 0
    textblatt
    lineatur
    GraphMode R2_COPYPEN, TRANSPARENT
    For i% = 1 To Min(zeile%, 16)
      antwy% = i% * Int(zeichenh% * 1.25)
      Color RGB(0, 0, 0) ' schwarz
      Text 42 * fx, antwy% - 3 * fy, txt$(i%)
    Next i%
    If zeile% > 16
      Repeat
        Sleep
        t$ = InKey$
      Until t$ <> ""
      Repeat
        PeekEvent
      Until InKey$ = ""
      Put 0, 0, textbl1$
      lineatur
      For i% = 15 To Min(zeile%, 30)
        antwy% = (i% - 14) * Int(zeichenh% * 1.25)
        Color RGB(0, 0, 0) ' schwarz
        Text 42 * fx, antwy% - 3 * fy, txt$(i%)
      Next i%
      If zeile% > 30
        Repeat
          Sleep
          t$ = InKey$
        Until t$ <> ""
        Repeat
          PeekEvent
        Until InKey$ = ""
        Put 0, 0, textbl1$
        lineatur
        For i% = 29 To Min(zeile%, 44)
          antwy% = (i% - 28) * Int(zeichenh% * 1.25)
          Color RGB(0, 0, 0) ' schwarz
          Text 42 * fx, antwy% - 3 * fy, txt$(i%)
        Next i%
      EndIf
    EndIf
    For i% = 1 To zeile%
      For jjj% = 1 To Len(txt$(i%))
        If Asc(Mid$(txt$(i%), jjj%, 1)) = 32
          Inc wortzahl%
        Else If Asc(Mid$(txt$(i%), jjj%, 1)) = 45 And Asc(Mid$(txt$(i%), jjj% - 1, 1)) = 32
          Dec wortzahl%
        EndIf
      Next jjj%
    Next i%
    Repeat
      Sleep
      t$ = InKey$
    Until t$ <> ""
    Repeat
      PeekEvent
    Until InKey$ = ""
    Add wortzahl%, zeile%
    Color RGB(255, 255, 198) ' creme
    PRBox 17 * fx, 16 * fy, 510 * fx, 464 * fy
    Color RGB(180, 255, 255) ' hell blaugrün
    DefLine 0, 1 * fy
    For jjj% = 0 To 8
      Line 40 * fx, 46 * fy + Int(zeichenh% * 1.25) * jjj%, 500 * fx, 46 * fy + Int(zeichenh% * 1.25) * jjj%
    Next jjj%
    Line 40 * fx, 310 * fy, 500 * fx, 310 * fy
    Line 40 * fx, 383 * fy, 500 * fx, 383 * fy
    Color RGB(255, 0, 0) ' rot
    DefLine 0, 5 * fy
    RBox 32 * fx, 268 * fy, 508 * fx, 323 * fy
    DefLine 0, 1 * fy
    Get 0, 0, 511 * fx, 440 * fy, lin$
    anfang| = 1
  EndIf
  If falsch1| = 0
    Inc nr%
  EndIf
  For i% = 1 To 15
    wort$(i%) = ""
  Next i%
  z_$ = txt$(nr%)
  wort_% = 0            ' Wortzahl einer Zeile
  altj% = 0
  For jjj% = 1 To Len(z_$) + 1
    If Asc(Mid$(z_$, jjj%, 1)) = 32 Or jjj% > Len(z_$)
      Inc wort_%
      wort$(wort_%) = Mid$(z_$, altj% + 1, jjj% - altj% - 1)
      If strich% = 1
        Clr strich%
        wort$(wort_% - 1) = wort$(wort_%)
        Dec wort_%
      EndIf
      altj% = jjj%
      If Asc(Mid$(z_$, jjj% - 1, 1)) = 45 And jjj% <= Len(z_$)
        strich% = 1
      EndIf
    EndIf
  Next jjj%
  saeule
  GraphMode R2_COPYPEN, TRANSPARENT
  For jjj% = 1 To 9
    If nr% - 10 + jjj% > 0
      Color RGB(0, 0, 235) ' blau
      Text 42 * fx, jjj% * Int(zeichenh% * 1.25) - 3 * fy, txt$(nr% - 10 + jjj%)
    EndIf
  Next jjj%
  If gross| = 1 Or fehler_% = 1
    Color RGB(0, 0, 235) ' blau
    Text 42 * fx, 285 * fy, z_$
  Else
    zz_$ = z_$
    Repeat
      PeekEvent
      aa% = InStr(zz_$, "ß")
      If aa% > 1
        zz_$ = Left$(zz_$, aa% - 1) + "ss" + Right$(zz_$, Len(zz_$) - aa%)
      EndIf
    Until aa% < 2
    Color RGB(0, 0, 235) ' blau
    SetFont schrift2%
    Text 42 * fx, 286 * fy, Upper$(zz_$)
    SetFont schrift3%
  EndIf
  beginn| = 1
  antwy% = 360 * fy
Return
