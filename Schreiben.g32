Color RGB(255, 255, 255)   ' weiß
a$ = "Kombipaket Version 8.3, Rudolf Rosenkränzer, 54456 Tawern, Tel. 06501/180202"
Text _X / 2 - TxtLen(a$) / 2, 465 * fy, a$
Clr a$
SetFont schrift1%
Color RGB(0, 0, 235) ' blau
Text 42 * fx, 300 * fy, "Gib bitte deinen Namen ein,"
Text 42 * fx, 320 * fy, "danach       die Fertig-Taste (Return)!"
SetFont schriftw1%
Color RGB(255, 0, 0) ' rot
Text 110 * fx, 320 * fy, "ò"
DefLine 0, 1 * fx
Box 42 * fx, 362 * fy, 56 * fx, 380 * fy
SetFont schrift3%
Repeat
  Repeat
    Sleep
    t$ = InKey$
  Until t$ <> ""
  Exit If t$ = Chr$(13)                  ' Return
  If t$ = Chr$(8) And nam$ <> ""           ' Backspace
    nam$ = Left$(nam$, Len(nam$) - 1)
    Color RGB(255, 255, 198) ' creme
    PBox 40 * fx + TxtLen(nam$), 360 * fy, 79 * fx + TxtLen(nam$), 384 * fy
  EndIf
  If Or(t$ = "ß", t$ = "Ä", t$ = "ä", t$ = "Ö", t$ = "ö", t$ = "Ü", t$ = "ü", t$ = "é", t$ = "è", t$ = "ê", And(Asc(t$) > 31, Asc(t$) < 127, Len(t$) = 1))
    Color RGB(255, 255, 198) ' creme
    Box 42 * fx + TxtLen(nam$), 362 * fy, 56 * fx + TxtLen(nam$), 380 * fy
    nam$ = nam$ + t$
  EndIf
  Repeat
    PeekEvent
    If Left$(nam$) = " "
      nam$ = Right$(nam$, Len(nam$) - 1)
    EndIf
  Until Left$(nam$) <> " "
  Color RGB(0, 0, 0) ' schwarz
  Text 42 * fx, 360 * fy, nam$
  Color RGB(255, 0, 0) ' rot
  Box 42 * fx + TxtLen(nam$), 362 * fy, 56 * fx + TxtLen(nam$), 380 * fy
Until Len(nam$) > 32
If nam$ = ""
  nam$ = "???"
EndIf
Color RGB(255, 255, 198) ' creme
PBox 20 * fx, 300 * fy, 619 * fx, 400 * fy
SetFont schrift6%
Color RGB(255, 0, 0) ' rot
For i% = 1 To Min(22, Len(nam$))
  Text 30 * fx, 245 * fy, Left$(nam$, i%)
  zeit# = oTimer
  Repeat
    PeekEvent
    zeitneu# = oTimer
  Until zeitneu# > zeit# + 180
Next i%
Color RGB(0, 0, 235) ' blau
SetFont schrift4%
If InStr(nam$, " und ") = 0 And InStr(nam$, "+") = 0
  einzelner| = 1
  Text 30 * fx, 320 * fy, "schreibt"
  du$ = "du hast "
Else
  Text 30 * fx, 320 * fy, "schreiben"
  du$ = "ihr habt "
EndIf
ink$ = "immer besser!"
SetFont schrift5%
Color RGB(0, 0, 235) ' blau
j# = 480
For i% = 1 To 13
  Text 30 * fx, 360 * fy, Left$(ink$, i%)
  zeit# = oTimer
  Repeat
    zeitneu# = oTimer
  Until zeitneu# > zeit# + j#
  j# = j# / 1.4
Next i%
Clr ink$
zeit# = oTimer
Repeat
  PeekEvent
  zeitneu# = oTimer
Until zeitneu# > zeit# + 1500
menueaufbau
hauptmenue
>Procedure alert1(al$, al1$, al2$)
  GraphMode R2_COPYPEN, TRANSPARENT
  DefLine 0, fx
  Color RGB(100, 0, 0) ' dunkelbraun
  PBox (319 - 244) * fx, (239 - 64) * fy, (319 + 244) * fx, (239 + 64) * fy
  Color RGB(255, 0, 0) ' rot
  Box (319 - 241) * fx, (239 - 61) * fy, (319 + 241) * fx, (239 + 61) * fy
  Color RGB(255, 255, 198) ' creme
  PBox (319 - 232) * fx, (239 - 52) * fy, (319 + 232) * fx, (239 + 52) * fy
  Color RGB(0, 0, 0) ' schwarz
  SetFont schrift1%
  Text (319 - 220) * fx, (239 - 34) * fy, al$
  Text (319 - 220) * fx, (239 - 14) * fy, al1$
  DefLine 0, 2 * fx
  Color RGB(190, 225, 255) ' hellblau
  PBox (319 - 40) * fx, (239 + 19) * fy, (319 + 40) * fx, (239 + 41) * fy
  Color RGB(100, 0, 0) ' dunkelbraun
  Box (319 - 40) * fx, (239 + 19) * fy, (319 + 40) * fx, (239 + 41) * fy
  DefLine 0, fx
  Stretch (319 + 170) * fx, (239 - 44) * fy, grins, 50 * fx, 56 * fy
  SetFont schrift1%
  Text (319 - 30) * fx, (239 + 19) * fy, al2$
  Clr k%
  Repeat
    PeekEvent
  Until MouseK = 0
  Repeat
    PeekEvent
    Mouse x%, y%, k%
  Until k% = 1 And x% > (319 - 40) * fx And x% < (319 + 40) * fx And y% > (239 + 20) * fy And y% < (239 + 40) * fy
Return
>Procedure alert2(al$, al1$, al2$)
  GraphMode R2_COPYPEN, TRANSPARENT
  DefLine 0, fx
  Color RGB(100, 0, 0) ' dunkelbraun
  PBox (319 - 244) * fx, (239 - 64) * fy, (319 + 244) * fx, (239 + 64) * fy
  Color RGB(255, 0, 0) ' rot
  Box (319 - 241) * fx, (239 - 61) * fy, (319 + 241) * fx, (239 + 61) * fy
  Color RGB(255, 255, 198) ' creme
  PBox (319 - 232) * fx, (239 - 52) * fy, (319 + 232) * fx, (239 + 52) * fy
  Color RGB(0, 0, 0) ' schwarz
  SetFont schrift1%
  Text (319 - 220) * fx, (239 - 24) * fy, al$
  DefLine 0, 2 * fx
  Color RGB(190, 225, 255) ' hellblau
  PBox (319 - 140) * fx, (239 + 19) * fy, (319 - 20) * fx, (239 + 41) * fy
  PBox (319 + 20) * fx, (239 + 19) * fy, (319 + 140) * fx, (239 + 41) * fy
  Color RGB(100, 0, 0) ' dunkelbraun
  Box (319 - 140) * fx, (239 + 19) * fy, (319 - 20) * fx, (239 + 41) * fy
  Box (319 + 20) * fx, (239 + 19) * fy, (319 + 140) * fx, (239 + 41) * fy
  DefLine 0, fx
  Stretch (319 + 170) * fx, (239 - 44) * fy, grins, 50 * fx, 56 * fy
  SetFont schrift1%
  Text (319 - 130) * fx, (239 + 19) * fy, al1$
  Text (319 + 30) * fx, (239 + 19) * fy, al2$
  Repeat
    PeekEvent
  Until MouseK = 0
  Repeat
    PeekEvent
    Mouse x%, y%, k%
  Until k% = 1 And ((x% > (319 - 140) * fx And x% < (319 - 20) * fx) Or (x% > (319 + 20) * fx And x% < (319 + 140) * fx)) And y% > (239 + 20) * fy And y% < (239 + 40) * fy
  If x% < 319 * fx
    alert| = 1
  Else
    alert| = 2
  EndIf
Return
>Procedure schreibblatt
  Color RGB(75, 0, 0)
  PBox 0, 0, _X, _Y
  PaintPicture tastatur, 43 * fx, 27 * fy
  Color RGB(180, 255, 255), RGB(255, 255, 198)
  Fill _X / 2, 223 * fy To RGB(0, 0, 0)
  Color RGB(255, 255, 198) ' creme
  PRBox 3 * fx, 228 * fy, 633 * fx, 475 * fy
  PBox 3 * fx, 228 * fy, 633 * fx, 260 * fy
  Color RGB(0, 0, 235) ' blau
  DefLine 0, 2 * fx
  Line 3 * fx, 227 * fy, 633 * fx, 227 * fy
  Line 3 * fx, 230 * fy, 633 * fx, 230 * fy
  DefLine 0, 12 * fx
  DefFill 42
  Color RGB(255, 0, 0) ' rot
  DefLine 0, 12 * fx
  PRBox 6 * fx, 6 * fy, 633 * fx, 473 * fy
  DefFill 0
  Color RGB(75, 0, 0) ' dunkelbraun
  Fill 3 * fx, 3 * fy To RGB(255, 0, 0)
  Fill 633 * fx, 3 * fy To RGB(255, 0, 0)
  Fill 3 * fx, 470 * fy To RGB(255, 0, 0)
  Fill 633 * fx, 470 * fy To RGB(255, 0, 0)
Return
>Procedure menueaufbau
  DefLine 0, 1 * fx                            ' Aufbau des Hauptmenüs
  Color RGB(75, 0, 0)
  PBox 0, 0, _X, _Y
  Color RGB(255, 255, 198) ' creme
  PBox 4 * fx, 126 * fy, 632 * fx, 364 * fy
  PBox 61 * fx, 51 * fy, 299 * fx, 74 * fy
  PBox 337 * fx, 51 * fy, 577 * fx, 74 * fy
  PBox 61 * fx, 86 * fy, 299 * fx, 109 * fy
  PBox 337 * fx, 86 * fy, 577 * fx, 109 * fy
  Color RGB(255, 0, 0) ' rot
  DefLine 0, 12 * fx
  DefFill 42
  PRBox 6 * fx, 6 * fy, 633 * fx, 473 * fy
  DefFill 0
  DefLine 0, 3 * fx
  RBox 59 * fx, 50 * fy, 301 * fx, 75 * fy
  RBox 335 * fx, 50 * fy, 579 * fx, 75 * fy
  RBox 59 * fx, 85 * fy, 301 * fx, 110 * fy
  RBox 335 * fx, 85 * fy, 579 * fx, 110 * fy
  Line 4 * fx, 125 * fy, 632 * fx, 125 * fy
  Line 4 * fx, 205 * fy, 632 * fx, 205 * fy
  Line 4 * fx, 285 * fy, 632 * fx, 285 * fy
  Line 4 * fx, 365 * fy, 632 * fx, 365 * fy
  Line 318 * fx, 125 * fy, 318 * fx, 365 * fy
  GraphMode R2_COPYPEN, TRANSPARENT
  Color RGB(255, 255, 255) ' weiß
  SetFont schrift0%
  If einzelner| = 1
    Text 60 * fx, 20 * fy, "Hier kannst du auswählen:"
  Else
    Text 60 * fx, 20 * fy, "Hier könnt ihr auswählen:"
  EndIf
  Text (_X - TxtLen(nam$)) / 2, 464 * fy, nam$
  SetFont schrift1%
  Color RGB(0, 0, 235) ' blau
  Text 110 * fx, 52 * fy, "Hilfe: ja"
  Text 381 * fx, 52 * fy, "Hilfe: nein"
  Text 110 * fx, 87 * fy, "normal"
  Text 381 * fx, 87 * fy, "groß"
  SetFont schrift4%
  Text 50 * fx, 145 * fy, "Schreiben  1"
  Text 355 * fx, 145 * fy, "Schreiben  2"
  Text 50 * fx, 225 * fy, "Schreiben  3"
  Text 355 * fx, 225 * fy, "Schreiben  4"
  Text 50 * fx, 305 * fy, "Wortschatz 1"
  Text 355 * fx, 305 * fy, "Wortschatz 2"
  SetFont schriftw3%
  Color RGB(255, 255, 255) ' weiß
  Text 120 * fx, 380 * fy, "8"    ' Maus
  Text 425 * fx, 380 * fy, "7"    ' Tastatur
  SetFont schrift0%
  Text 40 * fx, 380 * fy, "linke Maustaste:"
  Text 40 * fx, 395 * fy, "          Auswahl"
  Text 200 * fx, 380 * fy, "rechte Maustaste:"
  Text 200 * fx, 395 * fy, "weiter"
  Text 356 * fx, 380 * fy, "Taste F1:"
  Text 356 * fx, 395 * fy, "Hilfe: ja/nein"
  Text 480 * fx, 380 * fy, "Taste F8: Ende"
  Color RGB(255, 0, 0) ' rot
  PBox 441 * fx, 420 * fy, 446 * fx, 425 * fy
  PBox 480 * fx, 420 * fy, 485 * fx, 425 * fy
  SetFont schriftw2%
  Text 435 * fx, 393 * fy, "ò"
  Text 474 * fx, 393 * fy, "ò"
  Text 160 * fx, 381 * fy, "òò"
Return
>Procedure textblatt
  Color RGB(75, 0, 0)
  PBox 0, 0, _X, _Y
  Color RGB(255, 255, 198) ' creme
  PRBox 7 * fx, 7 * fy, 632 * fx, 473 * fy
  DefLine 0, 12 * fx
  DefFill 42
  Color RGB(255, 0, 0) ' rot
  PRBox 6 * fx, 6 * fy, 633 * fx, 473 * fy
  DefFill 0
Return
>Procedure menue                        ' Abfrage des Hauptmenüs
  Output = Win_2
  menueaufbau
  Get 0, 0, _X, _Y, fenster$
  Output = Win_1
  Put 0, 0, fenster$
  Clr fenster$
  DefLine 0, 1
  DefMouse 0
  GraphMode R2_COPYPEN, OPAQUE
  Do
    Repeat
      Sleep
      Mouse x%, y%, k%
      t$ = InKey$
    Until k% <> 0 Or (Len(t$) > 1 And Asc(Right$(t$)) = 119) Or Upper$(t$) = "S" Or Upper$(t$) = "T"
    Exit If k% = 2
    If Upper$(t$) = "S"
      Clr k%
      speichern| = 1
      GraphMode R2_COPYPEN, TRANSPARENT
      Color RGB(255, 255, 255) ' weiß
      SetFont schrift0%
      Text 240 * fx, 440 * fy, "Ergebnis speichern"
      GraphMode R2_COPYPEN, OPAQUE
    Else If Upper$(t$) = "T" And schreib| < 5
      If textbl% = 0
        textbl% = 1
        textblatt
        Get 0, 0, 511 * fx, 440 * fy, textbl1$
      Else
        textblatt
      EndIf
      texteingabe
    Else If Len(t$) > 1 And Asc(Right$(t$)) = 119  ' F8
      Color RGB(0, 0, 0) ' schwarz
      Repeat
        PeekEvent
      Until _Mess = 0
      DefMouse 0
      If einzelner| = 1
        alert2("Willst du wirklich aufhören?", "Ende", "zurück")
      Else
        alert2("Wollt ihr wirklich aufhören?", "Ende", "zurück")
      EndIf
      If alert| = 1
        ende
      EndIf
      hauptmenue
    EndIf
    Repeat
      PeekEvent
    Until MouseK = 0
    xx% = x% / fx
    yy% = y% / fy
    DefFill 0
    GraphMode R2_COPYPEN, TRANSPARENT
    If yy% < 109 And yy% > 86 Or yy% < 74 And yy% > 51
      SetFont schrift1%
      If yy% < 74 And yy% > 51               ' Hilfe
        Select xx%
        Case 60 To 300
          Select hilfe|
          Case 0
            Color RGB(0, 0, 235) ' blau
            PBox 60 * fx, 52 * fy, 299 * fx, 73 * fy
            Color RGB(255, 255, 198) ' creme
            Text 110 * fx, 52 * fy, "Hilfe: ja"
            hilfe| = 2
            hilferuf| = 1
          Case 1
            Color RGB(0, 0, 235) ' blau
            PBox 60 * fx, 52 * fy, 299 * fx, 73 * fy
            Color RGB(255, 255, 198) ' creme
            Text 110 * fx, 52 * fy, "Hilfe: ja"
            PBox 337 * fx, 52 * fy, 577 * fx, 73 * fy
            Color RGB(0, 0, 235) ' blau
            Text 381 * fx, 52 * fy, "Hilfe: nein"
            hilfe| = 2
            hilferuf| = 1
          EndSelect
        Case 336 To 578
          Select hilfe|
          Case 0
            Color RGB(0, 0, 235) ' blau
            PBox 337 * fx, 52 * fy, 577 * fx, 73 * fy
            Color RGB(255, 255, 198) ' creme
            Text 381 * fx, 52 * fy, "Hilfe: nein"
            hilfe| = 1
          Case 2
            Color RGB(255, 255, 198) ' creme
            PBox 60 * fx, 52 * fy, 299 * fx, 73 * fy
            Color RGB(0, 0, 235) ' blau
            Text 110 * fx, 52 * fy, "Hilfe: ja"
            PBox 337 * fx, 52 * fy, 577 * fx, 73 * fy
            Color RGB(255, 255, 198) ' creme
            Text 381 * fx, 52 * fy, "Hilfe: nein"
            hilfe| = 1
          EndSelect
        Default
          GoTo falsch
        EndSelect
      EndIf
      If yy% < 109 And yy% > 86              ' normal / groß
        Select xx%
        Case 60 To 300
          Select gross|
          Case 0
            Color RGB(0, 0, 235) ' blau
            PBox 60 * fx, 87 * fy, 299 * fx, 108 * fy
            Color RGB(255, 255, 198) ' creme
            Text 110 * fx, 87 * fy, "normal"
            gross| = 1
          Case 2
            Color RGB(0, 0, 235) ' blau
            PBox 60 * fx, 87 * fy, 299 * fx, 108 * fy
            Color RGB(255, 255, 198) ' creme
            Text 110 * fx, 87 * fy, "normal"
            PBox 337 * fx, 87 * fy, 577 * fx, 108 * fy
            Color RGB(0, 0, 235) ' blau
            Text 381 * fx, 87 * fy, "groß"
            gross| = 1
          EndSelect
        Case 336 To 578
          Select gross|
          Case 0
            Color RGB(0, 0, 235) ' blau
            PBox 337 * fx, 87 * fy, 577 * fx, 108 * fy
            Color RGB(255, 255, 198) ' creme
            Text 381 * fx, 87 * fy, "groß"
            gross| = 2
          Case 1
            Color RGB(255, 255, 198) ' creme
            PBox 60 * fx, 87 * fy, 299 * fx, 108 * fy
            Color RGB(0, 0, 235) ' blau
            Text 110 * fx, 87 * fy, "normal"
            PBox 337 * fx, 87 * fy, 577 * fx, 108 * fy
            Color RGB(255, 255, 198) ' creme
            Text 381 * fx, 87 * fy, "groß"
            gross| = 2
          EndSelect
        Default
          GoTo falsch
        EndSelect
      EndIf
    EndIf
    If yy% < 365 And yy% > 125
      If yy% < 205
        Clr schreibalt|
        Select xx%
        Case 5 To 317
          Select schreib|
          Case 2, 3, 4, 5, 6
            schreibalt| = schreib|
            schreib| = 1
          Case 1
            schreibalt| = 1
          Case 0
            schreib| = 1
          EndSelect
        Case 319 To 631
          Select schreib|
          Case 1, 3, 4, 5, 6
            schreibalt| = schreib|
            schreib| = 2
          Case 2
            schreibalt| = 2
          Case 0
            schreib| = 2
          EndSelect
        Default
          GoTo falsch
        EndSelect
      Else If yy% < 285
        Clr schreibalt|
        Select xx%
        Case 5 To 317
          Select schreib|
          Case 1, 2, 4, 5, 6
            schreibalt| = schreib|
            schreib| = 3
          Case 3
            schreibalt| = 3
          Case 0
            schreib| = 3
          EndSelect
        Case 319 To 631
          Select schreib|
          Case 1, 2, 3, 5, 6
            schreibalt| = schreib|
            schreib| = 4
          Case 4
            schreibalt| = 4
          Case 0
            schreib| = 4
          EndSelect
        Default
          GoTo falsch
        EndSelect
      Else If yy% < 365
        Clr schreibalt|
        Select xx%
        Case 5 To 317
          Select schreib|
          Case 1, 2, 3, 4, 6
            schreibalt| = schreib|
            schreib| = 5
          Case 5
            schreibalt| = 5
          Case 0
            schreib| = 5
          EndSelect
        Case 319 To 631
          Select schreib|
          Case 1, 2, 3, 4, 5
            schreibalt| = schreib|
            schreib| = 6
          Case 6
            schreibalt| = 6
          Case 0
            schreib| = 6
          EndSelect
        Default
          GoTo falsch
        EndSelect
      EndIf
      SetFont schrift4%
      Color RGB(255, 255, 198) ' creme
      Select schreibalt|
      Case 1
        PBox 12 * fx, 127 * fy, 316 * fx, 203 * fy
        Color RGB(0, 0, 235) ' blau
        Text 50 * fx, 145 * fy, "Schreiben  1"
      Case 2
        PBox 320 * fx, 127 * fy, Ceil(626 * fx), 203 * fy
        Color RGB(0, 0, 235) ' blau
        Text 355 * fx, 145 * fy, "Schreiben  2"
      Case 3
        PBox 12 * fx, 207 * fy, 316 * fx, 283 * fy
        Color RGB(0, 0, 235) ' blau
        Text 50 * fx, 225 * fy, "Schreiben  3"
      Case 4
        PBox 320 * fx, 207 * fy, Ceil(626 * fx), 283 * fy
        Color RGB(0, 0, 235) ' blau
        Text 355 * fx, 225 * fy, "Schreiben  4"
      Case 5
        PBox 12 * fx, 287 * fy, 316 * fx, 363 * fy
        Color RGB(0, 0, 235) ' blau
        Text 50 * fx, 305 * fy, "Wortschatz 1"
      Case 6
        PBox 320 * fx, 287 * fy, Ceil(626 * fx), 363 * fy
        Color RGB(0, 0, 235) ' blau
        Text 355 * fx, 305 * fy, "Wortschatz 2"
      EndSelect
      Color RGB(0, 0, 235) ' blau
      Select schreib|
      Case 1
        PBox 12 * fx, 127 * fy, 316 * fx, 203 * fy
        Color RGB(255, 255, 198) ' creme
        Text 50 * fx, 145 * fy, "Schreiben  1"
      Case 2
        PBox 320 * fx, 127 * fy, Ceil(626 * fx), 203 * fy
        Color RGB(255, 255, 198) ' creme
        Text 355 * fx, 145 * fy, "Schreiben  2"
      Case 3
        PBox 12 * fx, 207 * fy, 316 * fx, 283 * fy
        Color RGB(255, 255, 198) ' creme
        Text 50 * fx, 225 * fy, "Schreiben  3"
      Case 4
        PBox 320 * fx, 207 * fy, Ceil(626 * fx), 283 * fy
        Color RGB(255, 255, 198) ' creme
        Text 355 * fx, 225 * fy, "Schreiben  4"
      Case 5
        PBox 12 * fx, 287 * fy, 316 * fx, 363 * fy
        Color RGB(255, 255, 198) ' creme
        Text 50 * fx, 305 * fy, "Wortschatz 1"
      Case 6
        PBox 320 * fx, 287 * fy, Ceil(626 * fx), 363 * fy
        Color RGB(255, 255, 198) ' creme
        Text 355 * fx, 305 * fy, "Wortschatz 2"
      EndSelect
    EndIf
    falsch:
  Loop Until k% = 2
  If schreib| = 0
    schreib| = 1
  EndIf
  If hilfe| = 0
    hilfe| = 1
  EndIf
  If gross| = 0
    gross| = 1
  EndIf
  DefMouse V:aaa%(0)        ' transparente Mausform
Return
>Procedure menue0                       ' Aufbau: weitere Menüs
  Output = Win_2
  If menue0% = 0
    menue0% = 1
    menue0aufbau
  Else
    menue0aufbau
  EndIf
  Get 0, 0, _X, _Y, fenster$
  Output = Win_1
  Put 0, 0, fenster$
  Clr fenster$
Return
>Procedure menue0aufbau
  GraphMode R2_COPYPEN, TRANSPARENT
  Color RGB(75, 0, 0)
  PBox 0, 0, _X, _Y
  DefLine 0, 1 * fx
  Color RGB(100, 0, 0) ' dunkelbraun
  PRBox 3 * fx, 3 * fy, 633 * fx, 475 * fy
  Color RGB(255, 255, 198) ' creme
  PBox 4 * fx, 77 * fy, 632 * fx, 413 * fy
  Color RGB(255, 0, 0) ' rot
  DefLine 0, 12 * fx
  DefFill 42
  PRBox 6 * fx, 6 * fy, 633 * fx, 473 * fy
  DefFill 0
  DefLine 0, 3 * fx
  GraphMode R2_COPYPEN, TRANSPARENT
  Color RGB(255, 255, 255) ' weiß
  SetFont schrift0%
  Text (_X - TxtLen(nam$)) / 2, 464 * fy, nam$
  If einzelner| = 1
    Text 60 * fx, 20 * fy, "Hier kannst du auswählen:"
  Else
    Text 60 * fx, 20 * fy, "Hier könnt ihr auswählen:"
  EndIf
  Color RGB(255, 255, 198) ' creme
  PRBox 562 * fx, 23 * fy, 600 * fx, 68 * fy        ' Box für Kennzeichnung des Menüs
  Color RGB(255, 0, 0) ' rot
  RBox 560 * fx, 21 * fy, 602 * fx, 70 * fy
  DefLine 0, 2 * fx
  SetFont schrift3%
  jjj% = 1
  For i% = 54 To 408 Step 26
    Color RGB(255, 0, 0) ' rot
    Line 6 * fx, i% * fy + 22 * fy, 631 * fx, i% * fy + 22 * fy
    Color RGB(0, 0, 0) ' schwarz
    If jjj% > 1
      Text 45 * fx - TxtLen(Trim$(Str$(jjj% - 1))), i% * fy - 2 * fy, Trim$(Str$(jjj% - 1)) + "."
    EndIf
    Inc jjj%
  Next i%
  Clr jjj%
Return
>Procedure menue1
  GraphMode R2_COPYPEN, TRANSPARENT
  DefLine 0, 1 * fy
  Color RGB(0, 0, 0) ' schwarz
  SetFont schrift6%
  Text 568 * fx, 15 * fy, "1"
  Color RGB(255, 255, 255) ' weiß
  SetFont schrift0%
  If einzelner| = 1
    Text 60 * fx, 20 * fy, "Hier kannst du auswählen:"
  Else
    Text 60 * fx, 20 * fy, "Hier könnt ihr auswählen:"
  EndIf
  Text 230 * fx - TxtLen("linke Maustaste:"), 425 * fy, "linke Maustaste:"
  Text 230 * fx - TxtLen("rechte Maustaste:"), 440 * fy, "rechte Maustaste:"
  Text 240 * fx, 425 * fy, "Auswahl"
  Text 240 * fx, 440 * fy, "weiter"
  Color RGB(0, 0, 235) ' blau
  SetFont schrift3%
  Text 116 * fx, 78 * fy, "Tasten finden"                          ' 1.
