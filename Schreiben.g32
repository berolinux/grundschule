>Procedure menueabfrage
  Repeat
    PeekEvent
  Until MouseK = 0
  DefMouse 0
  Do
    Repeat
      Sleep
      Mouse x%, y%, k%
      t$ = InKey$
    Until (Len(t$) > 1 And Asc(Right$(t$)) = 119) Or k% > 0
    Repeat
      PeekEvent
    Until InKey$ = ""
    If Len(t$) > 1 And Asc(Right$(t$)) = 119
      hauptmenue
    EndIf
    xx% = x% / fx
    yy% = y% / fy
    Repeat
      PeekEvent
    Until MouseK = 0
    Exit If k% = 2
    Select yy%
    Case 77 To 415
      DefLine 0, 1
      For i% = 51 To 408 Step 26
        If yy% > i% And yy% < i% + 26
          SetFont schrift3%
          art| = i% / 26 - 2
          If altart| > 0
            Color RGB(255, 255, 198) ' creme
            PBox 12 * fx, 51 * fy + altart| * 26 * fy, Ceil(626 * fx), Ceil(74 * fy) + altart| * 26 * fy
            Color RGB(0, 0, 0)  'schwarz
            Text 45 * fx - TxtLen(Trim$(Str$(altart|))), 52 * fy + altart| * 26 * fy, Trim$(Str$(altart|)) + "."
            Color RGB(0, 0, 235) ' blau
            inv| = altart|
            Select schreib|
            Case 1
              invert1
            Case 2
              invert2
            Case 3
              invert3
            Case 4
              invert4
            Case 5
              invert5
            Case 6
              invert6
            EndSelect
          EndIf
          Color RGB(0, 0, 235) ' blau
          PBox 12 * fx, 51 * fy + art| * 26 * fy, Ceil(626 * fx), Ceil(74 * fy) + art| * 26 * fy
          Color RGB(255, 255, 198) ' creme
          Text 45 * fx - TxtLen(Trim$(Str$(art|))), 52 * fy + art| * 26 * fy, Trim$(Str$(art|)) + "."
          inv| = art|
          Select schreib|
          Case 1
            invert1
          Case 2
            invert2
          Case 3
            invert3
          Case 4
            invert4
          Case 5
            invert5
          Case 6
            invert6
          EndSelect
          Clr inv|
          altart| = art|
        EndIf
      Next i%
    EndSelect
    falsch3:
  Loop
  If art| = 0
    Inc art|
  EndIf
  If schreib| = 2
    Add art|, 13
  EndIf
  If schreib| = 3
    Add art|, 26
  EndIf
  If schreib| = 4
    Add art|, 39
  EndIf
  If schreib| = 5
    Add art|, 52
  EndIf
  If schreib| = 6
    Add art|, 65
  EndIf
  If (art| < 12 Or (Mod(art|, 13) < 6 And Mod(art|, 13) > 0)) And schreib| < 5
    Clr a12|
    schreibblatt
  Else If schreib| < 5
    a12| = 1
    If textbl% = 0
      textblatt
      Get 0, 0, 511 * fx, 440 * fy, textbl1$
      textbl% = 1
    Else
      textblatt
    EndIf
  Else
    Clr a12|
    If art| < 77
      Repeat
        PeekEvent
      Until _Mess = 0
      GraphMode R2_COPYPEN, TRANSPARENT
      DefLine 0, fx
      Color RGB(100, 0, 0) ' dunkelbraun
      PBox (319 - 244) * fx, (239 - 64) * fy, (319 + 244) * fx, (239 + 64) * fy
      Color RGB(255, 0, 0) ' rot
      Box (319 - 241) * fx, (239 - 61) * fy, (319 + 241) * fx, (239 + 61) * fy
      Color RGB(255, 255, 198) ' creme
      PBox (319 - 232) * fx, (239 - 52) * fy, (319 + 232) * fx, (239 + 52) * fy
      Color RGB(0, 0, 0) ' schwarz
      SetFont schrift1%
      If einzelner| = 1
        Text (319 - 210) * fx, (239 - 34) * fy, "Willst du Wörter ordnen (Alphabet oder  "
        Text (319 - 210) * fx, (239 - 14) * fy, "Wortarten) oder willst du abschreiben?"
      Else
        Text (319 - 210) * fx, (239 - 34) * fy, "Wollt ihr Wörter ordnen (Alphabet oder  "
        Text (319 - 210) * fx, (239 - 14) * fy, "Wortarten) oder wollt ihr abschreiben?"
      EndIf
      DefLine 0, 2 * fx
      Color RGB(190, 225, 255) ' hellblau
      PBox (319 - 170) * fx, (239 + 19) * fy, (319 - 70) * fx, (239 + 41) * fy
      PBox (319 - 50) * fx, (239 + 19) * fy, (319 + 50) * fx, (239 + 41) * fy
      PBox (319 + 70) * fx, (239 + 19) * fy, (319 + 170) * fx, (239 + 41) * fy
      Color RGB(100, 0, 0) ' dunkelbraun
      Box (319 - 170) * fx, (239 + 19) * fy, (319 - 70) * fx, (239 + 41) * fy
      Box (319 - 50) * fx, (239 + 19) * fy, (319 + 50) * fx, (239 + 41) * fy
      Box (319 + 70) * fx, (239 + 19) * fy, (319 + 170) * fx, (239 + 41) * fy
      DefLine 0, fx
      Stretch (319 + 170) * fx, (239 - 44) * fy, grins, 50 * fx, 56 * fy
      SetFont schrift1%
      Text (319 - 160) * fx, (239 + 19) * fy, "Alphabet"
      Text (319 - 40) * fx, (239 + 19) * fy, "Wortart"
      Text (319 + 80) * fx, (239 + 19) * fy, "schreiben"
      Clr k%
      Repeat
        PeekEvent
      Until MouseK = 0
      Repeat
        PeekEvent
        Mouse x%, y%, k%
      Until k% = 1 And ((x% > (319 - 170) * fx And x% < (319 - 70) * fx) Or (x% > (319 - 50) * fx And x% < (319 + 50) * fx) Or (x% > (319 + 70) * fx And x% < (319 + 170) * fx)) And y% > (239 + 20) * fy And y% < (239 + 40) * fy
      If x% < (319 - 70) * fx
        alph% = 1
      Else If x% < (319 + 50) * fx
        alph% = 2
      Else
        alph% = 3
      EndIf
      Repeat
        PeekEvent
      Until _Mess = 0
    EndIf
    If textbl% = 0
      textbl% = 1
      textblatt
      Get 0, 0, 511 * fx, 440 * fy, textbl1$
    Else
      textblatt
    EndIf
    lineatur5
  EndIf
  DefMouse V:aaa%(0)        ' transparente Mausform
Return
>Procedure invert1
