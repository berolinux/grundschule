>Procedure hauptmenue
  Clr a1%, a12|, alph%, altart|, altposx%, altposy%, altrichtig%, anfang|, antw$, antwort$
  Clr anzahl%, art|, beginn|, beginn1|, drucken|, e$, ende|, faktor%, falsch%, falsch1|
  Clr fehler_%, fehlersumme%, gross|, hilfe|, hilferuf|, iii%, inv|, ix%, nr%, pfeilw%, pos%
  Clr print|, richtig, richtig1%, schreib|, schreibalt|, start|, stelle%, texteing%, tt$
  Clr wortzahl%, wort_%, wort1%, x%, x_$, zeile%
  For i% = 1 To 95
    PeekEvent
    txt$(i%) = ""
  Next i%
  For i% = 1 To 15
    PeekEvent
    fehler$(i%) = ""
  Next i%
  GraphMode R2_COPYPEN, OPAQUE
  menue
  menue0
  Select schreib|
  Case 1
    menue1
  Case 2
    menue2
  Case 3
    menue3
  Case 4
    menue4
  Case 5
    menue5
  Case 6
    menue6
  EndSelect
  menueabfrage
  zeit# = oTimer
  If a12| = 0
    Stretch 536 * fx, 248 * fy, grins, 50 * fx, 56 * fy
  EndIf
  neu:
  Color RGB(0, 0, 0) ' schwarz
  SetFont schrift3%
  GraphMode R2_COPYPEN, TRANSPARENT
  If a12| = 0 And schreib| < 5 And art| <> 1
    DefLine 0, 1
    Color RGB(180, 255, 255) ' hell blaugrün
    Line 40 * fx, 325 * fy, 500 * fx, 325 * fy
    Line 40 * fx, 362 * fy, 500 * fx, 362 * fy
  EndIf
  If art| < 53
    Select art|
    Case 1
      a1
    Case 2
      a2
    Case 3
      a3
    Case 4
      a4
    Case 5
      a5
    Case 6
      a6
    Case 7
      a7
    Case 8
      a8
    Case 9
      a9
    Case 10
      a10
    Case 11
      a11
    Case 12, 13, 19, 20, 21, 22, 23, 24, 25, 26, 32, 33, 34, 35, 36, 37, 38, 39, 45, 46, 47, 48, 49, 50, 51, 52
      a12
    Case 14
      a14
    Case 15
      a15
    Case 16
      a16
    Case 17
      a17
    Case 18
      a18
    Case 27
      a27
    Case 28
      a28
    Case 29
      a29
    Case 30
      a30
    Case 31
      a31
    Case 40
      a40
    Case 41
      a41
    Case 42
      a42
    Case 43
      a43
    Case 44
      a44
    EndSelect
    If start| = 0
      DefMouse 0
      Repeat
        PeekEvent
      Until _Mess = 0
      If gross| = 2 And art| > 7
        Get (319 - 245) * fx, (239 - 65) * fy, (319 + 245) * fx, (239 + 65) * fy, alertf$
        alert1("Achtung!", "Ein 'ß' wird in Großbuchstaben zu 'SS'.", "OK")
        Put (319 - 245) * fx, (239 - 65) * fy, alertf$
        Clr alertf$
      EndIf
      DefMouse V:aaa%(0)        ' transparente Mausform
      start| = 1
    EndIf
  Else If art| < 77
    If start| = 0
      DefMouse 0
      Repeat
        PeekEvent
      Until _Mess = 0
      If gross| = 2 And art| > 7
        Get (319 - 245) * fx, (239 - 65) * fy, (319 + 245) * fx, (239 + 65) * fy, alertf$
        alert1("Achtung!", "Ein 'ß' wird in Großbuchstaben zu 'SS'.", "OK")
        Put (319 - 245) * fx, (239 - 65) * fy, alertf$
        Clr alertf$
      EndIf
      Repeat
        PeekEvent
      Until _Mess = 0
      DefMouse V:aaa%(0)        ' transparente Mausform
      start| = 1
    EndIf
    wortschatz
  Else
    If start| = 0
      DefMouse 0
      Repeat
        PeekEvent
      Until _Mess = 0
      If gross| = 2 And art| > 7
        Get (319 - 245) * fx, (239 - 65) * fy, (319 + 245) * fx, (239 + 65) * fy, alertf$
        alert1("Achtung!", "Ein 'ß' wird in Großbuchstaben zu 'SS'.", "OK")
        Put (319 - 245) * fx, (239 - 65) * fy, alertf$
        Clr alertf$
      EndIf
      Repeat
        PeekEvent
      Until _Mess = 0
      DefMouse V:aaa%(0)        ' transparente Mausform
      start| = 1
    EndIf
    beugung
  EndIf
  If a12| = 0
    antwy% = 340 * fy
  EndIf
  If schreib| < 5
    input1
  Else
    input2
  EndIf
  kontrolle
  If ende| = 0
    GoTo neu
  EndIf
Return
>Procedure saeule
  If a12| = 0 And schreib| < 5 And a1% = 0
    Put 0, 0, schreibblatt1$
    Color RGB(180, 255, 255) ' hell blaugrün
    DefLine 0, 1
    Line 40 * fx, 325 * fy, 500 * fx, 325 * fy
    Line 40 * fx, 362 * fy, 500 * fx, 362 * fy
  Else If schreib| < 5
    Put 0, 0, lin$
  EndIf
  If fehler_% = 1
    If art| = 53 And wahl% < 9
      Stretch 536 * fx, 248 * fy, heul, 50 * fx, 56 * fy
    Else
      Stretch 536 * fx, 248 * fy, heul, 50 * fx, 56 * fy
    EndIf
  Else
    If art| = 53 And wahl% < 9
      Stretch 536 * fx, 248 * fy, grins, 50 * fx, 56 * fy
    Else
      Stretch 536 * fx, 248 * fy, grins, 50 * fx, 56 * fy
    EndIf
  EndIf
  GraphMode R2_COPYPEN, TRANSPARENT
  Color RGB(255, 255, 255) ' weiß
  SetFont schrift0%
  Text (_X - TxtLen(nam$)) / 2, 464 * fy, nam$
  SetFont schrift3%
  If richtig1% > 0
    If altrichtig% = 0
      altrichtig% = 468 * fy
    EndIf
    Color RGB(0, 0, 235) ' blau
    PBox 570 * fx, altrichtig%, 611 * fx, 462 * fy - richtig# * 3 * fy
    altrichtig% = 468 * fy - richtig# * 3 * fy
    If richtig# >= 13
      Stretch 570 * fx, 429 * fy, katze, 41 * fx, 33 * fy
    EndIf
    If richtig# >= 26
      Stretch 570 * fx, 391 * fy, elefant, 41 * fx, 33 * fy
    EndIf
    If richtig# >= 39
      Stretch 570 * fx, 353 * fy, hase, 41 * fx, 33 * fy
    EndIf
    If richtig# >= 51.9
      Stretch 570 * fx, 315 * fy, blume, 41 * fx, 33 * fy
    EndIf
  EndIf
  If falsch% > 0
    Color RGB(160, 160, 160)
    PBox 512 * fx, 468 * fy, 552 * fx, 462 * fy - falsch% * 3 * fy
  EndIf
Return
>Procedure kontrolle
  If ende| = 1
    GoTo ende
  EndIf
  If antwort$ = z_$ And z_$ <> ""
    If art| < 8
      Inc richtig1%
      richtig# = richtig1%
    Else
      Add richtig1%, wort_%               ' Wortanzahl einer Zeile
      richtig# = Int(richtig1% / wortzahl% * 52)
    EndIf
    Clr fehler_%
    Clr falsch1|
  Else If z_$ <> ""
    fehler_% = 1
    Inc falsch%
    Inc falsch1|
    Inc fehlersumme%
    If fehlersumme% < 16                 ' Zahl der Fehler, die zusätzlich geübt werden können
      For i% = 1 To fehlersumme%
        If wort$(wort1%) = fehler$(i%)   ' kein doppeltes Üben falscher Wörter
          Dec fehlersumme%
          Exit If wort$(wort1%) = fehler$(i%)
        Else If i% = fehlersumme%
          Inc wortzahl%
          fehler$(fehlersumme%) = wort$(wort1%)
          txt$(zeile% + fehlersumme%) = wort$(wort1%)
        EndIf
      Next i%
    EndIf
  EndIf
  saeule
  schluss:
  If nr% = zeile% And nr% > 0 And fehlersumme% > 0 And z_$ = antwort$ And schreib| < 5
    Color RGB(255, 255, 198) ' creme
    PBox 25 * fx, 240 * fy, 511 * fx, 425 * fy
    Color RGB(0, 0, 0) ' schwarz
    SetFont schrift1%
    Text 42 * fx, 375 * fy, "Übe bitte weiter!"
    Text 42 * fx, 400 * fy, "ja:       j   ***   nein:       Taste F8"
    Color RGB(255, 0, 0) ' rot
    SetFont schriftw1%
    Text 72 * fx, 401 * fy, "ò      ò"
    SetFont schrift1%
    Repeat
      Sleep
      s$ = InKey$
    Until s$ = "j" Or s$ = "J" Or (Len(s$) = 2 And Asc(Right$(s$)) = 119)
    Repeat
      PeekEvent
    Until InKey$ = ""
    If s$ <> "j" And s$ <> "J"
      Clr s$
      GoTo ende
    EndIf
    Clr s$
    Color RGB(255, 255, 198) ' creme
    PBox 25 * fx, 370 * fy, 350 * fx, 430 * fy
    Color RGB(0, 0, 235) ' blau
  EndIf
  If richtig# > 51.8 Or falsch% > 51 Or ende| = 1 Or (nr% = zeile% + fehlersumme% And art| > 7 And falsch1| = 0)
    ende:
    If zeit# = 0
      ende
    Else
      zeitneu# = oTimer
      sekunden% = Div((zeitneu# - zeit#), 1000)
      zeitm% = Div(sekunden%, 60)
      zeits% = sekunden% - zeitm% * 60
      Clr ende|
      Color RGB(255, 255, 198) ' creme
      If a12| = 1
        PBox 27 * fx, 256 * fy, 511 * fx, 430 * fy
      Else If schreib| > 4
        PBox 40 * fx, 232 * fy, 511 * fx, 441 * fy
      Else
        PBox 27 * fx, 240 * fy, 511 * fx, 425 * fy
      EndIf
      If falsch% + richtig1% > 0
        Color RGB(0, 0, 0) ' schwarz
        SetFont schrift1%
        If art| < 8
          If falsch% + richtig1% = 1 And richtig1% = 1
            Text 42 * fx, 300 * fy, Min(nam$, Left$(nam$, 25)) + ", " + du$ + "eine Aufgabe"
          Else If falsch% + richtig1% = 1 And richtig1% = 0
            Text 42 * fx, 300 * fy, Min(nam$, Left$(nam$, 25)) + ", " + du$ + "keine Aufgabe"
          Else
            Text 42 * fx, 300 * fy, Min(nam$, Left$(nam$, 25)) + ", " + du$ + Trim$(Str$(richtig1%)) + " von " + Trim$(Str$(falsch% + richtig1%)) + " Aufgaben"
          EndIf
          Text 42 * fx, 325 * fy, "in " + Trim$(Str$(zeitm%)) + " min und " + Trim$(Str$(zeits%)) + " s gelöst!"
        Else
          If richtig1% = 1
            Text 42 * fx, 275 * fy, Min(nam$, Left$(nam$, 25)) + ", " + du$ + "eines von " + Trim$(Str$(wortzahl%)) + " Wörtern"
          Else If richtig1% = 0
            Text 42 * fx, 275 * fy, Min(nam$, Left$(nam$, 25)) + ", " + du$ + "keines von " + Trim$(Str$(wortzahl%)) + " Wörtern"
          Else
            Text 42 * fx, 275 * fy, Min(nam$, Left$(nam$, 25)) + ", " + du$ + Trim$(Str$(richtig1%)) + " von " + Trim$(Str$(wortzahl%)) + " Wörtern"
          EndIf
          Text 42 * fx, 300 * fy, "richtig geschrieben und dabei " + Trim$(Str$(falsch%)) + " Fehler gemacht."
          If einzelner| = 1
            Text 42 * fx, 325 * fy, "Deine Zeit: " + Trim$(Str$(zeitm%)) + " min und " + Trim$(Str$(zeits%)) + " s"
          Else
            Text 42 * fx, 325 * fy, "Eure Zeit: " + Trim$(Str$(zeitm%)) + " min und " + Trim$(Str$(zeits%)) + " s"
          EndIf
        EndIf
        Text 42 * fx, 375 * fy, "Ergebnis ausdrucken?"
        Text 42 * fx, 400 * fy, "ja:       j   ***   nein:       Taste F8"
        Color RGB(255, 0, 0) ' rot
        SetFont schriftw1%
        Text 72 * fx, 401 * fy, "ò      ò"
        SetFont schrift1%
        Repeat
          Sleep
          t$ = InKey$
        Until t$ = "j" Or t$ = "J" Or (Len(t$) = 2 And Asc(Right$(t$)) = 119) ' F8
        Repeat
          PeekEvent
        Until InKey$ = ""
        If t$ = "j" Or t$ = "J"                 ' Ergebnis ausdrucken
          druckeinrichtung
          If print| = 1  ' Drucker angeschaltet
            Output = Printer
            Repeat
              PeekEvent
            Until _Mess = 0
            Clr t$
            a$ = Trim$(Str$(Mod(art|, 13)))
            If a$ = "0"
              a$ = "13"
            EndIf
            If schreib| < 3
              SetFont schriftdr1%
              zeilenh2% = zeilenh1%
            Else
              SetFont schriftdr2%
              zeilenh2% = zeilenh2%
            EndIf
            Text zeilenh1% * 2, seite%, nam$ + ",  " + Date$ + ",  " + Time$
            Add seite%, zeilenh2%
            If art| < 8
              If richtig1% + falsch% = 1 And richtig1% = 1
                Text zeilenh1% * 2, seite%, "richtig war eine Aufgabe, Schreiben " + Trim$(Str$(schreib|)) + ", Zeile " + a$ + "."
              Else If richtig1% + falsch% = 1 And richtig1% = 0
                Text zeilenh1% * 2, seite%, "richtig war keine Aufgabe, Schreiben " + Trim$(Str$(schreib|)) + ", Zeile " + a$ + "."
              Else
                Text zeilenh1% * 2, seite%, "richtig waren " + Trim$(Str$(richtig1%)) + " von " + Trim$(Str$(richtig1% + falsch%)) + " Aufgaben, Schreiben " + Trim$(Str$(schreib|)) + ", Zeile " + a$ + "."
              EndIf
            Else
              If richtig1% = 1
                Text zeilenh1% * 2, seite%, "richtig war ein Wort von " + Trim$(Str$(wortzahl%)) + " Wörtern."
              Else If richtig1% = 0
                Text zeilenh1% * 2, seite%, "richtig war kein Wort von " + Trim$(Str$(wortzahl%)) + " Wörtern."
              Else If falsch% = 1
                Text zeilenh1% * 2, seite%, "richtig waren " + Trim$(Str$(richtig1%)) + " von " + Trim$(Str$(wortzahl%)) + " Wörtern, dabei wurde 1 Fehler gemacht."
              Else
                Text zeilenh1% * 2, seite%, "richtig waren " + Trim$(Str$(richtig1%)) + " von " + Trim$(Str$(wortzahl%)) + " Wörtern, dabei wurden " + Trim$(Str$(falsch%)) + " Fehler gemacht."
              EndIf
              Add seite%, zeilenh2%
              Text zeilenh1% * 2, seite%, "Schreiben " + Trim$(Str$(schreib|)) + ", Zeile " + a$
              Add seite%, zeilenh2%
              If alph% = 1
                Text zeilenh1% * 2, seite%, "Ordnen nach dem Alphabet"
              Else If alph% = 2
                Text zeilenh1% * 2, seite%, "Ordnen nach Wortarten"
              Else If alph% = 3 Or alph% = 0
                Text zeilenh1% * 2, seite%, "Abschreiben"
              EndIf
            EndIf
            Clr a$
            Add seite%, zeilenh2%
            If hilferuf| = 1
              Text zeilenh1% * 2, seite%, "Hilfe: ja"
            Else
              Text zeilenh1% * 2, seite%, "Hilfe: nein"
            EndIf
            Add seite%, zeilenh2%
            If gross| = 1
              Text zeilenh1% * 2, seite%, "Aufgabenwahl: normal"
            Else
              Text zeilenh1% * 2, seite%, "Aufgabenwahl: groß"
            EndIf
            Add seite%, zeilenh2%
            Text zeilenh1% * 2, seite%, "Zeit: " + Trim$(Str$(zeitm%)) + " min und " + Trim$(Str$(zeits%)) + " s"
            Add seite%, zeilenh2% * 2
            Output = Win_1
            Repeat
              PeekEvent
            Until _Mess = 0
          EndIf
        EndIf
      EndIf
      Color RGB(255, 255, 198) ' creme
      If a12| = 1
        PBox 27 * fx, 256 * fy, 511 * fx, 430 * fy
      Else If schreib| > 4
        PBox 40 * fx, 232 * fy, 511 * fx, 441 * fy
      Else
        PBox 27 * fx, 240 * fy, 511 * fx, 425 * fy
      EndIf
      If art| > 7
        SetFont schrift1%
        Color RGB(0, 0, 0) ' schwarz
        Text 42 * fx, 375 * fy, "Text ausdrucken?"
        Text 42 * fx, 400 * fy, "ja:       j   ***   nein:       Taste F8"
        Color RGB(255, 0, 0) ' rot
        SetFont schriftw1%
        Text 72 * fx, 401 * fy, "ò      ò"
        SetFont schrift1%
        Repeat
          Sleep
          t$ = InKey$
        Until t$ = "j" Or t$ = "J" Or (Len(t$) = 2 And Asc(Right$(t$)) = 119)
        Repeat
          PeekEvent
        Until InKey$ = ""
        DefMouse 0
        If t$ = "j" Or t$ = "J"                                                                              ' Text ausdrucken
          If drucken| = 0
            druckeinrichtung
          EndIf
          If print| = 1 ' Drucker angeschaltet
            Output = Printer
            If schreib| > 4
              Select art|
              Case 53
                a53
              Case 54
                a54
              Case 55
                a55
              Case 56
                a56
              Case 57
                a57
              Case 58
                a58
              Case 59
                a59
              Case 60
                a60
              Case 61
                a61
              Case 62
                a62
              Case 63
                a63
              Case 64
                a64
              Case 65
                a65
              Case 66
                a66
              Case 67
                a67
              Case 68
                a68
              Case 69
                a69
              Case 70
                a70
              Case 71
                a71
              Case 72
                a72
              Case 73
                a73
              Case 74
                a74
              Case 75
                a75
              Case 76
                a76
              Case 77
                a77
              Case 78
                a78
              EndSelect
              For i% = 1 To zeile%
                PeekEvent
                If art| < 77
                  Text zeilenh1% * 2, seite%, Right$(txt$(i%), Len(txt$(i%)) - 1)
                Else
                  Text zeilenh1% * 2, seite%, txt$(i%)
                EndIf
                Add seite%, zeilenh2%
              Next i%
            Else
              For i% = 1 To zeile%
                PeekEvent
                Text zeilenh1% * 2, seite%, txt$(i%)
                Add seite%, zeilenh2%
              Next i%
            EndIf
            Add seite%, zeilenh2% * 2
            If fehlersumme% > 0 And schreib| < 5
              Text zeilenh1% * 2, seite%, "Übe besonders:"
              Add seite%, zeilenh2% * 2
              For i% = 1 To Min(fehlersumme%, 15)
                PeekEvent
                Text zeilenh1% * 2, seite%, fehler$(i%)
                Add seite%, zeilenh2%
              Next i%
              Add seite%, zeilenh2% * 2
            EndIf
          EndIf
        EndIf
      EndIf
      If drucken| = 1
        Output = Printer
        Printer.EndPage
        FreeFont schriftdr1%
        FreeFont schriftdr2%
        EndDoc      ' Ende des Druck-Dokuments
        Repeat
          PeekEvent
        Until _Mess = 0
      EndIf
      Output = Win_1
      If speichern| > 0      ' Ergebnis speichern, falls gewünscht
        If nam$ <> ""
          If InStr(nam$, " ") <> 0
            nam1$ = nam$
            Repeat
              PeekEvent
              nam1$ = Left$(nam1$, InStr(nam1$, " ") - 1) + Right$(nam1$, Len(nam1$) - InStr(nam1$, " "))
            Until InStr(nam1$, " ") = 0
            f$ = "Schreiben\" + Left$(nam1$, Min(Len(nam1$), 8)) + ".txt"
          Else
            f$ = "Schreiben\" + nam$ + ".txt"
          EndIf
        Else
          f$ = "Schreiben\Schreib.txt"
        EndIf
        If richtig1% + falsch% > 0
          prozent% = Round(richtig1% / (richtig1% + falsch%) * 100)
          s_a% = Round((zeitm% * 60 + zeits%) / (richtig1% + falsch%))
        Else
          Clr prozent%, s_a%
        EndIf
        If Exist(f$)
          Open f$ for Append As # 1
        Else
          Open f$ for Output As # 1
          Print # 1
          Print # 1, nam$
          Print # 1, "     Datum  Zeit Wahl Zeile  Art min  s A H richtig gesamt s/A   %"
        EndIf
        d$ = Trim$(Date$)
        t$ = Space$(6)
        Rset t$ = Left$(Time$, 5)
        wahl_$ = Space$(5)
        Rset wahl_$ = Trim$(Str$(schreib|))
        zeile_$ = Space$(6)
        a$ = Trim$(Str$(Mod(art|, 13)))
        If a$ = "0"
          a$ = "13"
        EndIf
        Rset zeile_$ = a$
        Clr a$
        art_$ = Space$(5)
        If alph% = 0
          Rset art_$ = "Schr"
        Else If alph% = 1
          Rset art_$ = "Alph"
        Else If alph% = 2
          Rset art_$ = "Wort"
        Else If alph% = 3
          Rset art_$ = "Schr"
        EndIf
        zeitm_$ = Space$(4)
        Rset zeitm_$ = Trim$(Str$(zeitm%))
        zeits_$ = Space$(3)
        Rset zeits_$ = Trim$(Str$(zeits%))
        aufg$ = Space$(2)
        If gross| = 1
          Rset aufg$ = "n"
        Else
          Rset aufg$ = "g"
        EndIf
        hilfe_$ = Space$(2)
        If hilferuf| = 0
          Rset hilfe_$ = "n"
        Else
          Rset hilfe_$ = "j"
        EndIf
        richtig_$ = Space$(8)
        Rset richtig_$ = Trim$(Str$(richtig1%))
        richtig_falsch$ = Space$(7)
        Rset richtig_falsch$ = Trim$(Str$(richtig1% + falsch%))
        s_a_$ = Space$(4)
        Rset s_a_$ = Trim$(Str$(s_a%))
        prozent_$ = Space$(4)
        Rset prozent_$ = Trim$(Str$(prozent%))
        Print # 1, d$; t$; wahl_$; zeile_$; art_$; zeitm_$; zeits_$; aufg$; hilfe_$; richtig_$; richtig_falsch$; s_a_$; prozent_$
        Close # 1
      EndIf
    EndIf
    hauptmenue
  EndIf
  weiter2:
Return
>Procedure druckeinrichtung
  DefMouse 0
  Get (319 - 245) * fx, (239 - 65) * fy, (319 + 245) * fx, (239 + 65) * fy, alertf$
  alert2("Ist der Drucker angeschaltet?", "ja", "nein")
  Put (319 - 245) * fx, (239 - 65) * fy, alertf$
  Clr alertf$
  DefMouse V:aaa%(0)        ' transparente Mausform
  If alert| = 1
    drucken| = 1   ' Drucken erwünscht
    print| = 1     ' Drucker ist angeschaltet
    Output = Printer
    seitenh% = GetDevCaps(VERTRES)
    zeilenh1% = 11 * seitenh% / 640
    If art| < 77
      zeilenh2% = 10 * seitenh% / 640
    Else
      zeilenh2% = 7 * seitenh% / 640
    EndIf
    Printer.StartDoc "Schreiben"   ' Ausdruck-Dokument
    Printer.StartPage
    Font "arial", CharSet ANSI_CHARSET, Family FF_DONTCARE, Quality DEFAULT_QUALITY, Height zeilenh1%, To schriftdr1%
    Font "arial", CharSet ANSI_CHARSET, Family FF_DONTCARE, Quality DEFAULT_QUALITY, Height zeilenh2%, To schriftdr2%
    If schreib| < 3
      SetFont schriftdr1%
      zeilenh2% = zeilenh1%
    Else
      SetFont schriftdr2%
      zeilenh2% = zeilenh2%
    EndIf
    seite% = zeilenh1% * 3
  EndIf
Return
>Procedure a1   ' Tasten
  If beginn| = 0
    a1% = 1
    saeule
    beginn| = 1
    Color RGB(180, 255, 255) ' hell blaugrün
    DefLine 0, 1
    Line 40 * fx, 373 * fy, 500 * fx, 373 * fy
    Color RGB(0, 0, 0) ' schwarz
    SetFont schrift1%
    Text 42 * fx, 250 * fy, "Suche zuerst 3 wichtige Tasten:"
    Text 42 * fx, 300 * fy, "Drücke 5-mal die 'Fertig-Taste'! Sie ist im Bild rot!"
    For i% = 0 To 4
      Color RGB(255, 0, 0) ' rot
      Fill 581 * fx, 76 * fy To RGB(0, 0, 0)
      Repeat
        Sleep
        t$ = InKey$
      Until t$ = Chr$(13) Or (Len(t$) = 2 And Asc(Right$(t$)) = 119)
      If Len(t$) = 2 And Asc(Right$(t$)) = 119
        ende| = 1
        kontrolle
      EndIf
      Color RGB(255, 255, 198) ' creme
      Fill 581 * fx, 76 * fy To RGB(0, 0, 0)
    Next i%
    Inc richtig1%
    richtig# = richtig1%
    saeule
    Color RGB(255, 255, 198) ' creme
    PBox 40 * fx, 240 * fy, 510 * fx, 330 * fy
    Color RGB(0, 0, 0) ' schwarz
    SetFont schrift1%
    Text 42 * fx, 275 * fy, "Drücke jetzt 5-mal die 'Leertaste', dann die 'Fertig-Taste'!"
    For i% = 0 To 4
      Color RGB(255, 0, 0) ' rot
      Fill 318 * fx, 190 * fy To RGB(0, 0, 0)
      Repeat
        Sleep
        t$ = InKey$
      Until t$ = " " Or (Len(t$) = 2 And Asc(Right$(t$)) = 119)
      If Len(t$) = 2 And Asc(Right$(t$)) = 119
        ende| = 1
        kontrolle
      EndIf
      Color RGB(255, 255, 198) ' creme
      Fill 318 * fx, 190 * fy To RGB(0, 0, 0)
    Next i%
    Inc richtig1%
    richtig# = richtig1%
    saeule
    Color RGB(255, 0, 0) ' rot
    Fill 581 * fx, 76 * fy To RGB(0, 0, 0)
    Repeat
      Sleep
      t$ = InKey$
    Until t$ = Chr$(13) Or (Len(t$) = 2 And Asc(Right$(t$)) = 119)
    If Len(t$) = 2 And Asc(Right$(t$)) = 119
      ende| = 1
      kontrolle
    EndIf
    Inc richtig1%
    richtig# = richtig1%
    saeule
    Color RGB(255, 255, 198) ' creme
    Fill 581 * fx, 76 * fy To RGB(0, 0, 0)
    PBox 40 * fx, 270 * fy, 510 * fx, 330 * fy
    Color RGB(0, 0, 0) ' schwarz
    SetFont schrift1%
    Text 42 * fx, 300 * fy, "Drücke abwechselnd die Taste 'M' und die 'Leertaste'!"
    Clr tt$
    SetFont schrift3%
    For i% = 0 To 9
      Color RGB(255, 0, 0) ' rot
      Box 42 * fx + TxtLen(tt$), 350 * fy, 58 * fx + TxtLen(tt$), 366 * fy
      Fill 379 * fx, 160 * fy To RGB(0, 0, 0)
      Repeat
        Sleep
        t$ = InKey$
      Until t$ = "M" Or t$ = "m" Or (Len(t$) = 2 And Asc(Right$(t$)) = 119)
      If t$ = "m"
        t$ = "M"
      EndIf
      If Len(t$) = 2 And Asc(Right$(t$)) = 119
        ende| = 1
        kontrolle
      EndIf
      Color RGB(255, 255, 198) ' creme
      Box 42 * fx + TxtLen(tt$), 350 * fy, 58 * fx + TxtLen(tt$), 366 * fy
      tt$ = tt$ + t$
      Color RGB(0, 0, 0) ' schwarz
      Text 42 * fx, 347 * fy, tt$
      Color RGB(255, 255, 198) ' creme
      Fill 379 * fx, 160 * fy To RGB(0, 0, 0)
      Color RGB(255, 0, 0) ' rot
      Box 42 * fx + TxtLen(tt$), 350 * fy, 58 * fx + TxtLen(tt$), 366 * fy
      Fill 318 * fx, 190 * fy To RGB(0, 0, 0)
      Repeat
        Sleep
        t$ = InKey$
      Until t$ = " " Or (Len(t$) = 2 And Asc(Right$(t$)) = 119)
      If Len(t$) = 2 And Asc(Right$(t$)) = 119
        ende| = 1
        kontrolle
      EndIf
      Color RGB(255, 255, 198) ' creme
      Box 42 * fx + TxtLen(tt$), 350 * fy, 58 * fx + TxtLen(tt$), 366 * fy
      tt$ = tt$ + t$
      Color RGB(0, 0, 0) ' schwarz
      Text 42 * fx, 347 * fy, tt$
      Color RGB(255, 255, 198) ' creme
      Fill 318 * fx, 190 * fy To RGB(0, 0, 0)
    Next i%
    Inc richtig1%
    richtig# = richtig1%
    saeule
    Color RGB(255, 255, 198) ' creme
    PBox 40 * fx, 270 * fy, 510 * fx, 325 * fy
    Color RGB(0, 0, 0) ' schwarz
    SetFont schrift1%
    Text 42 * fx, 300 * fy, "Lösche die Zeichen mit der 'Zurück-Taste'!"
    SetFont schrift3%
    Color RGB(255, 0, 0) ' rot
    Box 42 * fx + TxtLen(tt$), 350 * fy, 58 * fx + TxtLen(tt$), 366 * fy
    Repeat
      Color RGB(255, 0, 0) ' rot
      Fill 576 * fx, 42 * fy To RGB(0, 0, 0)
      Repeat
        Sleep
        t$ = InKey$
      Until t$ = Chr$(8) Or ((Len(t$) = 2 And Asc(Right$(t$)) = 119))   ' Backspace
      If Len(t$) = 2 And Asc(Right$(t$)) = 119
        ende| = 1
        kontrolle
      EndIf
      Color RGB(255, 255, 198) ' creme
      Fill 576 * fx, 42 * fy To RGB(0, 0, 0)
      tt$ = Left$(tt$, (Len(tt$) - 1))
      Color RGB(255, 255, 198) ' creme
      PBox 42 * fx + TxtLen(tt$), 342 * fy, 510 * fx, 372 * fy
      Color RGB(0, 0, 0) ' schwarz
      Text 42 * fx, 347 * fy, tt$
      Color RGB(255, 0, 0) ' rot
      Box 42 * fx + TxtLen(tt$), 350 * fy, 58 * fx + TxtLen(tt$), 366 * fy
    Until tt$ = ""
    Inc richtig1%
    richtig# = richtig1%
    saeule
    Color RGB(255, 255, 198) ' creme
    Fill 576 * fx, 42 * fy To RGB(0, 0, 0)
    PBox 40 * fx, 270 * fy, 510 * fx, 400 * fy
    Color RGB(0, 0, 0) ' schwarz
    SetFont schrift1%
    Text 42 * fx, 250 * fy, "Fertig! Übe jetzt die anderen Buchstaben!"
    Text 42 * fx, 275 * fy, "Benutze zum Verbessern die 'Zurück-Taste'!"
    Text 42 * fx, 300 * fy, "Drücke die 'Fertig-Taste', wenn du fertig bist!"
    Text 42 * fx, 375 * fy, "Drücke jetzt die 'Fertig-Taste'!"
    Color RGB(255, 0, 0) ' rot
    Fill 581 * fx, 76 * fy To RGB(0, 0, 0)
    Repeat
      Sleep
      t$ = InKey$
    Until t$ = Chr$(13) Or (Len(t$) = 2 And Asc(Right$(t$)) = 119)
    If Len(t$) = 2 And Asc(Right$(t$)) = 119
      ende| = 1
      kontrolle
    EndIf
    Inc richtig1%
    richtig# = richtig1%
    saeule
    Color RGB(255, 255, 198) ' creme
    Fill 581 * fx, 76 * fy To RGB(0, 0, 0)
    PBox 40 * fx, 240 * fy, 510 * fx, 410 * fy
    Color RGB(180, 255, 255) ' hell blaugrün
    DefLine 0, 1
    Line 40 * fx, 325 * fy, 500 * fx, 325 * fy
    Line 40 * fx, 362 * fy, 500 * fx, 362 * fy
    Clr a1%
  EndIf
  If fehler_% = 0
    z% = Random(29) + 65
    If z% = 91
      z% = 196          ' Ä
    Else If z% = 92
      z% = 214          ' Ö
    Else If z% = 93
      z% = 220          ' Ü
    EndIf
    z_$ = Chr$(z%)
  EndIf
  GraphMode R2_COPYPEN, TRANSPARENT
  Color RGB(0, 0, 235) ' blau
  SetFont schrift3%
  Text 42 * fx, 300 * fy, z_$
Return
>Procedure a2   ' Zahlen
  If fehler_% = 0
    z% = Random(10) + 48
    z_$ = Chr$(z%)
  EndIf
  GraphMode R2_COPYPEN, TRANSPARENT
  Color RGB(0, 0, 235) ' blau
  SetFont schrift3%
  Text 42 * fx, 300 * fy, z_$
Return
>Procedure a3   ' Kleinbuchstaben
  If fehler_% = 0
    z% = Random(30) + 97
    If z% = 123
      z% = 228          ' ä
    Else If z% = 124
      z% = 246          ' ö
    Else If z% = 125
      z% = 252          ' ü
    Else If z% = 126
      z% = 223          ' ß
    EndIf
    z_$ = Chr$(z%)
  EndIf
  GraphMode R2_COPYPEN, TRANSPARENT
  Color RGB(0, 0, 235) ' blau
  SetFont schrift3%
  Text 42 * fx, 300 * fy, z_$
Return
>Procedure a4   ' Großbuchstaben
  If beginn| = 0
    beginn| = 1
    Color RGB(0, 0, 0) ' schwarz
    SetFont schrift1%
    Text 42 * fx, 400 * fy, "Eine Umschalttaste festhalten, Buchstabentaste drücken!"
    SetFont schrift3%
  EndIf
  If fehler_% = 0
    z% = Random(29) + 65
    If z% = 91
      z% = 196          ' Ä
    Else If z% = 92
      z% = 214          ' Ö
    Else If z% = 93
      z% = 220          ' Ü
    EndIf
    z_$ = Chr$(z%)
  EndIf
  GraphMode R2_COPYPEN, TRANSPARENT
  Color RGB(0, 0, 235) ' blau
  SetFont schrift3%
  Text 42 * fx, 300 * fy, z_$
Return
>Procedure a5   ' alle Buchstaben
  If fehler_% = 0
    z% = Random(59) + 65
    If z% = 91
      z% = 196          ' Ä
    Else If z% = 92
      z% = 228          ' ä
    Else If z% = 93
      z% = 214          ' Ö
    Else If z% = 94
      z% = 246          ' ö
    Else If z% = 95
      z% = 220          ' Ü
    Else If z% = 96
      z% = 252          ' ü
    Else If z% = 123
      z% = 223          ' ß
    EndIf
    z_$ = Chr$(z%)
    z% = Asc(Left$(z_$))
  EndIf
  GraphMode R2_COPYPEN, TRANSPARENT
  Color RGB(0, 0, 235) ' blau
  SetFont schrift3%
  Text 42 * fx, 300 * fy, z_$
Return
>Procedure a6   ' Zeichen
  If fehler_% = 0
    z% = Random(39) + 33
    If z% = 48
      z% = 125          ' }
    Else If z% = 49
      z% = 124          ' |
    Else If z% = 50
      z% = 123          ' {
    Else If z% = 51
      z% = 232          ' è
    Else If z% = 52
      z% = 95           ' Tiefstrich
    Else If z% = 53
      z% = 234          ' ê
    Else If z% = 54
      z% = 93           ' ]
    Else If z% = 55
      z% = 92           ' \
    Else If z% = 56
      z% = 91           ' [
    Else If z% = 57
      z% = 233          ' é
    Else If z% = 65
      z% = 126          ' ~
    Else If z% = 66
      z% = 176          ' °
    Else If z% = 67
      z% = 167          ' §
    Else If z% = 68
      z% = 178          ' ²
    Else If z% = 69
      z% = 179          ' ³
    Else If z% = 70
      z% = 181          ' µ
    Else If z% = 71
      z% = 128          ' Eurozeichen
    EndIf
    z_$ = Chr$(z%)
    z% = Asc(Left$(z_$))
  EndIf
  GraphMode R2_COPYPEN, TRANSPARENT
  Color RGB(0, 0, 235) ' blau
  SetFont schrift3%
  Text 42 * fx, 300 * fy, z_$
Return
>Procedure a7
  If fehler_% = 0
    z% = Random(108) + 33
    If z% = 127
      z% = 178          ' ²
    Else If z% = 129
      z% = 167          ' §
    Else If z% = 130
      z% = 176          ' °
    Else If z% = 131
      z% = 181          ' µ
    Else If z% = 132
      z% = 180          ' ´
    Else If z% = 133
      z% = 223          ' ß
    Else If z% = 134
      z% = 228          ' ä
    Else If z% = 135
      z% = 246          ' ö
    Else If z% = 136
      z% = 252          ' ü
    Else If z% = 137
      z% = 196          ' Ä
    Else If z% = 138
      z% = 214          ' Ö
    Else If z% = 139
      z% = 220          ' Ü
    Else If z% = 140
      z% = 179          ' ³
    EndIf
    z_$ = Chr$(z%)
    If z% = 180 Or z% = 94 Or z% = 96
      If z% = 94                 ' ^
        z% = 234                 ' ê
        z_$ = "ê"
      Else If z% = 96            ' `
        z% = 232                 ' è
        z_$ = "è"
      Else If z% = 180           ' ´
        z% = 233                 ' é
        z_$ = "é"
      EndIf
    EndIf
    z% = Asc(Left$(z_$))
  EndIf
  GraphMode R2_COPYPEN, TRANSPARENT
  Color RGB(0, 0, 235) ' blau
  SetFont schrift3%
  Text 42 * fx, 300 * fy, z_$
Return
