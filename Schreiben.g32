>Procedure wortschatz
  faktor% = 1
  Select art|
  Case 53
    a53
  Case 54
    a54
  Case 55
    a55
  Case 56
    a56
  Case 57
    a57
  Case 58
    a58
  Case 59
    a59
  Case 60
    a60
  Case 61
    a61
  Case 62
    a62
  Case 63
    a63
  Case 64
    a64
  Case 65
    a65
  Case 66
    a66
  Case 67
    a67
  Case 68
    a68
  Case 69
    a69
  Case 70
    a70
  Case 71
    a71
  Case 72
    a72
  Case 73
    a73
  Case 74
    a74
  Case 75
    a75
  Case 76
    a76
  Case 77
    a77
  Case 78
    a78
  EndSelect
  wortzahl% = zeile%
  For i% = 1 To zeile%
    Swap txt$(i%), txt$(Random(zeile%) + 1)
  Next i%
  num% = 1
  GraphMode R2_COPYPEN, TRANSPARENT
  Do
    Color RGB(255, 255, 198) ' creme
    For jjj% = 1 To 8
      twort$(jjj%) = ""
      If alph% <> 2 Or Even(jjj%) = -1             ' jjj% gerade Zahl
        PBox 68 * fx, 211 * fy + Int(zeichenh% * 1.25) * jjj%, 350 * fx, Ceil(232 * fy) + Int(zeichenh% * 1.25) * jjj%
      EndIf
    Next jjj%
    jjj% = 1
    For i% = num% To num% + 3
      twort$(jjj%) = txt$(i%)
      txt$(jjj%) = txt$(i%)
      Color RGB(255, 255, 198) ' creme
      PBox 68 * fx, 43 * fy + Int(zeichenh% * 1.25) * jjj%, 270 * fx, 68 * fy + Int(zeichenh% * 1.25) * jjj%
      If i% <= zeile%
        Color RGB(0, 0, 235) ' blau
        If gross| = 1
          Text 70 * fx, 43 * fy + Int(Int(zeichenh% * 1.25)) * jjj%, Right$(txt$(i%), Len(txt$(i%)) - 1)
        Else
          z_$ = txt$(i%)
          Repeat
            PeekEvent
            aa% = InStr(z_$, "ß")
            If aa% > 1
              z_$ = Left$(z_$, aa% - 1) + "ss" + Right$(z_$, Len(z_$) - aa%)
            EndIf
          Until aa% < 2
          Text 70 * fx, 43 * fy + Int(zeichenh% * 1.25) * jjj%, Upper$(Right$(z_$, Len(z_$) - 1))
        EndIf
      EndIf
      Inc jjj%
    Next i%
    For i% = num% + 4 To num% + 7
      twort$(jjj%) = txt$(i%)
      txt$(jjj%) = txt$(i%)
      Color RGB(255, 255, 198) ' creme
      PBox 270 * fx, 43 * fy + Int(zeichenh% * 1.25) * (jjj% - 4), 505 * fx, 68 * fy + Int(zeichenh% * 1.25) * (jjj% - 4)
      If i% <= zeile%
        Color RGB(0, 0, 235) ' blau
        If gross| = 1
          Text 272 * fx, 43 * fy + Int(zeichenh% * 1.25) * (jjj% - 4), Right$(txt$(i%), Len(txt$(i%)) - 1)
        Else
          z_$ = txt$(i%)
          Repeat
            PeekEvent
            aa% = InStr(z_$, "ß")
            If aa% > 1
              z_$ = Left$(z_$, aa% - 1) + "ss" + Right$(z_$, Len(z_$) - aa%)
            EndIf
          Until aa% < 2
          Text 272 * fx, 43 * fy + Int(zeichenh% * 1.25) * (jjj% - 4), Upper$(Right$(z_$, Len(z_$) - 1))
        EndIf
      EndIf
      Inc jjj%
    Next i%
    iii% = 1
    For jjj% = 1 To 8
      antw_$(jjj%) = ""
    Next jjj%
    If hilfe| = 2 And beginn1| = 0
      beginn1| = 1
      j# = oTimer
      Repeat
        PeekEvent
        zeitneu# = oTimer
      Until zeitneu# > j# + 2000
    EndIf
    If alph% = 1
      For jjj% = 1 To 8
        m|(jjj%) = jjj%
      Next jjj%
      Clr jjj%
      Repeat
        PeekEvent
        Inc jjj%
        txt$(jjj%) = Right$(txt$(jjj%), Len(txt$(jjj%)) - 1)
      Until txt$(jjj%) = "" Or jjj% = 9
      sortier
      Clr jjj%
      Repeat
        PeekEvent
        Inc jjj%
        txt$(jjj%) = " " + txt$(jjj%)
      Until txt$(jjj% + 1) = "" Or jjj% = 9
      Color RGB(0, 0, 235) ' blau
    EndIf
    If alph% = 2
      iii% = 2
      antwy% = 212 * fy + Int(zeichenh% * 1.25) * iii%
      Repeat
        PeekEvent
        input2
        Clr jjj%
        Repeat
          PeekEvent
          Inc jjj%
          Select Val(Left$(txt$(jjj%)))
          Case 1
            If iii% = 2 And antw_$(2) = "der " + Right$(txt$(jjj%), Len(txt$(jjj%)) - 1)
              GoTo richtig1
            EndIf
          Case 2
            If iii% = 2 And antw_$(2) = "die " + Right$(txt$(jjj%), Len(txt$(jjj%)) - 1)
              GoTo richtig1
            EndIf
          Case 3
            If iii% = 2 And antw_$(2) = "das " + Right$(txt$(jjj%), Len(txt$(jjj%)) - 1)
              GoTo richtig1
            EndIf
          Case 4
            If iii% = 4 And antw_$(4) = Right$(txt$(jjj%), Len(txt$(jjj%)) - 1)
              GoTo richtig1
            EndIf
          Case 5
            If iii% = 6 And antw_$(6) = Right$(txt$(jjj%), Len(txt$(jjj%)) - 1)
              GoTo richtig1
            EndIf
          Case 6
            If iii% = 8 And antw_$(8) = Right$(txt$(jjj%), Len(txt$(jjj%)) - 1)
              GoTo richtig1
            EndIf
          Case 7
            If iii% = 6 And antw_$(6) = Right$(txt$(jjj%), Len(txt$(jjj%)) - 1)
              GoTo richtig1
            Else If iii% = 8 And antw_$(8) = Right$(txt$(jjj%), Len(txt$(jjj%)) - 1)
              GoTo richtig1
            EndIf
          Case 8
            If iii% = 2 And antw_$(2) = "der " + Right$(txt$(jjj%), Len(txt$(jjj%)) - 1)
              GoTo richtig1
            Else If iii% = 2 And antw_$(2) = "das " + Right$(txt$(jjj%), Len(txt$(jjj%)) - 1)
              GoTo richtig1
            EndIf
          Case 9
            If iii% = 2 And antw_$(2) = "der " + Right$(txt$(jjj%), Len(txt$(jjj%)) - 1)
              GoTo richtig1
            Else If iii% = 2 And antw_$(2) = "die " + Right$(txt$(jjj%), Len(txt$(jjj%)) - 1)
              GoTo richtig1
            EndIf
          Case 0
            If Left$(txt$(jjj%)) = "f"        ' Adjektiv / sonst. Wort / der ...
              If txt$(jjj%) = "fwert" And antw_$(2) = "der Wert" And iii% = 2 And gross| = 2
                GoTo richtig1
              Else If txt$(jjj%) = "fwert" And ((antw_$(8) = "wert" And iii% = 8) Or (antw_$(6) = "wert" And iii% = 6))
                GoTo richtig1
              EndIf
            Else If Left$(txt$(jjj%)) = "g"   ' Adjektiv / sonst. Wort / das ...
              If txt$(jjj%) = "gFest" And ((antw_$(2) = "das Fest" And iii% = 2) Or (antw_$(6) = "fest" And iii% = 6 And gross| = 2) Or (antw_$(8) = "fest" And iii% = 8 And gross| = 2))
                GoTo richtig1
              Else If txt$(jjj%) = "gweh" And ((antw_$(2) = "das Weh" And iii% = 2 And gross| = 2) Or (antw_$(6) = "weh" And iii% = 6) Or (antw_$(8) = "weh" And iii% = 8))
                GoTo richtig1
              EndIf
            Else If Left$(txt$(jjj%)) = "e"        ' Adjektiv / der ...
              If iii% = 6 And antw_$(6) = Right$(txt$(jjj%), Len(txt$(jjj%)) - 1) And txt$(jjj%) <> "eArm"
                GoTo richtig1
              Else If txt$(jjj%) = "eArm" And iii% = 2 And antw_$(2) = "der Arm"
                GoTo richtig1
              Else If txt$(jjj%) = "eArm" And iii% = 6 And antw_$(6) = "arm" And gross| = 2
                GoTo richtig1
              Else If gross| = 2
                tt$ = Upper$(Mid$(txt$(jjj%), 2, 1)) + Right$(txt$(jjj%), Len(txt$(jjj%)) - 2)
                If iii% = 2 And antw_$(2) = "der " + tt$
                  GoTo richtig1
                EndIf
              EndIf
            Else If Left$(txt$(jjj%)) = "i"   ' Adjektiv / die ...
              If txt$(jjj%) = "iKlasse" And (iii% = 6 And antw_$(6) = "klasse" And gross| = 2) Or (iii% = 2 And antw_$(2) = "die Klasse")
                GoTo richtig1
              Else If txt$(jjj%) = "iCreme" And (iii% = 6 And antw_$(6) = "creme" And gross| = 2) Or (iii% = 2 And antw_$(2) = "die Creme")
                GoTo richtig1
              Else If txt$(jjj%) = "isauer" And (iii% = 6 And antw_$(6) = "sauer") Or (iii% = 2 And antw_$(2) = "die Sauer" And gross| = 2)
                GoTo richtig1
              EndIf
            Else If Left$(txt$(jjj%)) = "a"   ' Adjektiv / das ...
              If iii% = 6 And antw_$(6) = Right$(txt$(jjj%), Len(txt$(jjj%)) - 1)
                GoTo richtig1
              Else If gross| = 2
                tt$ = Upper$(Mid$(txt$(jjj%), 2, 1)) + Right$(txt$(jjj%), Len(txt$(jjj%)) - 2)
                If iii% = 2 And antw_$(2) = "das " + tt$
                  GoTo richtig1
                EndIf
              EndIf
            Else If Left$(txt$(jjj%)) = "k"   ' sonst. W. / der ...
              If iii% = 2 And antw_$(2) = "der " + Right$(txt$(jjj%), Len(txt$(jjj%)) - 1) And txt$(jjj%) <> "kweg"
                GoTo richtig1
              Else If txt$(jjj%) = "kWeg" And iii% = 8 And antw_$(8) = "weg" And gross| = 2
                GoTo richtig1
              Else If txt$(jjj%) = "kweg" And iii% = 8 And antw_$(8) = "weg"
                GoTo richtig1
              Else If txt$(jjj%) = "kweg" And iii% = 2 And antw_$(2) = "der Weg" And gross| = 2
                GoTo richtig1
              Else If txt$(jjj%) = "kMorgen" And iii% = 8 And antw_$(8) = "morgen" And gross| = 2
                GoTo richtig1
              EndIf
            Else If Left$(txt$(jjj%)) = "m"   ' sonst. W. / die ...
              If iii% = 2 And antw_$(2) = "die " + Right$(txt$(jjj%), Len(txt$(jjj%)) - 1)
                GoTo richtig1
              Else If txt$(jjj%) = "mAngst" And iii% = 8 And antw_$(8) = "angst" And gross| = 2
                GoTo richtig1
              EndIf
            Else If Left$(txt$(jjj%)) = "n"   ' sonst. W. / das ...
              If iii% = 8 And antw_$(8) = Right$(txt$(jjj%), Len(txt$(jjj%)) - 1)
                GoTo richtig1
              Else If gross| = 2
                tt$ = Upper$(Mid$(txt$(jjj%), 2, 1)) + Right$(txt$(jjj%), Len(txt$(jjj%)) - 2)
                If iii% = 2 And antw_$(2) = "das " + tt$
                  GoTo richtig1
                EndIf
              EndIf
            Else If Left$(txt$(jjj%)) = "y"   ' Verb / der ...
              If iii% = 4 And antw_$(4) = Right$(txt$(jjj%), Len(txt$(jjj%)) - 1)
                GoTo richtig1
              Else If gross| = 2
                tt$ = Upper$(Mid$(txt$(jjj%), 2, 1)) + Right$(txt$(jjj%), Len(txt$(jjj%)) - 2)
                If iii% = 2 And antw_$(2) = "der " + tt$
                  GoTo richtig1
                EndIf
              EndIf
            Else If Left$(txt$(jjj%)) = "z"   ' Verb / das ...
              If iii% = 4 And antw_$(4) = Right$(txt$(jjj%), Len(txt$(jjj%)) - 1)
                GoTo richtig1
              Else If gross| = 2
                tt$ = Upper$(Mid$(txt$(jjj%), 2, 1)) + Right$(txt$(jjj%), Len(txt$(jjj%)) - 2)
                If iii% = 2 And antw_$(2) = "das " + tt$
                  GoTo richtig1
                EndIf
              EndIf
            EndIf
          EndSelect
        Until jjj% = 8
        GoTo falsch1
        richtig1:
        Inc richtig1%
        richtig# = Int(richtig1% / wortzahl% * 52)
        Clr fehler_%
        Color RGB(255, 255, 198) ' creme
        If jjj% < 5
          PBox 68 * fx, 43 * fy + Int(zeichenh% * 1.25) * (jjj%), 270 * fx, 68 * fy + Int(zeichenh% * 1.25) * (jjj%)
        Else
          PBox 270 * fx, 43 * fy + Int(zeichenh% * 1.25) * (jjj% - 4), 505 * fx, 68 * fy + Int(zeichenh% * 1.25) * (jjj% - 4)
        EndIf
        txt$(jjj%) = ""
        GoTo weiter3
        falsch1:
        fehler_% = 1
        Inc falsch%
        weiter3:
        Clr jj%
        Color RGB(255, 255, 198) ' creme
        PBox 68 * fx, 207 * fy + Int(zeichenh% * 1.25) * iii%, 400 * fx, Ceil(232 * fy) + Ceil(zeichenh% * 1.25) * iii%
        antw_$(iii%) = ""
        saeule
        Repeat
          Inc jj%
          PeekEvent
        Until txt$(jj%) <> "" Or jj% = 9
      Until jj% > 8
    Else                                 ' alph%<>2
      Repeat
        Clr jj%
        Repeat
          PeekEvent
          Inc jj%
        Until antw_$(jj%) = ""
        iii% = jj%
        If txt$(iii%) <> ""
          z_$ = Right$(txt$(iii%), Len(txt$(iii%)) - 1)
        Else
          ende| = 1
          kontrolle
        EndIf
        If hilfe| = 2 Or fehler_% = 1
          Color RGB(180, 255, 255) ' hell blaugrün
          PBox 34 * fx, 183 * fy, 505 * fx, 213 * fy
          Color RGB(255, 0, 0) ' rot
          Text 70 * fx, 188 * fy, Right$(txt$(iii%), Len(txt$(iii%)) - 1)
        EndIf
        antwy% = 212 * fy + Int(zeichenh% * 1.25) * iii%
        input2
        tt$ = Right$(txt$(iii%), Len(txt$(iii%)) - 1)
        If antw_$(iii%) = tt$ Or (Val(Left$(txt$(iii%))) = 0 And gross| = 2)
          If gross| < 2 Or antw_$(iii%) = tt$
            GoTo richtig
          Else If Upper$(Left$(tt$)) + Right$(tt$, Len(tt$) - 1) = antw_$(iii%)
            GoTo richtig
          Else If Lower$(Left$(tt$)) + Right$(tt$, Len(tt$) - 1) = antw_$(iii%)
            GoTo richtig
          Else
            GoTo falsch2
          EndIf
          richtig:
          Inc richtig1%
          richtig# = Int(richtig1% / wortzahl% * 52)
          Clr fehler_%
          Color RGB(255, 255, 198) ' creme
          If alph% = 1
            If m|(iii%) < 5
              PBox 68 * fx, 43 * fy + Int(zeichenh% * 1.25) * m|(iii%), 270 * fx, 68 * fy + Int(zeichenh% * 1.25) * m|(iii%)
            Else
              PBox 270 * fx, 43 * fy + Int(zeichenh% * 1.25) * (m|(iii%) - 4), 505 * fx, 68 * fy + Int(zeichenh% * 1.25) * (m|(iii%) - 4)
            EndIf
          EndIf
          If alph% = 3
            If iii% < 5
              PBox 68 * fx, 43 * fy + Int(zeichenh% * 1.25) * iii%, 270 * fx, 68 * fy + Int(zeichenh% * 1.25) * iii%
            Else
              PBox 270 * fx, 43 * fy + Int(zeichenh% * 1.25) * (iii% - 4), 505 * fx, 68 * fy + Int(zeichenh% * 1.25) * (iii% - 4)
            EndIf
          EndIf
        Else
          falsch2:
          fehler_% = 1
          Inc falsch%
          Color RGB(255, 255, 198) ' creme
          PBox 68 * fx, 211 * fy + Int(zeichenh% * 1.25) * iii%, 350 * fx, Ceil(232 * fy) + Int(zeichenh% * 1.25) * iii%
          Color RGB(0, 0, 235) ' blau
          If alph% = 1
            If gross| = 1
              If m|(iii%) < 5
                Text 70 * fx, 43 * fy + Int(zeichenh% * 1.25) * m|(iii%), Right$(txt$(iii%), Len(txt$(iii%)) - 1)
              Else
                Text 272 * fx, 43 * fy + Int(zeichenh% * 1.25) * (m|(iii%) - 4), Right$(txt$(iii%), Len(txt$(iii%)) - 1)
              EndIf
            Else
              ttt$ = Right$(txt$(iii%), Len(txt$(iii%)) - 1)
              Repeat
                PeekEvent
                aa% = InStr(ttt$, "ß")
                If aa% > 1
                  ttt$ = Left$(ttt$, aa% - 1) + "ss" + Right$(ttt$, Len(ttt$) - aa%)
                EndIf
              Until aa% < 2
              If m|(iii%) < 5
                Text 70 * fx, 43 * fy + Int(zeichenh% * 1.25) * m|(iii%), Upper$(ttt$)
              Else
                Text 272 * fx, 43 * fy + Int(zeichenh% * 1.25) * (m|(iii%) - 4), Upper$(ttt$)
              EndIf
            EndIf
          EndIf
          If alph% = 3
            If gross| = 1
              If iii% < 5
                Text 70 * fx, 43 * fy + Int(zeichenh% * 1.25) * iii%, Right$(txt$(iii%), Len(txt$(iii%)) - 1)
              Else
                Text 272 * fx, 43 * fy + Int(zeichenh% * 1.25) * (iii% - 4), Right$(txt$(iii%), Len(txt$(iii%)) - 1)
              EndIf
            Else
              ttt$ = Right$(txt$(iii%), Len(txt$(iii%)) - 1)
              Repeat
                PeekEvent
                aa% = InStr(ttt$, "ß")
                If aa% > 1
                  ttt$ = Left$(ttt$, aa% - 1) + "ss" + Right$(ttt$, Len(ttt$) - aa%)
                EndIf
              Until aa% < 2
              If iii% < 5
                Text 70 * fx, 43 * fy + Int(zeichenh% * 1.25) * iii%, Upper$(ttt$)
              Else
                Text 272 * fx, 43 * fy + Int(zeichenh% * 1.25) * (iii% - 4), Upper$(ttt$)
              EndIf
            EndIf
          EndIf
          antw_$(iii%) = ""
        EndIf
        saeule
        Clr jj%
        Repeat
          PeekEvent
          Inc jj%
        Until antw_$(jj%) = ""
      Until jj% > 8
    EndIf
    Add num%, 8
    If num% > zeile%
      ende| = 1
      kontrolle
    EndIf
  Loop
Return
>Procedure sortier
  Local reihe%, pos%, start%
  For start% = 1 To 7
    For reihe% = start% + 1 To 8
      pos% = 0
      Repeat
        PeekEvent
        Inc pos%
      Until (b_|(Asc(Mid$(txt$(start%), pos%, 1))) <> b_|(Asc(Mid$(txt$(reihe%), pos%, 1)))) Or b_|(Asc(Mid$(txt$(start%), pos%, 1))) = 0 Or b_|(Asc(Mid$(txt$(reihe%), pos%, 1))) = 0
      If (b_|(Asc(Mid$(txt$(start%), pos%, 1))) > b_|(Asc(Mid$(txt$(reihe%), pos%, 1)))) And b_|(Asc(Mid$(txt$(reihe%), pos%, 1))) <> 0
        Swap txt$(start%), txt$(reihe%)
        Swap m|(start%), m|(reihe%)
      EndIf
    Next reihe%
  Next start%
Return
