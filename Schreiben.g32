>Procedure beugung
  faktor% = 2
  If art| = 77
    a77
  Else
    a78
  EndIf
  wortzahl% = zeile%
  num% = 1
  GraphMode R2_COPYPEN, TRANSPARENT
  Do
    Color RGB(255, 255, 198) ' creme
    For jjj% = 1 To 3
      PBox 68 * fx, 211 * fy + Int(zeichenh% * 1.25) * jjj% * 2, 350 * fx, 233 * fy + Int(zeichenh% * 1.25) * jjj% * 2
    Next jjj%
    PBox 68 * fx, 211 * fy + Int(zeichenh% * 1.25) * 7, 350 * fx, 233 * fy + Int(zeichenh% * 1.25) * 7
    jjj% = 1
    For i% = num% To num% + 3
      txt$(jjj%) = txt$(i%)
      Inc jjj%
    Next i%
    Color RGB(255, 255, 198) ' creme
    PBox 34 * fx, 85 * fy, 505 * fx, 115 * fy
    Color RGB(180, 255, 255) ' hell blaugrün
    PBox 34 * fx, 183 * fy, 505 * fx, 213 * fy
    z_$ = txt$(1)
    Color RGB(0, 0, 235) ' blau
    If gross| = 1
      Text 70 * fx, 90 * fy, z_$
    Else
      Repeat
        PeekEvent
        aa% = InStr(z_$, "ß")
        If aa% > 1
          z_$ = Left$(z_$, aa% - 1) + "ss" + Right$(z_$, Len(z_$) - aa%)
        EndIf
      Until aa% < 2
      Text 70 * fx, 90 * fy, Upper$(z_$)
    EndIf
    For jjj% = 1 To 4
      antw_$(jjj%) = ""
    Next jjj%
    jj% = 1
    Do
      iii% = jj% * 2
      If txt$(jj%) <> ""
        z_$ = txt$(jj%)
      Else
        ende| = 1
        kontrolle
      EndIf
      antwy% = 212 * fy + Int(zeichenh% * 1.25) * iii%
      If iii% = 8 Then antwy% = 212 * fy + Int(zeichenh% * 1.25) * 7
      If iii% = 8
        antw_$(4) = Left$(txt$(4), 7)
      Else If iii% > 3
        antw_$(jj%) = Left$(txt$(jj%), 3)
      EndIf
      Color RGB(0, 0, 0) ' schwarz
      Text 70 * fx, antwy% - 3 * fy, antw_$(jj%)
      Color RGB(180, 255, 255) ' hell blaugrün
      PBox 34 * fx, 183 * fy, 505 * fx, 213 * fy
      If hilfe| = 2 Or fehler_% = 1
        Color RGB(255, 0, 0) ' rot
        Text 70 * fx, 188 * fy, txt$(jj%)
      EndIf
      input2
      If (antw_$(jj%) = txt$(jj%)) Or (antw_$(jj%) = "er hat geschrieen" And txt$(jj%) = "er hat geschrien")
        Inc richtig1%
        richtig# = Int(richtig1% / wortzahl% * 52)
        Clr fehler_%
      Else
        fehler_% = 1
        Inc falsch%
        Color RGB(255, 255, 198) ' creme
        If iii% < 8
          PBox 68 * fx, 209 * fy + Int(zeichenh% * 1.25) * iii%, 350 * fx, 232 * fy + Int(zeichenh% * 1.25) * iii%
        Else
          PBox 68 * fx, 209 * fy + Int(zeichenh% * 1.25) * 7, 350 * fx, 232 * fy + Int(zeichenh% * 1.25) * 7
        EndIf
        antw_$(jj%) = ""
      EndIf
      saeule
      If fehler_% = 0
        Inc jj%
      EndIf
      Exit If jj% > 4
    Loop
    Add num%, 4
    If num% > zeile%
      ende| = 1
      kontrolle
    EndIf
  Loop
Return
