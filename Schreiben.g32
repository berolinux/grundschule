Font "Arial", Height Int(21 * fx), Weight 400, Width 0, To schrift1%
Font "Arial", Height Int(22 * fx), Weight 400, Width 0, To schrift2%
Font "Arial", Height Int(25 * fx), Weight 400, Width 0, To schrift3%
Font "Arial", Height Int(45 * fx), Weight 400, Width 0, To schrift4%
Font "Arial", Height Int(60 * fx), Weight 700, Width 0, To schrift5%
Font "Times New Roman", Height Int(62 * fx), Weight 700, Width 0, To schrift6%
