>Procedure texte     ' vorgegebene Übungen
  If anfang| = 0
    For i% = 1 To zeile%
      t$ = txt$(i%)
      For jjj% = 1 To Len(t$)
        PeekEvent
        If Asc(Mid$(t$, jjj%, 1)) = 32
          Inc wortzahl%
        Else If Asc(Mid$(t$, jjj%, 1)) = 45 And Asc(Mid$(t$, jjj% - 1, 1)) = 32
          Dec wortzahl%
        EndIf
      Next jjj%
    Next i%
    Add wortzahl%, zeile%
    saeule
    anfang| = 1
  EndIf
  If falsch1| = 0
    Inc nr%
  EndIf
  For i% = 1 To 15
    wort$(i%) = ""
  Next i%
  z_$ = txt$(nr%)
  Clr altj%
  Clr wort_%        ' Wortzahl einer Zeile
  Clr strich%
  For jjj% = 1 To Len(z_$) + 1
    If Asc(Mid$(z_$, jjj%, 1)) = 32 Or jjj% > Len(z_$)
      Inc wort_%
      wort$(wort_%) = Mid$(z_$, altj% + 1, jjj% - altj% - 1)
      If strich% = 1
        Clr strich%
        wort$(wort_% - 1) = wort$(wort_%)
        Dec wort_%
      EndIf
      altj% = jjj%
      If Asc(Mid$(z_$, jjj% - 1, 1)) = 45 And jjj% <= Len(z_$)
        strich% = 1
      EndIf
    EndIf
  Next jjj%
  Color RGB(0, 0, 235) ' blau
  SetFont schrift3%
  If gross| = 1 Or fehler_% = 1
    Text 42 * fx, 300 * fy, z_$
  Else
    zz_$ = z_$
    Repeat
      PeekEvent
      aa% = InStr(zz_$, "ß")
      If aa% > 1
        zz_$ = Left$(zz_$, aa% - 1) + "ss" + Right$(zz_$, Len(zz_$) - aa%)
      EndIf
    Until aa% < 2
    SetFont schrift2%
    Text 42 * fx, 300 * fy, Upper$(zz_$)
    SetFont schrift3%
  EndIf
Return
>Procedure ascii      ' Füllen der Tasten: Hilfe zum Auffinden
  If z% = 94                 ' ^
    z% = 234                 ' ê
    z_$ = "ê"
  Else If z% = 96            ' `
    z% = 232                 ' è
    z_$ = "è"
  Else If z% = 180           ' ´
    z% = 233                 ' é
    z_$ = "é"
  EndIf
  '  z% = 56
  Select z%
  Case 32                   ' Leertaste
    Fill 318 * fx, 190 * fy To RGB(0, 0, 0)
  Case 234, 176             ' °
    Fill 68 * fx, 43 * fy To RGB(0, 0, 0)    ' ^
    Fill 56 * fx, 36 * fy To RGB(0, 0, 0)
    If z% = 234
      Fill 195 * fx, 76 * fy To RGB(0, 0, 0) ' e
    EndIf
  Case 49, 33               ' 1
    Fill  105 * fx, 43 * fy To RGB(0, 0, 0)
  Case 50, 34, 178, 132, 147   ' 2, Anführungszeichen oben und unten
    Fill 143 * fx, 43 * fy To RGB(0, 0, 0)
  Case 51, 167, 179         ' 3
    Fill 167 * fx, 38 * fy To RGB(0, 0, 0)
    Fill 182 * fx, 43 * fy To RGB(0, 0, 0)
  Case 52, 36               ' 4
    Fill 218 * fx, 43 * fy To RGB(0, 0, 0)
    Fill 205 * fx, 56 * fy To RGB(0, 0, 0)
    Fill 204 * fx, 37 * fy To RGB(0, 0, 0)
    Fill 206 * fx, 43 * fy To RGB(0, 0, 0)
  Case 53, 37               ' 5
    Fill 258 * fx, 43 * fy To RGB(0, 0, 0)
    Fill 239 * fx, 37 * fy To RGB(0, 0, 0)
    Fill 248 * fx, 43 * fy To RGB(0, 0, 0)
  Case 54, 38               ' 6
    Fill 294 * fx, 43 * fy To RGB(0, 0, 0)
    Fill 278 * fx, 37 * fy To RGB(0, 0, 0)
    Fill 277 * fx, 41 * fy To RGB(0, 0, 0)
    Fill 280 * fx, 58 * fy To RGB(0, 0, 0)
  Case 55, 47, 123          ' 7
    Fill 331 * fx, 43 * fy To RGB(0, 0, 0)
  Case 56, 40, 91           ' 8
    Fill 369 * fx, 43 * fy To RGB(0, 0, 0)
    Fill 356 * fx, 53 * fy To RGB(0, 0, 0)
    Fill 356 * fx, 58 * fy To RGB(0, 0, 0)
  Case 57, 41, 93           ' 9
    Fill 406 * fx, 43 * fy To RGB(0, 0, 0)
    Fill 392 * fx, 54 * fy To RGB(0, 0, 0)
  Case 48, 61, 125          ' 0
    Fill 442 * fx, 43 * fy To RGB(0, 0, 0)
    Fill 430 * fx, 56 * fy To RGB(0, 0, 0)
  Case 223, 63, 92          ' ß
    Fill 481 * fx, 43 * fy To RGB(0, 0, 0)
  Case 232, 233             ' ´
    Fill 518 * fx, 43 * fy To RGB(0, 0, 0)
    Fill 195 * fx, 75 * fy To RGB(0, 0, 0)    ' e
  Case 81, 113, 64          ' Q
    Fill 106 * fx, 76 * fy To RGB(0, 0, 0)
    Fill 123 * fx, 76 * fy To RGB(0, 0, 0)
    Fill 120 * fx, 91 * fy To RGB(0, 0, 0)
    Fill 125 * fx, 91 * fy To RGB(0, 0, 0)
  Case 87, 119              ' W
    Fill 161 * fx, 76 * fy To RGB(0, 0, 0)
  Case 69, 101, 128         ' E, Eurozeichen
    Fill 195 * fx, 76 * fy To RGB(0, 0, 0)
  Case 82, 114              ' R
    Fill 236 * fx, 76 * fy To RGB(0, 0, 0)
    Fill 220 * fx, 74 * fy To RGB(0, 0, 0)
  Case 84, 116              ' T
    Fill 272 * fx, 76 * fy To RGB(0, 0, 0)
  Case 90, 122              ' Z
    Fill 309 * fx, 76 * fy To RGB(0, 0, 0)
  Case 85, 117              ' U
    Fill 348 * fx, 76 * fy To RGB(0, 0, 0)
  Case 73, 105              ' I
    Fill 384 * fx, 76 * fy To RGB(0, 0, 0)
  Case 79, 111              ' O
    Fill 407 * fx, 76 * fy' To RGB(0, 0, 0)
    Fill 422 * fx, 76 * fy' To RGB(0, 0, 0)
  Case 80, 112              ' P
    Fill 459 * fx, 76 * fy To RGB(0, 0, 0)
    Fill 444 * fx, 74 * fy To RGB(0, 0, 0)
  Case 220, 252             ' Ü
    Fill 497 * fx, 76 * fy To RGB(0, 0, 0)
  Case 42, 43, 126          ' *
    Fill 533 * fx, 76 * fy To RGB(0, 0, 0)
  Case 65, 97               ' A
    Fill 116 * fx, 114 * fy To RGB(0, 0, 0)
    Fill 132 * fx, 114 * fy To RGB(0, 0, 0)
  Case 83, 115              ' S
    Fill 169 * fx, 114 * fy To RGB(0, 0, 0)
  Case 68, 100              ' D
    Fill 191 * fx, 114 * fy To RGB(0, 0, 0)
    Fill 206 * fx, 114 * fy To RGB(0, 0, 0)
  Case 70, 102              ' F
    Fill 244 * fx, 114 * fy To RGB(0, 0, 0)
  Case 71, 103              ' G
    Fill 283 * fx, 114 * fy To RGB(0, 0, 0)
  Case 72, 104              ' H
    Fill 320 * fx, 114 * fy To RGB(0, 0, 0)
  Case 74, 106              ' J
    Fill 357 * fx, 114 * fy To RGB(0, 0, 0)
  Case 75, 107              ' K
    Fill 398 * fx, 114 * fy To RGB(0, 0, 0)
  Case 76, 108              ' L
    Fill 435 * fx, 114 * fy To RGB(0, 0, 0)
  Case 214, 246             ' Ö
    Fill 457 * fx, 114 * fy To RGB(0, 0, 0)
    Fill 472 * fx, 114 * fy To RGB(0, 0, 0)
  Case 196, 228             ' Ä
    Fill 495 * fx, 114 * fy To RGB(0, 0, 0)
    Fill 510 * fx, 114 * fy To RGB(0, 0, 0)
  Case 35, 39               ' #
    Fill 546 * fx, 114 * fy To RGB(0, 0, 0)
    Fill 532 * fx, 129 * fy To RGB(0, 0, 0)
  Case 60, 62, 124, 166     ' <
    Fill 107 * fx, 160 * fy To RGB(0, 0, 0)
  Case 89, 121              ' Y
    Fill 152 * fx, 160 * fy To RGB(0, 0, 0)
  Case 88, 120              ' X
    Fill 189 * fx, 160 * fy To RGB(0, 0, 0)
  Case 67, 99               ' C
    Fill 229 * fx, 160 * fy To RGB(0, 0, 0)
  Case 86, 118              ' V
    Fill 266 * fx, 160 * fy To RGB(0, 0, 0)
  Case 66, 98               ' B
    Fill 303 * fx, 160 * fy To RGB(0, 0, 0)
    Fill 289 * fx, 150 * fy To RGB(0, 0, 0)
    Fill 289 * fx, 155 * fy To RGB(0, 0, 0)
  Case 78, 110              ' N
    Fill 339 * fx, 160 * fy To RGB(0, 0, 0)
  Case 77, 109, 181         ' M
    Fill 379 * fx, 160 * fy To RGB(0, 0, 0)
  Case 44, 59               ' ,
    Fill 414 * fx, 160 * fy To RGB(0, 0, 0)
  Case 46, 58               ' .
    Fill 453 * fx, 160 * fy To RGB(0, 0, 0)
  Case 45, 95               ' -
    Fill 490 * fx, 160 * fy To RGB(0, 0, 0)
  EndSelect
  If art| > 1
    Select z%
    Case 33, 34, 36 To 42, 47, 58, 59, 61 To 63, 65 To 90, 95, 167, 176, 196, 214, 220, 232 ' Shift
      Fill 77 * fx, 160 * fy To RGB(0, 0, 0)
      Fill 56 * fx, 153 * fy To RGB(0, 0, 0)
      Fill 580 * fx, 160 * fy To RGB(0, 0, 0)
      Fill 518 * fx, 153 * fy To RGB(0, 0, 0)
    EndSelect
    Select z%
    Case 64, 91 To 93, 123 To 126, 128, 178, 179, 181 ' Alternate GR
      Fill 481 * fx, 190 * fy To RGB(0, 0, 0)
      Fill 462 * fx, 199 * fy To RGB(0, 0, 0)
    EndSelect
  EndIf
Return
>Procedure input1    ' vorgegebene Übungen, Diktate, Texteingabe
  Clr e$, z%, wort1%
  If texteing% = 0
    Clr pfeil|
  EndIf
  If texteing% = 1
    antwort$ = txt$(iii%)
  Else
    Clr antwort$
  EndIf
  stelle% = 1
  GraphMode R2_COPYPEN, TRANSPARENT
  SetFont schrift3%
  Do
    antwx% = 42 * fx + TxtLen(antwort$)
    If pfeilw% = 0 Or pos% = Len(antwort$)
      Color RGB(255, 0, 0) ' rot
      Box antwx%, antwy%, antwx% + 16 * fx, antwy% + 16 * fy
    EndIf
    If art| < 8 Or (hilfe| = 2 Or fehler_% = 1) And a12| = 0
      Color RGB(255, 255, 198) ' creme
      ascii
      z% = Asc(Left$(Mid$(z_$, stelle%, 1)))
      Color RGB(255, 0, 0) ' rot
      ascii
      Repeat
        PeekEvent
      Until InKey$ = ""
    EndIf
    If z% = 232 Or z% = 233 Or z% = 234
      Color RGB(0, 0, 0) ' schwarz
      SetFont schrift1%
      Text 42 * fx, 400 * fy, "Schreibe zuerst den Akzent, dann das kleine e!"
      SetFont schrift3%
    EndIf
    Repeat
      Sleep
      e$ = InKey$
      Exit If Or(e$ = "ß", e$ = "Ä", e$ = "ä", e$ = "Ö", e$ = "ö", e$ = "Ü", e$ = "ü", e$ = "²", e$ = "³", e$ = "§", e$ = "°", e$ = "µ", e$ = "é", e$ = "è", e$ = "ê", (Asc(e$) > 31 And Asc(e$) < 127 Or Asc(e$) = 128) And Len(e$) = 1)
      Exit If Len(e$) = 2 And texteing% = 1 And (Asc(Right$(e$)) = 37 Or Asc(Right$(e$)) = 38 Or Asc(Right$(e$)) = 39 Or Asc(Right$(e$)) = 40) ' Pfeiltasten
    Until e$ = Chr$(13)  Or e$ = Chr$(8) Or (Len(e$) = 2 And Asc(Right$(e$)) = 119) Or (Len(e$) = 2 And Asc(Right$(e$)) = 112)
    If Len(e$) > 1 And Asc(Right$(e$)) = 112         ' F1-Taste
      If hilfe| = 2
        hilfe| = 1
        If a12| = 1
          Color RGB(255, 255, 198) ' creme
          PBox 40 * fx, 280 * fy, 500 * fx, 309 * fy
        Else If art| > 7 And a12| = 0
          Color RGB(255, 255, 198) ' creme
          ascii
        EndIf
      Else
        hilfe| = 2
        hilferuf| = 1
        If gross| = 1 Or fehler_% = 1
          Color RGB(0, 0, 235) ' blau
          If a12| = 0
            Text 42 * fx, 300 * fy, z_$
          Else
            Text 42 * fx, 285 * fy, z_$
          EndIf
        Else
          SetFont schrift2%
          Repeat
            PeekEvent
            aa% = InStr(zz_$, "ß")
            If aa% > 1
              zz_$ = Left$(zz_$, aa% - 1) + "ss" + Right$(zz_$, Len(zz_$) - aa%)
            EndIf
          Until aa% < 2
          Color RGB(0, 0, 235) ' blau
          If a12| = 0
            Text 42 * fx, 300 * fy, Upper$(zz_$)
          Else
            Text 42 * fx, 286 * fy, Upper$(zz_$)
          EndIf
          SetFont schrift3%
        EndIf
      EndIf
    EndIf
    If z% = 232 Or z% = 233 Or z% = 234
      Color RGB(255, 255, 198) ' creme
      PBox 40 * fx, 370 * fy, 500 * fx, 425 * fy
    EndIf
    If a12| = 1 And hilfe| = 1 And falsch1| = 0 And e$ <> "" And beginn| = 1
      Clr beginn|
      Color RGB(255, 255, 198) ' creme
      PBox 40 * fx, 280 * fy, 500 * fx, 309 * fy
    EndIf
    If ((art| > 7 And art| < 12) Or (a12| = 0 And schreib| > 1)) And hilfe| = 1 And falsch1| = 0 And e$ <> ""
      Clr beginn|
      Color RGB(255, 255, 198) ' creme
      PBox 40 * fx, 298 * fy, 510 * fx, 324 * fy
    EndIf
    Color RGB(255, 255, 198) ' creme
    Box antwx%, antwy%, antwx% + 16 * fx, antwy% + 16 * fy
    If e$ = Chr$(13)                                      ' Return
      If texteing% = 1
        leerzeichen
      EndIf
      Inc wort1%
      Exit If e$ = Chr$(13)                            ' Return
    EndIf
    If Len(e$) > 1 And Asc(Right$(e$)) = 119              ' F8-Taste
      If texteing% = 0
        ende| = 1
        Add richtig1%, wort1%
        kontrolle
      Else
        x_$ = e$
        GoTo weiter
      EndIf
    Else If e$ = Chr$(8)                                   ' Backspace
      If texteing% = 1 And pos% > 0 And Len(antwort$) > 0
        Dec pos%
        antwort$ = Left$(antwort$, pos%) + Right$(antwort$, Len(antwort$) - pos% - 1)
        Color RGB(255, 255, 198) ' creme
        PBox 42 * fx + TxtLen(Left$(antwort$, pos%)), antwy% - 2 * fy, 500 * fx, antwy% + zeichenh% - Int(fy)
        Color RGB(0, 0, 0) ' schwarz
        Text 42 * fx, Round(antwy% - 3 * fy), antwort$
        altposx% = 42 * fx + TxtLen(Left$(antwort$, pos%))
        altposy% = antwy%
        Color RGB(255, 0, 0) ' rot
        Line 42 * fx + TxtLen(Left$(antwort$, pos%)), antwy%, 42 * fx + TxtLen(Left$(antwort$, pos%)), antwy% + 16 * fy
        antwx% = 42 * fx + TxtLen(antwort$)
      Else If pfeilw% = 0
        If (Len(antwort$) > 0)
          antwort$ = Left$(antwort$, Len(antwort$) - 1)
          Dec stelle%
          antwx% = 42 * fx + TxtLen(antwort$)
          Color RGB(255, 255, 198) ' creme
          If texteing% = 1
            PBox antwx% - Int(fx), antwy% - 2 * fy, antwx% + 22 * fx, antwy% + zeichenh% - Int(fy)
          Else
            PBox antwx% - Int(fx), antwy% - 4 * fy, antwx% + 22 * fx, antwy% + zeichenh%
          EndIf
        EndIf
      EndIf
    Else If Len(e$) = 2 And Asc(Right$(e$)) = 40 And texteing% = 1  ' Pfeil nach unten
      Clr beginn1|, pfeilw%, pos%
      If altposx% <> 0
        Color RGB(255, 255, 198) ' creme
        Line altposx%, altposy%, altposx%, altposy% + 16 * fy
        Clr altposx%, altposy%
      EndIf
      If txt$(iii%) <> "" And txt$(iii% + 1) <> ""
        leerzeichen
        txt$(iii%) = antwort$
        Inc iii%
        pfeil| = 1
        antwort$ = txt$(iii%)
        GoTo weiter
      EndIf
    Else If Len(e$) = 2 And Asc(Right$(e$)) = 38 And texteing% = 1  ' Pfeil nach oben
      Clr beginn1|, pfeilw%
      If altposx% <> 0
        Color RGB(255, 255, 198) ' creme
        Line altposx%, altposy%, altposx%, altposy% + 16 * fy
        Clr altposx%, altposy%
      EndIf
      If iii% > 1
        leerzeichen
        pfeil| = 1
        txt$(iii%) = antwort$
        Dec iii%
        antwort$ = txt$(iii%)
        GoTo weiter
      EndIf
    Else If Len(e$) > 1 And Asc(Right$(e$)) = 37 And texteing% = 1  ' Pfeil nach links
      pfeil| = 1
      pfeilw% = 1
      If beginn1| = 0
        beginn1| = 1
        pos% = Len(antwort$)
      EndIf
      If pos% > 0
        Dec pos%
        If pos% < Len(antwort$) - 1
          Color RGB(255, 255, 198) ' creme
          Line altposx%, antwy%, altposx%, antwy% + 16 * fy
        EndIf
        altposx% = 42 * fx + TxtLen(Left$(antwort$, pos%))
        altposy% = antwy%
        Color RGB(255, 0, 0) ' rot
        Line 42 * fx + TxtLen(Left$(antwort$, pos%)), antwy%, 42 * fx + TxtLen(Left$(antwort$, pos%)), antwy% + 16 * fy
      EndIf
      GoTo weiter
    Else If Len(e$) = 2 And Asc(Right$(e$)) = 39 And texteing% = 1  ' Pfeil nach rechts
      pfeil| = 1
      pfeilw% = 1
      If beginn1| = 0
        beginn1| = 1
        pos% = Len(antwort$)
      EndIf
      If pos% < Len(antwort$)
        Inc pos%
        Color RGB(255, 255, 198) ' creme
        Line altposx%, antwy%, altposx%, antwy% + 16 * fy
        altposx% = 42 * fx + TxtLen(Left$(antwort$, pos%))
        altposy% = antwy%
        Color RGB(255, 0, 0) ' rot
        Line 42 * fx + TxtLen(Left$(antwort$, pos%)), antwy%, 42 * fx + TxtLen(Left$(antwort$, pos%)), antwy% + 16 * fy
      EndIf
      GoTo weiter
    Else If Or(e$ = "ß", e$ = "Ä", e$ = "ä", e$ = "Ö", e$ = "ö", e$ = "Ü", e$ = "ü", e$ = "²", e$ = "³", e$ = "§", e$ = "°", e$ = "µ", e$ = "é", e$ = "è", e$ = "ê", (Asc(e$) > 31 And Asc(e$) < 127 Or Asc(e$) = 128))
      If art| = 1 Then e$ = Upper$(e$)
      SetFont schrift3%
      If e$ = Chr$(34) And art| > 7                                       ' Anführungszeichen
        If texteing% = 0
          If Right$(antwort$) = " " Or antwort$ = ""
            e$ = Chr$(132)    ' Ersetzen durch Anführungszeichen unten
          Else
            e$ = Chr$(147)    ' Ersetzen durch Anführungszeichen oben
          EndIf
        Else
          If pfeilw% = 1
            If Mid$(antwort$, pos%, 1) = " " Or pos% = 0
              e$ = Chr$(132)    ' Ersetzen durch Anführungszeichen unten
            Else
              e$ = Chr$(147)    ' Ersetzen durch Anführungszeichen oben
            EndIf
          Else
            If Right$(antwort$) = " " Or antwort$ = ""
              e$ = Chr$(132)    ' Ersetzen durch Anführungszeichen unten
            Else
              e$ = Chr$(147)    ' Ersetzen durch Anführungszeichen oben
            EndIf
          EndIf
        EndIf
      EndIf
      If (TxtLen(antwort$) < 450 * fx And texteing% = 0) Or (TxtLen(Upper$(antwort$)) < 490 * fx And texteing% = 1)
        If texteing% = 0 Or (texteing% = 1 And beginn1| = 0)
          antwort$ = antwort$ + e$
        Else
          antwort$ = Left$(antwort$, pos%) + e$ + Right$(antwort$, Len(antwort$) - pos%)
          Color RGB(255, 255, 198) ' creme
          PBox 42 * fx + TxtLen(Left$(antwort$, pos%)), antwy% - 2 * fy, 500 * fx, antwy% + zeichenh% - Int(fy)
          If pos% < Len(antwort$) - 1 And altposx% <> 0
            Color RGB(255, 255, 198) ' creme
            Line altposx%, antwy%, altposx%, antwy% + 16 * fy
          EndIf
          Inc pos%
          altposx% = 42 * fx + TxtLen(Left$(antwort$, pos%))
          altposy% = antwy%
          Color RGB(255, 0, 0) ' rot
          Line 42 * fx + TxtLen(Left$(antwort$, pos%)), antwy%, 42 * fx + TxtLen(Left$(antwort$, pos%)), antwy% + 16 * fy
          antwx% = 42 * fx + TxtLen(antwort$)
        EndIf
        Color RGB(255, 255, 198) ' creme
        Box antwx%, antwy%, antwx% + 16 * fx, antwy% + 16 * fy
        Color RGB(0, 0, 0) ' schwarz
        Text 42 * fx, Round(antwy% - 3 * fy), antwort$
        If Asc(Right$(antwort$)) = 32 And texteing% = 0        ' Leerzeichen
          If wort1% < wort_% And Right$(antwort$, 3) <> " - "
            Inc wort1%              ' richtige Wörter in einer Zeile
          EndIf
          If antwort$ <> Left$(z_$, stelle%)
            If Len(antwort$) > Len(z_$)
              If a12| = 1
                SetFont schrift1%
                If einzelner| = 1
                  Text 42 * fx, 400 * fy, "Schreibe ans Ende einer Zeile kein Leerzeichen!"
                Else
                  Text 42 * fx, 400 * fy, "Schreibt ans Ende einer Zeile kein Leerzeichen!"
                EndIf
              EndIf
              j# = oTimer
              Repeat
                PeekEvent
                zeitneu# = oTimer
              Until zeitneu# > j# + 2000
              Color RGB(255, 255, 198) ' creme
              PBox 40 * fx, 390 * fy, 500 * fx, 425 * fy
              antwort$ = Left$(antwort$, stelle% - 1)
              If antwort$ = z_$
                GoTo weiter
              EndIf
            EndIf
            fehler_% = 1
            falsch1| = 1
            falsch
            GoTo weiter
          EndIf
        EndIf
        Inc stelle%
      EndIf
      SetFont schrift3%
    EndIf
  Loop
  Clr beginn1|, pfeil|, pfeilw%
  If altposx% > 0 And texteing% = 1
    Color RGB(255, 255, 198) ' creme
    Line altposx%, antwy%, altposx%, antwy% + 16 * fy
    Clr altposx%, altposy%
  EndIf
  weiter:
Return
>Procedure leerzeichen
  If Left$(antwort$) = " " Or Right$(antwort$) = " " Or InStr(antwort$, "  ") > 0
    Repeat
      PeekEvent
      x% = InStr(antwort$, "  ")
      If x% <> 0
        antwort$ = Left$(antwort$, x%) + Right$(antwort$, Len(antwort$) - x% - 1)
      EndIf
    Until x% = 0
    If Left$(antwort$) = " "
      antwort$ = Right$(antwort$, Len(antwort$) - 1)
    EndIf
    If Right$(antwort$) = " "
      antwort$ = Left$(antwort$, Len(antwort$) - 1)
    EndIf
    Color RGB(255, 255, 198) ' creme
    PBox 42 * fx, antwy% - 2 * fy, 500 * fx, antwy% + zeichenh% - Int(fy)
    Color RGB(0, 0, 0) ' schwarz
    Text 42 * fx, Round(antwy% - 3 * fy), antwort$
  EndIf
Return
>Procedure input2    ' Texte, Wortschatz
  Clr e$, ix%
  i% = 1
  If hilfe| = 1 And beginn| = 1
    Clr beginn|
    Color RGB(180, 255, 255) ' hell blaugrün
    PBox 34 * fx, 183 * fy, 505 * fx, 213 * fy
  EndIf
  If (hilfe| = 2 Or fehler_% = 1) And alph% = 2 And beginn| = 0
    beginn| = 1
    Color RGB(180, 255, 255) ' hell blaugrün
    PBox 34 * fx, 183 * fy, 505 * fx, 213 * fy
    SetFont schrift1%
    Color RGB(255, 0, 0) ' rot
    Select iii%
    Case 2
      Text 42 * fx, 188 * fy, "Begleiter sind: der, die, das"
    Case 4
      Text 42 * fx, 188 * fy, "Suche Tuwörter: ich kann ..."
    Case 6
      Text 42 * fx, 188 * fy, "Suche Wiewörter: ich bin ..."
    EndSelect
  EndIf
  DefLine 0, 1
  GraphMode R2_COPYPEN, TRANSPARENT
  Do
    antwx% = 70 * fx + TxtLen(antw_$(iii% / faktor%))
    Color RGB(255, 0, 0) ' rot
    Box antwx%, antwy%, antwx% + 14 * fx, antwy% + 16 * fy
    f19:
    Repeat
      Sleep
      e$ = InKey$
      Exit If e$ = Chr$(8) Or (Asc(e$) > 64 And Asc(e$) < 91 Or (Asc(e$) > 96 And Asc(e$) < 123) And Len(e$) = 1)
    Until Or(e$ = Chr$(13), e$ = " ", e$ = "Ä", e$ = "Ö", e$ = "Ü", e$ = "ä", e$ = "ö", e$ = "ü", e$ = "ß", Len(e$) = 2 And (Asc(Right$(e$)) = 119 Or Asc(Right$(e$)) = 112), And(Len(e$) = 2, Asc(Right$(e$)) = 38 Or Asc(Right$(e$)) = 40, art| < 77))
    If Len(e$) = 2 And Asc(Right$(e$)) = 112                ' F1-Taste
      If hilfe| = 2
        hilfe| = 1
        Color RGB(180, 255, 255) ' hell blaugrün
        PBox 34 * fx, 183 * fy, 505 * fx, 213 * fy
      Else
        hilfe| = 2
        hilferuf| = 1
        Color RGB(180, 255, 255) ' hell blaugrün
        PBox 34 * fx, 183 * fy, 505 * fx, 213 * fy
        If alph% = 2
          Color RGB(180, 255, 255) ' hell blaugrün
          PBox 34 * fx, 183 * fy, 505 * fx, 213 * fy
          SetFont schrift1%
          Color RGB(255, 0, 0) ' rot
          Select iii%
          Case 2
            Text 42 * fx, 188 * fy, "Begleiter sind: der, die, das"
          Case 4
            Text 42 * fx, 188 * fy, "Suche Tuwörter: ich kann ..."
          Case 6
            Text 42 * fx, 188 * fy, "Suche Wiewörter: ich bin ..."
          EndSelect
        Else If art| > 76
          Color RGB(180, 255, 255) ' hell blaugrün
          PBox 34 * fx, 183 * fy, 505 * fx, 213 * fy
          Color RGB(255, 0, 0) ' rot
          Text 70 * fx, 188 * fy, txt$(jj%)
        Else
          Color RGB(255, 0, 0) ' rot
          SetFont schrift3%
          Text 70 * fx, 188 * fy, Right$(txt$(iii%), Len(txt$(iii%)) - 1)
        EndIf
      EndIf
      GoTo f19
    EndIf
    If Asc(Right$(e$)) <> 38 And Asc(Right$(e$)) <> 40
      Clr pfeil1|
    EndIf
    If pfeil1| = 0 And hilfe| = 1
      Color RGB(180, 255, 255) ' hell blaugrün
      PBox 34 * fx, 183 * fy, 505 * fx, 213 * fy
    EndIf
    Color RGB(255, 255, 198) ' creme
    Box antwx%, antwy%, antwx% + 14 * fx, antwy% + 16 * fy
    Exit If e$ = Chr$(13)                            ' Return
    If Len(e$) > 1 And Asc(Right$(e$)) = 119            ' F8-Taste
      ende| = 1
      kontrolle
    Else If e$ = Chr$(8)                                 ' Backspace
      If Len(antw_$(iii% / faktor%)) > 0
        antw_$(iii% / faktor%) = Left$(antw_$(iii% / faktor%), Len(antw_$(iii% / faktor%)) - 1)
        Dec i%
        Color RGB(255, 255, 198) ' creme
        antwx% = 70 * fx + TxtLen(antw_$(iii% / faktor%))
        If art| < 77
          PBox antwx% - Int(fx), antwy% - 2 * fy, antwx% + zeichenh%, antwy% + zeichenh% - Int(fy)
        Else
          PBox antwx% - Int(fx), antwy% - 2 * fy, antwx% + zeichenh%, antwy% + zeichenh%
        EndIf
      EndIf
    Else If Len(e$) = 2 And Asc(Right$(e$)) = 40 And antw_$(iii%) = "" ' Pfeil unten
      pfeil1| = 1
      If alph% = 2
        If iii% < 7
          Add iii%, 2
        EndIf
        antwy% = 212 * fy + Int(zeichenh% * 1.25) * iii%
      Else
        jj% = iii%
        Repeat
          PeekEvent
          Inc jj%
        Until antw_$(jj%) = "" Or jj% > 8
        If iii% < 8 And iii% < jj% And jj% < 9 And txt$(jj%) <> ""
          iii% = jj%
          antwy% = 212 * fy + Int(zeichenh% * 1.25) * iii%
          If alph% = 2
            z_$ = txt$(iii%)
          Else
            z_$ = Right$(txt$(iii%), Len(txt$(iii%)) - 1)
          EndIf
        EndIf
      EndIf
      If iii% < 1
        iii% = 1
      Else If iii% > 8
        iii% = 8
      EndIf
      If (hilfe| = 2 Or fehler_% = 1) And ix% <> iii%
        ix% = iii%
        Color RGB(180, 255, 255) ' hell blaugrün
        PBox 34 * fx, 183 * fy, 505 * fx, 213 * fy
        If alph% = 2
          SetFont schrift1%
          Color RGB(255, 0, 0) ' rot
          Select iii%
          Case 2
            Text 42 * fx, 188 * fy, "Begleiter sind: der, die, das"
          Case 4
            Text 42 * fx, 188 * fy, "Suche Tuwörter: ich kann ..."
          Case 6
            Text 42 * fx, 188 * fy, "Suche Wiewörter: ich bin ..."
          EndSelect
        Else
          Color RGB(255, 0, 0) ' rot
          SetFont schrift3%
          Text 70 * fx, 188 * fy, Right$(txt$(iii%), Len(txt$(iii%)) - 1)
        EndIf
      EndIf
      Color RGB(0, 0, 0) ' schwarz
    Else If Len(e$) = 2 And Asc(Right$(e$)) = 38 And antw_$(iii%) = "" ' Pfeil oben
      pfeil1| = 1
      If alph% = 2
        If iii% > 2
          Sub iii%, 2
        EndIf
        antwy% = 212 * fy + Int(zeichenh% * 1.25) * iii%
      Else
        jj% = iii%
        Repeat
          PeekEvent
          Dec jj%
        Until antw_$(jj%) = "" Or jj% < 1
        If iii% > 1 And iii% > jj% And jj% > 0
          iii% = jj%
          antwy% = 212 * fy + Int(zeichenh% * 1.25) * iii%
          If alph% = 2
            z_$ = txt$(iii%)
          Else
            z_$ = Right$(txt$(iii%), Len(txt$(iii%)) - 1)
          EndIf
        EndIf
      EndIf
      If iii% < 1
        iii% = 1
      Else If iii% > 8
        iii% = 8
      EndIf
      If (hilfe| = 2 Or fehler_% = 1) And ix% <> iii%
        ix% = iii%
        Color RGB(180, 255, 255) ' hell blaugrün
        PBox 34 * fx, 183 * fy, 505 * fx, 213 * fy
        If alph% = 2
          SetFont schrift1%
          Color RGB(255, 0, 0) ' rot
          Select iii%
          Case 2
            Text 42 * fx, 188 * fy, "Begleiter sind: der, die, das"
          Case 4
            Text 42 * fx, 188 * fy, "Suche Tuwörter: ich kann ..."
          Case 6
            Text 42 * fx, 188 * fy, "Suche Wiewörter: ich bin ..."
          EndSelect
        Else
          Color RGB(255, 0, 0) ' rot
          SetFont schrift3%
          Text 70 * fx, 188 * fy, Right$(txt$(iii%), Len(txt$(iii%)) - 1)
        EndIf
      EndIf
      Color RGB(0, 0, 0) ' schwarz
    Else If Or(e$ = "ß", e$ = "Ä", e$ = "ä", e$ = "Ö", e$ = "ö", e$ = "Ü", e$ = "ü", e$ = "²", e$ = "³", e$ = "§", e$ = "°", e$ = "µ", e$ = "é", e$ = "è", e$ = "ê", And(Asc(e$) > 31, Asc(e$) < 127, Len(e$) = 1))
      If alph% = 1 And hilfe| = 1 And fehler_% = 0
        Color RGB(255, 255, 198) ' creme
        If m|(iii%) < 5
          PBox 68 * fx, 43 * fy + Int(zeichenh% * 1.25) * m|(iii%), 270 * fx, 68 * fy + Int(zeichenh% * 1.25) * m|(iii%)
        Else
          PBox 270 * fx, 43 * fy + Int(zeichenh% * 1.25) * (m|(iii%) - 4), 505 * fx, 68 * fy + Int(zeichenh% * 1.25) * (m|(iii%) - 4)
        EndIf
      EndIf
      If alph% = 3 And hilfe| = 1 And fehler_% = 0
        Color RGB(255, 255, 198) ' creme
        If iii% < 5
          PBox 68 * fx, 43 * fy + Int(zeichenh% * 1.25) * (iii%), 270 * fx, 68 * fy + Int(zeichenh% * 1.25) * (iii%)
        Else
          PBox 270 * fx, 43 * fy + Int(zeichenh% * 1.25) * (iii% - 4), 505 * fx, 68 * fy + Int(zeichenh% * 1.25) * (iii% - 4)
        EndIf
      EndIf
      If Len(antw_$(iii% / faktor%)) < 27 And Len(e$) = 1 And Asc(e$) <> 8 ' ASC 8: Backspace
        antw_$(iii% / faktor%) = antw_$(iii% / faktor%) + e$
        Color RGB(255, 255, 198) ' creme
        Box antwx%, antwy%, antwx% + 14 * fx, antwy% + 16 * fy
        Color RGB(0, 0, 0) ' schwarz
        SetFont schrift3%
        If art| < 77
          Text 70 * fx, 209 * fy + Int(zeichenh% * 1.25) * iii%, antw_$(iii% / faktor%)
        Else
          Text 70 * fx, antwy% - 3 * fy, antw_$(iii% / faktor%)
        EndIf
        If Right$(antw_$(iii% / faktor%)) = " "
          If antw_$(iii% / faktor%) <> Left$(z_$, i%) And alph% <> 2
            If Left$(antw_$(iii% / faktor%), i% - 1) = z_$
              SetFont schrift1%
              If einzelner| = 1
                Text 42 * fx, 188 * fy, "Schreibe ans Ende einer Zeile kein Leerzeichen!"
              Else
                Text 42 * fx, 188 * fy, "Schreibt ans Ende einer Zeile kein Leerzeichen!"
              EndIf
              Dec i%
              j# = oTimer
              Repeat
                PeekEvent
                zeitneu# = oTimer
              Until zeitneu# > j# + 2000
              Color RGB(180, 255, 255) ' hell blaugrün
              PBox 34 * fx, 183 * fy, 505 * fx, 213 * fy
              antw_$(iii% / faktor%) = z_$
              GoTo weiter1
            EndIf
          EndIf
        EndIf
        If alph% = 2 And iii% = 2 And Len(antw_$(iii%)) > 4 And Left$(antw_$(iii%), 4) <> "der " And Left$(antw_$(iii%), 4) <> "die " And Left$(antw_$(iii%), 4) <> "das "
          Color RGB(180, 255, 255) ' hell blaugrün
          PBox 34 * fx, 183 * fy, 505 * fx, 213 * fy
          Color RGB(0, 0, 0) ' schwarz
          SetFont schrift1%
          If einzelner| = 1
            Text 42 * fx, 188 * fy, "Vergiss nicht den Begleiter des Namenworts!"
          Else
            Text 42 * fx, 188 * fy, "Vergesst nicht den Begleiter des Namenworts!"
          EndIf
          j# = oTimer
          Repeat
            PeekEvent
            zeitneu# = oTimer
          Until zeitneu# > j# + 2000
          Color RGB(180, 255, 255) ' hell blaugrün
          PBox 34 * fx, 183 * fy, 505 * fx, 213 * fy
          GoTo weiter1
        EndIf
        Inc i% 'Stelle innerhalb des Worts
      EndIf
    EndIf
  Loop
  weiter1:
Return
>Procedure texteingabe
  DefMouse 0
  texteing% = 1
  If schreib| = 0
    Repeat
      PeekEvent
    Until _Mess = 0
    alert1("Wählen Sie zuerst aus: Schreiben 1 bis 4,", "drücken Sie danach 'T'!", "OK")
    hauptmenue
  EndIf
  menue0
  Select schreib|
  Case 1
    menue1
  Case 2
    menue2
  Case 3
    menue3
  Case 4
    menue4
  EndSelect
  Color RGB(255, 255, 255) ' weiß
  SetFont schrift2%
  Text 250 * fx, 43 * fy, "Texteingabe"
  menueabfrage
  SetFont schrift3%
  If a12| = 0
    DefMouse 0
    Repeat
      PeekEvent
    Until _Mess = 0
    alert1("Sie können nur Felder wählen,", "die für Texte vorgesehen sind!", "OK")
    hauptmenue
  EndIf
  text1$ = "TEXTE\TEXT" + Trim$(Str$(schreib|)) + "_" + Trim$(Str$(art| - (schreib| - 1) * 13)) + ".TXT"
  If Exist(text1$) <> 0
    DefMouse 0
    Repeat
      PeekEvent
    Until _Mess = 0
    alert2("Text ändern - oder neuer Text?", "ändern", "neu")
    Repeat
      PeekEvent
    Until _Mess = 0
    If alert| = 1
      Open text1$ for Input As # 1
      Line Input # 1, txt$(1)
      iii% = Val(txt$(1))
      For i% = 1 To iii%
        Line Input # 1, txt$(i%)
      Next i%
      Close # 1
      zeile% = iii%
      gesamt% = iii%
      textblatt
      lineatur
      Color RGB(0, 0, 0) ' schwarz
      For i% = 1 To Min(zeile%, 16)
        antwy% = i% * Int(zeichenh% * 1.25)
        Text 42 * fx, Round(antwy% - 3 * fy), txt$(i%)
      Next i%
      GoTo aendern
    EndIf
  EndIf
  Repeat
    PeekEvent
  Until _Mess = 0
  textblatt
  lineatur
  GraphMode R2_COPYPEN, TRANSPARENT
  aendern:
  DefMouse 0
  Repeat
    PeekEvent
  Until _Mess = 0
  Get (319 - 245) * fx, (239 - 65) * fy, (319 + 245) * fx, (239 + 65) * fy, alertf$
  alert1("Abschluss jeder Zeile: Return! * Ändern fertiger", "Zeilen: Backspace, Pfeiltasten! * Fertig: F8!", "OK")
  Put (319 - 245) * fx, (239 - 65) * fy, alertf$
  Clr alertf$
  seite% = 1
  iii% = 1
  DefMouse V:aaa%(0)        ' transparente Mausform
  Repeat
    PeekEvent
    antwy% = iii% * Int(zeichenh% * 1.25)
    If seite% = 2
      Sub antwy%, 14 * Int(zeichenh% * 1.25)
    Else If seite% = 3
      Sub antwy%, 28 * Int(zeichenh% * 1.25)
    EndIf
    altiii% = iii%
    input1
    txt$(iii%) = antwort$
    If pfeil| = 0
      If txt$(iii%) = ""
        Dec iii%
      EndIf
      Inc iii%
    EndIf
    If gesamt% < iii%
      gesamt% = iii%
    EndIf
    If txt$(altiii%) = "" And txt$(altiii% + 1) <> ""
      iii% = altiii%
    EndIf
    If iii% = 14 And seite% = 2
      seite% = 1
      Put 0, 0, textbl1$
      lineatur
      For i% = 1 To 16
        antwy% = i% * Int(zeichenh% * 1.25)
        Text 42 * fx, Round(antwy% - 3 * fy), txt$(i%)
      Next i%
    EndIf
    If iii% = 17 And seite% = 1
      seite% = 2
      Put 0, 0, textbl1$
      lineatur
      For i% = 15 To Min(gesamt%, 30)
        antwy% = (i% - 14) * Int(zeichenh% * 1.25)
        Text 42 * fx, Round(antwy% - 3 * fy), txt$(i%)
      Next i%
    EndIf
    If iii% = 28 And seite% = 3
      seite% = 2
      Put 0, 0, textbl1$
      lineatur
      For i% = 15 To 30
        antwy% = (i% - 14) * Int(zeichenh% * 1.25)
        Text 42 * fx, Round(antwy% - 3 * fy), txt$(i%)
      Next i%
    EndIf
    If iii% = 31 And seite% = 2
      seite% = 3
      Put 0, 0, textbl1$
      lineatur
      For i% = 29 To gesamt%
        antwy% = (i% - 28) * Int(zeichenh% * 1.25)
        Text 42 * fx, Round(antwy% - 3 * fy), txt$(i%)
      Next i%
    EndIf
    Clr anzahl%
    For i% = 1 To iii%
      For jjj% = 1 To Len(txt$(i%))
        If Asc(Mid$(txt$(i%), jjj%, 1)) = 32
          Inc anzahl%
        Else If Asc(Mid$(txt$(i%), jjj%, 1)) = 45 And Asc(Mid$(txt$(i%), jjj% - 1, 1)) = 32
          Dec anzahl%
        EndIf
      Next jjj%
    Next i%
    If txt$(iii%) <> ""
      Add anzahl%, iii%
    Else
      Add anzahl%, iii% - 1
    EndIf
    SetFont schrift1%
    Color RGB(180, 255, 255) ' hell blaugrün
    PBox 510 * fx + TxtLen("Wortzahl:"), 385 * fy, 625 * fx, 412 * fy
    Color RGB(0, 0, 0) ' schwarz
    Text 620 * fx - TxtLen(Trim$(Str$(anzahl%))), 390 * fy, Trim$(Str$(anzahl%))
    SetFont schrift3%
  Until (Len(x_$) = 2 And Asc(Right$(x_$)) = 119) Or iii% = 45
  DefMouse 0
  If txt$(1) <> ""
    iii% = 1
    Do
      Exit If txt$(iii%) = ""
      Inc iii%
    Loop
    Dec iii%
    wiederhol:
    If Exist(text1$) <> 0
      Repeat
        PeekEvent
      Until _Mess = 0
      alert2("Soll der alte Text " + Mid$(text1$, 11, Len(text1$) - RInStr(text1$, "\")) + " gelöscht werden?", "ja", "nein")
      Repeat
        PeekEvent
      Until _Mess = 0
      If alert| = 1
        Kill text1$
      Else
        If Val(Mid$(text1$, RInStr(text1$, ".") - 2, 2)) < 13
          If Mid$(text1$, RInStr(text1$, ".") - 2, 1) = "1"
            text1$ = Left$(text1$, RInStr(text1$, ".") - 3) + Trim$(Str$(Val(Mid$(text1$, RInStr(text1$, ".") - 2, 2)) + 1)) + ".TXT"
          Else
            text1$ = Left$(text1$, RInStr(text1$, ".") - 2) + Trim$(Str$(Val(Mid$(text1$, RInStr(text1$, ".") - 1, 1)) + 1)) + ".TXT"
          EndIf
          GoTo wiederhol
        Else
          text1$ = "TEXTE\T.TXT"
        EndIf
      EndIf
    EndIf
    Repeat
      PeekEvent
    Until _Mess = 0
    alert2("Ihr Text wird unter Text " + Mid$(text1$, 11, Len(text1$) - RInStr(text1$, "\")) + " gespeichert.", "OK", "Abbruch")
    Repeat
      PeekEvent
    Until _Mess = 0
    If alert| = 1
      Open text1$ for Output As # 1
      Print # 1, Trim$(Str$(iii%))
      For i% = 1 To iii%
        Print # 1, txt$(i%)
      Next i%
      Close # 1
    EndIf
  EndIf
  Clr texteing%
  hauptmenue
Return
>Procedure lineatur
  Color RGB(255, 255, 255) ' weiß
  SetFont schrift0%
  Text (_X - TxtLen(nam$)) / 2, 464 * fy, nam$
  SetFont schrift3%
  Color RGB(180, 255, 255) ' hell blaugrün
  DefLine 0, 1 * fy
  For jjj% = 0 To 15
    Line 40 * fx, 47 * fy + Int(zeichenh% * 1.25) * jjj%, 500 * fx, 47 * fy + Int(zeichenh% * 1.25) * jjj%
  Next jjj%
  If texteing% = 1
    PBox 501 * fx, 385 * fy, 625 * fx, 412 * fy
    SetFont schrift1%
    Color RGB(0, 0, 0) ' schwarz
    Text 508 * fx, 390 * fy, "Wortzahl:"
    SetFont schrift3%
  EndIf
Return
>Procedure lineatur5
  Color RGB(255, 255, 255) ' weiß
  SetFont schrift0%
  Text (_X - TxtLen(nam$)) / 2, 464 * fy, nam$
  SetFont schrift3%
  GraphMode R2_COPYPEN, TRANSPARENT
  Put 0, 0, textbl1$
  DefLine 0, 1
  SetFont schrift3%
  If art| < 77
    For jjj% = 1 To 8
      If alph% <> 2 Or Even(jjj%) = -1  ' gerade Zahl
        Color RGB(180, 255, 255) ' hell blaugrün
        Line 40 * fx, Int(234 * fy) + Int(zeichenh% * 1.25) * jjj%, 350 * fx, Int(234 * fy) + Int(zeichenh% * 1.25) * jjj%
      EndIf
      If alph% <> 2
        Color RGB(0, 0, 235) ' blau
        Text 42 * fx, 209 * fy + Int(zeichenh% * 1.25) * jjj%, Trim$(Str$(jjj%)) + "."
      EndIf
    Next jjj%
  Else
    For jjj% = 2 To 6 Step 2
      Color RGB(180, 255, 255) ' hell blaugrün
      Line 40 * fx, Int(234 * fy) + Int(zeichenh% * 1.25) * jjj%, 350 * fx, Int(234 * fy) + Int(zeichenh% * 1.25) * jjj%
    Next jjj%
    Line 40 * fx, 234 * fy + Int(zeichenh% * 1.25) * 7, 350 * fx, 234 * fy + Int(zeichenh% * 1.25) * 7
  EndIf
  Color RGB(0, 0, 0) ' schwarz
  SetFont schrift1%
  If alph% = 1
    If einzelner| = 1
      Text 42 * fx, 30 * fy, "Ordne nach dem Alphabet:"
    Else
      Text 42 * fx, 30 * fy, "Ordnet nach dem Alphabet:"
    EndIf
  Else If alph% = 2
    If einzelner| = 1
      Text 42 * fx, 30 * fy, "Ordne nach den Wortarten:"
    Else
      Text 42 * fx, 30 * fy, "Ordnet nach den Wortarten:"
    EndIf
    Color RGB(0, 0, 235) ' blau
    Text 42 * fx, 236 * fy, "Namenwörter (Substantive) mit Begleiter:"
    Text 42 * fx, 236 * fy + Int(zeichenh% * 1.25) * 2, "Zeitwörter (Verben):"
    Text 42 * fx, 236 * fy + Int(zeichenh% * 1.25) * 4, "Eigenschaftswörter (Adjektive):"
    Text 42 * fx, 236 * fy + Int(zeichenh% * 1.25) * 6, "sonstige Wörter:"
  Else If alph% = 3
    If gross| = 1
      If einzelner| = 1
        Text 42 * fx, 30 * fy, "Schreibe diese Wörter ab:"
      Else
        Text 42 * fx, 30 * fy, "Schreibt diese Wörter ab:"
      EndIf
    Else
      If einzelner| = 1
        Text 42 * fx, 30 * fy, "Schreibe (nicht nur Großbuchstaben):"
      Else
        Text 42 * fx, 30 * fy, "Schreibt (nicht nur Großbuchstaben):"
      EndIf
    EndIf
  Else
    Text 42 * fx, 30 * fy, "Die Grundform des Zeitworts heißt:"
    Color RGB(0, 0, 235) ' blau
    If einzelner| = 1
      Text 42 * fx, 238 * fy, "Schreibe die Grundform:"
    Else
      Text 42 * fx, 238 * fy, "Schreibt die Grundform:"
    EndIf
    Text 42 * fx, 238 * fy + Int(zeichenh% * 1.25) * 2, "Gegenwart:"
    Text 42 * fx, 238 * fy + Int(zeichenh% * 1.25) * 4, "Vergangenheit:"
  EndIf
  If art| < 77
    Color RGB(180, 255, 255) ' hell blaugrün
    PBox 34 * fx, 183 * fy, 505 * fx, 213 * fy
    Color RGB(255, 0, 0) ' rot
    Text 42 * fx, 188 * fy, "Achtung!"
    j# = oTimer
    Repeat
      PeekEvent
      zeitneu# = oTimer
    Until zeitneu# > j# + 2000
    Color RGB(180, 255, 255) ' hell blaugrün
    PBox 34 * fx, 183 * fy, 505 * fx, 213 * fy
    Color RGB(0, 0, 0) ' schwarz
    If einzelner| = 1
      Text 42 * fx, 188 * fy, "Benutze die Tasten     und     !"
    Else
      Text 42 * fx, 188 * fy, "Benutzt die Tasten     und     !"
    EndIf
    SetFont schriftw1%
    Color RGB(255, 0, 0) ' rot
    Text 202 * fx, 188 * fy, "ò  ñ"
    SetFont schrift1%
  EndIf
  If art| > 52
    Color RGB(100, 0, 0) ' dunkelbraun
  Else
    Color RGB(0, 0, 235) ' blau
  EndIf
  DefLine 0, 2 * fx
  Line 13 * fx, 224 * fy, 624 * fx, 224 * fy
  Line 13 * fx, 227 * fy, 624 * fx, 227 * fy
Return
>Procedure falsch
  Color RGB(0, 0, 0) ' schwarz
  SetFont schrift1%
  Text 190 * fx, 400 * fy, "Achtung! Fehler!"
  Text 180 * fx, 421 * fy, "weiter:     Leertaste!"
  Color RGB(255, 0, 0) ' rot
  SetFont schriftw1%
  Text 240 * fx, 422 * fy, "ò"
  Color RGB(0, 0, 0) ' schwarz
  SetFont schrift3%
  Repeat
    Sleep
    t$ = InKey$
  Until t$ <> ""
  Repeat
    PeekEvent
  Until InKey$ = ""
Return
>Procedure ende
  Color RGB(75, 0, 0)
  PBox 0, 0, _X, _Y
  FreeFont schrift0%
  FreeFont schrift1%
  FreeFont schrift2%
  FreeFont schrift3%
  FreeFont schrift4%
  FreeFont schrift5%
  FreeFont schrift6%
  FreeFont schriftw1%
  FreeFont schriftw2%
  FreeFont schriftw3%
  Clr schreibblatt1$, lin$, textbl1$
  Set grins = Nothing
  Set heul = Nothing
  Set katze = Nothing
  Set elefant = Nothing
  Set hase = Nothing
  Set blume = Nothing
  Set tastatur = Nothing
  DefMouse 0
  Color RGB(255, 255, 255) ' weiß
  CloseW # 1
  CloseW # 2
  CloseW # 3
  End
Return
