    b_%(11) = 4
    buchst$(3) = "Ss"
    reihe%(18) = 18
    b_%(18) = 3
    buchst$(14) = "Uu"
    reihe%(21) = 21
    b_%(21) = 14
    buchst$(0) = "Mm"
    reihe%(12) = 12
    b_%(12) = 0
    buchst$(2) = "Aa"
