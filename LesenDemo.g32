Global aa%, aaa%, abstandx#, abstandy#, alert|, altaa%, altart|, altbreite%, altrechts%
Global altrichtig%, altunten%, altrichtig1%, altstelle%, altx%, alty%, anf|, anfang|
Global anzahl%, art_$, art|, asc%, aufgabenwahl|, bb%, b%, beginn|, bild%, bild1%, breite%
Global cc%, ccc%, d$, dd%, ddd%, drucken|, du$, ee%, eee%, eingabe$, einzelner|, ende|
Global falsch%, falsch_alt%, falsch1|, fehler|, fenster$, fertig0|, fertig1|, fertig2|
Global fertig3|, firsttime|, fortsetzung|, fx#, fy#, gib$, h2DC%, h3DC%, h4DC%, h5DC%, hNULL%
Global h4%, h5%, hilfe_$, hilfe|, hilferuf|, hintergrund1$, hintergrund2$, hintergrund3$
Global hoehe%, i%, ink$, j#, jj%, k%, kopie%, l%, lesen_$, lesen|, lesenalt|, lies$
Global nam$, nam1$, oldx%, oldy%, pfad$, print|, prozent_$, prozent%, rechtsx%, richtig#
Global richtig_$, richtig_alt%, richtig_falsch$, richtig1%, s_a_$, s_a%, schrift0%, schrift1%
Global schrift2%, schrift3%, schrift4%, schrift5%, schriftw1%, schriftw2%, schriftw3%
Global schriftdr%, seite%, seitenh%, sekunden%, speichern|, start|, start1|, stelle%, t$, tast$
Global tastbild%, taste%, unteny%, wahl%, wahl_|, wortzahl|, x%, xxx%, xpunkt%, xx%, xxxx#
Global y%, yyy%, yy%, yyyy#, zeilenh%, zeit#, zeitm_$, zeitm%, zeitneu#, zeits_$, zeits%
Global Picture grins, heul, katze, hase, kirche, blume
OpenW Full Hidden # 2, , , , , 0000000000      ' Vollbild
Win_2.AutoRedraw = 1
OpenW Full Hidden # 1, , , , , 0000000000
Win_1.AutoRedraw = 1
TopW # 1
Output = Win_1
pfad$ = CurDir$
If Right$(pfad$) = "\"
  pfad$ = Left$(pfad$, Len(pfad$) - 1)
EndIf
If Not GetAttr(pfad$ + "\Lesen") And 16      'Abfrage ob Ordner vorhanden
  MkDir pfad$ + "\Lesen"                     'Ordner anlegen
EndIf
Global fibelbild(81) As Picture
Global text$(81)
Global buchst$(39)       ' Laute "Oo"
Global alph$(39)         ' Merkbuchstaben der Wörter
Global text1$(5)
Global textbild%(5)      ' Wortkärtchen
Global reihe%(39)        ' Reihenfolge der Buchstaben/Laute im Alphabet
Global b_%(39)           ' Reihenfolge der Buchstaben/Laute in der Lesereihe
Global a%(65)
For i% = 1 To 32
  a%(i%) = -1            ' DEFMOUSE V:a%(0)        ' transparente Mausform
Next i%
DefMouse 0
fx# = _X / 640
fy# = _Y / 480
Font Orientation 0, Escapement 0, StrikeOut 0, Italic 0
Font StrikeOut 0, Underline 0, Family FF_DONTCARE, Pitch DEFAULT_PITCH
Font CharSet ANSI_CHARSET, Quality DEFAULT_QUALITY
Font "arial", Weight 400, Width 7 * fx * 0.8, Height Int(16 * fx), To schrift0%
Font "arial", Weight 400, Width 0, Height Int(21 * fx), To schrift1%
Font "arial", Weight 400, Width 0, Height Int(25 * fx), To schrift2%
Font "arial", Weight 400, Width 0, Height Int(39 * fx), To schrift3%
Font "arial", Weight 400, Width 0, Height Int(50 * fx), To schrift4%
Font "Times New Roman", Weight 700, Width 0, Height Int(60 * fx), To schrift5%
Font CharSet 1
Font "Wingdings", Weight 400, Width 0, Height Int(21 * fx), To schriftw1%
Font "Wingdings", Weight 400, Width 0, Height Int(25 * fx), To schriftw2%
Font "Wingdings", Weight 400, Width 0, Height Int(90 * fx), To schriftw3%
fibel                            ' Bilder und Wörter einlesen
Set grins =  LoadPicture("bild\grins.bmp")
Set heul =  LoadPicture("bild\heul.bmp")
Set katze =  LoadPicture("bild\katze.jpg")
Set hase =  LoadPicture("bild\hase.jpg")
Set kirche =  LoadPicture("bild\kirche.jpg")
Set blume =  LoadPicture("bild\blume.jpg")
RGBColor RGB(75, 0, 0)
PBox 0, 0, _X, _Y
DefMouse 0
RGBColor RGB(255, 255, 198), RGB(255, 255, 198) ' creme/creme
DefFill 0          ' Füllen mit Farbe ohne Muster
PRBox 3 * fx, 3 * fy, 633 * fx, 475 * fy
DefLine 0, 12 * fx
DefFill 42         ' ohne Füllung
PRBox 7 * fx, 8 * fy, 631 * fx, 473 * fy
DefFill 0
DefLine 0, 1 * fx
RGBColor RGB(100, 0, 0) ' dunkelbraun
PBox 0, 0, _X, 238 * fy ' obere Bildhälfte
RGBColor RGB(255, 0, 0) ' rot
DefLine 0, Ceil(3 * fx)
Line 6 * fx, 238 * fy, 632 * fx, 238 * fy ' Trennung oben/unten
DefLine 0, 12 * fx
DefFill 42
PRBox 6 * fx, 7 * fy, 632 * fx, 473 * fy
Get 0, 0, _X, 238 * fy, hintergrund1$
Get 0, 238 * fy, 510 * fx, _Y, hintergrund2$
Get 0, 238 * fy, _X, _Y, hintergrund3$
Get 0, 0, 1, 1, bild%    ' damit es besteht, Freebmp
Get 0, 0, 1, 1, bild1%
Get 0, 0, 1, 1, tastbild%
For i% = 0 To 4
  Get 0, 0, 1, 1, textbild%(i%)
Next i%
DefLine 0, 3 * fx
Box 37 * fx, 197 * fy, 161 * fx, 227 * fy ' Box für Wörter
Box 184 * fx, 197 * fy, 308 * fx, 227 * fy
Box 331 * fx, 197 * fy, 455 * fx, 227 * fy
Box 478 * fx, 197 * fy, 602 * fx, 227 * fy
DefFill 0
DefLine 0, 1 * fx
RGBColor RGB(255, 255, 255) ' weiß
PBox 39 * fx, 199 * fy, 159 * fx, 225 * fy  ' P-Box für Wörter
PBox 186 * fx, 199 * fy, 306 * fx, 225 * fy
PBox 333 * fx, 199 * fy, 453 * fx, 225 * fy
PBox 480 * fx, 199 * fy, 600 * fx, 225 * fy
Win_1.Show
neu0:
aa% = Random(32)
bb% = Random(32)
cc% = Random(32)
dd% = Random(32)
If fibelbild(aa%) = 0 Or fibelbild(bb%) = 0 Or fibelbild(cc%) = 0 Or fibelbild(dd%) = 0 Or aa% = bb% Or aa% = cc% Or aa% = dd% Or bb% = cc% Or bb% = dd% Or cc% = dd%
  GoTo neu0
EndIf
PaintPicture fibelbild(aa%), 40 * fx, 30 * fy, 118 * fx, 157 * fy
PaintPicture fibelbild(bb%), 187 * fx, 30 * fy, 118 * fx, 157 * fy
PaintPicture fibelbild(cc%), 334 * fx, 30 * fy,  118 * fx, 157 * fy
PaintPicture fibelbild(dd%), 481 * fx, 30 * fy,  118 * fx, 157 * fy
SetFont schrift2%
RGBColor RGB(0, 0, 0), RGB(255, 255, 255) ' schwarz/weiß
Text 99 * fx - TxtLen(text$(aa%)) / 2, 200 * fy, text$(aa%)
Text 246 * fx - TxtLen(text$(bb%)) / 2, 200 * fy, text$(bb%)
Text 393 * fx - TxtLen(text$(cc%)) / 2, 200 * fy, text$(cc%)
Text 540 * fx - TxtLen(text$(dd%)) / 2, 200 * fy, text$(dd%)
GraphMode R2_COPYPEN, TRANSPARENT
SetFont schrift0%
ink$ = "Kombipaket Version 8.0, Rudolf Rosenkränzer, 54456 Tawern, Tel. 06501/180202"
RGBColor RGB(255, 255, 255) ' weiß
'##E#
Text _X / 2 - TxtLen(ink$) / 2, 465 * fy, ink$
Clr ink$
SetFont schrift1%
RGBColor RGB(0, 0, 235) ' blau
Text 20 * fx, 300 * fy, "Gib bitte deinen Namen ein,"
Text 20 * fx, 320 * fy, "danach       die Fertig-Taste (Return)!"
SetFont schriftw1%
RGBColor RGB(255, 0, 0) ' rot
Text 88 * fx, 320 * fy, "ò"
DefLine 0, 1 * fx
Box 21 * fx, 362 * fy, 35 * fx, 380 * fy
SetFont schrift2%
Repeat
  Repeat
    Sleep
    t$ = InKey$
  Until t$ <> ""
  Exit If t$ = Chr$(13)                  ' Return
  If t$ = Chr$(8) And nam$ <> ""           ' Backspace
    nam$ = Left$(nam$, Len(nam$) - 1)
    RGBColor RGB(255, 255, 198) ' creme
    PBox 19 * fx + TxtLen(nam$), 360 * fy, 58 * fx + TxtLen(nam$), 384 * fy
  EndIf
  If Len(t$) = 1 And ((Asc(t$) > 64 And Asc(t$) < 91) Or (Asc(t$) > 96 And Asc(t$) < 123) Or t$ = "Ä" Or t$ = "Ö" Or t$ = "Ü" Or t$ = "ä" Or t$ = "ö" Or t$ = "ü" Or t$ = "ß" Or t$ = "+" Or t$ = " ")
    RGBColor RGB(255, 255, 198) ' creme
    Box 21 * fx + TxtLen(nam$), 362 * fy, 35 * fx + TxtLen(nam$), 380 * fy
    nam$ = nam$ + t$
  EndIf
  If Left$(nam$) = " "
    nam$ = Right$(nam$, Len(nam$) - 1)
  EndIf
  RGBColor RGB(0, 0, 0) ' schwarz
  Text 20 * fx, 360 * fy, nam$
  RGBColor RGB(255, 0, 0) ' rot
  Box 21 * fx + TxtLen(nam$), 362 * fy, 35 * fx + TxtLen(nam$), 380 * fy
Until Len(nam$) > 32
If nam$ = ""
  nam$ = "???"
EndIf
RGBColor RGB(255, 255, 198) ' creme
PBox 20 * fx, 300 * fy, 619 * fx, 400 * fy
SetFont schrift5%
RGBColor RGB(255, 0, 0) ' rot
For i% = 1 To Min(22, Len(nam$))
  Text 30 * fx, 254 * fy, Left$(nam$, i%)
  zeit# = oTimer
  Repeat
    PeekEvent
    zeitneu# = oTimer
  Until zeitneu# > zeit# + 180
Next i%
RGBColor RGB(0, 0, 235) ' blau
SetFont schrift4%
If InStr(nam$, " und ") = 0 And InStr(nam$, "+") = 0
  einzelner| = 1
  Text 30 * fx, 320 * fy, "lernt"
  gib$ = "Gib "
  lies$ = "Lies "
  du$ = "du hast "
Else
  Text 30 * fx, 320 * fy, "lernen"
  gib$ = "Gebt "
  lies$ = "Lest "
  du$ = "ihr habt "
EndIf
SetFont schrift5%
RGBColor RGB(0, 0, 235) ' blau
j# = 480
For i% = 1 To 19
  Text 30 * fx, 368 * fy, Left$("immer besser lesen!", i%)
  zeit# = oTimer
  Repeat
    zeitneu# = oTimer
  Until zeitneu# > zeit# + j#
  j# = j# / 1.2
Next i%
Clr j#
zeit# = oTimer
Repeat
  zeitneu# = oTimer
Until zeitneu# > zeit# + 500
hauptmenue
>Procedure alert2(al$, al1$, al2$)
  GraphMode R2_COPYPEN, TRANSPARENT
  DefLine 0, fx
  RGBColor RGB(100, 0, 0) ' dunkelbraun
  PBox 75 * fx, 175 * fy, 563 * fx, 303 * fy
  RGBColor RGB(255, 0, 0) ' rot
  Box 78 * fx, 178 * fy, 560 * fx, 300 * fy
  RGBColor RGB(255, 255, 198) ' creme
  PBox 87 * fx, 187 * fy, 551 * fx, 291 * fy
  RGBColor RGB(0, 0, 0) ' schwarz
  SetFont schrift1%
  Text 99 * fx, 215 * fy, al$
  DefLine 0, 2 * fx
  RGBColor RGB(190, 225, 255) ' hellblau
  PBox 179 * fx, 258 * fy, 299 * fx, 280 * fy
  PBox 339 * fx, 258 * fy, 459 * fx, 280 * fy
  RGBColor RGB(100, 0, 0) ' dunkelbraun
  Box 179 * fx, 258 * fy, 299 * fx, 280 * fy
  Box 339 * fx, 258 * fy, 459 * fx, 280 * fy
  DefLine 0, fx
  PaintPicture grins, 489 * fx, 195 * fy, 50 * fx, 56 * fy
  SetFont schrift1%
  Text 189 * fx, 258 * fy, al1$
  Text 349 * fx, 258 * fy, al2$
  Repeat
    PeekEvent
  Until MouseK = 0
  Repeat
    PeekEvent
    Mouse x%, y%, k%
  Until k% = 1 And ((x% > (319 - 140) * fx And x% < (319 - 20) * fx) Or (x > (319 + 20) * fx And x% < (319 + 140) * fx)) And y% > (239 + 20) * fy And y% < (239 + 40) * fy
  If x% < 319 * fx
    alert| = 1
  Else
    alert| = 2
  EndIf
Return
>Procedure menue                ' Hauptmenü mit Abfrage
  Output = Win_2
  Repeat
    PeekEvent
  Until MouseK = 0 And _Mess = 0
  GraphMode R2_COPYPEN, TRANSPARENT
  DefLine 0, 1 * fx                            ' Aufbau des Hauptmenüs
  RGBColor RGB(75, 0, 0)
  PBox 0, 0, _X, _Y
  RGBColor RGB(100, 0, 0) ' dunkelbraun
  PRBox 3 * fx, 3 * fy, 633 * fx, 475 * fy
  RGBColor RGB(255, 255, 198) ' creme
  DefFill 0
  PBox 4 * fx, 96 * fy, 632 * fx, 364 * fy
  PRBox 60 * fx, 55 * fy, 270 * fx, 80 * fy            ' alle Wörter
  PRBox 366 * fx, 55 * fy, 576 * fx, 80 * fy
  RGBColor RGB(255, 0, 0) ' rot
  DefLine 0, 3 * fx
  RBox 60 * fx, 55 * fy, 270 * fx, 80 * fy             ' nur Merkwörter
  RBox 366 * fx, 55 * fy, 576 * fx, 80 * fy
  DefLine 0, 12 * fx
  DefFill 42
  PRBox 6 * fx, 7 * fy, 632 * fx, 473 * fy
  DefFill 0
  DefLine 0, 3 * fx
  Line 4 * fx, 95 * fy, 632 * fx, 95 * fy
  Line 4 * fx, 185 * fy, 632 * fx, 185 * fy
  Line 4 * fx, 275 * fy, 632 * fx, 275 * fy
  Line 4 * fx, 365 * fy, 632 * fx, 365 * fy
  Line 318 * fx, 95 * fy, 318 * fx, 365 * fy
  RGBColor RGB(255, 255, 255) ' weiß
  SetFont schrift0%
  If einzelner| = 1
    Text 40 * fx, 30 * fy, "Hier kannst du auswählen:"
  Else
    Text 40 * fx, 30 * fy, "Hier könnt ihr auswählen:"
  EndIf
  Text (_X - TxtLen(nam$)) / 2, 464 * fy, nam$
  SetFont schrift1%
  RGBColor RGB(0, 0, 235) ' blau
  Text 119 * fx, 58 * fy, "alle Wörter"
  Text 415 * fx, 58 * fy, "nur Merkwörter"
  SetFont schrift3%
  Text 25 * fx, 125 * fy, "Mama … Igel"
  Text 330 * fx, 125 * fy, "Mama … Fenster"
  Text 25 * fx, 215 * fy, "Mama … Auto"
  Text 330 * fx, 215 * fy, "Mama … Biene"
  Text 25 * fx, 305 * fy, "Mama … Schere"
  Text 330 * fx, 305 * fy, "Mama … Computer"
  RGBColor RGB(0, 0, 0)       ' schwarz
  SetFont schriftw3%
  RGBColor RGB(255, 255, 255) ' weiß
  Text 120 * fx, 380 * fy, "8"    ' Maus
  Text 425 * fx, 380 * fy, "7"    ' Tastatur
  SetFont schrift0%
  Text 40 * fx, 380 * fy, "linke Maustaste:"
  Text 40 * fx, 395 * fy, "          Auswahl"
  Text 200 * fx, 380 * fy, "rechte Maustaste:"
  Text 200 * fx, 395 * fy, "weiter"
  Text 356 * fx, 380 * fy, "Taste F1:"
  Text 356 * fx, 395 * fy, "Hilfe: ja/nein"
  Text 480 * fx, 380 * fy, "Taste F8: Ende"
  RGBColor RGB(255, 0, 0) ' rot
  PBox 441 * fx, 420 * fy, 446 * fx, 425 * fy
  PBox 480 * fx, 420 * fy, 485 * fx, 425 * fy
  SetFont schriftw2%
  Text 435 * fx, 393 * fy, "ò"
  Text 474 * fx, 393 * fy, "ò"
  Text 160 * fx, 381 * fy, "òò"
  SetFont schrift2%                ' ############################################
  Color RGB(0, 255, 0) ' hellgrün
  Text 200 * fx, 410 * fy, "Demoversion"
  SetFont schrift0%
  Text 200 * fx, 434 * fy, "Jede Übung bricht nach"
  Text 200 * fx, 449 * fy, "einigen richtigen Eingaben ab!"
  ' ###################################################################
  Get 0, 0, _X, _Y, fenster$
  Output = Win_1
  Put 0, 0, fenster$
  Clr fenster$
  DefLine 0, 1
  DefMouse 0
  GraphMode R2_COPYPEN, OPAQUE
  Do
    Repeat
      Sleep
      Mouse x%, y%, k%
      t$ = InKey$
    Until k% <> 0 Or (Len(t$) > 1 And Asc(Right$(t$)) = 119) Or t$ = "S" Or t$ = "s"
    Exit If k% = 2
    If t$ = "S" Or t$ = "s"
      Clr k%
      speichern| = 1
      GraphMode R2_COPYPEN, TRANSPARENT
      RGBColor RGB(255, 255, 255) ' weiß
      SetFont schrift0%
      Text 240 * fx, 440 * fy, "Ergebnis speichern"
      GraphMode R2_COPYPEN, OPAQUE
    EndIf
    If Len(t$) > 1 And Asc(Right$(t$)) = 119 ' F8
      RGBColor RGB(0, 0, 0) ' schwarz
      DefMouse 0
      Repeat
        PeekEvent
      Until MouseK = 0
      If einzelner| = 1
        alert2("Willst du wirklich aufhören?", "Ende", "zurück")
      Else
        alert2("Wollt ihr wirklich aufhören?", "Ende", "zurück")
      EndIf
      DefMouse V:a%(0)        ' transparente Mausform
      If alert| = 1
        ende
      EndIf
      Repeat
        PeekEvent
      Until MouseK = 0
      hauptmenue
    EndIf
    Repeat
      PeekEvent
    Until MouseK = 0
    xx% = x% / fx
    DefFill 0
    GraphMode R2_COPYPEN, TRANSPARENT
    If y% < 80 * fy And y > 51 * fy               ' alle Wörter
      SetFont schrift1%
      Select xx%
      Case 59 To 271
        Select wortzahl|
        Case 0
          RGBColor RGB(0, 0, 235) ' blau
          PBox 62 * fx, 57 * fy, 268 * fx, 78 * fy            ' alle Wörter
          RGBColor RGB(255, 255, 198) ' creme
          Text 119 * fx, 58 * fy, "alle Wörter"
          wortzahl| = 2                      ' alle Wörter
        Case 1
          RGBColor RGB(0, 0, 235) ' blau
          PBox 62 * fx, 57 * fy, 268 * fx, 78 * fy            ' alle Wörter
          RGBColor RGB(255, 255, 198) ' creme
          Text 119 * fx, 58 * fy, "alle Wörter"
          PBox 368 * fx, 57 * fy, 575 * fx, 78 * fy           ' nur Merkwörter
          RGBColor RGB(0, 0, 235) ' blau
          Text 415 * fx, 58 * fy, "nur Merkwörter"
          wortzahl| = 2
        EndSelect
      Case 379 To 581            ' nur Merkwörter
        Select wortzahl|
        Case 0
          RGBColor RGB(0, 0, 235) ' blau
          PBox 368 * fx, 57 * fy, 575 * fx, 78 * fy           ' nur Merkwörter
          RGBColor RGB(255, 255, 198) ' creme
          Text 415 * fx, 58 * fy, "nur Merkwörter"
          wortzahl| = 1                    ' nur Merkwörter
        Case 2
          RGBColor RGB(255, 255, 198) ' creme
          PBox 62 * fx, 57 * fy, 268 * fx, 78 * fy            ' alle Wörter
          RGBColor RGB(0, 0, 235)              ' blau
          Text 119 * fx, 58 * fy, "alle Wörter"
          PBox 368 * fx, 57 * fy, 575 * fx, 78 * fy           ' nur Merkwörter
          RGBColor RGB(255, 255, 198) ' creme
          Text 415 * fx, 58 * fy, "nur Merkwörter"
          wortzahl| = 1
        EndSelect
      EndSelect
    EndIf
    If y% > 95 * fy And y% < 365 * fy
      If y% < 185 * fy
        Clr lesenalt|
        Select xx
        Case 5 To 317
          Select lesen|
          Case 2, 3, 4, 5, 6
            lesenalt| = lesen|
            lesen| = 1
          Case 1
            lesenalt| = 1
          Case 0
            lesen| = 1
          EndSelect
        Case 319 To 631
          Select lesen|
          Case 1, 3, 4, 5, 6
            lesenalt| = lesen|
            lesen| = 2
          Case 2
            lesenalt| = 2
          Case 0
            lesen| = 2
          EndSelect
        Default
          GoTo falsch
        EndSelect
      Else If y% < 275 * fy
        Clr lesenalt|
        Select xx
        Case 5 To 317
          Select lesen|
          Case 1, 2, 4, 5, 6
            lesenalt| = lesen|
            lesen| = 3
          Case 3
            lesenalt| = 3
          Case 0
            lesen| = 3
          EndSelect
        Case 319 To 631
          Select lesen|
          Case 1, 2, 3, 5, 6
            lesenalt| = lesen|
            lesen| = 4
          Case 4
            lesenalt| = 4
          Case 0
            lesen| = 4
          EndSelect
        Default
          GoTo falsch
        EndSelect
      Else If y% < 365 * fy
        Clr lesenalt|
        Select xx
        Case 5 To 317
          Select lesen|
          Case 1, 2, 3, 4, 6
            lesenalt| = lesen|
            lesen| = 5
          Case 5
            lesenalt| = 5
          Case 0
            lesen| = 5
          EndSelect
        Case 319 To 631
          Select lesen|
          Case 1, 2, 3, 4, 5
            lesenalt| = lesen|
            lesen| = 6
          Case 6
            lesenalt| = 6
          Case 0
            lesen| = 6
          EndSelect
        Default
          GoTo falsch
        EndSelect
      EndIf
      SetFont schrift3%
      RGBColor RGB(255, 255, 198) ' creme
      Select lesenalt|
      Case 1
        PBox 12 * fx, 97 * fy, 316 * fx, 183 * fy
        RGBColor RGB(0, 0, 235)              ' blau
        Text 25 * fx, 125 * fy, "Mama … Igel"
      Case 2
        PBox 320 * fx, 97 * fy, 626 * fx, 183 * fy
        RGBColor RGB(0, 0, 235)              ' blau
        Text 330 * fx, 125 * fy, "Mama … Fenster"
      Case 3
        PBox 12 * fx, 187 * fy, 316 * fx, 273 * fy
        RGBColor RGB(0, 0, 235)              ' blau
        Text 25 * fx, 215 * fy, "Mama … Auto"
      Case 4
        PBox 320 * fx, 187 * fy, 626 * fx, 273 * fy
        RGBColor RGB(0, 0, 235)              ' blau
        Text 330 * fx, 215 * fy, "Mama … Biene"
      Case 5
        PBox 12 * fx, 277 * fy, 316 * fx, 363 * fy
        RGBColor RGB(0, 0, 235)              ' blau
        Text 25 * fx, 305 * fy, "Mama … Schere"
      Case 6
        PBox 320 * fx, 277 * fy, 626 * fx, 363 * fy
        RGBColor RGB(0, 0, 235)              ' blau
        Text 330 * fx, 305 * fy, "Mama … Computer"
      EndSelect
      RGBColor RGB(0, 0, 235)              ' blau
      Select lesen|
      Case 1
        PBox 12 * fx, 97 * fy, 316 * fx, 183 * fy
        RGBColor RGB(255, 255, 198) ' creme
        Text 25 * fx, 125 * fy, "Mama … Igel"
      Case 2
        PBox 320 * fx, 97 * fy, 626 * fx, 183 * fy
        RGBColor RGB(255, 255, 198) ' creme
        Text 330 * fx, 125 * fy, "Mama … Fenster"
      Case 3
        PBox 12 * fx, 187 * fy, 316 * fx, 273 * fy
        RGBColor RGB(255, 255, 198) ' creme
        Text 25 * fx, 215 * fy, "Mama … Auto"
      Case 4
        PBox 320 * fx, 187 * fy, 626 * fx, 273 * fy
        RGBColor RGB(255, 255, 198) ' creme
        Text 330 * fx, 215 * fy, "Mama … Biene"
      Case 5
        PBox 12 * fx, 277 * fy, 316 * fx, 363 * fy
        RGBColor RGB(255, 255, 198) ' creme
        Text 25 * fx, 305 * fy, "Mama … Schere"
      Case 6
        PBox 320 * fx, 277 * fy, 626 * fx, 363 * fy
        RGBColor RGB(255, 255, 198) ' creme
        Text 330 * fx, 305 * fy, "Mama … Computer"
      EndSelect
    EndIf
    falsch:
  Loop Until k% = 2
  If lesen| = 0
    lesen| = 1
  EndIf
  If wortzahl| = 0
    wortzahl| = 2           ' alle Wörter
  EndIf
  hilfe| = 1
  Output = Win_2
  menue0
  menue1
  Get 0, 0, _X, _Y, fenster$
  Output = Win_1
  Put 0, 0, fenster$
  Clr fenster$
  DefMouse V:a%(0)        ' transparente Mausform
  Repeat
    PeekEvent
  Until MouseK = 0 And _Mess = 0
Return
>Procedure menue0               ' Grundform für Menü 2
  GraphMode R2_COPYPEN, OPAQUE
  DefLine 0, 1 * fx
  RGBColor RGB(75, 0, 0)
  PBox 0, 0, _X, _Y
  RGBColor RGB(100, 0, 0) ' dunkelbraun
  PRBox 3 * fx, 3 * fy, 633 * fx, 475 * fy
  RGBColor RGB(255, 255, 198) ' creme
  PBox 4 * fx, 77 * fy, 632 * fx, 413 * fy
  RGBColor RGB(255, 0, 0) ' rot
  DefLine 0, 12 * fx
  DefFill 42
  PRBox 6 * fx, 7 * fy, 632 * fx, 473 * fy
  DefFill 0
  GraphMode R2_COPYPEN, TRANSPARENT
  RGBColor RGB(255, 255, 255) ' weiß
  SetFont schrift0%
  Text (_X - TxtLen(nam$)) / 2, 464 * fy, nam$
  DefLine 0, 2 * fx
  SetFont schrift2%
  jj% = 1
  For i% = 54 To 408 Step 26
    RGBColor RGB(255, 0, 0) ' rot
    Line 6 * fx, i% * fy + 22 * fy, 631 * fx, i% * fy + 22 * fy
    RGBColor RGB(0, 0, 0) ' schwarz
    If jj% > 1
      Text 45 * fx - TxtLen(Trim$(Str$(jj% - 1))), i% * fy - 2 * fy, Trim$(Str$(jj% - 1)) + "."
    EndIf
    Inc jj%
  Next i%
  Clr jj%
Return
>Procedure menue1               ' Menü 2
  GraphMode R2_COPYPEN, TRANSPARENT
  RGBColor RGB(255, 255, 255) ' weiß
  DefLine 0, 1 * fy
  SetFont schrift0%
  If einzelner| = 1
    Text 45 * fx, 40 * fy, "Hier kannst du auswählen:"
  Else
    Text 45 * fx, 40 * fy, "Hier könnt ihr auswählen:"
  EndIf
  Text 230 * fx - TxtLen("linke Maustaste:"), 425 * fy, "linke Maustaste:"
  Text 230 * fx - TxtLen("rechte Maustaste:"), 440 * fy, "rechte Maustaste:"
  Text 240 * fx, 425 * fy, "Auswahl"
  Text 240 * fx, 440 * fy, "weiter"
  Text (_X - TxtLen(nam$)) / 2, 464 * fy, nam$
  RGBColor RGB(0, 0, 235) ' blau
  SetFont schrift2%
  Text 116 * fx, 78 * fy, "Wörter schieben"                     ' 1.
  Text 116 * fx, 104 * fy, "Memory 1"                           ' 2.
  Text 116 * fx, 130 * fy, "Merkbuchstaben schieben"            ' 3.
  Text 116 * fx, 156 * fy, "Memory 2 (rubbeln)"                 ' 4.
  Text 116 * fx, 182 * fy, "Memory 3"                           ' 5.
  Text 116 * fx, 208 * fy, "Buchstaben suchen:"                 ' 6.
  Text 116 * fx + TxtLen("Buchstaben suchen: "), 208 * fy, "ama"  ' 6.
  Text 116 * fx, 234 * fy, "Buchstaben suchen: M"               ' 7.
  Text 116 * fx + TxtLen("Buchstaben suchen: M"), 234 * fy, "ma"  ' 7.
  Text 116 * fx, 260 * fy, "Buchstaben suchen: Mam"              ' 8.
  Text 116 * fx, 286 * fy, "alle Buchstaben suchen"             ' 9.
  Text 116 * fx, 312 * fy, "Buchstaben schreiben:"                 ' 10.
  Text 116 * fx + TxtLen("Buchstaben schreiben: "), 312 * fy, "ama"  ' 10.
  Text 116 * fx, 338 * fy, "Buchstaben schreiben: M"               ' 11.
  Text 116 * fx + TxtLen("Buchstaben schreiben: M"), 338 * fy, "ma"  ' 11.
  Text 116 * fx, 364 * fy, "Buchstaben schreiben: Mam"              ' 12.
  Text 116 * fx, 390 * fy, "alle Buchstaben schreiben"             ' 13.
  RGBColor RGB(255, 0, 0) ' rot
  Text 116 * fx + TxtLen("Buchstaben suchen: "), 208 * fy, ""       ' 6.
  Text 116 * fx + TxtLen("Buchstaben suchen: M"), 234 * fy, ""      ' 7.
  Text 116 * fx + TxtLen("Buchstaben suchen: Mam"), 260 * fy, ""     ' 8.
  Text 116 * fx + TxtLen("Buchstaben schreiben: "), 312 * fy, ""    ' 10.
  Text 116 * fx + TxtLen("Buchstaben schreiben: M"), 338 * fy, ""   ' 11.
  Text 116 * fx + TxtLen("Buchstaben schreiben: Mam"), 364 * fy, ""  ' 12.
Return
>Procedure menueabfrage         ' Abfrage: zweites Menü
  Repeat
    PeekEvent
  Until MouseK = 0 And _Mess = 0
  DefMouse 0
  Do
    Repeat
      Sleep
      Mouse x%, y%, k%
      t$ = InKey$
    Until (Len(t$) > 1 And Asc(Right$(t$)) = 119) Or k% > 0
    Repeat
      PeekEvent
    Until InKey$ = ""
    If Len(t$) > 1 And Asc(Right$(t$)) = 119
      DefMouse V:a%(0)        ' transparente Mausform
      hauptmenue
    EndIf
    xx% = x% / fx
    yy% = y% / fy
    Repeat
      PeekEvent
    Until MouseK = 0
    Exit If k% = 2
    Select yy%
    Case 77 To 415
      DefLine 0, 1
      For i% = 51 To 408 Step 26
        If yy% > i% And yy% < i% + 26
          SetFont schrift2%
          art| = i% / 26 - 2
          If altart| > 0
            RGBColor RGB(255, 255, 198) ' creme
            PBox 12 * fx, 51 * fy + altart| * 26 * fy, 626 * fx, Ceil(74 * fy) + altart| * 26 * fy
            RGBColor RGB(0, 0, 0) ' schwarz
            Text 45 * fx - TxtLen(Trim$(Str$(altart|))), 52 * fy + altart| * 26 * fy, Trim$(Str$(altart|)) + "."
            RGBColor RGB(0, 0, 235)              ' blau
            Select altart|
            Case 1
              Text 116 * fx, 78 * fy, "Wörter schieben"                                     ' 1.
            Case 2
              Text 116 * fx, 104 * fy, "Memory 1"                                           ' 2.
            Case 3
              Text 116 * fx, 130 * fy, "Merkbuchstaben schieben"                            ' 3.
            Case 4
              Text 116 * fx, 156 * fy, "Memory 2 (rubbeln)"                                 ' 4.
            Case 5
              Text 116 * fx, 182 * fy, "Memory 3"                                           ' 5.
            Case 6
              Text 116 * fx, 208 * fy, "Buchstaben suchen:"                                 ' 6.
              Text 116 * fx + TxtLen("Buchstaben suchen: "), 208 * fy, "ama"               ' 6.
              RGBColor RGB(255, 0, 0) ' rot
              Text 116 * fx + TxtLen("Buchstaben suchen: "), 208 * fy, ""                  ' 6.
            Case 7
              Text 116 * fx, 234 * fy, "Buchstaben suchen: M"                               ' 7.
              Text 116 * fx + TxtLen("Buchstaben suchen: M"), 234 * fy, "ma"               ' 7.
              RGBColor RGB(255, 0, 0) ' rot
              Text 116 * fx + TxtLen("Buchstaben suchen: M"), 234 * fy, ""                 ' 7.
            Case 8
              Text 116 * fx, 260 * fy, "Buchstaben suchen: Mam"                             ' 8.
              RGBColor RGB(255, 0, 0) ' rot
              Text 116 * fx + TxtLen("Buchstaben suchen: Mam"), 260 * fy, ""               ' 8.
            Case 9
              Text 116 * fx, 286 * fy, "alle Buchstaben suchen"                             ' 9.
            Case 10
              Text 116 * fx, 312 * fy, "Buchstaben schreiben:"                              ' 10.
              Text 116 * fx + TxtLen("Buchstaben schreiben: "), 312 * fy, "ama"            ' 10.
              RGBColor RGB(255, 0, 0) ' rot
              Text 116 * fx + TxtLen("Buchstaben schreiben: "), 312 * fy, ""               ' 10.
            Case 11
              Text 116 * fx, 338 * fy, "Buchstaben schreiben: M"                            ' 11.
              Text 116 * fx + TxtLen("Buchstaben schreiben: M"), 338 * fy, "ma"            ' 11.
              RGBColor RGB(255, 0, 0) ' rot
              Text 116 * fx + TxtLen("Buchstaben schreiben: M"), 338 * fy, ""              ' 11.
            Case 12
              Text 116 * fx, 364 * fy, "Buchstaben schreiben: Mam"                          ' 12.
              RGBColor RGB(255, 0, 0) ' rot
              Text 116 * fx + TxtLen("Buchstaben schreiben: Mam"), 364 * fy, ""            ' 12.
            Case 13
              Text 116 * fx, 390 * fy, "alle Buchstaben schreiben"                          ' 13.
            EndSelect
          EndIf
          RGBColor RGB(0, 0, 235)              ' blau
          PBox 12 * fx, i% * fy, 626 * fx, i% * fy + Ceil(23 * fy)
          RGBColor RGB(255, 255, 198) ' creme
          Text 45 * fx - TxtLen(Trim$(Str$(art|))), 52 * fy + art| * 26 * fy, Trim$(Str$(art|)) + "."
          Select art|
          Case 1
            Text 116 * fx, 78 * fy, "Wörter schieben"                                       ' 1.
          Case 2
            Text 116 * fx, 104 * fy, "Memory 1"                                             ' 2.
          Case 3
            Text 116 * fx, 130 * fy, "Merkbuchstaben schieben"                              ' 3.
          Case 4
            Text 116 * fx, 156 * fy, "Memory 2 (rubbeln)"                                   ' 4.
          Case 5
            Text 116 * fx, 182 * fy, "Memory 3"                                             ' 5.
          Case 6
            Text 116 * fx, 208 * fy, "Buchstaben suchen:"                                   ' 6.
            Text 116 * fx + TxtLen("Buchstaben suchen: "), 208 * fy, "ama"                 ' 6.
            Text 116 * fx + TxtLen("Buchstaben suchen: "), 208 * fy, ""                    ' 6.
          Case 7
            Text 116 * fx, 234 * fy, "Buchstaben suchen: M"                                 ' 7.
            Text 116 * fx + TxtLen("Buchstaben suchen: M"), 234 * fy, "ma"                 ' 7.
            Text 116 * fx + TxtLen("Buchstaben suchen: M"), 234 * fy, ""                   ' 7.
          Case 8
            Text 116 * fx, 260 * fy, "Buchstaben suchen: Mam"                               ' 8.
            Text 116 * fx + TxtLen("Buchstaben suchen: Mam"), 260 * fy, ""                 ' 8.
          Case 9
            Text 116 * fx, 286 * fy, "alle Buchstaben suchen"                               ' 9.
          Case 10
            Text 116 * fx, 312 * fy, "Buchstaben schreiben:"                                ' 10.
            Text 116 * fx + TxtLen("Buchstaben schreiben: "), 312 * fy, "ama"              ' 10.
            Text 116 * fx + TxtLen("Buchstaben schreiben: "), 312 * fy, ""                 ' 10.
          Case 11
            Text 116 * fx, 338 * fy, "Buchstaben schreiben: M"                              ' 11.
            Text 116 * fx + TxtLen("Buchstaben schreiben: M"), 338 * fy, "ma"              ' 11.
            Text 116 * fx + TxtLen("Buchstaben schreiben: M"), 338 * fy, ""                ' 11.
          Case 12
            Text 116 * fx, 364 * fy, "Buchstaben schreiben: Mam"                            ' 12.
            Text 116 * fx + TxtLen("Buchstaben schreiben: Mam"), 364 * fy, ""              ' 12.
          Case 13
            Text 116 * fx, 390 * fy, "alle Buchstaben schreiben"                            ' 13.
          EndSelect
          altart| = art|
        EndIf
      Next i%
    EndSelect
    falsch3:
  Loop
  If art| = 0
    Inc art|
  EndIf
  DefMouse V:a%(0)        ' transparente Mausform
  Repeat
    PeekEvent
  Until MouseK = 0 And _Mess = 0
Return
>Procedure hauptmenue
  Clr richtig, richtig1%, falsch%, falsch1|, richtig_alt%, falsch_alt%
  Clr lesen|, aufgabenwahl|, altart|, lesenalt|, art|, ende|, anzahl%
  Clr start1|, fehler|, hilfe|, beginn|, anf|, anfang|, wahl_|, eingabe$, l%
  Clr stelle%, altbreite%, altstelle%, altrichtig1%
  Clr oldy%, wortzahl|, fortsetzung|, start|, hilferuf|, aa%, xpunkt%
  Clr oldx%, tast$
  GraphMode R2_COPYPEN, OPAQUE
  menue
  menueabfrage
  zeit = oTimer
  alph$(35) = "Qu"
  neu:
  DefMouse 0
  Put 0, 0, hintergrund1$
  If start1| = 0
    Put 0, 238 * fy, hintergrund3$
    RGBColor RGB(255, 255, 255) ' weiß
    SetFont schrift0%
    Text (_X - TxtLen(nam$)) / 2, 464 * fy, nam$
    PaintPicture grins, 536 * fx, 256 * fy, 50 * fx, 56 * fy
    start1| = 1
  Else
    Put 0, 238 * fy, hintergrund2$
  EndIf
  RGBColor RGB(0, 0, 0) ' schwarz
  SetFont schrift2%
  GraphMode R2_COPYPEN, TRANSPARENT
  Select art|
  Case 1, 2
    a1
  Case 3, 4, 5
    a3
  Case 6, 7, 8, 9
    a6
  Case 10, 11, 12, 13
    a10
  EndSelect
  kontrolle
  GoTo neu :
Return
>Procedure kontrolle
  GraphMode R2_COPYPEN, TRANSPARENT
  If richtig1% >= 5 Or falsch% >= 5 Or ende| = 1
    SetFont schrift1%
    If zeit# = 0
      ende
    Else If richtig1% + falsch% > 0
      zeitneu# = oTimer
      sekunden% = Div((zeitneu# - zeit#), 1000)
      zeitm% = Div(sekunden%, 60)
      zeits% = sekunden% - zeitm% * 60
      Put 0, 238 * fy, hintergrund2$
      RGBColor RGB(0, 0, 0) ' schwarz
      Text 42 * fx, 275 * fy, Min(nam$, Left$(nam$, 25)) + ","
      If richtig1% + falsch% = 1 And richtig1% = 1
        Text 42 * fx, 300 * fy, du$ + "eine Aufgabe"
        Text 42 * fx, 325 * fy, "in " + Trim$(Str$(zeitm%)) + " min und " + Trim$(Str$(zeits%)) + " s gelöst!"
      Else If richtig1% + falsch% = 1 And richtig1% = 0
        Text 42 * fx, 300 * fy, du$ + "keine Aufgabe gelöst!"
        Text 42 * fx, 325 * fy, "Zeit: " + Trim$(Str$(zeitm%)) + " min und " + Trim$(Str$(zeits%)) + " s"
      Else
        Text 42 * fx, 300 * fy, du$ + Trim$(Str$(richtig1%)) + " von " + Trim$(Str$(richtig1% + falsch%)) + " Aufgaben"
        Text 42 * fx, 325 * fy, "in " + Trim$(Str$(zeitm%)) + " min und " + Trim$(Str$(zeits%)) + " s gelöst!"
      EndIf
      Text 42 * fx, 375 * fy, "Ergebnis ausdrucken?"
      Text 42 * fx, 400 * fy, "ja:       j   ***   nein:       Taste F8"
      RGBColor RGB(255, 0, 0) ' rot
      SetFont schriftw1%
      Text 72 * fx, 401 * fy, "ò      ò"
      SetFont schrift1%
      Repeat
        Sleep
        t$ = InKey$
      Until t$ = "j" Or t$ = "J" Or (Len(t$) = 2 And Asc(Right$(t$)) = 119) ' F8
      Repeat
        PeekEvent
      Until InKey$ = ""
      DefMouse 0
      If t$ = "j" Or t$ = "J"
        If drucken| = 0
          druckeinrichtung
        EndIf
        Clr t$
        If print| = 1  '  Drucker angeschaltet
          Output = Printer
          If seitenh% - seite% < zeilenh% * 5
            Printer.EndPage
            Printer.StartPage
            seite% = zeilenh% * 3
          EndIf
          Output = Win_1
          RGBColor RGB(255, 255, 198) ' creme
          PRBox 23 * fx, 260 * fy, 510 * fx, 444 * fy                  ' Textabdeckung
          Output = Printer
          Repeat
            PeekEvent
          Until _Mess = 0
          SetFont schriftdr%
          RGBColor RGB(0, 0, 0) ' schwarz
          Text zeilenh% * 2, seite%, nam$ + ",  " + Date$ + ",  " + Time$
          Add seite%, zeilenh%
          If richtig1% + falsch% = 1 And richtig1% = 1
            Text zeilenh% * 2, seite%, "Richtig war eine Aufgabe, Lesen " + Trim$(Str$(lesen|)) + ", Zeile " + Trim$(Str$(art|)) + "."
          Else If richtig1% + falsch% = 1 And richtig1% = 0
            Text zeilenh% * 2, seite%, "Richtig war keine Aufgabe, Lesen " + Trim$(Str$(lesen|)) + ", Zeile " + Trim$(Str$(art|)) + "."
          Else
            Text zeilenh% * 2, seite%, "Richtig waren " + Trim$(Str$(richtig1%)) + " von " + Trim$(Str$(richtig1% + falsch%)) + " Aufgaben, Stufe " + Trim$(Str$(lesen|)) + ", Zeile " + Trim$(Str$(art|)) + "."
          EndIf
          Add seite%, zeilenh%
          Text zeilenh% * 2, seite%, "Zeit: " + Trim$(Str$(zeitm%)) + " min und " + Trim$(Str$(zeits%)) + " s"
          Add seite%, zeilenh%
          If hilferuf| = 1
            Text zeilenh% * 2, seite%, "Hilfe: ja"
          Else
            Text zeilenh% * 2, seite%, "Hilfe: nein"
          EndIf
          Add seite%, zeilenh% * 2
          Repeat
            PeekEvent
          Until _Mess = 0
          Output = Win_1
          SetFont schrift2%
        EndIf
      EndIf
      If speichern| > 0
        speichern      '  Ergebnis auf Diskette speichern, falls gewünscht
      EndIf
    EndIf
    hauptmenue
  EndIf
Return
>Procedure druckeinrichtung
  alert2("Ist der Drucker angeschaltet?", "ja", "nein")
  If alert| = 1
    drucken| = 1 ' Drucken erwünscht
    print| = 1  ' Drucker ist angeschaltet
    Output = Printer
    seitenh% = GetDevCaps(VERTRES)
    zeilenh% = 12 * seitenh% / 640
    Printer.StartDoc "Lesen"   ' Ausdruck-Dokument
    Printer.StartPage
    Font "arial", CharSet ANSI_CHARSET, Family FF_DONTCARE, Width zeilenh% * 0.4, Height zeilenh%, To schriftdr%
    seite% = zeilenh% * 3
  EndIf
Return
>Procedure saeule
  DefLine 0, 1
  If fehler| = 1
    PaintPicture heul, 536 * fx, 256 * fy, 50 * fx, 56 * fy
  Else
    PaintPicture grins, 536 * fx, 256 * fy, 50 * fx, 56 * fy
  EndIf
  GraphMode R2_COPYPEN, TRANSPARENT
  RGBColor RGB(255, 255, 255) ' weiß
  SetFont schrift0%
  Text (_X - TxtLen(nam$)) / 2, 464 * fy, nam$
  SetFont schrift2%
  DefFill 0
  If richtig > 0 And richtig < 37 And altrichtig1% < richtig ' bei art|=9
    RGBColor RGB(0, 0, 235) ' blau
    PBox 570 * fx, 460 * fy - richtig * 4 * fy, 611 * fx, Ceil(467 * fy) - richtig_alt% * 4 * fy
    If richtig >= 9
      PaintPicture katze, 570 * fx, 429 * fy, 41 * fx, 33 * fy
    EndIf
    If richtig >= 18
      PaintPicture hase, 570 * fx, 392 * fy, 41 * fx, 33 * fy
    EndIf
    If richtig >= 27
      PaintPicture kirche, 570 * fx, 356 * fy, 41 * fx, 33 * fy
    EndIf
    If richtig >= 36
      PaintPicture blume, 570 * fx, 320 * fy, 41 * fx, 33 * fy
    EndIf
  EndIf
  richtig_alt% = richtig
  If falsch% > 0 And falsch% < 37
    RGBColor RGB(160, 160, 160) ' grau
    PBox 512 * fx, Ceil(467 * fy), 552 * fx, 461 * fy - falsch% * 4 * fy
  EndIf
Return
>Procedure speichern
  If speichern| = 1
    speichern| = 2
    nam1$ = nam$
    If nam$ <> "???"
      If InStr(nam1$, "und") <> 0
        nam1$ = Left$(nam1$, InStr(nam1$, "und") - 1) + "_" + Right$(nam1$, Len(nam1$) - InStr(nam1$, "und") - 2)
      EndIf
      If InStr(nam1$, "+") <> 0
        nam1$ = Left$(nam1$, InStr(nam1$, "+") - 1) + "_" + Right$(nam1$, Len(nam1$) - InStr(nam1$, "+"))
      EndIf
      If InStr(nam1$, " ") <> 0
        Repeat
          '     peekevent
          nam1$ = Left$(nam1$, InStr(nam1$, " ") - 1) + Right$(nam1$, Len(nam1$) - InStr(nam1$, " "))
        Until InStr(nam1$, " ") = 0
        pfad$ = pfad$ + "\LESEN\" + Left$(nam1$, Min(Len(nam1$), 8)) + ".TXT"
      Else
        pfad$ = pfad$ + "\LESEN\" + nam1$ + ".TXT"
      EndIf
    Else
      pfad$ = pfad$ + "\LESEN\LESEN" + ".TXT"
    EndIf
  EndIf
  If richtig1% + falsch% > 0
    prozent% = Round(richtig1% / (richtig1% + falsch%) * 100)
    s_a% = Round((zeitm% * 60 + zeits%) / (richtig1% + falsch%))
  Else
    prozent% = 0
    s_a% = 0
  EndIf
  If Exist(pfad$) = 0
    Open pfad$ for Output As # 1
    Print # 1
    Print # 1, nam$
    Print # 1, "     Datum   Zeit  Stufe  Zeile  min  s  H  richtig gesamt  s/A    %"
  Else
    Open pfad$ for Append As # 1
  EndIf
  d$ = Date$
  t$ = Space$(7)
  Rset t$ = Left$(Time$, 5)
  lesen_$ = Space$(7)
  Rset lesen_$ = Trim$(Str$(lesen|))
  art_$ = Space$(7)
  Rset art_$ = Trim$(Str$(art|))
  zeitm_$ = Space$(5)
  Rset zeitm_$ = Trim$(Str$(zeitm%))
  zeits_$ = Space$(3)
  Rset zeits_$ = Trim$(Str$(zeits%))
  hilfe_$ = Space$(3)
  If hilferuf| = 0
    Rset hilfe_$ = "n"
  Else
    Rset hilfe_$ = "j"
  EndIf
  richtig_$ = Space$(9)
  Rset richtig_$ = Trim$(Str$(richtig1%))
  richtig_falsch$ = Space$(7)
  Rset richtig_falsch$ = Trim$(Str$(richtig1% + falsch%))
  s_a_$ = Space$(5)
  Rset s_a_$ = Trim$(Str$(s_a%))
  prozent_$ = Space$(5)
  Rset prozent_$ = Trim$(Str$(prozent%))
  Print # 1, d$; t$; lesen_$; art_$; zeitm_$; zeits_$; hilfe_$; richtig_$; richtig_falsch$; s_a_$; prozent_$
  Close # 1
Return
>Procedure zufall               ' Zahlen für Aufgaben mit Zusatzwörtern
  Select lesen|
  Case 1
    anzahl% = 8  '  8 Merkwörter
  Case 2
    anzahl% = 20 ' 12 Merkwörter +  8 Zusatzwörter
  Case 3
    anzahl% = 34 ' 16 Merkwörter + 18 Zusatzwörter
  Case 4
    anzahl% = 48 ' 20 Merkwörter + 28 Zusatzwörter
  Case 5
    anzahl% = 64 ' 24 Merkwörter + 40 Zusatzwörter
  Case 6
    anzahl% = 81 ' 38 Merkwörter + 43 Zusatzwörter
  EndSelect
  neu1:
  aa% = Random(anzahl%)
  If aa% = altaa%
    GoTo neu1
  EndIf
  altaa% = aa%
  neu2:
  bb% = Random(anzahl%)
  If bb% = aa%
    GoTo neu2
  EndIf
  neu3:
  cc% = Random(anzahl%)
  If cc% = aa% Or cc% = bb%
    GoTo neu3
  EndIf
  neu4:
  dd% = Random(anzahl%)
  If dd% = aa% Or dd% = bb% Or dd% = cc%
    GoTo neu4
  EndIf
  neu5:
  ee% = Random(anzahl%)
  If ee% = aa% Or ee% = bb% Or ee% = cc% Or ee% = dd%
    GoTo neu5
  EndIf
  Select lesen|
  Case 2
    If aa% > 11
      aa% = aa% + 26
    EndIf
    If bb% > 11
      bb% = bb% + 26
    EndIf
    If cc% > 11
      cc% = cc% + 26
    EndIf
    If dd% > 11
      dd% = dd% + 26
    EndIf
    If ee% > 11
      ee% = ee% + 26
    EndIf
  Case 3
    If aa% > 15
      aa% = aa% + 22
    EndIf
    If bb% > 15
      bb% = bb% + 22
    EndIf
    If cc% > 15
      cc% = cc% + 22
    EndIf
    If dd% > 15
      dd% = dd% + 22
    EndIf
    If ee% > 15
      ee% = ee% + 22
    EndIf
  Case 4
    If aa% > 19
      aa% = aa% + 18
    EndIf
    If bb% > 19
      bb% = bb% + 18
    EndIf
    If cc% > 19
      cc% = cc% + 18
    EndIf
    If dd% > 19
      dd% = dd% + 18
    EndIf
    If ee% > 19
      ee% = ee% + 18
    EndIf
  Case 5
    If aa% > 23
      aa% = aa% + 14
    EndIf
    If bb% > 23
      bb% = bb% + 14
    EndIf
    If cc% > 23
      cc% = cc% + 14
    EndIf
    If dd% > 23
      dd% = dd% + 14
    EndIf
    If ee% > 23
      ee% = ee% + 14
    EndIf
  EndSelect
  aaa% = Random(5)
  neu6:
  b% = Random(5)
  If b% = aaa%
    GoTo neu6
  EndIf
  neu7:
  ccc% = Random(5)
  If ccc% = aaa% Or ccc% = b%
    GoTo neu7
  EndIf
  neu8:
  ddd% = Random(5)
  If ddd% = aaa% Or ddd% = b% Or ddd% = ccc%
    GoTo neu8
  EndIf
  neu9:
  eee% = Random(5)
  If eee% = aaa% Or eee% = b% Or eee% = ccc% Or eee% = ddd%
    GoTo neu9
  EndIf
Return
>Procedure zufall1              ' Zahlen für Aufgaben ohne Zusatzwörter
  Select lesen|
  Case 1
    anzahl% = 8  '  8 Merkwörter
  Case 2
    anzahl% = 12 ' 12 Merkwörter
  Case 3
    anzahl% = 16 ' 16 Merkwörter
  Case 4
    anzahl% = 20 ' 20 Merkwörter
  Case 5
    anzahl% = 24 ' 24 Merkwörter
  Case 6
    anzahl% = 38 ' 38 Merkwörter
  EndSelect
  neu11:
  aa% = Random(anzahl%)
  If aa% = altaa%
    GoTo neu11
  EndIf
  altaa% = aa%
  neu12:
  bb% = Random(anzahl%)
  If bb% = aa%
    GoTo neu12
  EndIf
  neu13:
  cc% = Random(anzahl%)
  If cc% = aa% Or cc% = bb%
    GoTo neu13
  EndIf
  neu14:
  dd% = Random(anzahl%)
  If dd% = aa% Or dd% = bb% Or dd% = cc%
    GoTo neu14
  EndIf
  neu15:
  ee% = Random(anzahl%)
  If ee% = aa% Or ee% = bb% Or ee% = cc% Or ee% = dd%
    GoTo neu15
  EndIf
  aaa% = Random(5)
  neu16:
  b% = Random(5)
  If b% = aaa%
    GoTo neu16
  EndIf
  neu17:
  ccc% = Random(5)
  If ccc% = aaa% Or ccc% = b%
    GoTo neu17
  EndIf
  neu18:
  ddd% = Random(5)
  If ddd% = aaa% Or ddd% = b% Or ddd% = ccc%
    GoTo neu18
  EndIf
  neu19:
  eee% = Random(5)
  If eee% = aaa% Or eee% = b% Or eee% = ccc% Or eee% = ddd%
    GoTo neu19
  EndIf
Return
>Procedure hinweis_beginn
  If beginn| = 0
    beginn| = 1
    FreeBmp bild%
    Get 0, 241 * fy, 420 * fx, _Y, bild%
    RGBColor RGB(255, 255, 198) ' creme
    PRBox 23 * fx, 244 * fy, 400 * fx, 443 * fy
    RGBColor RGB(0, 190, 255) ' hell blaugrün
    DefLine 0, 5 * fx
    RBox 23 * fx, 244 * fy, 400 * fx, 460 * fy
    DefLine 0, 1 * fx
    GraphMode R2_COPYPEN, TRANSPARENT
    RGBColor RGB(0, 0, 0) ' schwarz
    SetFont schrift1%
    If art| = 1 Or art| = 2
      Text 55 * fx, 275 * fy, "Wähle ein Wort mit der linken Maustaste"
      Text 55 * fx, 295 * fy, "aus, schiebe es zum richtigen Bild,"
      Text 55 * fx, 315 * fy, "lege es mit der rechten Maustaste ab!"
      Text 55 * fx, 345 * fy, "fertig:"
      Text 135 * fx, 345 * fy, "Fertig-Taste!"
      Text 55 * fx, 395 * fy, "      jetzt die Leertaste!"
      SetFont schriftw1%
      RGBColor RGB(255, 0, 0) ' rot
      Text 115 * fx, 346 * fy, "ò"
      Text 55 * fx, 396 * fy, "ò"
    Else If art| > 2 And art| < 6
      Text 45 * fx, 275 * fy, "Wähle einen Buchstaben mit der linken"
      Text 45 * fx, 295 * fy, "Maustaste aus, schiebe ihn zum Bild,"
      Text 45 * fx, 315 * fy, "lege ihn mit der rechten Maustaste ab!"
      Text 45 * fx, 345 * fy, "fertig:"
      Text 125 * fx, 345 * fy, "Fertig-Taste!"
      Text 45 * fx, 395 * fy, "      jetzt die Leertaste!"
      SetFont schriftw1%
      RGBColor RGB(255, 0, 0) ' rot
      Text 105 * fx, 346 * fy, "ò"
      Text 45 * fx, 396 * fy, "ò"
    Else If art| > 5 And art| < 10
      If art| = 6
        Text 55 * fx, 275 * fy, "Wie beginnt das Wort?"
      Else If art| = 7
        Text 55 * fx, 275 * fy, "Suche einen Buchstaben aus der Mitte!"
      Else If art| = 8
        Text 55 * fx, 275 * fy, "Wie endet das Wort?"
      Else If art| = 9
        Text 55 * fx, 275 * fy, "Suche alle Buchstaben der Reihe nach!"
      EndIf
      Text 55 * fx, 295 * fy, "Klicke mit der Maus an!"
      Text 55 * fx, 345 * fy, "fertig:"
      Text 135 * fx, 345 * fy, "Fertig-Taste!"
      Text 55 * fx, 395 * fy, "      jetzt die Leertaste!"
      SetFont schriftw1%
      RGBColor RGB(255, 0, 0) ' rot
      Text 115 * fx, 346 * fy, "ò"
      Text 55 * fx, 396 * fy, "ò"
    Else
      If art| = 10
        Text 40 * fx, 275 * fy, "Schreibe den ersten Buchstaben des Worts!"
      Else If art| = 11
        Text 40 * fx, 275 * fy, "Schreibe einen Buchstaben aus der Mitte!"
      Else If art| = 12
        Text 40 * fx, 275 * fy, "Schreibe den letzten Buchstaben des Worts!"
      Else If art| = 13
        Text 40 * fx, 275 * fy, "Schreibe alle Buchstaben der Reihe nach!"
      EndIf
      Text 40 * fx, 345 * fy, "fertig:"
      Text 120 * fx, 345 * fy, "Fertig-Taste!"
      Text 40 * fx, 395 * fy, "      jetzt die Leertaste!"
      SetFont schriftw1%
      RGBColor RGB(255, 0, 0) ' rot
      Text 100 * fx, 346 * fy, "ò"
      Text 40 * fx, 396 * fy, "ò"
    EndIf
    Repeat
      Sleep
      t$ = InKey$
    Until t$ <> ""
    Put 0, 241 * fy, bild%
  EndIf
Return
>Procedure tastaturmalen
  If anf| = 0
    anf| = 1
    buchst$(1) = "Oo"
    reihe%(14) = 14
    b_%(14) = 1
    buchst$(7) = "Ii"
