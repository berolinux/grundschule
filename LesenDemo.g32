>Procedure ende
  RGBColor RGB(75, 0, 0)
  PBox 0, 0, _X, _Y
  For i% = 0 To 80
    Set fibelbild(i%) = Nothing
  Next i%
  Set grins = Nothing
  Set heul = Nothing
  Set katze = Nothing
  Set kirche = Nothing
  Set hase = Nothing
  Set blume = Nothing
  FreeBmp bild%
  FreeBmp bild1%
  FreeBmp tastbild%
  For i% = 0 To 4
    FreeBmp textbild%(i%)
  Next i%
  If drucken| = 1
    Output = Printer
    Printer.EndPage
    Printer.EndDoc
    FreeFont schriftdr%
    Output = Win_1
  EndIf
  FreeFont schrift0%
  FreeFont schrift1%
  FreeFont schrift2%
  FreeFont schrift3%
  FreeFont schrift4%
  FreeFont schrift5%
  FreeFont schriftw1%
  FreeFont schriftw2%
  FreeFont schriftw3%
  Clr hintergrund1$
  Clr hintergrund2$
  Clr hintergrund3$
  CloseW # 1
  End
Return
