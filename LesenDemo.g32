    b_%(4) = 8
    buchst$(20) = "ch"
    reihe%(37) = 37
    b_%(37) = 20
    buchst$(6) = "Nn"
    reihe%(13) = 13
    b_%(13) = 6
    buchst$(16) = "Ei ei"
    reihe%(31) = 31
    b_%(31) = 16
    buchst$(23) = "Sch sch"
    reihe%(35) = 35
    b_%(35) = 23
    buchst$(24) = "Ww"
    reihe%(23) = 23
    b_%(23) = 24
    buchst$(13) = "Hh"
    reihe%(7) = 7
    b_%(7) = 13
    buchst$(21) = "Dd"
    reihe%(3) = 3
    b_%(3) = 21
    buchst$(12) = "Kk"
    reihe%(10) = 10
    b_%(10) = 12
    buchst$(26) = "ng"
    reihe%(36) = 36
    b_%(36) = 26
    buchst$(11) = "Ff"
    reihe%(5) = 5
    b_%(5) = 11
    buchst$(19) = "ie"
    reihe%(33) = 33
    b_%(33) = 19
    buchst$(10) = "Pp"
    reihe%(15) = 15
    b_%(15) = 10
    buchst$(17) = "Gg"
    reihe%(6) = 6
    b_%(6) = 17
    buchst$(18) = "Bb"
    reihe%(1) = 1
    b_%(1) = 18
    buchst$(22) = "Zz"
    reihe%(26) = 26
    b_%(26) = 22
    buchst$(25) = "Vv"
    reihe%(22) = 22
    b_%(22) = 25
    buchst$(32) = "äu"
    reihe%(34) = 34
    b_%(34) = 32
    buchst$(29) = "Ää"
    reihe%(27) = 27
    b_%(27) = 29
    buchst$(30) = "Öö"
    reihe%(28) = 28
    b_%(28) = 30
    buchst$(31) = "Üü"
    reihe%(29) = 29
    b_%(29) = 31
    buchst$(27) = "Jj"
    reihe%(9) = 9
    b_%(9) = 27
    buchst$(28) = "Xx"
    reihe%(24) = 24
    b_%(24) = 28
    buchst$(34) = "Eu eu"
    reihe%(32) = 32
    b_%(32) = 34
    buchst$(37) = "Cc"
    reihe%(2) = 2
    b_%(2) = 37
    buchst$(35) = "Qu qu"
    reihe%(16) = 16
    b_%(16) = 35
    buchst$(33) = "ß"
    reihe%(19) = 19
    b_%(19) = 33
    buchst$(36) = "Yy"
    reihe%(25) = 25
    b_%(25) = 36
    DefLine 0, 2 * fx
    For i% = 0 To 37
      If i% < 10
        RGBColor RGB(255, 255, 255) ' weiß
        PBox 20 * fx + i% * 49 * fx, 290 * fy, 64 * fx + i% * 49 * fx, 317 * fy
        RGBColor RGB(0, 0, 235) ' blau
        Box 20 * fx + i% * 49 * fx, 290 * fy, 64 * fx + i% * 49 * fx, 317 * fy
      Else If i% < 16
        RGBColor RGB(255, 255, 255) ' weiß
        PBox 20 * fx + (i% - 10) * 49 * fx, 330 * fy, 64 * fx + (i% - 10) * 49 * fx, 357 * fy
        RGBColor RGB(0, 0, 235) ' blau
        Box 20 * fx + (i% - 10) * 49 * fx, 330 * fy, 64 * fx + (i% - 10) * 49 * fx, 357 * fy
      Else If i% = 16 ' Qu
        RGBColor RGB(255, 255, 255) ' weiß
        PBox 314 * fx, 330 * fy, 386 * fx, 357 * fy
        RGBColor RGB(0, 0, 235) ' blau
        Box 314 * fx, 330 * fy, 386 * fx, 357 * fy
      Else If i% = 17 ' R
        RGBColor RGB(255, 255, 255) ' weiß
        PBox 391 * fx, 330 * fy, 433 * fx, 357 * fy
        RGBColor RGB(0, 0, 235) ' blau
        Box 391 * fx, 330 * fy, 433 * fx, 357 * fy
      Else If i% = 18 ' S
        RGBColor RGB(255, 255, 255) ' weiß
        PBox 438 * fx, 330 * fy, 480 * fx, 357 * fy
        RGBColor RGB(0, 0, 235) ' blau
        Box 438 * fx, 330 * fy, 480 * fx, 357 * fy
      Else If i% = 19 ' ß
        RGBColor RGB(255, 255, 255) ' weiß
        PBox 485 * fx, 330 * fy, 504 * fx, 357 * fy
        RGBColor RGB(0, 0, 235) ' blau
        Box 485 * fx, 330 * fy, 504 * fx, 357 * fy
      Else If i% < 30
        RGBColor RGB(255, 255, 255) ' weiß
        PBox 20 * fx + (i% - 20) * 49 * fx, 370 * fy, 64 * fx + (i% - 20) * 49 * fx, 397 * fy
        RGBColor RGB(0, 0, 235) ' blau
        Box 20 * fx + (i% - 20) * 49 * fx, 370 * fy, 64 * fx + (i% - 20) * 49 * fx, 397 * fy
      Else If art| < 10
        If i% = 30  ' Au
          RGBColor RGB(255, 255, 255) ' weiß
          PBox 20 * fx, 410 * fy, 90 * fx, 437 * fy
          RGBColor RGB(0, 0, 235) ' blau
          Box 20 * fx, 410 * fy, 90 * fx, 437 * fy
        Else If i% = 31  ' Ei
          RGBColor RGB(255, 255, 255) ' weiß
          PBox 95 * fx, 410 * fy, 151 * fx, 437 * fy
          RGBColor RGB(0, 0, 235) ' blau
          Box 95 * fx, 410 * fy, 151 * fx, 437 * fy
        Else If i% = 32  ' Eu
          RGBColor RGB(255, 255, 255) ' weiß
          PBox 156 * fx, 410 * fy, 226 * fx, 437 * fy
          RGBColor RGB(0, 0, 235) ' blau
          Box 156 * fx, 410 * fy, 226 * fx, 437 * fy
        Else If i% < 35  ' ie, äu
          RGBColor RGB(255, 255, 255) ' weiß
          PBox 231 * fx + (i% - 33) * 45 * fx, 410 * fy, 271 * fx + (i% - 33) * 45 * fx, 437 * fy
          RGBColor RGB(0, 0, 235) ' blau
          Box 231 * fx + (i% - 33) * 45 * fx, 410 * fy, 271 * fx + (i% - 33) * 45 * fx, 437 * fy
        Else If i% = 35  'Sch
          RGBColor RGB(255, 255, 255) ' weiß
          PBox 321 * fx, 410 * fy, 414 * fx, 437 * fy
          RGBColor RGB(0, 0, 235) ' blau
          Box 321 * fx, 410 * fy, 414 * fx, 437 * fy
        Else If i% < 38  ' ck, ch
          RGBColor RGB(255, 255, 255) ' weiß
          PBox 419 * fx + (i% - 36) * 45 * fx, 410 * fy, 459 * fx + (i% - 36) * 45 * fx, 437 * fy
          RGBColor RGB(0, 0, 235) ' blau
          Box 419 * fx + (i% - 36) * 45 * fx, 410 * fy, 459 * fx + (i% - 36) * 45 * fx, 437 * fy
        EndIf
      EndIf
      Select lesen|
      Case 1
        If b_%(i%) < 8
          RGBColor RGB(0, 0, 0) ' schwarz
        Else
          RGBColor RGB(220, 220, 220) ' hellgrau
        EndIf
      Case 2
        If b_%(i%) < 12
          RGBColor RGB(0, 0, 0) ' schwarz
        Else
          RGBColor RGB(220, 220, 220) ' hellgrau
        EndIf
      Case 3
        If b_%(i%) < 16
          RGBColor RGB(0, 0, 0) ' schwarz
        Else
          RGBColor RGB(220, 220, 220) ' hellgrau
        EndIf
      Case 4
        If b_%(i%) < 20
          RGBColor RGB(0, 0, 0) ' schwarz
        Else
          RGBColor RGB(220, 220, 220) ' hellgrau
        EndIf
      Case 5
        If b_%(i%) < 24
          RGBColor RGB(0, 0, 0) ' schwarz
        Else
          RGBColor RGB(220, 220, 220) ' hellgrau
        EndIf
      Case 6
        RGBColor RGB(0, 0, 0) ' schwarz
      EndSelect
      SetFont schrift2%
      If i% < 10
        Text 42 * fx + reihe%(i%) * 49 * fx - TxtLen(buchst$(b_%(i%))) / 2, 292 * fy, buchst$(b_%(i%))
      Else If i% < 16
        Text 42 * fx + reihe%(i% - 10) * 49 * fx - TxtLen(buchst$(b_%(i%))) / 2, 332 * fy, buchst$(b_%(i%))
      Else If i% = 16  ' Qu
        Text 350 * fx - TxtLen(buchst$(b_%(i%))) / 2, 332 * fy, buchst$(b_%(i%))
      Else If i% = 17  ' R
        Text 412 * fx - TxtLen(buchst$(b_%(i%))) / 2, 332 * fy, buchst$(b_%(i%))
      Else If i% = 18  ' S
        Text 459 * fx - TxtLen(buchst$(b_%(i%))) / 2, 332 * fy, buchst$(b_%(i%))
      Else If i% = 19  ' ß
        Text 494 * fx - TxtLen(buchst$(b_%(i%))) / 2, 332 * fy, buchst$(b_%(i%))
      Else If i% < 30
        Text 42 * fx + reihe%(i% - 20) * 49 * fx - TxtLen(buchst$(b_%(i%))) / 2, 372 * fy, buchst$(b_%(i%))
      Else If art| < 10
        If i% = 30  ' Au
          Text 55 * fx - TxtLen(buchst$(b_%(i%))) / 2, 412 * fy, buchst$(b_%(i%))
        Else If i% = 31  ' Ei
          Text 123 * fx - TxtLen(buchst$(b_%(i%))) / 2, 412 * fy, buchst$(b_%(i%))
        Else If i% = 32  ' Eu
          Text 191 * fx - TxtLen(buchst$(b_%(i%))) / 2, 412 * fy, buchst$(b_%(i%))
        Else If i% < 35  ' ie, äu
          Text 251 * fx + reihe%(i% - 33) * 44 * fx - TxtLen(buchst$(b_%(i%))) / 2, 412 * fy, buchst$(b_%(i%))
        Else If i% = 35  ' Sch
          Text 367 * fx - TxtLen(buchst$(b_%(i%))) / 2, 412 * fy, buchst$(b_%(i%))
        Else If i% < 38  ' ck, ch
          Text 439 * fx + reihe%(i% - 36) * 45 * fx - TxtLen(buchst$(b_%(i%))) / 2, 412 * fy, buchst$(b_%(i%))
        EndIf
      EndIf
    Next i%
    Clr tast$
    Get 19 * fx, 289 * fy, 506 * fx, 438 * fy, tast$
  Else
    Put 19 * fx, 289 * fy, tast$
  EndIf
Return
>Procedure tastaturabfrage
  DefMouse 0
  For taste% = 0 To 38
    If taste% < 10
      Exit If x > 20 * fx + taste% * 49 * fx And x < 64 * fx + taste% * 49 * fx And y > 290 * fy And y < 317 * fy
    Else If taste% < 16
      Exit If x > 20 * fx + (taste% - 10) * 49 * fx And x < 64 * fx + (taste% - 10) * 49 * fx And y > 330 * fy And y < 357 * fy
    Else If taste% = 16 ' Qu
      Exit If x > 314 * fx And x < 386 * fx And y > 330 * fy And y < 357 * fy
    Else If taste% = 17 ' R
      Exit If x > 391 * fx And x < 433 * fx And y > 330 * fy And y < 357 * fy
    Else If taste% = 18 ' S
      Exit If x > 438 * fx And x < 480 * fx And y > 330 * fy And y < 357 * fy
    Else If taste% = 19 ' ß
      Exit If x > 485 * fx And x < 504 * fx And y > 330 * fy And y < 357 * fy
    Else If taste% < 30
      Exit If x > 20 * fx + (taste% - 20) * 49 * fx And x < 64 * fx + (taste% - 20) * 49 * fx And y > 370 * fy And y < 397 * fy
    Else If taste% = 30 ' Au
      Exit If x > 20 * fx And x < 90 * fx And y > 410 * fy And y < 437 * fy
    Else If taste% = 31 ' Ei
      Exit If x > 95 * fx And x < 151 * fx And y > 410 * fy And y < 437 * fy
    Else If taste% = 32 ' Eu
      Exit If x > 156 * fx And x < 226 * fx And y > 410 * fy And y < 437 * fy
    Else If taste% < 35 ' ie, äu
      Exit If x > 231 * fx + (taste% - 33) * 45 * fx And x < 271 * fx + (taste% - 33) * 45 * fx And y > 410 * fy And y < 437 * fy
    Else If taste% = 35 ' Sch
      Exit If x > 321 * fx And x < 414 * fx And y > 410 * fy And y < 437 * fy
    Else If taste% < 38 ' ck, ch
      Exit If x > 419 * fx + (taste% - 36) * 45 * fx And x < 459 * fx + (taste% - 36) * 45 * fx And y > 410 * fy And y < 437 * fy
    EndIf
  Next taste%
  If taste% >= 38
    b_%(taste%) = 38
  EndIf
  hoehe% = Int(28 * fy)
  If art| < 6
    If taste% < 10
      FreeBmp tastbild%
      Get 20 * fx + taste% * 49 * fx, 290 * fy, 64 * fx + taste% * 49 * fx, 317 * fy, tastbild%
      breite% = Int(45 * fx)
    Else If taste% < 16
      FreeBmp tastbild%
      Get 20 * fx + (taste% - 10) * 49 * fx, 330 * fy, 64 * fx + (taste% - 10) * 49 * fx, 357 * fy, tastbild%
      breite% = Int(45 * fx)
    Else If taste% = 16 ' Qu
      FreeBmp tastbild%
      Get 314 * fx, 330 * fy, 386 * fx, 357 * fy, tastbild%
      breite% = Int(73 * fx)
    Else If taste% = 17 ' R
      FreeBmp tastbild%
      Get 391 * fx, 330 * fy, 433 * fx, 357 * fy, tastbild%
      breite% = Int(43 * fx)
    Else If taste% = 18 ' S
      FreeBmp tastbild%
      Get 438 * fx, 330 * fy, 480 * fx, 357 * fy, tastbild%
      breite% = Int(43 * fx)
    Else If taste% = 19 ' ß
      FreeBmp tastbild%
      Get 485 * fx, 330 * fy, 504 * fx, 357 * fy, tastbild%
      breite% = Ceil(19 * fx)
    Else If taste% < 30
      FreeBmp tastbild%
      Get 20 * fx + (taste% - 20) * 49 * fx, 370 * fy, 64 * fx + (taste% - 20) * 49 * fx, 397 * fy, tastbild%
      breite% = Int(45 * fx)
      If taste% = 20 ' T
        breite% = Ceil(44 * fx)
      EndIf
    Else If taste% = 30 ' Au
      FreeBmp tastbild%
      Get 20 * fx, 410 * fy, 90 * fx, 437 * fy, tastbild%
      breite% = Int(71 * fx)
    Else If taste% = 31 ' Ei
      FreeBmp tastbild%
      Get 95 * fx, 410 * fy, 151 * fx, 437 * fy, tastbild%
      breite% = Int(57 * fx)
    Else If taste% = 32 ' Eu
      FreeBmp tastbild%
      Get 156 * fx, 410 * fy, 226 * fx, 437 * fy, tastbild%
      breite% = Int(71 * fx)
    Else If taste% < 35 ' ie, äu
      FreeBmp tastbild%
      Get 231 * fx + (taste% - 33) * 45 * fx, 410 * fy, 271 * fx + (taste% - 33) * 45 * fx, 437 * fy, tastbild%
      breite% = Int(41 * fx)
    Else If taste% = 35 ' Sch
      FreeBmp tastbild%
      Get 321 * fx, 410 * fy, 414 * fx, 437 * fy, tastbild%
      breite% = Ceil(93 * fx)
    Else If taste% < 38 ' ck, ch
      FreeBmp tastbild%
      Get 419 * fx + (taste% - 36) * 45 * fx, 410 * fy, 459 * fx + (taste% - 36) * 45 * fx, 437 * fy, tastbild%
      breite% = Int(41 * fx)
    EndIf
  Else
    If taste% < 16
      breite% = Int(23 * fx)
    Else If taste% = 16 ' Qu
      breite% = Int(39 * fx)
    Else If taste% = 23 ' W
      breite% = Int(29 * fx)
    Else If taste% < 30
      breite% = Int(23 * fx)
    Else If taste% = 30 ' Au
      breite% = Int(35 * fx)
    Else If taste% = 31 ' Ei
      breite% = Int(29 * fx)
    Else If taste% = 32 ' Eu
      breite% = Int(35 * fx)
    Else If taste% = 33 ' ie
      breite% = Int(29 * fx)
    Else If taste% = 34 ' äu
      breite% = Int(35 * fx)
    Else If taste% = 35 ' Sch
      breite% = Int(47 * fx)
    Else If taste% < 38 ' ck, ch
      breite% = Int(35 * fx)
    EndIf
  EndIf
Return
>Procedure tastaturabfrage2
  If Asc(Upper$(ink$)) < 84
    asc% = Asc(Upper$(ink$)) - 65
  Else If Asc(ink$) = 223 ' ß
    asc% = 19
  Else If Asc(Upper$(ink$)) < 91
    asc% = Asc(Upper$(ink$)) - 64
  Else If Asc(ink$) = 196 Or Asc(ink$) = 228 ' Ä,ä
    asc% = 27
  Else If Asc(ink$) = 214 Or Asc(ink$) = 246 ' Ö,ö
    asc% = 28
  Else If Asc(ink$) = 220 Or Asc(ink$) = 252 ' Ü,ü
    asc% = 29
  EndIf
  If asc% < 10
    x% = 64 * fx + asc% * 49 * fx
    y% = 317 * fy
  Else If asc% < 16
    x% = 64 * fx + (asc% - 10) * 49 * fx
    y% = 357 * fy
  Else If asc% = 16 ' Qu
    x% = 386 * fx
    y% = 357 * fy
  Else If asc% = 17 ' R
    x% = 433 * fx
    y% = 357 * fy
  Else If asc% = 18 ' S
    x% = 480 * fx
    y% = 357 * fy
  Else If asc% = 19 ' ß
    x% = 504 * fx
    y% = 357 * fy
  Else If asc% < 30
    x% = 64 * fx + (asc% - 20) * 49 * fx
    y% = 397 * fy
  EndIf
  hoehe% = 29 * fy
  If asc% < 30
    breite% = 24 * fx
  EndIf
  If asc% = 23 ' W oder w
    breite% = 30 * fx
  EndIf
Return
>Procedure a1                   ' Merkwörter schieben
  If wortzahl| = 2
    zufall
  Else
    zufall1
  EndIf
  DefLine 0, 3 * fx
  RGBColor RGB(255, 0, 0) ' rot
  Box 37 * fx, 197 * fy, 161 * fx, 227 * fy ' Box für Wörter
  Box 184 * fx, 197 * fy, 308 * fx, 227 * fy
  Box 331 * fx, 197 * fy, 455 * fx, 227 * fy
  Box 478 * fx, 197 * fy, 602 * fx, 227 * fy
  DefFill 0
  DefLine 0, 1 * fx
  RGBColor RGB(255, 255, 255) ' weiß
  PBox 39 * fx, 199 * fy, 159 * fx, 225 * fy  ' P-Box für Wörter
  PBox 186 * fx, 199 * fy, 306 * fx, 225 * fy
  PBox 333 * fx, 199 * fy, 453 * fx, 225 * fy
  PBox 480 * fx, 199 * fy, 600 * fx, 225 * fy
  hinweis_beginn
  RGBColor RGB(255, 0, 0) ' rot
  DefLine 0, 3 * fx
  Box 37 * fx, 247 * fy, Ceil(161 * fx), Ceil(277 * fy) ' Box für Wörter
  Box 87 * fx, 287 * fy, Ceil(211 * fx), Ceil(317 * fy)
  Box 137 * fx, 327 * fy, Ceil(261 * fx), Ceil(357 * fy)
  Box 187 * fx, 367 * fy, Ceil(311 * fx), Ceil(397 * fy)
  Box 237 * fx, 407 * fy, Ceil(361 * fx), Ceil(437 * fy)
  DefLine 0, 1 * fx
  DefFill 0
  RGBColor RGB(255, 255, 255) ' weiß
  PBox 39 * fx, 249 * fy, 159 * fx, 275 * fy  ' Füllbox für Wörter
  PBox 89 * fx, 289 * fy, 209 * fx, 315 * fy
  PBox 139 * fx, 329 * fy, 259 * fx, 355 * fy
  PBox 189 * fx, 369 * fy, 309 * fx, 395 * fy
  PBox 239 * fx, 409 * fy, 359 * fx, 435 * fy
  text1$(0) = text$(aa%)
  text1$(1) = text$(bb%)
  text1$(2) = text$(cc%)
  text1$(3) = text$(dd%)
  text1$(4) = text$(ee%)
  PaintPicture fibelbild(aa%), 40 * fx, 30 * fy, 118 * fx, 157 * fy
  PaintPicture fibelbild(bb%), 187 * fx, 30 * fy, 118 * fx, 157 * fy
  PaintPicture fibelbild(cc%), 334 * fx, 30 * fy, 118 * fx, 157 * fy
  PaintPicture fibelbild(dd%), 481 * fx, 30 * fy, 118 * fx, 157 * fy
  GraphMode R2_COPYPEN, TRANSPARENT
  RGBColor RGB(0, 0, 0) ' schwarz
  SetFont schrift2%
  Text 99 * fx - TxtLen(text1$(aaa%)) / 2, 250 * fy, text1$(aaa%)
  Text 149 * fx - TxtLen(text1$(b%)) / 2, 290 * fy, text1$(b%)
  Text 199 * fx - TxtLen(text1$(ccc%)) / 2, 330 * fy, text1$(ccc%)
  Text 249 * fx - TxtLen(text1$(ddd%)) / 2, 370 * fy, text1$(ddd%)
  Text 299 * fx - TxtLen(text1$(eee%)) / 2, 410 * fy, text1$(eee%)
  For i% = 0 To 4
    FreeBmp textbild%(i%)
  Next i%
  Get 36 * fx, 246 * fy, Trunc(162 * fx), Trunc(278 * fy), textbild%(aaa%)
  Get 86 * fx, 286 * fy, Trunc(212 * fx), Trunc(318 * fy), textbild%(b%)
  Get 136 * fx, 326 * fy, Trunc(262 * fx), Trunc(358 * fy), textbild%(ccc%)
  Get 186 * fx, 366 * fy, Trunc(312 * fx), Trunc(398 * fy), textbild%(ddd%)
  Get 236 * fx, 406 * fy, Trunc(362 * fx), Trunc(438 * fy), textbild%(eee%)
  GraphMode R2_COPYPEN, TRANSPARENT
  Clr fertig0|, fertig1|, fertig2|, fertig3|, anfang|, oldx%, oldy%, altx%, alty%
  hilfe| = 1
  Repeat
    DefMouse 0
    f15:
    DefLine 0, 1
    If hilfe| = 2
      RGBColor RGB(255, 0, 0) ' rot
      If fertig0| = 0
        Text 99 * fx - TxtLen(text$(aa%)) / 2, 200 * fy, text$(aa%)
      EndIf
      If fertig1| = 0
        Text 246 * fx - TxtLen(text$(bb%)) / 2, 200 * fy, text$(bb%)
      EndIf
      If fertig2| = 0
        Text 393 * fx - TxtLen(text$(cc%)) / 2, 200 * fy, text$(cc%)
      EndIf
      If fertig3| = 0
        Text 540 * fx - TxtLen(text$(dd%)) / 2, 200 * fy, text$(dd%)
      EndIf
    Else If hilfe| = 1
      RGBColor RGB(255, 255, 255) ' weiß
      If fertig0| = 0
        PBox 39 * fx, 199 * fy, 159 * fx, 225 * fy  ' Füllbox für Wörter
      EndIf
      If fertig1| = 0
        PBox 186 * fx, 199 * fy, 306 * fx, 225 * fy
      EndIf
      If fertig2| = 0
        PBox 333 * fx, 199 * fy, 453 * fx, 225 * fy
      EndIf
      If fertig3| = 0
        PBox 480 * fx, 199 * fy, 600 * fx, 225 * fy
      EndIf
    EndIf
    If art| = 1 Or anfang| = 1
      FreeBmp bild%
      Get 0, 0, _X, _Y, bild%
      FreeBmp bild1%
      Get 0, 0, _X, _Y, bild1%
    EndIf
    Repeat
      PeekEvent
    Until MouseK = 0 And _Mess = 0
    Repeat
      Sleep
      Mouse x%, y%, k%
      ink$ = InKey$
    Until k% = 1 Or ink$ = Chr$(13) Or (Len(ink$) = 2 And (Asc(Right$(ink$)) = 119 Or Asc(Right$(ink$)) = 112))
    Exit If (ink$ = Chr$(13) And fertig0| = 1 And fertig1| = 1 And fertig2| = 1 And fertig3| = 1) Or (Len(ink$) = 2 And Asc(Right$(ink$)) = 119)
    If art| = 2 And anfang| = 0
      anfang| = 1
      RGBColor RGB(100, 0, 0)
      PBox 30 * fx, 30 * fy, 610 * fx, 190 * fy ' Abdeckung Memory
      FreeBmp bild%
      Get 0, 0, _X, _Y, bild%
      FreeBmp bild1%
      Get 0, 0, _X, _Y, bild1%
    EndIf
    If Len(ink$) > 1 And Asc(Right$(ink$)) = 112  ' F1-Taste
      If hilfe| = 1
        hilferuf| = 1
        hilfe| = 2
      Else
        hilfe| = 1
      EndIf
      GoTo f15
    EndIf
    hoehe% = 32 * fy
    breite% = 126 * fx
    Clr kopie%
    If x% > 35 * fx And x% < 165 * fx And y% > 245 * fy And y% < 281 * fy
      FreeBmp textbild%(aaa%)
      Get 36 * fx, 246 * fy, 162 * fx, 278 * fy, textbild%(aaa%)
      kopie% = textbild%(aaa%)
      wahl% = aaa%
    Else If x% > 85 * fx And x% < 215 * fx And y% > 285 * fy And y% < 321 * fy
      FreeBmp textbild%(b%)
      Get 86 * fx, 286 * fy, 212 * fx, 318 * fy, textbild%(b%)
      kopie% = textbild%(b%)
      wahl% = b%
    Else If x% > 135 * fx And x% < 265 * fx And y% > 325 * fy And y% < 361 * fy
      FreeBmp textbild%(ccc%)
      Get 136 * fx, 326 * fy, 262 * fx, 358 * fy, textbild%(ccc%)
      kopie% = textbild%(ccc%)
      wahl% = ccc%
    Else If x% > 185 * fx And x% < 315 * fx And y% > 365 * fy And y% < 401 * fy
      FreeBmp textbild%(ddd%)
      Get 186 * fx, 366 * fy, 312 * fx, 398 * fy, textbild%(ddd%)
      kopie% = textbild%(ddd%)
      wahl% = ddd%
    Else If x% > 235 * fx And x% < 365 * fx And y% > 405 * fy And y% < 441 * fy
      FreeBmp textbild%(eee%)
      Get 236 * fx, 406 * fy, 362 * fx, 438 * fy, textbild%(eee%)
      kopie% = textbild%(eee%)
      wahl% = eee%
    Else
      GoTo f15
    EndIf
    DefMouse 0
    GraphMode R2_COPYPEN, TRANSPARENT
    h2DC% = CreateCompatibleDC(Win_1.hDC)
    hNULL% = SelectObject(h2DC%, kopie%) 'selektiert logisches DC und Bitmap
    h4% = CreateCompatibleBitmap(Win_1.hDC, breite%, hoehe%) 'erzeugt eine Bitmap mit Handle h4%
    h4DC% = CreateCompatibleDC(Win_1.hDC)
    ~SelectObject(h4DC%, h4%)
    h3DC% = CreateCompatibleDC(Win_1.hDC)
    ~SelectObject(h3DC%, bild%)
    h5% = CreateCompatibleBitmap(Win_1.hDC, breite% * 2, hoehe% * 2)
    h5DC% = CreateCompatibleDC(Win_1.hDC)
    ~SelectObject(h5DC%, h5%)
    Repeat
      PeekEvent
    Until MouseK = 0 And _Mess = 0
    Do
      f16:
      PeekEvent
      Mouse x%, y%, k%
      Exit If k% = 2
      xx% = x% - breite%
      yy% = y% - hoehe%
      If xx% <> altx% Or yy% <> alty%
        ~BitBlt(h4DC%, 0, 0, breite%, hoehe%, h2DC%, 0, 0, SRCCOPY)
        rechtsx% = xx% + breite%
        unteny% = yy% + hoehe%
        altrechts% = altx% + breite%
        altunten% = alty% + hoehe%
        If rechtsx% < altx% Or unteny% < alty% Or yy% > altunten%
          GoTo n1
        EndIf
        If xx% < altrechts%
          If altx% > xx%
            rechtsx% = xx%
            altrechts% = breite% + altx% - xx%
          Else
            rechtsx% = altx%
            altrechts% = breite% + xx% - altx%
          EndIf
          If alty% > yy%
            unteny% = yy%
            altunten% = hoehe% + alty% - yy%
          Else
            unteny% = alty%
            altunten% = hoehe% + yy% - alty%
          EndIf
          ~BitBlt(h5DC%, 0, 0, altrechts%, altunten%, h3DC%, rechtsx%, unteny%, SRCCOPY)
          ~BitBlt(h5DC%, xx% - rechtsx%, yy% - unteny%, breite%, hoehe%, h4DC%, 0, 0, SRCCOPY)
          ~BitBlt(Win_1.hDC, rechtsx%, unteny%, altrechts%, altunten%, h5DC%, 0, 0, SRCCOPY)
        Else
          n1:
          ~BitBlt(Win_1.hDC, xx%, yy%, breite%, hoehe%, h4DC%, 0, 0, SRCCOPY)
          ~BitBlt(Win_1.hDC, altx%, alty%, breite%, hoehe%, h3DC%, altx%, alty%, SRCCOPY)
        EndIf
      EndIf
      altx% = xx%
      alty% = yy%
    Loop Until k% = 2
    Exit If (ink$ = Chr$(13) And fertig0| = 1 And fertig1| = 1 And fertig2| = 1 And fertig3| = 1) Or (Len(ink$) = 2 And Asc(Right$(ink$)) = 119)
    GraphMode R2_COPYPEN, TRANSPARENT
    RGBColor RGB(0, 0, 0) ' schwarz
    Put 0, 0, bild1%
    If y% > 200 * fy And y% < 224 * fy + hoehe% And (x% > 101 * fx And x% < 97 * fx + breite% Or x% > 248 * fx And x% < 244 * fx + breite% Or x% > 395 * fx And x% < 391 * fx + breite% Or x% > 542 * fx And x% < 538 * fx + breite%)
      If x% > 101 * fx And x% < 97 * fx + breite% And fertig0| = 0
        If wahl% = 0
          Text 99 * fx - TxtLen(text$(aa%)) / 2, 200 * fy, text$(aa%)
          PaintPicture fibelbild(aa%), 40 * fx, 30 * fy, 118 * fx, 157 * fy
          If lesen| = 1
            richtig = richtig + 36 / 20
          Else
            richtig = richtig + 1
          EndIf
          Inc richtig1%
          Clr fehler|
          fertig0| = 1
        Else
          fehler| = 1
          Inc falsch%
        EndIf
      Else If x% > 248 * fx And x% < 244 * fx + breite% And fertig1| = 0
        If wahl% = 1
          Text 246 * fx - TxtLen(text$(bb%)) / 2, 200 * fy, text$(bb%)
          PaintPicture fibelbild(bb%), 187 * fx, 30 * fy, 118 * fx, 157 * fy
          If lesen| = 1
            richtig = richtig + 36 / 20
          Else
            richtig = richtig + 1
          EndIf
          Inc richtig1%
          Clr fehler|
          fertig1| = 1
        Else
          fehler| = 1
          Inc falsch%
        EndIf
      Else If x% > 395 * fx And x% < 391 * fx + breite% And fertig2| = 0
        If wahl% = 2
          Text 393 * fx - TxtLen(text$(cc%)) / 2, 200 * fy, text$(cc%)
          PaintPicture fibelbild(cc%), 334 * fx, 30 * fy, 118 * fx, 157 * fy
          If lesen| = 1
            richtig = richtig + 36 / 20
          Else
            richtig = richtig + 1
          EndIf
          Inc richtig1%
          Clr fehler|
          fertig2| = 1
        Else
          fehler| = 1
          Inc falsch%
        EndIf
      Else If x% > 542 * fx And x% < 538 * fx + breite% And fertig3| = 0
        If wahl% = 3
          Text 540 * fx - TxtLen(text$(dd%)) / 2, 200 * fy, text$(dd%)
          PaintPicture fibelbild(dd%), 481 * fx, 30 * fy, 118 * fx, 157 * fy
          If lesen| = 1
            richtig = richtig + 36 / 20
          Else
            richtig = richtig + 1
          EndIf
          Inc richtig1%
          Clr fehler|
          fertig3| = 1
        Else
          fehler| = 1
          Inc falsch%
        EndIf
      EndIf
    EndIf
    saeule
    If h2DC% Then ~SelectObject(h2DC%, hNULL%)
    If h3DC% Then ~SelectObject(h3DC%, hNULL%)
    If h4DC% Then ~SelectObject(h4DC%, hNULL%)
    If h5DC% Then ~SelectObject(h5DC%, hNULL%)
    ~DeleteDC(h2DC%)
    ~DeleteDC(h3DC%)
    ~DeleteDC(h4DC%)
    ~DeleteDC(h5DC%)
    FreeBmp h4%
    FreeBmp h5%
    Exit If richtig >= 36 Or falsch% >= 36
  Until (ink$ = Chr$(13) And fertig0| = 1 And fertig1| = 1 And fertig2| = 1 And fertig3| = 1) Or (Len(ink$) = 2 And Asc(Right$(ink$)) = 119)
  If Len(ink$) = 2 And Asc(Right$(ink$)) = 119 Or richtig >= 36 Or falsch% >= 36
    ende| = 1
  EndIf
Return
>Procedure a3                   ' Merklaute schieben
  zufall1
  DefLine 0, 3 * fx
  RGBColor RGB(255, 0, 0) ' rot
  Box 37 * fx, 197 * fy, 161 * fx, 227 * fy ' Box für Wörter
  Box 184 * fx, 197 * fy, 308 * fx, 227 * fy
  Box 331 * fx, 197 * fy, 455 * fx, 227 * fy
  Box 478 * fx, 197 * fy, 602 * fx, 227 * fy
  DefFill 0
  DefLine 0, 1 * fx
  RGBColor RGB(255, 255, 255) ' weiß
  PBox 39 * fx, 199 * fy, 159 * fx, 225 * fy  ' P-Box für Wörter
  PBox 186 * fx, 199 * fy, 306 * fx, 225 * fy
  PBox 333 * fx, 199 * fy, 453 * fx, 225 * fy
  PBox 480 * fx, 199 * fy, 600 * fx, 225 * fy
  PaintPicture fibelbild(aa%), 40 * fx, 30 * fy, 118 * fx, 157 * fy
  PaintPicture fibelbild(bb%), 187 * fx, 30 * fy, 118 * fx, 157 * fy
  PaintPicture fibelbild(cc%), 334 * fx, 30 * fy, 118 * fx, 157 * fy
  PaintPicture fibelbild(dd%), 481 * fx, 30 * fy, 118 * fx, 157 * fy
  hinweis_beginn
  tastaturmalen
  GraphMode R2_COPYPEN, TRANSPARENT
  Clr fertig0|, fertig1|, fertig2|, fertig3|, anfang|
  If art| = 4
    FreeBmp bild%
    Get 0, 0, _X, _Y, bild%
  EndIf
  hilfe| = 1
  Repeat
    PeekEvent
    DefMouse 0
    f17:
    DefLine 0, 1
    If hilfe| = 2
      RGBColor RGB(255, 0, 0) ' rot
      If fertig0| = 0
        Text 99 * fx - TxtLen(buchst$(aa%)) / 2, 200 * fy, buchst$(aa%)
      EndIf
      If fertig1| = 0
        Text 246 * fx - TxtLen(buchst$(bb%)) / 2, 200 * fy, buchst$(bb%)
      EndIf
      If fertig2| = 0
        Text 393 * fx - TxtLen(buchst$(cc%)) / 2, 200 * fy, buchst$(cc%)
      EndIf
      If fertig3| = 0
        Text 540 * fx - TxtLen(buchst$(dd%)) / 2, 200 * fy, buchst$(dd%)
      EndIf
    Else If hilfe| = 1
      RGBColor RGB(255, 255, 255) ' weiß
      If fertig0| = 0
        PBox 39 * fx, 199 * fy, 159 * fx, 225 * fy  ' Füllbox für Wörter
      EndIf
      If fertig1| = 0
        PBox 186 * fx, 199 * fy, 306 * fx, 225 * fy
      EndIf
      If fertig2| = 0
        PBox 333 * fx, 199 * fy, 453 * fx, 225 * fy
      EndIf
      If fertig3| = 0
        PBox 480 * fx, 199 * fy, 600 * fx, 225 * fy
      EndIf
    EndIf
    If art| = 3 Or (art| = 5 And anfang| = 1)
      FreeBmp bild%
      Get 0, 0, _X, _Y, bild%
      FreeBmp bild1%
      Get 0, 0, _X, _Y, bild1%
    EndIf
    f20:
    Repeat
      PeekEvent
    Until MouseK = 0 And _Mess = 0
    Repeat
      Sleep
      Mouse x%, y%, k%
      ink$ = InKey$
    Until k% = 1 Or ink$ = Chr$(13) Or (Len(ink$) = 2 And (Asc(Right$(ink$)) = 119 Or Asc(Right$(ink$)) = 112))
    Exit If (ink$ = Chr$(13) And fertig0| = 1 And fertig1| = 1 And fertig2| = 1 And fertig3| = 1) Or (Len(ink$) = 2 And Asc(Right$(ink$)) = 119)
    If Len(ink$) > 1 And Asc(Right$(ink$)) = 112  ' F1-Taste
      If hilfe| = 1
        hilfe| = 2
        hilferuf| = 1
      Else
        hilfe| = 1
      EndIf
      GoTo f17
    EndIf
    tastaturabfrage
    If b_%(taste%) >= anzahl% Or b_%(taste%) = 38
      GoTo f20
    Else
      If art| = 4 Or (art| = 5 And anfang| = 0)
        If anfang| = 0
          DefFill 0
          RGBColor RGB(100, 0, 0)
          PBox 30 * fx, 30 * fy, 610 * fx, 190 * fy ' Abdeckung Memory
        EndIf
        If art| = 5
          FreeBmp bild%
          Get 0, 0, _X, _Y, bild%
        EndIf
        FreeBmp bild1%
        Get 0, 0, _X, _Y, bild1%
        anfang| = 1
      EndIf
      Clr kopie%
      kopie% = tastbild%
      DefMouse 0
      h2DC% = CreateCompatibleDC(Win_1.hDC)
      hNULL% = SelectObject(h2DC%, kopie%) 'selektiert logisches DC und Bitmap
      h4% = CreateCompatibleBitmap(Win_1.hDC, breite%, hoehe%) 'erzeugt eine Bitmap mit Handle h4%
      h4DC% = CreateCompatibleDC(Win_1.hDC)
      ~SelectObject(h4DC%, h4%) ' ordnet dem DC h4DC% die Bitmap h4% zu
      h3DC% = CreateCompatibleDC(Win_1.hDC)
      ~SelectObject(h3DC%, bild%)
      h5% = CreateCompatibleBitmap(Win_1.hDC, breite% * 2, hoehe% * 2)
      h5DC% = CreateCompatibleDC(Win_1.hDC)
      ~SelectObject(h5DC%, h5%)
      Clr start|
      Repeat
        PeekEvent
      Until MouseK = 0 And _Mess = 0
      Do
        PeekEvent
        Mouse x%, y%, k%
        xx% = x% - breite%
        yy% = y% - hoehe%
        If xx% <> altx% Or yy% <> alty%
          ~BitBlt(h4DC%, 0, 0, breite%, hoehe%, h2DC%, 0, 0, SRCCOPY)
          rechtsx% = xx% + breite%
          unteny% = yy% + hoehe%
          altrechts% = altx% + breite%
          altunten% = alty% + hoehe%
          If rechtsx% < altx% Or unteny% < alty% Or yy% > altunten%
            GoTo n2
          EndIf
          If xx% < altrechts%
            If altx% > xx%
              rechtsx% = xx%
              altrechts% = breite% + altx% - xx%
            Else
              rechtsx% = altx%
              altrechts% = breite% + xx% - altx%
            EndIf
            If alty% > yy%
              unteny% = yy%
              altunten% = hoehe% + alty% - yy%
            Else
              unteny% = alty%
              altunten% = hoehe% + yy% - alty%
            EndIf
            ~BitBlt(h5DC%, 0, 0, altrechts%, altunten%, h3DC%, rechtsx%, unteny%, SRCCOPY)
            ~BitBlt(h5DC%, xx% - rechtsx%, yy% - unteny%, breite%, hoehe%, h4DC%, 0, 0, SRCCOPY)
            ~BitBlt(Win_1.hDC, rechtsx%, unteny%, altrechts%, altunten%, h5DC%, 0, 0, SRCCOPY)
          Else
            n2:
            ~BitBlt(Win_1.hDC, xx%, yy%, breite%, hoehe%, h4DC%, 0, 0, SRCCOPY)
            ~BitBlt(Win_1.hDC, altx%, alty%, breite%, hoehe%, h3DC%, altx%, alty%, SRCCOPY)
          EndIf
        EndIf
        If art| = 4 And start| = 0
          start| = 1
          RGBColor RGB(0, 0, 0) ' schwarz
          If fertig0| = 1
            Text 99 * fx - TxtLen(text$(aa%)) / 2, 200 * fy, text$(aa%)
          EndIf
          If fertig1| = 1
            Text 246 * fx - TxtLen(text$(bb%)) / 2, 200 * fy, text$(bb%)
          EndIf
          If fertig2| = 1
            Text 393 * fx - TxtLen(text$(cc%)) / 2, 200 * fy, text$(cc%)
          EndIf
          If fertig3| = 1
            Text 540 * fx - TxtLen(text$(dd%)) / 2, 200 * fy, text$(dd%)
          EndIf
        EndIf
        altx% = xx%
        alty% = yy%
      Loop Until k% = 2
      Exit If (ink$ = Chr$(13) And fertig0| = 1 And fertig1| = 1 And fertig2| = 1 And fertig3| = 1) Or (Len(ink$) = 2 And Asc(Right$(ink$)) = 119)
      GraphMode R2_COPYPEN, TRANSPARENT
      Put 0, 0, bild1%
      If y% > 200 * fy And y% < 224 * fy + hoehe% And (x% > 37 * fx + breite% / 2 And x% < 161 * fx + breite% / 2 Or x% > 184 * fx + breite% / 2 And x% < 308 * fx + breite% / 2 Or x% > 331 * fx + breite% / 2 And x% < 455 * fx + breite% / 2 Or x% > 478 * fx + breite% / 2 And x% < 602 * fx + breite% / 2)
        If x% > 37 * fx + breite% / 2 And x% < 161 * fx + breite% / 2 And fertig0| = 0
          If b_%(taste%) = aa%
            RGBColor RGB(255, 255, 255) ' weiß
            PBox 39 * fx, 199 * fy, 159 * fx, 225 * fy  ' Füllbox für Wörter
            RGBColor RGB(0, 0, 0) ' schwarz
            Text 99 * fx - TxtLen(text$(aa%)) / 2, 200 * fy, text$(aa%)
            PaintPicture fibelbild(aa%), 40 * fx, 30 * fy, 118 * fx, 157 * fy
            If lesen| = 1
              richtig = richtig + 36 / 20
            Else
              richtig = richtig + 1
            EndIf
            Inc richtig1%
            Clr fehler|
            fertig0| = 1
          Else
            fehler| = 1
            Inc falsch%
          EndIf
        Else If x% > 184 * fx + breite% / 2 And x% < 308 * fx + breite% / 2 And fertig1| = 0
          If b_%(taste%) = bb%
            RGBColor RGB(255, 255, 255) ' weiß
            PBox 186 * fx, 199 * fy, 306 * fx, 225 * fy
            RGBColor RGB(0, 0, 0) ' schwarz
            Text 246 * fx - TxtLen(text$(bb%)) / 2, 200 * fy, text$(bb%)
            PaintPicture fibelbild(bb%), 187 * fx, 30 * fy, 118 * fx, 157 * fy
            If lesen| = 1
              richtig = richtig + 36 / 20
            Else
              richtig = richtig + 1
            EndIf
            Inc richtig1%
            Clr fehler|
            fertig1| = 1
          Else
            fehler| = 1
            Inc falsch%
          EndIf
        Else If x% > 331 * fx + breite% / 2 And x% < 455 * fx + breite% / 2 And fertig2| = 0
          If b_%(taste%) = cc%
            RGBColor RGB(255, 255, 255) ' weiß
            PBox 333 * fx, 199 * fy, 453 * fx, 225 * fy
            RGBColor RGB(0, 0, 0) ' schwarz
            Text 393 * fx - TxtLen(text$(cc%)) / 2, 200 * fy, text$(cc%)
            PaintPicture fibelbild(cc%), 334 * fx, 30 * fy, 118 * fx, 157 * fy
            If lesen| = 1
              richtig = richtig + 36 / 20
            Else
              richtig = richtig + 1
            EndIf
            Inc richtig1%
            Clr fehler|
            fertig2| = 1
          Else
            fehler| = 1
            Inc falsch%
          EndIf
        Else If x% > 478 * fx + breite% / 2 And x% < 602 * fx + breite% / 2 And fertig3| = 0
          If b_%(taste%) = dd%
            RGBColor RGB(255, 255, 255) ' weiß
            PBox 480 * fx, 199 * fy, 600 * fx, 225 * fy
            RGBColor RGB(0, 0, 0) ' schwarz
            Text 540 * fx - TxtLen(text$(dd%)) / 2, 200 * fy, text$(dd%)
            PaintPicture fibelbild(dd%), 481 * fx, 30 * fy, 118 * fx, 157 * fy
            If lesen| = 1
              richtig = richtig + 36 / 20
            Else
              richtig = richtig + 1
            EndIf
            Inc richtig1%
            Clr fehler|
            fertig3| = 1
          Else
            fehler| = 1
            Inc falsch%
          EndIf
        EndIf
      EndIf
      saeule
      If h2DC% Then ~SelectObject(h2DC%, hNULL%)
      If h3DC% Then ~SelectObject(h3DC%, hNULL%)
      If h4DC% Then ~SelectObject(h4DC%, hNULL%)
      If h5DC% Then ~SelectObject(h5DC%, hNULL%)
      ~DeleteDC(h2DC%)
      ~DeleteDC(h3DC%)
      ~DeleteDC(h4DC%)
      ~DeleteDC(h5DC%)
      FreeBmp h4%
      FreeBmp h5%
      Exit If richtig >= 36 Or falsch% >= 36
    EndIf
  Until (ink$ = Chr$(13) And fertig0| = 1 And fertig1| = 1 And fertig2| = 1 And fertig3| = 1) Or (Len(ink$) = 2 And Asc(Right$(ink$)) = 119)
  If Len(ink$) = 2 And Asc(Right$(ink$)) = 119 Or richtig >= 36 Or falsch% >= 36
    ende| = 1
  EndIf
Return
>Procedure a6                   ' Buchstaben anklicken und laufen lassen
  firsttime| = 1
  wiederhol6:
  If wortzahl| = 2
    zufall
  Else
    zufall1
  EndIf
  RGBColor RGB(255, 0, 0) ' rot
  DefLine 0, 3 * fx
  If art| <> 9
    PaintPicture fibelbild(aa%), 260 * fx, 30 * fy, 118 * fx, 157 * fy
  EndIf
  Box 257 * fx, 197 * fy, 381 * fx, 227 * fy ' Box für Wort
  DefLine 0, Ceil(3 * fx)
  Line 6 * fx, 238 * fy, 632 * fx, 238 * fy ' Trennung oben/unten
  DefFill 0
  DefLine 0, 1 * fx
  RGBColor RGB(255, 255, 255) ' weiß
  PBox 259 * fx, 199 * fy, 379 * fx, 225 * fy  ' P-Box für Wort
  If beginn| = 0
    hinweis_beginn
    tastaturmalen
  EndIf
  RGBColor RGB(100, 0, 0) ' dunkelbraun
  PBox 150 * fx, 230 * fy, 500 * fx, 238 * fy    ' Abdeckung Wortkärtchen
  RGBColor RGB(255, 255, 198) ' creme
  PBox 150 * fx, 238 * fy, 500 * fx, 268 * fy
  RGBColor RGB(255, 0, 0) ' rot
  DefLine 0, Ceil(3 * fx)
  Line 6 * fx, 238 * fy, 632 * fx, 238 * fy ' Trennung oben/unten
  PaintPicture fibelbild(aa%), 260 * fx, 30 * fy, 118 * fx, 157 * fy
  GraphMode R2_COPYPEN, TRANSPARENT
  Clr fertig0|, fehler|, xpunkt%
  stelle% = 1
  hilfe| = 1
  DefMouse 0
  f18:
  DefLine 0, 1
  If hilfe| = 2
    RGBColor RGB(255, 0, 0) ' rot
    If fertig0| = 0
      Text 319 * fx - TxtLen(text$(aa%)) / 2, 200 * fy, text$(aa%)
    EndIf
  Else If hilfe| = 1
    RGBColor RGB(255, 255, 255) ' weiß
    If fertig0| = 0
      PBox 259 * fx, 199 * fy, 379 * fx, 225 * fy  ' Füllbox für Wörter
    EndIf
  EndIf
  If firsttime|
    FreeBmp bild%
    Get 0, 0, _X, _Y, bild%
  EndIf
  FreeBmp bild1%
  Get 0, 0, 510 * fx, _Y, bild1%
  f19:
  Clr ink$, x%, y%, k%
  Repeat
    PeekEvent
  Until MouseK = 0 And _Mess = 0
  Repeat
    Sleep
    Mouse x%, y%, k%
    ink$ = InKey$
  Until k% = 1 Or (Len(ink$) = 2 And (Asc(Right$(ink$)) = 119 Or Asc(Right$(ink$)) = 112))
  If Len(ink$) = 2 And Asc(Right$(ink$)) = 119 Or ((richtig >= 36 Or falsch% >= 36) And (art| <> 9 Or (art| = 9 And stelle% > Len(text$(aa%)))))
    ende| = 1
    GoTo kontroll6
  EndIf
  If Len(ink$) = 2 And Asc(Right$(ink$)) = 112  ' F1-Taste
    If hilfe| = 1
      hilfe| = 2
      hilferuf| = 1
    Else
      hilfe| = 1
    EndIf
    If hilfe| = 2
      RGBColor RGB(255, 0, 0) ' rot
      If fertig0| = 0
        Text 319 * fx - TxtLen(text$(aa%)) / 2, 200 * fy, text$(aa%)
      EndIf
    Else If hilfe| = 1
      RGBColor RGB(255, 255, 255) ' weiß
      If fertig0| = 0
        PBox 259 * fx, 199 * fy, 379 * fx, 225 * fy  ' Füllbox für Wörter
      EndIf
    EndIf
    GoTo f19
  EndIf
  tastaturabfrage
  If !firsttime|
    ~BitBlt(h3DC%, 0, 0, _X, _Y, Win_1.hDC, 0, 0, SRCCOPY)
  EndIf
  If (b_%(taste%) >= anzahl% And art| < 7) Or b_%(taste%) = 38
    GoTo f19
  EndIf
  RGBColor RGB(255, 255, 0) ' gelb
  DefFill 0
  PBox x% - breite%, y% - hoehe%, x% - 1, y% - 1
  RGBColor RGB(255, 0, 0) ' rot
  DefLine 0, 1
  Box x% - breite%, y% - hoehe%, x% - 1, y% - 1
  RGBColor RGB(0, 0, 0) ' schwarz
  If art| = 6                 ' Anfangsbuchstaben
    Text x% - breite% / 2 - TxtLen(alph$(b_%(taste%))) / 2, y% - hoehe% + 3 * fy, alph$(b_%(taste%))
  Else If art| = 7 Or art| = 8  ' Mitte oder Ende
    Text x% - breite% / 2 - TxtLen(Lower$(alph$(b_%(taste%)))) / 2, y% - hoehe% + 3 * fy, Lower$(alph$(b_%(taste%)))
  Else If art| = 9            ' alle Buchstaben
    If stelle% = 1
      Text x% - breite% / 2 - TxtLen(alph$(b_%(taste%))) / 2, y% - hoehe% + 3 * fy, alph$(b_%(taste%))
    Else
      Text x% - breite% / 2 - TxtLen(Lower$(alph$(b_%(taste%)))) / 2, y% - hoehe% + 3 * fy, Lower$(alph$(b_%(taste%)))
    EndIf
  EndIf
  FreeBmp tastbild%
  Get x% - breite%, y% - hoehe%, x%, y%, tastbild%
  DefMouse 0
  GraphMode R2_COPYPEN, TRANSPARENT
  If firsttime|
    h2DC% = CreateCompatibleDC(Win_1.hDC)
    hNULL% = SelectObject(h2DC%, tastbild%) 'selektiert logisches DC und Bitmap
    h4% = CreateCompatibleBitmap(Win_1.hDC, 64 * fx, hoehe%) 'erzeugt eine Bitmap mit Handle h4%
    h4DC% = CreateCompatibleDC(Win_1.hDC)
    ~SelectObject(h4DC%, h4%) ' ordnet dem DC h4DC% die Bitmap h4% zu
    h3DC% = CreateCompatibleDC(Win_1.hDC)
    ~SelectObject(h3DC%, bild%)
    h5% = CreateCompatibleBitmap(Win_1.hDC, 100 * fx, hoehe% * 2)
    h5DC% = CreateCompatibleDC(Win_1.hDC)
    ~SelectObject(h5DC%, h5%)
    ~SelectObject(Win_1.hDC, hNULL%)
    firsttime| = 0
  Else
    ~SelectObject(h2DC%, tastbild%)
  EndIf
  Repeat
    PeekEvent
  Until MouseK = 0 And _Mess = 0
  Clr anfang|
  Do
    Local time# = Timer
    PeekEvent
    If anfang| = 0
      anfang| = 1
      xxxx# = x%
      yyyy# = y%
      If art| > 5 And art| < 9
        xpunkt% = 319 * fx + breite% / 2
      Else If art| = 9
        If stelle% = 1
          xpunkt% = _X / 2 - Len(text$(aa%)) * 6.5
          altstelle% = stelle%
        Else If stelle% > altstelle%
          Add xpunkt%, breite% - 1
        EndIf
      EndIf
      abstandx# = x% - xpunkt%
      abstandy# = y% - Int(260 * fy)
      If Abs(abstandx#) > Abs(abstandy#)
        abstandy# = Abs(abstandy# / abstandx#)
        If Int(xxxx#) < xpunkt%
          abstandx# = -1
        Else
          abstandx# = 1
        EndIf
      Else
        If Int(xxxx#) < xpunkt%
          abstandx# = -Abs(abstandx# / abstandy#)
        Else
          abstandx# = Abs(abstandx# / abstandy#)
        EndIf
        abstandy# = 1
      EndIf
      yyyy# = yyyy# + abstandy#
      xxxx# = xxxx# + abstandx#
    EndIf
    If yyyy# > Int(261 * fy)
      yyyy# = yyyy# - abstandy#
      xxxx# = xxxx# - abstandx#
    Else
      yyyy# = Int(260 * fy)
      xxxx# = xpunkt%
    EndIf
    xx% = xxxx# - breite%
    yy% = yyyy# - hoehe%
    If xx% <> altx% Or yy% <> alty%
      ~BitBlt(h4DC%, 0, 0, breite%, hoehe%, h2DC%, 0, 0, SRCCOPY)
      rechtsx% = xx% + breite%
      unteny% = yy% + hoehe%
      altrechts% = altx% + breite%
      altunten% = alty% + hoehe%
      If rechtsx% < altx% Or unteny% < alty% Or yy% > altunten%
        GoTo n3
      EndIf
      If xx% < altrechts%
        If altx% > xx%
          rechtsx% = xx%
          altrechts% = breite% + altx% - xx%
        Else
          rechtsx% = altx%
          altrechts% = breite% + xx% - altx%
        EndIf
        If alty% > yy%
          unteny% = yy%
          altunten% = hoehe% + alty% - yy%
        Else
          unteny% = alty%
          altunten% = hoehe% + yy% - alty%
        EndIf
        ~BitBlt(h5DC%, 0, 0, altrechts%, altunten%, h3DC%, rechtsx%, unteny%, SRCCOPY)
        ~BitBlt(h5DC%, xx% - rechtsx%, yy% - unteny%, breite%, hoehe%, h4DC%, 0, 0, SRCCOPY)
        ~BitBlt(Win_1.hDC, rechtsx%, unteny%, altrechts%, altunten%, h5DC%, 0, 0, SRCCOPY)
      Else
        n3:
        ~BitBlt(Win_1.hDC, xx%, yy%, breite%, hoehe%, h4DC%, 0, 0, SRCCOPY)
        ~BitBlt(Win_1.hDC, altx%, alty%, breite%, hoehe%, h3DC%, altx%, alty%, SRCCOPY)
      EndIf
    EndIf
    PeekEvent
    altx% = xx%
    alty% = yy%
    Repeat
      PeekEvent
    Until Timer - time# > 0.0005
  Loop Until Ceil(yyyy#) = Int(260 * fy)
  GraphMode R2_COPYPEN, TRANSPARENT
  If art| = 6
    If alph$(b_%(taste%)) = Left$(text$(aa%), Len(alph$(b_%(taste%))))
      RGBColor RGB(255, 255, 255) ' weiß
      PBox 259 * fx, 199 * fy, 379 * fx, 225 * fy  ' Füllbox für Wörter
      RGBColor RGB(0, 0, 0) ' schwarz
      Text 319 * fx - TxtLen(text$(aa%)) / 2, 200 * fy, text$(aa%)
      If lesen| = 1
        richtig = richtig + 36 / 20
      Else
        richtig = richtig + 1
      EndIf
      Inc richtig1%
      Clr fehler|
      fertig0| = 1
    Else
      RGBColor RGB(255, 255, 255) ' weiß
      PBox 259 * fx, 199 * fy, 379 * fx, 225 * fy  ' Füllbox für Wörter
      RGBColor RGB(255, 0, 0) ' rot
      Text 319 * fx - TxtLen(text$(aa%)) / 2, 200 * fy, text$(aa%)
      fehler| = 1
      Inc falsch%
    EndIf
  Else If art| = 7
    If InStr(text$(aa%), Lower$(alph$(b_%(taste%)))) > 1 And InStr(text$(aa%), Lower$(alph$(b_%(taste%)))) < Len(text$(aa%))
      RGBColor RGB(255, 255, 255) ' weiß
      PBox 259 * fx, 199 * fy, 379 * fx, 225 * fy  ' Füllbox für Wörter
      RGBColor RGB(0, 0, 0) ' schwarz
      Text 319 * fx - TxtLen(text$(aa%)) / 2, 200 * fy, text$(aa%)
      If lesen| = 1
        richtig = richtig + 36 / 20
      Else
        richtig = richtig + 1
      EndIf
      Inc richtig1%
      Clr fehler|
      fertig0| = 1
    Else
      RGBColor RGB(255, 255, 255) ' weiß
      PBox 259 * fx, 199 * fy, 379 * fx, 225 * fy  ' Füllbox für Wörter
      RGBColor RGB(255, 0, 0) ' rot
      Text 319 * fx - TxtLen(text$(aa%)) / 2, 200 * fy, text$(aa%)
      fehler| = 1
      Inc falsch%
    EndIf
  Else If art| = 8
    If Lower$(alph$(b_%(taste%))) = Lower$(Right$(text$(aa%), Len(alph$(b_%(taste%)))))
      RGBColor RGB(255, 255, 255) ' weiß
      PBox 259 * fx, 199 * fy, 379 * fx, 225 * fy  ' Füllbox für Wörter
      RGBColor RGB(0, 0, 0) ' schwarz
      Text 319 * fx - TxtLen(text$(aa%)) / 2, 200 * fy, text$(aa%)
      If lesen| = 1
        richtig = richtig + 36 / 20
      Else
        richtig = richtig + 1
      EndIf
      Inc richtig1%
      Clr fehler|
      fertig0| = 1
    Else
      RGBColor RGB(255, 255, 255) ' weiß
      PBox 259 * fx, 199 * fy, 379 * fx, 225 * fy  ' Füllbox für Wörter
      RGBColor RGB(255, 0, 0) ' rot
      Text 319 * fx - TxtLen(text$(aa%)) / 2, 200 * fy, text$(aa%)
      fehler| = 1
      Inc falsch%
    EndIf
  Else If art| = 9
    altstelle% = stelle%
    If stelle% = 1 And alph$(b_%(taste%)) = Left$(text$(aa%), Len(alph$(b_%(taste%))))
      richtig = richtig + 1
      Inc richtig1%
      Clr fehler|
      stelle% = stelle% + Len(alph$(b_%(taste%)))
    Else If stelle% > 1 And Mid$(text$(aa%), stelle%, Len(alph$(b_%(taste%)))) = Lower$(alph$(b_%(taste%)))
      richtig = richtig + 1
      Inc richtig1%
      Clr fehler|
      stelle% = stelle% + Len(alph$(b_%(taste%)))
    Else
      fehler| = 1
      altrichtig% = richtig
      richtig = richtig - stelle% + 1
      Inc falsch%
      PaintPicture fibelbild(aa%), 260 * fx, 30 * fy, 118 * fx, 157 * fy
    EndIf
    If stelle% > Len(text$(aa%)) Or fehler| = 1
      If fehler| = 0
        RGBColor RGB(0, 0, 0) ' schwarz
      Else
        RGBColor RGB(255, 0, 0) ' rot
        stelle% = 1
        altstelle% = 1
      EndIf
      Text 319 * fx - TxtLen(text$(aa%)) / 2, 200 * fy, text$(aa%)
    EndIf
  EndIf
  saeule
  If art| < 9 Or (art| = 9 And (stelle% > Len(text$(aa%))) Or fehler| = 1)
    Repeat
      Sleep
      ink$ = InKey$
    Until ink$ = Chr$(13) Or (Len(ink$) = 2 And (Asc(Right$(ink$)) = 119 Or Asc(Right$(ink$)) = 112))
  EndIf
  If art| <> 9
    Put 0, 0, bild1%
  EndIf
  If falsch% >= 5 Or (richtig >= 5 And (art| <> 9 Or (art| = 9 And stelle% > Len(text$(aa%)))))
    ende| = 1
    RGBColor RGB(100, 0, 0) ' dunkelbraun
    PBox 210 * fx, 230 * fy, 410 * fx, 238 * fy
    RGBColor RGB(255, 255, 198) ' creme
    PBox 210 * fx, 238 * fy, 410 * fx, 268 * fy
    RGBColor RGB(255, 0, 0) ' rot
    DefLine 0, Ceil(3 * fx)
    Line 210 * fx, 238 * fy, 410 * fx, 238 * fy ' Trennung oben/unten
    GoTo kontroll6
  EndIf
  If Len(ink$) = 2 And Asc(Right$(ink$)) = 119
    ende| = 1
    RGBColor RGB(100, 0, 0) ' dunkelbraun
    PBox 210 * fx, 230 * fy, 410 * fx, 238 * fy
    RGBColor RGB(255, 255, 198) ' creme
    PBox 210 * fx, 238 * fy, 410 * fx, 268 * fy
    RGBColor RGB(255, 0, 0) ' rot
    DefLine 0, Ceil(3 * fx)
    Line 210 * fx, 238 * fy, 410 * fx, 238 * fy ' Trennung oben/unten
    GoTo kontroll6
  EndIf
  If art| = 9 And stelle% <= Len(text$(aa%))
    If fehler| = 1
      PaintPicture fibelbild(aa%), 260 * fx, 30 * fy, 118 * fx, 157 * fy
      RGBColor RGB(100, 0, 0) ' dunkelbraun
      PBox 210 * fx, 230 * fy, 410 * fx, 238 * fy
      RGBColor RGB(255, 255, 198) ' creme
      PBox 210 * fx, 238 * fy, 410 * fx, 268 * fy
      RGBColor RGB(255, 0, 0) ' rot
      DefLine Ceil(0), 3 * fx
      Line 210 * fx, 238 * fy, 410 * fx, 238 * fy ' Trennung oben/unten
    EndIf
    GoTo f18
  EndIf
  If fehler| = 1
    GoTo f18
  EndIf
  GoTo wiederhol6
  kontroll6:
  If firsttime| = 0
    If h2DC% Then ~SelectObject(h2DC%, hNULL%)
    If h3DC% Then ~SelectObject(h3DC%, hNULL%)
    If h4DC% Then ~SelectObject(h4DC%, hNULL%)
    If h5DC% Then ~SelectObject(h5DC%, hNULL%)
    ~DeleteDC(h2DC%)
    ~DeleteDC(h3DC%)
    ~DeleteDC(h4DC%)
    ~DeleteDC(h5DC%)
    FreeBmp h4%
    FreeBmp h5%
  EndIf
Return
>Procedure a10                  ' Buchstaben schreiben und laufen lassen
  firsttime| = 1
  wiederhol10:
  alph$(35) = "Q"
  If wortzahl| = 2
    zufall
  Else
    zufall1
  EndIf
  RGBColor RGB(255, 0, 0) ' rot
  DefLine 0, 3 * fx
  If art| < 13
    PaintPicture fibelbild(aa%), 260 * fx, 30 * fy, 118 * fx, 157 * fy
  EndIf
  Box 257 * fx, 197 * fy, 381 * fx, 227 * fy ' Box für Wort
  DefLine 0, Ceil(3 * fx)
  Line 6 * fx, 238 * fy, 632 * fx, 238 * fy ' Trennung oben/unten
  DefFill 0
  DefLine 0, 1 * fx
  RGBColor RGB(255, 255, 255) ' weiß
  PBox 259 * fx, 199 * fy, 379 * fx, 225 * fy  ' P-Box für Wort
  If beginn| = 0
    hinweis_beginn
    tastaturmalen
  EndIf
  RGBColor RGB(100, 0, 0) ' dunkelbraun
  PBox 150 * fx, 230 * fy, 500 * fx, 238 * fy    ' Abdeckung Wortkärtchen
  RGBColor RGB(255, 255, 198) ' creme
  PBox 150 * fx, 238 * fy, 500 * fx, 268 * fy
  RGBColor RGB(255, 0, 0) ' rot
  DefLine 0, Ceil(3 * fx)
  Line 6 * fx, 238 * fy, 632 * fx, 238 * fy ' Trennung oben/unten
  If art| = 13
    PaintPicture fibelbild(aa%), 260 * fx, 30 * fy, 118 * fx, 157 * fy
  EndIf
  DefMouse V:a%(0)        ' transparente Mausform
  GraphMode R2_COPYPEN, TRANSPARENT
  Clr fertig0|, fehler|, xpunkt%
  stelle% = 1
  hilfe| = 1
  f22:
  Repeat
    PeekEvent
  Until MouseK = 0 And _Mess = 0
  DefLine 0, 1
  If hilfe| = 2
    RGBColor RGB(255, 0, 0) ' rot
    If fertig0| = 0
      Text 319 * fx - TxtLen(text$(aa%)) / 2, 200 * fy, text$(aa%)
    EndIf
  Else If hilfe| = 1
    RGBColor RGB(255, 255, 255) ' weiß
    If fertig0| = 0
      PBox 259 * fx, 199 * fy, 379 * fx, 225 * fy  ' Füllbox für Wörter
    EndIf
  EndIf
  If firsttime|
    FreeBmp bild%
    Get 0, 0, _X, _Y, bild%
  EndIf
  FreeBmp bild1%
  Get 0, 0, 510 * fx, _Y, bild1%
  f23:
  RGBColor RGB(255, 255, 255)
  Repeat
    Sleep
    ink$ = InKey$
  Until Asc(ink$) > 64 And Asc(ink$) < 91 Or Asc(ink$) > 96 And Asc(ink$) < 123 Or ink$ = "Ä" Or ink$ = "ä" Or ink$ = "Ö" Or ink$ = "ö" Or ink$ = "Ü" Or ink$ = "ü" Or ink$ = "ß"  Or (Len(ink$) = 2 And (Asc(Right$(ink$)) = 112 Or Asc(Right$(ink$)) = 119))
  If Len(ink$) = 2 And Asc(Right$(ink$)) = 119 Or ((richtig >= 36 Or falsch% >= 36) And (art| <> 13 Or (art| = 13 And stelle% > Len(text$(aa%)))))
    ende| = 1
    GoTo kontroll10
  EndIf
  If Len(ink$) = 2 And Asc(Right$(ink$)) = 112  ' F1-Taste
    If hilfe| = 1
      hilfe| = 2
      hilferuf| = 1
    Else
      hilfe| = 1
    EndIf
    If hilfe| = 2
      RGBColor RGB(255, 0, 0) ' rot
      If fertig0| = 0
        Text 319 * fx - TxtLen(text$(aa%)) / 2, 200 * fy, text$(aa%)
      EndIf
    Else If hilfe| = 1
      RGBColor RGB(255, 255, 255) ' weiß
      If fertig0| = 0
        PBox 259 * fx, 199 * fy, 379 * fx, 225 * fy  ' Füllbox für Wörter
      EndIf
    EndIf
    GoTo f23
  EndIf
  tastaturabfrage2
  If !firsttime|
    ~BitBlt(h3DC%, 0, 0, _X, _Y, Win_1.hDC, 0, 0, SRCCOPY)
  EndIf
  RGBColor RGB(255, 255, 0) ' gelb
  DefFill 0
  PBox x% - breite%, y% - hoehe%, x% - 1, y% - 1
  RGBColor RGB(255, 0, 0) ' rot
  DefLine 0, 1
  Box x% - breite%, y% - hoehe%, x% - 1, y% - 1
  RGBColor RGB(0, 0, 0) ' schwarz
  If art| = 10                  ' Anfangsbuchstaben
    Text x% - breite% / 2 - TxtLen(alph$(b_%(asc%))) / 2, y% - hoehe% + 3 * fy, alph$(b_%(asc%))
  Else If art| = 11 Or art| = 12  ' Mitte oder Ende
    Text x% - breite% / 2 - TxtLen(Lower$(alph$(b_%(asc%)))) / 2, y% - hoehe% + 3 * fy, Lower$(alph$(b_%(asc%)))
  Else If art| = 13             ' alle Buchstaben
    If stelle% = 1
      Text x% - breite% / 2 - TxtLen(alph$(b_%(asc%))) / 2, y% - hoehe% + 3 * fy, alph$(b_%(asc%))
    Else
      Text x% - breite% / 2 - TxtLen(Lower$(alph$(b_%(asc%)))) / 2, y% - hoehe% + 3 * fy, Lower$(alph$(b_%(asc%)))
    EndIf
  EndIf
  FreeBmp tastbild%
  Get x% - breite%, y% - hoehe%, x%, y%, tastbild%
  GraphMode R2_COPYPEN, TRANSPARENT
  Repeat
    PeekEvent
  Until MouseK = 0 And _Mess = 0
  If firsttime|
    h2DC% = CreateCompatibleDC(Win_1.hDC)
    hNULL% = SelectObject(h2DC%, tastbild%) 'selektiert logisches DC und Bitmap
    h4% = CreateCompatibleBitmap(Win_1.hDC, breite% * 2, hoehe%) 'erzeugt eine Bitmap mit Handle h4%
    h4DC% = CreateCompatibleDC(Win_1.hDC)
    ~SelectObject(h4DC%, h4%) ' ordnet dem DC h4DC% die Bitmap h4% zu
    h3DC% = CreateCompatibleDC(Win_1.hDC)
    ~SelectObject(h3DC%, bild%)
    h5% = CreateCompatibleBitmap(Win_1.hDC, breite% * 2, hoehe% * 2)
    h5DC% = CreateCompatibleDC(Win_1.hDC)
    ~SelectObject(h5DC%, h5%)
    ~SelectObject(Win_1.hDC, hNULL%)
    firsttime| = 0
  Else
    ~SelectObject(h2DC%, tastbild%)
  EndIf
  Clr anfang|
  Do
    If anfang| = 0
      anfang| = 1
      xxxx# = x%
      yyyy# = y%
      If art| < 13
        xpunkt% = 319 * fx + breite% / 2
      Else
        If stelle% = 1
          xpunkt% = _X / 2 - Len(text$(aa%)) * 6.5
          altstelle% = stelle%
        Else If stelle% > altstelle%
          Add xpunkt%, breite% - 1
        EndIf
      EndIf
      abstandx = xxxx# - xpunkt%
      abstandy = yyyy# - Int(260 * fy)
      If Abs(abstandx) > Abs(abstandy)
        abstandy = Abs(abstandy / abstandx)
        If Int(xxxx#) < xpunkt%
          abstandx = -1
        Else
          abstandx = 1
        EndIf
      Else
        If Int(xxxx#) < xpunkt%
          abstandx = -Abs(abstandx / abstandy)
        Else
          abstandx = Abs(abstandx / abstandy)
        EndIf
        abstandy = 1
      EndIf
      yyyy# = yyyy# + abstandy
      xxxx# = xxxx# + abstandx
    EndIf
    If Int(yyyy#) > Int(261 * fy)
      yyyy# = yyyy# - abstandy
      xxxx# = xxxx# - abstandx
    Else
      yyyy# = Int(260 * fy)
      xxxx# = xpunkt%
    EndIf
    xx% = xxxx# - breite%
    yy% = yyyy# - hoehe%
    If xx% <> altx% Or yy% <> alty%
      ~BitBlt(h4DC%, 0, 0, breite%, hoehe%, h2DC%, 0, 0, SRCCOPY)
      rechtsx% = xx% + breite%
      unteny% = yy% + hoehe%
      altrechts% = altx% + breite%
      altunten% = alty% + hoehe%
      If rechtsx% < altx% Or unteny% < alty% Or yy% > altunten%
        GoTo n4
      EndIf
      If xx% < altrechts%
        If altx% > xx%
          rechtsx% = xx%
          altrechts% = breite% + altx% - xx%
        Else
          rechtsx% = altx%
          altrechts% = breite% + xx% - altx%
        EndIf
        If alty% > yy%
          unteny% = yy%
          altunten% = hoehe% + alty% - yy%
        Else
          unteny% = alty%
          altunten% = hoehe% + yy% - alty%
        EndIf
        ~BitBlt(h5DC%, 0, 0, altrechts%, altunten%, h3DC%, rechtsx%, unteny%, SRCCOPY)
        ~BitBlt(h5DC%, xx% - rechtsx%, yy% - unteny%, breite%, hoehe%, h4DC%, 0, 0, SRCCOPY)
        ~BitBlt(Win_1.hDC, rechtsx%, unteny%, altrechts%, altunten%, h5DC%, 0, 0, SRCCOPY)
      Else
        n4:
        ~BitBlt(Win_1.hDC, xx%, yy%, breite%, hoehe%, h4DC%, 0, 0, SRCCOPY)
        ~BitBlt(Win_1.hDC, altx%, alty%, breite%, hoehe%, h3DC%, altx%, alty%, SRCCOPY)
      EndIf
    EndIf
    altx% = xx%
    alty% = yy%
  Loop Until Int(yyyy#) = Int(260 * fy)
  GraphMode R2_COPYPEN, TRANSPARENT
  If art| = 10
    If alph$(b_%(asc%)) = Left$(text$(aa%), Len(alph$(b_%(asc%))))
      RGBColor RGB(255, 255, 255) ' weiß
      PBox 259 * fx, 199 * fy, 379 * fx, 225 * fy  ' Füllbox für Wörter
      RGBColor RGB(0, 0, 0) ' schwarz
      Text 319 * fx - TxtLen(text$(aa%)) / 2, 200 * fy, text$(aa%)
      If lesen| = 1
        richtig = richtig + 36 / 20
      Else
        richtig = richtig + 1
      EndIf
      Inc richtig1%
      Clr fehler|
      fertig0| = 1
    Else
      RGBColor RGB(255, 255, 255) ' weiß
      PBox 259 * fx, 199 * fy, 379 * fx, 225 * fy  ' Füllbox für Wörter
      RGBColor RGB(255, 0, 0) ' rot
      Text 319 * fx - TxtLen(text$(aa%)) / 2, 200 * fy, text$(aa%)
      fehler| = 1
      Inc falsch%
    EndIf
  Else If art| = 11
    If InStr(text$(aa%), Lower$(alph$(b_%(asc%)))) > 1 And InStr(text$(aa%), Lower$(alph$(b_%(asc%)))) < Len(text$(aa%))
      RGBColor RGB(255, 255, 255) ' weiß
      PBox 259 * fx, 199 * fy, 379 * fx, 225 * fy  ' Füllbox für Wörter
      RGBColor RGB(0, 0, 0) ' schwarz
      Text 319 * fx - TxtLen(text$(aa%)) / 2, 200 * fy, text$(aa%)
      If lesen| = 1
        richtig = richtig + 36 / 20
      Else
        richtig = richtig + 1
      EndIf
      Inc richtig1%
      Clr fehler|
      fertig0| = 1
    Else
      RGBColor RGB(255, 255, 255) ' weiß
      PBox 259 * fx, 199 * fy, 379 * fx, 225 * fy  ' Füllbox für Wörter
      RGBColor RGB(255, 0, 0) ' rot
      Text 319 * fx - TxtLen(text$(aa%)) / 2, 200 * fy, text$(aa%)
      fehler| = 1
      Inc falsch%
    EndIf
  Else If art| = 12
    If Lower$(alph$(b_%(asc%))) = Lower$(Right$(text$(aa%), Len(alph$(b_%(asc%)))))
      RGBColor RGB(255, 255, 255) ' weiß
      PBox 259 * fx, 199 * fy, 379 * fx, 225 * fy  ' Füllbox für Wörter
      RGBColor RGB(0, 0, 0) ' schwarz
      Text 319 * fx - TxtLen(text$(aa%)) / 2, 200 * fy, text$(aa%)
      If lesen| = 1
        richtig = richtig + 36 / 20
      Else
        richtig = richtig + 1
      EndIf
      Inc richtig1%
      Clr fehler|
      fertig0| = 1
    Else
      RGBColor RGB(255, 255, 255) ' weiß
      PBox 259 * fx, 199 * fy, 379 * fx, 225 * fy  ' Füllbox für Wörter
      RGBColor RGB(255, 0, 0) ' rot
      Text 319 * fx - TxtLen(text$(aa%)) / 2, 200 * fy, text$(aa%)
      fehler| = 1
      Inc falsch%
    EndIf
  Else If art| = 13
    altstelle% = stelle%
    If stelle% = 1 And alph$(b_%(asc%)) = Left$(text$(aa%), Len(alph$(b_%(asc%))))
      richtig = richtig + 1
      Inc richtig1%
      Clr fehler|
      stelle% = stelle% + Len(alph$(b_%(asc%)))
    Else If stelle% > 1 And Mid$(text$(aa%), stelle%, Len(alph$(b_%(asc%)))) = Lower$(alph$(b_%(asc%)))
      richtig = richtig + 1
      Inc richtig1%
      Clr fehler|
      stelle% = stelle% + Len(alph$(b_%(asc%)))
    Else
      fehler| = 1
      altrichtig% = richtig
      richtig = richtig - stelle% + 1
      Inc falsch%
      PaintPicture fibelbild(aa%), 260 * fx, 30 * fy, 118 * fx, 157 * fy
    EndIf
    If stelle% > Len(text$(aa%)) Or fehler| = 1
      If fehler| = 0
        RGBColor RGB(0, 0, 0) ' schwarz
      Else
        RGBColor RGB(255, 0, 0) ' rot
        stelle% = 1
        altstelle% = 1
      EndIf
      Text 319 * fx - TxtLen(text$(aa%)) / 2, 200 * fy, text$(aa%)
    EndIf
  EndIf
  saeule
  If art| < 13 Or (art| = 13 And (stelle% > Len(text$(aa%))) Or fehler| = 1)
    Repeat
      Sleep
      ink$ = InKey$
    Until ink$ = Chr$(13) Or (Len(ink$) = 2 And (Asc(Right$(ink$)) = 119 Or Asc(Right$(ink$)) = 112))
  EndIf
  If art| <> 13
    Put 0, 0, bild1%
  Else If art| = 13 And (stelle% > Len(text$(aa%)) Or fehler| = 1)
    RGBColor RGB(100, 0, 0) ' dunkelbraun
    PBox 150 * fx, 230 * fy, 500 * fx, 238 * fy
    RGBColor RGB(255, 255, 198) ' creme
    PBox 150 * fx, 238 * fy, 500 * fx, 268 * fy
    RGBColor RGB(255, 0, 0) ' rot
    DefLine 0, Ceil(3 * fx)
    Line 150 * fx, 238 * fy, 500 * fx, 238 * fy ' Trennung oben/unten
  EndIf
  If (richtig >= 5 Or falsch% >= 5) And (art| <> 13 Or (art| = 13 And stelle% > Len(text$(aa%))))
    ende| = 1
    GoTo kontroll10
  EndIf
  If Len(ink$) = 2 And Asc(Right$(ink$)) = 119
    ende| = 1
    GoTo kontroll10
  EndIf
  If art| = 13 And stelle% <= Len(text$(aa%))
    PaintPicture fibelbild(aa%), 260 * fx, 30 * fy, 118 * fx, 157 * fy
    GoTo f22
  EndIf
  If fehler| = 1
    GoTo f22
  Else
    GoTo wiederhol10
  EndIf
  kontroll10:
  If firsttime| = 0
    If h2DC% Then ~SelectObject(h2DC%, hNULL%)
    If h3DC% Then ~SelectObject(h3DC%, hNULL%)
    If h4DC% Then ~SelectObject(h4DC%, hNULL%)
    If h5DC% Then ~SelectObject(h5DC%, hNULL%)
    ~DeleteDC(h2DC%)
    ~DeleteDC(h3DC%)
    ~DeleteDC(h4DC%)
    ~DeleteDC(h5DC%)
    FreeBmp h4%
    FreeBmp h5%
  EndIf
Return
