'##E#
Global a%, al$, al1$, al2$, alert$, alertf|, ansaugen|, ausschnitt$, beginn|, bild$, blau%, blau1%, blau2%, breite%, farbe%, fertig|, fuellung|, fx#, fy#
Global gruen%, h|, h1|, h2|, h3|, h4|, h5|, h6|, h7|, h8|, h9|, h10|, hoehe%,  i%, i1%, i2%, i3%, j$, jj$, k%, klemme_h|, klemm_h$, klemme_br|
Global klemm_br$, links%, luft_zyl_br$, menge%, rot%, schlauch_br|, schlauch_h|, schlauch_t_br|, schlauch_t|, schlauch_t_h|, schrift0%, schrift1%
Global schrift2%, schrift3%, schrift4%, schriftw1%, schriftw2%, seitenh%, start|, t_stueck|, unten|, voll|, vorw%, wahl|, wasserstand_h%, v%, v_links|
Global v_rechts|, x%, xa%, xe%, xx%, y%, ya%, ye%, yy%, zeit#, zeitalt#, zylinder$, xxxxx%, yyyyy%
Global Picture hintergrund, hintergrund1, ventil_ra, ventil_rb, ventil_rc, ventil_rvo, ventil_rvu, ventil_ro, ventil_ru, ventil_la, ventil_lb, ventil_lc, ventil_lvo
Global Picture ventil_lvu, ventil_lo, ventil_lu
If _Y / _X <= 0.76                                 ' Seitenverhältnis 3 : 4 oder Breitbild
  xxxxx% = _X
  yyyyy% = _Y
  OpenW # 3, 0, 0, xxxxx% , yyyyy%, 0000000000      '  Hintergrundfenster
  Win_3.AutoRedraw = 1
  Win_3.Disable
  Output = Win_3
  DefLine 0, 1
  DefFill 0
  RGBColor RGB(30, 0, 0) ' dunkelbraun
  PBox 0, 0, _X, _Y
  If _Y < 600
    alert1("Das Programm erfordert eine Bildauflösung von mindestens 800 x 600 Punkten (Breite x Höhe):", "Stellen Sie dazu eine hohe Farbenanzahl ein: 24-Bit oder 32-Bit")
    ende
  Else If _Y < 768
    OpenW Hidden # 2, Int(xxxxx% / 2) - 401, Int(yyyyy% / 2) - 301, 802, 602, 0      ' 800x600
    Win_2.AutoRedraw = 1
    OpenW # 1, Int(xxxxx% / 2) - 401, Int(yyyyy% / 2) - 301, 802, 602, 0
    Win_1.AutoRedraw = 1
    Set hintergrund =  LoadPicture("bild\wasserleitung\hintergrund800.jpg")
  Else If _Y < 864
    OpenW Hidden # 2, Int(xxxxx% / 2) - 513, Int(yyyyy% / 2) - 385, 1026, 770, 0      ' 1024x768
    Win_2.AutoRedraw = 1
    OpenW # 1, Int(xxxxx% / 2) - 513, Int(yyyyy% / 2) - 385, 1026, 770, 0
    Win_1.AutoRedraw = 1
    Set hintergrund =  LoadPicture("bild\wasserleitung\hintergrund1024.jpg")
  Else If _Y < 960
    OpenW Hidden # 2, Int(xxxxx% / 2) - 577, Int(yyyyy% / 2) - 433, 1154, 866, 0      '  1152x864
    Win_2.AutoRedraw = 1
    OpenW # 1, Int(xxxxx% / 2) - 577, Int(yyyyy% / 2) - 433, 1154, 866, 0
    Win_1.AutoRedraw = 1
    Set hintergrund =  LoadPicture("bild\wasserleitung\hintergrund1152.jpg")
  Else If _Y < 1200
    OpenW Hidden # 2, Int(xxxxx% / 2) - 641, Int(yyyyy% / 2) - 481, 1282, 962, 0      '  1280x960
    Win_2.AutoRedraw = 1
    OpenW # 1, Int(xxxxx% / 2) - 641, Int(yyyyy% / 2) - 481, 1282, 962, 0
    Win_1.AutoRedraw = 1
    Set hintergrund =  LoadPicture("bild\wasserleitung\hintergrund1280.jpg")
  Else If _Y > 1199
    OpenW Hidden # 2, Int(xxxxx% / 2) - 801, Int(yyyyy% / 2) - 601, 1602, 1202, 0      '  1600x1200
    Win_2.AutoRedraw = 1
    OpenW # 1, Int(xxxxx% / 2) - 801, Int(yyyyy% / 2) - 601, 1602, 1202, 0
    Win_1.AutoRedraw = 1
    Set hintergrund =  LoadPicture("bild\wasserleitung\hintergrund1600.jpg")
  EndIf
Else If _Y / _X < 0.76                                                          ' Hochformatbild
  xxxxx% = _X
  yyyyy% = _Y
  OpenW # 3, 0, 0, xxxxx% , yyyyy%, 0000000000      '  Hintergrundfenster
  Win_3.AutoRedraw = 1
  Win_3.Disable
  Output = Win_3
  DefLine 0, 1
  DefFill 0
  RGBColor RGB(30, 0, 0) ' dunkelbraun
  PBox 0, 0, _X, _Y
  If _X < 800
    alert1("Das Programm erfordert eine Bildauflösung von mindestens 800 x 600 Punkten (Breite x Höhe):", "Stellen Sie dazu eine hohe Farbenanzahl ein: 24-Bit oder 32-Bit")
    ende
  Else If _X < 1024
    OpenW Hidden # 2, Int(xxxxx% / 2) - 401, Int(yyyyy% / 2) - 301, 802, 602, 0      ' 800x600
    Win_2.AutoRedraw = 1
    OpenW # 1, Int(xxxxx% / 2) - 401, Int(yyyyy% / 2) - 301, 802, 602, 0
    Win_1.AutoRedraw = 1
    Set hintergrund =  LoadPicture("bild\wasserleitung\hintergrund800.jpg")
  Else If _X < 1152
    OpenW Hidden # 2, Int(xxxxx% / 2) - 513, Int(yyyyy% / 2) - 385, 1026, 770, 0      ' 1024x768
    Win_2.AutoRedraw = 1
    OpenW # 1, Int(xxxxx% / 2) - 513, Int(yyyyy% / 2) - 385, 1026, 770, 0
    Win_1.AutoRedraw = 1
    Set hintergrund =  LoadPicture("bild\wasserleitung\hintergrund1024.jpg")
  Else If _X < 1280
    OpenW Hidden # 2, Int(xxxxx% / 2) - 577, Int(yyyyy% / 2) - 433, 1154, 866, 0      '  1152x864
    Win_2.AutoRedraw = 1
    OpenW # 1, Int(xxxxx% / 2) - 577, Int(yyyyy% / 2) - 433, 1154, 866, 0
    Win_1.AutoRedraw = 1
    Set hintergrund =  LoadPicture("bild\wasserleitung\hintergrund1152.jpg")
  Else If _X < 1600
    OpenW Hidden # 2, Int(xxxxx% / 2) - 641, Int(yyyyy% / 2) - 481, 1282, 962, 0      '  1280x960
    Win_2.AutoRedraw = 1
    OpenW # 1, Int(xxxxx% / 2) - 641, Int(yyyyy% / 2) - 481, 1282, 962, 0
    Win_1.AutoRedraw = 1
    Set hintergrund =  LoadPicture("bild\wasserleitung\hintergrund1280.jpg")
  Else If _X > 1599
    OpenW Hidden # 2, Int(xxxxx% / 2) - 801, Int(yyyyy% / 2) - 601, 1602, 1202, 0      '  1600x1200
    Win_2.AutoRedraw = 1
    OpenW # 1, Int(xxxxx% / 2) - 801, Int(yyyyy% / 2) - 601, 1602, 1202, 0
    Win_1.AutoRedraw = 1
    Set hintergrund =  LoadPicture("bild\wasserleitung\hintergrund1600.jpg")
  EndIf
EndIf
Output = Win_1
Print
DefMouse 0
DefFill 0  ' Füllen mit Vollfarbe
fx# = _X / 1152
fy# = _Y / 864
Font Orientation 0, Escapement 0, StrikeOut 0, Italic 0
Font StrikeOut 0, Underline 0, Family FF_DONTCARE, Pitch DEFAULT_PITCH
Font CharSet ANSI_CHARSET, Quality DEFAULT_QUALITY
Font "arial", Weight 400, Width 0, Height Int(20 * fx), To schrift0%
Font "arial", Weight 400, Width 0, Height Int(25 * fx), To schrift1%
Font "arial", Weight 400, Width 0, Height Int(30 * fx), To schrift2%
Font "arial", Weight 400, Width 0, Height Int(40 * fx), To schrift3%
Font "Times New Roman", Weight 700, Width 0, Height Int(66 * fx), To schrift4%
Font CharSet 1
Font "Wingdings", Weight 800, Width 0, Height Int(90 * fx), To schriftw1%
Font "Wingdings", Weight 800, Width 0, Height Int(40 * fx), To schriftw2%
GraphMode R2_COPYPEN, TRANSPARENT
Set hintergrund1 =  LoadPicture("bild\wasserleitung\hintergrund1.jpg")
Put 0, 0, hintergrund
Set ventil_ro =  LoadPicture("bild\wasserleitung\ventil1o.jpg")  ' leer, Kugel oben
Set ventil_ru =  LoadPicture("bild\wasserleitung\ventil1u.jpg")  ' leer, Kugel unten
Set ventil_ra =  LoadPicture("bild\wasserleitung\ventil1a.jpg")
Set ventil_rb =  LoadPicture("bild\wasserleitung\ventil1b.jpg")
Set ventil_rc =  LoadPicture("bild\wasserleitung\ventil1c.jpg")
Set ventil_rvo =  LoadPicture("bild\wasserleitung\ventil1vo.jpg")  ' voll, Kugel oben
Set ventil_rvu =  LoadPicture("bild\wasserleitung\ventil1vu.jpg")  ' voll, Kugel unten
Set ventil_lo =  LoadPicture("bild\wasserleitung\ventil2o.jpg")  ' leer, Kugel oben
Set ventil_lu =  LoadPicture("bild\wasserleitung\ventil2u.jpg")  ' leer, Kugel unten
Set ventil_la =  LoadPicture("bild\wasserleitung\ventil2a.jpg")
Set ventil_lb =  LoadPicture("bild\wasserleitung\ventil2b.jpg")
Set ventil_lc =  LoadPicture("bild\wasserleitung\ventil2c.jpg")
Set ventil_lvu =  LoadPicture("bild\wasserleitung\ventil2vu.jpg")  ' voll, Kugel unten
Set ventil_lvo =  LoadPicture("bild\wasserleitung\ventil2vo.jpg")  ' voll, Kugel oben
SetFont schrift4%
Color RGB(0, 60, 220)  ' blau
Text 50 * fx, 110 * fy, "Frisches Wasser für diese Häuser!"
Color RGB(250, 0, 0)  'rot
Text 49 * fx, 109 * fy, "Frisches Wasser für diese Häuser!"
SetFont schrift1%
Text 310 * fx, 210 * fy, "Hier sind deine Aufgaben:"
Color RGB(0, 60, 220)  ' blau
Text 380 * fx, 255 * fy, "1. Kann Wasser bergauf fließen? (zwei Versuche)"
Text 380 * fx, 295 * fy, "2. Wasserhochbehälter und Brunnen"
Text 380 * fx, 335 * fy, "3. Bau einer Pumpe"
Text 380 * fx, 375 * fy, "4. Frisches Wasser für die Häuser"
Color RGB(250, 250, 170)  ' beige
Text 10 * fx, 525 * fy, "Hier siehst du tief in die Erde hinein,"
Text 10 * fx, 560 * fy, "    so als wäre sie mit einem riesigen Messer durchgeschnitten – wie eine Buttercremetorte."
DefLine 0, 1
Text 70 * fx, 730 * fy, "Ende:  Taste F8"
Text 980 * fx, 730 * fy, "Weiter"
Box 965 * fx, 723 * fy, 1055 * fx, 763 * fy
SetFont schrift0%
Color RGB(0, 220, 255)  ' blau
Text _X / 2 - TxtLen("Kombipaket Grundschule Vers. 8.3, Rudolf Rosenkränzer, Tel. 06501/180202") / 2, 840 * fy, "Kombipaket Grundschule Vers. 8.3, Rudolf Rosenkränzer, Tel. 06501/180202"
neu0:
Repeat
  j$ = InKey$
  Mouse x, y, k%
Until k% = 1 And x > 965 * fx And x < 1055 * fx And y > 723 * fy And y < 763 * fy Or Len(j$) = 2 And (Asc(Right$(j$)) = 119) ' Or k% = 2  ' F8
If Len(j$) = 2 And (Asc(Right$(j$)) = 119)  'F8
  alert3("Willst du wirklich aufhören?", "Ende", "zurück")
  If alertf| = 1
    ende
  Else
    GoTo neu0
  EndIf
EndIf
verzoegerung(400)
hauptmenue
>Procedure hauptmenue          ' Steuerung des Ablaufs
  beginn:
  ansaugen| = 0  ' Es kann kein Wasser angesaugt werden
  voll| = 0             ' Der Zylinder der Pumpe ist leer
  schlauch_br| = 1 ' Schlauch Pumpe - Brunnen kann gesetzt werden
  schlauch_h| = 1 ' Schlauch Pumpe - Hochbehälter kann gesetzt werden
  t_stueck| = 1  ' T-Stück kann gesetzt werden
  unten| = 1   ' Kolben der Pumpe steht unten
  wasserstand_h% = 205 * fy  ' Wasserstand im Hochbehälter nach der ersten Füllung
  Stretch 0, 0, hintergrund1, _X, _Y
  leitung
  wasserwahl
  Stretch 0, 0, hintergrund1, _X, _Y
  leitung2
  wasserwahl2
  Put 0, 0, hintergrund
  hochbehaelter
  Put 0, 0, hintergrund
  brunnen
  Stretch 0, 0, hintergrund1, _X, _Y
  pumpe
  pumpe2
  Put 0, 0, hintergrund
  wasserleitung
  alert3("Willst du wirklich aufhören?", "Ende", "von vorne")
  If alertf| = 1
    ende
  EndIf
  GoTo beginn
Return
>Procedure leitung                   ' Wasserleitung Versuch 1
  Get 0, 145 * fy, _X, 174 * fy, ausschnitt$
  DefLine 0, 40 * fx
  Color RGB(0, 80, 160) ' dunkelblau
  Ellipse _X / 2, 175 * fy, 500 * fx, 600 * fy, 181, 359
  Ellipse 0, 140 * fy, 77 * fx, 50 * fy, 0, 90    ' Ausfluss
  Color RGB(0, 0, 0) 'schwarz
  DefLine 0, 20 * fx
  Ellipse _X / 2, 175 * fy, 500 * fx, 600 * fy, 180, 360
  Ellipse 0, 140 * fy, 77 * fx, 50 * fy, 0, 90             ' Ausfluss
  Color RGB(255, 255, 255) ' weiß
  DefLine 0, 14 * fx
  Ellipse _X / 2, 175 * fy, 500 * fx, 600 * fy, 180, 360
  Color RGB(100, 220, 255)       ' hellblau
  Ellipse 0, 140 * fy, 77 * fx, 50 * fy, 0, 90
  Put 0, 145 * fy, ausschnitt$
Return
>Procedure wasserwahl            ' Leiste zur Auswahl der Wassermenge Versuch 1, zugehöriger Text
  menge% = 0
  Color RGB(0, 0, 200)  ' dunkelblau
  DefLine 0, 1
  SetFont schrift1%
  Text 200 * fx, 180 * fy, "Kann Wasser ohne eine Pumpe bergauf fließen?"
  Text 200 * fx, 225 * fy, "Du kannst Wasser in dieses Rohr fließen lassen."
  Text 200 * fx, 260 * fy, "Zeichne vor jedem Versuch auf ein Blatt eine kleine Skizze, die zeigt, an welcher"
  Text 200 * fx, 290 * fy, "     Stelle des Rohres das Wasser sich wohl sammeln wird. (Du kannst diese Seite"
  Text 200 * fx, 320 * fy, "     auch ausdrucken lassen und deine Vermutungen auf dem Blatt markieren.)"
  Text 200 * fx, 355 * fy, "Wähle dann die Wassermenge mit der Maus oben in der Wasserleiste aus!"
  Text 200 * fx, 390 * fy, "Hast du den Stand des Wassers richtig vorhergesagt?"
  Text 200 * fx, 425 * fy, "Ein neuer Klick in die Wasserleiste startet einen neuen Versuch."
  Text 200 * fx, 460 * fy, "Wenn du einen durchsichtigen Plastikschlauch hast, überprüfe deine Ergebnisse"
  Text 200 * fx, 490 * fy, "     mit richtigem Wasser – zu Hause vielleicht in der Badewanne!"
  Text 300 * fx, 530 * fy, "Beantworte bitte diese Frage:"
  Text 300 * fx, 590 * fy, "Klicke dann auf " + Chr$(132) + "Weiter" + Chr$(147) + " und vergleiche deine Antwort!"
  SetFont schrift0%
  Color RGB(0, 0, 200)  ' dunkelblau
  Text 202 * fx, 50 * fy, "wenig Wasser"
  Text 1013 * fx, 50 * fy, "viel Wasser"
  Box 882 * fx, 700 * fy, 1100 * fx, 732 * fy
  Box 882 * fx, 750 * fy, 1100 * fx, 782 * fy
  Box 882 * fx, 800 * fy, 1100 * fx, 832 * fy
  Color RGB(230, 0, 0)  ' rot
  SetFont schrift1%
  Text 300 * fx, 560 * fy, "Wie weit kann Wasser ohne eine Pumpe bergauf fließen?"
  Text 200 * fx + TxtLen("Zeichne "), 260 * fy, "vor jedem Versuch"
  Text 890 * fx, 705 * fy, "Weiter"
  Text 890 * fx, 755 * fy, "Ich hab's verstanden!"
  Text 890 * fx, 805 * fy, "Drucken"
  rot% = 185
  gruen% = 235
  blau% = 255
  xa% = 200 * fx
  ya% = 70 * fy
  xe% = 219 * fx
  ye% = 110 * fy
  For i% = 1 To 45                     ' Zeichnen der Farbleiste
    Color RGB(rot%, gruen%, blau%)
    PBox xa%, ya%, xe%, ye%
    rot% = rot% - 3
    gruen% = gruen% - 3
    blau% = blau% - 3
    If Mod(i%, 5) = 0  ' Teilen durch 5 ergibt Rest 0
      Color RGB(0, 0, 200)  ' dunkelblau
      If i% = 5
        Text xa% - 1, ye% + 1, Str$(i%)
      Else
        Text xa% - 7 * fx, ye% + 1, Str$(i%)
      EndIf
    EndIf
    xa% = xa% + Fix(20 * fx)
    xe% = xe% + Fix(20 * fx)
  Next i%
  neu:
  Repeat
    PeekEvent
  Until MouseK = 0 And _Mess = 0
  Repeat
    PeekEvent
    Mouse x, y, k%
    j$ = InKey$
  Until (Len(j$) = 2 And (Asc(Right$(j$)) = 119)) Or (k% = 1 And (x > 200 * fx And x < 200 * fx + 45 * Fix(20 * fx) And y > 70 * fy And y < 110 * fy Or (x > 882 * fx And x < 1100 * fx And (y > 800 * fy And y < 832 * fy Or y > 750 * fy And y < 782 * fy Or  y > 700 * fy And y < 732 * fy))))
  If k% = 1 And x > 200 * fx And x < 1099 * fx And y > 70 * fy And y < 110 * fy
    Color RGB(255, 255, 255)  ' weiß
    DefLine 0, 14 * fx
    Ellipse _X / 2, 175 * fy, 500 * fx, 600 * fy, 180, 360
    menge% = Fix((x - 200 * fx) / Fix(20 * fx)) * 4 + 2
    wasser(menge%)   ' Wassermenge als 178stel, nur gerade Zahlen
    GoTo neu
  Else If Len(j$) = 2 And (Asc(Right$(j$)) = 119)  ' F8
    alert3("Willst du wirklich aufhören?", "Ende", "zurück")
    If alertf| = 1
      ende
    Else
      GoTo neu
    EndIf
  Else If k% = 1 And x > 882 * fx And x < 1100 * fx And y > 700 * fy And y < 732 * fy  ' hilfe 1
    hilfe
    GoTo neu
  Else If k% = 1 And x > 882 * fx And x < 1100 * fx And y > 750 * fy And y < 782 * fy  '  verstanden
  Else If k% = 1 And x > 882 * fx And x < 1100 * fx And y > 800 * fy And y < 832 * fy  '  Drucken
    alert3("Ist der Drucker angeschaltet?", "ja", "nein")
    If alertf| = 1
      drucken
    EndIf
    GoTo neu
  EndIf
  Clr ausschnitt$
Return
>Procedure wasser(menge%)    ' Fließen des Wassers Versuch 1
  DefLine 0, 14 * fx
  Color RGB(100, 220, 255)       ' hellblau
  Line 77 * fx, 144 * fy, 77 * fx, 176 * fy   ' Wasser aus Kranen
  DefLine 0, 14 * fx
  For i% = 181 To 269 + menge% / 2
    Color RGB(100, 220, 255)       ' hellblau
    Ellipse _X / 2, 175 * fy, 500 * fx, 600 * fy, i%, i% + 1
    If i% > 180 + menge%
      Color RGB(255, 255, 255)     ' weiß
      If i% = 181 + menge%
        Line 77 * fx, 144 * fy, 77 * fx, 176 * fy   ' Wasser aus Kranen
      EndIf
      Ellipse _X / 2, 175 * fy, 500 * fx, 600 * fy, i% - menge%, i% - menge% + 1
    EndIf
    verzoegerung(i% / 12 / fx)
  Next i%
  Color RGB(255, 255, 255)     ' weiß
  Line 77 * fx, 144 * fy, 77 * fx, 176 * fy   ' Wasser aus Kranen
  Color RGB(100, 220, 255)       ' hellblau
  Ellipse _X / 2, 175 * fy, 500 * fx, 600 * fy, 270 - menge% / 2, 271 - menge% / 2  ' letzter Punkt links, damit die Wölbung stimmt
Return
>Procedure hilfe                       ' Hilfe Versuch 1
  Get 0, 0, _X, _Y, bild$
  Stretch 0, 0, hintergrund1, _X, _Y
  GraphMode R2_COPYPEN, TRANSPARENT
  leitung
  DefLine 0, 14 * fx
  Color RGB(100, 220, 255)  '  hellblau
  Ellipse _X / 2, 175 * fy, 500 * fx, 600 * fy, 180, 290
  Put 0, 145 * fy, ausschnitt$
  Color RGB(240, 0, 0)  '  rot
  Line _X / 2, 600 * fy, _X / 2, 820 * fy
  SetFont schrift1%
  Text _X / 2 - (100 * fx + (TxtLen("links"))), 600 * fy, "links"
  Text _X / 2 + 100 * fx, 600 * fy, "rechts"
  Color RGB(0, 0, 200)  '  dunkelblau
  Text _X / 2 - TxtLen("zurück: Taste F8") / 2, 520 * fy, "zurück: Taste F8"
  Text 200 * fx, 160 * fy, "Alles Wasser im Rohr drückt nach unten."
  Text 200 * fx, 195 * fy, "In der linken Hälfte des Rohres steht in diesem Beispiel das Wasser viel höher"
  Text 200 * fx, 225 * fy, "     und drückt deshalb viel stärker nach unten als in der rechten Hälfte."
  Text 200 * fx, 260 * fy, "Stelle dir das Wasser als kleine Kügelchen vor!"
  Text 200 * fx, 295 * fy, "Die Kügelchen der linken Seite rutschen wie auf einer Rutschbahn nach unten"
  Text 200 * fx, 325 * fy, "     und drücken die Kügelchen der rechten Seite solange nach oben, bis diese"
  Text 200 * fx, 355 * fy, "     gleich stark zurückdrücken. Dann herrscht Gleichgewicht: Das Wasser"
  Text 200 * fx, 385 * fy, "     steht in beiden Hälften des Rohres gleich hoch."
  Text 200 * fx, 420 * fy, "So oder ähnlich ist deine Antwort richtig:"
  Color RGB(240, 0, 0)  ' rot
  Text 200 * fx, 450 * fy, "     Das Wasser kann so weit steigen, bis es auf beiden Seiten gleich hoch steht."
  Repeat
    PeekEvent
  Until MouseK = 0 And _Mess = 0
  Repeat
    PeekEvent
    j$ = InKey$
    Mouse x, y, k%
  Until Len(j$) = 2 And Asc(Right$(j$)) = 119 '  Or k% = 2  'F8
  '  If k% = 2
  '  drucken
  '  EndIf
  Put 0, 0, bild$
  Clr bild$
Return
>Procedure leitung2                 ' Wasserleitung Versuch 2
  Get 0, 350 * fy, _X, 380 * fy, ausschnitt$
  GraphMode R2_COPYPEN, TRANSPARENT
  Color RGB(0, 80, 160)                                                             ' dunkelblau
  DefLine 0, 36 * fx
  Ellipse 0, 140 * fy, 78 * fx, 50 * fy, 0, 90  ' Ausfluss
  DefLine 34 * fx
  Line 78 * fx, 139 * fy, 78 * fx, 720 * fy      ' nach unten, Rohr A
  Line 78 * fx, 720 * fy, 800 * fx, 720 * fy    ' unten waagerecht
  Line 800 * fx, 720 * fy, 1095 * fx, 550 * fy  ' schräg, Rohr E
  Line 1095 * fx, 550 * fy, 783 * fx, 370 * fy  ' schräg, Rohr E
  DefLine 0, 1
  PBox 189 * fx, 380 * fy, 273 * fx, 720 * fy  ' Rohr B
  PBox 402 * fx, 380 * fy, 446 * fx, Ceil(538 * fy)  ' Rohr C
  PBox 362 * fx, 539 * fy, 486 * fx, 720 * fy  ' Rohr C
  PBox 555 * fx, 380 * fy, 679 * fx, 562 * fy  ' Rohr D
  PBox 595 * fx, Int(563 * fy), 639 * fx, 720 * fy  ' Rohr D
  Color RGB(0, 0, 0)                                                                   ' schwarz
  DefLine 0, 20 * fx
  Ellipse 0, 140 * fy, 78 * fx, 50 * fy, 0, 90
  DefLine 0, 18 * fx
  Line 78 * fx, 144 * fy, 78 * fx, 720 * fy
  Line 78 * fx, 720 * fy, 800 * fx, 720 * fy  ' unten waagerecht
  Line 800 * fx, 720 * fy, 1095 * fx, 550 * fy  ' schräg, Rohr E
  Line 1095 * fx, 550 * fy, 783 * fx, 370 * fy  ' schräg, Rohr E
  DefLine 0, 1
  PBox 197 * fx, 380 * fy, 265 * fx, 720 * fy  ' Rohr B
  PBox 410 * fx, 380 * fy, 438 * fx, 546 * fy  ' Rohr C
  PBox 370 * fx, 547 * fy, 478 * fx, 720 * fy  ' Rohr C
  PBox 563 * fx, 380 * fy, 671 * fx, 554 * fy  ' Rohr D
  PBox 603 * fx, 555 * fy, 631 * fx, 720 * fy  ' Rohr D
  DefLine 0, 14 * fx
  Color RGB(100, 220, 255)                                                        ' hellblau
  Ellipse 0, 140 * fy, 78 * fx, 50 * fy, 0, 90
  Line 78 * fx, 139 * fy, 78 * fx, 360 * fy
  leeren
  Put 0, 350 * fy, ausschnitt$
Return
>Procedure wasserwahl2          ' Leiste zur Auswahl der Wassermenge Versuch 2, zugehöriger Text
  Color RGB(0, 0, 200)  ' dunkelblau
  DefLine 0, 1
  SetFont schrift1%
  Text 200 * fx, 170 * fy, "Im zweiten Versuch kannst du Wasser in fünf verschiedene Rohre fließen lassen."
  Text 200 * fx, 205 * fy, "Zeichne vor jedem Versuch wieder eine kleine Skizze, die zeigt, wie hoch du den Stand"
  Text 200 * fx, 235 * fy, "     des Wassers in Rohr A, B, C, D und E vermutest."
  Text 200 * fx, 275 * fy, "Du kannst dir dazu ein Blatt mit den leeren Rohren ausdrucken lassen."
  Text 200 * fx, 310 * fy, "Wähle dann die Wassermenge mit der Maus oben in der Wasserleiste aus!"
  SetFont schrift0%
  Color RGB(0, 0, 200)  ' dunkelblau
  Text 202 * fx, 50 * fy, "wenig Wasser"
  Text 1032 * fx, 50 * fy, "viel Wasser"
  Box 890 * fx, 700 * fy, 1120 * fx, 732 * fy
  Box 890 * fx, 750 * fy, 1120 * fx, 782 * fy
  Box 890 * fx, 800 * fy, 1120 * fx, 832 * fy
  Color RGB(230, 0, 0)  ' rot
  SetFont schrift1%
  Text 200 * fx + TxtLen("Zeichne "), 205 * fy, "vor jedem Versuch"
  Text 900 * fx, 705 * fy, "Warum?"
  Text 900 * fx, 755 * fy, "Ich hab's verstanden!"
  Text 900 * fx, 805 * fy, "Drucken"
  Text 78 * fx - TxtLen("Rohr A") / 2, 750 * fy, "Rohr A"
  Text 231 * fx - TxtLen("Rohr B") / 2, 750 * fy, "Rohr B"
  Text 424 * fx - TxtLen("Rohr C") / 2, 750 * fy, "Rohr C"
  Text 617 * fx - TxtLen("Rohr D") / 2, 750 * fy, "Rohr D"
  Text 950 * fx, 540 * fy, "Rohr E"
  rot% = 185
  gruen% = 235
  blau% = 255
  xa% = 200 * fx
  ya% = 70 * fy
  xe% = 227 * fx
  ye% = 110 * fy
  Color RGB(0, 0, 200)  ' dunkelblau
  Text 207 * fx, ye% + 1, "3"
  For i% = 3 To 36                     ' Zeichnen der Farbleiste
    Color RGB(rot%, gruen%, blau%)
    PBox xa%, ya%, xe%, ye%
    rot% = rot% - 4
    gruen% = gruen% - 4
    blau% = blau% - 4
    If Mod(i%, 5) = 0  ' Teilen durch 5 ergibt Rest 0
      Color RGB(0, 0, 200)  ' dunkelblau
      If i% = 5
        Text xa% + 3, ye% + 1, Str$(i%)
      Else
        Text xa% - 3, ye% + 1, Str$(i%)
      EndIf
    EndIf
    xa% = xa% + Fix(27 * fx)
    xe% = xe% + Fix(27 * fx)
  Next i%
  neu3:
  Repeat
    PeekEvent
  Until MouseK = 0 And _Mess = 0
  Repeat
    PeekEvent
    Mouse x, y, k%
    j$ = InKey$
  Until (Len(j$) = 2 And (Asc(Right$(j$)) = 119)) Or (k% = 1 And (x > 200 * fx And x < 200 * fx + 34 * Fix(27 * fx) And y > 70 * fy And y < 110 * fy Or x > 890 * fx And x < 1120 * fx And (y > 800 * fy And y < 832 * fy Or y > 750 * fy And y < 782 * fy Or  y > 700 * fy And y < 732 * fy)))
  If k% = 1 And x > 200 * fx And x < 1117 * fx And y > 70 * fy And y < 110 * fy
    leeren
    menge% = Fix((x - 200 * fx) / Fix(27 * fx)) + 1
    wasser2(menge%)   ' Wassermenge als 340stel, nur gerade Zahlen
    GoTo neu3
  Else If Len(j$) = 2 And (Asc(Right$(j$)) = 119)  ' F8
    alert3("Willst du wirklich aufhören?", "Ende", "zurück")
    If alertf| = 1
      ende
    Else
      GoTo neu3
    EndIf
  Else If k% = 1 And x > 890 * fx And x < 1120 * fx And y > 700 * fy And y < 732 * fy  ' hilfe 1
    alert2("Das Wasser steht am Ende in allen Rohren gleich hoch.", "Auf die Breite oder auf die Form des Rohres kommt es nicht an.", "Es ist so, als wäre das Wasser in allen Rohren Teil eines einzigen großen Sees.")
    GoTo neu3
  Else If k% = 1 And x > 890 * fx And x < 1120 * fx And y > 750 * fy And y < 782 * fy  '  verstanden: weiter ohne Reaktion
  Else If k% = 1 And x > 890 * fx And x < 1120 * fx And y > 800 * fy And y < 832 * fy  '  Drucken
    alert3("Ist der Drucker angeschaltet?", "ja", "nein")
    If alertf| = 1
      drucken
    EndIf
    GoTo neu3
  Else
    GoTo neu3
  EndIf
Return
>Procedure wasser2(menge%)  ' Fließen des Wassers Versuch 2
  Color RGB(100, 220, 255)                                                        ' hellblau
  DefLine 0, 14 * fx
  For i% = 1 To 370 * fy
    Line 78 * fx, 350 * fy, 78 * fx, 350 * fy + i% ' Wasserfüllung durch Rohr A
    verzoegerung(1 / fx)
  Next i%
  Color RGB(100, 220, 255)                                                        ' hellblau / Füllen der Rohre
  For i% = 1 To 722 * fy
    If (i% > 370 * fx  And menge% = 1)
      Color RGB(255, 255, 255)                      ' weiß
      Line 78 * fx, 352 * fy, 78 * fx, 350 * fy + i% - 360 * fy   ' Rohr A leeren
      Color RGB(100, 220, 255)                      ' hellblau
    EndIf
    Line 78 * fx, 720 * fy, 78 * fx + i%, 720 * fy  '  unten waagerecht
    verzoegerung(1 / fx)
  Next i%
  If menge% > 1
    Color RGB(100, 220, 255)                                                        ' hellblau
    hoehe% = (360 * fx - menge% * 10 * fx) / (menge% * 10 * fx)
    For i% = 1 To menge% * 10 * fx
      If menge% < 4                    ' Nachlaufen muss abbrechen, ehe Füllen mit Pboxen beginnt
        DefLine 0, 14 * fx
        Color RGB(255, 255, 255)                                                     ' weiß
        Line 78 * fx, 352 * fy, 78 * fx, 354 * fy + i% * hoehe%  ' Rohr A leeren
        Color RGB(100, 220, 255)                                                     ' hellblau
      Else If i% => menge% * 10 * fx  - (36 - menge%)  ' Nachlaufen bricht erst während des Steigens ab
        DefLine 0, 14 * fx
        Color RGB(255, 255, 255)                                                     ' weiß
        Line 78 * fx, 352 * fy, 78 * fx, 362 * fy + 10 * fx * (i% - (menge% * 10 * fx - (36 - menge%)))   ' Rohr A leeren
        Color RGB(100, 220, 255)                                                     ' hellblau
      EndIf
      DefLine 0, 1
      PBox 71 * fx, 720 * fy, Ceil(83 * fx), 720 * fy - i%     ' Rohr A
      PBox 201 * fx, 720 * fy, 261 * fx, 720 * fy - i% ' Rohr B
      If i% <= 170 * fx
        PBox 374 * fx, 720 * fy, 474 * fx, 720 * fy - i% ' Rohr C
        PBox 607 * fx, 720 * fy, 627 * fx, 720 * fy - i% ' Rohr D
        DefLine 0, 14 * fx
        Line 800 * fx, 720 * fy, 800 * fx + (i% - 1) / 0.577249575, Ceil(720 * fy - (i% - 1))  ' schräg, Rohr E
      Else
        PBox 414 * fx, Ceil(551 * fy), 434 * fx, 720 * fy - i%  ' Rohr C
        PBox 567 * fx, Ceil(551 * fy), 667 * fx, 720 * fy - i%  ' Rohr D
        DefLine 0, 14 * fx
        Line 1095 * fx, 550 * fy, Fix(1095 * fx - (i% - 171 * fx) / 0.577249575), Ceil(720 * fy - (i% - 1))  ' schräg, Rohr E
      EndIf
      verzoegerung(15 / fx)
    Next i%
    i% = i% - 1
    If i% => menge% * 10 * fx                                         '   Verbessern der Enden Rohr A
      Color RGB(255, 255, 255)  ' weiß
      DefLine 0, 1
      If _X = 1024
        PBox 71 * fx, 720 * fy - i% - 5, Fix(84 * fx), 720 * fy - i%     ' Rohr A
      Else
        PBox 71 * fx, 720 * fy - i% - 5, 84 * fx, 720 * fy - i%
      EndIf
    EndIf
    If i% < 169 * fx                                                           '  Verbessern der Enden Rohr E vor dem Knick
      DefLine 0, 1
      xa% = 800 * fx + (i% - 1) / 0.577249575
      Color RGB(100, 220, 255)                                                     ' hellblau
      For i3% = -8 * fy To 5 * fy
        Line xa% - 11 * fx + i3% / 0.577249575, Ceil(720 * fy - i% - i3%), xa% + Fix(17 * fx) + i3% / 0.577249575, Ceil(720 * fy - i% - i3%)   ' schräg, Rohr E
        If i3% >= -2 * fy
          Color RGB(255, 255, 255)
        EndIf
      Next i3%
    Else If i% > 168 * fx And i% < 172 * fx                                       ' Rohr E beim Knick
      DefLine 0, 1
      Color RGB(100, 220, 255)                                                     ' hellblau
      Line 1076 * fx, 553 * fy, 1102 * fx , 553 * fy   ' schräg, Rohr E
      Line 1078 * fx, Fix(552 * fy), 1102 * fx , Fix(552 * fy)   ' schräg, Rohr E
      Line 1078 * fx, Ceil(552 * fy), 1102 * fx , Ceil(552 * fy)   ' schräg, Rohr E
      Line 1080 * fx, Fix(551 * fy), 1102 * fx , Fix(551 * fy)   ' schräg, Rohr E
      Line 1080 * fx, Ceil(551 * fy), 1102 * fx , Ceil(551 * fy)   ' schräg, Rohr E
      Line 1080 * fx, Fix(550 * fy), 1102 * fx , Fix(550 * fy)   ' schräg, Rohr E
      Line 1080 * fx, Ceil(550 * fy), 1102 * fx , Ceil(550 * fy)   ' schräg, Rohr E
      Color RGB(255, 255, 255)  '  weiß
      For i3% = 0 To 5 * fy
        Line 1080 * fx + i3% / 2, Int(549 * fy) - i3%, 1102 * fx - i3% , Int(549 * fy) - i3%   ' schräg, Rohr E
      Next i3%
    Else If i% > 171 * fx                                                                ' Rohr E hinter dem Knick
      DefLine 0, 1
      xa% = 1095 * fx - (i% - 171 * fx) / 0.577249575
      Color RGB(100, 220, 255)                                                     ' hellblau
      For i3% = -6 * fy To 6 * fy
        If _X = 800 And i3% < -5 * fy
          Line xa% - 15 * fx - i3% / 0.577249575, Ceil(720 * fy - i% - i3%), xa% + 11 * fx - i3% / 0.577249575, Ceil(720 * fy - i% - i3%)   ' schräg, Rohr E
        Else
          Line xa% - 15 * fx - i3% / 0.577249575, Ceil(720 * fy - i% - i3%), xa% + 12 * fx - i3% / 0.577249575, Ceil(720 * fy - i% - i3%)   ' schräg, Rohr E
        EndIf
        If i3% = -1
          Color RGB(255, 255, 255)
        EndIf
      Next i3%
    EndIf
  EndIf
  Put 0, 350 * fy, ausschnitt$
Return
>Procedure leeren                    ' Rohre Versuch 2 leeren
  DefLine 0, 14 * fx
  Color RGB(255, 255, 255)                                                        ' weiß
  Line 78 * fx, 370 * fy, 78 * fx, 720 * fy
  Line 78 * fx, 720 * fy, 800 * fx, 720 * fy  ' unten waagerecht
  Line 800 * fx, 720 * fy, 1095 * fx, 550 * fy  ' schräg, Rohr E
  Line 1095 * fx, 550 * fy, 783 * fx, 370 * fy  ' schräg, Rohr E
  DefLine 0, 1
  PBox 201 * fx, 380 * fy, 261 * fx, 720 * fy  ' Rohr B
  PBox 414 * fx, 380 * fy, 434 * fx, 550 * fy  ' Rohr C
  PBox 374 * fx, 551 * fy, 474 * fx, 720 * fy  ' Rohr C
  PBox 567 * fx, 380 * fy, 667 * fx, 550 * fy  ' Rohr D
  PBox 607 * fx, 551 * fy, 627 * fx, 720 * fy  ' Rohr D
  Put 0, 350 * fy, ausschnitt$
Return
>Procedure hochbehaelter        ' Platz für den Hochbehälter suchen, zugehöriger Text
  SetFont schrift1%
  Color RGB(0, 0, 200)  ' dunkelblau
  Text 80 * fx, 110 * fy, "Suche jetzt den Platz für einen Wasserbehälter,"
  Text 80 * fx, 140 * fy, "    von dem aus das Wasser alle Häuser ohne eine Pumpe erreichen kann."
  Text 80 * fx, 185 * fy, "Der Behälter soll zum größten Teil unter der Erdoberfläche liegen, damit das Wasser"
  Text 80 * fx, 215 * fy, "    im Winter nicht einfrieren kann. Man soll ihn aber ohne Treppe erreichen können."
  Text 80 * fx, 260 * fy, "Klicke mit der Maus an eine dafür geeignete Stelle!"
  Get 0, 0, _X, _Y, bild$
  neu1:
  Repeat
    PeekEvent
  Until MouseK = 0
  Repeat
    PeekEvent
    Mouse x, y, k%
    j$ = InKey$
  Until k% <> 0 Or Len(j$) = 2 And Asc(Right$(j$)) = 119   'F8
  Put 0, 0, bild$
  blau1% = GetBValue(GetPixel(Win_1.hDC, x + 22 * fx, y - 7 * fy))
  blau2% = GetBValue(GetPixel(Win_1.hDC, x , y - 11 * fy))
  farbabfrage(x, y)
  If k% <> 0
    ya% = y / fy
    xa% = x / fx
    Select ya%
    Case 0 To 320
      alert1("Soll der Wasserbehälter in der Luft schweben?", "Lies die Aufgabe wieder durch und versuche es noch einmal!")
    Case 533 To 864
      alert1("Soll der Wasserbehälter tief in der Erde vergraben werden?", "Lies die Aufgabe wieder durch und versuche es noch einmal!")
    Case 321 To 532
      If rot% > 72 And gruen% > 205 And blau% > 245 ' Luft
        alert1("Soll der Wasserbehälter in der Luft schweben?", "Lies die Aufgabe wieder durch und versuche es noch einmal!")
      Else If  rot% > 140  And rot% < 185 And gruen% < 95 And blau% < 75   ' Erdfarbe
        wasserkontrolle
        If start| = 0
          start| = 1
          Color RGB(250, 250, 170)  ' beige
          DefLine 0, 1
          Text 80 * fx, 800 * fy, "Das Bild zeigt dir, ob das Wasser das höchstgelegene Haus erreichen könnte."
          verzoegerung(2000)
        EndIf
        If blau2% > 200 And ya% < 365 Or ya% < 338
          alert1("Gut: Das Wasser kann weit über das Dach des höchstgelegenen Hauses steigen.", "Der Wasserbehälter sollte aber noch etwas tiefer in der Erde liegen.")
        Else  If ya% > 337 And ya% < 365
          If xa% < 45 Or blau1% < 80
            alert1("Gut: Das Wasser kann weit über das Dach des höchstgelegenen Hauses steigen.", "Man müsste aber auf einer Treppe zum Wasserbehälter hinuntersteigen.")
          Else
            alert1("Das ist genau der richtige Platz: Das Wasser kann weit über das Dach des höchst-", "gelegenen Hauses steigen und es muss keine Treppe gebaut werden.")
            Color RGB(250, 250, 170)  ' beige
            DefLine 0, 1
            Text 880 * fx, 720 * fy, "Weiter"
            Text 880 * fx, 770 * fy, "Drucken"
            Text 880 * fx, 820 * fy, "Warum ein Hochbehälter?"
            Box 865 * fx, 713 * fy, 1140 * fx, 753 * fy
            Box 865 * fx, 763 * fy, 1140 * fx, 803 * fy
            Box 865 * fx, 813 * fy, 1140 * fx, 853 * fy
            zurueck:
            Repeat
              PeekEvent
            Until MouseK = 0
            Repeat
              j$ = InKey$
              Mouse x, y, k%
            Until k% = 1 And x > 865 * fx And x < 1140 * fx And (y > 713 * fy And y < 753 * fy Or y > 763 * fy And y < 803 * fy Or y > 813 * fy And y < 853 * fy) Or Len(j$) = 2 And (Asc(Right$(j$)) = 119) 'F8
            If Len(j$) = 2 And (Asc(Right$(j$)) = 119)  'F8
              alert3("Willst du wirklich aufhören?", "Ende", "zurück")
              If alertf| = 1
                ende
              Else
                GoTo zurueck
              EndIf
            Else If x > 865 * fx And x < 1140 * fx And y > 813 * fy And y < 853 * fy  ' Warum Hochbehälter?
              alert2("Das Wasser soll auch fließen können, wenn die Pumpe einmal ausfällt.", "Man kann Energie sparen, wenn die Pumpe nur so lange läuft,", "bis der Wasserbehälter wieder gefüllt ist.")
              GoTo zurueck
            Else If x > 865 * fx And x < 1140 * fx And y > 763 * fy And y < 803 * fy ' Drucken
              alert3("Ist der Drucker angeschaltet?", "ja", "nein")
              If alertf| = 1
                drucken
              EndIf
              GoTo zurueck
            EndIf
            verzoegerung(400)
            Clr bild$
            GoTo fertig1
          EndIf
        Else If ya% < 384
          alert1("Das Wasser kann jetzt bis über das Dach des höchstgelegenen Hauses steigen.", "Ein wenig mehr Höhe sollte den Wasserdruck noch verstärken.")
        Else If ya% < 407
          alert1("Das Wasser kann jetzt das höchstgelegene Haus erreichen.", "Der Wasserstand reicht aber noch nicht für eine brauchbare Wasserversorgung.")
        Else
          alert2("Das Wasser muss ohne Pumpe mindestens bis über das Dach des höchst-", "gelegenen Hauses steigen, damit es noch mit genügend Druck aus der Leitung", "fließt. Suche einen besseren Platz für den Wasserbehälter!")
        EndIf
      Else If rot% < 175 And gruen% > 160 And blau% < 80  And ya% < 384  ' grüner Streifen über der Erdfarbe
        alert1("Diese Stelle liegt zu nahe an der Erdoberfläche.", "Suche einen besseren Platz für den Wasserbehälter!")
      Else
        alert1("Dieser Platz ist nicht geeignet. Lies die Aufgabe durch", "und suche einen besseren Platz für den Wasserbehälter!")
      EndIf
    EndSelect
  Else
    alert3("Willst du wirklich aufhören?", "Ende", "zurück")
    If alertf| = 1
      ende
    Else
      GoTo neu1
    EndIf
  EndIf
  GoTo neu1
  fertig1:
Return
>Procedure wasserkontrolle      ' Wasserstand je nach Lage des Hochbehälters
  If _X > 800
    If x > 179 * fx And x < 182 * fx ' Ellipse zu eng
      x = 182 * fx
    EndIf
    If x > 177 * fx And x < 180 * fx
      x = 177 * fx
    EndIf
  Else
    If x > 179 * fx And x < 192 * fx ' Ellipse zu eng
      x = 192 * fx
    EndIf
    If x > 167 * fx And x < 180 * fx
      x = 167 * fx
    EndIf
  EndIf
  DefLine 0, 1
  Color RGB(80, 80, 80)  ' dunkelgrau, Wasserhochbehälter
  PBox x - 19 * fx, y - 10 * fy, x + 19 * fx, y + 19 * fy
  Color RGB(255, 255, 255) ' weiß, Luft
  PBox x - 16 * fx, y - 6 * fy, x + 16 * fx, y - 1
  PBox x + 9 * fx, y - 6 * fy, x + 16 * fx, y + 4 * fy
  PBox x + 9 * fx, y - 4 * fy, x + 19 * fx, y + 4 * fy
  Color RGB(0, 0, 0)       ' schwarz
  PBox x + 6 * fx, y - 2 * fy, x + 8 * fx, y + 7 * fy
  PBox x + 8 * fx, y + 5 * fy, x + 19 * fx, y + 7 * fy
  If  x > 179 * fx  ' Leitung auf linke  Seite des höchstgelegenen Hauses
    DefLine 0, 8 * fx
    Color RGB(0, 0, 0)       ' schwarz
    Ellipse 149 * fx + (x - 149 * fx) / 2, y + 5 * fy, (x - 149 * fx) / 2, 150 * fy, 180, 360
    DefLine 0, 4 * fx
    Color RGB(255, 255, 255)  ' weiß
    Ellipse 149 * fx + (x - 149 * fx) / 2, y + 5 * fy, (x - 149 * fx) / 2, 149 * fy, 178, 360
    Color RGB(100, 220, 255)       ' hellblau Wasser
    DefLine 0, 1
    PBox x - 16 * fx, y - 1, x + 5 * fx, y + 15 * fy
    DefLine 0, 4 * fx
    For i% = 360 DownTo 179
      zeitalt# = oTimer
      Ellipse 149 * fx + (x - 149 * fx) / 2, y + 5 * fy, (x - 149 * fx) / 2, 150 * fy, i% - 1, i%
      verzoegerung((370 - i%) / 10)
    Next i%
  Else  '   Leitung auf rechte  Seite des höchstgelegenen Hauses
    DefLine 0, 8 * fx
    Color RGB(0, 0, 0)       ' schwarz
    Ellipse 210 * fx + (x - 210 * fx) / 2, y + 5 * fy, (x - 210 * fx) / 2, 150 * fy, 180, 360
    DefLine 0, 4 * fx
    Color RGB(255, 255, 255)  ' weiß
    Ellipse 210 * fx + (x - 210 * fx) / 2, y + 5 * fy, (x - 210 * fx) / 2, 150 * fy, 183, 362
    Color RGB(100, 220, 255)       ' hellblau Wasser
    DefLine 0, 1
    PBox x - 16 * fx, y - 1, x + 5 * fx, y + 15 * fy
    DefLine 0, 4 * fx
    For i% = 180 To 361
      zeitalt# = oTimer
      Ellipse 210 * fx + (x - 210 * fx) / 2, y + 5 * fy, (x - 210 * fx) / 2, 150 * fy, i%, i% + 1
      verzoegerung((370 - i%) / 10)
    Next i%
  EndIf
Return
>Procedure brunnen                 ' Platz für den Brunnen suchen, zugehöriger Text
  DefLine 0, 1
  PBox 45 * fx, 343 * fy, 66 * fx, 360 * fy
  Color RGB(194, 252, 254)     ' Luft
  PBox 80 * fx, 334 * fy, 95 * fx, 350 * fy ' Eingang
  DefLine 0, 1
  Color RGB(147, 218, 62) ' grün
  PBox 80 * fx, 349 * fy, 93 * fx, 351 * fy  ' Fläche vor Eingang
  Color RGB(80, 80, 80) ' dunkelgrau
  PBox 42 * fx, 334 * fy, 80 * fx, 362 * fy  ' Wasserhochbehälter
  Color RGB(255, 255, 255) ' weiß, Luft
  PBox 45 * fx, 338 * fy, 77 * fx, 343 * fy
  PBox 70 * fx, 338 * fy, 77 * fx, 345 * fy
  Color RGB(255, 255, 255)       ' weiß, Eingang, Platz für Wasser
  PBox 69 * fx, 341 * fy, 80 * fx, 348 * fy
  PBox 45 * fx, 343 * fy, 66 * fx, 358 * fy
  Color RGB(0, 0, 0)       ' schwarz
  PBox 67 * fx, 342 * fy, 69 * fx, 351 * fy
  PBox 69 * fx, 349 * fy, 80 * fx, 351 * fy
  Get 0, 0, _X, _Y, bild$
  SetFont schrift1%
  Color RGB(0, 60, 220)  ' blau
  Text 80 * fx, 210 * fy, "Der Wasserhochbehälter ist fertig. Jetzt muss er mit Wasser gefüllt werden."
  Text 80 * fx, 245 * fy, "Das Wasser des Bachs könnte schmutzig sein. Sauberes Wasser gibt es tief unter dem Erdboden."
  Color RGB(250, 250, 170)  ' beige
  Text 10 * fx, 530 * fy, "Diese Erdschicht (z. B. Sandstein) kann sich mit"
  Text 10 * fx, 555 * fy, "    Regenwasser voll saugen wie ein Schwamm."
  Text _X / 2 - TxtLen("Erdschicht, in die kein Wasser eindringen kann") / 2, 760 * fy, "Erdschicht, in die kein Wasser eindringen kann"
  Color RGB(60, 230, 255)  ' hellblau
  Text 628 * fx, 530 * fy, "Regenwasser sickert langsam nach unten, bis es sich"
  Text 628 * fx, 555 * fy, "   über einer wasserundurchlässigen Schicht sammelt."
  SetFont schrift3%
  Text _X / 2 - TxtLen("Grundwasser") / 2, 680 * fy, "Grundwasser"
  SetFont schriftw1%
  Text 600 * fx, 580 * fy, "â"  ' Pfeil nach unten"
  Color RGB(250, 250, 170)   '  beige
  Text 70 * fx, 430 * fy, "á"  ' Pfeil nach oben"
  Text 200 * fx, 590 * fy, "â"  ' Pfeil nach unten"
  SetFont schrift1%
  Repeat
    PeekEvent
  Until MouseK = 0
  SetFont schrift1%
  DefLine 0, 1
  Text 980 * fx, 730 * fy, "Weiter"
  Text 980 * fx, 780 * fy, "Drucken"
  Box 965 * fx, 723 * fy, 1070 * fx, 763 * fy
  Box 965 * fx, 773 * fy, 1070 * fx, 813 * fy
  zurueck2:
  Repeat
    j$ = InKey$
    Mouse x, y, k%
  Until k% = 1 And x > 965 * fx And x < 1070 * fx And (y > 723 * fy And y < 763 * fy Or y > 773 * fy And y < 813 * fy) Or Len(j$) = 2 And (Asc(Right$(j$)) = 119) 'F8
  If Len(j$) = 2 And (Asc(Right$(j$)) = 119)  'F8
    alert3("Willst du wirklich aufhören?", "Ende", "zurück")
    If alertf| = 1
      ende
    Else
      GoTo zurueck2
    EndIf
  Else If x > 965 * fx And x < 1070 * fx And  y > 773 * fy And y < 813 * fy  ' Drucken
    alert3("Ist der Drucker angeschaltet?", "ja", "nein")
    If alertf| = 1
      drucken
    EndIf
    GoTo zurueck2
  EndIf
  verzoegerung(400)
  Put 0, 0, bild$
  Clr bild$
  SetFont schrift1%
  Color RGB(0, 60, 220)  ' blau
  Text 80 * fx, 145 * fy, "Suche jetzt den besten Platz für einen Brunnen."
  Text 80 * fx, 180 * fy, "Dafür soll ein Loch von der Erdoberfläche bis zum Grundwasser gebohrt werden."
  Text 80 * fx, 215 * fy, "Durch die mit kleinen Löchern versehenen Wände des Brunnens kann das saubere Wasser"
  Text 80 * fx, 245 * fy, "     dann in den Brunnen fließen."
  Text 80 * fx, 280 * fy, "Klicke an eine Stelle, von der aus das Grundwasser leicht zu erreichen ist!"
  neu2:
  Repeat
    PeekEvent
  Until MouseK = 0
  Repeat
    PeekEvent
    j$ = InKey$
    Mouse x, y, k%
  Until k% = 1 Or Len(j$) = 2 And (Asc(Right$(j$)) = 119) 'F8
  farbabfrage(x, y)
  If Len(j$) = 2 And (Asc(Right$(j$)) = 119)  'F8
    alert3("Willst du wirklich aufhören?", "Ende", "zurück")
    If alertf| = 1
      ende
    Else
      GoTo neu2
    EndIf
  Else If x > 553 * fx And x <= 578 * fx And y > 528 * fy And y < 537 * fy  ' Bach
    alert1("Diese Stelle ist nicht geeignet.", "Das Wasser des Bachs ist ein Hindernis und könnte das Trinkwasser verschmutzen.")
  Else If y > 511 * fy And y < 531 * fy And blau% < 245 ' nicht in der Luft
    If x > 500 * fx And x <= 539 * fx  ' linkes Ufer
      alert1("Du hast die beste Stelle gefunden.", "Der Weg zum Grundwasser ist nicht weit. Der Brunnen kann gebohrt werden.")
      GoTo fertig2
    Else If x > 578 * fx And x <= 605 * fx  ' rechtes Ufer
      alert1("Diese Stelle ist geeignet; das flachere Ufer der anderen Bachseite", "bietet aber etwas mehr Platz. Suche diese etwas günstigere Stelle.")
    Else If x > 539 * fx And x <= 553 * fx
      alert1("Diese Stelle ist zwar geeignet; eine etwas größere Entfernung vom Bach", "könnte aber Schwierigkeiten bei Hochwasser vermeiden helfen!")
    Else
      alert1("Suche eine Stelle,", "von der aus man den Brunnen bis zum Grundwasser noch leichter bohren kann!")
    EndIf
  Else If blau% > 250 Or y < 312 * fy
    alert1("Diese Stelle ist nicht geeignet.", "Lies die Aufgabe noch einmal durch!")
  Else If y < 512 * fy  ' zu hoch
    alert1("Diese Stelle ist nicht geeignet.", "Das Brunnen müsste tiefer als notwendig gebohrt werden.")
  Else If y > 530 * fy  ' zu tief
    alert1("Diese Stelle ist nicht geeignet.", "Der Brunnen muss von der Erdoberfläche aus gebohrt werden.")
  EndIf
  GoTo neu2
  fertig2:
  Color RGB(255, 255, 255)
  For i% = 1 To 190 * fx
    PBox Ceil(518 * fx), 520 * fy, 528 * fx, 520 * fy + i%
    verzoegerung(80 / fx)
  Next i%
  Color RGB(100, 30, 30)  ' dunkelbraun
  DefLine 0, Ceil(2 * fx)
  Line 519 * fx, 515 * fy, 519 * fx, 710 * fy  ' Brunnenwand
  Line 528 * fx, 515 * fy, 528 * fx, 710 * fy
  Color RGB(100, 220, 255)       ' hellblau Wasser
  For i% = 1 To Ceil(55 * fx)
    If _X = 800
      PBox 522 * fx, 711 * fy, 525 * fx, 711 * fx - i%
    Else
      PBox 521 * fx, 711 * fy, Fix(526 * fx), 711 * fx - i%
    EndIf
    verzoegerung(150 + i% * 2 / fx)
  Next i%
  Color RGB(250, 250, 170)  ' beige
  DefLine 0, 1
  Text 980 * fx, 730 * fy, "Weiter"
  Text 980 * fx, 780 * fy, "Drucken"
  Box 965 * fx, 723 * fy, 1070 * fx, 763 * fy
  Box 965 * fx, 773 * fy, 1070 * fx, 813 * fy
  zurueck2a:
  Repeat
    j$ = InKey$
    Mouse x, y, k%
  Until k% = 1 And x > 965 * fx And x < 1070 * fx And (y > 723 * fy And y < 763 * fy Or y > 773 * fy And y < 813 * fy) Or Len(j$) = 2 And (Asc(Right$(j$)) = 119) 'F8
  If Len(j$) = 2 And (Asc(Right$(j$)) = 119)  'F8
    alert3("Willst du wirklich aufhören?", "Ende", "zurück")
    If alertf| = 1
      ende
    Else
      GoTo zurueck2a
    EndIf
  Else If x > 965 * fx And x < 1070 * fx And  y > 773 * fy And y < 813 * fy  ' Drucken
    alert3("Ist der Drucker angeschaltet?", "ja", "nein")
    If alertf| = 1
      drucken
    EndIf
    GoTo zurueck2a
  EndIf
  verzoegerung(400)
Return
>Procedure pumpe                    ' Bau einer Pumpe ohne Ventile, zugehöriger Text
  Color RGB(0, 80, 160)                                                             ' dunkelblau
  DefLine 0, 1
  PBox 50 * fx, 50 * fy, 300 * fx, 220 * fy  ' Hochbehälter
  PBox 526 * fx, Ceil(254 * fy), 626 * fx, Fix(486 * fy)  ' Zylinder
  PBox 450 * fx, 750 * fy, 702 * fx, 864 * fy     ' Brunnen
  PBox 450 * fx, 720 * fy, 461 * fx, 750 * fy    ' Brunnenrand
  PBox 691 * fx, 720 * fy, 702 * fx, 750 * fy    ' Brunnenrand
  Color RGB(0, 0, 0)                                                                   ' schwarz
  PBox 58 * fx, 50 * fy, 292 * fx, 212 * fy  ' Hochbehälter
'##0#
  PBox 534 * fx, Ceil(262 * fy), 618 * fx, Fix(478 * fy)  ' Zylinder
  PBox 458 * fx, 750 * fy, 694 * fx, 864 * fy     ' Brunnen
  PBox 458 * fx, 720 * fy, 461 * fx, 750 * fy    ' Brunnenrand
  PBox 691 * fx, 720 * fy, 694 * fx, 750 * fy    ' Brunnenrand
  Color RGB(255, 255, 255)                                                           ' weiß
  PBox 62 * fx, 50 * fy, 288 * fx, 208 * fy  ' Hochbehälter
  PBox 538 * fx, Ceil(266 * fy), 614 * fx, Fix(474 * fy)  ' Zylinder
  PBox 567 * fx, 254 * fy, 585 * fx, 265 * fy  ' Zylinder oben Mitte
  Color RGB(0, 0, 0)                                                                       ' schwarz
  PBox 567 * fx, 475 * fy, 585 * fx, 500 * fy  ' Zylinder unten Mitte
  PBox 58 * fx, 50 * fy, 75 * fx, 55 * fy      ' Sensor für Wasserstand Hochbehälter
  Color RGB(255, 255, 255)                                                             ' weiß
  PBox 571 * fx, 475 * fy, 581 * fx, 500 * fy  ' Zylinder unten Mitte
  Color RGB(100, 220, 255)                                                             ' hellblau Wasser
  PBox 462 * fx, 750 * fy, 690 * fx, 864 * fy     ' Brunnen
  Color RGB(160, 50, 50)                                                                ' dunkelbraun
  PBox 538 * fx, 454 * fy, 614 * fx, 474 * fy     ' Kolben
  Color RGB(130, 130, 130)                                                            ' grau
  PBox 569 * fx, 220 * fy, 583 * fx, Ceil(453 * fy)     ' Kolbenstange
  PBox 67 * fx, 55 * fy, 75 * fx, 58 * fy      ' Sensor für Wasserstand Hochbehälter
  SetFont schriftw2%
  Color RGB(255, 0, 0)               '  rot
  PBox 67 * fx, 58 * fy, 75 * fx, 60 * fy      ' Sensor für Wasserstand Hochbehälter
  Text 630 * fx, 330 * fy, "é"  ' Pfeil nach oben"
  Text 630 * fx, 380 * fy, "ê"  ' Pfeil nach unten"
  SetFont schrift1%
  Text 175 * fx - TxtLen("Wasserhochbehälter") / 2, 230 * fy, "Wasserhochbehälter"
  Text 714 * fx, 740 * fy, "Brunnen"
  Color RGB(0, 0, 200)
  Text 670 * fx, 30 * fy, "Deine Aufgabe:"
  Text 670 * fx, 60 * fy, "Schaffe mit der Pumpe Wasser aus dem"
  Text 670 * fx, 90 * fy, "   Brunnen in den Hochbehälter!"
  Text 670 * fx, 125 * fy, "Keine Pumpe kann Wasser über etwa 9 m"
  Text 670 * fx, 155 * fy, "   hinaus hochsaugen."
  Text 670 * fx, 190 * fy, "Sauge deshalb das Wasser nur bis in die Pumpe"
  Text 670 * fx, 220 * fy, "   und drücke es dann in den Hochbehälter!"
  Text 670 * fx, 255 * fy, "Eine solche Pumpe funktioniert wie jede Spritze:"
  Text 670 * fx, 285 * fy, "   Im Inneren des Zylinders wird der braune Kol-"
  Text 670 * fx, 315 * fy, "   ben mit der Kolbenstange hin und her bewegt."
  Text 670 * fx, 350 * fy, "Du kannst ihn mit einem Klick auf einen der"
  Text 670 * fx, 380 * fy, "   beiden roten Pfeile bewegen."
  Text 670 * fx, 415 * fy, "Wenn du einen der Gegenstände links unten"
  Text 670 * fx, 445 * fy, "   benutzen willst, klicke auf seinen"
  Text 714 * fx + TxtLen("Brunnen  "), 740 * fy, "Sein Wasserstand verändert sich"
  Text 714 * fx + TxtLen("Brunnen  "), 770 * fy, "nicht, wenn Wasser gepumpt wird."
  Text 714 * fx + TxtLen("Brunnen  "), 800 * fy, "Wie im richtigen Brunnen sorgt das"
  Text 714 * fx + TxtLen("Brunnen  "), 830 * fy, "Grundwasser für den Ausgleich."
  Text 64 * fx - TxtLen("lang oder") / 2, 800 * fy, "lang oder"
  Text 64 * fx - TxtLen("kurz") / 2, 830 * fy, "kurz"
  Text 183 * fx - TxtLen("aus Glas") / 2, 800 * fy, "aus Glas"
  Text 330 * fx - TxtLen("Sie drückt den") / 2, 800 * fy, "Sie drückt den"
  Text 330 * fx - TxtLen("Schlauch fest zu") / 2, 830 * fy, "Schlauch fest zu"
  Color RGB(255, 0, 0)               '  rot
  Text 670 * fx + TxtLen("   benutzen willst, klicke auf seinen "), 445 * fy, "Namen!"
  Text 64 * fx - TxtLen("Schlauch") / 2, 770 * fy, "Schlauch"
  Text 183 * fx - TxtLen("T-Stück") / 2, 770 * fy, "T-Stück"
  Text 330 * fx - TxtLen("Klemme") / 2, 770 * fy, "Klemme"
  Box 18 * fx, 770 * fy, 110 * fx, 794 * fy  ' Box um Schlauch
  Box 142 * fx, 770 * fy, 224 * fx, 794 * fy  ' Box um T-Stück
  Box 286 * fx, 770 * fy, 373 * fx, 794 * fy  ' Box um Klemme
  PBox 54 * fx, 600 * fy, 74 * fx, 760 * fy  ' Schlauch
  Color RGB(0, 0, 0)                      '  schwarz
  PBox 190 * fx, 660 * fy, 208 * fx, 760 * fy  ' T-Stück
  PBox 158 * fx, 701 * fy, 190 * fx, 719 * fy
  Color RGB(255, 255, 255)            '  weiß
  PBox Ceil(59 * fx), 600 * fy, 69 * fx, 760 * fy  ' Schlauch
  PBox Ceil(194 * fx), 660 * fy, Fix(204 * fx), 760 * fy  ' T-Stück
  PBox 158 * fx, 705 * fy, 194 * fx, Fix(715 * fy)
  Color RGB(0, 0, 0)
  PRBox 300 * fx, 740 * fy, 360 * fx, 760 * fy ' Klemme
  Get 0, 0, _X, _Y, bild$
  Get 571 * fx, 475 * fy, 581 * fx, 760 * fy, luft_zyl_br$
  neu4:
  DefLine 0, 1
  Repeat
    PeekEvent
  Until MouseK = 0 And _Mess = 0
  Repeat
    PeekEvent
    Mouse x, y, k%
    j$ = InKey$
  Until Len(j$) = 2 And (Asc(Right$(j$)) = 119) Or (k% = 1 And ((x > 629 * fy And x < 670 * fx And y > 329 * fy And y < 420 * fy) Or (x > 18 * fx And x < 373 * fx And y > 770 * fy And y < 794 * fy)))
  If Len(j$) = 2 And (Asc(Right$(j$)) = 119)  ' F8
    alert3("Willst du wirklich aufhören?", "Ende", "zurück")
    If alertf| = 1
      ende
    Else
      GoTo neu4
    EndIf
  Else If k% = 1 And x > 629 * fy And x < 670 * fx And y > 329 * fy And y < 420 * fy
    farbabfrage(x, y)
    If unten| = 1 And rot% > 250 And gruen% < 80 And blau% < 80 And y < 373 * fy  ' Pfeil nach oben
      If _X = 1600 Or _X = 1280
        nachoben1600
      Else If _X = 800
        nachoben800
      Else
        nachoben
      EndIf
    Else  If unten| = 0 And rot% > 250  And gruen% < 80 And blau% < 80 And y > 372 * fy  ' Pfeil nach unten
      If _X = 1600 Or _X = 1280
        nachunten1600
      Else If _X = 800
        nachunten800
      Else
        nachunten
      EndIf
    EndIf
  Else If x > 18 * fx And x < 373 * fx And y > 770 * fy And y < 794 * fy   ' Auswahl von Schlauch, T-Stück oder Klemme
    If x > 18 * fx And x < 110 * fx  '  Schlauch
      alertSchl
    Else If x > 142 * fx And x < 224 * fx  '  T-Stück
      alertT
    Else If x > 286 * fx And x < 373 * fx  '  Klemme
      If beginn| = 0 And schlauch_t_h| = 2 And schlauch_t_br| = 2
        alert2("Achtung! Wenn eine Klemme gesetzt ist, kannst du sie erst dann wieder entfernen,", "wenn eine zweite Klemme gesetzt worden ist.", "Sonst könnte Wasser aus der Leitung zurück in den Brunnen fließen.")
        beginn| = 1
      EndIf
      alertKl
    EndIf
  EndIf
  If fertig| = 1
    fertig| = 0
    DefLine 0, 1
    Color RGB(255, 0, 0)   ' rot
    Box 965 * fx, 593 * fy, 1100 * fx, 633 * fy
    Box 965 * fx, 643 * fy, 1100 * fx, 683 * fy
    Color RGB(0, 0, 0)  ' schwarz
    Text 980 * fx, 600 * fy, "Weiter"
    Text 980 * fx, 650 * fy, "Drucken"
    zurueck3:
    Repeat
      j$ = InKey$
      Mouse x, y, k%
    Until k% = 1 And x > 965 * fx And x < 1100 * fx And ((y > 593 * fy And y < 633 * fy) Or (y > 643 * fy And y < 683 * fy)) Or Len(j$) = 2 And (Asc(Right$(j$)) = 119) 'F8
    If Len(j$) = 2 And (Asc(Right$(j$)) = 119)  'F8
      alert3("Willst du wirklich aufhören?", "Ende", "zurück")
      If alertf| = 1
        ende
      Else
        GoTo zurueck3
      Else
        verzoegerung(400)
        GoTo weiter2
      EndIf
    EndIf
    If y > 643 * fy And y < 683 * fy  ' Drucken
      alert3("Ist der Drucker angeschaltet?", "ja", "nein")
      If alertf| = 1
        drucken
      EndIf
      GoTo zurueck3
    EndIf
    verzoegerung(400)
    GoTo weiter2
  EndIf
  GoTo neu4
  weiter2:
Return
>Procedure zubehoer                ' Zubehör einrichten, Aufruf durch alertSchl, alertT, alertKl
  zurueck1:
  Repeat
    PeekEvent
  Until MouseK = 0
  Repeat
    PeekEvent
    Mouse x, y, k%
  Until k% = 1  And (x > 700 * fx And x < 720 * fx And y > 542 * fy And y < 712 * fy Or x > 960 * fx And x < 980 * fx And y > 692 * fy And y < 712 * fy)
  farbabfrage(x, y)
  If rot% < 200 And gruen% = 255 And blau% = 255                                      ' hellblau, Farbe des Auswahlkästchens in Alert-Schlauch
    DefLine 0, 1
    If x > 700 * fx And x < 720 * fx                                                  ' alle Auswahlkästchen
      If y > 542 * fy And y < 562 * fy                                                 '  Schlauch Pumpe - Brunnen
        If t_stueck| < 2 And schlauch_h| = 1
          Color RGB(240, 50, 50)               '  rot
          If _X = 1600 Or _X = 1280
            PBox 562 * fx + 1, 488 * fy, 566 * fx + 1, 504 * fy  ' Schlauch links
            PBox 586 * fx - 1, 488 * fy, 590 * fx - 1, 504 * fy  ' Schlauch rechts
            PBox 566 * fx + 1, 501 * fy - 1, 570 * fx + 1, 796 * fy  ' Schlauch links
            PBox 582 * fx - 1, 501 * fy - 1, 586 * fx - 1, 796 * fy  ' Schlauch rechts
          Else
            PBox 562 * fx, 488 * fy, 566 * fx, 504 * fy  ' Schlauch links
            PBox 586 * fx, 488 * fy, 590 * fx, 504 * fy  ' Schlauch rechts
            PBox 566 * fx, 501 * fy, 570 * fx, 796 * fy  ' Schlauch links
            PBox 582 * fx, 501 * fy, 586 * fx, 796 * fy  ' Schlauch rechts
          EndIf
          Color RGB(255, 255, 255)            '  weiß
          If voll| = 0
            PBox 571 * fx, 476 * fy, 581 * fx, 796 * fy  ' Schlauch innen
          Else
            PBox 571 * fx, 501 * fy, 581 * fx, 796 * fy  ' Schlauch innen
          EndIf
          schlauch_br| = 2
          schlauch_h| = 0
          schlauch_t| = 0
          schlauch_t_br| = 0
          schlauch_t_h| = 0
          t_stueck| = 0
          ansaugen| = 1
        Else If t_stueck| = 2 And schlauch_t| > 0 And schlauch_t_br| > 0  ' T-Stück gesetzt, Verbindung zum Brunnen fertigstellen
          Color RGB(240, 50, 50)               '  rot
          If _X = 1600 Or _X = 1280
            PBox 562 * fx + 1, 488 * fy, 566 * fx + 1, 504 * fy  ' Schlauch links           ' Schlauch Pumpe - T-Stück
            PBox 586 * fx - 1, 488 * fy, 590 * fx - 1, 504 * fy  ' Schlauch rechts
            PBox 566 * fx, 501 * fy - 1, 570 * fx, 549 * fy + 1  ' Schlauch links
            PBox 582 * fx, 501 * fy - 1, 586 * fx, 549 * fy + 1  ' Schlauch rechts
            PBox 562 * fx + 1, 546 * fy, 566 * fx + 1, 562 * fy  ' Schlauch T-Stück links
            PBox 586 * fx - 1, 546 * fy, 590 * fx - 1, 562 * fy  ' Schlauch T-Stück rechts
          Else
            PBox 562 * fx, 488 * fy, 566 * fx, 504 * fy  ' Schlauch links           ' Schlauch Pumpe - T-Stück
            PBox 586 * fx, 488 * fy, 590 * fx, 504 * fy  ' Schlauch rechts
            PBox 566 * fx, 501 * fy, 570 * fx, 549 * fy  ' Schlauch links
            PBox 582 * fx, 501 * fy, 586 * fx, 549 * fy  ' Schlauch rechts
            PBox 562 * fx, 546 * fy, 566 * fx, 562 * fy  ' Schlauch T-Stück links
            PBox 586 * fx, 546 * fy, 590 * fx, 562 * fy  ' Schlauch T-Stück rechts
          EndIf
          If voll| = 0
            Color RGB(255, 255, 255)            '  weiß
            PBox 571 * fx, 476 * fy, 581 * fx, 600 * fy  ' Schlauch innen
          EndIf
          Color RGB(240, 50, 50)               '  rot
          If _X = 1600 Or _X = 1280
            PBox 562 * fx + 1, 638 * fy, 566 * fx + 1, 654 * fy  ' Schlauch links            ' Schlauch T-Stück - Brunnen
            PBox 586 * fx - 1, 638 * fy, 590 * fx - 1, 654 * fy  ' Schlauch rechts
            PBox 566 * fx, 651 * fy, 570 * fx, 796 * fy  ' Schlauch links
            PBox 582 * fx, 651 * fy, 586 * fx, 796 * fy  ' Schlauch rechts
          Else
            PBox 562 * fx, 638 * fy, 566 * fx, 654 * fy  ' Schlauch links            ' Schlauch T-Stück - Brunnen
            PBox 586 * fx, 638 * fy, 590 * fx, 654 * fy  ' Schlauch rechts
            PBox 566 * fx, 651 * fy, 570 * fx, 796 * fy  ' Schlauch links
            PBox 582 * fx, 651 * fy, 586 * fx, 796 * fy  ' Schlauch rechts
          EndIf
          Color RGB(255, 255, 255)            '  weiß
          PBox 571 * fx, 595 * fy, 581 * fx, 796 * fy  ' Schlauch innen
          Color RGB(100, 220, 255)                        ' hellblau Wasser
          PBox 571 * fx, 750 * fy, 581 * fx, 796 * fy   ' Schlauch zum Brunnen
          schlauch_br| = 0
          schlauch_h| = 0
          schlauch_t| = 2
          schlauch_t_br| = 2
          If schlauch_t_h| = 2
            klemme_br| = 1
            klemme_h| = 1
          EndIf
          If klemme_h| = 2
            If voll| = 2
              ansaugen| = 2
            Else
              ansaugen| = 1
            EndIf
          Else
            ansaugen| = 0
          EndIf
        EndIf
      Else If y > 572 * fy And y < 592 * fy                                                '  Schlauch Pumpe - Hochbehälter
        Color RGB(240, 50, 50)               '  rot
        If _X = 1600 Or _X = 1280
          PBox 562 * fx + 1, 488 * fy, 566 * fx + 1, 504 * fy  ' Schlauch links
          PBox 586 * fx - 1, 488 * fy, 590 * fx - 1, 504 * fy  ' Schlauch rechts
        Else
          PBox 562 * fx, 488 * fy, 566 * fx, 504 * fy  ' Schlauch links
          PBox 586 * fx, 488 * fy, 590 * fx, 504 * fy  ' Schlauch rechts
        EndIf
        DefLine 0, 19 * fx
        Line 576 * fx, 503 * fy, 576 * fx, 600 * fy
        Line 576 * fx, 600 * fy, 350 * fx, 600 * fy
        Line 350 * fx, 600 * fy, 350 * fx, 30 * fy
        Line 350 * fx,  30 * fy, 250 * fx, 30 * fy
        Line 250 * fx,  30 * fy, 250 * fx, 60 * fy
        Color RGB(255, 255, 255)           ' weiß
        DefLine 0, Fix(11 * fx)
        Line 576 * fx, 490 * fy, 576 * fx, 600 * fy
        Line 576 * fx, 600 * fy, 350 * fx, 600 * fy
        Line 350 * fx, 600 * fy, 350 * fx, 30 * fy
        Line 350 * fx,  30 * fy, 250 * fx, 30 * fy
        Line 250 * fx,  30 * fy, 250 * fx, 60 * fy
        Color RGB(250, 254, 253)
        PBox 240 * fx, 55 * fy, 260 * fx, 65 * fy  ' Abdeckung Auslauf zum Hochbehälter
        DefLine 0, 1
        Color RGB(0, 0, 0)                                                                         ' schwarz
        PBox 567 * fx, 475 * fy, 585 * fx, 500 * fy  ' Zylinder unten Mitte, Anschluss an Schlauch
        Color RGB(255, 255, 255)                                                             ' weiß
        PBox 571 * fx, 475 * fy, 581 * fx, 500 * fy  ' Zylinder unten Mitte
        If voll| = 1
          Color RGB(100, 220, 255)                        ' hellblau Wasser
          PBox 571 * fx, 475 * fy, 581 * fx, 500 * fy
        EndIf
        schlauch_br| = 0
        schlauch_h| = 2
        schlauch_t| = 0
        schlauch_t_br| = 0
        schlauch_t_h| = 0
        t_stueck| = 0
        ansaugen| = 0
      Else If y > 602 * fy And y < 622 * fy                                                                    '  Schlauch T-Stück - Hochbehälter
        Color RGB(240, 50, 50)               '  rot
        If _X = 1600 Or _X = 1280
          PBox 518 * fx, 587 * fy + 1, 534 * fx, 590 * fy + 1  ' Schlauch oben
          PBox 518 * fx, 610 * fy - 1, 534 * fx, 614 * fy - 1 ' Schlauch unten
        Else
          PBox 518 * fx, 587 * fy, 534 * fx, 590 * fy  ' Schlauch oben
          PBox 518 * fx, 610 * fy, 534 * fx, 614 * fy ' Schlauch unten
        EndIf
        DefLine 0, 19 * fx
        Line 521 * fx, 600 * fy, 350 * fx, 600 * fy
        Line 350 * fx, 600 * fy, 350 * fx, 30 * fy
        Line 350 * fx,  30 * fy, 250 * fx, 30 * fy
        Line 250 * fx,  30 * fy, 250 * fx, 60 * fy
        DefLine 0, 1
        Color RGB(0, 0, 0)                      ' schwarz
        PBox 522 * fx, Ceil(591 * fy), 540 * fx, 609 * fy  ' T-Stück linker Anschluss
        Color RGB(255, 255, 255)           ' weiß
        DefLine 0, Fix(11 * fx)
        Line 576 * fx, 600 * fy, 350 * fx, 600 * fy
        Line 350 * fx, 600 * fy, 350 * fx, 30 * fy
        Line 350 * fx,  30 * fy, 250 * fx, 30 * fy
        Line 250 * fx,  30 * fy, 250 * fx, 60 * fy
        Color RGB(250, 254, 253)
        PBox 240 * fx, 55 * fy, 260 * fx, 65 * fy
        DefLine 0, 1
        Color RGB(0, 0, 0)                     ' schwarz
        PBox 567 * fx, 475 * fy, 585 * fx, 500 * fy  ' Zylinder unten Mitte, Anschluss an Schlauch
        Color RGB(255, 255, 255)          ' weiß
        PBox 571 * fx, 475 * fy, 581 * fx, 500 * fy  ' Zylinder unten Mitte
        If voll| > 0
          Color RGB(100, 220, 255)                        ' hellblau Wasser
          PBox 571 * fx, 475 * fy, 581 * fx, 500 * fy
        EndIf
        schlauch_br| = 0
        schlauch_h| = 0
        schlauch_t_h| = 2
        If schlauch_t| = 2
          klemme_h| = 1
          klemme_br| = 1
        EndIf
        ansaugen| = 0
      Else If y > 632 * fy And y < 652 * fy                                                              '  alles entfernen
        If voll| = 0 Or voll| = 2
          Put 0, 0, bild$
        Else               ' Zylinder voll
          Get 526 * fx, 10 * fy, 626 * fx, 486 * fy, zylinder$       '  voller Zylinder
          Output = Win_2
          Put 0, 0, bild$
          Put 526 * fx, 10 * fy, zylinder$
          Clr zylinder$
          DefLine 0, 1
          Color RGB(100, 220, 255)                        ' hellblau Wasser
          PBox 571 * fx, 480 * fy, 581 * fx, 500 * fy
          Get 0, 0, _X, _Y, j$
          Output = Win_1
          Put 0, 0, j$
          Clr j$
        EndIf
        schlauch_br| = 1
        schlauch_h| = 1
        schlauch_t| = 0
        schlauch_t_br| = 0
        schlauch_t_h| = 0
        t_stueck| = 1
        klemme_br| = 0
        klemme_h| = 0
        ansaugen| = 0
        fuellung| = 0
        If voll| = 0 Or voll| = 2
          unten| = 1
          voll| = 0
        EndIf
        wasserstand_h% = 205 * fy  ' Wasserstand im Hochbehälter nach der ersten Füllung
      Else If y > 662 * fy And y < 682 * fy                                                              ' zurück
        GoTo weiter
      Else
        GoTo zurueck1
      EndIf
    EndIf
  Else If rot% = 255 And gruen% = 255 And blau% < 160                       ' gelb, Farbe des Auswahlkästchens in Alert-T-Stück
    If y > 542 * fy And y < 562 * fy                                                         ' T-Stück setzen
      DefLine 0, 1
      Color RGB(0, 0, 0)                                         ' schwarz
      PBox 567 * fx, 550 * fy, 585 * fx, 650 * fy  ' T-Stück
      If _X = 1024
        PBox 522 * fx, 591 * fy, 571 * fx, 609 * fy
      Else
        PBox 522 * fx, Ceil(591 * fy), 571 * fx, 609 * fy
      EndIf
      Color RGB(255, 255, 255)                              ' weiß
      PBox 571 * fx, 550 * fy, 581 * fx, 650 * fy  ' Zylinder unten Mitte
      PBox 522 * fx, Ceil(595 * fy), 571 * fx, Fix(605 * fy)  ' T-Stück
      schlauch_br| = 0
      schlauch_h| = 0
      schlauch_t| = 1
      schlauch_t_br| = 1
      schlauch_t_h| = 1
      t_stueck| = 2
      ansaugen| = 0
    Else If y > 572 * fy And y < 592 * fy                                                  '  alles entfernen
      If voll| = 0 Or voll| = 2
        Put 0, 0, bild$
      Else               ' Zylinder voll
        Get 526 * fx, 10 * fy, 626 * fx, 486 * fy, zylinder$       '  voller Zylinder
        Output = Win_2
        Put 0, 0, bild$
        Put 526 * fx, 10 * fy, zylinder$
        Clr zylinder$
        DefLine 0, 1
        Color RGB(100, 220, 255)                        ' hellblau Wasser
        PBox 571 * fx, 480 * fy, 581 * fx, 500 * fy
        Get 0, 0, _X, _Y, j$
        Output = Win_1
        Put 0, 0, j$
        Clr j$
      EndIf
      schlauch_br| = 1
      schlauch_h| = 1
      schlauch_t| = 0
      schlauch_t_br| = 0
      schlauch_t_h| = 0
      t_stueck| = 1
      klemme_br| = 0
      klemme_h| = 0
      ansaugen| = 0
      fuellung| = 0
      If voll| = 0 Or voll| = 2
        unten| = 1
        voll| = 0
      EndIf
      wasserstand_h% = 205 * fy  ' Wasserstand im Hochbehälter nach der ersten Füllung
    Else If y > 602 * fy And y < 622 * fy                                                  ' zurück
      GoTo weiter
    Else
      GoTo zurueck1
    EndIf
  Else If rot% = 255 And gruen% < 200 And blau% = 255                                        ' lila, Farbe des Auswahlkästchens in Alert-Klemme
    If x > 960 * fx And x < 980 * fx                                                          ' zurück
      GoTo weiter
    Else If y > 542 * fy And y < 562 * fy                                                   ' Klemme Richtung Brunnen setzen
      Get 546 * fx, 670 * fy, 606 * fx, 690 * fy, klemm_br$  ' Hintergrund der Klemme_Br zum späteren Wiederherstellen
      Color RGB(0, 0, 0)      ' schwarz
      PRBox 546 * fx, 670 * fy, 606 * fx, 690 * fy  ' Klemme_Br
      klemme_br| = 2
      ansaugen| = 0
    Else If y > 572 * fy And y < 592 * fy                                                 ' Klemme Richtung Brunnen entfernen
      Repeat
        PeekEvent
      Until MouseK = 0 And _Mess = 0
      Put 546 * fx, 670 * fy,  klemm_br$
      Clr klemm_br$
      klemme_br| = 1
      If schlauch_t| = 2 And schlauch_t_br| = 2 And klemme_h| = 2
        ansaugen| = 1
        If fuellung| = 1
          ansaugen| = 2
        EndIf
      Else
        ansaugen| = 0
      EndIf
    Else If y > 602 * fy And y < 622 * fy                                                 ' Klemme Richtung Hochbehälter setzen
      Get 482 * fx, 570 * fy, 502 * fx, 630 * fy, klemm_h$  ' Hintergrund der Klemme_H zum späteren Wiederherstellen
      Color RGB(0, 0, 0)      ' schwarz
      PRBox 482 * fx, 570 * fy, 502 * fx, 630 * fy  ' Klemme_H
      klemme_h| = 2
      If schlauch_t_br = 2 And schlauch_t = 2 And klemme_br| < 2
        ansaugen| = 1
        If fuellung| = 1
          ansaugen| = 2
        EndIf
      Else
        ansaugen| = 0
      EndIf
    Else If y > 632 * fy And y < 652 * fy                                                    ' Klemme Richtung Hochbehälter entfernen
      Repeat
        PeekEvent
      Until MouseK = 0 And _Mess = 0
      Put 482 * fx, 570 * fy,  klemm_h$
      klemme_h| = 1
      ansaugen| = 0
    Else If y > 662 * fy And y < 682 * fy And fuellung| = 1 And ((klemme_br| = 2 And klemme_h| < 2) Or (klemme_br| < 2 And klemme_h| = 2))  ' Klemmen wechseln
      If klemme_br| = 2                                                      ' Klemme_Br gesetzt
        Put 546 * fx, 670 * fy,  klemm_br$
        Color RGB(0, 0, 0)      ' schwarz
        PRBox 482 * fx, 570 * fy, 502 * fx, 630 * fy  ' Klemme_H
        klemme_br| = 1
        klemme_h| = 2
        If fuellung| = 1
          ansaugen| = 2
        Else
          ansaugen| = 1
        EndIf
      Else                                                                            ' Klemme_H gesetzt
        Put 482 * fx, 570 * fy,  klemm_h$
        Color RGB(0, 0, 0)      ' schwarz
        PRBox 546 * fx, 670 * fy, 606 * fx, 690 * fy  ' Klemme_Br
        klemme_h| = 1
        klemme_br| = 2
        ansaugen| = 0
      EndIf
    Else If y > 692 * fy And y < 712 * fy                                                           ' alles entfernen
      If voll| = 0  Or voll| = 2
        Put 0, 0, bild$
      Else  ' Zylinder voll
        Get 526 * fx, 10 * fy, 626 * fx, 486 * fy, zylinder$       '  voller Zylinder
        Output = Win_2
        Put 0, 0, bild$
        Put 526 * fx, 10 * fy, zylinder$
        Clr zylinder$
        DefLine 0, 1
        Color RGB(100, 220, 255)                        ' hellblau Wasser
        PBox 571 * fx, 480 * fy, 581 * fx, 500 * fy
        Get 0, 0, _X, _Y, j$
        Output = Win_1
        Put 0, 0, j$
        Clr j$
      EndIf
      schlauch_br| = 1
      schlauch_h| = 1
      schlauch_t| = 0
      schlauch_t_br| = 0
      schlauch_t_h| = 0
      t_stueck| = 1
      klemme_br| = 0
      klemme_h| = 0
      ansaugen| = 0
      fuellung| = 0
      If voll| = 0 Or voll| = 2
        unten| = 1
        voll| = 0
      EndIf
      wasserstand_h% = 205 * fy  ' Wasserstand im Hochbehälter nach der ersten Füllung
    EndIf
  Else
    GoTo zurueck1
  EndIf
  weiter:
Return
>Procedure nachoben               ' Kolben nach oben _X = 1024 oder 1152
  If klemme_br| = 2 And klemme_h| = 2
    alert2("Die Pumpe kann nichts ansaugen. Beide Leitungen sind durch Klemmen", "verschlossen. Wenn du eine Spritze ohne Nadel hast, mache folgenden Versuch:", "Drücke die Spritze fest auf deinen Arm und ziehe vorsichtig am Kolben!")
  Else If ansaugen| > 0   And (klemme_br| = 2 And klemme_h| < 2 Or schlauch_h| = 2)    ' Zurücksaugen aus der Steigleitung in die Pumpe + Rückgängigmachen
    For i% = 0 To 152 * fy
      DefLine 0, 1
      Color RGB(160, 50, 50)                                                                ' dunkelbraun
      PBox 538 * fx, 473 * fy - i%, 614 * fx, 453 * fy - i%         ' Kolben
      Color RGB(100, 220, 255)                        ' hellblau Wasser
      PBox 538 * fx, 474 * fy , 614 * fx, 474 * fy - i%
      DefLine 0, Fix(11 * fx)
      Color RGB(255, 255, 255)                        ' weiß
      If i% < 4 * fy
        Line 250 * fx,  50 * fy, 250 * fx, Min(55 * fy - i% * 7, 50 * fy)
      Else If i% < 19 * fy
        Line 250 * fx ,  30 * fy, 252 * fx + (i% - 4 * fx) * 7, 30 * fy
      Else If i% < 101 * fy
        Line 350 * fx, 30 * fy, 350 * fx, 32 * fy + Fix(i% - 19 * fy) * 7
      Else If  i% < 134 * fy
        Line 350 * fx, 600 * fy, Max(348 * fx + Fix(i% - 101 * fy) * 7, 350 * fx), 600 * fy  ' Schläuche zum Hochbehälter
        If i% = 134 * fy - 1
          Line 550 * fx, 600 * fy, 576 * fx, 600 * fy  ' Schläuche zum Hochbehälter
        EndIf
      Else
        DefLine 0, 1
        PBox 571 * fx, 600 * fy, 581 * fx, 600 * fy - (i% - 134 * fy) * 7
      EndIf
      DefLine 0, 1
      Color RGB(130, 130, 130)                        ' grau
      PBox 569 * fx, 220 * fy, 583 * fx, 221 * fy - i%     ' Kolbenstange
      verzoegerung(20 / fx)
    Next i%
    verzoegerung(500)
    alert1("Diese Idee war nicht so gut!", "Das Wasser wird wieder in die Leitung zurückgepumpt.")
    verzoegerung(500)
    For i% = 0 To 153 * fy
      Color RGB(160, 50, 50)                           ' dunkelbraun
      PBox 538 * fx, 301 * fy + i%, 614 * fx, 321 * fy + i%     ' Kolben
      DefLine 0, Fix(11 * fx)
      Color RGB(100, 220, 255)                        ' hellblau Wasser
      If i% < 16 * fy
        Line 576 * fx, 475 * fy + i%, 576 * fx, 495 * fy + i% * 7  ' Schläuche zum Hochbehälter
      Else If i% < 49 * fy
        Line 576 * fx - (i% - 16 * fx) * 7, 600 * fy, 576 * fx, 600 * fy
      Else If i% < 131 * fy
        If _X = 1024
'##B#
          Line 350 * fx, 600 * fy, 350 * fx, Min(600 * fy, 604 * fy - (i% - 49 * fy) * 7)
        Else
          Line 350 * fx, 600 * fy, 350 * fx, 600 * fy - (i% - 49 * fy) * 7
        EndIf
      Else If i% < 146 * fy
        Line 349 * fx - (i% - 131 * fy) * 7,  30 * fy, 350 * fx, 30 * fy
      Else If i% < 148 * fy
        Line 250 * fx,  30 * fy, 250 * fx, 35 * fy + (i% - 146 * fy) * 7
      EndIf
      DefLine 0, 1
      Color RGB(255, 255, 255)                        ' weiß
      PBox 538 * fx, 290 * fy , 568 * fx, 300 * fy + i%    ' Luft neben Kolbenstange
      PBox 584 * fx, 290 * fy , 614 * fx, 300 * fy + i%    ' Luft neben Kolbenstange
      Color RGB(130, 130, 130)                        ' grau
      PBox 569 * fx, 300 * fy, 583 * fx, 300 * fy + i%     ' Kolbenstange
      Color RGB(244, 255, 251)                        ' heller Hintergrund
      PBox 569 * fx, 48 * fy, 583 * fx, 68 * fy + i%         ' Luft über Kolbenstange
      verzoegerung(30 / fx)
    Next i%
    DefLine 0, Fix(11 * fx)
    Color RGB(255, 255, 255)              ' weiß
    Line 250 * fx,  65 * fy, 250 * fx, 50 * fy   ' Abdeckung
  Else  ' Ansaugen aus dem Brunnen
    For i% = 0 To 188 * fy
      DefLine 0, 1
      Color RGB(160, 50, 50)                                                                ' dunkelbraun
'##1#
      PBox 538 * fx, Fix(473 * fy) - i%, 614 * fx, Ceil(453 * fy) - i%           ' Kolben
      If ansaugen| = 1 And i% < 47 * fy And klemme_br| < 2
        Color RGB(255, 255, 255)                      ' weiß
        PBox 538 * fx, Fix(474 * fy), 614 * fx, 474 * fy - i%    ' Luft
        Color RGB(100, 220, 255)                        ' hellblau Wasser
        PBox 571 * fx, 799 * fy, 581 * fx, 796 * fy - i% * 7  ' Steigrohr
        voll| = 1    ' Zylinder gefüllt, mit Luftblase
      Else If ansaugen| = 1 And klemme_br| < 2
        Color RGB(255, 255, 255)                      ' weiß
        PBox 538 * fx, Fix(475 * fy) - i% , 614 * fx, 475 * fy - i%    ' Luft
        Color RGB(100, 220, 255)                        ' hellblau Wasser
        PBox 538 * fx, 474 * fy , 614 * fx, 474 * fy - (i% - 47 * fy)
        voll| = 1   ' Zylinder gefüllt, mit Luftblase
      Else If ansaugen| = 2  And klemme_br| < 2    ' keine Luft im Zylinder
        If i% = 0
          Color RGB(100, 220, 255)                        ' hellblau Wasser
          PBox 571 * fx, 799 * fy, 581 * fx, 475 * fy  ' Steigrohr
        EndIf
        Color RGB(100, 220, 255)                        ' hellblau Wasser
        PBox 538 * fx, Fix(474 * fy), 614 * fx, 474 * fy - i%
        voll| = 2   ' Zylinder gefüllt, ohne Luftblase
      Else If ansaugen| = 0  ' kein Ansaugen aus dem Brunnen möglich
        Color RGB(255, 255, 255)                      ' weiß
        PBox 538 * fx, Fix(474 * fy), 614 * fx, 474 * fy - i%    ' Luft
      EndIf
      DefLine 0, 1
      Color RGB(130, 130, 130)                        ' grau
      PBox 569 * fx, 220 * fy, 583 * fx, 221 * fy - i%     ' Kolbenstange
      verzoegerung(20 / fx)
    Next i%
    unten| = 0  ' Kolben oben
    If ansaugen| > 0 And schlauch_t_br| = 2 And klemme_br| < 2
      Get 546 * fx, 670 * fx, 606 * fx, 690 * fy, klemm_br$  ' Hintergrund der Klemme_Br zum späteren Wiederherstellen
    EndIf
  EndIf
  If schlauch_t_br| = 2 And schlauch_t| = 2 And klemme_br| < 2 And klemme_h| < 2
    alert1("Weil die Pumpe durch das offene Ende des T-Stücks leichte Luft ansaugen kann,", "bleibt das viel schwerere Wasser im Brunnen.")
  EndIf
Return
>Procedure nachoben800          ' Kolben nach oben _X = 800
  If klemme_br| = 2 And klemme_h| = 2
    alert2("Die Pumpe kann nichts ansaugen. Beide Leitungen sind durch Klemmen", "verschlossen. Wenn du eine Spritze ohne Nadel hast, mache folgenden Versuch:", "Drücke die Spritze fest auf deinen Arm und ziehe vorsichtig am Kolben!")
  Else If ansaugen| > 0   And (klemme_br| = 2 And klemme_h| < 2 Or schlauch_h| = 2)    ' Zurücksaugen aus der Steigleitung in die Pumpe + Rückgängigmachen
    For i% = 0 To 152 * fy
      DefLine 0, 1
      Color RGB(160, 50, 50)                                                                ' dunkelbraun
      PBox 538 * fx, 473 * fy - i%, 614 * fx, 453 * fy - i%         ' Kolben
      Color RGB(100, 220, 255)                        ' hellblau Wasser
      PBox 538 * fx, 474 * fy , 614 * fx, 474 * fy - i%
      DefLine 0, Fix(11 * fx)
      Color RGB(255, 255, 255)                        ' weiß
      If i% < 4 * fy
        Line 250 * fx,  50 * fy, 250 * fx, 55 * fy - i% * 7
      Else If i% < 19 * fy
        Line 250 * fx , 30 * fy, 250 * fx + (i% - 4 * fx) * 6.7, 30 * fy
      Else If i% < 101 * fy
        Line 350 * fx, 30 * fy, 350 * fx, 32 * fy + Fix(i% - 19 * fy) * 7
      Else If  i% < 134 * fy
        Line 350 * fx, 600 * fy, 354 * fx + Fix(i% - 101 * fy) * 7, 600 * fy  ' Schläuche zum Hochbehälter
        If i% = 134 * fy - 1
          Line 550 * fx, 600 * fy, 576 * fx, 600 * fy  ' Schläuche zum Hochbehälter
        EndIf
      Else
        DefLine 0, 1
        PBox 571 * fx, 600 * fy, 581 * fx, 604 * fy - (i% - 134 * fy) * 7
      EndIf
      DefLine 0, 1
      Color RGB(130, 130, 130)                        ' grau
      PBox 569 * fx, 220 * fy, 583 * fx, 221 * fy - i%     ' Kolbenstange
      verzoegerung(20 / fx)
    Next i%
    verzoegerung(500)
    alert1("Diese Idee war nicht so gut!", "Das Wasser wird wieder in die Leitung zurückgepumpt.")
    verzoegerung(500)
    For i% = 0 To 153 * fy
      Color RGB(160, 50, 50)                           ' dunkelbraun
      PBox 538 * fx, 301 * fy + i%, 614 * fx, 321 * fy + i%     ' Kolben
      DefLine 0, Fix(11 * fx)
      Color RGB(100, 220, 255)                        ' hellblau Wasser
      If i% < 16 * fy
        Line 576 * fx, 475 * fy + i%, 576 * fx, 495 * fy + i% * 7  ' Schläuche zum Hochbehälter
      Else If i% < 49 * fy
        Line 580 * fx - (i% - 16 * fx) * 7, 600 * fy, 576 * fx, 600 * fy
      Else If i% < 131 * fy
        Line 350 * fx, 600 * fy, 350 * fx, 598 * fy - (i% - 49 * fy) * 7
      Else If i% < 146 * fy
        Line 350 * fx - (i% - 131 * fy) * 6.7,  30 * fy, 350 * fx, 30 * fy
      Else If i% < 148 * fy
        Line 250 * fx,  30 * fy, 250 * fx, 37 * fy + (i% - 146 * fy) * 7
      EndIf
      DefLine 0, 1
      Color RGB(255, 255, 255)                        ' weiß
      PBox 538 * fx, 290 * fy , 568 * fx, 300 * fy + i%    ' Luft neben Kolbenstange
      PBox 584 * fx, 290 * fy , 614 * fx, 300 * fy + i%    ' Luft neben Kolbenstange
      Color RGB(130, 130, 130)                        ' grau
      PBox 569 * fx, 300 * fy, 583 * fx, 300 * fy + i%     ' Kolbenstange
      Color RGB(244, 255, 251)                        ' heller Hintergrund
      PBox 569 * fx, 48 * fy, 583 * fx, 68 * fy + i%         ' Luft über Kolbenstange
      verzoegerung(30 / fx)
    Next i%
    DefLine 0, Fix(11 * fx)
    Color RGB(255, 255, 255)              ' weiß
    Line 250 * fx,  65 * fy, 250 * fx, 50 * fy   ' Abdeckung
  Else  ' Ansaugen aus dem Brunnen
    For i% = 0 To 188 * fy
      DefLine 0, 1
      Color RGB(160, 50, 50)                                                                ' dunkelbraun
      PBox 538 * fx, Fix(473 * fy) - i%, 614 * fx, Ceil(453 * fy) - i%           ' Kolben
      If ansaugen| = 1 And i% < 47 * fy And klemme_br| < 2
        Color RGB(255, 255, 255)                      ' weiß
        PBox 538 * fx, Fix(474 * fy), 614 * fx, 474 * fy - i%    ' Luft
        Color RGB(100, 220, 255)                        ' hellblau Wasser
        PBox 571 * fx, 798 * fy, 581 * fx, 796 * fy - i% * 7  ' Steigrohr
        voll| = 1    ' Zylinder gefüllt, mit Luftblase
      Else If ansaugen| = 1 And klemme_br| < 2
        Color RGB(255, 255, 255)                      ' weiß
        PBox 538 * fx, Fix(475 * fy) - i% , 614 * fx, 475 * fy - i%    ' Luft
        Color RGB(100, 220, 255)                        ' hellblau Wasser
        PBox 538 * fx, 474 * fy , 614 * fx, 474 * fy - (i% - 47 * fy)
        voll| = 1   ' Zylinder gefüllt, mit Luftblase
      Else If ansaugen| = 2  And klemme_br| < 2    ' keine Luft im Zylinder
        If i% = 0
          Color RGB(100, 220, 255)                        ' hellblau Wasser
          PBox 571 * fx, 798 * fy, 581 * fx, 475 * fy  ' Steigrohr
        EndIf
        Color RGB(100, 220, 255)                        ' hellblau Wasser
        PBox 538 * fx, Fix(474 * fy), 614 * fx, 474 * fy - i%
        voll| = 2   ' Zylinder gefüllt, ohne Luftblase
      Else If ansaugen| = 0  ' kein Ansaugen aus dem Brunnen möglich
        Color RGB(255, 255, 255)                      ' weiß
        PBox 538 * fx, Fix(474 * fy), 614 * fx, 474 * fy - i%    ' Luft
      EndIf
      DefLine 0, 1
      Color RGB(130, 130, 130)                        ' grau
      PBox 569 * fx, 220 * fy, 583 * fx, 221 * fy - i%     ' Kolbenstange
      verzoegerung(20 / fx)
    Next i%
    unten| = 0  ' Kolben oben
    If ansaugen| > 0 And schlauch_t_br| = 2 And klemme_br| < 2
      Get 546 * fx, 670 * fx, 606 * fx, 690 * fy, klemm_br$  ' Hintergrund der Klemme_Br zum späteren Wiederherstellen
    EndIf
  EndIf
  If schlauch_t_br| = 2 And schlauch_t| = 2 And klemme_br| < 2 And klemme_h| < 2
    alert1("Weil die Pumpe durch das offene Ende des T-Stücks leichte Luft ansaugen kann,", "bleibt das viel schwerere Wasser im Brunnen.")
  EndIf
Return
>Procedure nachoben1600        ' Kolben nach oben _X = 1600 oder 1280
  If klemme_br| = 2 And klemme_h| = 2
    alert2("Die Pumpe kann nichts ansaugen. Beide Leitungen sind durch Klemmen", "verschlossen. Wenn du eine Spritze ohne Nadel hast, mache folgenden Versuch:", "Drücke die Spritze fest auf deinen Arm und ziehe vorsichtig am Kolben!")
  Else If ansaugen| > 0   And (klemme_br| = 2 And klemme_h| < 2 Or schlauch_h| = 2)    ' Zurücksaugen aus der Steigleitung in die Pumpe + Rückgängigmachen
    For i% = 0 To 153 * fy
      DefLine 0, 1
      Color RGB(160, 50, 50)                                                                ' dunkelbraun
      PBox 538 * fx, 473 * fy - i%, 614 * fx, 453 * fy - i%         ' Kolben
      Color RGB(100, 220, 255)                        ' hellblau Wasser
      If i% = 0
        PBox 571 * fx, 474 * fy + 1, 581 * fx, 474 * fy + 2
      EndIf
      PBox 538 * fx, 474 * fy + 1 , 614 * fx, 474 * fy - i%
      DefLine 0, Fix(11 * fx)
      Color RGB(255, 255, 255)                        ' weiß
      If i% < 4 * fy
        Line 250 * fx,  50 * fy - 1, 250 * fx, 50 * fy - i% * 5
      Else If i% < 19 * fy
        Line 250 * fx ,  30 * fy, 250 * fx + i% * 5, 30 * fy
      Else If i% < 101 * fy
        Line 350 * fx, 30 * fy, 350 * fx, 30 * fy + (i% - 19 * fy) * 6.9
      Else If  i% < 134 * fy
        Line 350 * fx, 600 * fy, 354 * fx + (i% - 101 * fy) * 6, 600 * fy  ' Schläuche zum Hochbehälter
        If i% = Int(134 * fy) - 1
          Line 550 * fx, 600 * fy, 576 * fx, 600 * fy  ' Schläuche zum Hochbehälter
        EndIf
      Else
        DefLine 0, 1
        PBox 571 * fx, 600 * fy, 581 * fx, 611 * fy - (i% - 133 * fy) * 7
      EndIf
      DefLine 0, 1
      Color RGB(130, 130, 130)                        ' grau
      PBox 569 * fx, 220 * fy, 583 * fx, 221 * fy - i%     ' Kolbenstange
      verzoegerung(20 / fx)
    Next i%
    verzoegerung(500)
    alert1("Diese Idee war nicht so gut!", "Das Wasser wird wieder in die Leitung zurückgepumpt.")
    verzoegerung(500)
    For i% = 0 To 153 * fy
      Color RGB(160, 50, 50)                           ' dunkelbraun
      PBox 538 * fx, 301 * fy + i%, 614 * fx, 321 * fy + i%     ' Kolben
      DefLine 0, Fix(11 * fx)
      Color RGB(100, 220, 255)                        ' hellblau Wasser
      If i% < 16 * fy
        Line 576 * fx, 475 * fy + i%, 576 * fx, 495 * fy + i% * 7  ' Schläuche zum Hochbehälter
      Else If i% < 49 * fy
        Line 576 * fx - (i% - 16 * fx) * 6.7, 600 * fy, 576 * fx, 600 * fy
      Else If i% < 131 * fy
        Line 350 * fx, 600 * fy, 350 * fx, Min(600 * fy, 603 * fy - (i% - 49 * fy) * 7)
      Else If i% < 146 * fy
        Line 350 * fx - (i% - 131 * fy) * 6.7,  30 * fy, 350 * fx, 30 * fy
      Else If i% < 148 * fy
        Line 250 * fx,  30 * fy, 250 * fx, 30 * fy + (i% - 146 * fy) * 7
      EndIf
      DefLine 0, 1
      Color RGB(255, 255, 255)                        ' weiß
      PBox 538 * fx, 290 * fy , 568 * fx, 300 * fy + i%    ' Luft neben Kolbenstange
      PBox 584 * fx, 290 * fy , 614 * fx, 300 * fy + i%    ' Luft neben Kolbenstange
      Color RGB(130, 130, 130)                        ' grau
      PBox 569 * fx, 300 * fy, 583 * fx, 300 * fy + i%     ' Kolbenstange
      Color RGB(244, 255, 251)                        ' heller Hintergrund
      PBox 569 * fx, 48 * fy, 583 * fx, 68 * fy + i%         ' Luft über Kolbenstange
      verzoegerung(30 / fx)
    Next i%
    DefLine 0, Fix(11 * fx)
    Color RGB(255, 255, 255)              ' weiß
    Line 250 * fx,  65 * fy, 250 * fx, 50 * fy   ' Abdeckung
  Else  ' Ansaugen aus dem Brunnen
    For i% = 0 To 188 * fy + 1
      DefLine 0, 1
      Color RGB(160, 50, 50)                 ' dunkelbraun
      PBox 538 * fx, 473 * fy - i%, 614 * fx, 453 * fy - i%           ' Kolben
      If  i% < 47 * fy And ansaugen| = 1 And klemme_br| < 2
        Color RGB(255, 255, 255)                      ' weiß
        PBox 538 * fx, 474 * fy + 1, 614 * fx, 474 * fy + 1 - i%    ' Luft
        Color RGB(100, 220, 255)                        ' hellblau Wasser
        PBox 571 * fx, 798 * fy, 581 * fx, 800 * fy - i% * 7  ' Steigrohr
        voll| = 1    ' Zylinder gefüllt, mit Luftblase
      Else If ansaugen| = 1 And klemme_br| < 2
        Color RGB(255, 255, 255)                      ' weiß
        PBox 538 * fx, 474 * fy + 1 - i% , 614 * fx, 474 * fy + 2 - i%    ' Luft
        Color RGB(100, 220, 255)                        ' hellblau Wasser
        PBox 538 * fx, 474 * fy + 1, 614 * fx, 474 * fy + 1 - (i% - 47 * fy)
        voll| = 1   ' Zylinder gefüllt, mit Luftblase
      Else If ansaugen| = 2  And klemme_br| < 2    ' keine Luft im Zylinder
        If i% = 0
          Color RGB(100, 220, 255)                        ' hellblau Wasser
          PBox 571 * fx, 798 * fy, 581 * fx, 475 * fy  ' Steigrohr
        EndIf
        Color RGB(100, 220, 255)                        ' hellblau Wasser
        PBox 538 * fx, 474 * fy + 1, 614 * fx, 474 * fy + 1 - i%
        voll| = 2   ' Zylinder gefüllt, ohne Luftblase
      Else If ansaugen| = 0  ' kein Ansaugen aus dem Brunnen möglich
        Color RGB(255, 255, 255)                      ' weiß
        PBox 538 * fx, 474 * fy + 1, 614 * fx, 474 * fy + 1 - i%    ' Luft
      EndIf
      DefLine 0, 1
      Color RGB(130, 130, 130)                        ' grau
      PBox 569 * fx, 220 * fy, 583 * fx, 221 * fy - i%     ' Kolbenstange
      verzoegerung(20 / fx)
    Next i%
    unten| = 0  ' Kolben oben
    If ansaugen| > 0 And schlauch_t_br| = 2 And klemme_br| < 2
      Get 546 * fx, 670 * fx, 606 * fx, 690 * fy, klemm_br$  ' Hintergrund der Klemme_Br zum späteren Wiederherstellen
    EndIf
  EndIf
  If schlauch_t_br| = 2 And schlauch_t| = 2 And klemme_br| < 2 And klemme_h| < 2
    alert1("Weil die Pumpe durch das offene Ende des T-Stücks leichte Luft ansaugen kann,", "bleibt das viel schwerere Wasser im Brunnen.")
  EndIf
Return
>Procedure nachunten              ' Kolben nach unten _X = 1024 oder 1152
  If schlauch_br| = 2 Or schlauch_t_br| = 2 And klemme_h| = 2
    If voll| = 0
      DefLine 0, 1
      Color RGB(255, 255, 255)            '  weiß
      PBox 571 * fx, 595 * fy, 581 * fx, 796 * fy  ' Schlauch innen
    EndIf
    Get 520 * fx, 600 * fy, 635 * fx, 830 * fy, jj$
  EndIf
  If klemme_h| = 2 And klemme_br| = 2
    alert2("Beide Ausgänge sind geschlossen. Der Kolben müsste Luft oder Wasser sehr stark", "zusammenpressen. Wenn du eine Spritze ohne Nadel hast, mache folgenden", "Versuch: Drücke die Spritze fest gegen deine Hand und drücke dann auf den Kolben!")
  Else   ' es sind nicht beide Klemmen gesetzt
    If schlauch_t_br| = 2 And klemme_h| = 2 Or schlauch_br| = 2 And fuellung| = 0       ' Pumpen durch geschlossenen Schlauch zurück in den Brunnen, noch Luft im Zylinder
      farbabfrage(576 * fx, 510 * fy)  ' Abfrage nach rot%: Leitung zum Brunnen voll oder leer?
    EndIf
    For i% = 0 To 188 * fy
      Color RGB(160, 50, 50)                           ' dunkelbraun
      PBox 538 * fx, Ceil(266 * fy) + i%, 614 * fx, Fix(286 * fy) + i%     ' Kolben
      If  voll| = 1 And (schlauch_t_br| = 2 And klemme_h| = 2 Or schlauch_br| = 2) And fuellung| = 0       ' Pumpen durch geschlossenen Schlauch zurück in den Brunnen, noch Luft im Zylinder
        If rot% < 230    ' Rohr ist mit Wasser gefüllt
          If i% < 141 * fy
            Color RGB(255, 255, 255)                      ' weiß
            PBox 538 * fx, 286 * fy + 47 * fy + i% , 614 * fx, Fix(287 * fy) + Fix(47 * fy) + i%    ' Luft im Kolben
          Else
            Color RGB(255, 255, 255)                      ' weiß
            PBox 571 * fx, 475 * fy, 581 * fx, 474 * fy + (i% - 142 * fy) * 7   ' Luft im Schlauch
          EndIf
        Else  '  Luft im Schlauch
          If i% < 141 * fy
            If i% < 8 * fy
              Color RGB(255, 255, 255)                      ' weiß
              PBox 571 * fx, 750 * fy, 581 * fx, 750 * fy + i% * 7   ' Luft im Schlauch
            Else
              DefLine 0, 0
              Color RGB(238, 255, 247)  ' Hintergrund
              PCircle 576 * fx, 803 * fy, 8 * fx
              If i% < 49 * fy
                PCircle 596 * fx + Rand(25 * fx) , 800 * fy - Rand(i%) / 1.5, 6 * fx - Rand(3 * fx)
                PCircle 556 * fx - Rand(25 * fx) , 800 * fy - Rand(i%) / 1.5, 6 * fx - Rand(3 * fx)
                If i% > 18 * fy
                  PCircle 596 * fx + Rand(25 * fx) , 785 * fy - Rand(i%) / 2, 6 * fx - Rand(3 * fx)
                  PCircle 556 * fx - Rand(25 * fx) , 785 * fy - Rand(i%) / 2, 6 * fx - Rand(3 * fx)
                EndIf
                If i% > 18 * fy
                  PCircle 596 * fx + Rand(25 * fx) , 770 * fy - Rand(i%) / 2.5, 6 * fx - Rand(3 * fx)
                  PCircle 556 * fx - Rand(25 * fx) , 770 * fy - Rand(i%) / 2.5, 6 * fx - Rand(3 * fx)
                EndIf
                If i% > 28 * fy
                  PCircle 596 * fx + Rand(25 * fx) , 755 * fy - Rand(i%) / 3, 6 * fx - Rand(3 * fx)
                  PCircle 556 * fx - Rand(25 * fx) , 755 * fy - Rand(i%) / 3, 6 * fx - Rand(3 * fx)
                EndIf
              Else
                Color RGB(100, 220, 255) ' hellblau Wasser
                PCircle 596 * fx + Rand(30 * fx) , 800 * fy - Rand(i% - 64 * fy) / 1.7, 6 * fx - Rand(3 * fx)
                PCircle 556 * fx - Rand(30 * fx) , 800 * fy - Rand(i% - 64 * fy) / 1.7, 6 * fx - Rand(3 * fx)
                PCircle 596 * fx + Rand(30 * fx) , 800 * fy - Rand(i% - 54 * fy) / 1.6, 6 * fx - Rand(3 * fx)
                PCircle 556 * fx - Rand(30 * fx) , 800 * fy - Rand(i% - 54 * fy) / 1.6, 6 * fx - Rand(3 * fx)
              EndIf
              PCircle 576 * fx + Rand(25 * fx) - Rand(25 * fx), 800 * fy + Rand(15 * fy) , 6 * fx - Rand(3 * fx)
              PCircle 581 * fx + Rand(25 * fx), 800 * fy + Rand(15 * fy) , 6 * fx - Rand(3 * fx)
              PCircle 571 * fx - Rand(25 * fx) , 800 * fy + Rand(15 * fy) , 6 * fx - Rand(3 * fx)
            EndIf
            Color RGB(255, 255, 255)                      ' weiß
            PBox 538 * fx, 286 * fy + 47 * fy + i% , 614 * fx, Fix(287 * fy) + Fix(47 * fy) + i%    ' Luft im Kolben
            Color RGB(100, 220, 255)                        ' hellblau Wasser
            PBox 571 * fx, 475 * fy, 581 * fx, 474 * fy + i% * 7   ' Schlauch zum Brunnen
          Else
            DefLine 0, 0
            Color RGB(100, 220, 255)                        ' hellblau Wasser
            PCircle 596 * fx + Rand(30 * fx) , 800 * fy - Rand((i% - 135 * fy)), 8 * fx
            PCircle 556 * fx - Rand(30 * fx) , 800 * fy - Rand((i% - 135 * fy)) , 8 * fx
            PCircle 576 * fx + Rand(25 * fx) , 800 * fy + Rand(15 * fx) , 6 * fx
            PCircle 576 * fx - Rand(25 * fx) , 800 * fy + Rand(15 * fx) , 6 * fx
            verzoegerung(1 / fx)
            If i% => Int(188 * fy)
              Put 520 * fx, 600 * fy, jj$
            EndIf
            Color RGB(255, 255, 255)                      ' weiß
            PBox 571 * fx, 475 * fy, 581 * fx, 474 * fy + (i% - 142 * fy) * 7   ' Luft im Schlauch
          EndIf
        EndIf
      Else If voll| = 1 And schlauch_h| < 2 And schlauch_br| < 2 And klemme_h| < 2 And klemme_br| < 2 ' Pumpen ohne Schlauch oder durch offenen Schlauch zurück in den Brunnen
        If i% < 47 * fy
          DefLine 0, Fix(11 * fx)
          Color RGB(100, 220, 255)                        ' hellblau Wasser
          Line 576 * fx, 480 * fy + i%, 576 * fx, 495 * fy + i% * 7
        EndIf
        If i% < 141 * fy
          DefLine 0, 1
          Color RGB(255, 255, 255)                      ' weiß
          PBox 538 * fx, 286 * fy + 47 * fy + i% , 614 * fx, Fix(287 * fy) + Fix(47 * fy) + i%    ' Luft im Kolben
        Else If i% < 174 * fx
          Color RGB(238, 255, 247)  ' Hintergrund
          DefLine 0, 1
          PBox 571 * fx, 475 * fy , 581 * fx, 493 * fy + (i% - 141 * fx) * 8
        EndIf
      Else  If voll| = 1 And schlauch_h| = 2  ' Pumpe voll, mit Luftblase, Schlauch zum Hochbehälter angeschlossen
        If i% < 141 * fy
          DefLine 0, 1
          Color RGB(255, 255, 255)                      ' weiß
          PBox 538 * fx, 286 * fy + 47 * fy + i% , 614 * fx, Fix(287 * fy) + Fix(47 * fy) + i%    ' Luft im Kolben
        EndIf
        DefLine 0, Fix(11 * fx)
        Color RGB(100, 220, 255)                        ' hellblau Wasser
        If i% < 16 * fy
          Line 576 * fx, 480 * fy + i%, 576 * fx, 489 * fy + i% * 7  ' Schläuche zum Hochbehälter
          If i% = 16 * fy - 1
            Line 576 * fx, 580 * fy, 576 * fx, 600 * fy
          EndIf
        Else If i% < 49 * fy
          Line Ceil(574 * fx) - (i% - 16 * fy) * 7, 600 * fy, 576 * fx, 600 * fy
        Else If i% < 131 * fy
          Line 350 * fx, 600 * fy, 350 * fx, Ceil(597 * fy) - Fix(i% - 49 * fy) * 7
        Else If i% < 146 * fy
          Line 349 * fx - (i% - 131 * fy) * 7,  30 * fy, 350 * fx, 30 * fy
        Else If  i% < 171 * fy
          Line 250 * fx,  30 * fy, 250 * fx, 35 * fy + (i% - 146 * fy) * 7
        EndIf
        If i% = Int(173 * fy) Or i% = Int(176 * fy) Or i% = Int(179 * fy) Or i% = Int(182 * fy) Or i% = Int(185 * fy) Or i% = Int(188 * fy)
          DefLine 0, 1
          PBox 62 * fx,  209 * fy, 288 * fx, 209 * fy - (i% - 170 * fy) / 3  ' Wasser im Hochbehälter
        EndIf
        If i% > 141 * fy And i% < 157 * fy
          DefLine 0, 1
          Color RGB(255, 255, 255)  ' weiß
          PBox 571 * fx, 475 * fy, 581 * fx, 482 * fy  ' Luft in Schläuche zum Hochbehälter
          DefLine 0, Fix(11 * fx)
          Line 576 * fx, 480 * fy, 576 * fx, 492 * fy + (i% - 141 * fy) * 7
        Else If i% > 156 * fy
          Color RGB(255, 255, 255)  ' weiß
          DefLine 0, Fix(11 * fx)
          Line 574 * fx - (i% - 157 * fy) * 7, 600 * fy, 576 * fx, 600 * fy
          If i% > 166 * fx
            Line 250 * fx,  50 * fy, 250 * fx, 49 * fy + (i% - 166 * fy) * 7  ' Abdeckung: Wasser in den Hochbehälter
          EndIf
        EndIf
      Else If voll| = 1 And schlauch_t| = 2 And schlauch_t_br| = 2 And schlauch_t_h = 2 And klemme_br| = 2 And klemme_h < 2 ' Pumpe voll, Schläuche und T-Stück richtig angeschlossen
        If i% < 141 * fy
          Color RGB(255, 255, 255)                      ' weiß
          PBox 538 * fx, 286 * fy + 47 * fy + i% , 614 * fx, Fix(287 * fy) + Fix(47 * fy) + i%    ' Luft im Kolben
        EndIf
        Color RGB(100, 220, 255)                        ' hellblau Wasser
        DefLine 0, Fix(11 * fx)
        If i% = 0
          Line 576 * fx, 480 * fy, 576 * fx, 600 * fy  ' Schläuche zum Hochbehälter
        EndIf
        If i% < 33 * fy
          If _X = 1024
            Line 574 * fx - i% * 6.8, 600 * fy, 576 * fx, 600 * fy  ' Schläuche zum Hochbehälter
          Else
            Line 576 * fx - i% * 7, 600 * fy, 576 * fx, 600 * fy
          EndIf
        Else If i% < 115 * fy
          If _X = 1024
            Line 350 * fx, 600 * fy, 350 * fx, 598 * fy - (i% - 33 * fy) * 6.9
          Else
            Line 350 * fx, 600 * fy, 350 * fx, 600 * fy - (i% - 33 * fy) * 7
          EndIf
        Else If i% < 130 * fy
          Line 348 * fx - Fix(i% - 115 * fy) * 7,  30 * fy, 350 * fx, 30 * fy
        Else If  i% < 141 * fy
          Line 250 * fx,  30 * fy, 250 * fx, 33 * fy + (i% - 130 * fy) * 7
        Else If i% > 141 * fy And i% < Fix(143 * fy)
          DefLine 0, 1
          PBox 62 * fx,  209 * fy, 288 * fx, 205 * fy  ' Wasser im Hochbehälter
          DefLine 0, Fix(11 * fx)
          Color RGB(255, 255, 255)  ' weiß
          Line 250 * fx,  50 * fy, 250 * fx, 200 * fy
          Get 525 * fx, 469 * fy, 537 * fx, 474 * fy, j$ ' Öffnung zum Luftablassen
          If klemme_h| < 2
            Get 482 * fx, 570 * fx, 502 * fx, 630 * fy, klemm_h$  ' Hintergrund der Klemme_H zum späteren Wiederherstellen
          EndIf
          verzoegerung(1500)
          alert2("Gut: Du hast die Klemmen richtig benutzt. Jetzt wird die Luft aus dem Zylinder", "durch eine kleine Öffnung entfernt, damit die Pumpe ganz mit Wasser", "gefüllt werden kann.")
          verzoegerung(400)
          DefLine 0, 1
          Color RGB(255, 255, 255)  ' weiß
          PBox 525 * fx, 469 * fy, 537 * fx, 474 * fy  ' Öffnung zur Entlüftung
          fuellung| = 1  ' keine Luft mehr im Zylinder
          ansaugen| = 2  ' Ansaugen ohne Luftblase
          wasserstand_h% = 205 * fy  ' Wasserstand im Hochbehälter nach der ersten Füllung
        EndIf
      Else If voll| = 2 And ((klemme_h| < 2 And klemme_br| = 2) Or schlauch_h| = 2)
        Color RGB(100, 220, 255)                        ' hellblau Wasser
        DefLine 0, Fix(11 * fx)
        If i% = 0
          Line 576 * fx, 480 * fy, 576 * fx, 600 * fy  ' Schläuche zum Hochbehälter
        EndIf
        If  i% < 22 * fy
          Line 250 * fx,  30 * fy, 250 * fx, 33 * fy + i% * 8  ' Wasserfluss in den Hochbehälter
        Else If i% > 178 * fy
          If 49 * fy + (i% - 178 * fy) * 8 < wasserstand_h% - i% / 3
            Color RGB(255, 255, 255)  ' weiß
            Line 250 * fx,  50 * fy, 250 * fx, 49 * fy + (i% - 178 * fy) * 8  ' Abdeckung: Wasser in den Hochbehälter
          EndIf
        EndIf
        If Mod(i%, 3) = 0 And i% > 5 * fy
          DefLine 0, 1
          Color RGB(100, 220, 255)                        ' hellblau Wasser
          PBox 62 * fx,  209 * fy, 288 * fx, wasserstand_h% - i% / 3  ' Wasser im Hochbehälter
        EndIf
        If i% = Int(188 * fy)
          DefLine 0, 1
          Color RGB(255, 255, 255)  ' weiß
          PBox 245 * fx,  55 * fy, 255 * fx, wasserstand_h% - i% / 3 + 1  ' Abdeckung: Wasser in den Hochbehälter
        EndIf
        If wasserstand_h% - i% / 3 <= 60 * fy
          DefLine 0, Fix(11 * fx)
          Color RGB(255, 255, 255)  ' weiß
          Line 250 * fx,  50 * fy, 250 * fx, 53 * fy  ' Abdeckung: Wasser in den Hochbehälter
          DefLine 0, 1
          Color RGB(250, 254, 253)
          PBox 240 * fx, 55 * fy, 260 * fx, 60 * fy  ' Abdeckung Wasser in den Hochbehälter
          alert2("Sehr gut: Du hast den Hochbehälter gefüllt.", "Der Fühler oben links im Hochbehälter hat die Pumpe abgeschaltet,", "damit das Wasser nicht überläuft.")
          Repeat
            PeekEvent
          Until MouseK = 0
          fertig| = 1
          GoTo weiter1
        EndIf
        fuellung| = 1  ' keine Luft mehr im Zylinder
        ansaugen| = 2  ' Ansaugen ohne Luftblase
      Else If voll| = 2 And klemme_br| < 2  ' keine Klemme Richtung Brunnen vorhanden
        If i% < 47 * fy
          DefLine 0, Fix(11 * fx)
          Color RGB(100, 220, 255)                        ' hellblau Wasser
          Line 576 * fx, 480 * fy + i%, 576 * fx, 495 * fy + i% * 7
        EndIf
      Else If voll| = 0 And schlauch_br| = 2 Or schlauch_t_br| = 2 And klemme_h| = 2   ' Zylinder leer, Schlauch zum Brunnen
        DefLine 0, 0
        Color RGB(238, 255, 247)  ' Hintergrund
        PCircle 576 * fx, 803 * fy, 8 * fx
        If i% < 94 * fy
          PCircle 592 * fx + Rand(26 * fx) , 806 * fy - Rand(i%), 6 * fx - Rand(3 * fx)
          PCircle 560 * fx - Rand(26 * fx) , 806 * fy - Rand(i%), 6 * fx - Rand(3 * fx)
          If i% > 10 * fy
            PCircle 592 * fx + Rand(21 * fx) , 800 * fy - Rand(i%) / 1.5, 8 * fx - Rand(3 * fx)
            PCircle 560 * fx - Rand(21 * fx) , 800 * fy - Rand(i%) / 1.5, 8 * fx - Rand(3 * fx)
          EndIf
          If i% > 25 * fy
            PCircle 592 * fx + Rand(23 * fx) , 800 * fy - Rand(i%) / 2, 6 * fx - Rand(3 * fx)
            PCircle 560 * fx - Rand(23 * fx) , 800 * fy - Rand(i%) / 2, 6 * fx - Rand(3 * fx)
          EndIf
          If i% > 40 * fy
            PCircle 592 * fx + Rand(26 * fx) , 800 * fy - Rand(i%) / 3, 8 * fx - Rand(3 * fx)
            PCircle 560 * fx - Rand(26 * fx) , 800 * fy - Rand(i%) / 3, 8 * fx - Rand(3 * fx)
          EndIf
        Else
          PCircle 594 * fx + Rand(28 * fx) , 803 * fy - Rand(i% - 95 * fy), 6 * fx - Rand(3 * fx)
          PCircle 558 * fx - Rand(28 * fx) , 803 * fy - Rand(i% - 95 * fy), 6 * fx - Rand(3 * fx)
        EndIf
        PCircle 579 * fx + Rand(28 * fx), 800 * fy + Rand(20 * fy) , 6 * fx - Rand(3 * fx)
        PCircle 573 * fx - Rand(28 * fx) , 800 * fy + Rand(20 * fy) , 6 * fx - Rand(3 * fx)
      EndIf
      DefLine 0, 1
      Color RGB(255, 255, 255)                        ' weiß
      PBox 538 * fx, Ceil(266 * fy), 568 * fx, 265 * fy + i%    ' Luft neben Kolbenstange
      PBox 584 * fx, Ceil(266 * fy), 614 * fx, 265 * fy + i%    ' Luft neben Kolbenstange
      Color RGB(130, 130, 130)                        ' grau
      PBox 569 * fx, Ceil(266 * fy), 583 * fx, 265 * fy + i%     ' Kolbenstange
      Color RGB(244, 255, 251)                        ' heller Hintergrund
      PBox 569 * fx, 32 * fy, 583 * fx, 32 * fy + i%         ' Luft über Kolbenstange
      verzoegerung(20 / fx)
    Next i%
    Put 525 * fx, 469 * fy, j$
    Clr j$
    If schlauch_t_br| = 2 And klemme_h| < 2  ' Wasser steigt im offenen Rohr bis zum Wasserspiegel des Brunnens
      Color RGB(100, 220, 255)                        ' hellblau Wasser
      PBox 571 * fx, 750 * fy, 581 * fx, 796 * fy   ' Schlauch zum Brunnen
    EndIf
    If voll| = 0 And (schlauch_br| = 2 Or (schlauch_t_br| = 2 And klemme_h| = 2))
      For i% = 0 To 100
        DefLine 0, 0
        Color RGB(100, 220, 255)                        ' hellblau Wasser
        PCircle 596 * fx + Rand(30 * fx) , 800 * fy - Rand(i% / 1.5), 6 * fx - Rand(3 * fx)
        PCircle 556 * fx - Rand(30 * fx) , 800 * fy - Rand(i% / 1.5) , 6 * fx - Rand(3 * fx)
        PCircle 596 * fx + Rand(30 * fx) , 800 * fy + Rand(20 * fx) , 6 * fx - Rand(3 * fx)
        PCircle 556 * fx - Rand(30 * fx) , 800 * fy + Rand(20 * fx) , 6 * fx - Rand(3 * fx)
        PCircle 576 * fx - Rand(30 * fx) , 800 * fy + Rand(20 * fx) , 6 * fx - Rand(3 * fx)
        verzoegerung(1 / fx)
      Next i%
      Put 520 * fx, 600 * fy, jj$
    EndIf
    If voll| = 2 And klemme_h| < 2 And klemme_br| = 2
      wasserstand_h% = wasserstand_h% - i% / 3  ' Wasserstand im Hochbehälter
    EndIf
    If voll| = 2 And klemme_h| < 2 And klemme_br| < 2 ' keine Klemme vorhanden
      For i% = 0 To 34 * fx
        DefLine 0, 1
        Color RGB(238, 255, 247)  ' Hintergrund
        PBox 571 * fx, 475 * fy , 581 * fx, 477 * fy + i% * 8
        verzoegerung(20 / fx)
      Next i%
    EndIf
    If voll| = 1 And schlauch_h = 2                        ' Pumpe voll, Schlauch zum Hochbehälter angeschlossen
      Color RGB(100, 220, 255)                ' hellblau Wasser
      DefLine 0, 1
      PBox 62 * fx,  209 * fy, 288 * fx, 209 * fy - (i% - 170 * fy) / 3  ' Wasser im Hochbehälter
      Repeat
        PeekEvent
      Until MouseK = 0
      Repeat
        PeekEvent
        j$ = InKey$
        Mouse x, y, k%
      Until k% <> 0 Or j$ <> ""
      alert2("Gut : Du konntest Wasser in den Hochbehälter pumpen.", "Versuche jetzt, das laufende Wechseln der Schläuche zu vermeiden.", "Das geht, wenn du das T-Stück und eine Klemme benutzt.")
      schlauch_br| = 1
      schlauch_h| = 1
      schlauch_t| = 0
      schlauch_t_br| = 0
      schlauch_t_h| = 0
      t_stueck| = 1
      ansaugen| = 0
      fuellung| = 0
      Put 0, 0, bild$
    EndIf
    If (voll| = 1 Or voll| = 2) And schlauch_h| < 2 And schlauch_br| < 2 And schlauch_t_br| < 2 ' Pumpe voll, kein Schlauch, kein T-Stück angeschlossen
      Color RGB(238, 255, 247)  ' Hintergrund
      DefLine 0, Fix(11 * fx)
      For i% = 1 To 20
        Line 576 * fx, 480 * fy + i%, 576 * fx, 495 * fy + i% * 7
      Next i%
      Put 571 * fx, 475 * fy, luft_zyl_br$
    EndIf
    voll| = 0  ' Zylinder leer
    unten| = 1  ' Kolben unten
  EndIf
  weiter1:
  Clr jj$
Return
>Procedure nachunten800         ' Kolben nach unten _X = 800
  If schlauch_br| = 2 Or schlauch_t_br| = 2 And klemme_h| = 2
    If voll| = 0
      DefLine 0, 1
      Color RGB(255, 255, 255)            '  weiß
      PBox 571 * fx, 595 * fy, 581 * fx, 796 * fy  ' Schlauch innen
    EndIf
    Get 520 * fx, 600 * fy, 635 * fx, 830 * fy, jj$
  EndIf
  If klemme_h| = 2 And klemme_br| = 2
    alert2("Beide Ausgänge sind geschlossen. Der Kolben müsste Luft oder Wasser sehr stark", "zusammenpressen. Wenn du eine Spritze ohne Nadel hast, mache folgenden", "Versuch: Drücke die Spritze fest gegen deine Hand und drücke dann auf den Kolben!")
  Else   ' es sind nicht beide Klemmen gesetzt
    If schlauch_t_br| = 2 And klemme_h| = 2 Or schlauch_br| = 2 And fuellung| = 0       ' Pumpen durch geschlossenen Schlauch zurück in den Brunnen, noch Luft im Zylinder
      farbabfrage(576 * fx, 510 * fy)  ' Abfrage nach rot%: Leitung zum Brunnen voll oder leer?
    EndIf
    For i% = 0 To 188 * fy
      Color RGB(160, 50, 50)                           ' dunkelbraun
      PBox 538 * fx, Ceil(266 * fy) + i%, 614 * fx, Fix(286 * fy) + i%     ' Kolben
      If  voll| = 1 And (schlauch_t_br| = 2 And klemme_h| = 2 Or schlauch_br| = 2) And fuellung| = 0       ' Pumpen durch geschlossenen Schlauch zurück in den Brunnen, noch Luft im Zylinder
        If rot% < 230    ' Rohr ist mit Wasser gefüllt
          If i% < 142 * fy
            Color RGB(255, 255, 255)                      ' weiß
            PBox 538 * fx, 286 * fy + 47 * fy + i% , 614 * fx, Fix(287 * fy) + Fix(47 * fy) + i%    ' Luft im Kolben
          Else
            Color RGB(255, 255, 255)                      ' weiß
            PBox 571 * fx, 475 * fy, 581 * fx, 470 * fy + (i% - 142 * fy) * 7   ' Luft im Schlauch
          EndIf
        Else  '  Luft im Schlauch
          If i% < 142 * fy
            If i% < 8 * fy
              Color RGB(255, 255, 255)                      ' weiß
              PBox 571 * fx, 750 * fy, 581 * fx, 747 * fy + i% * 7   ' Luft im Schlauch
            Else
              DefLine 0, 0
              Color RGB(238, 255, 247)  ' Hintergrund
              PCircle 576 * fx, 803 * fy, 8 * fx
              If i% < 49 * fy
                PCircle 596 * fx + Rand(25 * fx) , 800 * fy - Rand(i%) / 1.5, 6 * fx - Rand(3 * fx)
                PCircle 556 * fx - Rand(25 * fx) , 800 * fy - Rand(i%) / 1.5, 6 * fx - Rand(3 * fx)
                If i% > 18 * fy
                  PCircle 596 * fx + Rand(25 * fx) , 785 * fy - Rand(i%) / 2, 6 * fx - Rand(3 * fx)
                  PCircle 556 * fx - Rand(25 * fx) , 785 * fy - Rand(i%) / 2, 6 * fx - Rand(3 * fx)
                EndIf
                If i% > 18 * fy
                  PCircle 596 * fx + Rand(25 * fx) , 770 * fy - Rand(i%) / 2.5, 6 * fx - Rand(3 * fx)
                  PCircle 556 * fx - Rand(25 * fx) , 770 * fy - Rand(i%) / 2.5, 6 * fx - Rand(3 * fx)
                EndIf
                If i% > 28 * fy
                  PCircle 596 * fx + Rand(25 * fx) , 755 * fy - Rand(i%) / 3, 6 * fx - Rand(3 * fx)
                  PCircle 556 * fx - Rand(25 * fx) , 755 * fy - Rand(i%) / 3, 6 * fx - Rand(3 * fx)
                EndIf
              Else
                Color RGB(100, 220, 255) ' hellblau Wasser
                PCircle 596 * fx + Rand(30 * fx) , 800 * fy - Rand(i% - 64 * fy) / 1.7, 6 * fx - Rand(3 * fx)
                PCircle 556 * fx - Rand(30 * fx) , 800 * fy - Rand(i% - 64 * fy) / 1.7, 6 * fx - Rand(3 * fx)
                PCircle 596 * fx + Rand(30 * fx) , 800 * fy - Rand(i% - 54 * fy) / 1.6, 6 * fx - Rand(3 * fx)
                PCircle 556 * fx - Rand(30 * fx) , 800 * fy - Rand(i% - 54 * fy) / 1.6, 6 * fx - Rand(3 * fx)
              EndIf
              PCircle 576 * fx + Rand(25 * fx) - Rand(25 * fx), 800 * fy + Rand(15 * fy) , 6 * fx - Rand(3 * fx)
              PCircle 581 * fx + Rand(25 * fx), 800 * fy + Rand(15 * fy) , 6 * fx - Rand(3 * fx)
              PCircle 571 * fx - Rand(25 * fx) , 800 * fy + Rand(15 * fy) , 6 * fx - Rand(3 * fx)
            EndIf
            Color RGB(255, 255, 255)                      ' weiß
            PBox 538 * fx, 286 * fy + 47 * fy + i% , 614 * fx, Fix(287 * fy) + Fix(47 * fy) + i%    ' Luft im Kolben
            Color RGB(100, 220, 255)                        ' hellblau Wasser
            PBox 571 * fx, 475 * fy, 581 * fx, 471 * fy + i% * 7   ' Luft im Schlauch
          Else
            DefLine 0, 0
            Color RGB(100, 220, 255)                        ' hellblau Wasser
            PCircle 596 * fx + Rand(30 * fx) , 800 * fy - Rand((i% - 135 * fy)), 8 * fx
            PCircle 556 * fx - Rand(30 * fx) , 800 * fy - Rand((i% - 135 * fy)) , 8 * fx
            PCircle 576 * fx + Rand(25 * fx) , 800 * fy + Rand(15 * fx) , 6 * fx
            PCircle 576 * fx - Rand(25 * fx) , 800 * fy + Rand(15 * fx) , 6 * fx
            verzoegerung(1 / fx)
            If i% >= 188 * fy
              Put 520 * fx, 600 * fy, jj$
            EndIf
            Color RGB(255, 255, 255)                      ' weiß
            PBox 571 * fx, 475 * fy, 581 * fx, 470 * fy + (i% - 142 * fy) * 7   ' Luft im Schlauch
          EndIf
        EndIf
      Else If voll| = 1 And schlauch_h| < 2 And schlauch_br| < 2 And klemme_h| < 2 And klemme_br| < 2 ' Pumpen ohne Schlauch oder durch offenen Schlauch zurück in den Brunnen
        If i% < 47 * fy
          DefLine 0, Fix(11 * fx)
          Color RGB(100, 220, 255)                        ' hellblau Wasser
          Line 576 * fx, 480 * fy + i%, 576 * fx, 495 * fy + i% * 7
        EndIf
        If i% < 142 * fy
          DefLine 0, 1
          Color RGB(255, 255, 255)                      ' weiß
          PBox 538 * fx, 286 * fy + 47 * fy + i% , 614 * fx, Fix(287 * fy) + Fix(47 * fy) + i%    ' Luft im Kolben
        Else If i% < 174 * fx
          Color RGB(238, 255, 247)  ' Hintergrund
          DefLine 0, 1
          PBox 571 * fx, 475 * fy , 581 * fx, 494 * fy + (i% - 141 * fx) * 8
        EndIf
      Else  If voll| = 1 And schlauch_h| = 2  ' Pumpe voll, mit Luftblase, Schlauch zum Hochbehälter angeschlossen
        If i% < 142 * fy
          DefLine 0, 1
          Color RGB(255, 255, 255)                      ' weiß
          PBox 538 * fx, 286 * fy + 47 * fy + i% , 614 * fx, Fix(287 * fy) + Fix(47 * fy) + i%    ' Luft im Kolben
        EndIf
        DefLine 0, Fix(11 * fx)
        Color RGB(100, 220, 255)                        ' hellblau Wasser
        If i% < 16 * fy
          Line 576 * fx, 480 * fy + i%, 576 * fx, 489 * fy + i% * 7  ' Schläuche zum Hochbehälter
          If i% = 16 * fy - 1
            Line 576 * fx, 580 * fy, 576 * fx, 600 * fy
          EndIf
        Else If i% < 48 * fy
          Line Ceil(574 * fx) - (i% - 16 * fy) * 7, 600 * fy, 576 * fx, 600 * fy
        Else If i% < 132 * fy
          Line 350 * fx, 600 * fy, 350 * fx, Ceil(597 * fy) - Fix(i% - 49 * fy) * 7
        Else If i% < 146 * fy
          Line 352 * fx - (i% - 131 * fy) * 7,  30 * fy, 350 * fx, 30 * fy
        Else If  i% < 171 * fy
          Line 250 * fx,  30 * fy, 250 * fx, 35 * fy + (i% - 146 * fy) * 7
        EndIf
        If i% = Int(173 * fy) Or i% = Int(176 * fy) Or i% = Int(179 * fy) Or i% = Int(182 * fy) Or i% = Int(185 * fy) Or i% = Int(188 * fy)
          DefLine 0, 1
          PBox 62 * fx,  209 * fy, 288 * fx, 209 * fy - (i% - 170 * fy) / 3  ' Wasser im Hochbehälter
        EndIf
        If i% > 142 * fy And i% < 157 * fy
          DefLine 0, 1
          Color RGB(255, 255, 255)  ' weiß
          PBox 571 * fx, 475 * fy, 581 * fx, 482 * fy  ' Luft in Schläuche zum Hochbehälter
          DefLine 0, Fix(11 * fx)
          Line 576 * fx, 480 * fy, 576 * fx, 489 * fy + (i% - 141 * fy) * 7
        Else If i% > 156 * fy
          Color RGB(255, 255, 255)  ' weiß
          DefLine 0, Fix(11 * fx)
          Line 574 * fx - (i% - 157 * fy) * 7, 600 * fy, 576 * fx, 600 * fy
          If i% > 166 * fx
            Line 250 * fx,  50 * fy, 250 * fx, 45 * fy + (i% - 166 * fy) * 7  ' Abdeckung: Wasser in den Hochbehälter
          EndIf
        EndIf
      Else If voll| = 1 And schlauch_t| = 2 And schlauch_t_br| = 2 And schlauch_t_h = 2 And klemme_br| = 2 And klemme_h < 2 ' Pumpe voll, Schläuche und T-Stück richtig angeschlossen
        If i% < 142 * fy
          Color RGB(255, 255, 255)                      ' weiß
          PBox 538 * fx, 286 * fy + 47 * fy + i% , 614 * fx, Fix(287 * fy) + Fix(47 * fy) + i%    ' Luft im Kolben
        EndIf
        Color RGB(100, 220, 255)                        ' hellblau Wasser
        DefLine 0, Fix(11 * fx)
        If i% = 0
          Line 576 * fx, 480 * fy, 576 * fx, 600 * fy  ' Schläuche zum Hochbehälter
        EndIf
        If i% < 33 * fy
          Line 575 * fx - i% * 7, 600 * fy, 576 * fx, 600 * fy  ' Schläuche zum Hochbehälter
        Else If i% < 115 * fy
          Line 350 * fx, 600 * fy, 350 * fx, 598 * fy - Fix(i% - 33 * fy) * 7
        Else If i% < 130 * fy
          Line 350 * fx - Fix(i% - 115 * fy) * 6.7,  30 * fy, 350 * fx, 30 * fy
        Else If  i% < 141 * fy
          Line 250 * fx,  30 * fy, 250 * fx, 35 * fy + (i% - 130 * fy) * 7
        Else If i% > 142 * fy And i% < Ceil(143 * fy)
          DefLine 0, 1
          PBox 62 * fx,  209 * fy, 288 * fx, 205 * fy  ' Wasser im Hochbehälter
          DefLine 0, Fix(11 * fx)
          Color RGB(255, 255, 255)  ' weiß
          Line 250 * fx,  50 * fy, 250 * fx, 200 * fy
          Get 525 * fx, 469 * fy, 537 * fx, 474 * fy, j$ ' Öffnung zum Luftablassen
          If klemme_h| < 2
            Get 482 * fx, 570 * fx, 502 * fx, 630 * fy, klemm_h$  ' Hintergrund der Klemme_H zum späteren Wiederherstellen
          EndIf
          verzoegerung(1500)
          alert2("Gut: Du hast die Klemmen richtig benutzt. Jetzt wird die Luft aus dem Zylinder", "durch eine kleine Öffnung entfernt, damit die Pumpe ganz mit Wasser", "gefüllt werden kann.")
          verzoegerung(400)
          DefLine 0, 1
          Color RGB(255, 255, 255)  ' weiß
          PBox 525 * fx, 469 * fy, 537 * fx, 474 * fy  ' Öffnung zur Entlüftung
          fuellung| = 1  ' keine Luft mehr im Zylinder
          ansaugen| = 2  ' Ansaugen ohne Luftblase
          wasserstand_h% = 205 * fy  ' Wasserstand im Hochbehälter nach der ersten Füllung
        EndIf
      Else If voll| = 2 And ((klemme_h| < 2 And klemme_br| = 2) Or schlauch_h| = 2)
        Color RGB(100, 220, 255)                        ' hellblau Wasser
        DefLine 0, Fix(11 * fx)
        If i% = 0
          Line 576 * fx, 480 * fy, 576 * fx, 600 * fy  ' Schläuche zum Hochbehälter
        EndIf
        If  i% < 22 * fy
          Line 250 * fx,  30 * fy, 250 * fx, 30 * fy + i% * 8  ' Wasserfluss in den Hochbehälter
        Else If i% > 178 * fy
          If 49 * fy + (i% - 178 * fy) * 8 < wasserstand_h% - i% / 3
            Color RGB(255, 255, 255)  ' weiß
            Line 250 * fx,  50 * fy, 250 * fx, 50 * fy + (i% - 178 * fy) * 8  ' Abdeckung: Wasser in den Hochbehälter
          EndIf
        EndIf
        If Mod(i%, 3) = 0 And i% > 5 * fy
          DefLine 0, 1
          Color RGB(100, 220, 255)                        ' hellblau Wasser
          PBox 62 * fx,  209 * fy, 288 * fx, wasserstand_h% - i% / 3  ' Wasser im Hochbehälter
        EndIf
        If i% = Int(188 * fy)
          DefLine 0, 1
          Color RGB(255, 255, 255)  ' weiß
          PBox 245 * fx,  55 * fy, 255 * fx, wasserstand_h% - i% / 3  ' Abdeckung: Wasser in den Hochbehälter
        EndIf
        If wasserstand_h% - i% / 3 <= 60 * fy
          DefLine 0, Fix(11 * fx)
          Color RGB(255, 255, 255)  ' weiß
          Line 250 * fx,  50 * fy, 250 * fx, 53 * fy  ' Abdeckung: Wasser in den Hochbehälter
          DefLine 0, 1
          Color RGB(250, 254, 253)
          PBox 240 * fx, 55 * fy, 260 * fx, 60 * fy  ' Abdeckung Wasser in den Hochbehälter
          alert2("Sehr gut: Du hast den Hochbehälter gefüllt.", "Der Fühler oben links im Hochbehälter hat die Pumpe abgeschaltet,", "damit das Wasser nicht überläuft.")
          Repeat
            PeekEvent
          Until MouseK = 0
          fertig| = 1
          GoTo weiter1
        EndIf
        fuellung| = 1  ' keine Luft mehr im Zylinder
        ansaugen| = 2  ' Ansaugen ohne Luftblase
      Else If voll| = 2 And klemme_br| < 2  ' keine Klemme Richtung Brunnen vorhanden
        If i% < 47 * fy
          DefLine 0, Fix(11 * fx)
          Color RGB(100, 220, 255)                        ' hellblau Wasser
          Line 576 * fx, 480 * fy + i%, 576 * fx, 495 * fy + i% * 7
        EndIf
      Else If voll| = 0 And schlauch_br| = 2 Or schlauch_t_br| = 2 And klemme_h| = 2   ' Zylinder leer, Schlauch zum Brunnen
        DefLine 0, 0
        Color RGB(238, 255, 247)  ' Hintergrund
        PCircle 576 * fx, 803 * fy, 8 * fx
        If i% < 94 * fy
          PCircle 592 * fx + Rand(26 * fx) , 806 * fy - Rand(i%), 6 * fx - Rand(3 * fx)
          PCircle 560 * fx - Rand(26 * fx) , 806 * fy - Rand(i%), 6 * fx - Rand(3 * fx)
          If i% > 10 * fy
            PCircle 592 * fx + Rand(21 * fx) , 800 * fy - Rand(i%) / 1.5, 8 * fx - Rand(3 * fx)
            PCircle 560 * fx - Rand(21 * fx) , 800 * fy - Rand(i%) / 1.5, 8 * fx - Rand(3 * fx)
          EndIf
          If i% > 25 * fy
            PCircle 592 * fx + Rand(23 * fx) , 800 * fy - Rand(i%) / 2, 6 * fx - Rand(3 * fx)
            PCircle 560 * fx - Rand(23 * fx) , 800 * fy - Rand(i%) / 2, 6 * fx - Rand(3 * fx)
          EndIf
          If i% > 40 * fy
            PCircle 592 * fx + Rand(26 * fx) , 800 * fy - Rand(i%) / 3, 8 * fx - Rand(3 * fx)
            PCircle 560 * fx - Rand(26 * fx) , 800 * fy - Rand(i%) / 3, 8 * fx - Rand(3 * fx)
          EndIf
        Else
          PCircle 594 * fx + Rand(28 * fx) , 803 * fy - Rand(i% - 95 * fy), 6 * fx - Rand(3 * fx)
          PCircle 558 * fx - Rand(28 * fx) , 803 * fy - Rand(i% - 95 * fy), 6 * fx - Rand(3 * fx)
        EndIf
        PCircle 579 * fx + Rand(28 * fx), 800 * fy + Rand(20 * fy) , 6 * fx - Rand(3 * fx)
        PCircle 573 * fx - Rand(28 * fx) , 800 * fy + Rand(20 * fy) , 6 * fx - Rand(3 * fx)
      EndIf
      DefLine 0, 1
      Color RGB(255, 255, 255)                        ' weiß
      PBox 538 * fx, Ceil(266 * fy), 568 * fx, 265 * fy + i%    ' Luft neben Kolbenstange
      PBox 584 * fx, Ceil(266 * fy), 614 * fx, 265 * fy + i%    ' Luft neben Kolbenstange
      Color RGB(130, 130, 130)                        ' grau
      PBox 569 * fx, Ceil(266 * fy), 583 * fx, 265 * fy + i%     ' Kolbenstange
      Color RGB(244, 255, 251)                        ' heller Hintergrund
      PBox 569 * fx, 32 * fy, 583 * fx, 32 * fy + i%         ' Luft über Kolbenstange
      verzoegerung(20 / fx)
    Next i%
    Put 525 * fx, 469 * fy, j$
    Clr j$
    If schlauch_t_br| = 2 And klemme_h| < 2  ' Wasser steigt im offenen Rohr bis zum Wasserspiegel des Brunnens
      Color RGB(100, 220, 255)                        ' hellblau Wasser
      PBox 571 * fx, 750 * fy, 581 * fx, 796 * fy   ' Schlauch zum Brunnen
    EndIf
    If voll| = 0 And (schlauch_br| = 2 Or (schlauch_t_br| = 2 And klemme_h| = 2))
      For i% = 0 To 100
        DefLine 0, 0
        Color RGB(100, 220, 255)                        ' hellblau Wasser
        PCircle 596 * fx + Rand(30 * fx) , 800 * fy - Rand(i% / 1.5), 6 * fx - Rand(3 * fx)
        PCircle 556 * fx - Rand(30 * fx) , 800 * fy - Rand(i% / 1.5) , 6 * fx - Rand(3 * fx)
        PCircle 596 * fx + Rand(30 * fx) , 800 * fy + Rand(20 * fx) , 6 * fx - Rand(3 * fx)
        PCircle 556 * fx - Rand(30 * fx) , 800 * fy + Rand(20 * fx) , 6 * fx - Rand(3 * fx)
        PCircle 576 * fx - Rand(30 * fx) , 800 * fy + Rand(20 * fx) , 6 * fx - Rand(3 * fx)
        verzoegerung(1 / fx)
      Next i%
      Put 520 * fx, 600 * fy, jj$
    EndIf
    If voll| = 2 And klemme_h| < 2 And klemme_br| = 2
      wasserstand_h% = wasserstand_h% - i% / 3  ' Wasserstand im Hochbehälter
    EndIf
    If voll| = 2 And klemme_h| < 2 And klemme_br| < 2 ' keine Klemme vorhanden
      For i% = 0 To 34 * fx
        DefLine 0, 1
        Color RGB(238, 255, 247)  ' Hintergrund
        PBox 571 * fx, 475 * fy , 581 * fx, 477 * fy + i% * 8
        verzoegerung(20 / fx)
      Next i%
    EndIf
    If voll| = 1 And schlauch_h = 2                        ' Pumpe voll, Schlauch zum Hochbehälter angeschlossen
      Color RGB(100, 220, 255)                ' hellblau Wasser
      DefLine 0, 1
      PBox 62 * fx,  209 * fy, 288 * fx, 209 * fy - (i% - 170 * fy) / 3  ' Wasser im Hochbehälter
      Repeat
        PeekEvent
      Until MouseK = 0
      Repeat
        PeekEvent
        j$ = InKey$
        Mouse x, y, k%
      Until k% <> 0 Or j$ <> ""
      alert2("Gut : Du konntest Wasser in den Hochbehälter pumpen.", "Versuche jetzt, das laufende Wechseln der Schläuche zu vermeiden.", "Das geht, wenn du das T-Stück und eine Klemme benutzt.")
      schlauch_br| = 1
      schlauch_h| = 1
      schlauch_t| = 0
      schlauch_t_br| = 0
      schlauch_t_h| = 0
      t_stueck| = 1
      ansaugen| = 0
      fuellung| = 0
      Put 0, 0, bild$
    EndIf
    If (voll| = 1 Or voll| = 2) And schlauch_h| < 2 And schlauch_br| < 2 And schlauch_t_br| < 2 ' Pumpe voll, kein Schlauch, kein T-Stück angeschlossen
      Color RGB(238, 255, 247)  ' Hintergrund
      DefLine 0, Fix(11 * fx)
      For i% = 1 To 20
        Line 576 * fx, 480 * fy + i%, 576 * fx, 495 * fy + i% * 7
      Next i%
      Put 571 * fx, 475 * fy, luft_zyl_br$
    EndIf
    voll| = 0  ' Zylinder leer
    unten| = 1  ' Kolben unten
  EndIf
  weiter1:
  Clr jj$
Return
>Procedure nachunten1600       ' Kolben nach unten _X = 1600 oder 1280
  If schlauch_br| = 2 Or schlauch_t_br| = 2 And klemme_h| = 2
    If voll| = 0
      DefLine 0, 1
      Color RGB(255, 255, 255)            '  weiß
      PBox 571 * fx, 595 * fy, 581 * fx, 796 * fy  ' Schlauch innen
    EndIf
    Get 520 * fx, Ceil(500 * fy), 635 * fx, 830 * fy, jj$
  EndIf
  If klemme_h| = 2 And klemme_br| = 2
    alert2("Beide Ausgänge sind geschlossen. Der Kolben müsste Luft oder Wasser sehr stark", "zusammenpressen. Wenn du eine Spritze ohne Nadel hast, mache folgenden", "Versuch: Drücke die Spritze fest gegen deine Hand und drücke dann auf den Kolben!")
  Else   ' es sind nicht beide Klemmen gesetzt
    If schlauch_t_br| = 2 And klemme_h| = 2 Or schlauch_br| = 2 And fuellung| = 0       ' Pumpen durch geschlossenen Schlauch zurück in den Brunnen, noch Luft im Zylinder
      farbabfrage(576 * fx, 510 * fy)  ' Abfrage nach rot%: Leitung zum Brunnen voll oder leer?
    EndIf
    DefLine 0, 1
    For i% = 0 To 188 * fy + 1
      Color RGB(160, 50, 50)                           ' dunkelbraun
      PBox 538 * fx, Ceil(266 * fy) + i%, 614 * fx, Fix(286 * fy) + i%     ' Kolben
      If  voll| = 1 And (schlauch_t_br| = 2 And klemme_h| = 2 Or schlauch_br| = 2) And fuellung| = 0       ' Pumpen durch geschlossenen Schlauch zurück in den Brunnen, noch Luft im Zylinder
        If rot% < 230    ' Rohr ist mit Wasser gefüllt
          If i% < 141 * fy
            Color RGB(255, 255, 255)                      ' weiß
            PBox 538 * fx, 286 * fy + 47 * fy + i% , 614 * fx, Fix(287 * fy) + Fix(47 * fy) + i%    ' Luft im Kolben
          Else
            Color RGB(255, 255, 255)                      ' weiß
            PBox 571 * fx, 475 * fy, 581 * fx, 470 * fy + (i% - 142 * fy) * 7   ' Luft im Schlauch
          EndIf
        Else  '  Luft im Schlauch
          If i% < 141 * fy
            If i% < 8 * fy
              Color RGB(255, 255, 255)                      ' weiß
              PBox 571 * fx, 750 * fy, 581 * fx, 750 * fy + i% * 7   ' Luft im Schlauch
            Else
              DefLine 0, 0
              Color RGB(238, 255, 247)  ' Hintergrund
              PCircle 576 * fx, 803 * fy, 8 * fx
              If i% < 49 * fy
                PCircle 596 * fx + Rand(25 * fx) , 800 * fy - Rand(i%) / 1.5, 6 * fx - Rand(3 * fx)
                PCircle 556 * fx - Rand(25 * fx) , 800 * fy - Rand(i%) / 1.5, 6 * fx - Rand(3 * fx)
                If i% > 18 * fy
                  PCircle 596 * fx + Rand(25 * fx) , 785 * fy - Rand(i%) / 2, 6 * fx - Rand(3 * fx)
                  PCircle 556 * fx - Rand(25 * fx) , 785 * fy - Rand(i%) / 2, 6 * fx - Rand(3 * fx)
                EndIf
                If i% > 18 * fy
                  PCircle 596 * fx + Rand(25 * fx) , 770 * fy - Rand(i%) / 2.5, 6 * fx - Rand(3 * fx)
                  PCircle 556 * fx - Rand(25 * fx) , 770 * fy - Rand(i%) / 2.5, 6 * fx - Rand(3 * fx)
                EndIf
                If i% > 28 * fy
                  PCircle 596 * fx + Rand(25 * fx) , 755 * fy - Rand(i%) / 3, 6 * fx - Rand(3 * fx)
                  PCircle 556 * fx - Rand(25 * fx) , 755 * fy - Rand(i%) / 3, 6 * fx - Rand(3 * fx)
                EndIf
              Else
                Color RGB(100, 220, 255) ' hellblau Wasser
                PCircle 596 * fx + Rand(30 * fx) , 800 * fy - Rand(i% - 64 * fy) / 1.7, 6 * fx - Rand(3 * fx)
                PCircle 556 * fx - Rand(30 * fx) , 800 * fy - Rand(i% - 64 * fy) / 1.7, 6 * fx - Rand(3 * fx)
                PCircle 596 * fx + Rand(30 * fx) , 800 * fy - Rand(i% - 54 * fy) / 1.6, 6 * fx - Rand(3 * fx)
                PCircle 556 * fx - Rand(30 * fx) , 800 * fy - Rand(i% - 54 * fy) / 1.6, 6 * fx - Rand(3 * fx)
              EndIf
              PCircle 576 * fx + Rand(25 * fx) - Rand(25 * fx), 800 * fy + Rand(15 * fy) , 6 * fx - Rand(3 * fx)
              PCircle 581 * fx + Rand(25 * fx), 800 * fy + Rand(15 * fy) , 6 * fx - Rand(3 * fx)
              PCircle 571 * fx - Rand(25 * fx) , 800 * fy + Rand(15 * fy) , 6 * fx - Rand(3 * fx)
            EndIf
            Color RGB(255, 255, 255)                      ' weiß
            PBox 538 * fx, 286 * fy + 47 * fy + i% , 614 * fx, Fix(287 * fy) + Fix(47 * fy) + i%    ' Luft im Kolben
            Color RGB(100, 220, 255)                        ' hellblau Wasser
            PBox 571 * fx, 475 * fy, 581 * fx, 470 * fy + i% * 7   ' Luft im Schlauch
          Else
            DefLine 0, 0
            Color RGB(100, 220, 255)                        ' hellblau Wasser
            PCircle 596 * fx + Rand(30 * fx) , 800 * fy - Rand((i% - 135 * fy)), 8 * fx
            PCircle 556 * fx - Rand(30 * fx) , 800 * fy - Rand((i% - 135 * fy)) , 8 * fx
            PCircle 576 * fx + Rand(25 * fx) , 800 * fy + Rand(15 * fx) , 6 * fx
            PCircle 576 * fx - Rand(25 * fx) , 800 * fy + Rand(15 * fx) , 6 * fx
            verzoegerung(1 / fx)
            If i% => Int(188 * fy)
              Put 520 * fx, Ceil(500 * fy), jj$
            EndIf
            Color RGB(255, 255, 255)                      ' weiß
            PBox 571 * fx, 475 * fy, 581 * fx, 470 * fy + (i% - 142 * fy) * 7   ' Luft im Schlauch
          EndIf
        EndIf
      Else If voll| = 1 And schlauch_h| < 2 And schlauch_br| < 2 And klemme_h| < 2 And klemme_br| < 2 ' Pumpen ohne Schlauch oder durch offenen Schlauch zurück in den Brunnen
        If i% < 47 * fy
          DefLine 0, Fix(11 * fx)
          Color RGB(100, 220, 255)                        ' hellblau Wasser
          Line 576 * fx, 480 * fy + i%, 576 * fx, 490 * fy + i% * 7
        EndIf
        If i% < 141 * fy
          DefLine 0, 1
          Color RGB(255, 255, 255)                      ' weiß
          PBox 538 * fx, 286 * fy + 47 * fy + i% , 614 * fx, Fix(287 * fy) + Fix(47 * fy) + i%    ' Luft im Kolben
        Else If i% < 174 * fx
          Color RGB(238, 255, 247)  ' Hintergrund
          DefLine 0, 1
          PBox 571 * fx, 475 * fy , 581 * fx, 490 * fy - 1 + (i% - 141 * fx) * 8
        EndIf
      Else  If voll| = 1 And schlauch_h| = 2  ' Pumpe voll, mit Luftblase, Schlauch zum Hochbehälter angeschlossen
        If i% < 141 * fy
          DefLine 0, 1
          Color RGB(255, 255, 255)                      ' weiß
          PBox 538 * fx, 286 * fy + 47 * fy + i% , 614 * fx, Fix(287 * fy) + Fix(47 * fy) + i%    ' Luft im Kolben
        EndIf
        DefLine 0, Fix(11 * fx)
        Color RGB(100, 220, 255)                        ' hellblau Wasser
        If i% < 16 * fy
          Line 576 * fx, 480 * fy + i%, 576 * fx, 489 * fy + i% * 7  ' Schläuche zum Hochbehälter
          If i% = 16 * fy - 1
            Line 576 * fx, 580 * fy, 576 * fx, 600 * fy
          EndIf
        Else If i% < 49 * fy
          Line 576 * fx - (i% - 16 * fy) * 6.7, 600 * fy, 576 * fx, 600 * fy
        Else If i% < 131 * fy
          Line 350 * fx, 600 * fy, 350 * fx, Ceil(597 * fy) - Fix(i% - 49 * fy) * 7
        Else If i% < 146 * fy
          Line 349 * fx - (i% - 131 * fy) * 6.7,  30 * fy, 350 * fx, 30 * fy
        Else If  i% < 171 * fy
          Line 250 * fx,  30 * fy, 250 * fx, 30 * fy + (i% - 146 * fy) * 7
        EndIf
        If i% = Int(173 * fy) Or i% = Int(176 * fy) Or i% = Int(179 * fy) Or i% = Int(182 * fy) Or i% = Int(185 * fy) Or i% = Int(188 * fy)
          DefLine 0, 1
          PBox 62 * fx,  209 * fy, 288 * fx, 209 * fy - (i% - 170 * fy) / 3  ' Wasser im Hochbehälter
        EndIf
        If i% > 141 * fy And i% < 157 * fy
          DefLine 0, 1
          Color RGB(255, 255, 255)  ' weiß
          PBox 571 * fx, 475 * fy, 581 * fx, 482 * fy  ' Luft in Schläuche zum Hochbehälter
          DefLine 0, Fix(11 * fx)
          Line 576 * fx, 480 * fy, 576 * fx, 488 * fy + (i% - 141 * fy) * 7
        Else If i% > 156 * fy
          Color RGB(255, 255, 255)  ' weiß
          DefLine 0, Fix(11 * fx)
          Line 574 * fx - (i% - 157 * fy) * 7, 600 * fy, 576 * fx, 600 * fy
          If i% > 166 * fx
            Line 250 * fx,  50 * fy, 250 * fx, 49 * fy + (i% - 166 * fy) * 6.7  ' Abdeckung: Wasser in den Hochbehälter
          EndIf
        EndIf
      Else If voll| = 1 And schlauch_t| = 2 And schlauch_t_br| = 2 And schlauch_t_h = 2 And klemme_br| = 2 And klemme_h < 2 ' Pumpe voll, Schläuche und T-Stück richtig angeschlossen
        If i% < Ceil(141 * fy) + 1
          Color RGB(255, 255, 255)                      ' weiß
          PBox 538 * fx, 286 * fy + 47 * fy + i% , 614 * fx, Fix(287 * fy) + Fix(47 * fy) + i%    ' Luft im Kolben
        EndIf
        Color RGB(100, 220, 255)                        ' hellblau Wasser
        DefLine 0, Fix(11 * fx)
        If i% = 0
          Line 576 * fx, 480 * fy, 576 * fx, 600 * fy  ' Schläuche zum Hochbehälter
        EndIf
        If i% < 33 * fy
          Line Min(576 * fx, 578 * fx - i% * 7), 600 * fy, 576 * fx, 600 * fy  ' Schläuche zum Hochbehälter
        Else If i% < 115 * fy
          Line 350 * fx, 600 * fy, 350 * fx, 600 * fy - Fix(i% - 33 * fy) * 7
        Else If i% < 130 * fy
          Line 350 * fx - (i% - 115 * fy) * 6.7,  30 * fy, 350 * fx, 30 * fy
        Else If  i% < 141 * fy
          Line 250 * fx,  30 * fy, 250 * fx, 30 * fy + (i% - 130 * fy) * 7
        Else If i% = Ceil(141 * fy) + 1
          DefLine 0, 1
          PBox 62 * fx,  209 * fy, 288 * fx, 205 * fy  ' Wasser im Hochbehälter
          DefLine 0, Fix(11 * fx)
          Color RGB(255, 255, 255)  ' weiß
          Line 250 * fx,  50 * fy, 250 * fx, 200 * fy
          Get 525 * fx, 469 * fy, 537 * fx, 474 * fy + 1, j$ ' Öffnung zum Luftablassen
          If klemme_h| < 2
            Get 482 * fx, 570 * fx, 502 * fx, 630 * fy, klemm_h$  ' Hintergrund der Klemme_H zum späteren Wiederherstellen
          EndIf
          verzoegerung(1500)
          alert2("Gut: Du hast die Klemmen richtig benutzt. Jetzt wird die Luft aus dem Zylinder", "durch eine kleine Öffnung entfernt, damit die Pumpe ganz mit Wasser", "gefüllt werden kann.")
          verzoegerung(400)
          DefLine 0, 1
          Color RGB(255, 255, 255)  ' weiß
          PBox 525 * fx, 469 * fy, 537 * fx, 474 * fy + 1  ' Öffnung zur Entlüftung
          fuellung| = 1  ' keine Luft mehr im Zylinder
          ansaugen| = 2  ' Ansaugen ohne Luftblase
          wasserstand_h% = 205 * fy  ' Wasserstand im Hochbehälter nach der ersten Füllung
        EndIf
      Else If voll| = 2 And ((klemme_h| < 2 And klemme_br| = 2) Or schlauch_h| = 2)
        Color RGB(100, 220, 255)                        ' hellblau Wasser
        DefLine 0, Fix(11 * fx)
        If i% = 0
          Line 576 * fx, 480 * fy, 576 * fx, 600 * fy  ' Schläuche zum Hochbehälter
        EndIf
        If  i% < 22 * fy
          Line 250 * fx,  30 * fy, 250 * fx, 30 * fy + i% * 7.8  ' Wasserfluss in den Hochbehälter
        Else If i% > 178 * fy
          If 49 * fy + (i% - 178 * fy) * 8 < wasserstand_h% - i% / 3
            Color RGB(255, 255, 255)  ' weiß
            Line 250 * fx,  50 * fy, 250 * fx, 49 * fy + (i% - 178 * fy) * 8  ' Abdeckung: Wasser in den Hochbehälter
          EndIf
        EndIf
        If Mod(i%, 3) = 0 And i% > 5 * fy
          DefLine 0, 1
          Color RGB(100, 220, 255)                        ' hellblau Wasser
          PBox 62 * fx,  209 * fy, 288 * fx, wasserstand_h% - i% / 3  ' Wasser im Hochbehälter
        EndIf
        If i% = Int(188 * fy)
          DefLine 0, 1
          Color RGB(255, 255, 255)  ' weiß
          PBox 245 * fx,  55 * fy, 255 * fx, wasserstand_h% - i% / 3  ' Abdeckung: Wasser in den Hochbehälter
        EndIf
        If wasserstand_h% - i% / 3 <= 60 * fy
          DefLine 0, Fix(11 * fx)
          Color RGB(255, 255, 255)  ' weiß
          Line 250 * fx,  50 * fy, 250 * fx, 53 * fy  ' Abdeckung: Wasser in den Hochbehälter
          DefLine 0, 1
          Color RGB(250, 254, 253)
          PBox 240 * fx, 55 * fy, 260 * fx, 60 * fy  ' Abdeckung Wasser in den Hochbehälter
          alert2("Sehr gut: Du hast den Hochbehälter gefüllt.", "Der Fühler oben links im Hochbehälter hat die Pumpe abgeschaltet,", "damit das Wasser nicht überläuft.")
          Repeat
            PeekEvent
          Until MouseK = 0
          fertig| = 1
          GoTo weiter1
        EndIf
        fuellung| = 1  ' keine Luft mehr im Zylinder
        ansaugen| = 2  ' Ansaugen ohne Luftblase
      Else If voll| = 2 And klemme_br| < 2  ' keine Klemme Richtung Brunnen vorhanden
        If i% < 47 * fy
          DefLine 0, Fix(11 * fx)
          Color RGB(100, 220, 255)                        ' hellblau Wasser
          Line 576 * fx, 480 * fy + i%, 576 * fx, 495 * fy + i% * 7
        EndIf
      Else If voll| = 0 And schlauch_br| = 2 Or schlauch_t_br| = 2 And klemme_h| = 2   ' Zylinder leer, Schlauch zum Brunnen
        DefLine 0, 0
        Color RGB(238, 255, 247)  ' Hintergrund
        PCircle 576 * fx, 803 * fy, 8 * fx
        If i% < 94 * fy
          PCircle 592 * fx + Rand(26 * fx) , 806 * fy - Rand(i%), 6 * fx - Rand(3 * fx)
          PCircle 560 * fx - Rand(26 * fx) , 806 * fy - Rand(i%), 6 * fx - Rand(3 * fx)
          If i% > 10 * fy
            PCircle 592 * fx + Rand(21 * fx) , 800 * fy - Rand(i%) / 1.5, 8 * fx - Rand(3 * fx)
            PCircle 560 * fx - Rand(21 * fx) , 800 * fy - Rand(i%) / 1.5, 8 * fx - Rand(3 * fx)
          EndIf
          If i% > 25 * fy
            PCircle 592 * fx + Rand(23 * fx) , 800 * fy - Rand(i%) / 2, 6 * fx - Rand(3 * fx)
            PCircle 560 * fx - Rand(23 * fx) , 800 * fy - Rand(i%) / 2, 6 * fx - Rand(3 * fx)
          EndIf
          If i% > 40 * fy
            PCircle 592 * fx + Rand(26 * fx) , 800 * fy - Rand(i%) / 3, 8 * fx - Rand(3 * fx)
            PCircle 560 * fx - Rand(26 * fx) , 800 * fy - Rand(i%) / 3, 8 * fx - Rand(3 * fx)
          EndIf
        Else
          PCircle 594 * fx + Rand(28 * fx) , 803 * fy - Rand(i% - 95 * fy), 6 * fx - Rand(3 * fx)
          PCircle 558 * fx - Rand(28 * fx) , 803 * fy - Rand(i% - 95 * fy), 6 * fx - Rand(3 * fx)
        EndIf
        PCircle 579 * fx + Rand(28 * fx), 800 * fy + Rand(20 * fy) , 6 * fx - Rand(3 * fx)
        PCircle 573 * fx - Rand(28 * fx) , 800 * fy + Rand(20 * fy) , 6 * fx - Rand(3 * fx)
      EndIf
      DefLine 0, 1
      Color RGB(255, 255, 255)                        ' weiß
      PBox 538 * fx, 266 * fy - 1, 568 * fx, 265 * fy + i%    ' Luft neben Kolbenstange
      PBox 584 * fx, 266 * fy - 1, 614 * fx, 265 * fy + i%    ' Luft neben Kolbenstange
      Color RGB(130, 130, 130)                        ' grau
      PBox 569 * fx, 266 * fy - 1, 583 * fx, 265 * fy + i%     ' Kolbenstange
      Color RGB(244, 255, 251)                        ' heller Hintergrund
      PBox 569 * fx, 32 * fy, 583 * fx, 32 * fy + i%         ' Luft über Kolbenstange
      verzoegerung(20 / fx)
    Next i%
    Put 525 * fx, 469 * fy, j$
    Clr j$
    If schlauch_t_br| = 2 And klemme_h| < 2  ' Wasser steigt im offenen Rohr bis zum Wasserspiegel des Brunnens
      Color RGB(100, 220, 255)                        ' hellblau Wasser
      PBox 571 * fx, 750 * fy, 581 * fx, 796 * fy   ' Schlauch zum Brunnen
    EndIf
    If voll| = 0 And (schlauch_br| = 2 Or (schlauch_t_br| = 2 And klemme_h| = 2))
      For i% = 0 To 100
        DefLine 0, 0
        Color RGB(100, 220, 255)                        ' hellblau Wasser
        PCircle 596 * fx + Rand(30 * fx) , 800 * fy - Rand(i% / 1.5), 6 * fx - Rand(3 * fx)
        PCircle 556 * fx - Rand(30 * fx) , 800 * fy - Rand(i% / 1.5) , 6 * fx - Rand(3 * fx)
        PCircle 596 * fx + Rand(30 * fx) , 800 * fy + Rand(20 * fx) , 6 * fx - Rand(3 * fx)
        PCircle 556 * fx - Rand(30 * fx) , 800 * fy + Rand(20 * fx) , 6 * fx - Rand(3 * fx)
        PCircle 576 * fx - Rand(30 * fx) , 800 * fy + Rand(20 * fx) , 6 * fx - Rand(3 * fx)
        verzoegerung(1 / fx)
      Next i%
      Put 520 * fx, Ceil(500 * fy), jj$
    EndIf
    If voll| = 2 And klemme_h| < 2 And klemme_br| = 2
      wasserstand_h% = wasserstand_h% - i% / 3  ' Wasserstand im Hochbehälter
    EndIf
    If voll| = 2 And klemme_h| < 2 And klemme_br| < 2 ' keine Klemme vorhanden
      For i% = 0 To 34 * fx
        DefLine 0, 1
        Color RGB(238, 255, 247)  ' Hintergrund
        PBox 571 * fx, 475 * fy , 581 * fx, 477 * fy + i% * 8
        verzoegerung(20 / fx)
      Next i%
    EndIf
    If voll| = 1 And schlauch_h = 2                        ' Pumpe voll, Schlauch zum Hochbehälter angeschlossen
      Color RGB(100, 220, 255)                ' hellblau Wasser
      DefLine 0, 1
      PBox 62 * fx,  209 * fy, 288 * fx, 209 * fy - (i% - 170 * fy) / 3  ' Wasser im Hochbehälter
      Repeat
        PeekEvent
      Until MouseK = 0
      Repeat
        PeekEvent
        j$ = InKey$
        Mouse x, y, k%
      Until k% <> 0 Or j$ <> ""
      alert2("Gut : Du konntest Wasser in den Hochbehälter pumpen.", "Versuche jetzt, das laufende Wechseln der Schläuche zu vermeiden.", "Das geht, wenn du das T-Stück und eine Klemme benutzt.")
      schlauch_br| = 1
      schlauch_h| = 1
      schlauch_t| = 0
      schlauch_t_br| = 0
      schlauch_t_h| = 0
      t_stueck| = 1
      ansaugen| = 0
      fuellung| = 0
      Put 0, 0, bild$
    EndIf
    If (voll| = 1 Or voll| = 2) And schlauch_h| < 2 And schlauch_br| < 2 And schlauch_t_br| < 2 ' Pumpe voll, kein Schlauch, kein T-Stück angeschlossen
      Color RGB(238, 255, 247)  ' Hintergrund
      DefLine 0, Fix(11 * fx)
      For i% = 1 To 20
        Line 576 * fx, 480 * fy + i%, 576 * fx, 495 * fy + i% * 7
      Next i%
      Put 571 * fx, 475 * fy, luft_zyl_br$
    EndIf
    voll| = 0  ' Zylinder leer
    unten| = 1  ' Kolben unten
  EndIf
  weiter1:
  Clr jj$
Return
>Procedure pumpe2                  ' Pumpe mit Ventilen
  Output = Win_2
  GraphMode R2_COPYPEN, TRANSPARENT
  Stretch 0, 0, hintergrund1, _X, _Y
  Color RGB(0, 80, 160)                                                             ' dunkelblau
  DefLine 0, 1
  PBox 50 * fx, 50 * fy, 300 * fx, 220 * fy  ' Hochbehälter
  PBox 526 * fx, Ceil(254 * fy), 626 * fx, Fix(486 * fy)  ' Zylinder
  PBox 450 * fx, 750 * fy, 702 * fx, 864 * fy     ' Brunnen
  PBox 450 * fx, 720 * fy, 461 * fx, 750 * fy    ' Brunnenrand
  PBox 691 * fx, 720 * fy, 702 * fx, 750 * fy    ' Brunnenrand
  Color RGB(0, 0, 0)                                                                   ' schwarz
  PBox 58 * fx, 50 * fy, 292 * fx, 212 * fy  ' Hochbehälter
  PBox 534 * fx, Ceil(262 * fy), 618 * fx, Fix(478 * fy)  ' Zylinder
  PBox 458 * fx, 750 * fy, 694 * fx, 864 * fy     ' Brunnen
  PBox 458 * fx, 720 * fy, 461 * fx, 750 * fy    ' Brunnenrand
  PBox 691 * fx, 720 * fy, 694 * fx, 750 * fy    ' Brunnenrand
  Color RGB(255, 255, 255)                                                           ' weiß
  PBox 62 * fx, 50 * fy, 288 * fx, 208 * fy  ' Hochbehälter
  PBox 538 * fx, Ceil(266 * fy), 614 * fx, Fix(474 * fy)  ' Zylinder
  PBox 567 * fx, 254 * fy, 585 * fx, 265 * fy  ' Zylinder oben Mitte
  Color RGB(0, 0, 0)                                                                       ' schwarz
  PBox 534 * fx, 475 * fy, 618 * fx, 515 * fy  ' Zylinder unten
  PBox 58 * fx, 50 * fy, 75 * fx, 55 * fy      ' Sensor für Wasserstand Hochbehälter
  Color RGB(255, 255, 255)                                                             ' weiß
  PBox 538 * fx, 475 * fy, 573 * fx, 511 * fy  ' Zylinder unten, Platz für Ventile
  PBox 579 * fx, 475 * fy, 614 * fx, 511 * fy  ' Zylinder unten, Platz für Ventile
  Color RGB(100, 220, 255)                                                             ' hellblau Wasser
  PBox 462 * fx, 750 * fy, 690 * fx, 864 * fy     ' Brunnen
  Color RGB(160, 50, 50)                                                                ' dunkelbraun
  If _X = 1600 Or _X = 1280
    PBox 538 * fx, 454 * fy, 614 * fx, Fix(474 * fy)    ' Kolben
  Else
    PBox 538 * fx, 454 * fy, 614 * fx, 474 * fy     ' Kolben
  EndIf
  Color RGB(130, 130, 130)                                                            ' grau
  If _X = 1600 Or _X = 1280
    PBox 569 * fx, 220 * fy, 583 * fx, 453 * fy + 1     ' Kolbenstange
  Else
    PBox 569 * fx, 220 * fy, 583 * fx, 453 * fy     ' Kolbenstange
  EndIf
  PBox 67 * fx, 55 * fy, 75 * fx, 58 * fy      ' Sensor für Wasserstand Hochbehälter
  SetFont schriftw2%
  Color RGB(255, 0, 0)               '  rot
  PBox 67 * fx, 58 * fy, 75 * fx, 60 * fy      ' Sensor für Wasserstand Hochbehälter
  Text 630 * fx, 330 * fy, "é"  ' Pfeil nach oben"
  Text 630 * fx, 380 * fy, "ê"  ' Pfeil nach unten"
  SetFont schrift1%
  Text 175 * fx - TxtLen("Wasserhochbehälter") / 2, 230 * fy, "Wasserhochbehälter"
  Text 714 * fx, 740 * fy, "Brunnen"
  Color RGB(0, 0, 200)
  Text 690 * fx, 30 * fy, "Deine erste Pumpe hat schon gut gearbeitet."
  Text 690 * fx, 60 * fy, "Jetzt kannst du sie so verbessern, dass sie"
  Text 690 * fx, 85 * fy, "   keine Klemmen mehr braucht."
  Text 690 * fx, 115 * fy, "Dazu werden zwei Ventile eingebaut."
  Text 690 * fx, 145 * fy, "Ein Ventil lässt Wasser nur in einer Richtung"
  Text 690 * fx, 170 * fy, "   fließen, es versperrt ihm aber den Weg"
  Text 690 * fx, 195 * fy, "   in der anderen Richtung."
  Text 690 * fx, 225 * fy, "Sieh dir unten links die vergrößerte Zeichnung"
  Text 690 * fx, 250 * fy, "   der beiden Ventile genau an!"
  Text 690 * fx, 280 * fy, "Beides sind Kugelventile. Ventil 2 ist gebaut"
  Text 690 * fx, 305 * fy, "   wie Ventil 1, steht nur auf dem Kopf."
  Text 690 * fx, 335 * fy, "Im Inneren von Ventil 1 siehst du eine leichte,"
  Text 690 * fx, 360 * fy, "   bewegliche Kugel und darüber ein Gitter"
  Text 690 * fx, 385 * fy, "   (wie ein feines Sieb)."
  Text 690 * fx, 415 * fy, "Überlege, was geschieht, wenn Wasser von"
  Text 690 * fx, 440 * fy, "   oben oder von unten durch dieses Ventil"
  Text 690 * fx, 465 * fy, "   gesaugt oder gedrückt wird."
  Text 690 * fx, 495 * fy, "In einer Richtung wird die Kugel gegen den."
  Text 690 * fx, 520 * fy, "   Ausfluss gedrückt und versperrt den Weg."
  Text 690 * fx, 545 * fy, "   In der anderen Richtung hält das Sieb die"
  Text 690 * fx, 570 * fy, "   Kugel fest, das Wasser aber kann fließen."
  Text 690 * fx, 600 * fy, "Klicke jetzt auf den roten Namen eines Ventils"
  Text 690 * fx, 625 * fy, "   und wähle, an welcher Stelle es verkleinert"
  Text 690 * fx, 650 * fy, "   in die Pumpe eingebaut werden soll!"
  Text 690 * fx, 680 * fy, "Danach kannst du die Pumpe bedienen."
  Color RGB(255, 0, 0)               '  rot
  Text 138 * fx - TxtLen("Ventil 1") / 2, 756 * fy, "Ventil 1"
  Text 318 * fx - TxtLen("Ventil 2") / 2, 756 * fy, "Ventil 2"
  Box 85 * fx, 752 * fy, 191 * fx, 785 * fy  ' Box um "Ventil 1"
  Box 265 * fx, 752 * fy, 371 * fx, 785 * fy  ' Box um "Ventil 2"
  Color RGB(0, 0, 0)   ' schwarz
  If _X = 1600 Or _X = 1280
    PBox 588 * fx, 516 * fy - 1, 606 * fx, 795 * fy  ' Rohr zum Brunnen
  Else If _X = 800
    PBox 588 * fx, 516 * fy, 605 * fx, 795 * fy  ' Rohr zum Brunnen
  Else
    PBox 588 * fx, 516 * fy, 606 * fx, 795 * fy  ' Rohr zum Brunnen
  EndIf
  If _X = 1600 Or _X = 1280
    PBox 548 * fx, 516 * fy - 1, 566 * fx, 598 * fy  ' Rohre zum Hochbehälter
  Else
    PBox 548 * fx, 516 * fy, 566 * fx, 598 * fy  ' Rohre zum Hochbehälter
  EndIf
  DefLine 0, 19 * fx
  Line 557 * fx, 600 * fy, 350 * fx, 600 * fy
  Line 350 * fx, 600 * fy, 350 * fx, 30 * fy
  Line 350 * fx,  30 * fy, 250 * fx, 30 * fy
  Line 250 * fx,  30 * fy, 250 * fx, 55 * fy
  Color RGB(255, 255, 255)           ' weiß
  DefLine 0, 1
  If _X = 800
    PBox 592 * fx, 510 * fy, 601 * fx, 795 * fy  ' Rohr zum Brunnen
    PBox Ceil(552 * fx), 510 * fy, 562 * fx, 599 * fy  ' Rohre zum Hochbehälter
  Else
    PBox Ceil(592 * fx), 510 * fy, 602 * fx, 795 * fy  ' Rohr zum Brunnen
    PBox 552 * fx, 510 * fy, Fix(562 * fx), 599 * fy  ' Rohre zum Hochbehälter
  EndIf
  DefLine 0, Fix(11 * fx)
  If _X = 1600 Or _X = 1280
    Line 557 * fx - 1, 600 * fy, 350 * fx, 600 * fy
  Else
    Line 557 * fx, 600 * fy, 350 * fx, 600 * fy
  EndIf
  Line 350 * fx, 600 * fy, 350 * fx, 30 * fy
  Line 350 * fx,  30 * fy, 250 * fx, 30 * fy
  Line 250 * fx,  30 * fy, 250 * fx, 60 * fy
  DefLine 0, 1
  Color RGB(250, 254, 253)
  PBox 240 * fx, 55 * fy, 260 * fx, 65 * fy ' Abschneiden Wasserauslauf zum Hochbehälter
  Color RGB(0, 0, 0)  'schwarz
  PBox 100 * fx, 670 * fy, 176 * fx, 736 * fy                                  ' 1. Ventil
  Line 109 * fx, 670 * fy, 128 * fx, 660 * fy  ' links
  Line 100 * fx, 670 * fy, 100 * fx, 660 * fy
  PBox 100 * fx, 656 * fy, 128 * fx, 660 * fy
  Line 167 * fx, 670 * fy, 148 * fx, 660 * fy  ' rechts
  Line 176 * fx, 670 * fy, 176 * fx, 660 * fy
  PBox 148 * fx, 656 * fy, 176 * fx, 660 * fy
  Fill 109 * fx, 663 * fy To RGB(0, 0, 0) ' Füllen bis schwarz
  Fill 167 * fx, 663 * fy To RGB(0, 0, 0)
  DefLine 0, 1
  Color RGB(255, 255, 255)  ' weiß
  PBox 106 * fx, Fix(674 * fy), 170 * fx, 716 * fy
  PBox 128 * fx, 702 * fy, 148 * fx, 741 * fy
  For i% = 0 To 3
    PBox 110 * fx + i% * 16 * fx, 670 * fy, 118 * fx + i% * 16 * fx, 674 * fy  ' Gitter
  Next i%
  Color RGB(255, 0, 0)            '  rot
  PCircle 138 * fx, 708 * fy, 22 * fx          ' Ventilkugel
  Color RGB(0, 0, 0)  ' schwarz
  PBox 280 * fx, 656 * fy, 356 * fx, 722 * fy                                ' 2. Ventil
  Line 289 * fx, 722 * fy, 308 * fx, 732 * fy  ' links
  Line 280 * fx, 722 * fy, 280 * fx, 732 * fy
  PBox 280 * fx, 732 * fy, 308 * fx, 736 * fy
  Line 347 * fx, 722 * fy, 328 * fx, 732 * fy  ' rechts
  Line 356 * fx, 722 * fy, 356 * fx, 732 * fy
  PBox 328 * fx, 732 * fy, 356 * fx, 736 * fy
  Fill 283 * fx, 729 * fy To RGB(0, 0, 0) ' Füllen bis schwarz
  Fill 353 * fx, 729 * fy To RGB(0, 0, 0)
  Color RGB(255, 255, 255)  ' weiß
  PBox 286 * fx, 676 * fy, 350 * fx, Fix(718 * fy)
  PBox 308 * fx, 656 * fy, 328 * fx, 666 * fy
  For i% = 0 To 3
    PBox 290 * fx + i% * 16 * fx, 718 * fy, 298 * fx + i% * 16 * fx, 722 * fy  ' Gitter
  Next i%
  PCircle 318 * fx, 682 * fy, 22 * fx          ' Ventilkugel
  Color RGB(255, 0, 0)            '  rot
  PCircle 318 * fx, 696 * fy, 22 * fx          ' Ventilkugel
  Get 0, 0, _X, _Y, bild$
  Output = Win_1
  GraphMode R2_COPYPEN, TRANSPARENT
  unten| = 1  ' Kolben unten
  ansaugen| = 1  ' Ansaugen mit Luftblase
  v_links| = 0  ' linkes Ventil nicht gesetzt
  v_rechts| = 0  ' rechtes Ventil nicht gesetzt
  voll| = 0  ' Zylinder leer
  Put 0, 0, bild$
  neu5:
  DefLine 0, 1
  Repeat
    PeekEvent
  Until MouseK = 0 And _Mess = 0
  Repeat
    PeekEvent
    Mouse x, y, k%
    j$ = InKey$
  Until Len(j$) = 2 And (Asc(Right$(j$)) = 119) Or (k% = 1  And voll| = 0 And y > 752 * fy And y < 785 * fy And (x > 85 * fx And x < 191 * fx Or x > 265 * fx And x < 371 * fx)) Or (k% = 1 And x > 629 * fx And x < 670 * fx And y > 329 * fy And y < 420 * fy)
  If Len(j$) = 2 And (Asc(Right$(j$)) = 119)  ' F8
    alert3("Willst du wirklich aufhören?", "Ende", "zurück")
    If alertf| = 1
      ende
    Else
      GoTo neu5
    EndIf
  Else If k% = 1 And x > 629 * fx And x < 670 * fx And y > 329 * fy And y < 420 * fy And v_links| > 0 And v_rechts| > 0  ' Pfeile, beide Ventile gesetzt
    farbabfrage(x, y)
    If unten| = 1 And rot% > 250 And gruen% < 80 And blau% < 80 And y < 373 * fy  ' Pfeil nach oben
      If _X = 1600 Or _X = 1280
        nachoben2_1600
      Else If _X = 800
        nachoben2_800
      Else
        nachoben2
      EndIf
    Else  If unten| = 0 And rot% > 250 And gruen% < 80 And blau% < 80 And y > 372 * fy  ' Pfeil nach unten
      If _X = 1600 Or _X = 1280
        nachunten2_1600
      Else If _X = 800
        nachunten2_800
      Else
        nachunten2
      EndIf
    EndIf
  Else If k% = 1 And x > 85 * fx And x < 191 * fx And y > 752 * fy And y < 785 * fy And (v_links| < 2 Or v_rechts| < 2) ' Ventil 1, falls nicht schon beide richtig
    alert3("Ventil 1 nach links (zum Hochbehälter) oder nach rechts (zum Brunnen)?", "nach links", "nach rechts")
    If alertf| = 1 ' Richtung Hochbehälter
      PaintPicture  ventil_ru, 538 * fx, 475 * fy, 39 * fx, 41 * fy
      v_links| = 1  ' falsch gesetzt
    Else  ' Richtung Brunnen
      PaintPicture  ventil_ru, 578 * fx, 475 * fy, 39 * fx, 41 * fy
      v_rechts| = 2  ' richtig gesetzt
    EndIf
  Else If x > 265 * fx And x < 371 * fx And y > 752 * fy And y < 785 * fy And (v_links| < 2 Or v_rechts| < 2)   ' Ventil 2, falls nicht schon beide richtig
    alert3("Ventil 2 nach links (zum Hochbehälter) oder nach rechts (zum Brunnen)?", "nach links", "nach rechts")
    If alertf| = 1 ' Richtung Hochbehälter
      PaintPicture  ventil_lu, 538 * fx, 475 * fy, 39 * fx, 41 * fy
      v_links = 2  ' richtig gesetzt
    Else  ' Richtung Brunnen
      v_rechts| = 1  ' falsch gesetzt
      PaintPicture  ventil_lu, 578 * fx, 475 * fy, 39 * fx, 41 * fy
    EndIf
  EndIf
  If fertig| = 1
    fertig| = 0
    DefLine 0, 1
    Color RGB(255, 0, 0)   ' rot
    Box 965 * fx, 723 * fy, 1100 * fx, 763 * fy
    Box 965 * fx, 773 * fy, 1100 * fx, 813 * fy
    Color RGB(0, 0, 0)  ' schwarz
    Text 980 * fx, 730 * fy, "Weiter"
    Text 980 * fx, 780 * fy, "Drucken"
    zurueck4:
    Repeat
      j$ = InKey$
      Mouse x, y, k%
    Until k% = 1 And x > 965 * fx And x < 1100 * fx And ((y > 723 * fy And y < 763 * fy) Or (y > 773 * fy And y < 813 * fy)) Or Len(j$) = 2 And (Asc(Right$(j$)) = 119) 'F8
    If Len(j$) = 2 And (Asc(Right$(j$)) = 119)  'F8
      alert3("Willst du wirklich aufhören?", "Ende", "zurück")
      If alertf| = 1
        ende
      Else
        GoTo zurueck4
      EndIf
    EndIf
    If y > 773 * fy And y < 813 * fy  ' Drucken
      alert3("Ist der Drucker angeschaltet?", "ja", "nein")
      If alertf| = 1
        drucken
      EndIf
      GoTo zurueck4
    EndIf
    verzoegerung(400)
    GoTo weiter3
  EndIf
  GoTo neu5
  weiter3:
Return
>Procedure nachoben2              ' Kolben nach oben mit Ventilen
  For i% = 0 To 188 * fy
    If v_rechts| = 2 And v_links| = 2 And ansaugen| = 1
      DefLine 0, 1
      Color RGB(160, 50, 50)                                                                ' dunkelbraun
      PBox 538 * fx, 473 * fy - i%, 614 * fx, 453 * fy - i%           ' Kolben
      If i% = 0
        PaintPicture  ventil_lo, 538 * fx, 475 * fy, 39 * fx, 41 * fy
        PaintPicture  ventil_ro, 578 * fx, 475 * fy, 39 * fx, 41 * fy
'##2#
      EndIf
      If i% < 41 * fy
        Color RGB(255, 255, 255)                      ' weiß
        PBox 538 * fx, 474 * fy , 614 * fx, 474 * fy - i%    ' Luft
        Color RGB(100, 220, 255)                        ' hellblau Wasser
        PBox Ceil(592 * fx), 796 * fy, 602 * fx, 794 * fy - i% * 7  ' Rohr zum Brunnen
      Else If i%  = Int(41 * fy)
        Color RGB(255, 255, 255)                      ' weiß
        PBox 538 * fx, 475 * fy - i% , 614 * fx, 475 * fy - i%    ' Luft
        PaintPicture  ventil_ra, 578 * fx, 475 * fy, 39 * fx, 41 * fy
        verzoegerung(5 / fx)
      Else If i% = Int(42 * fy)
        Color RGB(255, 255, 255)                      ' weiß
        PBox 538 * fx, 475 * fy - i% , 614 * fx, 475 * fy - i%    ' Luft
        PaintPicture  ventil_rb, 578 * fx, 475 * fy, 39 * fx, 41 * fy
        verzoegerung(5 / fx)
      Else If i% = Int(43 * fy)
        Color RGB(255, 255, 255)                      ' weiß
        PBox 538 * fx, 475 * fy - i% , 614 * fx, 475 * fy - i%    ' Luft
        PaintPicture  ventil_rc, 578 * fx, 475 * fy, 39 * fx, 41 * fy
        verzoegerung(5 / fx)
      Else If i% = Int(44 * fy)
        Color RGB(255, 255, 255)                      ' weiß
        PBox 538 * fx, 475 * fy - i% , 614 * fx, 475 * fy - i%    ' Luft
        PaintPicture  ventil_rvo, 578 * fx, 475 * fy, 39 * fx, 41 * fy
        verzoegerung(5 / fx)
      Else
        If i% = Ceil(45 * fy)
          PaintPicture  ventil_la, 538 * fx, 475 * fy, 39 * fx, 41 * fy
        EndIf
        Color RGB(255, 255, 255)                      ' weiß
        PBox 538 * fx, 475 * fy - i% , 614 * fx, 475 * fy - i%    ' Luft
        Color RGB(100, 220, 255)                        ' hellblau Wasser
        PBox 538 * fx, 474 * fy, 614 * fx, 474 * fy - (i% - 45 * fy)
        If i% = Int(188 * fy)
          voll| = 1   ' Zylinder gefüllt, mit Luftblase
          verzoegerung(400)
          PaintPicture  ventil_rvu, 578 * fx, 475 * fy, 39 * fx, 41 * fy
        EndIf
      EndIf
      Color RGB(130, 130, 130)                        ' grau
      PBox 569 * fx, 220 * fy, 583 * fx, 221 * fy - i%     ' Kolbenstange
    Else If ansaugen| = 2    ' keine Luft im Zylinder
      DefLine 0, 1
      Color RGB(160, 50, 50)                                                                ' dunkelbraun
      PBox 538 * fx, 473 * fy - i%, 614 * fx, 453 * fy - i%           ' Kolben
      If i% = 0
        PaintPicture  ventil_lvo, 538 * fx, 475 * fy, 39 * fx, 41 * fy
        PaintPicture  ventil_rvo, 578 * fx, 475 * fy, 39 * fx, 41 * fy
      EndIf
      Color RGB(100, 220, 255)                        ' hellblau Wasser
      PBox 538 * fx, 474 * fy, 614 * fx, 474 * fy - i%
      Color RGB(130, 130, 130)                        ' grau
      PBox 569 * fx, 220 * fy, 583 * fx, 221 * fy - i%     ' Kolbenstange
      voll| = 2   ' Zylinder gefüllt, ohne Luftblase
      If i% = Int(188 * fy)
        verzoegerung(400)
        PaintPicture  ventil_rvu, 578 * fx, 475 * fy, 39 * fx, 41 * fy
      EndIf
    Else If  v_links| = 1                                   ' Ansaugen von Luft aus dem Steigrohr
      DefLine 0, 1
      Color RGB(160, 50, 50)                                                                ' dunkelbraun
      PBox 538 * fx, 473 * fy - i%, 614 * fx, 453 * fy - i%           ' Kolben
      Color RGB(255, 255, 255)                      ' weiß
      PBox 538 * fx, Fix(474 * fy), 614 * fx, 474 * fy - i%    ' Luft
      PaintPicture  ventil_ro, 538 * fx, 475 * fy, 39 * fx, 41 * fy
      Color RGB(130, 130, 130)                        ' grau
      PBox 569 * fx, 220 * fy, 583 * fx, 221 * fy - i%     ' Kolbenstange
      If i% = Int(188 * fy)
        alert1("Weil die Pumpe durch die Leitung zum Hochbehälter leichte Luft ansaugen kann,", "bleibt das viel schwerere Wasser im Brunnen.")
        PaintPicture  ventil_ru, 538 * fx, 475 * fy, 39 * fx, 41 * fy
      EndIf
    Else If v_rechts| = 1 And v_links| = 2                                   ' kein Ansaugen
      PaintPicture  ventil_lo, 538 * fx, 475 * fy, 39 * fx, 41 * fy
      PaintPicture  ventil_lo, 578 * fx, 475 * fy, 39 * fx, 41 * fy
      If i% = Int(30 * fy)
        alert1("Beide Ventile verschließen den Eingang und verhindern,", "dass Luft oder Wasser angesaugt werden können.")
        PaintPicture  ventil_lu, 538 * fx, 475 * fy, 39 * fx, 41 * fy
        PaintPicture  ventil_lu, 578 * fx, 475 * fy, 39 * fx, 41 * fy
        GoTo weiter5
      EndIf
    EndIf
    verzoegerung(20 / fx)
  Next i%
  unten| = 0  ' Kolben oben
  weiter5:
Return
>Procedure nachoben2_800      ' Kolben nach oben mit Ventilen _X = 800
  For i% = 0 To 188 * fy
    If v_rechts| = 2 And v_links| = 2 And ansaugen| = 1
      DefLine 0, 1
      Color RGB(160, 50, 50)                                                                ' dunkelbraun
      PBox 538 * fx, 473 * fy - i%, 614 * fx, 453 * fy - i%           ' Kolben
      If i% = 0
        PaintPicture  ventil_lo, 538 * fx, 475 * fy, 39 * fx, 41 * fy
        PaintPicture  ventil_ro, 578 * fx, 475 * fy, 39 * fx, 41 * fy
      EndIf
      If i% < 41 * fy
        Color RGB(255, 255, 255)                      ' weiß
        PBox 538 * fx, 474 * fy , 614 * fx, 474 * fy - i%    ' Luft
        Color RGB(100, 220, 255)                        ' hellblau Wasser
        PBox Fix(592 * fx), 796 * fy, 601 * fx, 794 * fy - i% * 7  ' Rohr zum Brunnen
      Else If i%  = Int(41 * fy)
        Color RGB(255, 255, 255)                      ' weiß
        PBox 538 * fx, 475 * fy - i% , 614 * fx, 475 * fy - i%    ' Luft
        PaintPicture  ventil_ra, 578 * fx, 475 * fy, 39 * fx, 41 * fy
        verzoegerung(5 / fx)
      Else If i% = Int(42 * fy)
        Color RGB(255, 255, 255)                      ' weiß
        PBox 538 * fx, 475 * fy - i% , 614 * fx, 475 * fy - i%    ' Luft
        PaintPicture  ventil_rb, 578 * fx, 475 * fy, 39 * fx, 41 * fy
        verzoegerung(5 / fx)
      Else If i% = Int(43 * fy)
        Color RGB(255, 255, 255)                      ' weiß
        PBox 538 * fx, 475 * fy - i% , 614 * fx, 475 * fy - i%    ' Luft
        PaintPicture  ventil_rc, 578 * fx, 475 * fy, 39 * fx, 41 * fy
        verzoegerung(5 / fx)
      Else If i% = Int(44 * fy)
        Color RGB(255, 255, 255)                      ' weiß
        PBox 538 * fx, 475 * fy - i% , 614 * fx, 475 * fy - i%    ' Luft
        PaintPicture  ventil_rvo, 578 * fx, 475 * fy, 39 * fx, 41 * fy
        verzoegerung(5 / fx)
      Else
        If i% = Ceil(45 * fy)
          PaintPicture  ventil_la, 538 * fx, 475 * fy, 39 * fx, 41 * fy
        EndIf
        Color RGB(255, 255, 255)                      ' weiß
        PBox 538 * fx, 475 * fy - i% , 614 * fx, 475 * fy - i%    ' Luft
        Color RGB(100, 220, 255)                        ' hellblau Wasser
        PBox 538 * fx, 474 * fy, 614 * fx, 474 * fy - (i% - 45 * fy)
        If i% = Int(188 * fy) + 1
          voll| = 1   ' Zylinder gefüllt, mit Luftblase
          verzoegerung(400)
          PaintPicture  ventil_rvu, 578 * fx, 475 * fy, 39 * fx, 41 * fy
        EndIf
      EndIf
      Color RGB(130, 130, 130)                        ' grau
      PBox 569 * fx, 220 * fy, 583 * fx, 221 * fy - i%     ' Kolbenstange
    Else If ansaugen| = 2    ' keine Luft im Zylinder
      DefLine 0, 1
      Color RGB(160, 50, 50)                                                                ' dunkelbraun
      PBox 538 * fx, 473 * fy - i%, 614 * fx, 453 * fy - i%           ' Kolben
      If i% = 0
        PaintPicture  ventil_lvo, 538 * fx, 475 * fy, 39 * fx, 41 * fy
        PaintPicture  ventil_rvo, 578 * fx, 475 * fy, 39 * fx, 41 * fy
      EndIf
      Color RGB(100, 220, 255)                        ' hellblau Wasser
      PBox 538 * fx, 474 * fy, 614 * fx, 474 * fy - i%
      Color RGB(130, 130, 130)                        ' grau
      PBox 569 * fx, 220 * fy, 583 * fx, 221 * fy - i%     ' Kolbenstange
      voll| = 2   ' Zylinder gefüllt, ohne Luftblase
      If i% = Int(188 * fy) + 1
        verzoegerung(400)
        PaintPicture  ventil_rvu, 578 * fx, 475 * fy, 39 * fx, 41 * fy
      EndIf
    Else If  v_links| = 1                                   ' Ansaugen von Luft aus dem Steigrohr
      DefLine 0, 1
      Color RGB(160, 50, 50)                                                                ' dunkelbraun
      PBox 538 * fx, 473 * fy - i%, 614 * fx, 453 * fy - i%           ' Kolben
      Color RGB(255, 255, 255)                      ' weiß
      PBox 538 * fx, Fix(474 * fy), 614 * fx, 474 * fy - i%    ' Luft
      PaintPicture  ventil_ro, 538 * fx, 475 * fy, 39 * fx, 41 * fy
      Color RGB(130, 130, 130)                        ' grau
      PBox 569 * fx, 220 * fy, 583 * fx, 221 * fy - i%     ' Kolbenstange
      If i% = Int(188 * fy) + 1
        alert1("Weil die Pumpe durch die Leitung zum Hochbehälter leichte Luft ansaugen kann,", "bleibt das viel schwerere Wasser im Brunnen.")
        verzoegerung(300)
        PaintPicture  ventil_ru, 538 * fx, 475 * fy, 39 * fx, 41 * fy
      EndIf
    Else If v_rechts| = 1 And v_links| = 2                                   ' kein Ansaugen
      PaintPicture  ventil_lo, 538 * fx, 475 * fy, 39 * fx, 41 * fy
      PaintPicture  ventil_lo, 578 * fx, 475 * fy, 39 * fx, 41 * fy
      If i% = Int(30 * fy)
        alert1("Beide Ventile verschließen den Eingang und verhindern,", "dass Luft oder Wasser angesaugt werden können.")
        PaintPicture  ventil_lu, 538 * fx, 475 * fy, 39 * fx, 41 * fy
        PaintPicture  ventil_lu, 578 * fx, 475 * fy, 39 * fx, 41 * fy
        GoTo weiter5
      EndIf
    EndIf
    verzoegerung(20 / fx)
  Next i%
  unten| = 0  ' Kolben oben
  weiter5:
Return
>Procedure nachoben2_1600    ' Kolben nach oben mit Ventilen _X = 1600 oder 1280
  For i% = 0 To Int(188 * fy)
    If v_rechts| = 2 And v_links| = 2 And ansaugen| = 1
      DefLine 0, 1
      Color RGB(160, 50, 50)                                                                ' dunkelbraun
      PBox 538 * fx, 473 * fy - i%, 614 * fx, 453 * fy - i%           ' Kolben
      If i% = 0
        PaintPicture  ventil_lo, 538 * fx, 475 * fy, 39 * fx, 41 * fy
        PaintPicture  ventil_ro, 578 * fx, 475 * fy, 39 * fx, 41 * fy
      EndIf
      If i% = 1
        Color RGB(255, 255, 255)                      ' weiß
        PBox 592 * fx, 474 * fy, 602 * fx, 474 * fy + 1    ' Luft
        PBox 552 * fx, 474 * fy, 562 * fx, 474 * fy + 1    ' Luft
      EndIf
      If i% < Int(41 * fy)
        Color RGB(255, 255, 255)                      ' weiß
        PBox 538 * fx, 474 * fy, 614 * fx, 474 * fy - i%    ' Luft
        Color RGB(100, 220, 255)                        ' hellblau Wasser
        PBox Ceil(592 * fx), 796 * fy, 602 * fx, 792 * fy - i% * 7  ' Rohr zum Brunnen
      Else If i%  = Int(41 * fy)
        Color RGB(255, 255, 255)                      ' weiß
        PBox 538 * fx, 475 * fy - i% , 614 * fx, 475 * fy - i%    ' Luft
        PaintPicture  ventil_ra, 578 * fx, 475 * fy, 39 * fx, 41 * fy
        verzoegerung(5)
      Else If i% = Int(41 * fy) + 1
        Color RGB(255, 255, 255)                      ' weiß
        PBox 538 * fx, 475 * fy - i% , 614 * fx, 475 * fy - i%    ' Luft
        PaintPicture  ventil_rb, 578 * fx, 475 * fy, 39 * fx, 41 * fy
        verzoegerung(5)
      Else If i% = Int(41 * fy) + 2
        Color RGB(255, 255, 255)                      ' weiß
        PBox 538 * fx, 475 * fy - i% , 614 * fx, 475 * fy - i%    ' Luft
        PaintPicture  ventil_rc, 578 * fx, 475 * fy, 39 * fx, 41 * fy
        verzoegerung(5)
      Else If i% = Int(41 * fy) + 3
        Color RGB(255, 255, 255)                      ' weiß
        PBox 538 * fx, 475 * fy - i% , 614 * fx, 475 * fy - i%    ' Luft
        PaintPicture  ventil_rvo, 578 * fx, 475 * fy, 39 * fx, 41 * fy
        verzoegerung(5)
      Else
        If i% = Int(41 * fy) + 4
          PaintPicture  ventil_la, 538 * fx, 475 * fy, 39 * fx, 41 * fy
        EndIf
        Color RGB(255, 255, 255)                      ' weiß
        PBox 538 * fx, 475 * fy - i% , 614 * fx, 475 * fy - i%    ' Luft
        Color RGB(100, 220, 255)                        ' hellblau Wasser
        PBox 538 * fx, 474 * fy, 614 * fx, 474 * fy - (i% - 44 * fy)
        If i% >= Int(188 * fy)
          voll| = 1   ' Zylinder gefüllt, mit Luftblase
          verzoegerung(400)
          PaintPicture  ventil_rvu, 578 * fx, 475 * fy, 39 * fx, 41 * fy
        EndIf
      EndIf
      Color RGB(130, 130, 130)                        ' grau
      PBox 569 * fx, 220 * fy, 583 * fx, 221 * fy - i%     ' Kolbenstange
    Else If ansaugen| = 2    ' keine Luft im Zylinder
      DefLine 0, 1
      Color RGB(160, 50, 50)                                                                ' dunkelbraun
      PBox 538 * fx, 473 * fy - i%, 614 * fx, 453 * fy - i%           ' Kolben
      If i% = 0
        PaintPicture  ventil_lvo, 538 * fx, 475 * fy, 39 * fx, 41 * fy
        PaintPicture  ventil_rvo, 578 * fx, 475 * fy, 39 * fx, 41 * fy
      EndIf
      Color RGB(100, 220, 255)                        ' hellblau Wasser
      If i% = 1
        PBox 592 * fx, 474 * fy, 602 * fx, 474 * fy + 1    ' Luft
        PBox 552 * fx, 474 * fy, 562 * fx, 474 * fy + 1    ' Luft
      EndIf
      PBox 538 * fx, 474 * fy, 614 * fx, 474 * fy - i%
      Color RGB(130, 130, 130)                        ' grau
      PBox 569 * fx, 220 * fy, 583 * fx, 221 * fy - i%     ' Kolbenstange
      voll| = 2   ' Zylinder gefüllt, ohne Luftblase
      If i% >= Int(188 * fy)
        verzoegerung(400)
        PaintPicture  ventil_rvu, 578 * fx, 475 * fy, 39 * fx, 41 * fy
      EndIf
    Else If  v_links| = 1                                   ' Ansaugen von Luft aus dem Steigrohr
      DefLine 0, 1
      Color RGB(160, 50, 50)                                                                ' dunkelbraun
      PBox 538 * fx, 473 * fy - i%, 614 * fx, 453 * fy - i%           ' Kolben
      Color RGB(255, 255, 255)                      ' weiß
      If i% = 1
        Color RGB(255, 255, 255)                      ' weiß
        PBox 592 * fx, 474 * fy, 602 * fx, 474 * fy + 1    ' Luft
        PBox 552 * fx, 474 * fy, 562 * fx, 474 * fy + 1    ' Luft
      EndIf
      PBox 538 * fx, Fix(474 * fy), 614 * fx, 474 * fy - i%    ' Luft
      PaintPicture  ventil_ro, 538 * fx, 475 * fy, 39 * fx, 41 * fy
      Color RGB(130, 130, 130)                        ' grau
      PBox 569 * fx, 220 * fy, 583 * fx, 221 * fy - i%     ' Kolbenstange
      If i% >= Int(188 * fy)
        alert1("Weil die Pumpe durch die Leitung zum Hochbehälter leichte Luft ansaugen kann,", "bleibt das viel schwerere Wasser im Brunnen.")
        PaintPicture  ventil_ru, 538 * fx, 475 * fy, 39 * fx, 41 * fy
      EndIf
    Else If v_rechts| = 1 And v_links| = 2                                   ' kein Ansaugen
      PaintPicture  ventil_lo, 538 * fx, 475 * fy, 39 * fx, 41 * fy
      PaintPicture  ventil_lo, 578 * fx, 475 * fy, 39 * fx, 41 * fy
      If i% = Int(30 * fy)
        alert1("Beide Ventile verschließen den Eingang und verhindern,", "dass Luft oder Wasser angesaugt werden können.")
        PaintPicture  ventil_lu, 538 * fx, 475 * fy, 39 * fx, 41 * fy
        PaintPicture  ventil_lu, 578 * fx, 475 * fy, 39 * fx, 41 * fy
        GoTo weiter5
      EndIf
    EndIf
    verzoegerung(20 / fx)
  Next i%
  unten| = 0  ' Kolben oben
  weiter5:
Return
>Procedure nachunten2             ' Kolben nach unten mit Ventilen _X = 1024 oder 1152
  If voll| = 0  And v_links| = 1 And v_rechts| = 1  ' Auspumpen von Luft
    Get 538 * fx, 600 * fy, 656 * fx, 830 * fy, jj$
  EndIf
  For i% = 0 To 188 * fy
    Color RGB(160, 50, 50)                           ' dunkelbraun
    PBox 538 * fx, Ceil(266 * fy) + i%, 614 * fx, 286 * fy + i%     ' Kolben
    If voll| = 1  ' Pumpe voll, mit Luftblase, Ventile richtig
      If i% < 141 * fy
        Color RGB(255, 255, 255)                      ' weiß
        PBox 538 * fx, 285 * fy + Fix(47 * fy) + i%, 614 * fx, Fix(287 * fy) + Fix(47 * fy) + i%    ' Luft im Kolben
        Color RGB(100, 220, 255)                        ' hellblau Wasser
        DefLine 0, Fix(11 * fx)
        If i% = 0
          PaintPicture  ventil_la, 538 * fx, 475 * fy, 39 * fx, 41 * fy
          verzoegerung(5 / fx)
        Else If i% = 1
          PaintPicture  ventil_lb, 538 * fx, 475 * fy, 39 * fx, 41 * fy
          verzoegerung(5 / fx)
        Else If i% = 2
          PaintPicture  ventil_lc, 538 * fx, 475 * fy, 39 * fx, 41 * fy
          verzoegerung(5 / fx)
        Else If i% = 3
          PaintPicture  ventil_lvu, 538 * fx, 475 * fy, 39 * fx, 41 * fy
          verzoegerung(5 / fx)
        Else If i% < Int(9 * fy)
          DefLine 0, 1
          PBox 552 * fx, 515 * fy, Fix(562 * fx), 521 * fy + i% * 9  ' Rohre zum Hochbehälter
          DefLine 0, Fix(11 * fx)
          If i% = Int(9 * fy) - 1
            Line 557 * fx, 580 * fy, 557 * fx, 600 * fy
          EndIf
        Else If i% < 33 * fy
          If _X = 1024
'##B#
            Line 557 * fx, 600 * fy, 556 * fx - (i% - 8 * fy) * 8.3, 600 * fy
          Else
            Line 557 * fx, 600 * fy, 557 * fx - (i% - 9 * fy) * 9, 600 * fy
          EndIf
        Else If i% < 115 * fy
          If _X = 1024
            Line 350 * fx, 600 * fy, 350 * fx, 604 * fy - (i% - 33 * fy) * 7
          Else
            Line 350 * fx, 600 * fy, 350 * fx, 600 * fy - (i% - 33 * fy) * 7
          EndIf
        Else If i% < 130 * fy
          Line 347 * fx - (i% - 115 * fy) * 6.7,  30 * fy, 350 * fx, 30 * fy
        Else If  i% < 141 * fy
          Line 250 * fx,  30 * fy, 250 * fx, 35 * fy + (i% - 130 * fy) * 7
        EndIf
      Else If i% > 141 * fy And i% < Fix(143 * fy)
        DefLine 0, 1
        Color RGB(100, 220, 255)                        ' hellblau Wasser
        PBox 62 * fx,  209 * fy, 288 * fx, 205 * fy  ' Wasser im Hochbehälter
        DefLine 0, Fix(11 * fx)
        Color RGB(255, 255, 255)  ' weiß
        Line 250 * fx,  55 * fy, 250 * fx, 200 * fy ' Wasserfluss im Hochbehälter
        Get 525 * fx, 469 * fy, 537 * fx, 474 * fy, j$ ' Öffnung zur Entlüftung
        verzoegerung(1000)
        alert1("Die Luft aus dem Zylinder wird wieder durch eine kleine Öffnung entfernt,", "damit die Pumpe ganz mit Wasser gefüllt werden kann.")
        verzoegerung(400)
        DefLine 0, 1
        Color RGB(255, 255, 255)  ' weiß
        PBox 525 * fx, 469 * fy, 537 * fx, 474 * fy  ' Öffnung zur Entlüftung
        fuellung| = 1  ' keine Luft mehr im Zylinder
        ansaugen| = 2  ' Ansaugen ohne Luftblase
        wasserstand_h% = 205 * fy  ' Wasserstand im Hochbehälter nach der ersten Füllung
      EndIf
    Else If voll| = 2
      Color RGB(100, 220, 255)                        ' hellblau Wasser
      DefLine 0, Fix(11 * fx)
      If i% = 0
        PaintPicture  ventil_lvu, 538 * fx, 475 * fy, 39 * fx, 41 * fy
        PaintPicture  ventil_rvu, 578 * fx, 475 * fy, 39 * fx, 41 * fy
      EndIf
      If  i% < 22 * fy
        Line 250 * fx,  30 * fy, 250 * fx, 33 * fy + i% * 8  ' Wasserfluss in den Hochbehälter
      Else If i% > 178 * fy
        If 49 * fy + (i% - 178 * fy) * 8 < wasserstand_h% - i% / 3
          Color RGB(255, 255, 255)  ' weiß
          Line 250 * fx,  50 * fy, 250 * fx, 49 * fy + (i% - 178 * fy) * 8  ' Abdeckung: Wasser in den Hochbehälter
        EndIf
      EndIf
      If Mod(i%, 3) = 0 And i% > 5 * fy
        DefLine 0, 1
        Color RGB(100, 220, 255)                        ' hellblau Wasser
        PBox 62 * fx,  209 * fy, 288 * fx, wasserstand_h% - i% / 3  ' Wasser im Hochbehälter
      EndIf
      If i% = Int(188 * fy)
        DefLine 0, 1
        Color RGB(255, 255, 255)  ' weiß
        PBox 245 * fx,  55 * fy, 255 * fx, wasserstand_h% - i% / 3 + 1  ' Abdeckung: Wasser in den Hochbehälter
      EndIf
      If wasserstand_h% - i% / 3 <= 60 * fy
        DefLine 0, Fix(11 * fx)
        Color RGB(255, 255, 255)  ' weiß
        Line 250 * fx,  50 * fy, 250 * fx, 53 * fy  ' Abdeckung: Wasser in den Hochbehälter
        DefLine 0, 1
        Color RGB(250, 254, 253)
        PBox 240 * fx, 55 * fy, 260 * fx, 60 * fy  ' Abdeckung Auslauf zum Hochbehälter
        alert2("Sehr gut: Du hast den Hochbehälter wieder gefüllt.", "Die Pumpe kann jetzt von einem Motor angetrieben werden", "und die Häuser mit Wasser versorgen.")
        Repeat
          PeekEvent
        Until MouseK = 0
        fertig| = 1
        GoTo weiter4
      EndIf
      fuellung| = 1  ' keine Luft mehr im Zylinder
      ansaugen| = 2  ' Ansaugen ohne Luftblase
    Else If voll| = 2  ' Zylinder voll, keine Luft
      If i% < 47 * fy
        DefLine 0, Fix(11 * fx)
        Color RGB(100, 220, 255)                        ' hellblau Wasser
        Line 576 * fx, 480 * fy + i%, 576 * fx, 495 * fy + i% * 7
      EndIf
    Else If voll| = 0 And v_links| < 2 And v_rechts| = 2
      PaintPicture  ventil_ru, 538 * fx, 475 * fy, 39 * fx, 41 * fy
      alert1("Beide Ventile, sind geschlossen. Ändere ein Ventil,", "damit du die Luft aus dem Zylinder entfernen kannst!")
      GoTo weiter4
    Else If voll| = 0 And v_rechts| = 1 And v_links| = 1   ' Auspumpen von Luft
      DefLine 0, 0
      Color RGB(238, 255, 247)  ' Hintergrund
      PCircle 597 * fx, 803 * fy, 8 * fx
      If i% < 94 * fy
        PCircle 616 * fx + Rand(25 * fx) , 806 * fy - Rand(i%), 6 * fx - Rand(3 * fx)
        PCircle 578 * fx - Rand(25 * fx) , 806 * fy - Rand(i%), 6 * fx - Rand(3 * fx)
        If i% > 15 * fy
          PCircle 615 * fx + Rand(23 * fx) , 800 * fy - Rand(i%) / 1.5, 6 * fx - Rand(3 * fx)
          PCircle 579 * fx - Rand(23 * fx) , 800 * fy - Rand(i%) / 1.5, 6 * fx - Rand(3 * fx)
        EndIf
        If i% > 25 * fy
          PCircle 617 * fx + Rand(25 * fx) , 800 * fy - Rand(i%) / 2, 6 * fx - Rand(3 * fx)
          PCircle 577 * fx - Rand(25 * fx) , 800 * fy - Rand(i%) / 2, 6 * fx - Rand(3 * fx)
        EndIf
        If i% > 35 * fy
          PCircle 617 * fx + Rand(25 * fx) , 800 * fy - Rand(i%) / 3, 6 * fx - Rand(3 * fx)
          PCircle 577 * fx - Rand(25 * fx) , 800 * fy - Rand(i%) / 3, 6 * fx - Rand(3 * fx)
        EndIf
      Else
        PCircle 617 * fx + Rand(30 * fx) , 803 * fy - Rand(i% - 84 * fy) / 1.3, 6 * fx - Rand(3 * fx)
        PCircle 577 * fx - Rand(30 * fx) , 803 * fy - Rand(i% - 84 * fy) / 1.3, 6 * fx - Rand(3 * fx)
      EndIf
      PCircle 597 * fx + Rand(35 * fx), 805 * fy + Rand(20 * fy) , 6 * fx
      PCircle 597 * fx - Rand(35 * fx) , 805 * fy + Rand(20 * fy) , 6 * fx
    EndIf
    DefLine 0, 1
    Color RGB(255, 255, 255)                        ' weiß
    PBox 538 * fx, Ceil(266 * fy), 568 * fx, 265 * fy + i%    ' Luft neben Kolbenstange
    PBox 584 * fx, Ceil(266 * fy), 614 * fx, 265 * fy + i%    ' Luft neben Kolbenstange
    Color RGB(130, 130, 130)                        ' grau
    PBox 569 * fx, Ceil(266 * fy), 583 * fx, 265 * fy + i%     ' Kolbenstange
    Color RGB(244, 255, 251)                        ' heller Hintergrund
    PBox 569 * fx, 32 * fy, 583 * fx, 32 * fy + i%         ' Luft über Kolbenstange
    verzoegerung(20 / fx)
  Next i%
  Put 525 * fx, 469 * fy, j$
  Clr j$
  If voll| = 0 And v_rechts| = 1 And v_links| = 1   ' Auspumpen von Luft
    For i% = 0 To 100
      DefLine 0, 0
      Color RGB(100, 220, 255)                        ' hellblau Wasser
      PCircle 617 * fx + Rand(30 * fx) , 805 * fy - Rand(i% / 2.5), 8 * fx
      PCircle 577 * fx - Rand(30 * fx) , 805 * fy - Rand(i% / 2.5) , 8 * fx
      PCircle 597 * fx + Rand(35 * fx) , 805 * fy + Rand(15 * fx) , 8 * fx
      PCircle 597 * fx - Rand(35 * fx) , 805 * fy + Rand(15 * fx) , 8 * fx
      verzoegerung(1 / fx)
    Next i%
    Put 538 * fx, 600 * fy, jj$
    Clr jj$
  EndIf
  If voll| = 2
    wasserstand_h% = wasserstand_h% - i% / 3  ' Wasserstand im Hochbehälter
  EndIf
  voll| = 0  ' Zylinder leer
  unten| = 1  ' Kolben unten
  weiter4:
Return
>Procedure nachunten2_800     ' Kolben nach unten mit Ventilen _X = 800
  If voll| = 0  And v_links| = 1 And v_rechts| = 1  ' Auspumpen von Luft
    Get 538 * fx, 600 * fy, 656 * fx, 830 * fy, jj$
  EndIf
  For i% = 0 To 188 * fy - 1
    Color RGB(160, 50, 50)                           ' dunkelbraun
    PBox 538 * fx, Ceil(266 * fy) + i%, 614 * fx, 286 * fy + i%     ' Kolben
    If voll| = 1  ' Pumpe voll, mit Luftblase, Ventile richtig
      If i% < 142 * fy
        Color RGB(255, 255, 255)                      ' weiß
        PBox 538 * fx, Fix(286 * fy) + Fix(47 * fy) + i%, 614 * fx, Fix(287 * fy) + Fix(47 * fy) + i%    ' Luft im Kolben
        Color RGB(100, 220, 255)                        ' hellblau Wasser
        DefLine 0, Fix(11 * fx)
        If i% = 0
          PaintPicture  ventil_la, 538 * fx, 475 * fy, 39 * fx, 41 * fy
          verzoegerung(5 / fx)
        Else If i% = 1
          PaintPicture  ventil_lb, 538 * fx, 475 * fy, 39 * fx, 41 * fy
          verzoegerung(5 / fx)
        Else If i% = 2
          PaintPicture  ventil_lc, 538 * fx, 475 * fy, 39 * fx, 41 * fy
          verzoegerung(5 / fx)
        Else If i% = 3
          PaintPicture  ventil_lvu, 538 * fx, 475 * fy, 39 * fx, 41 * fy
          verzoegerung(5 / fx)
        Else If i% < Int(9 * fy)
          DefLine 0, 1
          PBox 553 * fx, 515 * fy, Fix(562 * fx), 521 * fy + i% * 9  ' Rohre zum Hochbehälter
          DefLine 0, Fix(11 * fx)
          If i% = Int(9 * fy) - 1
            Line 557 * fx, 580 * fy, 557 * fx, 600 * fy
          EndIf
        Else If i% < 33 * fy
          Line 557 * fx, 600 * fy, 567 * fx - (i% - 9 * fy + 1) * 9, 600 * fy
        Else If i% < 115 * fy
          Line 350 * fx, 599 * fy, 350 * fx, 599 * fy - (i% - 33 * fy) * 7
        Else If i% < 130 * fy
          Line Fix(351 * fx) - Fix(i% - 115 * fy) * 6.7,  30 * fy, 350 * fx, 30 * fy
        Else If  i% < 141 * fy
          Line 250 * fx,  30 * fy, 250 * fx, 35 * fy + (i% - 130 * fy) * 7
        EndIf
      Else If i% > 142 * fy And i% < Ceil(143 * fy)
        DefLine 0, 1
        Color RGB(100, 220, 255)                        ' hellblau Wasser
        PBox 62 * fx,  209 * fy, 288 * fx, 205 * fy  ' Wasser im Hochbehälter
        DefLine 0, Fix(11 * fx)
        Color RGB(255, 255, 255)  ' weiß
        Line 250 * fx,  55 * fy, 250 * fx, 200 * fy ' Wasserfluss im Hochbehälter
        Get 525 * fx, 469 * fy, 537 * fx, 474 * fy, j$ ' Öffnung zur Entlüftung
        verzoegerung(1000)
        alert1("Die Luft aus dem Zylinder wird wieder durch eine kleine Öffnung entfernt,", "damit die Pumpe ganz mit Wasser gefüllt werden kann.")
        verzoegerung(400)
        DefLine 0, 1
        Color RGB(255, 255, 255)  ' weiß
        PBox 525 * fx, 469 * fy, 537 * fx, 474 * fy  ' Öffnung zur Entlüftung
        fuellung| = 1  ' keine Luft mehr im Zylinder
        ansaugen| = 2  ' Ansaugen ohne Luftblase
        wasserstand_h% = 205 * fy  ' Wasserstand im Hochbehälter nach der ersten Füllung
      EndIf
    Else If voll| = 2
      Color RGB(100, 220, 255)                        ' hellblau Wasser
      DefLine 0, Fix(11 * fx)
      If i% = 0
        PaintPicture  ventil_lvu, 538 * fx, 475 * fy, 39 * fx, 41 * fy
        PaintPicture  ventil_rvu, 578 * fx, 475 * fy, 39 * fx, 41 * fy
      EndIf
      If  i% < 22 * fy
        Line 250 * fx,  30 * fy, 250 * fx, 30 * fy + i% * 8  ' Wasserfluss in den Hochbehälter
      Else If i% > 178 * fy
        If 49 * fy + (i% - 178 * fy) * 8 < wasserstand_h% - i% / 3
          Color RGB(255, 255, 255)  ' weiß
          Line 250 * fx,  50 * fy, 250 * fx, 49 * fy + (i% - 178 * fy) * 8  ' Abdeckung: Wasser in den Hochbehälter
        EndIf
      EndIf
      If Mod(i%, 3) = 0 And i% > 5 * fy
        DefLine 0, 1
        Color RGB(100, 220, 255)                        ' hellblau Wasser
        PBox 62 * fx,  209 * fy, 288 * fx, wasserstand_h% - i% / 3  ' Wasser im Hochbehälter
      EndIf
      If i% >= 188 * fy - 1
        DefLine 0, 1
        Color RGB(255, 255, 255)  ' weiß
        PBox 245 * fx,  55 * fy, 255 * fx, wasserstand_h% - i% / 3  ' Abdeckung: Wasser in den Hochbehälter
      EndIf
      If wasserstand_h% - i% / 3 <= 60 * fy
        DefLine 0, Fix(11 * fx)
        Color RGB(255, 255, 255)  ' weiß
        Line 250 * fx,  50 * fy, 250 * fx, 53 * fy  ' Abdeckung: Wasser in den Hochbehälter
        DefLine 0, 1
        Color RGB(250, 254, 253)
        PBox 240 * fx, 55 * fy, 260 * fx, 60 * fy  ' Abdeckung Auslauf zum Hochbehälter
        alert2("Sehr gut: Du hast den Hochbehälter wieder gefüllt.", "Die Pumpe kann jetzt von einem Motor angetrieben werden", "und die Häuser mit Wasser versorgen.")
        Repeat
          PeekEvent
        Until MouseK = 0
        fertig| = 1
        GoTo weiter4
      EndIf
      fuellung| = 1  ' keine Luft mehr im Zylinder
      ansaugen| = 2  ' Ansaugen ohne Luftblase
    Else If voll| = 2  ' Zylinder voll, keine Luft
      If i% < 47 * fy
        DefLine 0, Fix(11 * fx)
        Color RGB(100, 220, 255)                        ' hellblau Wasser
        Line 576 * fx, 480 * fy + i%, 576 * fx, 495 * fy + i% * 7
      EndIf
    Else If voll| = 0 And v_links| < 2 And v_rechts| = 2
      PaintPicture  ventil_ru, 538 * fx, 475 * fy, 39 * fx, 41 * fy
      alert1("Beide Ventile, sind geschlossen. Ändere ein Ventil,", "damit du die Luft aus dem Zylinder entfernen kannst!")
      GoTo weiter4
    Else If voll| = 0 And v_rechts| = 1 And v_links| = 1   ' Auspumpen von Luft
      DefLine 0, 0
      Color RGB(238, 255, 247)  ' Hintergrund
      PCircle 597 * fx, 803 * fy, 8 * fx
      If i% < 94 * fy
        PCircle 616 * fx + Rand(25 * fx) , 806 * fy - Rand(i%), 6 * fx - Rand(3 * fx)
        PCircle 578 * fx - Rand(25 * fx) , 806 * fy - Rand(i%), 6 * fx - Rand(3 * fx)
        If i% > 15 * fy
          PCircle 615 * fx + Rand(23 * fx) , 800 * fy - Rand(i%) / 1.5, 6 * fx - Rand(3 * fx)
          PCircle 579 * fx - Rand(23 * fx) , 800 * fy - Rand(i%) / 1.5, 6 * fx - Rand(3 * fx)
        EndIf
        If i% > 25 * fy
          PCircle 617 * fx + Rand(25 * fx) , 800 * fy - Rand(i%) / 2, 6 * fx - Rand(3 * fx)
          PCircle 577 * fx - Rand(25 * fx) , 800 * fy - Rand(i%) / 2, 6 * fx - Rand(3 * fx)
        EndIf
        If i% > 35 * fy
          PCircle 617 * fx + Rand(25 * fx) , 800 * fy - Rand(i%) / 3, 6 * fx - Rand(3 * fx)
          PCircle 577 * fx - Rand(25 * fx) , 800 * fy - Rand(i%) / 3, 6 * fx - Rand(3 * fx)
        EndIf
      Else
        PCircle 617 * fx + Rand(30 * fx) , 803 * fy - Rand(i% - 84 * fy) / 1.3, 6 * fx - Rand(3 * fx)
        PCircle 577 * fx - Rand(30 * fx) , 803 * fy - Rand(i% - 84 * fy) / 1.3, 6 * fx - Rand(3 * fx)
      EndIf
      PCircle 597 * fx + Rand(35 * fx), 805 * fy + Rand(20 * fy) , 6 * fx
      PCircle 597 * fx - Rand(35 * fx) , 805 * fy + Rand(20 * fy) , 6 * fx
    EndIf
    DefLine 0, 1
    Color RGB(255, 255, 255)                        ' weiß
    PBox 538 * fx, Ceil(266 * fy), 568 * fx, 265 * fy + i%    ' Luft neben Kolbenstange
    PBox 584 * fx, Ceil(266 * fy), 614 * fx, 265 * fy + i%    ' Luft neben Kolbenstange
    Color RGB(130, 130, 130)                        ' grau
    PBox 569 * fx, Ceil(266 * fy), 583 * fx, 265 * fy + i%     ' Kolbenstange
    Color RGB(244, 255, 251)                        ' heller Hintergrund
    PBox 569 * fx, 32 * fy, 583 * fx, 32 * fy + i%         ' Luft über Kolbenstange
    verzoegerung(20 / fx)
  Next i%
  Put 525 * fx, 469 * fy, j$
  Clr j$
  If voll| = 0 And v_rechts| = 1 And v_links| = 1   ' Auspumpen von Luft
    For i% = 0 To 100
      DefLine 0, 0
      Color RGB(100, 220, 255)                        ' hellblau Wasser
      PCircle 617 * fx + Rand(30 * fx) , 805 * fy - Rand(i% / 2.5), 8 * fx
      PCircle 577 * fx - Rand(30 * fx) , 805 * fy - Rand(i% / 2.5) , 8 * fx
      PCircle 597 * fx + Rand(35 * fx) , 805 * fy + Rand(15 * fx) , 8 * fx
      PCircle 597 * fx - Rand(35 * fx) , 805 * fy + Rand(15 * fx) , 8 * fx
      verzoegerung(1 / fx)
    Next i%
    Put 538 * fx, 600 * fy, jj$
    Clr jj$
  EndIf
  If voll| = 2
    wasserstand_h% = wasserstand_h% - i% / 3  ' Wasserstand im Hochbehälter
  EndIf
  voll| = 0  ' Zylinder leer
  unten| = 1  ' Kolben unten
  weiter4:
Return
>Procedure nachunten2_1600   ' Kolben nach unten mit Ventilen _X = 1600 oder 1280
  If voll| = 0  And v_links| = 1 And v_rechts| = 1  ' Auspumpen von Luft
    Get 538 * fx, 600 * fy, 656 * fx, 830 * fy, jj$
  EndIf
  For i% = 0 To Int(188 * fy) + 1
    Color RGB(160, 50, 50)                           ' dunkelbraun
    PBox 538 * fx, Ceil(266 * fy) + i%, 614 * fx, 286 * fy + i%     ' Kolben
    If voll| = 1  ' Pumpe voll, mit Luftblase, Ventile richtig
      If i% < 141 * fy
        Color RGB(255, 255, 255)                      ' weiß
        PBox 538 * fx, 286 * fy + 47 * fy + i% - 4, 614 * fx, 287 * fy + 47 * fy + i%    ' Luft im Kolben
        Color RGB(100, 220, 255)                        ' hellblau Wasser
        DefLine 0, Fix(11 * fx)
        If i% = 0
          PaintPicture  ventil_la, 538 * fx, 475 * fy, 39 * fx, 41 * fy
          verzoegerung(5 / fx)
        Else If i% = 1
          PaintPicture  ventil_lb, 538 * fx, 475 * fy, 39 * fx, 41 * fy
          verzoegerung(5 / fx)
        Else If i% = 2
          PaintPicture  ventil_lc, 538 * fx, 475 * fy, 39 * fx, 41 * fy
          verzoegerung(5 / fx)
        Else If i% = 3
          PaintPicture  ventil_lvu, 538 * fx, 475 * fy, 39 * fx, 41 * fy
          verzoegerung(5 / fx)
        Else If i% < Int(9 * fy)
          DefLine 0, 1
          PBox Fix(552 * fx), 515 * fy, 562 * fx, 521 * fy + i% * 9  ' Rohre zum Hochbehälter
          DefLine 0, Fix(11 * fx)
          If i% = Int(9 * fy) - 1
            Line 557 * fx, 580 * fy, 557 * fx, 600 * fy
          EndIf
        Else If i% < 33 * fy
          Line 557 * fx, 600 * fy, Min(557 * fx, 562 * fx - (i% - 9 * fy) * 9), 600 * fy
        Else If i% < 115 * fy
          Line 350 * fx, 600 * fy, 350 * fx, Min(600 * fy, 603 * fy - (i% - 33 * fy) * 7)
        Else If i% < 130 * fy
          Line 349 * fx - (i% - 115 * fy) * 6.7,  30 * fy, 350 * fx, 30 * fy
        Else If  i% < 141 * fy
          Line 250 * fx,  30 * fy, 250 * fx, 39 * fy + (i% - 130 * fy) * 7
        EndIf
      Else If i% > Int(141 * fy) And i% < Int(143 * fy)
        DefLine 0, 1
        Color RGB(100, 220, 255)                        ' hellblau Wasser
        PBox 62 * fx,  209 * fy, 288 * fx, 205 * fy  ' Wasser im Hochbehälter
        DefLine 0, Fix(11 * fx)
        Color RGB(255, 255, 255)  ' weiß
        Line 250 * fx,  55 * fy, 250 * fx, 200 * fy ' Wasserfluss im Hochbehälter
        Get 525 * fx, 469 * fy, 537 * fx, 474 * fy + 1, j$ ' Öffnung zur Entlüftung
        verzoegerung(1000)
        alert1("Die Luft aus dem Zylinder wird wieder durch eine kleine Öffnung entfernt,", "damit die Pumpe ganz mit Wasser gefüllt werden kann.")
        verzoegerung(400)
        DefLine 0, 1
        Color RGB(255, 255, 255)  ' weiß
        PBox 525 * fx, 469 * fy, 537 * fx, 474 * fy + 1   ' Öffnung zur Entlüftung
        fuellung| = 1  ' keine Luft mehr im Zylinder
        ansaugen| = 2  ' Ansaugen ohne Luftblase
        wasserstand_h% = 205 * fy  ' Wasserstand im Hochbehälter nach der ersten Füllung
      EndIf
    Else If voll| = 2
      Color RGB(100, 220, 255)                        ' hellblau Wasser
      DefLine 0, Fix(11 * fx)
      If i% = 0
        PaintPicture  ventil_lvu, 538 * fx, 475 * fy, 39 * fx, 41 * fy
        PaintPicture  ventil_rvu, 578 * fx, 475 * fy, 39 * fx, 41 * fy
      EndIf
      If  i% < 22 * fy
        Line 250 * fx,  30 * fy, 250 * fx, 30 * fy + i% * 7.7  ' Wasserfluss in den Hochbehälter
      Else If i% > 178 * fy
        If 49 * fy + (i% - 178 * fy) * 8 < wasserstand_h% - i% / 3
          Color RGB(255, 255, 255)  ' weiß
          Line 250 * fx,  55 * fy, 250 * fx, 55 * fy + (i% - 178 * fy) * 7  ' Abdeckung: Wasser in den Hochbehälter
        EndIf
      EndIf
      If Mod(i%, 3) = 0 And i% > 5 * fy
        DefLine 0, 1
        Color RGB(100, 220, 255)                        ' hellblau Wasser
        PBox 62 * fx,  209 * fy, 288 * fx, wasserstand_h% - i% / 3  ' Wasser im Hochbehälter
      EndIf
      If i% >= Int(188 * fy)
        DefLine 0, 1
        Color RGB(255, 255, 255)  ' weiß
        PBox 245 * fx,  55 * fy, 255 * fx, wasserstand_h% - i% / 3 ' Abdeckung: Wasser in den Hochbehälter
      EndIf
      If wasserstand_h% - i% / 3 <= 60 * fy
        DefLine 0, Fix(11 * fx)
        Color RGB(255, 255, 255)  ' weiß
        Line 250 * fx,  55 * fy, 250 * fx, 55 * fy  ' Abdeckung: Wasser in den Hochbehälter
        DefLine 0, 1
        Color RGB(250, 254, 253)
        PBox 240 * fx, 55 * fy, 260 * fx, 60 * fy  ' Abdeckung Auslauf zum Hochbehälter
        alert2("Sehr gut: Du hast den Hochbehälter wieder gefüllt.", "Die Pumpe kann jetzt von einem Motor angetrieben werden", "und die Häuser mit Wasser versorgen.")
        Repeat
          PeekEvent
        Until MouseK = 0
        fertig| = 1
        GoTo weiter4
      EndIf
      fuellung| = 1  ' keine Luft mehr im Zylinder
      ansaugen| = 2  ' Ansaugen ohne Luftblase
    Else If voll| = 2  ' Zylinder voll, keine Luft
      If i% < 47 * fy
        DefLine 0, Fix(11 * fx)
        Color RGB(100, 220, 255)                        ' hellblau Wasser
        Line 576 * fx, 480 * fy + i%, 576 * fx, 495 * fy + i% * 7
      EndIf
    Else If voll| = 0 And v_links| < 2 And v_rechts| = 2
      PaintPicture  ventil_ru, 538 * fx, 475 * fy, 39 * fx, 41 * fy
      alert1("Beide Ventile, sind geschlossen. Ändere ein Ventil,", "damit du die Luft aus dem Zylinder entfernen kannst!")
      GoTo weiter4
    Else If voll| = 0 And v_rechts| = 1 And v_links| = 1   ' Auspumpen von Luft
      DefLine 0, 0
      Color RGB(238, 255, 247)  ' Hintergrund
      PCircle 597 * fx, 803 * fy, 8 * fx
      If i% < 94 * fy
        PCircle 616 * fx + Rand(25 * fx) , 806 * fy - Rand(i%), 6 * fx - Rand(3 * fx)
        PCircle 578 * fx - Rand(25 * fx) , 806 * fy - Rand(i%), 6 * fx - Rand(3 * fx)
        If i% > 15 * fy
          PCircle 615 * fx + Rand(23 * fx) , 800 * fy - Rand(i%) / 1.5, 6 * fx - Rand(3 * fx)
          PCircle 579 * fx - Rand(23 * fx) , 800 * fy - Rand(i%) / 1.5, 6 * fx - Rand(3 * fx)
        EndIf
        If i% > 25 * fy
          PCircle 617 * fx + Rand(25 * fx) , 800 * fy - Rand(i%) / 2, 6 * fx - Rand(3 * fx)
          PCircle 577 * fx - Rand(25 * fx) , 800 * fy - Rand(i%) / 2, 6 * fx - Rand(3 * fx)
        EndIf
        If i% > 35 * fy
          PCircle 617 * fx + Rand(25 * fx) , 800 * fy - Rand(i%) / 3, 6 * fx - Rand(3 * fx)
          PCircle 577 * fx - Rand(25 * fx) , 800 * fy - Rand(i%) / 3, 6 * fx - Rand(3 * fx)
        EndIf
      Else
        PCircle 617 * fx + Rand(30 * fx) , 803 * fy - Rand(i% - 84 * fy) / 1.3, 6 * fx - Rand(3 * fx)
        PCircle 577 * fx - Rand(30 * fx) , 803 * fy - Rand(i% - 84 * fy) / 1.3, 6 * fx - Rand(3 * fx)
      EndIf
      PCircle 597 * fx + Rand(35 * fx), 805 * fy + Rand(20 * fy) , 6 * fx
      PCircle 597 * fx - Rand(35 * fx) , 805 * fy + Rand(20 * fy) , 6 * fx
    EndIf
    DefLine 0, 1
    Color RGB(255, 255, 255)                        ' weiß
    PBox 538 * fx, 266 * fy, 568 * fx, 265 * fy + i%    ' Luft neben Kolbenstange
    PBox 584 * fx, 266 * fy, 614 * fx, 265 * fy + i%    ' Luft neben Kolbenstange
    Color RGB(130, 130, 130)                        ' grau
    PBox 569 * fx, Ceil(266 * fy), 583 * fx, 265 * fy + i%     ' Kolbenstange
    Color RGB(244, 255, 251)                        ' heller Hintergrund
    PBox 569 * fx, 32 * fy, 583 * fx, 32 * fy + i%         ' Luft über Kolbenstange
    verzoegerung(20 / fx)
  Next i%
  Put 525 * fx, 469 * fy, j$
  Clr j$
  If voll| = 0 And v_rechts| = 1 And v_links| = 1   ' Auspumpen von Luft
    For i% = 0 To 100
      DefLine 0, 0
      Color RGB(100, 220, 255)                        ' hellblau Wasser
      PCircle 617 * fx + Rand(30 * fx) , 805 * fy - Rand(i% / 2.5), 8 * fx
      PCircle 577 * fx - Rand(30 * fx) , 805 * fy - Rand(i% / 2.5) , 8 * fx
      PCircle 597 * fx + Rand(35 * fx) , 805 * fy + Rand(15 * fx) , 8 * fx
      PCircle 597 * fx - Rand(35 * fx) , 805 * fy + Rand(15 * fx) , 8 * fx
      verzoegerung(1 / fx)
    Next i%
    Put 538 * fx, 600 * fy, jj$
    Clr jj$
  EndIf
  If voll| = 2
    wasserstand_h% = wasserstand_h% - i% / 3  ' Wasserstand im Hochbehälter
  EndIf
  voll| = 0  ' Zylinder leer
  unten| = 1  ' Kolben unten
  weiter4:
Return
>Procedure wasserleitung          ' Wasserleitung zum Hochbehälter und zu den Häusern verlegen
  DefLine 0, 1
  Color RGB(0, 0, 0)
  PBox 45 * fx, 343 * fy, 66 * fx, 360 * fy   ' Eingang zum Wasserhochbehälter
  Color RGB(193, 242, 255)     ' Luft
  PBox 81 * fx, 334 * fy, 95 * fx, 348 * fy ' Eingang
  DefLine 0, 1
  Color RGB(147, 209, 66)  '  grün
  PBox 79 * fx, 349 * fy, 94 * fx, 351 * fy
  Color RGB(80, 80, 80) ' dunkelgrau, Wasserhochbehälter
  PBox 42 * fx, 334 * fy, 80 * fx, 362 * fy
  Color RGB(255, 255, 255) ' weiß, Luft
  PBox 45 * fx, 338 * fy, 77 * fx, 343 * fy
  PBox 70 * fx, 338 * fy, 77 * fx, 345 * fy
  Color RGB(255, 255, 255)       ' weiß, Eingang, Platz für Wasser
  PBox 69 * fx, 341 * fy, 80 * fx, 348 * fy
  PBox 45 * fx, 343 * fy, 66 * fx, 358 * fy
  Color RGB(0, 0, 0)       ' schwarz
  PBox 67 * fx, 342 * fy, 69 * fx, 351 * fy
  PBox 69 * fx, 349 * fy, 80 * fx, 351 * fy
  Color RGB(255, 255, 255)  ' weiß
  PBox Ceil(518 * fx), 520 * fy, 528 * fx, 655 * fy  ' Brunnen
  Color RGB(100, 30, 30)  ' dunkelbraun
  DefLine 0, 2 * fx
  Line 519 * fx, 515 * fy, 519 * fx, 711 * fy  ' Brunnenwand
  Line 528 * fx, 515 * fy, 528 * fx, 711 * fy
  Color RGB(100, 220, 255)       ' hellblau Wasser
  PBox Fix(521 * fx), Fix(656 * fy), Ceil(526 * fx), 712 * fy
  DefLine 0, 3
  Color RGB(0, 0, 0)  ' schwarz
  Line 522 * fx, 645 * fy, 522 * fx, 690 * fy  ' Saugleitung
  Line Ceil(516 * fx), 645 * fy, Ceil(516 * fx), 650 * fy ' Ausfluss Pumpe
  DefLine 0, 1
  Color RGB(100, 220, 255)  ' hellblau Wasser
  Line 522 * fx, 645 * fy, 522 * fx, 693 * fy  ' Saugleitung
  Line Ceil(516 * fx), 645 * fy, Ceil(516 * fx), 650 * fy  ' Ausfluss Pumpe
  Color RGB(0, 0, 0)  ' schwarz
  PRBox 514 * fx, Fix(630 * fy), 524 * fx, 645 * fy  '  Pumpe
  Color RGB(255, 0, 0)  ' rot
  PRBox 515 * fx, 631 * fy, 523 * fx, 644 * fy  '  Pumpe
  verzoegerung(400)
  alert1("Klicke auf die rote Pumpe im Brunnen. Dann wird", "eine Leitung durch den Brunnen nach oben verlegt und mit Wasser gefüllt.")
  neu6:
  Repeat
    j$ = InKey$
    Mouse x, y, k%
  Until k% = 1 And x > 515 * fx And x < 523 * fx And y > 631 * fy And y < 644 * fy Or Len(j$) = 2 And (Asc(Right$(j$)) = 119) 'F8
  If Len(j$) = 2 And (Asc(Right$(j$)) = 119)  'F8
    alert3("Willst du wirklich aufhören?", "Ende", "zurück")
    If alertf| = 1
      ende
    Else
      GoTo neu6
    EndIf
  EndIf
  DefLine 0, 3
  Color RGB(0, 0, 0)  ' schwarz Leitungen
  For i% = 1 To 9 * fx
    Line 516 * fx, 650 * fy, 516 * fx - i%, 650 * fy  ' Leitung zum Brunnenrand
    verzoegerung(15 / fx)
  Next i%
  For i% = 1 To 25 * fx
    Line 507 * fx, 650 * fy, 507 * fx, 650 * fy - i%
    verzoegerung(15 / fx)
  Next i%
  For i% = 1 To 15 * fx
    Line 507 * fx, 625 * fy, 507 * fx + i%, 625 * fy
    verzoegerung(15 / fx)
  Next i%
  For i% = 1 To 73 * fx
    Line 522 * fx, 625 * fy, 522 * fx, 625 * fy - i%
    verzoegerung(15 / fx)
  Next i%
  Line 516 * fx, 648 * fy, 516 * fx, 650 * fy  ' Leitung zum Brunnenrand
  DefLine 0, 1
  Color RGB(100, 220, 255)  ' hellblau Wasser
  Line Ceil(516 * fx), 645 * fy, Ceil(516 * fx), 650 * fy  ' Ausfluss Pumpe
  For i% = 1 To 9 * fx
    Line Ceil(516 * fx), 650 * fy, 516 * fx - i%, 650 * fy  ' Leitung zum Hochbehälter
    verzoegerung(15 / fx)
  Next i%
  For i% = 1 To 25 * fx
    Line 507 * fx, 650 * fy, 507 * fx, 650 * fy - i%
    verzoegerung(15 / fx)
  Next i%
  For i% = 1 To 15 * fx
    Line 507 * fx, 625 * fy, 507 * fx + i%, 625 * fy
    verzoegerung(15 / fx)
  Next i%
  For i% = 1 To 73 * fx
    Line 522 * fx, 625 * fy, 522 * fx, 625 * fy - i%
    verzoegerung(15 / fx)
  Next i%
  verzoegerung(400)
  alert1("Klicke jetzt auf den Wasserhochbehälter.", "Die Leitung wird dann bis dorthin verlegt und der Behälter mit Wasser gefüllt.")
  neu7:
  Repeat
    j$ = InKey$
    Mouse x, y, k%
  Until k% = 1 And x > 42 * fx And x < 77 * fx And y > 338 * fy And y < 362 * fy Or Len(j$) = 2 And (Asc(Right$(j$)) = 119) 'F8
  If Len(j$) = 2 And (Asc(Right$(j$)) = 119)  'F8
    alert3("Willst du wirklich aufhören?", "Ende", "zurück")
    If alertf| = 1
      ende
    Else
      GoTo neu7
    EndIf
  EndIf
  DefLine 0, 3
  Color RGB(0, 0, 0)  ' schwarz Leitungen
  For i% = 1 To 183 * fx
    Line Fix(522 * fx), 552 * fy, 522 * fx - i%, 552 * fy - i% * 110 / 183  ' Steigung: y / x
    verzoegerung(15 / fx)
  Next i%
  For i% = 1 To 185 * fx
    Line 339 * fx, 442 * fy, 339 * fx - i%, 442 * fy - i% * 16 / 185
    verzoegerung(15 / fx)
  Next i%
  For i% = 1 To 85 * fx
    Line 154 * fx, 426 * fy, 154 * fx - i%, 426 * fy - i% * 57 / 85
    verzoegerung(15 / fx)
  Next i%
  For i% = 1 To 34 * fx
    Line 69 * fx, 369 * fy, 69 * fx - i%, 369 * fy
    verzoegerung(15 / fx)
  Next i%
  For i% = 1 To 30 * fx
    Line 35 * fx, 369 * fy, 35 * fx, 369 * fy - i%
    verzoegerung(15 / fx)
  Next i%
  For i% = 1 To 15 * fx
    Line 35 * fx, 339 * fy, 35 * fx + i%, 339 * fy
    verzoegerung(15 / fx)
  Next i%
  For i% = 1 To 3 * fx
    Line 50 * fx, 339 * fy, 50 * fx , 339 * fy + i%
    verzoegerung(15 / fx)
  Next i%
  DefLine 0, 1
  Color RGB(100, 220, 255)  ' hellblau Wasser
  For i% = 1 To 183 * fx
    Line Fix(522 * fx), 553 * fy, Fix(522 * fx) - i%, Fix(552 * fy) - i% * 110 / 183  ' Steigung: y / x
    verzoegerung(15 / fx)
  Next i%
  For i% = 1 To 185 * fx
    Line 339 * fx, 442 * fy, 339 * fx - i%, 442 * fy - i% * 16 / 185
    verzoegerung(15 / fx)
  Next i%
  For i% = 1 To 85 * fx
    Line 154 * fx, 426 * fy, 154 * fx - i%, 426 * fy - i% * 57 / 85
    verzoegerung(15 / fx)
  Next i%
  For i% = 1 To 34 * fx
    Line 69 * fx, 369 * fy, 69 * fx - i%, 369 * fy
    verzoegerung(15 / fx)
  Next i%
  For i% = 1 To 30 * fx
    Line 35 * fx, 369 * fy, 35 * fx, 369 * fy - i%
    verzoegerung(15 / fx)
  Next i%
  For i% = 1 To 15 * fx
    Line 35 * fx, 339 * fy, 37 * fx + i%, 339 * fy
    verzoegerung(15 / fx)
  Next i%
  For i% = 1 To 3 * fx
    Line 50 * fx, 339 * fy, 50 * fx , 339 * fy + i%
    verzoegerung(15 / fx)
  Next i%
  Line 50 * fx, 339 * fy, 50 * fx , 359 * fy  ' Einfluss Hochbehälter
  For i% = 1 To 17 * fx
    PBox 45 * fx, Ceil(359 * fy), 66 * fx , 359 * fy - i% ' Wasser im Hochbehölter
    verzoegerung(200 / fx)
  Next i%
  verzoegerung(300)
  alert1("Klicke jetzt auf das letzte Haus auf der rechten Seite.", "Dann wird vom Hochbehälter aus die Versorgungsleitung für alle Häuser verlegt.")
  verzoegerung(400)
  neu8:
  Repeat
    j$ = InKey$
    Mouse x, y, k%
  Until k% = 1 And x > 1099 * fx And x < 1133 * fx And y > 400 * fy And y < 430 * fy Or Len(j$) = 2 And (Asc(Right$(j$)) = 119) 'F8
  If Len(j$) = 2 And (Asc(Right$(j$)) = 119)  'F8
    alert3("Willst du wirklich aufhören?", "Ende", "zurück")
    If alertf| = 1
      ende
    Else
      GoTo neu8
    EndIf
  EndIf
  DefLine 0, 3
  Color RGB(0, 0, 0)  ' schwarz Leitungen
  For i% = 1 To 12 * fx
    Line 68 * fx, 358 * fy, 68 * fx + i%, 358 * fy
    verzoegerung(15 / fx)
  Next i%
  For i% = 1 To 88 * fx
    Line 80 * fx, 358 * fy, 80 * fx + i%, 358 * fy + i% * 59 / 88
    verzoegerung(15 / fx)
  Next i%
  For i% = 1 To 174 * fx
    Line 168 * fx, 417 * fy, 168 * fx + i%, 417 * fy + i% * 15 / 174
    verzoegerung(15 / fx)
  Next i%
  For i% = 1 To 176 * fx
    Line 342 * fx, 432 * fy, Fix(342 * fx) + i%, 432 * fy + i% * 105 / 176
    verzoegerung(15 / fx)
  Next i%
  For i% = 1 To 68 * fx
    Line Ceil(529 * fx), 539 * fy, 529 * fx + i%, 539 * fy
    verzoegerung(15 / fx)
  Next i%
  For i% = 1 To 100 * fx
    Line Fix(597 * fx), 539 * fy, 597 * fx + i%, 539 * fy - i% * 70 / 100
    verzoegerung(15 / fx)
  Next i%
  For i% = 1 To 441 * fx
    Line 697 * fx, 469 * fy, 697 * fx + i%, 469 * fy - i% * 35 / 441
    verzoegerung(15 / fx)
  Next i%
  DefLine 0, 1
  Color RGB(100, 220, 255)  ' hellblau Wasser
  For i% = 1 To 12 * fx
    Line 66 * fx, 358 * fy, Ceil(68 * fx) + i%, 358 * fy
    verzoegerung(15 / fx)
  Next i%
  For i% = 1 To 88 * fx
    Line 80 * fx, 358 * fy, 80 * fx + i%, 358 * fy + i% * 59 / 88
    verzoegerung(15 / fx)
  Next i%
  For i% = 1 To 174 * fx
    Line Fix(168 * fx), Fix(417 * fy), 168 * fx + i%, 417 * fy + i% * 15 / 174
    verzoegerung(15 / fx)
  Next i%
  For i% = 1 To 176 * fx
    Line Fix(342 * fx), 432 * fy, 342 * fx + i%, 432 * fy + i% * 105 / 176
    verzoegerung(15 / fx)
  Next i%
  For i% = 1 To 68 * fx
    Line Ceil(529 * fx), 539 * fy, 529 * fx + i%, 539 * fy
    verzoegerung(15 / fx)
  Next i%
  For i% = 1 To 100 * fx
    Line Fix(597 * fx), 539 * fy, 597 * fx + i%, 539 * fy - i% * 70 / 100
    verzoegerung(15 / fx)
  Next i%
  For i% = 1 To 441 * fx
    Line 697 * fx, 469 * fy, 697 * fx + i%, 469 * fy - i% * 35 / 441
    verzoegerung(15 / fx)
  Next i%
  Line Fix(65 * fx), 358 * fy, 80 * fx, 358 * fy  '     Ausfluss Hochbehälter
  alert2("Klicke jetzt auf den unteren Rand jedes Hauses!", "Es wird dann an die Wasserleitung angeschlossen.", "Den Wasseranschluss eures Hauses kannst du im Keller finden.")
  h| = 0  ' Zahl der an die Wasserleitung angeschlossenen Häuser
  beginn| = 0
  Clr h1|, h2|, h3|, h4|, h5|, h6|, h7|, h8|, h9|, h10|  ' Anschluss der einzelnen Häuser
  zurueck5:
  Repeat
    j$ = InKey$
    Mouse x, y, k%
  Until k% = 1 Or (Len(j$) = 2 And (Asc(Right$(j$)) = 119)) ' F8
  If beginn| = 0
    beginn| = 1
    GraphMode R2_COPYPEN, TRANSPARENT
    DefLine 0, 1
    Color RGB(100, 0, 0) ' dunkelbraun
    PBox 10 * fx, 535 * fy, 350 * fx, 750 * fy
    Color RGB(255, 0, 0) ' rot
    Box 15 * fx, 540 * fy, 345 * fx, 745 * fy
    Color RGB(249, 254, 231)  ' Hintergrund
    PBox 21 * fx, 546 * fy, 339 * fx, 738 * fy
    Color RGB(0, 0, 0) ' schwarz
    SetFont schrift1%
    Text 80 * fx, 570 * fy, "Haus 1"
    Text 80 * fx, 600 * fy, "Haus 2"
    Text 80 * fx, 630 * fy, "Haus 3"
    Text 80 * fx, 660 * fy, "Haus 4"
    Text 80 * fx, 690 * fy, "Haus 5"
    Text 230 * fx, 570 * fy, "Haus   6"
    Text 230 * fx, 600 * fy, "Haus   7"
    Text 230 * fx, 630 * fy, "Haus   8"
    Text 230 * fx, 660 * fy, "Haus   9"
    Text 230 * fx, 690 * fy, "Haus 10"
  EndIf
  If Len(j$) = 2 And (Asc(Right$(j$)) = 119) Or (x > 965 * fx And x < 1100 * fx And y > 723 * fy And y < 763 * fy) ' F8 oder Ende
    GoTo weiter6
  Else If x > 965 * fx And x < 1100 * fx And y > 773 * fy And y < 813 * fy  ' Drucken
    alert3("Ist der Drucker angeschaltet?", "ja", "nein")
    If alertf| = 1
      drucken
    EndIf
    GoTo zurueck5
  Else If x > 168 * fx And x < 198 * fx And y > 403 * fy And y < 413 * fy And h1| = 0 ' Haus 1
    hausanschluss(x, y)
    Color RGB(190, 255, 255) ' hellblau
    PBox 50 * fx, 572 * fy, 70 * fx, 592 * fy
    Color RGB(100, 0, 0) ' dunkelbraun
    Box 50 * fx, 572 * fy, 70 * fx, 592 * fy
    h1| = 1
  Else If x > 220 * fx And x < 250 * fx And y > 408 * fy And y < 418 * fy And h2| = 0 ' Haus 2
    hausanschluss(x, y)
    Color RGB(190, 255, 255) ' hellblau
    PBox 50 * fx, 602 * fy, 70 * fx, 622 * fy
    Color RGB(100, 0, 0) ' dunkelbraun
    Box 50 * fx, 602 * fy, 70 * fx, 622 * fy
    h2| = 1
  Else If x > 263 * fx And x < 293 * fx And y > 410 * fy And y < 420 * fy And h3| = 0 ' Haus 3
    hausanschluss(x, y)
    Color RGB(190, 255, 255) ' hellblau
    PBox 50 * fx, 632 * fy, 70 * fx, 652 * fy
    Color RGB(100, 0, 0) ' dunkelbraun
    Box 50 * fx, 632 * fy, 70 * fx, 652 * fy
    h3| = 1
  Else If x > 310 * fx And x < 340 * fx And y > 416 * fy And y < 426 * fy And h4| = 0 ' Haus 4
    hausanschluss(x, y)
    Color RGB(190, 255, 255) ' hellblau
    PBox 50 * fx, 662 * fy, 70 * fx, 682 * fy
    Color RGB(100, 0, 0) ' dunkelbraun
    Box 50 * fx, 662 * fy, 70 * fx, 682 * fy
    h4| = 1
  Else If x > 700 * fx And x < 730 * fx And y > 454 * fy And y < 464 * fy And h5| = 0 ' Haus 5
    hausanschluss(x, y)
    Color RGB(190, 255, 255) ' hellblau
    PBox 50 * fx, 692 * fy, 70 * fx, 712 * fy
    Color RGB(100, 0, 0) ' dunkelbraun
    Box 50 * fx, 692 * fy, 70 * fx, 712 * fy
    h5| = 1
  Else If x > 744 * fx And x < 786 * fx And y > 447 * fy And y < 457 * fy And h6| = 0 ' Haus 6
    hausanschluss(x, y)
    Color RGB(190, 255, 255) ' hellblau
    PBox 200 * fx, 572 * fy, 220 * fx, 592 * fy
    Color RGB(100, 0, 0) ' dunkelbraun
    Box 200 * fx, 572 * fy, 220 * fx, 592 * fy
    h6| = 1
  Else If x > 804 * fx And x < 834 * fx And y > 444 * fy And y < 454 * fy And h7| = 0 ' Haus 7
    hausanschluss(x, y)
    Color RGB(190, 255, 255) ' hellblau
    PBox 200 * fx, 602 * fy, 220 * fx, 622 * fy
    Color RGB(100, 0, 0) ' dunkelbraun
    Box 200 * fx, 602 * fy, 220 * fx, 622 * fy
    h7| = 1
  Else If x > 852 * fx And x < 882 * fx And y > 438 * fy And y < 448 * fy And h8| = 0 ' Haus 8
    hausanschluss(x, y)
    Color RGB(190, 255, 255) ' hellblau
    PBox 200 * fx, 632 * fy, 220 * fx, 652 * fy
    Color RGB(100, 0, 0) ' dunkelbraun
    Box 200 * fx, 632 * fy, 220 * fx, 652 * fy
    h8| = 1
  Else If x > 1051 * fx And x < 1081 * fx And y > 418 * fy And y < 428 * fy And h9| = 0 ' Haus 9
    hausanschluss(x, y)
    Color RGB(190, 255, 255) ' hellblau
    PBox 200 * fx, 662 * fy, 220 * fx, 682 * fy
    Color RGB(100, 0, 0) ' dunkelbraun
    Box 200 * fx, 662 * fy, 220 * fx, 682 * fy
    h9| = 1
  Else If x > 1101 * fx And x < 1131 * fx And y > 421 * fy And y < 431 * fy And h10| = 0 ' Haus 10
    hausanschluss(x, y)
    Color RGB(190, 255, 255) ' hellblau
    PBox 200 * fx, 692 * fy, 220 * fx, 712 * fy
    Color RGB(100, 0, 0) ' dunkelbraun
    Box 200 * fx, 692 * fy, 220 * fx, 712 * fy
    h10| = 1
  Else
    GoTo zurueck5
  EndIf
  If h| = 10  ' alle Häuser angeschlossen
    alert2("Du hast alle Häuser erfolgreich an die Wasserleitung angeschlossen.", "Damit hast du deine Aufgabe sehr gut erfüllt!", "Wenn du willst, kannst du das letzte Bild jetzt noch ausdrucken lassen.")
    DefLine 0, 1
    Color RGB(255, 100, 100)   ' rot
    Box 965 * fx, 723 * fy, 1100 * fx, 763 * fy
    Box 965 * fx, 773 * fy, 1100 * fx, 813 * fy
    Color RGB(250, 250, 170)  ' beige
    Text 980 * fx, 730 * fy, "Ende"
    Text 980 * fx, 780 * fy, "Drucken"
    GoTo zurueck5
  Else
    GoTo zurueck5
  EndIf
  weiter6:
  beginn| = 0
Return
>Procedure hausanschluss(x, y)      ' Anschluss der Häuser an die Wasserleitung
  i% = 0
  Repeat
    farbabfrage(x, y + i%)
    i% = i% + 1
  Until blau% > 250 And rot% < 110
  DefLine 0, 3
  Color RGB(0, 0, 0)  '  schwarz
  For i1% = 0 To i% - 2
    Line x, y + i% - 2, x, y + i% - 2 - i1%
    verzoegerung(60 / fx)
  Next i1%
  DefLine 0, 1
  Color RGB(100, 220, 255)  ' hellblau Wasser
  For i1% = 0 To i% - 1
    Line x, y + i% - 1, x, y + i% - 1 - i1%
    verzoegerung(60 / fx)
  Next i1%
  h| = h| + 1  ' Zahl der angeschlossenen Häuser
Return
>Procedure alert1(al$, al1$)           ' zweizeilige Mitteilung
  Get 80 * fx, 105 * fy, 1013 * fx, 335 * fy, alert$
  GraphMode R2_COPYPEN, TRANSPARENT
  SetFont schrift1%
  DefLine 0, 1
  Color RGB(100, 0, 0) ' dunkelbraun
  PBox 80 * fx, 105 * fy, 958 * fx, 335 * fy
  Color RGB(255, 0, 0) ' rot
  Box 85 * fx, 110 * fy, 953 * fx, 330 * fy
  Color RGB(255, 255, 198) ' creme
  PBox 101 * fx, 126 * fy, 936 * fx, 313 * fy
  Color RGB(0, 0, 0) ' schwarz
  SetFont schrift1%
  Text 123 * fx, 170 * fy, al$
  Text 123 * fx, 205 * fy, al1$
  DefLine 0, 2 * fx
  Color RGB(190, 255, 255) ' hellblau
  PBox _X / 2 - 85 * fx, 254 * fy,  _X / 2 - 25 * fx, 294 * fy
  Color RGB(100, 0, 0) ' dunkelbraun
  Box _X / 2 - 85 * fx, 254 * fy,  _X / 2 - 25 * fx, 294 * fy
  DefLine 0, 1
  Text _X / 2 - 55 * fx - TxtLen("OK") / 2, 261 * fy, "OK"
  Repeat
    PeekEvent
  Until MouseK = 0
  Repeat
    PeekEvent
    Mouse xx%, yy%, k%
  Until k% = 1 And ((xx% > _X / 2 - 85 * fx And xx% < _X / 2 - 25 * fx) And (yy% > 254 * fy And yy% < 294 * fy))
  Put 80 * fx, 105 * fy, alert$
  Clr alert$
Return
>Procedure alert2(al$, al1$, al2$)   ' dreizeilige Mitteilung
  Get 80 * fx, 155 * fy, 1013 * fx, 385 * fy, alert$
  GraphMode R2_COPYPEN, TRANSPARENT
  SetFont schrift1%
  DefLine 0, 1
  Color RGB(100, 0, 0) ' dunkelbraun
  PBox 80 * fx, 155 * fy, 970 * fx, 385 * fy
  Color RGB(255, 0, 0) ' rot
  Box 85 * fx, 160 * fy, 965 * fx, 380 * fy
  Color RGB(255, 255, 198) ' creme
  PBox 101 * fx, 176 * fy, 948 * fx, 363 * fy
  Color RGB(0, 0, 0) ' schwarz
  Text 123 * fx, 200 * fy, al$
  Text 123 * fx, 235 * fy, al1$
  Text 123 * fx, 270 * fy, al2$
  DefLine 0, 2 * fx
  Color RGB(190, 255, 255) ' hellblau
  PBox _X / 2 - 85 * fx, 310 * fy,  _X / 2 - 25 * fx, 347 * fy
  Color RGB(100, 0, 0) ' dunkelbraun
  Box _X / 2 - 85 * fx, 310 * fy,  _X / 2 - 25 * fx, 347 * fy
  DefLine 0, 1
  SetFont schrift1%
  Text _X / 2 - 55 * fx - TxtLen("OK") / 2, 316 * fy, "OK"
  Repeat
    PeekEvent
  Until MouseK = 0
  Repeat
    PeekEvent
    Mouse xx%, yy%, k%
  Until k% = 1 And ((xx% > _X / 2 - 85 * fx And xx% < _X / 2 - 25 * fx) And (yy% > 310 * fy And yy% < 347 * fy))
  Put 80 * fx, 155 * fy, alert$
  Clr alert$
Return
>Procedure alert3(al$, al1$, al2$)   ' zweifache Auswahlmöglichkeit
  GraphMode R2_COPYPEN, TRANSPARENT
  Get 135 * fx, 115 * fy, 1013 * fy, 345 * fy, ausschnitt$
  DefLine 0, 1
  Color RGB(100, 0, 0) ' dunkelbraun
  PBox 135 * fx, 115 * fy, 1013 * fx, 345 * fy
  Color RGB(255, 0, 0) ' rot
  Box 140 * fx, 120 * fy, 1008 * fx, 340 * fy
  Color RGB(255, 255, 198) ' creme
  PBox 156 * fx, 136 * fy, 991 * fx, 323 * fy
  Color RGB(0, 0, 0) ' schwarz
  SetFont schrift2%
  Text 168 * fx, 190 * fy, al$
  DefLine 0, 2 * fx
  Color RGB(190, 225, 255) ' hellblau
  PBox 322 * fx, 264 * fy, 538 * fx, 304 * fy
  PBox 610 * fx, 264 * fy, 826 * fx, 304 * fy
  Color RGB(100, 0, 0) ' dunkelbraun
  Box 322 * fx, 264 * fy, 538 * fx, 304 * fy
  Box 610 * fx, 264 * fy, 826 * fx, 304 * fy
  DefLine 0, 1
  Text 340 * fx, 269 * fy, al1$
  Text 628 * fx, 269 * fy, al2$
  Repeat
    PeekEvent
  Until MouseK = 0
  Repeat
    PeekEvent
    Mouse x%, y%, k%
  Until k% = 1 And ((x% > 322 * fx And x% < 538 * fx) Or (x% > 610 * fx And x% < 826 * fx)) And y% > 264 * fy And y% < 304 * fy
  If x% < 538 * fx
    alertf| = 1
  Else
    alertf| = 2
  EndIf
  Put 135 * fx, 115 * fy, ausschnitt$
  Clr ausschnitt$
  SetFont schrift1%
Return
>Procedure alertSchl                 ' Auswahl: Schlauch, Aufruf aus Pumpe
  Get 670 * fx, 475 * fy, 1147 * fx, 730 * fy, alert$
  GraphMode R2_COPYPEN, TRANSPARENT
  DefLine 0, 1
  Color RGB(100, 0, 0) ' dunkelbraun
  PBox 670 * fx, 475 * fy, 1147 * fx, 730 * fy
  Color RGB(255, 0, 0) ' rot
  Box 675 * fx, 480 * fy, 1142 * fx, 725 * fy
  Color RGB(249, 254, 231)  ' Hintergrund
  PBox 681 * fx, 486 * fy, 1135 * fx, 718 * fy
  Color RGB(0, 0, 0) ' schwarz
  SetFont schrift1%
  Text 740 * fx, 503 * fy, "Wohin soll der Schlauch?"
  Text 740 * fx, 540 * fy, "zwischen Pumpe und Brunnen"
  Text 740 * fx, 570 * fy, "zwischen Pumpe und Hochbehälter"
  Text 740 * fx, 600 * fy, "zwischen T-Stück und Hochbehälter"
  Text 740 * fx, 630 * fy, "alles entfernen"
  Text 740 * fx, 660 * fy, "zurück"
  If schlauch_br| = 1 Or (schlauch_t| = 1 And schlauch_t_br| = 1) '  Verbindung Pumpe - Brunnen kann gesetzt werden
    Color RGB(190, 255, 255) ' hellblau
    PBox 700 * fx, 542 * fy, 720 * fx, 562 * fy
    Color RGB(100, 0, 0) ' dunkelbraun
    Box 700 * fx, 542 * fy, 720 * fx, 562 * fy
  EndIf
  If schlauch_h = 1 '  Schlauch Pumpe - Hochbehälter kann gesetzt werden
    Color RGB(190, 255, 255) ' hellblau
    PBox 700 * fx, 542 * fy + 30 * fy, 720 * fx, 562 * fy + 30 * fy
    Color RGB(100, 0, 0) ' dunkelbraun
    Box 700 * fx, 542 * fy + 30 * fy, 720 * fx, 562 * fy + 30 * fy
  EndIf
  If t_stueck| = 2 And schlauch_t_h = 1 '  Schlauch T-Stück - Hochbehälter kann gesetzt werden
    Color RGB(190, 255, 255) ' hellblau
    PBox 700 * fx, 542 * fy + 60 * fy, 720 * fx, 562 * fy + 60 * fy
    Color RGB(100, 0, 0) ' dunkelbraun
    Box 700 * fx, 542 * fy + 60 * fy, 720 * fx, 562 * fy + 60 * fy
  EndIf
  Color RGB(190, 255, 255) ' hellblau
  PBox 700 * fx, 542 * fy + 90 * fy, 720 * fx, 562 * fy + 90 * fy '  alles entfernen
  Color RGB(100, 0, 0) ' dunkelbraun
  Box 700 * fx, 542 * fy + 90 * fy, 720 * fx, 562 * fy + 90 * fy
  Color RGB(190, 255, 255) ' hellblau
  PBox 700 * fx, 542 * fy + 120 * fy, 720 * fx, 562 * fy + 120 * fy '  zurück
  Color RGB(100, 0, 0) ' dunkelbraun
  Box 700 * fx, 542 * fy + 120 * fy, 720 * fx, 562 * fy + 120 * fy
  zubehoer
  Put 670 * fx, 475 * fy, alert$
  Clr alert$
Return
>Procedure alertT                     ' Auswahl: T-Stück
  Get 670 * fx, 475 * fy, 1147 * fx, 730 * fy, alert$
  GraphMode R2_COPYPEN, TRANSPARENT
  DefLine 0, 1
  Color RGB(100, 0, 0) ' dunkelbraun
  PBox 670 * fx, 475 * fy, 1147 * fx, 730 * fy
  Color RGB(255, 0, 0) ' rot
  Box 675 * fx, 480 * fy, 1142 * fx, 725 * fy
  Color RGB(249, 254, 231)  ' Hintergrund
  PBox 681 * fx, 486 * fy, 1135 * fx, 718 * fy
  Color RGB(0, 0, 0) ' schwarz
  SetFont schrift1%
  Text 740 * fx, 503 * fy, "Was willst du tun?"
  Text 740 * fx, 540 * fy, "T-Stück zwischen Pumpe und Brunnen"
  Text 740 * fx, 570 * fy, "alles entfernen"
  Text 740 * fx, 600 * fy, "zurück"
  If t_stueck = 1 '  T-Stück zwischen Pumpe und Brunnen kann gesetzt werden
    Color RGB(255, 255, 150) ' gelb
    PBox 700 * fx, 542 * fy, 720 * fx, 562 * fy
    Color RGB(100, 0, 0) ' dunkelbraun
    Box 700 * fx, 542 * fy, 720 * fx, 562 * fy
  EndIf
  Color RGB(255, 255, 150) ' gelb
  PBox 700 * fx, 542 * fy + 30 * fy, 720 * fx, 562 * fy + 30 * fy '  alles entfernen
  Color RGB(100, 0, 0) ' dunkelbraun
  Box 700 * fx, 542 * fy + 30 * fy, 720 * fx, 562 * fy + 30 * fy
  Color RGB(255, 255, 150) ' gelb
  PBox 700 * fx, 542 * fy + 60 * fy, 720 * fx, 562 * fy + 60 * fy '  zurück
  Color RGB(100, 0, 0) ' dunkelbraun
  Box 700 * fx, 542 * fy + 60 * fy, 720 * fx, 562 * fy + 60 * fy
  zubehoer
  Put 670 * fx, 475 * fy, alert$
  Clr alert$
Return
>Procedure alertKl                    ' Auswahl: Klemme
  Get 670 * fx, 475 * fy, 1147 * fx, 730 * fy, alert$
  GraphMode R2_COPYPEN, TRANSPARENT
  DefLine 0, 1
  Color RGB(100, 0, 0) ' dunkelbraun
  PBox 670 * fx, 475 * fy, 1147 * fx, 730 * fy
  Color RGB(255, 0, 0) ' rot
  Box 675 * fx, 480 * fy, 1142 * fx, 725 * fy
  Color RGB(249, 254, 231)  ' Hintergrund
  PBox 681 * fx, 486 * fy, 1135 * fx, 718 * fy
  Color RGB(0, 0, 0) ' schwarz
  SetFont schrift1%
  Text 740 * fx, 503 * fy, "Was willst du tun?"
  Text 740 * fx, 540 * fy, "Klemme Richtung Brunnen"
  Text 740 * fx, 570 * fy, "Klemme Richtung Brunnen weg"
  Text 740 * fx, 600 * fy, "Klemme Richtung Hochbehälter"
  Text 740 * fx, 630 * fy, "Klemme Richtung Hochbehälter weg"
  Text 740 * fx, 660 * fy, "Klemmen wechseln"
  Text 740 * fx, 690 * fy, "alles entfernen"
  Text 1000 * fx, 690 * fy, "zurück"
  If klemme_br| = 1 And klemme_h > 0   '  Klemme Richtung Brunnen kann gesetzt werden, nur wenn Schlauch zum Hochbehälter angeschlossen ist
    Color RGB(255, 190, 255) ' lila
    PBox 700 * fx, 542 * fy, 720 * fx, 562 * fy
    Color RGB(100, 0, 0) ' dunkelbraun
    Box 700 * fx, 542 * fy, 720 * fx, 562 * fy
  EndIf
  If klemme_br| = 2 And klemme_h| = 2 '  Klemme Richtung Brunnen kann entfernt werden, Entfernen nur, wenn eine Klemme bestehen bleibt
    Color RGB(255, 190, 255) ' lila
    PBox 700 * fx, 542 * fy + 30 * fy, 720 * fx, 562 * fy + 30 * fy
    Color RGB(100, 0, 0) ' dunkelbraun
    Box 700 * fx, 542 * fy + 30 * fy, 720 * fx, 562 * fy + 30 * fy
  EndIf
  If klemme_h| = 1                                '  Klemme Richtung Hochbehälter kann gesetzt werden
    Color RGB(255, 190, 255) ' lila
    PBox 700 * fx, 542 * fy + 60 * fy, 720 * fx, 562 * fy + 60 * fy
    Color RGB(100, 0, 0) ' dunkelbraun
    Box 700 * fx, 542 * fy + 60 * fy, 720 * fx, 562 * fy + 60 * fy
  EndIf
  If klemme_h| = 2 And klemme_br| = 2 '  Klemme Richtung Hochbehälter kann entfernt werdent
    Color RGB(255, 190, 255) ' lila
    PBox 700 * fx, 542 * fy + 90 * fy, 720 * fx, 562 * fy + 90 * fy
    Color RGB(100, 0, 0) ' dunkelbraun
    Box 700 * fx, 542 * fy + 90 * fy, 720 * fx, 562 * fy + 90 * fy
  EndIf
  If ansaugen| = 2 And ((klemme_h| = 2 And klemme_br| < 2) Or (klemme_h| < 2 And klemme_br| = 2)) ' Wechsel zwischen den beiden Klemmen
    Color RGB(255, 190, 255) ' lila
    PBox 700 * fx, 542 * fy + 120 * fy, 720 * fx, 562 * fy + 120 * fy
    Color RGB(100, 0, 0) ' dunkelbraun
    Box 700 * fx, 542 * fy + 120 * fy, 720 * fx, 562 * fy + 120 * fy
  EndIf
  Color RGB(255, 190, 255) ' lila
  PBox 700 * fx, 542 * fy + 150 * fy, 720 * fx, 562 * fy + 150 * fy '  alles entfernen
  Color RGB(100, 0, 0) ' dunkelbraun
  Box 700 * fx, 542 * fy + 150 * fy, 720 * fx, 562 * fy + 150 * fy
  Color RGB(255, 190, 255) ' lila
  PBox 960 * fx, 542 * fy + 150 * fy, 980 * fx, 562 * fy + 150 * fy '  zurück
  Color RGB(100, 0, 0) ' dunkelbraun
  Box 960 * fx, 542 * fy + 150 * fy, 980 * fx, 562 * fy + 150 * fy
  zubehoer
  Repeat
    PeekEvent
  Until MouseK = 0 And _Mess = 0
  Put 670 * fx, 475 * fy, alert$
  Clr alert$
Return
>Procedure farbabfrage(x, y)     ' Farbe für einen Punkt abfragen
  farbe% = GetPixel(Win_1.hDC, x, y)
  rot% = GetRValue(farbe%)
  blau% = GetBValue(farbe%)
  gruen% = GetGValue(farbe%)
  '  Color RGB(255, 255, 255)
  '  PBox 304, 0, 760, 70
  '  Color RGB(0, 0, 0)
  '  Text 305, 5, "rot=" + Str(rot%)
  '  Text 455, 5, "grün=" + Str(gruen%)
  '  Text 605, 5, "blau=" + Str(blau%)
  '  Text 305, 35, "x ="  + Str(x)
  '  Text 455, 35, "y =" + Str(y)
Return
>Procedure verzoegerung(v%)   ' Verzögerung in Millisekunden
  zeitalt# = oTimer
  Repeat
    zeit# = oTimer
    PeekEvent
  Until zeit# > zeitalt# + v%
Return
>Procedure drucken                  ' Ausdruck des Bildschirms
  Local h%, pic As Picture
  Get 0, 0, _X - 1, _Y - 1, h%
  Set pic = CreatePicture(h%, 1)
  Printer.StartDoc "Druck"
  Printer.Orientation = 2  ' Querformat
  Output = Printer
  seitenh% = GetDevCaps(VERTRES) * 0.95
  Printer.StartPage
  PaintPicture pic, seitenh% / 18, 0, seitenh% / 3 * 4, seitenh%
  Printer.EndPage
  Printer.EndDoc
  Output = Win_1
  FreeBmp h%
  Set pic = Nothing
Return
>Procedure ende
  Set hintergrund =  Nothing
  Set hintergrund1 =  Nothing
  Set ventil_ro = Nothing
  Set ventil_ru = Nothing
  Set ventil_ra = Nothing
  Set ventil_rb = Nothing
  Set ventil_rc = Nothing
  Set ventil_rvo = Nothing
  Set ventil_rvu = Nothing
  Set ventil_lo = Nothing
  Set ventil_lu = Nothing
  Set ventil_la = Nothing
  Set ventil_lb = Nothing
  Set ventil_lc = Nothing
  Set ventil_lvo = Nothing
  Set ventil_lvu = Nothing
  FreeFont schrift0%
  FreeFont schrift1%
  FreeFont schrift2%
  FreeFont schrift3%
  FreeFont schrift4%
  FreeFont schriftw1%
  FreeFont schriftw2%
  CloseW # 1
  CloseW # 2
  CloseW # 3
  End
Return
