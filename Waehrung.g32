>Sub Niederlande_KeyPress(Ascii&)
  nie = Val(Niederlande.Text)
  eur = nie / 2.20371
  abfrage(Ascii&)
>Sub Euro_KeyPress(Ascii&)
  eur = Val(Euro.Text)
  abfrage(Ascii&)
>Sub Beenden_Click
  PostMessage frm1.hWnd, WM_CLOSE, 0, 0
  Repeat
    Sleep
  Until Me Is Nothing
>Sub frm1_Load
  Euro.SetFocus
'##B#
>Sub Drucken_Click
  Alert 2, "Was soll gedruckt werden?", 1, "Bild|Text|nichts", a%
  If a% = 1
    frm1.PrintForm
  Else If a% = 2
    drucken
  EndIf
>Sub Euro_MouseDown(Button&, Shift&, x!, y!)
