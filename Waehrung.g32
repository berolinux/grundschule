>Sub Finnland_KeyPress(Ascii&)
  fin = Val(Finnland.Text)
  eur = fin / 5.94573
  abfrage(Ascii&)
>Sub Deutschland_KeyPress(Ascii&)
  deu = Val(Deutschland.Text)
  eur = deu / 1.95583
  abfrage(Ascii&)
>Sub Österreich_KeyPress(Ascii&)
