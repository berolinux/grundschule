'##E#
' ***************************************************************************
' *****                Umrechnung Euro-Landeswährungen                      *****
' *****      von Rudolf Rosenkränzer, Auf der Hard 3, 54456 Tawern       *****
' *****                      Telefon 06501/180202                            *****
' ***************************************************************************
Global xx%, yy%, x%, y%, k%, antwx%, antwy%, schrift%, schrift1%, a%
Global Double eur, fin, nie, bel, lux, fra, irl
Global Double spa, por, ita, öst, deu
LoadForm frm1
frm1.AutoRedraw = 1
Do
  Sleep
Until Me Is Nothing
>Sub TextboxLeeren(frm As Form)
  Local EditField As Control
  For Each EditField In frm.Controls
    If TypeOf(EditField) Is TextBox Then
      EditField.Text = ""
    End If
  Next
End Sub
>Procedure drucken
  Local seitenh&, zeilenh&, seite&, stelle&, schriftdr%
  Output = Printer
  Printer.StartDoc "Euro"
  Printer.StartPage
  seitenh& = GetDevCaps(VERTRES)
  zeilenh& = 12 * seitenh& / 640
  Font "arial", CharSet ANSI_CHARSET, Family FF_DONTCARE, Weight 600, Width zeilenh& * 0.4, Height zeilenh&, To schriftdr%
  SetFont schriftdr%
  seite& = zeilenh& * 4   'Abstand vom oberen Seitenrand
  Text zeilenh& * 3, seite&, "In allen Euro-Ländern gilt bis zum Jahr 2002 die alte Landeswährung"
  Add seite&, zeilenh&
  Text zeilenh& * 3, seite&, "zum festen Umrechnungskurs:"
  Add seite&, zeilenh& * 1.8
  Text zeilenh& * 3, seite&, "Euro: " + Str$(FRound(eur, 2), 2, 2) + " €"
  Add seite&, zeilenh& * 1.3
  Text zeilenh& * 5, seite&, "Finnland: " + Str$(FRound(eur * 5.94573, 2), 2, 2) + " Fmk"
  Add seite&, zeilenh& * 1.3
  Text zeilenh& * 5, seite&, "Niederlande: " + Str$(FRound(eur * 2.20371, 2), 2, 2) + " hfl"
  Add seite&, zeilenh& * 1.3
  Text zeilenh& * 5, seite&, "Belgien: " + Str$(FRound(eur * 40.3399, 2), 2, 2) + " bfr"
  Add seite&, zeilenh& * 1.3
  Text zeilenh& * 5, seite&, "Luxemburg: " + Str$(FRound(eur * 40.3399, 2), 2, 2) + " lfr"
  Add seite&, zeilenh& * 1.3
  Text zeilenh& * 5, seite&, "Frankreich: " + Str$(FRound(eur * 6.55957, 2), 2, 2) + " FF"
  Add seite&, zeilenh& * 1.3
  Text zeilenh& * 5, seite&, "Irland: " + Str$(FRound(eur * 0.787564, 2), 2, 2) + " Ir£"
  Add seite&, zeilenh& * 1.3
  Text zeilenh& * 5, seite&, "Spanien: " + Str$(FRound(eur * 166.386, 2), 2, 2) + " Pta"
  Add seite&, zeilenh& * 1.3
  Text zeilenh& * 5, seite&, "Portugal: " + Str$(FRound(eur * 200.482, 2), 2, 2) + " Esc"
  Add seite&, zeilenh& * 1.3
  Text zeilenh& * 5, seite&, "Italien: " + Str$(FRound(eur * 1936.27, 2), 2, 2) + " Lit"
  Add seite&, zeilenh& * 1.3
  Text zeilenh& * 5, seite&, "Österreich: " + Str$(FRound(eur * 13.7603, 2), 2, 2) + " öS"
  Add seite&, zeilenh& * 1.3
  Text zeilenh& * 5, seite&, "Deutschland: " + Str$(FRound(eur * 1.95583, 2), 2, 2) + " DM"
  Printer.EndPage
  Printer.EndDoc
  FreeFont schriftdr%
  Output = Me
  Repeat
    Sleep
  Until Me Is Nothing
>Procedure abfrage(ByRef Ascii&) ' Variable wird selbst übergeben und geändert, nicht nur der Wert
  If Ascii& = 44 Then Ascii& = 46 ' Komma durch Punkt ersetzen
  If (Ascii& < Asc("0") Or Ascii& > Asc("9")) And Ascii& <> 46 && Ascii& <> 13 Then Ascii& = 0
  If Ascii& = 13  Or eur > Large 10000000000 ' Return
    rechnen
    Do
      Sleep
    Loop Until Me Is Nothing
  EndIf
Return
>Procedure rechnen
  Euro.Text = Str$(FRound(eur, 2), 2, 2)
  Finnland.Text = Str$(FRound(eur * 5.94573, 2), 2, 2) 'Finn. Mark
  Niederlande.Text = Str$(FRound(eur * 2.20371, 2), 2, 2)  'Holl. Gulden
  Belgien.Text = Str$(FRound(eur * 40.3399, 2), 2, 2)  'Belg. Franc
  Luxemburg.Text = Str$(FRound(eur * 40.3399, 2), 2, 2) ' Luxemb. Franc
  Frankreich.Text = Str$(FRound(eur * 6.55957, 2), 2, 2)  'Franz. Franc
  Irland.Text = Str$(FRound(eur * 0.787564, 2), 2, 2) 'Irisches Pfund
  Spanien.Text = Str$(FRound(eur * 166.386, 2), 2, 2)  'Peseta
  Portugal.Text = Str$(FRound(eur * 200.482, 2), 2, 2)  'Escudo
  Italien.Text = Str$(FRound(eur * 1936.27, 2), 2, 2)  'Ital. Lira
  Österreich.Text = Str$(FRound(eur * 13.7603, 2), 2, 2) 'Österr. Schilling
  Deutschland.Text = Str$(FRound(eur * 1.95583, 2), 2, 2) 'Deutsche Mark

