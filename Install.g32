' ************** Installationsprogramm Kombipaket Grundschule Version 8.0  **************
Global ver%, version%, a%, MkDir%, kernel%, m%, pfad$, server%, beginn%, AppAtom%
Global TopicAtom%, ServerWindow%
Global Execute!, Ack!
Global AppAtom As Int16

Declare Function LZStart Lib "lz32" ()
Declare Function LZDone Lib "lz32" ()
Declare Function CopyLZFile Lib "lz32" (ByVal Source As Integer, ByVal Dest As Integer) As Integer

Dialog # 1, _X / 2 - 155, _Y / 2 - 50, 310, 130, "Bero Installationsprogramm"
  Dlg Fill 1, RGB(192, 192, 192)
  LText "In welchen Ordner installieren?", 0, 10, 10, 280, 25
  EditText "C:\Grundschule", 103, 10, 40, 280, 25, ES_LEFT | ES_AUTOHSCROLL | WS_TABSTOP | WS_BORDER
  DefPushButton "&OK", 104, 10, 70, 135, 25, BS_DEFPUSHBUTTON | WS_TABSTOP
  PushButton "&Abbruch", 105, 160, 70, 135, 25, BS_PUSHBUTTON | WS_TABSTOP
EndDialog
ShowDialog # 1
~SetFocus(DlgItem(1, 103))
SendMessage Dlg(1, 103), EM_SETSEL, 0, MakeLong(0, 20)
Do
  PeekEvent
  m% = MENU(0)
Loop Until m% = 104 Or m% = 105
If m% = 105
  CloseDialog # 1
  End
EndIf
pfad$ = _Win$(Dlg(1, 103))
CloseDialog # 1
If Right$(pfad$) = "\" Then pfad$ = Left$(pfad$, Len(pfad$) - 1)
If (GetAttr(pfad$ + "\Rechnen") And 16) And (Exist(pfad$ + "\Rechnen.exe") = -1) ' Ordner und Datei vorhanden"
  Alert 2, "Soll die vorhandene Installation überschrieben werden?", 1, "ja|nein", a%
EndIf
If a% = 2
  End
EndIf
Copy "GfaWin23.Ocx", SysDir + "\GfaWin23.Ocx"  ' Kopieren/Überschreiben in Windows\System
TitleW # 1, "Bero Install"
OpenW # 1, _X / 2 - 150, _Y / 2 - 100, 300, 200, -1
VerzeichnisMitUnterverzeichnissenErstellen(pfad$ + "\Bild\ABCD")
VerzeichnisMitUnterverzeichnissenErstellen(pfad$ + "\Bild\Puzzle")
VerzeichnisMitUnterverzeichnissenErstellen(pfad$ + "\Bild\Wasserleitung")
VerzeichnisMitUnterverzeichnissenErstellen(pfad$ + "\Texte")
VerzeichnisMitUnterverzeichnissenErstellen(pfad$ + "\Originale")
VerzeichnisMitUnterverzeichnissenErstellen(pfad$ + "\Rechnen")
VerzeichnisMitUnterverzeichnissenErstellen(pfad$ + "\Schreiben")
VerzeichnisMitUnterverzeichnissenErstellen(pfad$ + "\Lesen")
Print "Programme werden kopiert..."
~LZStart()
Copy "Schreiben.exe", pfad$ + "\Schreiben.exe"
Copy "Rechnen.exe", pfad$ + "\Rechnen.exe"
Copy "Lesen.exe", pfad$ + "\Lesen.exe"
Copy "Waehrung.exe", pfad$ + "\Waehrung.exe"
