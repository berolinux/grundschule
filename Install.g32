>Procedure Copy(a$, b$)
  Local a%, Source%, Destination%, q$, z$
  PeekEvent
  If Exist(b$) = 0
    Copy:
    a$ = a$ + Chr$(0), b$ = b$ + Chr$(0)
    Source% = _lopen(V:a$, OF_READ)
    Destination% = _lcreat(V:b$, 0)
    If Source% > 0 && Destination% > 0
      ~CopyLZFile(Source%, Destination%)
    EndIf
    If Source% > 0 Then  ~_lclose(Source%)
    If Destination% > 0 Then ~_lclose(Destination%)
  Else
    If beginn% = 0
      beginn% = 1
      Message b$ + " überschreiben mit Neuinstallation?", "Kombipaket Grundschule", MB_YESNO, a%
      If a% = IDYES
        GoTo Copy
      EndIf
    Else
      GoTo Copy
    EndIf
  EndIf
Return
>Procedure VerzeichnisMitUnterverzeichnissenErstellen(Verz$)
  // Erstellt ein Verzeichnis mit Unterverzeichnissen,
  // z.B. C:\BERO\BERODRAW\BDRMMPL
  Local a$ = Verz$, b$ = ""
  While InStr(a$, "\")
    b$ = Left$(a$, InStr(a$, "\"))
    Mid$(a$, InStr(a$, "\"), 1) = "¤"
    While InStr(b$, "¤")
      Mid$(b$, InStr(b$, "¤"), 1) = "\"
    Wend
    b$ = Left$(b$, Len(b$) - 1)
    If Len(b$) > 2
      VerzeichnisErstellen(b$)
    EndIf
  Wend
  VerzeichnisErstellen(Verz$)
Return
>Procedure VerzeichnisErstellen(Verzeichnis$)
  // Erstellt ein Verzeichnis, falls es noch nicht vorhanden ist.
  Try
    MkDir Verzeichnis$
  Catch
  EndCatch
Return
>Function InitiateDDE(Application$)
  Execute! = False
  AppAtom = GlobalAddAtom(Application$)
  Clr ServerWindow%
  SendMessage HWND_BROADCAST, WM_DDE_INITIATE, Win_1.hWnd, MakeLong(AppAtom, AppAtom)
  Repeat
    GetEvent
  Until ServerWindow% <> 0
  ~GlobalDeleteAtom(AppAtom)
  Return ServerWindow%
EndFunc
>Procedure SendDDE(server%, Command$)
  Local h%, p%
  Execute! = True, Ack! = False
  Command$ = Command$ + Chr$(0)
  h% = GlobalAlloc(GMEM_DDESHARE, Len(Command$))
  p% = GlobalLock(h%)
  BMove V:Command$, p%, Len(Command$)
  ~GlobalUnlock(h%)
  PostMessage server%, WM_DDE_EXECUTE, Me.hWnd, h% //MakeLong(h%, 0)
  Repeat
    GetEvent
  Until Ack!
  ~GlobalFree(h%)
Return
>Procedure TerminateDDE(server%)
  PostMessage ServerWindow%, WM_DDE_TERMINATE, Win(1), 0
Return
>Procedure Win_1_DDEWndProc(ByRef hw%, ByRef m%, ByRef w%, ByRef l%, ByRef retval%, ByRef valid?)
  If m% = WM_DDE_ACK
    If(LoWord(l%) == AppAtom && HiWord(l%) == AppAtom)
      ServerWindow% = w%
    EndIf
    If Execute!
      ~GlobalFree(l%)
      ~SetFocus(Win(1))
      Ack! = True
    EndIf
  EndIf
Return
