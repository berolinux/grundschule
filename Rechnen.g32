DefMouse 0
If _X  >= 1600                ' Darstellung nur bis 1600
  If _Y < 1200
    vx% = (_X - 1280) / 2 ' seitliche Verschiebung
    vy% = (_Y - 960) / 2 ' Verschiebung nach unten
  Else If _Y >= 1200
    vx% = (_X - 1600) / 2 ' seitliche Verschiebung
    vy% = (_Y - 1200) / 2 ' Verschiebung nach unten
  EndIf
Else If _X >= 1280
  If _Y < 864
    vx% = (_X - 1024) / 2 ' seitliche Verschiebung
    vy% = (_Y - 768) / 2 ' Verschiebung nach unten
  Else If _Y < 960
    vx% = (_X - 1152) / 2 ' seitliche Verschiebung
    vy% = (_Y - 864) / 2 ' Verschiebung nach unten
  Else If _Y <= 1023
    vx% = (_X - 1280) / 2 ' seitliche Verschiebung
    vy% = (_Y - 960) / 2 ' Verschiebung nach unten
  Else If _Y = 1024
    vx% = (_X - 1280) / 2 ' seitliche Verschiebung
    vy% = (_Y - 1024) / 2 ' Verschiebung nach unten
  Else If _Y > 1024
    vx% = (_X - 1280) / 2 ' seitliche Verschiebung
    vy% = (_Y - 960) / 2 ' Verschiebung nach unten
  EndIf
Else If _X >= 1152
  If _Y >= 864
    vx% = (_X - 1152) / 2 ' seitliche Verschiebung
    vy% = (_Y - 864) / 2 ' Verschiebung nach unten
  Else If _Y < 864
    vx% = (_X - 1024) / 2 ' seitliche Verschiebung
    vy% = (_Y - 768) / 2 ' Verschiebung nach unten
  EndIf
Else If _X >= 1024
  If _Y >= 768
    vx% = (_X - 1024) / 2 ' seitliche Verschiebung
    vy% = (_Y - 768) / 2 ' Verschiebung nach unten
  Else If _Y < 768
    vx% = (_X - 800) / 2 ' seitliche Verschiebung
    vy% = (_Y - 600) / 2 ' Verschiebung nach unten
  EndIf
Else If _X >= 800
  If _Y >= 600
    vx% = (_X - 800) / 2 ' seitliche Verschiebung
    vy% = (_Y - 600) / 2 ' Verschiebung nach unten
  Else If _Y < 600
    vx% = (_X - 640) / 2 ' seitliche Verschiebung
    vy% = (_Y - 480) / 2 ' Verschiebung nach unten
  EndIf
Else If _X >= 640 And _Y >= 480
  vx% = (_X - 640) / 2 ' seitliche Verschiebung
  vy% = (_Y - 480) / 2 ' Verschiebung nach unten
Else
  fx# = (_X - 2 * vx%) / 640
  fy# = (_Y - 2 * vy%) / 480
  alert2("Stelle bitte eine höhere Bildauflösung ein!", "Ja", "Ende")
  ende
EndIf
