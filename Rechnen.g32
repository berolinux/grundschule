>Procedure invert3
  Select inv|
  Case 1
'##B#
    b% = 84 * fy + vy%
'##B#
    c% = 5 * fx
    For j% = 0 To 2
'##B#
      a% = 100 * fx + vx%
      For i% = 0 To 10
        If i% <> 5
          PBox a%, b%, a% + 3 * fx, b% + 3 * fy
        EndIf
        Add a%, c%
      Next i%
      Add b%, c%
    Next j%
    If v| = 0
      Color RGB(255, 0, 0) ' rot
    EndIf
    Box 97 * fx + vx% + TxtLen("            "), 80 * fy + vy%, 111 * fx + vx% + TxtLen("            "), 98 * fy + vy%                              ' 1.
  Case 2
    Text 96 * fx + vx%, 104 * fy + vy%, "700                   H,   Z,   E "    ' 2.
    If v| = 0
      Color RGB(255, 0, 0) ' rot
    EndIf
    SetFont schriftw3%
    Text 96 * fx + vx% + zeichenbr% * 20, 105 * fy + vy%, "ò"                                    ' 2.
    Text 96 * fx + vx% + zeichenbr% * 25, 105 * fy + vy%, "ò"                                    ' 2.
    Text 96 * fx + vx% + zeichenbr% * 30, 105 * fy + vy%, "ò"                                    ' 2.
    SetFont schrift3%
  Case 3
    Text 96 * fx + vx%, 130 * fy + vy%, "400 + 300 =  "                         ' 3.
