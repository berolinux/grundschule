        PBox 190 + vx%, 434, 233 + vx%, 434 + zeichenh%
        Color RGB(255, 0, 0) ' rot
        Text 134 + vx% - TxtLen(Trim$(Str$(i%))), 435, Trim$(Str$(i%))
      EndIf
      If i% > 100 And i% < 201
        PBox 92 + vx%, 434, 135 + vx%, 434 + zeichenh%
        PBox 190 + vx%, 434, 233 + vx%, 434 + zeichenh%
        PBox 288 + vx%, 434, 331 + vx%, 434 + zeichenh%
        Color RGB(255, 0, 0) ' rot
        Text 134 + vx% - TxtLen("100"), 435, "100"
        Text 232 + vx% - TxtLen(Trim$(Str$(i%))), 435, Trim$(Str$(i%))
      EndIf
      If i% > 200 And i% < 301
        PBox 190 + vx%, 434, 233 + vx%, 434 + zeichenh%
        PBox 288 + vx%, 434, 331 + vx%, 434 + zeichenh%
        PBox 386 + vx%, 434, 429 + vx%, 434 + zeichenh%
        Color RGB(255, 0, 0) ' rot
        Text 232 + vx% - TxtLen("200"), 435, "200"
        Text 330 + vx% - TxtLen(Trim$(Str$(i%))), 435, Trim$(Str$(i%))
      EndIf
      If i% > 300 And i% < 401
        PBox 288 + vx%, 434, 331 + vx%, 434 + zeichenh%
        PBox 386 + vx%, 434, 429 + vx%, 434 + zeichenh%
        PBox 484 + vx%, 434, 527 + vx%, 434 + zeichenh%
        Color RGB(255, 0, 0) ' rot
        Text 330 + vx% - TxtLen("300"), 435, "300"
        Text 428 + vx% - TxtLen(Trim$(Str$(i%))), 435, Trim$(Str$(i%))
      EndIf
      If i% > 400 And i% < 501
        PBox 386 + vx%, 434, 429 + vx%, 434 + zeichenh%
        PBox 484 + vx%, 434, 527 + vx%, 434 + zeichenh%
        PBox 92 + vx%, 556, 135 + vx%, 556 + zeichenh%
        Color RGB(255, 0, 0) ' rot
        Text 428 + vx% - TxtLen("400"), 435, "400"
        Text 526 + vx% - TxtLen(Trim$(Str$(i%))), 435, Trim$(Str$(i%))
      EndIf
      If i% > 500 And i% < 601
        PBox 484 + vx%, 434, 527 + vx%, 434 + zeichenh%
        PBox 92 + vx%, 556, 135 + vx%, 556 + zeichenh%
        PBox 190 + vx%, 556, 233 + vx%, 556 + zeichenh%
        Color RGB(255, 0, 0) ' rot
        Text 526 + vx% - TxtLen("500"), 435, "500"
        Text 134 + vx% - TxtLen(Trim$(Str$(i%))), 557, Trim$(Str$(i%))
      EndIf
      If i% > 600 And i% < 701
        PBox 92 + vx%, 556, 135 + vx%, 556 + zeichenh%
        PBox 190 + vx%, 556, 233 + vx%, 556 + zeichenh%
        PBox 288 + vx%, 556, 331 + vx%, 556 + zeichenh%
        Color RGB(255, 0, 0) ' rot
        Text 134 + vx% - TxtLen("600"), 557, "600"
        Text 232 + vx% - TxtLen(Trim$(Str$(i%))), 557, Trim$(Str$(i%))
      EndIf
      If i% > 700 And i% < 801
