  Box 97 * fx + vx% + TxtLen("14 + 1 = "), 366 * fy + vy%, 111 * fx + vx% + TxtLen("14 + 1 = "), 384 * fy + vy%               ' 12.
  Box 97 * fx + vx% + TxtLen("14 + 1 = "), 392 * fy + vy%, 111 * fx + vx% + TxtLen("14 + 1 = "), 410 * fy + vy%               ' 13.
  Color RGB(0, 0, 0) ' schwarz
