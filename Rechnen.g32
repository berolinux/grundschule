    Box 97 * fx + vx% + TxtLen("144 + 144 = "), 392 * fy + vy%, 111 * fx + vx% + TxtLen("144 + 144 = "), 410 * fy + vy%         ' 13.
  EndSelect
Return
>Procedure invert4
  Select inv|
  Case 1
    SetFont schrift0%
    If v| = 0
      Color RGB(0, 170, 0) ' grün
    EndIf
'##B#
    a% = 100 * fx + vx%
'##B#
    b% = 83 * fy + vy%
'##B#
    c% = 5 * fx
    For i% = 0 To 10
      If i% <> 5
        PBox a%, b%, a% + 3 * fx, b% + 3 * fy
      EndIf
      Add a%, c%
    Next i%
    If v| = 0
      Color RGB(0, 0, 235) ' blau
    EndIf
'##B#
    b% = 91 * fy + vy%
'##B#
    c% = 5 * fx
    For j% = 0 To 1
'##B#
      a% = 100 * fx + vx%
      For i% = 0 To 10
        If i% <> 5
          PBox a%, b%, a% + 3 * fx, b% + 3 * fy
        EndIf
        Add a%, c%
      Next i%
      Add b%, c%
    Next j%
    SetFont schrift3%
    If v| = 0
      Color RGB(255, 0, 0) ' rot
    EndIf
    Box 97 * fx + vx% + TxtLen("4000 + 3000 = "), 80 * fy + vy%, 111 * fx + vx% + TxtLen("4000 + 3000 = "), 98 * fy + vy%         ' 1.
  Case 2
    Text 96 * fx + vx%, 104 * fy + vy%, "7000                 T,   H,   Z,   E "  ' 2.
    If v| = 0
      Color RGB(255, 0, 0) ' rot
    EndIf
    SetFont schriftw3%
    Text 96 * fx + vx% + zeichenbr% * 19, 105 * fy + vy%, "ò"                                    ' 2.
    Text 96 * fx + vx% + zeichenbr% * 24, 105 * fy + vy%, "ò"                                    ' 2.
    Text 96 * fx + vx% + zeichenbr% * 29, 105 * fy + vy%, "ò"                                    ' 2.
    Text 96 * fx + vx% + zeichenbr% * 34, 105 * fy + vy%, "ò"                                    ' 2.
    SetFont schrift3%
  Case 3
    Text 96 * fx + vx%, 130 * fy + vy%, "4000 + 3000 =  "                         ' 3.
    If v| = 0
      Color RGB(255, 0, 0) ' rot
    EndIf
    Box 97 * fx + vx% + TxtLen("4000 + 3000 = "), 132 * fy + vy%, 111 * fx + vx% + TxtLen("4000 + 3000 = "), 150 * fy + vy%     ' 3.
  Case 4
    Text 96 * fx + vx%, 156 * fy + vy%, "7000 - 3000 =                          " ' 4.
    If v| = 0
      Color RGB(255, 0, 0) ' rot
    EndIf
    Box 97 * fx + vx% + TxtLen("4000 + 3000 = "), 158 * fy + vy%, 111 * fx + vx% + TxtLen("4000 + 3000 = "), 176 * fy + vy%     ' 4.
  Case 5
    Text 96 * fx + vx%, 182 * fy + vy%, "4000 +      =                          " ' 5.
    If v| = 0
      Color RGB(255, 0, 0) ' rot
    EndIf
    Text 96 * fx + vx%, 182 * fy + vy%, "              10000 "                                                                                               ' 5.
    Box 97 * fx + vx% + TxtLen("4000 = "), 184 * fy + vy%, 111 * fx + vx% + TxtLen("4000 = "), 202 * fy + vy%                             ' 5."
  Case 6
    Text 96 * fx + vx%, 208 * fy + vy%, "   7 ·  400 =                          " ' 6.
    If v| = 0
      Color RGB(255, 0, 0) ' rot
    EndIf
    Box 97 * fx + vx% + TxtLen("4000 + 3000 = "), 210 * fy + vy%, 111 * fx + vx% + TxtLen("4000 + 3000 = "), 228 * fy + vy%     ' 6.
  Case 7
    Text 96 * fx + vx%, 234 * fy + vy%, "Kommazahlen                            " ' 7.
  Case 8
    Text 96 * fx + vx%, 260 * fy + vy%, "schriftlich addieren                   " ' 8.
  Case 9
    Text 96 * fx + vx%, 286 * fy + vy%, "schriftlich subtrahieren               " ' 9.
  Case 10
    Text 96 * fx + vx%, 312 * fy + vy%, "schriftlich multiplizieren             " ' 10.
  Case 11
    Text 96 * fx + vx%, 338 * fy + vy%, "schriftlich dividieren  "                ' 11.
  Case 12
    Text 96 * fx + vx%, 364 * fy + vy%, "   2 · 4000 =       das Doppelte"        ' 12.
    If v| = 0
      Color RGB(255, 0, 0) ' rot
    EndIf
    Box 97 * fx + vx% + TxtLen("4000 + 3000 = "), 366 * fy + vy%, 111 * fx + vx% + TxtLen("4000 + 3000 = "), 384 * fy + vy%    ' 12.
  Case 13
    Text 96 * fx + vx%, 390 * fy + vy%, "8000 :    2 =       die Hälfte  "        ' 13.
    If v| = 0
      Color RGB(255, 0, 0) ' rot
    EndIf
    Box 97 * fx + vx% + TxtLen("4000 + 3000 = "), 392 * fy + vy%, 111 * fx + vx% + TxtLen("4000 + 3000 = "), 410 * fy + vy%    ' 13.
  EndSelect
Return
>Procedure invert5
  Select inv|
  Case 1
    Text 66 * fx + vx%, 78 * fy + vy%, "Cent oder Pfennige bezahlen                      "  ' 1.
  Case 2
    Text 66 * fx + vx%, 104 * fy + vy%, "Euro oder DM bezahlen                           "  ' 2.
  Case 3
    Text 66 * fx + vx%, 130 * fy + vy%, "€/ct oder DM/Pf bezahlen"                ' 3.
  Case 4
    Text 66 * fx + vx%, 156 * fy + vy%, "ct oder Pf herausgeben (auf 10|20|100)   " ' 4.
  Case 5
    Text 66 * fx + vx%, 182 * fy + vy%, "€ oder DM herausgeben (auf 20|100|1000)   " ' 5.
  Case 6
    Text 66 * fx + vx%, 208 * fy + vy%, "€/ct - DM/Pf herausgeben (auf 10|20|100)   " ' 6.
  Case 7
    Text 66 * fx + vx%, 234 * fy + vy%, "Uhr anhalten (12 h)                    " ' 7.
  Case 8
    Text 66 * fx + vx%, 260 * fy + vy%, "Uhr anhalten (24 h)                    " ' 8.
  Case 9
    Text 66 * fx + vx%, 286 * fy + vy%, "von 4.10 Uhr bis  4.30 Uhr             " ' 9.
  Case 10
    Text 66 * fx + vx%, 312 * fy + vy%, "von 4.10 Uhr bis  5.20 Uhr             " ' 10.
  Case 11
    Text 66 * fx + vx%, 338 * fy + vy%, "von 4.00 Uhr bis 18.00 Uhr          "    ' 11.
  Case 12
    Text 66 * fx + vx%, 364 * fy + vy%, "vom 7.12.2000 bis zum 25.12.2000"        ' 12.
  Case 13
    Text 66 * fx + vx%, 390 * fy + vy%, "vom 5. 8.2000 bis zum  5. 8.2023      "  ' 13.
  EndSelect
Return
>Procedure invert6
  Select inv|
  Case 1
    Text 96 * fx + vx%, 78 * fy + vy%, "Geld:                                  "  ' 1.
  Case 2
    Text 96 * fx + vx%, 104 * fy + vy%, "DM - Pf   oder   € - ct   Euro - Cent  "  ' 2.
  Case 3
    Text 96 * fx + vx%, 130 * fy + vy%, "Längenmaße:        "                     ' 3.
  Case 4
    Text 96 * fx + vx%, 156 * fy + vy%, "cm - mm      Zentimeter - Millimeter   " ' 4.
  Case 5
    Text 96 * fx + vx%, 182 * fy + vy%, " m - cm      Meter      - Zentimeter   " ' 5.
  Case 6
    Text 96 * fx + vx%, 208 * fy + vy%, " m - mm      Meter      - Millimeter   " ' 6.
  Case 7
    Text 96 * fx + vx%, 234 * fy + vy%, "km -  m      Kilometer  - Meter        " ' 7.
  Case 8
    Text 96 * fx + vx%, 260 * fy + vy%, "km - 100 m   Kilometer  - 100 Meter    " ' 8.
  Case 9
    Text 96 * fx + vx%, 286 * fy + vy%, "Gewichte:                              " ' 9.
  Case 10
    Text 96 * fx + vx%, 312 * fy + vy%, "kg -  g      Kilogramm  - Gramm        " ' 10.
  Case 11
    Text 96 * fx + vx%, 338 * fy + vy%, " t - kg      Tonnen     - Kilogramm "    ' 11.
  Case 12
    Text 96 * fx + vx%, 364 * fy + vy%, "Hohlmaße:                       "        ' 12.
  Case 13
    Text 96 * fx + vx%, 390 * fy + vy%, " l - ml      Liter      - Milliliter  "  ' 13.
  EndSelect
Return
>Procedure selbsteingabe
  If art| = 46 And weiter| = 0 'Maße mit dem Komma schreiben
    menue_masse
    rechenblatt
  Else If art| = 53 And beginn| = 0 ' Geld
    If wahl| < 9
      Color RGB(255, 255, 198) ' creme
      PRBox 3 * fx + vx%, 3 * fy + vy%, 633 * fx + vx%, 475 * fy + vy%
      DefLine 0, 12 * fy
      DefFill 42
      PRBox 7 * fx + vx%, 8 * fy + vy%, 631 * fx + vx%, 473 * fy + vy%
      Color RGB(255, 0, 0) ' rot
      PRBox 6 * fx + vx%, 6 * fy + vy%, 632 * fx + vx%, 473 * fy + vy%
      DefFill 0
      DefLine 0, fy
    Else
      rechenblatt
    EndIf
  EndIf
  GraphMode R2_COPYPEN, TRANSPARENT
  neu2:
  saeule
  neu1:
  Color RGB(0, 0, 0) ' schwarz
  SetFont schrift1%
  If art| = 46 ' Maße
    If wahl| = 4
      mass$ = "cm"
      mass1$ = "mm"
      mass2$ = "Zentimeter"
      mass3$ = "Millimeter"
    Else If wahl| = 8
      mass$ = "km"
      mass1$ = "100-m-Stücke"
      mass2$ = "Kilometer"
      mass3$ = "100-m-Stücke"
    Else If wahl| = 2
      If geldwahl| = 1 ' DM
        mass$ = "DM"
        mass1$ = "Pf"
        mass2$ = "DM"
        mass3$ = "Pfennige"
      Else
        mass$ = "€"
        mass1$ = "ct"
        mass2$ = "Euro"
        mass3$ = "Cent"
      EndIf
    Else If wahl| = 5
      mass$ = "m"
      mass1$ = "cm"
      mass2$ = "Meter"
      mass3$ = "Zentimeter"
    Else If wahl| = 6
      mass$ = "m"
      mass1$ = "mm"
      mass2$ = "Meter"
      mass3$ = "Millimeter"
    Else If wahl| = 7
      mass$ = "km"
      mass1$ = "m"
      mass2$ = "Kilometer"
      mass3$ = "Meter"
    Else If wahl| = 10
      mass$ = "kg"
      mass1$ = "g"
      mass2$ = "Kilogramm"
      mass3$ = "Gramm"
    Else If wahl| = 11
      mass$ = "t"
      mass1$ = "kg"
      mass2$ = "Tonnen"
      mass3$ = "Kilogramm"
    Else If wahl| = 13
      mass$ = "l"
      mass1$ = "ml"
      mass2$ = "Liter"
      mass3$ = "Milliliter"
    EndIf
  EndIf
  If art| = 53 ' Geld
    Repeat
      PeekEvent
    Until And(_Mess = 0, InKey$ = "")
    If wahl| > 6
      stufe| = 3
    EndIf
    If wahl| = 1 Or wahl| = 4
      If geldwahl| = 1 ' DM
        Text 25 * fx + vx%, 240 * fy + vy%, gib$ + "ein: Pfennige"
      Else
        Text 25 * fx + vx%, 240 * fy + vy%, gib$ + "ein: Cent"
      EndIf
    Else If wahl| = 2 Or wahl| = 5
      If geldwahl| = 1 ' DM
        Text 25 * fx + vx%, 240 * fy + vy%, gib$ + "ein: DM"
      Else
        Text 25 * fx + vx%, 240 * fy + vy%, gib$ + "ein: €"
      EndIf
    Else If wahl| = 3 Or wahl| = 6
      If geldwahl| = 1 ' DM
        Text 25 * fx + vx%, 240 * fy + vy%, gib$ + "ein: 1. DM, 2. Pf"
      Else
        Text 25 * fx + vx%, 240 * fy + vy%, gib$ + "ein: 1. €   , 2. ct"
      EndIf
    Else If wahl| = 7 Or wahl| = 8
      Text 25 * fx + vx%, 240 * fy + vy%, gib$ + "ein: 1. Stunde, 2. Minuten"
    Else If wahl| > 8 And wahl| < 12
      Text 280 * fx + vx%, 270 * fy + vy%, gib$ + "ein: 1. Stunde"
      Text 280 * fx + vx% + TxtLen(gib$ + "ein: "), 290 * fy + vy%, "2. Minuten"
      Text 280 * fx + vx% + TxtLen(gib$ + "ein: "), 310 * fy + vy%, "3. Stunde"
      Text 280 * fx + vx% + TxtLen(gib$ + "ein: "), 330 * fy + vy%, "4. Minuten"
    Else If wahl| > 11
      Text 280 * fx + vx%, 270 * fy + vy%, gib$ + "ein: 1. Tag"
      Text 280 * fx + vx% + TxtLen(gib$ + "ein: "), 290 * fy + vy%, "2. Monat"
      Text 280 * fx + vx% + TxtLen(gib$ + "ein: "), 310 * fy + vy%, "3. Jahr"
      Text 280 * fx + vx% + TxtLen(gib$ + "ein: "), 330 * fy + vy%, "4. Tag"
      Text 280 * fx + vx% + TxtLen(gib$ + "ein: "), 350 * fy + vy%, "5. Monat"
      Text 280 * fx + vx% + TxtLen(gib$ + "ein: "), 370 * fy + vy%, "6. Jahr"
      Text 280 * fx + vx%, 390 * fy + vy%, "(Jahre von 1600 bis 2100)"
    EndIf
  EndIf
  Repeat
    PeekEvent
  Until And(_Mess = 0, InKey$ = "")
  Text 42 * fx + vx%, 270 * fy + vy%, "1. Zahl  ?"
  zahleingabe(270 * fy + vy%)
  If ende| = 1
    GoTo ende_selbst
  EndIf
  za$ = zh$
  a% = h%
  Select art|
  Case 1, 2
    If a% > 100
      Text 42 * fx + vx%, 390 * fy + vy%, gib$ + "eine kleinere Zahl ein!"
      falsch
      Repeat
        Sleep
      Until InKey$ <> ""
      abdecken
      GoTo neu2
    EndIf
  Case 3, 4, 5, 6, 10, 11, 14, 15, 16, 23, 24, 29, 30, 32, 33, 34, 35, 36, 37, 42, 43, 45, 46, 47, 48, 49, 50, 53
    If art| = 16 And stufe| = 3
      b% = 100
      zb$ = "100"
      GoTo weiter
    EndIf
    If art| = 46
      If stufe| = 1
        Select wahl|
        Case 4, 8
          zehn| = 1
          antwort% = a%
          If Len(za$) > 1
            antwort_$ = Trim$(Str$(a%))
          Else
            antwort_$ = Right$(Trim$(Str$(100 + a%)), 2)
          EndIf
          za$ = Left$(antwort_$, Len(antwort_$) - 1)
        Case 2, 5
          hundert| = 1
          antwort% = a%
          If Len(za$) > 2
            antwort_$ = Trim$(Str$(a%))
          Else
            antwort_$ = Right$(Trim$(Str$(1000 + a%)), 3)
          EndIf
          za$ = Left$(antwort_$, Len(antwort_$) - 2)
        Case 6, 7, 10, 11, 13
          tausend| = 1
          antwort% = a%
          If Len(za$) > 3
            antwort_$ = Trim$(Str$(a%))
          Else
            antwort_$ = Right$(Trim$(Str$(10000 + a%)), 4)
          EndIf
          za$ = Left$(antwort_$, Len(antwort_$) - 3)
        EndSelect
        GoTo weiter
      EndIf
    EndIf
    If art| = 53 And (wahl| = 1 Or wahl| = 2 Or wahl| = 4 Or wahl| = 5) ' Geld
      GoTo weiter
    EndIf
    Text 42 * fx + vx%, 290 * fy + vy%, "2. Zahl  ?"
    zahleingabe(290 * fy + vy%)
    If ende| = 1
      GoTo ende_selbst
    EndIf
    zb$ = zh$
    b% = h%
    If art| > 28 And a% = 0 And b% = 0
      Text 157 * fx + vx%, 325 * fy + vy%, gib$ + "eine größere Zahl ein!"
      falsch
      Repeat
        Sleep
      Until InKey$ <> ""
      abdecken
      GoTo neu1
    EndIf
    If art| = 53 And (wahl| = 3 Or wahl| = 6)
      a% = 100 * a% + b%
      za$ = Trim$(Str$(a%))
    EndIf
    weiter:
  Case 17 To 19
    aa% = a%
    zufall
    b% = aa%
    zb$ = Trim$(Str$(b%))
    Clr aa%
  Case 20 To 22
    aa% = a%
    zufall
    b% = Div(aa%, c%)
    rest% = aa% - b% * c%
    zb$ = Trim$(Str$(b%))
    Clr aa%
  Case 25, 26, 38, 39, 51, 52
    b% = a%
    zb$ = za$
  Case 27, 28
    If a% > 1000
      Text 42 * fx + vx%, 390 * fy + vy%, gib$ + "eine kleinere Zahl ein!"
      falsch
      Repeat
        Sleep
      Until InKey$ <> ""
      abdecken
      GoTo neu2
    EndIf
  Case 31
    If stufe| = 1
      c% = Round(a%, -1)
      If c% < a%
        Add c%, 10
      EndIf
      zc$ = Trim$(Str$(c%))
    Else If stufe| = 2
      c% = Round(a%, -2)
      If c% < a%
        Add c%, 100
      EndIf
      zc$ = Trim$(Str$(c%))
    Else
      c% = 1000
      zc$ = "1000"
    EndIf
    b% = c% - a%
    zb$ = Trim$(Str$(b%))
  Case 40, 41
    If a% > 1000999
      Text 42 * fx + vx%, 390 * fy + vy%, gib$ + "eine kleinere Zahl ein!"
      falsch
      Repeat
        Sleep
      Until InKey$ <> ""
      abdecken
      GoTo neu2
    Else
      stufe| = 3
      d% = Val(Right$(za$, 3))
      If a% > 1000
        a% = Val(Left$(za$, Len(za$) - 3))
        za$ = Trim$(Str$(a%))
      Else
        a% = 0
        za$ = ""
      EndIf
      antwort% = a% * 1000 + d%
    EndIf
  Case 44
    If stufe| = 1
      zc$ = "10000"
      c% = 10000
    Else If stufe| = 2
      c% = 100000
      zc$ = "100000"
    Else
      c% = 1000000
      zc$ = "1000000"
    EndIf
    b% = c% - a%
    zb$ = Trim$(Str$(b%))
  EndSelect
  Select art|
  Case 5
    If a% > b%
      Text 42 * fx + vx%, 390 * fy + vy%, "Die 2. Zahl muss größer als die 1. Zahl sein!"
      falsch
      Repeat
        Sleep
      Until InKey$ <> ""
      abdecken
      GoTo neu2
    EndIf
  Case 4, 6, 37
    If a% < b%
      Text 42 * fx + vx%, 390 * fy + vy%, "Die 2. Zahl muss kleiner als die 1. Zahl sein!"
      falsch
      Repeat
        Sleep
      Until InKey$ <> ""
      abdecken
      GoTo neu2
    EndIf
    antwort% = a% - b%
  Case 8, 9
    If Len(za$) > 1
      Text 42 * fx + vx%, 390 * fy + vy%, gib$ + "nur eine Ziffer ein!"
      falsch
      Repeat
        Sleep
      Until InKey$ <> ""
      abdecken
      GoTo neu2
    EndIf
  Case 23, 34, 45
    c% = b%
    b% = a%
    zc$ = Trim$(Str$(c%))
    zb$ = Trim$(Str$(b%))
  Case 24, 35
    If b% = 0
      Text 42 * fx + vx%, 390 * fy + vy%, "Nicht durch Null teilen!"
      falsch
      Repeat
        Sleep
      Until InKey$ <> ""
      abdecken
      GoTo neu2
    EndIf
    c% = b%
    b% = Div(a%, b%)
    rest% = a% - b% * c%
    zb$ = Trim$(Str$(b%))
    zc$ = Trim$(Str$(c%))
  Case 36, 47, 48
    Clr zc$, zd$, ze$, zf$
    GraphMode R2_COPYPEN, TRANSPARENT
    Text 250 * fx + vx%, 270 * fy + vy%, "genug Zahlen:      Fertig-Taste!"
    SetFont schriftw1%
    Color RGB(255, 0, 0) ' rot
    Text 377 * fx + vx%, 271 * fy + vy%, "ò"
    SetFont schrift1%
    Color RGB(0, 0, 0) ' schwarz
    If art| <> 48
      antwort% = a% + b%
    Else
      antwort% = b%
    EndIf
    zahlenraum_b% = 3
    antw_# = antwort%
    Repeat
      PeekEvent
      Text 42 * fx + vx%, 250 * fy + vy% + 20 * zahlenraum_b% * fy, Trim$(Str$(zahlenraum_b%)) + ". Zahl  ?"
      zahleingabe(250 * fy + vy% + 20 * zahlenraum_b% * fy)
      If ende| = 1
        GoTo ende_selbst
      EndIf
      Exit If aus% = 1
      If zahlenraum_b% = 3
        zc$ = zh$
        c% = h%
        Add antwort%, c%
        Add antw_#, c%
      Else If zahlenraum_b% = 4
        zd$ = zh$
        d% = h%
        Add antwort%, d%
        Add antw_#, d%
      Else If zahlenraum_b% = 5
        ze$ = zh$
        e% = h%
        Add antwort%, e%
        Add antw_#, e%
      Else If zahlenraum_b% = 6
        zf$ = zh$
        f% = h%
        Add antwort%, f%
        Add antw_#, f%
      EndIf
      Inc zahlenraum_b%
    Until zahlenraum_b% > 6
    If antw_# <> antwort%
      Text 42 * fx + vx%, 390 * fy + vy%, gib$ + "kleinere Zahlen ein!"
      falsch
      Repeat
        Sleep
      Until InKey$ <> ""
      abdecken
      Clr antw_#
      GoTo neu2
    Else
      Clr antw_#
    EndIf
    Clr zh$, h%, aus%
    If art| = 48
      antwort% = a% - antwort%
      If antwort% < 0
        If einzelner| = 1
          Text 42 * fx + vx%, 390 * fy + vy%, "Du ziehst zuviel ab!"
        Else
          Text 42 * fx + vx%, 390 * fy + vy%, "Ihr zieht zuviel ab!"
        EndIf
        falsch
        Repeat
          Sleep
        Until InKey$ <> ""
        abdecken
        GoTo neu2
      EndIf
    EndIf
  Case 46 ' Maße
    If stufe| > 1
      Select wahl|
      Case 4, 8
        zehn| = 1
        antwort% = a% * 10 + b%
        If antwort% > 9
          antwort_$ = Trim$(Str$(antwort%))
        Else
          antwort_$ = Right$(Trim$(Str$(100 + antwort%)), 2)
        EndIf
        If antwort% = 0
          antwort_$ = "00"
        EndIf
      Case 2, 5
        hundert| = 1
        antwort% = 100 * a% + b%
        If antwort% > 99
          antwort_$ = Trim$(Str$(antwort%))
        Else
          antwort_$ = Right$(Trim$(Str$(1000 + antwort%)), 3)
        EndIf
        If antwort% = 0
          antwort_$ = "000"
        EndIf
      Case 6, 7, 10, 11, 13
        tausend| = 1
        antwort% = a% * 1000 + b%
        If antwort% > 999
          antwort_$ = Trim$(Str$(antwort%))
        Else
          antwort_$ = Right$(Trim$(Str$(10000 + antwort%)), 4)
        EndIf
        If antwort% = 0
          antwort_$ = "0000"
        EndIf
      EndSelect
    EndIf
    If (stufe| = 3 And antwort% = 0) Or (stufe| = 3 And komma| = 2 And antwort1% = 0 And antwort% < 2)
      Text 157 * fx + vx%, 325 * fy + vy%, gib$ + "eine größere Zahl ein!"
      falsch
      Repeat
        Sleep
      Until InKey$ <> ""
      abdecken
      GoTo neu1
    Else If stufe| = 3 And komma| = 2 And antwort2% = 0 And antwort1% > 0 And (antwort1% - antwort% < 1) ' Subtrahieren
      Text 157 * fx + vx%, 325 * fy + vy%, "Nicht mehr abziehen als vorhanden ist!"
      falsch
      Repeat
        Sleep
      Until InKey$ <> ""
      abdecken
      GoTo neu1
    Else If stufe| = 3 And komma| = 2 And antwort3% = 0 And antwort2% > 0 And (antwort1% - antwort2% - antwort% < 0)  ' Subtrahieren
      Text 157 * fx + vx%, 325 * fy + vy%, "Nicht mehr abziehen als vorhanden ist!"
      falsch
      Repeat
        Sleep
      Until InKey$ <> ""
      abdecken
      GoTo neu1
    EndIf
  Case 53 ' Geld
    If (wahl| = 1 And a% > 1000) Or (wahl| = 2 And a% > 10000) Or (wahl| = 3 And a% > 1000000)
      Text 42 * fx + vx%, 390 * fy + vy%, gib$ + "eine kleinere Zahl ein!"
      falsch
      Repeat
        Sleep
      Until InKey$ <> ""
      abdecken
      GoTo neu2
    Else If wahl| = 4 And ((stufe| = 1 And a% > 10) Or (stufe| = 2 And a% > 20) Or (stufe| = 3 And a% > 100))
      Text 42 * fx + vx%, 390 * fy + vy%, gib$ + "eine kleinere Zahl ein!"
      falsch
      Repeat
        Sleep
      Until InKey$ <> ""
      abdecken
      GoTo neu2
    Else If wahl| = 5 And ((stufe| = 1 And a% > 20) Or (stufe| = 2 And a% > 100) Or (stufe| = 3 And a% > 1000))
      Text 42 * fx + vx%, 390 * fy + vy%, gib$ + "eine kleinere Zahl ein!"
      falsch
      Repeat
        Sleep
      Until InKey$ <> ""
      abdecken
      GoTo neu2
    Else If wahl| = 6 And ((stufe| = 1 And a% > 1000) Or (stufe| = 2 And a% > 2000) Or (stufe| = 3 And a% > 10000))
      Text 42 * fx + vx%, 390 * fy + vy%, gib$ + "kleinere Zahlen ein!"
      falsch
      Repeat
        Sleep
      Until InKey$ <> ""
      abdecken
      GoTo neu2
    EndIf
    If wahl| > 8
      Text 42 * fx + vx%, 310 * fy + vy%, "3. Zahl  ?"
      zahleingabe(310 * fy + vy%)
      If ende| = 1
        GoTo ende_selbst
      EndIf
      zc$ = zh$
      c% = h%
      Text 42 * fx + vx%, 330 * fy + vy%, "4. Zahl  ?"
      zahleingabe(330 * fy + vy%)
      If ende| = 1
        GoTo ende_selbst
      EndIf
      zd$ = zh$
      d% = h%
    EndIf
    If wahl| = 7
      If a% < 1 Or a% > 12 Or b% < 0 Or b% > 59
        Text 42 * fx + vx%, 390 * fy + vy%, gib$ + "richtige Zahlen ein!"
        falsch
        Repeat
          Sleep
        Until InKey$ <> ""
        abdecken
        Put 0, 0, uhr1$
        Color RGB(255, 255, 198) ' creme
        PRBox 490 * fx + vx%, 24 * fy + vy%, 617 * fx + vx%, 160 * fy + vy% ' Abdeckung
        GoTo neu2
      EndIf
    Else If wahl| > 7 And wahl| < 12
      If a% < 0 Or a% > 23 Or c% < 0 Or c% > 23 Or b% < 0 Or b% > 59 Or d% < 0 Or d% > 59
        Text 42 * fx + vx%, 390 * fy + vy%, gib$ + "richtige Zahlen ein!"
        falsch
        Repeat
          Sleep
        Until InKey$ <> ""
        abdecken
        If wahl| = 8
          Put 0, 0, uhr1$
          Color RGB(255, 255, 198) ' creme
          PRBox 490 * fx + vx%, 24 * fy + vy%, 617 * fx + vx%, 160 * fy + vy% ' Abdeckung
        EndIf
        GoTo neu2
      EndIf
    Else If wahl| > 11
      Text 42 * fx + vx%, 350 * fy + vy%, "5. Zahl  ?"
      zahleingabe(350 * fy + vy%)
      If ende| = 1
        GoTo ende_selbst
      EndIf
      ze$ = zh$
      e% = h%
      Text 42 * fx + vx%, 370 * fy + vy%, "6. Zahl  ?"
      zahleingabe(370 * fy + vy%)
      If ende| = 1
        GoTo ende_selbst
      EndIf
      zf$ = zh$
      f% = h%
      If c% > f% Or (c% = f% And b% > e%) Or (c% = f% And b% = e% And a% > d%)
        Swap c%, f%
        Swap b%, e%
        Swap a%, d%
      EndIf
      If a% < 1 Or a% > 31 Or b% < 1 Or b% > 12 Or c% < 1600 Or c% > 2100 Or d% < 1 Or d% > 31 Or e% < 1 Or e% > 12 Or f% < 1600 Or f% > 2100
        Text 42 * fx + vx%, 390 * fy + vy%, gib$ + "richtige Zahlen ein!"
        falsch
        Repeat
          Sleep
        Until InKey$ <> ""
        abdecken
        GoTo neu2
      EndIf
      If (a% > 30 And (b% = 4 Or b% = 6 Or b% = 9 Or b% = 11)) Or (d% > 30 And (e% = 4 Or e% = 6 Or e% = 9 Or e% = 11))
        Text 42 * fx + vx%, 390 * fy + vy%, gib$ + "richtige Zahlen ein!"
        falsch
        Repeat
          Sleep
        Until InKey$ <> ""
        abdecken
        GoTo neu2
      EndIf
      If a% > 28 And b% = 2
        If Mod(c%, 4) <> 0 Or c% = 1600 Or c% = 2000
          Text 42 * fx + vx%, 390 * fy + vy%, gib$ + "richtige Zahlen ein!"
          falsch
          Repeat
            Sleep
          Until InKey$ <> ""
          abdecken
          GoTo neu2
        Else If a% > 29
          Text 42 * fx + vx%, 390 * fy + vy%, gib$ + "richtige Zahlen ein!"
          falsch
          Repeat
            Sleep
          Until InKey$ <> ""
          abdecken
          GoTo neu2
        EndIf
      EndIf
      If d% > 28 And e% = 2
        If Mod(f%, 4) <> 0 Or f% = 1600 Or f% = 2000
          Text 42 * fx + vx%, 390 * fy + vy%, gib$ + "richtige Zahlen ein!"
          falsch
          Repeat
            Sleep
          Until InKey$ <> ""
          abdecken
          GoTo neu2
        Else If d% > 29
          Text 42 * fx + vx%, 390 * fy + vy%, gib$ + "richtige Zahlen ein!"
          falsch
          Repeat
            Sleep
          Until InKey$ <> ""
          abdecken
          GoTo neu2
        EndIf
      EndIf
      za$ = Trim$(Str$(a%))
      zb$ = Trim$(Str$(b%))
      zc$ = Trim$(Str$(c%))
      zd$ = Trim$(Str$(d%))
      ze$ = Trim$(Str$(e%))
      zf$ = Trim$(Str$(f%))
    EndIf
  EndSelect
  Color RGB(255, 255, 198) ' creme
  If wahl| < 9 And art| = 53
    PBox 15 * fx + vx%, 238 * fy + vy%, 400 * fx + vx%, 440 * fy + vy% ' Abdeckung
  Else
    abdecken
  EndIf
  ende_selbst:
  DefLine 0, 1
Return
>Procedure zahleingabe(j%)
  Clr zh$, h%
  If art| = 46
    If stufe| = 1
      Text 42 * fx + vx%, 365 * fy + vy%, gib$ + "ein:   " + mass1$
    Else
      If geldwahl| = 2
        Text 42 * fx + vx%, 365 * fy + vy%, gib$ + "ein:   1. €"
      Else
        Text 42 * fx + vx%, 365 * fy + vy%, gib$ + "ein:   1. " + mass$
      EndIf
      Text 42 * fx + vx%, 390 * fy + vy%, gib$ + "ein:   2. " + mass1$
    EndIf
  EndIf
  Repeat
    Repeat
      Sleep
      ink$ = InKey$
    Until ink$ <> ""
    If ink$ = Chr$(13) And zh$ = ""
      aus% = 1
    EndIf
    Exit If ink$ = Chr$(13)                  ' Return
    If Len(ink$) > 1 And Asc(Right$(ink$)) = 119  ' F8
      ende| = 1
      Clr zh$, h%, f1%
      GoTo ende_zahl
    EndIf
    If ink$ = Chr$(8) And zh$ <> ""             ' Backspace
      zh$ = Left$(zh$, Len(zh$) - 1)
      Color RGB(255, 255, 198) ' creme
      PBox 160 * fx + vx% + TxtLen(zh$), j%, 160 * fx + vx% + TxtLen(zh$) + zeichenbr%, j% + zeichenh%
      h% = Val(zh$)
    Else If ink$ <> Chr$(8) And ((Asc(ink$) > 47 And Asc(ink$) < 58) Or (ink$ = "-" And zh$ = "" And (art| = 29 Or art| = 30 Or (art| > 31 And art| < 36) Or art| = 38 Or art| = 39 Or art| = 42 Or art| = 43 Or art| = 44 Or art| = 51 Or art| = 52)))
      zh$ = zh$ + ink$
      h% = Val(zh$)
    EndIf
    Color RGB(0, 0, 0) ' schwarz
    Text 160 * fx + vx%, j%, zh$
  Until h% > 100000000 Or h% < -100000000 Or (art| = 46 And stufe| = 3 And Len(Trim$(Str$(h%))) > 2) Or (art| = 46 And stufe| = 2 And (h% > 1000 Or h% < -1000))
  Clr i%
  zh$ = Trim$(Str$(h%))
  ende_zahl:
Return
>Procedure hauptmenue
  neubeginn:
  If f1% = 1 And ende| = 0
    GoTo korrektur
  EndIf
  If zugross| = 1
    Clr zugross|
    GoTo neu
  EndIf
  Clr aa2%, alertf|, altart|, antwort1%, antwort2%, antwort3%, antwort1_$, antwort2_$
  Clr antwort3_$, art|, aufgabenwahl|, aus%, beginn|, beginn1|, eingabe_$, ende|, f1%, falsch%
  Clr falsch1|, falsch_alt|, fehler|, fortsetzung|, geldwahl|, gruen%, hilfe|, hilferuf|, inv|
  Clr hundert|, k%, komma|, l%, laenge|, neu$, rechnen|, rechnenalt|, rest%, rest50%, richtig1%
  Clr richtig_alt|, schreibweise|, stufe|, stufealt|, tausend|, teilen|, textl%
  Clr uebertr|, ueb%, wahl|, wechsel|, weiter|, v|, zehn|
  GraphMode R2_COPYPEN, OPAQUE
  menue
  If art| <> 53  ' Geld, Uhr, Zeit
    menueabfrage
  EndIf
  zeit# = oTimer
  If art| <> 46 And art| <> 53 Or (art| = 53 And wahl| > 8)
    rechenblatt
    Stretch 536 * fx + vx%, 45 * fy + vy%, grins, 50 * fx, 56 * fy
  Else If art| = 53 And (wahl| = 7 Or wahl| = 8)
    Put 0, 0, uhr1$
  EndIf
  neu:
  Clr eing$, antwort_$, pfeil%, xx%
  If fehler| = 1 And art| <> 36 And art| <> 37 And art| <> 47 And art| <> 48 And art| <> 49 And art| <> 50
    GoTo korrektur
  EndIf
  If fortsetzung| = 0
    If aufgabenwahl| = 1
      If rest50% = 0
        zufall
      EndIf
      If art| <> 53
        abdecken
      EndIf
    Else
      selbsteingabe
      If ende| = 1
        kontrolle
        GoTo neubeginn
      EndIf
    EndIf
  EndIf
  korrektur:
  Color RGB(0, 0, 0) ' schwarz
  SetFont schrift3%
  GraphMode R2_COPYPEN, TRANSPARENT
  antwy% = 29 * fy + vy%
  Select art|
  Case 1
    a1
  Case 2
    a2
  Case 3
    a3
  Case 4
    a4
  Case 5
    a5
  Case 6
    a6
  Case 7
    a7
  Case 8
    a8
  Case 9
    a9
  Case 10
    a10
  Case 11
    a11
  Case 12
    a12
  Case 13
    a13
  Case 14
    a14
  Case 15
    a15
  Case 16
    a16
  Case 17, 18, 19, 23, 34, 45
    a17
  Case 20, 21, 22, 24, 35
    a20
  Case 25, 38, 51
    a25
  Case 26, 39, 52
    a26
  Case 27
    a27
  Case 28
    a28
  Case 29, 32, 42
    a29
  Case 30, 33, 43
    a30
  Case 31, 44
    a31
  Case 36, 47
    a36
  Case 37, 48
    a37
  Case 40
    a40
  Case 41
    a41
  Case 46
    a46
  Case 49
    a49
  Case 50
    a50
  Case 53
    geld_uhr
  EndSelect
  If art| <> 36 And art| <> 37 And art| <> 40 And art| <> 46 And art| <> 47 And art| <> 48 And art| <> 49 And art| <> 50 And art| <> 53
    If eing$ = ""
      Color RGB(255, 0, 0) ' rot
      Box antwx%, antwy% + Int(4 * fy), antwx% + zeichenbr% - Ceil(2 * fx), antwy% + zeichenh%
    EndIf
    input1(antwx%, antwy%, eingabe_$)
  EndIf
  If fortsetzung| = 1 And ende| = 1 And art| = 41
    kontrolle
    GoTo neubeginn
  EndIf
  If fortsetzung| = 0
    Clr fehler|
    kontrolle
    If ende| = 1
      GoTo neubeginn
    EndIf
  EndIf
  anpassung
  GoTo neu
Return
>Procedure kontrolle
  If (art| = 53 And wahl| < 7 And ende| = 1) Or (art| = 53 And wahl| < 7 And aufgabenwahl| = 2)   ' Geld
    abdecken
    Color RGB(255, 255, 198) ' creme
    PBox 14 * fx + vx%, 238 * fy + vy%, 70 * fx + vx%, 410 * fy + vy%
    PRBox 16 * fx + vx%, 238 * fy + vy%, 400 * fx + vx%, 438 * fy + vy% ' Abdeckung Geldbox
    PBox 399 * fx + vx%, 248 * fy + vy%, 510 * fx + vx%, 420 * fy + vy%   ' Abdeckung rechts
    DefLine 0, 5 * fy
    PRBox 17 * fx + vx%, 240 * fy + vy%, 395 * fx + vx%, 462 * fy + vy%
    DefLine 0, 1
  Else If art| = 53 And (wahl| = 7 Or wahl| = 8) ' Uhr
    Put 0, 0, uhr1$
    Color RGB(255, 255, 198) ' creme
    PRBox 490 * fx + vx%, 24 * fy + vy%, 617 * fx + vx%, 160 * fy + vy% ' Abdeckung
  EndIf
  GraphMode R2_COPYPEN, TRANSPARENT
  If ende| = 1
    GoTo ende
  EndIf
  If rest% <> 0
    neu11:
    If eingabe_$ = Trim$(Str$(antwort%))
      Color RGB(0, 0, 0) ' schwarz
      If schreibweise| = 0
        Text antwx% + TxtLen(eingabe_$) + zeichenbr%, antwy%, "Rest"
      Else
        Add antwx%, TxtLen(zc$)
        Text antwx% + TxtLen(eingabe_$) + zeichenbr% * 4, antwy%, "+"
      EndIf
      Color RGB(255, 0, 0) ' rot
      Box antwx% + TxtLen(eingabe_$) + zeichenbr% * 6 + 2 * fx, antwy% + 4 * fy, antwx% + TxtLen(eingabe_$) + zeichenbr% * 7 - 2 * fx, antwy% + zeichenh%
      restlaenge% = 1
      rest_$ = ""
      eing$ = ""
'##B#
      input1(antwx% + TxtLen(eingabe_$) + zeichenbr% * 6 + 2 * fx - 1, antwy%, rest_$)
      Clr restlaenge%
      If Val(Trim$(rest_$)) = rest%
        Clr falsch1|, rest%
        Inc richtig1%
      Else
        If art| = 50
          Color RGB(255, 255, 198) ' creme
          PRBox 40 * fx + vx%, 374 * fy + vy%, 510 * fx + vx%, 464 * fy + vy%     ' Textabdeckung
          falsch
          SetFont schrift1%
          Color RGB(0, 0, 0) ' schwarz
          If einzelner| = 1
            Text 42 * fx + vx%, 350 * fy + vy%, "Du findest den Rest in deiner letzten Zeile!"
          Else
            Text 42 * fx + vx%, 350 * fy + vy%, "Ihr findet den Rest in eurer letzten Zeile!"
          EndIf
          SetFont schrift3%
          Repeat
            Sleep
          Until InKey$ <> ""
        EndIf
        rest_$ = ""
        Inc falsch1|
        Inc falsch%
        fehler| = 1
        fehlerb| = 1
        If art| = 50
          rest50% = 1
        EndIf
      EndIf
    Else
      Inc falsch1|
      Inc falsch%
      fehler| = 1
      fehlerb| = 1
    EndIf
  Else
    If (Val(eingabe_$) = antwort% And art| <> 2 And art| <> 28 And art| <> 41) Or ((art| = 2 Or art| = 28 Or art| = 41) And a% = Len(eingabe_$))
      Clr falsch1|
      Inc richtig1%
    Else
      Inc falsch1|
      Inc falsch%
      fehler| = 1
      fehlerb| = 1
    EndIf
  EndIf
  ende:
  saeule
  GraphMode R2_COPYPEN, TRANSPARENT
  If richtig1% = 90 Or falsch% = 90 Or ende| = 1 Or (art| = 53 And wahl| < 9 And (richtig1% = 45 Or falsch% = 45))
    SetFont schrift1%
    ende| = 1
    If richtig1% + falsch% = 0
      GoTo neuwahl
    Else If richtig1% + falsch% > 0
      zeitneu# = oTimer
      sekunden% = Div((zeitneu# - zeit#), 1000)
      zeitm% = Div(sekunden%, 60)
      zeits% = sekunden% - zeitm% * 60
      abdecken
      Color RGB(0, 0, 0) ' schwarz
      Text 42 * fx + vx%, 275 * fy + vy%, Min(nam$, Left$(nam$, 25)) + ","
      If richtig1% + falsch% = 1 And richtig1% = 1
        If einzelner| = 1
          Text 42 * fx + vx%, 300 * fy + vy%, "du hast eine Aufgabe"
        Else
          Text 42 * fx + vx%, 300 * fy + vy%, "ihr habt eine Aufgabe"
        EndIf
        Text 42 * fx + vx%, 325 * fy + vy%, "in " + Trim$(Str$(zeitm%)) + " min und " + Trim$(Str$(zeits%)) + " s gelöst!"
      Else If richtig1% + falsch% = 1 And richtig1% = 0
        If einzelner| = 1
          Text 42 * fx + vx%, 300 * fy + vy%, "du hast keine Aufgabe gelöst!"
        Else
          Text 42 * fx + vx%, 300 * fy + vy%, "ihr habt keine Aufgabe gelöst!"
        EndIf
        Text 42 * fx + vx%, 325 * fy + vy%, "Zeit: " + Trim$(Str$(zeitm%)) + " min und " + Trim$(Str$(zeits%)) + " s"
      Else
        If einzelner| = 1
          Text 42 * fx + vx%, 300 * fy + vy%, "du hast " + Trim$(Str$(richtig1%)) + " von " + Trim$(Str$(richtig1% + falsch%)) + " Aufgaben"
        Else
          Text 42 * fx + vx%, 300 * fy + vy%, "ihr habt " + Trim$(Str$(richtig1%)) + " von " + Trim$(Str$(richtig1% + falsch%)) + " Aufgaben"
        EndIf
        Text 42 * fx + vx%, 325 * fy + vy%, "in " + Trim$(Str$(zeitm%)) + " min und " + Trim$(Str$(zeits%)) + " s gelöst!"
      EndIf
      Text 42 * fx + vx%, 375 * fy + vy%, "Ergebnis ausdrucken?"
      Text 42 * fx + vx%, 400 * fy + vy%, "ja:       j   ***   nein:       Taste F8"
      Color RGB(255, 0, 0) ' rot
      SetFont schriftw1%
      Text 72 * fx + vx%, 401 * fy + vy%, "ò      ò"
      SetFont schrift1%
      Repeat
        PeekEvent
      Until InKey$ = ""
      Repeat
        Sleep
        ink$ = InKey$
      Until ink$ = "j" Or ink$ = "J" Or (Len(ink$) = 2 And Asc(Right$(ink$)) = 119) ' F8
      Repeat
        PeekEvent
      Until InKey$ = ""
      DefMouse 0
      If ink$ = "j" Or ink$ = "J"
        If drucken| = 0
          druckeinrichtung
        EndIf
        Clr ink$
        If print| = 1   ' Drucker angeschaltet
          Output = Printer
          If seitenh% - seite% < zeilenh% * 5
            Printer.EndPage
            Printer.StartPage
            seite% = zeilenh% * 3
          EndIf
          Repeat
            PeekEvent
          Until _Mess = 0
          Color RGB(0, 0, 0) ' schwarz
          SetFont schriftdr%
          Text zeilenh% * 2, seite%, nam$ + ",  " + Date$ + ",  " + Time$
          Add seite%, zeilenh%
          If richtig1% + falsch% = 1 And richtig1% = 1
            If rechnen| < 5
              Text zeilenh% * 2, seite%, "Richtig war eine Aufgabe, Rechnen " + Trim$(Str$(rechnen|)) + ", Zeile " + Trim$(Str$(Mod(art|, 13))) + ", Stufe " + Trim$(Str$(stufe|)) + "."
            Else
              Text zeilenh% * 2, seite%, "Richtig war eine Aufgabe, Geld/Zeit, Zeile " + Trim$(Str$(wahl|)) + ", Stufe " + Trim$(Str$(stufe|)) + "."
            EndIf
          Else If richtig1% + falsch% = 1 And richtig1% = 0
            If rechnen| < 5
              Text zeilenh% * 2, seite%, "Richtig war keine Aufgabe, Rechnen " + Trim$(Str$(rechnen|)) + ", Zeile " + Trim$(Str$(Mod(art|, 13))) + ", Stufe " + Trim$(Str$(stufe|)) + "."
            Else
              Text zeilenh% * 2, seite%, "Richtig war keine Aufgabe, Geld/Zeit, Zeile " + Trim$(Str$(wahl|)) + ", Stufe;" + Trim$(Str$(stufe|)) + "."
            EndIf
          Else
            If rechnen| < 5
              Text zeilenh% * 2, seite%, "Richtig waren " + Trim$(Str$(richtig1%)) + " von " + Trim$(Str$(richtig1% + falsch%)) + " Aufgaben, Rechnen " + Trim$(Str$(rechnen|)) + ", Zeile " + Trim$(Str$(Mod(art|, 13))) + ", Stufe " + Trim$(Str$(stufe|)) + "."
            Else
              Text zeilenh% * 2, seite%, "Richtig waren " + Trim$(Str$(richtig1%)) + " von " + Trim$(Str$(richtig1% + falsch%)) + " Aufgaben, Geld/Zeit, Zeile " + Trim$(Str$(wahl|)) + ", Stufe " + Trim$(Str$(stufe|)) + "."
            EndIf
          EndIf
          Add seite%, zeilenh%
          Text zeilenh% * 2, seite%, "Zeit: " + Trim$(Str$(zeitm%)) + " min und " + Trim$(Str$(zeits%)) + " s"
          Add seite%, zeilenh%
          If hilferuf| = 1
            Text zeilenh% * 2, seite%, "Hilfe: ja"
          Else
            Text zeilenh% * 2, seite%, "Hilfe: nein"
          EndIf
          Add seite%, zeilenh%
          If aufgabenwahl| = 1
            Text zeilenh% * 2, seite%, "Aufgabenwahl: Computer"
          Else
            Text zeilenh% * 2, seite%, "Aufgabenwahl: selbst"
          EndIf
          Add seite%, zeilenh% * 2
          Repeat
            PeekEvent
          Until _Mess = 0
          Output = Win_1
          SetFont schrift3%
        EndIf
      EndIf
      If speichern_| > 0
        speichern       '  Ergebnis auf Diskette speichern, falls gewünscht
      EndIf
    EndIf
    neuwahl:
  EndIf
Return
>Procedure druckeinrichtung
  alert2("Ist der Drucker angeschaltet?", "ja", "nein")
  If alertf| = 1
    drucken| = 1  ' Drucken erwünscht
    print| = 1    ' Drucker ist angeschaltet
    Output = Printer
    seitenh% = GetDevCaps(VERTRES)
    zeilenh% = 10 * Int(seitenh% / 640)
    Printer.StartDoc "Rechnen"   ' Ausdruck-Dokument
    Printer.StartPage
    Font "arial", CharSet ANSI_CHARSET, Family FF_DONTCARE, Width zeilenh% * 0.4, Height zeilenh%, To schriftdr%
    seite% = zeilenh% * 3
  EndIf
Return
>Procedure saeule
  GraphMode R2_COPYPEN, TRANSPARENT
  DefFill 0
  If art| <> 53 And art| <> 46 And art| <> 41 Or (art| = 41 And fortsetzung| = 0)
    Put 0, 0, rechenblatt1$
    abdecken
  Else If art| = 46 And fortsetzung| = 0
    Put 0, 0, rechenblatt1$
    abdecken
  Else If art| = 53 And wahl| > 8
    Put 0, 0, rechenblatt1$
    abdecken
  EndIf
  Color RGB(255, 255, 255), ' weiß
  SetFont schrift0
  Text Int((_X - vx% - TxtLen(nam$)) / 2), 464 * fy + vy%, nam$
  If fehler| = 1
    If art| = 53 And wahl| < 9
      Stretch 536 * fx + vx%, 225 * fy + vy%, heul, 50 * fx, 56 * fy
    Else
      Stretch 536 * fx + vx%, 45 * fy + vy%, heul, 50 * fx, 56 * fy
    EndIf
  Else
    If art| = 53 And wahl| < 9
      Stretch 536 * fx + vx%, 225 * fy + vy%, grins, 50 * fx, 56 * fy
    Else
      Stretch 536 * fx + vx%, 45 * fy + vy%, grins, 50 * fx, 56 * fy
    EndIf
  EndIf
  Color RGB(255, 255, 255) ' weiß
  SetFont schrift0%
  Text Int((_X  - vx% - TxtLen(nam$)) / 2), 464 * fy + vy%, nam$
  SetFont schrift3%
  If richtig1% > 0
    Color RGB(0, 0, 235) ' blau
    PBox 570 * fx + vx%, 472 * fy + vy% - richtig1% * 4 * fy, 611 * fx + vx%, 462 * fy + vy% - richtig1% * 4 * fy
    If richtig1% >= 9
      Stretch 570 * fx + vx%, 430 * fy + vy%, katze, 41 * fx, 33 * fy
    EndIf
    If richtig1% >= 18
      Stretch 570 * fx + vx%, 394 * fy + vy%, elefant, 41 * fx, 33 * fy
    EndIf
    If richtig1% >= 27
      Stretch 570 * fx + vx%, 358 * fy + vy%, kueken, 41 * fx, 33 * fy
    EndIf
    If richtig1% >= 36
      Stretch 570 * fx + vx%, 322 * fy + vy%, baum, 41 * fx, 33 * fy
    EndIf
    If richtig1% >= 45
      Stretch 570 * fx + vx%, 286 * fy + vy%, kirche, 41 * fx, 33 * fy
    EndIf
    If richtig1% >= 54
      Stretch 570 * fx + vx%, 250 * fy + vy%, ski, 41 * fx, 33 * fy
    EndIf
    If richtig1% >= 63
      Stretch 570 * fx + vx%, 214 * fy + vy%, hase, 41 * fx, 33 * fy
    EndIf
    If richtig1% >= 72
      Stretch 570 * fx + vx%, 178 * fy + vy%, blume, 41 * fx, 33 * fy
    EndIf
    If richtig1% >= 81
      Stretch 570 * fx + vx%, 142 * fy + vy%, sonne, 41 * fx, 33 * fy
    EndIf
    If richtig1% >= 90
      Stretch 570 * fx + vx%, 106 * fy + vy%, eis, 41 * fx, 33 * fy
    EndIf
  EndIf
  If falsch% > 0
    Color RGB(160, 160, 160) ' grau
    PBox 512 * fx + vx%, 472 * fy + vy% - falsch% * 4 * fy, 552 * fx + vx%, 462 * fy + vy% - falsch% * 4 * fy
  EndIf
Return
>Procedure speichern
  If speichern_| = 1
    speichern_| = 2
    nam1$ = nam$
    If nam$ <> ""
      If InStr(nam1$, "und") <> 0
        nam1$ = Left$(nam1$, InStr(nam1$, "und") - 1) + "_" + Right$(nam1$, Len(nam1$) - InStr(nam1$, "und") - 2)
      EndIf
      If InStr(nam1$, "+") <> 0
        nam1$ = Left$(nam1$, InStr(nam1$, "+") - 1) + "_" + Right$(nam1$, Len(nam1$) - InStr(nam1$, "+"))
      EndIf
      If InStr(nam1$, " ") <> 0
        Repeat
          PeekEvent
          nam1$ = Left$(nam1$, InStr(nam1$, " ") - 1) + Right$(nam1$, Len(nam1$) - InStr(nam1$, " "))
        Until InStr(nam1$, " ") = 0
        pfad$ = pfad$ + "\Rechnen\" + Left$(nam1$, Min(Len(nam1$), 8)) + ".TXT"
      Else
        pfad$ = pfad$ + "\Rechnen\" + nam1$ + ".TXT"
      EndIf
    Else
      pfad$ = pfad$ + "\Rechnen\Rechnen" + ".txt"
    EndIf
  EndIf
  If richtig1% + falsch% > 0
    prozent% = Round(richtig1% / (richtig1% + falsch%) * 100)
    s_a% = Round((zeitm% * 60 + zeits%) / (richtig1% + falsch%))
  Else
    prozent% = 0
    s_a% = 0
  EndIf
  If Exist(pfad$) = 0
    Open pfad$ for Output As # 1
    Print # 1
    Print # 1, nam$
    Print # 1, "     Datum   Zeit  Rechnen Zeile Stufe  min  s  a  H  richtig gesamt  s/a    %"
  Else
    Open pfad$ for Append As # 1
  EndIf
  zd$ = Date$
  ink$ = Space$(7)
  Rset ink$ = Left$(Time$, 5)
  rechnen_$ = Space$(9)
  Rset rechnen_$ = Trim$(Str$(rechnen|))
  art_$ = Space$(6)
  If rechnen| < 5
    Rset art_$ = Trim$(Str$(Mod(art|, 13)))
  Else
    Rset art_$ = Trim$(Str$(wahl|))
  EndIf
  stufe_$ = Space$(6)
  Rset stufe_$ = Trim$(Str$(stufe|))
  zeitm_$ = Space$(5)
  Rset zeitm_$ = Trim$(Str$(zeitm%))
  zeits_$ = Space$(3)
  Rset zeits_$ = Trim$(Str$(zeits%))
  aufg$ = Space$(3)
  If aufgabenwahl| = 1
    Rset aufg$ = "C"
  Else
    Rset aufg$ = "s"
  EndIf
  hilfe_$ = Space$(3)
  If hilferuf| = 0
    Rset hilfe_$ = "n"
  Else
    Rset hilfe_$ = "j"
  EndIf
  richtig_$ = Space$(9)
  Rset richtig_$ = Trim$(Str$(richtig1%))
  richtig_falsch_$ = Space$(7)
  Rset richtig_falsch_$ = Trim$(Str$(richtig1% + falsch%))
  s_a_$ = Space$(5)
  Rset s_a_$ = Trim$(Str$(s_a%))
  prozent_$ = Space$(5)
  Rset prozent_$ = Trim$(Str$(prozent%))
  Print # 1, zd$; ink$; rechnen_$; art_$; stufe_$; zeitm_$; zeits_$; aufg$; hilfe_$; richtig_$; richtig_falsch_$; s_a_$; prozent_$
  Close # 1
Return
>Procedure anpassung
  If richtig1% > richtig_alt|
    richtig_alt| = richtig1%
    If art| = 36 Or art| = 47 Or art| = 48
      If wechsel| = 1
        If zahlenraum_b% < grenze%
          Inc zahlenraum_b%
        EndIf
        Clr wechsel|
      Else
        wechsel| = 1
      EndIf
    Else If zahlenraum_b% < grenze%
      Inc zahlenraum_b%
    EndIf
  EndIf
  If falsch% > falsch_alt|
    falsch_alt| = falsch%
    If zahlenraum_b% > 3 And (art| = 36 Or art| = 47 Or art| = 48)
      Dec zahlenraum_b%
    Else If zahlenraum_b% > 4
      Dec zahlenraum_b%
    EndIf
  EndIf
Return
>Procedure zahlenraum
  zahlenraum_b% = 5
  If rechnen| = 1
    zahlenraum_a% = 11
    If stufe| = 2
      zahlenraum_a% = 21
    EndIf
    If stufe| = 3
      zahlenraum_a% = 101
    EndIf
  EndIf
  If rechnen| = 2
    zahlenraum_a% = 101
  EndIf
  If rechnen| = 3 Or rechnen| = 4
    zahlenraum_a% = 1001
    If art| = 36 Or art| = 47 Or art| = 48
      zahlenraum_b% = 3
    EndIf
  EndIf
Return
>Procedure zufall
  zuf:
  a% = Random(zahlenraum_a%)
  b% = Random(zahlenraum_b%)
  c% = Random(11)
  d% = Random(1001)
  If a% = 0 Or a% = 1
    a% = Random(zahlenraum_a%)
  EndIf
  If b% = 0 Or b% = 1
    b% = Random(zahlenraum_b%)
  EndIf
  If c% = 0 Or c% = 1
    c% = Random(11)
  EndIf
  If a% = alta%
    If a% - 1 > 0
      Dec a%
    Else
      Inc a%
    EndIf
  EndIf
  If b% = altb%
    If b% - 1 > 0
      Dec b%
    Else
      Inc b%
    EndIf
  EndIf
  If c% = altc%
    If c% < 10
      Inc c%
    Else
      Dec c%
    EndIf
  EndIf
  If fehlerb| = 1
    Clr fehlerb|
    b% = altb%
  EndIf
  alta% = a%
  altb% = b%
  altc% = c%
  za$ = Trim$(Str$(a%))
  zb$ = Trim$(Str$(b%))
  zc$ = Trim$(Str$(c%))
  zd$ = Trim$(Str$(d%))
  Select art|
  Case 3
    If stufe| = 3
      a% = c% * 10
      b% = b% * 10
      If a% + b% > 100
        GoTo zuf
      EndIf
    Else
      If Val(Right$(za$)) + Val(Right$(zb$)) > 10 Or (Val(Right$(za$)) <> 0 And Len(zb$) <> 1) Or a% + b% > zahlenraum_a% - 1
        GoTo zuf
      EndIf
    EndIf
  Case 4
    If stufe| = 3
      a% = c% * 10
      b% = b% * 10
      If a% - b% < 0
        GoTo zuf
      EndIf
    Else
      If a% - b% < 0 Or (Val(Right$(za$)) <> 0 And Val(Right$(za$)) - Val(Right$(zb$)) < 0) Or (Val(Right$(za$)) <> 0 And Len(zb$) <> 1)
        GoTo zuf
      EndIf
    EndIf
  Case 5
    If stufe| = 3
      a% = c% * 10
      b% = b% * 10
      If a% - b% < 0
        GoTo zuf
      EndIf
    Else
      If Val(Right$(za$)) <> 0 And (Val(Right$(za$)) < Val(Right$(zb$)) Or Len(zb$) > 1) Or a% - b% < 0
        GoTo zuf
      EndIf
    EndIf
  Case 6
    If stufe| = 3
      a% = c% * 10
      b% = b% * 10
      If a% - b% < 0
        GoTo zuf
      EndIf
    Else
      If Val(Right$(za$)) <> 0 And (Val(Right$(za$)) < Val(Right$(zb$)) Or Len(zb$) > 1) Or a% - b% < 0
        GoTo zuf
      EndIf
    EndIf
  Case 7
    Select stufe|
    Case 1
      c% = 10
      zc$ = "10"
    Case 2
      c% = 20
      zc$ = "20"
    Case 3
      Mul b%, 10
      c% = 100
      zc$ = "100"
    EndSelect
  Case 8
    Select stufe|
    Case 1
      c% = 10
      zc$ = "10"
    Case 2
      c% = 20
      zc$ = "20"
    Case 3
      Mul b%, 10
      c% = 100
      zc$ = "100"
    EndSelect
  Case 9
    Select stufe|
    Case 1
      c% = 0
      zc$ = "0"
    Case 2
      c% = 10
      zc$ = "10"
    Case 3
      If c% > 9
        GoTo zuf
      EndIf
      Mul c%, 10
    EndSelect
  Case 10
    If stufe| = 3
      If Val(Right$(za$)) + Val(Right$(zb$)) > 10 Or (Val(Right$(za$)) <> 0 And Len(zb$) <> 1)
        GoTo zuf
      EndIf
    Else
      a% = Val(Right$(za$))
      If stufe| = 2
        If Len(Trim$(Str$(a% + b%))) < 2
          GoTo zuf
        EndIf
      EndIf
    EndIf
    If a% + b% > zahlenraum_a% - 1
      GoTo zuf
    EndIf
  Case 11
    If stufe| = 3
      If (Val(Right$(za$)) <> 0 And Val(Right$(za$)) - Val(Right$(zb$)) < 0) Or (Val(Right$(za$)) <> 0 And Len(zb$) <> 1)
        GoTo zuf
      EndIf
    Else
      If stufe| = 2
        a% = 10 + Val(Right$(za$))
        If Len(Trim$(Str$(a% - b%))) > 1
          GoTo zuf
        EndIf
      EndIf
    EndIf
    If a% - b% < 0
      GoTo zuf
    EndIf
  Case 12
    If stufe| = 2 And zahlenraum_b% < 10
      Inc zahlenraum_b%
    Else If stufe| = 3
      Mul b%, 10
    EndIf
  Case 13
    If stufe| = 2 And zahlenraum_b% < 19
      Add zahlenraum_b%, 2
    Else If stufe| = 3
      Mul b%, 10
    EndIf
  Case 14
    If stufe| = 1
      If Val(Right$(za$)) + Val(Right$(zb$)) < 10
        GoTo zuf
      EndIf
    Else If stufe| = 2
      Mul b%, 10
    Else If stufe| = 3
      b% = b% * 10 + c%
    EndIf
    If a% + b% > zahlenraum_a%
      GoTo zuf
    EndIf
  Case 15
    If stufe| = 1
      If Val(Right$(za$)) > Val(Right$(zb$))
        GoTo zuf
      EndIf
    Else If stufe| = 2
      Mul b%, 10
    Else If stufe| = 3
      b% = b% * 10 + c%
    EndIf
    If a% - b% < 0
      GoTo zuf
    EndIf
  Case 16
    If stufe| = 3
      c% = 100
      b% = b% * 10 + Val(Right$(za$))
      a% = 100 - b%
    Else
      If c% > 0
        Mul c%, 10
        a% = c% - b%
      Else
        GoTo zuf
      EndIf
    EndIf
  Case 17, 20
    Select stufe|
    Case 1
      c% = 2
    Case 2
      c% = 4
    Case 3
      c% = 8
    EndSelect
  Case 18, 21
    Select stufe|
    Case 1
      c% = 3
    Case 2
      c% = 6
    Case 3
      c% = 9
    EndSelect
  Case 19, 22
    Select stufe|
    Case 1
      c% = 5
    Case 2
      c% = 10
    Case 3
      c% = 7
    EndSelect
  Case 24
    If stufe| = 2 Or stufe| = 3
      rest% = Random(c%)
    EndIf
  Case 25
    If stufe| = 1
      If zahlenraum_b% < 11
        Inc zahlenraum_b%
      EndIf
    Else If stufe| = 2
      b% = Div(b% * 10, 2)
    Else If stufe| = 3
      If zahlenraum_b% < 46
        Add zahlenraum_b%, 5
      EndIf
    EndIf
  Case 26
    If stufe| = 1
      If zahlenraum_b% < 17
        Add zahlenraum_b%, 3
      EndIf
    Else If stufe| = 2
      Mul b%, 10
    Else If stufe| = 3
      If zahlenraum_b% < 91
        Add zahlenraum_b%, 10
      EndIf
    EndIf
  Case 27, 28
    If stufe| = 1
      a% = Round(a%, -2)
    Else If stufe| = 2
      a% = Round(a%, -1)
    EndIf
  Case 29, 30
    If b% > 8
      b% = c%
    EndIf
    If stufe| = 1
      If richtig1% < 10
        a% = Round(a%, -2)
      Else
        a% = Round(a%, -1)
      EndIf
      Mul b%, 100
    Else If stufe| = 2
      a% = Round(a%, -1)
      Mul b%, 10
    Else If stufe| = 3
      Mul b%, 100
    EndIf
    If a% + b% > zahlenraum_a% And art| = 29
      GoTo zuf
    EndIf
    If a% - b% < 0 And art| = 30
      GoTo zuf
    EndIf
  Case 31
    If stufe| = 1
      If c% > 0
        Mul c%, 100
        b% = b% * 10 + Val(Right$(za$))
        a% = c% - b%
      Else
        GoTo zuf
      EndIf
    Else If stufe| = 2
      c% = 1000
      b% = b% * 100 + Val(Right$(za$)) * 10
      a% = 1000 - b%
    Else
      c% = 1000
      b% = b% * 100 + Val(Right$(za$, 2))
      a% = 1000 - b%
    EndIf
  Case 32, 33
    If stufe| = 2
      If richtig1% < 11
        b% = 1
      Else If richtig1% < 21
        b% = 2
      EndIf
      b% = b% * 10 + Val(Right$(zc$))
    Else If stufe| = 3
      If richtig1% < 11
        b% = 1
      Else If richtig1% < 21
        b% = 2
      EndIf
      b% = b% * 100 + Val(Right$(zd$)) * 10
    EndIf
    If stufe| > 1 And beginn| = 0
      beginn| = 1
      SetFont schrift1%
      Color RGB(0, 0, 0) ' schwarz
      If einzelner| = 1
        Text 42 * fx + vx%, 410 * fy + vy%, "Notiere Zwischenergebnisse auf einem Zettel!"
      Else
        Text 42 * fx + vx%, 410 * fy + vy%, "Notiert Zwischenergebnisse auf einem Zettel!"
      EndIf
      SetFont schrift3%
    EndIf
    If a% + b% > zahlenraum_a% And art| = 32
      GoTo zuf
    EndIf
    If a% - b% < 0 And art| = 33
      GoTo zuf
    EndIf
  Case 34
    If c% <> 0
      Mul c%, 10
      If stufe| > 1 And c% < 100
        Add c%, Val(Right$(za$))
      EndIf
    EndIf
  Case 35
    Mul c%, 10
    If stufe| = 2 Or stufe| = 3
      rest% = Random(c%)
    EndIf
  Case 36, 37
    neu4:
    a% = Random(1001)
    If art| = 36
      b% = Random(400)
    Else
      b% = Random(1000)
    EndIf
    c% = Random(200)
    d% = Random(300)
    e% = Random(100)
    f% = Random(200)
    za$ = Trim$(Str$(a%))
    zb$ = Trim$(Str$(b%))
    zc$ = Trim$(Str$(c%))
    zd$ = Trim$(Str$(d%))
    ze$ = Trim$(Str$(e%))
    zf$ = Trim$(Str$(f%))
    If stufe| = 1
      a% = Val(Right$(za$, 2)) + 1
      b% = Val(Right$(zb$)) + 6
      c% = Val(Right$(zc$)) + 4
      d% = Val(Right$(zd$)) + 2
      e% = Val(Right$(ze$)) + 1
      f% = Val(Right$(zf$)) + 1
    Else If stufe| = 2
      a% = Val(Right$(za$, 3)) + 1
      b% = Val(Right$(zb$, 2)) + 1
      c% = Val(Right$(zc$, 2)) + 1
      d% = Val(Right$(zd$, 2)) + 1
      e% = Val(Right$(ze$, 2)) + 1
      f% = Val(Right$(zf$, 2)) + 1
    EndIf
    If art| = 36
      antwort% = a% + b%
      If zahlenraum_b% > 3
        Add antwort%, c%
        If zahlenraum_b% > 4
          Add antwort%, d%
          If zahlenraum_b% > 5
            Add antwort%, e%
            If zahlenraum_b% > 6
              Add antwort%, f%
            EndIf
          EndIf
        EndIf
      EndIf
      If antwort% > 1000
        GoTo neu4
      EndIf
    Else
      If b% > a%
        GoTo neu4
      EndIf
      antwort% = a% - b%
    EndIf
  Case 38, 39
    b% = Random(5) * 100 + b% * 10 + c%
    If b% > 500
      b% = 500
    EndIf
    If art| = 39
      Mul b%, 2
    EndIf
    If stufe| = 1
      b% = c% * 100
      If art| = 38
        Div b%, 2
      EndIf
    Else If stufe| = 2
      b% = Round(b%, -1)
    EndIf
  Case 40
    c% = Random(101)
    If a% = 0 Or c% = 0 Or d% = 0
      GoTo zuf
    EndIf
    If stufe| = 1
      a% = b%
      Add zahlenraum_b%, 9
    EndIf
    If stufe| = 1 Or stufe| = 2
      antwort% = a% * 1000
    Else If stufe| = 3
      If d% = 1000
        d% = 999
      EndIf
      antwort% = a% * 1000 + d%
    EndIf
  Case 41
    If stufe| = 1
      a% = b%
      Add zahlenraum_b%, 9
    EndIf
  Case 42, 43
    If art| = 43 And zahlenraum_b% < 11
      zahlenraum_b% = 11
    EndIf
    If stufe| = 1
      a% = b% * 1000
      b% = Round(d%, -2) * 10
    Else If stufe| = 2
      a% = b% * 10000
      b% = Round(d%, -2) * 100
    Else If stufe| = 3
      a% = Val(Right$(za$, 2)) * 10000
      Mul b%, 10000
      If a% + b% > 1000000 And art| = 42
        GoTo zuf
      EndIf
    EndIf
    If a% - b% < 0 And art| = 43
      GoTo zuf
    EndIf
  Case 44
    If stufe| = 1
      c% = 10000
      b% = Val(Right$(za$, 2)) * 100
    Else If stufe| = 2
      c% = 100000
      b% = Val(Right$(za$, 2)) * 1000
    Else
      c% = 1000000
      b% = Val(Right$(za$, 2)) * 10000
    EndIf
    a% = c% - b%
  Case 45
    If c% <> 0
      If stufe| = 1
        Mul c%, 100
      Else If stufe| = 2
        Mul c%, 1000
      Else
        Mul c%, 1000
        If  c% < 10000
          Add c%, Val(Right$(za$)) * 100
        EndIf
      EndIf
    EndIf
  Case 46
    If weiter| = 0
      menue_masse
      rechenblatt
    EndIf
    If stufe| > 1
      wechsel| = Random(7)
      If wechsel| > 5
        a% = 0
      Else If wechsel| > 3
        a% = Random(10)
      Else If wechsel| > 1
        a% = Random(100)
      Else
        a% = Random(1000)
      EndIf
    EndIf
    Select wahl|
    Case 4, 8
      zehn| = 1
      b% = Random(10)
      If stufe| = 1
        a% = Random(100)
        If a% > 75
          a% = 0
        EndIf
      EndIf
      antwort% = 10 * a% + b%
      If antwort% = 0
        GoTo zuf
      EndIf
      antwort_$ = Trim$(Str$(a%)) + Trim$(Str$(b%))
      If wahl| = 4
        mass$ = "cm"
        mass1$ = "mm"
        mass2$ = "Zentimeter"
        mass3$ = "Millimeter"
      Else
        mass$ = "km"
        mass1$ = "100-m-Stücke"
        mass2$ = "Kilometer"
        mass3$ = "100-Meter-Stücke"
      EndIf
    Case 2, 5
      hundert| = 1
      If stufe| = 1
        a% = Random(14)
        If a% > 9
          a% = 0
        EndIf
      EndIf
      wechsel| = Random(2)
      If wechsel| = 1
        b% = Random(10)
      Else
        b% = Random(100)
      EndIf
      antwort% = 100 * a% + b%
      antwort_$ = Trim$(Str$(a%)) + Right$(Trim$(Str$(100 + b%)), 2)
      If wahl| = 2
        If geldwahl| = 1 'DM
          mass$ = "DM"
          mass1$ = "Pf"
          mass2$ = "DM"
          mass3$ = "Pfennige"
        Else
          mass$ = "€"
          mass1$ = "ct"
          mass2$ = "Euro"
          mass3$ = "Cent"
        EndIf
      Else If wahl| = 5
        mass$ = "m"
        mass1$ = "cm"
        mass2$ = "Meter"
        mass3$ = "Zentimeter"
      EndIf
      If antwort% = 0
        GoTo zuf
      EndIf
    Case 6, 7, 10, 11, 13
      tausend| = 1
      If stufe| = 1
        a% = Random(14)
        If a% > 9
          a% = 0
        EndIf
      EndIf
      wechsel| = Random(3)
      If wechsel| = 0
        b% = Random(1000)
      Else If wechsel| = 1
        b% = Random(100)
      Else
        b% = Random(10)
      EndIf
      antwort% = 1000 * a% + b%
      antwort_$ = Trim$(Str$(a%)) + Right$(Trim$(Str$(1000 + b%)), 3)
      If wahl| = 6
        mass$ = "m"
        mass1$ = "mm"
        mass2$ = "Meter"
        mass3$ = "Millimeter"
      Else If wahl| = 7
        mass$ = "km"
        mass1$ = "m"
        mass2$ = "Kilometer"
        mass3$ = "Meter"
      Else If wahl| = 10
        mass$ = "kg"
        mass1$ = "g"
        mass2$ = "Kilogramm"
        mass3$ = "Gramm"
      Else If wahl| = 11
        mass$ = "t"
        mass1$ = "kg"
        mass2$ = "Tonnen"
        mass3$ = "Kilogramm"
      Else If wahl| = 13
        mass$ = "l"
        mass1$ = "ml"
        mass2$ = "Liter"
        mass3$ = "Milliliter"
      EndIf
      If antwort% = 0
        GoTo zuf
      EndIf
    EndSelect
  Case 47, 48
    neu6:
    a% = Random(1000001)
    If art| = 48
      b% = Random(400000)
    Else
      b% = Random(1000000)
    EndIf
    c% = Random(200000)
    d% = Random(300000)
    e% = Random(100000)
    f% = Random(200000)
    za$ = Trim$(Str$(a%))
    zb$ = Trim$(Str$(b%))
    zc$ = Trim$(Str$(c%))
    zd$ = Trim$(Str$(d%))
    ze$ = Trim$(Str$(e%))
    zf$ = Trim$(Str$(f%))
    If art| = 47
      If stufe| = 1
        a% = Val(Right$(za$, 4))
        b% = Val(Right$(zb$, 3))
        c% = Val(Right$(zc$, 4))
        d% = Val(Right$(zd$, 2))
        e% = Val(Right$(ze$, 3))
        f% = Val(Right$(zf$, 3))
      Else If stufe| = 2
        a% = Val(Right$(za$, 5))
        b% = Val(Right$(zb$, 4))
        c% = Val(Right$(zc$, 4))
        d% = Val(Right$(zd$, 5))
        e% = Val(Right$(ze$, 3))
        f% = Val(Right$(zf$, 5))
      EndIf
    Else
      If stufe| = 1
        a% = Val(Right$(za$, 4))
        b% = Val(Right$(zb$, 4))
        c% = Val(Right$(zc$, 3))
        d% = Val(Right$(zd$, 3))
        e% = Val(Right$(ze$, 2))
        f% = Val(Right$(zf$, 3))
      Else If stufe| = 2
        a% = Val(Right$(za$, 5))
        b% = Val(Right$(zb$, 4))
        c% = Val(Right$(zc$, 5))
        d% = Val(Right$(zd$, 3))
        e% = Val(Right$(ze$, 4))
        f% = Val(Right$(zf$, 4))
      EndIf
    EndIf
    antwort% = b%
    If zahlenraum_b% > 3
      Add antwort%, c%
      If zahlenraum_b% > 4
        Add antwort%, d%
        If zahlenraum_b% > 5
          Add antwort%, e%
          If zahlenraum_b% > 6
            Add antwort%, f%
          EndIf
        EndIf
      EndIf
    EndIf
    If art| = 47
      Add antwort%, a%
    Else
      If antwort% > a%
        GoTo neu6
      Else
        antwort% = a% - antwort%
      EndIf
    EndIf
  Case 49
    If stufe| = 1
      b% = Random(zahlenraum_b%)
      If b% < 2
        b% = b% + 2
      EndIf
    Else If stufe| = 2
      b% = Random(zahlenraum_b%)
      If b% = 0
        b% = 2
      EndIf
      b% = b% * 10 + Random(zahlenraum_b%)
    Else If stufe| = 3
      b% = Random(2501)
      If b% < 10
        b% = 25
      EndIf
    EndIf
    If b% > a%
      Swap b%, a%
    EndIf
  Case 50
    b% = Random(zahlenraum_b%)
    If b% < 2
      b% = b% + 2
    EndIf
    If stufe| = 1
      a% = Random(2000)
    Else If stufe| = 2
      a% = Random(2000000)
    Else
      If richtig1% < 8
        a% = Random(1000)
        If a% < 100
          a% = Random(1000)
        EndIf
      Else If richtig1% < 15
        a% = Random(10000)
      Else If richtig1% < 22
        a% = Random(100000)
      Else
        a% = Random(2000000)
      EndIf
    EndIf
    If stufe| = 3
      If beginn| = 0
        beginn| = 1
        DefMouse 0
        Repeat
          PeekEvent
        Until _Mess = 0
        If einzelner| = 1
          alert3("Durch welche Zahlen willst du teilen?", "bis 15", "Zehner", "Z und E")
        Else
          alert3("Durch welche Zahlen wollt ihr teilen?", "bis 15", "Zehner", "Z und E")
        EndIf
        Repeat
          PeekEvent
        Until _Mess = 0
        DefMouse V:aaa%(0)        ' transparente Mausform
        Color RGB(255, 255, 198) ' creme
        PBox 500 * fx + vx%, 170 * fy + vy%, 570 * fx + vx%, 320 * fy + vy%
      EndIf
      Select alertf|
      Case 1
        b% = 11 + Random(5)
      Case 2
        b% = b% * 10
      Case 3
        b% = b% * 10 + 1 + Random(9)
      EndSelect
    EndIf
  Case 51, 52
    If stufe| = 1
      b% = b% * 1000
    Else If stufe| = 2
      b% = b% * 10000
    Else If stufe| = 3
      b% = b% * 10000 + Val(Right$(za$)) * 1000
    EndIf
  Case 53
    If weiter| = 0
      menue_geld_uhr
    EndIf
    If wahl| = 1 Or wahl| = 4
      If stufe| = 1
        a% = Random(11)
      Else If stufe| = 2
        a% = Random(21)
      Else
        a% = Random(101)
      EndIf
    Else If wahl| = 2 Or wahl| = 5
      If stufe| = 1
        a% = Random(21)
      Else If stufe| = 2
        a% = Random(101)
      Else
        If wahl| = 2
          a% = Random(1201)
        Else
          a% = Random(1001)
        EndIf
      EndIf
    Else If wahl| = 3 Or wahl| = 6
      If stufe| = 1
        a% = Random(1001)
      Else If stufe| = 2
        a% = Random(2001)
      Else
        a% = Random(10001)
      EndIf
    Else If wahl| > 6 And wahl| < 12
      a% = Random(24)
      b% = Random(60)
      c% = Random(24)
      d% = Random(60)
      If wahl| = 7
        a% = Mod(a%, 12)
        If a% = 0
          a% = 12
        EndIf
        If stufe| = 1
          b% = 0
        Else If stufe| = 2
          b% = Div(b%, 15) * 15
        EndIf
      Else If wahl| = 8
        If stufe| = 1
          b% = 0
        Else If stufe| = 2
          b% = Round(b%, -1)
          If b% = 60
            b% = 0
          EndIf
        EndIf
      Else If wahl| > 8 And wahl| < 12
        If wahl| = 9
          c% = a%
        Else If wahl| = 10
          c% = a% + 1
        EndIf
        If stufe| = 1
          b% = Round(b%, -1)
          d% = Round(d%, -1)
          If wahl| = 11
            Clr d%, b%
          EndIf
        Else If stufe| = 2
          If wahl| < 11
            b% = Div(b%, 5) * 5
            d% = Div(d%, 5) * 5
          Else
            b% = Round(b%, -1)
            d% = Round(d%, -1)
          EndIf
        EndIf
        If d% = b% And a% = c%
          Add d%, 50
        EndIf
        If d% > 59
          d% = 0
          If wahl| = 9
            Inc c%
          EndIf
        EndIf
        If b% > 59
          b% = 0
          d% = 0
          Inc c%
        EndIf
        If c% > 23
          c% = 0
        EndIf
        If d% < b% And a% = c% And wahl| < 11
          Swap d%, b%
        EndIf
      EndIf
    Else If wahl| > 11
      a% = Random(31)
      b% = Random(12)
      Inc a%
      Inc b%
      c% = Random(151)
      Add c%, 1900
      d% = Random(31)
      e% = Random(12)
      Inc d%
      Inc e%
      f% = Random(151)
      Add f%, 1900
      If wahl| = 12
        f% = c%
        If stufe| = 1
          e% = b%
          If d% < a%
            Swap d%, a%
          EndIf
        Else If stufe| = 2
          e% = b% + 1
          If e% = 13
            e% = 1
          EndIf
        Else If stufe| = 3
          If e% < b%
            Inc f%
          EndIf
        EndIf
      Else If wahl| = 13
        If f% < c%
          Swap f%, c%
        EndIf
        If stufe| = 1
          d% = a%
          e% = b%
        Else If stufe| = 2
          d% = a%
          If e% < b% And f% = c%
            Add f%, 15
          EndIf
        EndIf
      EndIf
      If c% > f% Or (c% = f% And b% > e%) Or (c% = f% And b% = e% And a% > d%)
        Swap c%, f%
        Swap b%, e%
        Swap a%, d%
      EndIf
      If a% = 31 And (b% = 4 Or b% = 6 Or b% = 9 Or b% = 11)
        Dec a%
      EndIf
      If a% > 28 And b% = 2
        If Mod(c%, 4) <> 0 Or c% = 2000
          a% = 28
        Else
          a% = 29
        EndIf
      EndIf
      If d% = 31 And (e% = 4 Or e% = 6 Or e% = 9 Or e% = 11)
        Dec d%
      EndIf
      If d% > 28 And e% = 2
        If Mod(f%, 4) <> 0 Or f% = 2000
          d% = 28
        Else
          d% = 29
        EndIf
      EndIf
    EndIf
  EndSelect
  za$ = Trim$(Str$(a%))
  zb$ = Trim$(Str$(b%))
  zc$ = Trim$(Str$(c%))
  zd$ = Trim$(Str$(d%))
  ze$ = Trim$(Str$(e%))
  zf$ = Trim$(Str$(f%))
Return
>Procedure a1                       '                * Rechnen 1
  antwx% = Int(42 * fx + vx%)
  antwort% = a%
  GraphMode R2_COPYPEN, TRANSPARENT
  Color RGB(0, 0, 235) ' blau
  If a% > 0
    For i% = 1 To a%
      l% = i%
      hundertfeld
      PCircle 62 * fx + vx% + llx%, 282 * fy + vy% + lly%, 6 * fy
      If (hilfe| = 2 Or falsch1| > 1)
        Color RGB(255, 0, 0) ' rot
        If Mod(i%, 10) = 0
          Text 62 * fx + vx% + llx% + 20, 270 * fy + vy% + lly%, Trim$(Str$(i%))
        EndIf
        If i% = a%
          Text 62 * fx + vx% + llx% + 20, 270 * fy + vy% + lly%, Trim$(Str$(i%))
        EndIf
        Color RGB(0, 0, 235) ' blau
      EndIf
      Inc l%
    Next i%
  EndIf
  Color RGB(0, 0, 0) ' schwarz
  Text Int(42 * fx + vx%), 28 * fy + vy% + zeichenh% * 10, "Wie viele sind es?"
Return
>Procedure a2
  Text Int(42 * fx + vx%), 29 * fy + vy%, za$
  Color RGB(255, 0, 0) ' rot
  SetFont schriftw3%
  Text 41 * fx + vx%, 29 * fy + vy% + zeichenh% * 10, "ò"
  Text 41 * fx + vx% + zeichenbr% * 5, 29 * fy + vy% + zeichenh% * 10, "ò"
  Color RGB(0, 0, 0) ' schwarz
  SetFont schrift3%
  Text Int(42 * fx + vx%), 28 * fy + vy% + zeichenh% * 10, "  Z,   E"
  antwx% = Int(42 * fx + vx%) + zeichenbr%
  antwy% = 270 * fy + vy%
Return
>Procedure a3                       ' 4+1=x
  antwort% = a% + b%
  grenze% = 11
  Text Int(42 * fx + vx%), 29 * fy + vy%, za$ + " + " + zb$ + " = "
  antwx% = TxtLen(za$ + zb$) + Int(42 * fx + vx%) + zeichenbr% * 6
  If (hilfe| = 2 Or falsch1| > 1) And b% >= 0
    hilfe1(a%, a% + b%)
  EndIf
Return
>Procedure a4                       ' 5-1=x
  antwort% = a% - b%
  grenze% = 11
  Text Int(42 * fx + vx%), 29 * fy + vy%, za$ + " - " + zb$ + " = "
  antwx% = TxtLen(za$ + zb$) + Int(42 * fx + vx%) + zeichenbr% * 6
  If (hilfe| = 2 Or falsch1| > 1) And b% >= 0
    hilfe1(a% - b%, a%)
  EndIf
Return
>Procedure a5                       ' 3+x=4
  If aufgabenwahl| = 1
    antwort% = b%
    grenze% = 11
    Text Int(42 * fx + vx%), 29 * fy + vy%, Trim$(Str$(a% - b%)) + " + " + Space$(Len(zb$)) + " = " + za$
    antwx% = TxtLen(Trim$(Str$(a% - b%))) + Int(42 * fx + vx%) + zeichenbr% * 3
    If hilfe| = 2 Or falsch1| > 1
      hilfe1(a% - b%, a%)
    EndIf
  Else
    antwort% = b% - a%
    Text Int(42 * fx + vx%), 29 * fy + vy%, Trim$(Str$(a%)) + " + " + Space$(Len(Trim$(Str$(b% - a%)))) + " = " + zb$
    antwx% = TxtLen(za$) + Int(42 * fx + vx%) + zeichenbr% * 3
    If hilfe| = 2 Or falsch1| > 1
      hilfe1(a%, b%)
    EndIf
  EndIf
Return
>Procedure a6                       ' 6-x=5
  If aufgabenwahl| = 1
    antwort% = b%
    grenze% = 11
    Text Int(42 * fx + vx%), 29 * fy + vy%, za$ + " - " + Space$(Len(zb$)) + " = " + Trim$(Str$(a% - b%))
    antwx% = TxtLen(za$) + Int(42 * fx + vx%) + zeichenbr% * 3
    If hilfe| = 2 Or falsch1| > 1
      hilfe1(a% - b%, a%)
    EndIf
  Else
    antwort% = a% - b%
    Text Int(42 * fx + vx%), 29 * fy + vy%, za$ + " - " + Space$(Len(Trim$(Str$(a% - b%)))) + " = " + zb$
    antwx% = TxtLen(za$) + Int(42 * fx + vx%) + zeichenbr% * 3
    If hilfe| = 2 Or falsch1| > 1
      hilfe1(b%, a%)
    EndIf
  EndIf
Return
>Procedure a7                       ' 6+x=Z
  If aufgabenwahl| = 1
    antwort% = b%
    grenze% = 11
    Text Int(42 * fx + vx%), 29 * fy + vy%, Trim$(Str$(c% - b%)) + " + " + Space$(Len(zb$)) + " = " + zc$
    antwx% = TxtLen(Trim$(Str$(c% - b%))) + Int(42 * fx + vx%) + zeichenbr% * 3
    If hilfe| = 2 Or falsch1| > 1
      hilfe1(c% - b%, c%)
    EndIf
  Else
    zb$ = Trim$(Str$(Val(Left$(za$, Len(za$) - 1)) + 1) + "0")
    b% = Val(zb$)
    antwort% = b% - a%
    Text Int(42 * fx + vx%), 29 * fy + vy%, za$ + " + " + Space$(Len(Trim$(Str$(b% - a%)))) + " = " + zb$
    antwx% = TxtLen(za$) + Int(42 * fx + vx%) + zeichenbr% * 3
    If hilfe| = 2 Or falsch1| > 1
      hilfe1(a%, b%)
    EndIf
  EndIf
Return
>Procedure a8                       ' Z-3=x
  If aufgabenwahl| = 1
    antwort% = c% - b%
    grenze% = 11
    Text Int(42 * fx + vx%), 29 * fy + vy%, zc$ + " - " + zb$ + " = "
    antwx% = TxtLen(zc$) + TxtLen(zb$) + Int(42 * fx + vx%) + zeichenbr% * 6
    If hilfe| = 2 Or falsch1| > 1
      hilfe1(c% - b%, c%)
    EndIf
  Else
    Select stufe|
    Case 1
      b% = 10
      zb$ = "10"
    Case 2
      b% = 20
      zb$ = "20"
    Case 3
      b% = (Random(10) + 1) * 10
      zb$ = Trim$(Str$(b%))
    EndSelect
    antwort% = b% - a%
    Text Int(42 * fx + vx%), 29 * fy + vy%, zb$ + " - " + za$ + " = "
    antwx% = TxtLen(zb$) + TxtLen(za$) + Int(42 * fx + vx%) + zeichenbr% * 6
    If hilfe| = 2 Or falsch1| > 1
      hilfe1(b% - a%, b%)
    EndIf
  EndIf
Return
>Procedure a9                       ' Z+3=x
  If aufgabenwahl| = 1
    antwort% = c% + b%
    grenze% = 11
    Text Int(42 * fx + vx%), 29 * fy + vy%, zc$ + " + " + zb$ + " = "
    antwx% = TxtLen(zc$) + TxtLen(zb$) + Int(42 * fx + vx%) + zeichenbr% * 6
    If hilfe| = 2 Or falsch1| > 1
      hilfe1(c%, c% + b%)
    EndIf
  Else
    Select stufe|
    Case 1
      b% = 0
      zb$ = "0"
    Case 2
      b% = 10
      zb$ = "10"
    Case 3
      b% = Random(10) * 10
      zb$ = Trim$(Str$(b%))
    EndSelect
    antwort% = b% + a%
    Text Int(42 * fx + vx%), 29 * fy + vy%, zb$ + " + " + za$ + " = "
    antwx% = TxtLen(zb$) + TxtLen(za$) + Int(42 * fx + vx%) + zeichenbr% * 6
    If hilfe| = 2 Or falsch1| > 1
      hilfe1(b%, a% + b%)
    EndIf
  EndIf
Return
>Procedure a10                      ' 9+2=x
  antwort% = a% + b%
  grenze% = 11
  If stufe| = 2
    grenze% = 21
  EndIf
  Text Int(42 * fx + vx%), 29 * fy + vy%, za$ + " + " + zb$ + " = "
  antwx% = TxtLen(za$) + TxtLen(zb$) + Int(42 * fx + vx%) + zeichenbr% * 6
  If (hilfe| = 2 Or falsch1| > 1) And b% >= 0
    hilfe1(a%, a% + b%)
  EndIf
Return
>Procedure a11                      ' 12-4=x
  antwort% = a% - b%
  grenze% = 11
  If stufe| = 2
    grenze% = 21
  EndIf
  Text Int(42 * fx + vx%), 29 * fy + vy%, za$ + " - " + zb$ + " = "
  antwx% = TxtLen(za$) + TxtLen(zb$) + Int(42 * fx + vx%) + zeichenbr% * 6
  If (hilfe| = 2 Or falsch1| > 1) And b% >= 0
    hilfe1(a% - b%, a%)
  EndIf
Return
>Procedure a12                      ' 2*4=x
  If aufgabenwahl| = 1
    antwort% = b% * 2
    grenze% = 6
    If stufe| = 2
      grenze% = 11
    EndIf
    Text Int(42 * fx + vx%), 29 * fy + vy%, "2 · " + zb$ + " = "
    antwx% = TxtLen(zb$) + Int(42 * fx + vx%) + zeichenbr% * 7
    If hilfe| = 2 Or falsch1| > 1
      hilfe1(b%, 2 * b%)
    EndIf
  Else
    antwort% = a% * 2
    Text Int(42 * fx + vx%), 29 * fy + vy%, "2 · " + za$ + " = "
    antwx% = TxtLen(za$) + Int(42 * fx + vx%) + zeichenbr% * 7
    If hilfe| = 2 Or falsch1| > 1
      hilfe1(a%, 2 * a%)
    EndIf
  EndIf
Return
>Procedure a13                      ' 8:2=x
  If aufgabenwahl| = 1
    antwort% = Div(b%, 2)
    If stufe| = 2
      grenze% = 21
    Else
      grenze% = 11
    EndIf
    rest% = Mod(b%, 2)
    Text Int(42 * fx + vx%), 29 * fy + vy%, zb$ + " : 2 = "
    antwx% = TxtLen(zb$) + Int(42 * fx + vx%) + zeichenbr% * 7
    c% = Div(b%, 2)
    If hilfe| = 2 Or falsch1| > 1
      hilfe_mal1(2, c%)
    EndIf
  Else
    antwort% = Div(a%, 2)
    rest% = Mod(a%, 2)
    Text Int(42 * fx + vx%), 29 * fy + vy%, za$ + " : 2 = "
    antwx% = TxtLen(za$) + Int(42 * fx + vx%) + zeichenbr% * 7
    c% = Div(a%, 2)
    If hilfe| = 2 Or falsch1| > 1
      hilfe_mal1(2, c%)
    EndIf
  EndIf
Return
>Procedure a14                      ' 28+3=x  * Rechnen 2
  antwort% = a% + b%
  grenze% = 11
  Text Int(42 * fx + vx%), 29 * fy + vy%, za$ + " + " + zb$ + " = "
  antwx% = TxtLen(za$) + TxtLen(zb$) + Int(42 * fx + vx%) + zeichenbr% * 6
  If (hilfe| = 2 Or falsch1| > 1) And b% >= 0
    hilfe1(a%, a% + b%)
  EndIf
Return
>Procedure a15                      ' 32-4=x
  antwort% = a% - b%
  grenze% = 11
  Text Int(42 * fx + vx%), 29 * fy + vy%, za$ + " - " + zb$ + " = "
  antwx% = TxtLen(za$) + TxtLen(zb$) + Int(42 * fx + vx%) + zeichenbr% * 6
  If (hilfe| = 2 Or falsch1| > 1) And b% >= 0
    hilfe1(a% - b%, a%)
  EndIf
Return
>Procedure a16                      ' 27+x=30 / 30-x=27 / 27+x=100
  If aufgabenwahl| = 1
    antwort% = b%
    grenze% = 10
    If stufe| = 2
      Text Int(42 * fx + vx%), 29 * fy + vy%, zc$ + " - " + Space$(Len(zb$)) + " = " + za$
      antwx% = TxtLen(zc$) + Int(42 * fx + vx%) + zeichenbr% * 3
    Else
      Text Int(42 * fx + vx%), 29 * fy + vy%, za$ + " + " + Space$(Len(zb$)) + " = " + zc$
      antwx% = TxtLen(za$) + Int(42 * fx + vx%) + zeichenbr% * 3
    EndIf
    If hilfe| = 2 Or falsch1| > 1
      hilfe1(c% - b%, c%)
    EndIf
  Else
    If stufe| = 2
      Text Int(42 * fx + vx%), 29 * fy + vy%, za$ + " - " + Space$(Len(Trim$(Str$(a% - b%)))) + " = " + zb$
      antwort% = a% - b%
      If hilfe| = 2 Or falsch1| > 1
        hilfe1(b%, a%)
      EndIf
    Else
      antwort% = b% - a%
      Text Int(42 * fx + vx%), 29 * fy + vy%, za$ + " + " + Space$(Len(Trim$(Str$(b% - a%)))) + " = " + zb$
      If hilfe| = 2 Or falsch1| > 1
        hilfe1(a%, b%)
      EndIf
    EndIf
    antwx% = TxtLen(za$) + Int(42 * fx + vx%) + zeichenbr% * 3
  EndIf
Return
>Procedure a17                      ' Einmaleins: 3*4=x
  If b% * c% > 2147483647 Or b% * c% < -2147483647
    SetFont schrift1%
    Text Int(42 * fx + vx%), 375 * fy + vy%, gib$ + "kleinere Zahlen ein!"
    Color RGB(0, 0, 235) ' blau
    Text 220 * fx + vx%, 419 * fy + vy%, "Achtung!"
    Text 180 * fx + vx%, 440 * fy + vy%, "weiter:     Leertaste!"
    Color RGB(255, 0, 0) ' rot
    SetFont schriftw1%
    Text 240 * fx + vx%, 441 * fy + vy%, "ò"
    Color RGB(0, 0, 0) ' schwarz
    SetFont schrift3%
    Repeat
      Sleep
    Until InKey$ <> ""
    zugross| = 1
    hauptmenue
  EndIf
  antwort% = b% * c%
  grenze% = 11
  Text Int(42 * fx + vx%), 29 * fy + vy%, zb$ + " · " + zc$ + " = "
  If art| = 34 And stufe| = 2 And aufgabenwahl| = 1
    If Len(zc$) = 3
      ze$ = "100"
    Else If Len(zc$) = 2
      ze$ = Left$(zc$) + "0"
    Else
      ze$ = "0"
    EndIf
    If einzelner| = 1
      Text Int(42 * fx + vx%), 29 * fy + vy% + zeichenh% * 9, "Rechne:    " + zb$ + " · " + ze$
    Else
      Text Int(42 * fx + vx%), 29 * fy + vy% + zeichenh% * 9, "Rechnet:   " + zb$ + " · " + ze$
    EndIf
    Text Int(42 * fx + vx%), 29 * fy + vy% + zeichenh% * 10, "         + " + zb$ + " · " + Space$(Len(ze$) - 1) + Right$(zc$)
    Clr ze$
    If beginn| = 0
      beginn| = 1
      SetFont schrift1%
      Color RGB(0, 0, 0) ' schwarz
      If einzelner| = 1
        Text Int(42 * fx + vx%), 410 * fy + vy%, "Notiere das Zwischenergebnis auf einem Zettel!"
      Else
        Text Int(42 * fx + vx%), 410 * fy + vy%, "Notiert das Zwischenergebnis auf einem Zettel!"
      EndIf
      SetFont schrift3%
    EndIf
  EndIf
  If art| = 45 And stufe| = 3 And aufgabenwahl| = 1
    If Len(zc$) = 5
      ze$ = "10000"
    Else If Len(zc$) = 4
      ze$ = Left$(zc$) + "000"
    Else
      ze$ = "0"
    EndIf
    If einzelner| = 1
      Text Int(42 * fx + vx%), 29 * fy + vy% + zeichenh% * 9, "Rechne:    " + zb$ + " · " + ze$
    Else
      Text Int(42 * fx + vx%), 29 * fy + vy% + zeichenh% * 9, "Rechnet:   " + zb$ + " · " + ze$
    EndIf
    If Val(Right$(zc$, 3)) > 0
      Text Int(42 * fx + vx%), 29 * fy + vy% + zeichenh% * 10, "         + " + zb$ + " · " + Space$(Len(ze$) - 3) + Right$(zc$, 3)
    Else
      Text Int(42 * fx + vx%), 29 * fy + vy% + zeichenh% * 10, "         + " + zb$ + " · " + Space$(Len(ze$) - 1) + "0"
    EndIf
    If beginn| = 0
      beginn| = 1
      SetFont schrift1%
      Color RGB(0, 0, 0) ' schwarz
      If einzelner| = 1
        Text Int(42 * fx + vx%), 410 * fy + vy%, "Notiere das Zwischenergebnis!"
      Else
        Text Int(42 * fx + vx%), 410 * fy + vy%, "Notiert das Zwischenergebnis!"
      EndIf
      SetFont schrift3%
    EndIf
    Clr ze$
  EndIf
  antwx% = TxtLen(zb$) + TxtLen(zc$) + Int(42 * fx + vx%) + zeichenbr% * 6
  If hilfe| = 2 Or falsch1| > 1
    If art| = 45 And stufe| = 2
      tausend| = 1
      hilfe_mal2(b%, Int(c% / 1000))
    Else If art| < 27
      hilfe_mal1(b%, c%)
    Else If art| <> 45
      hilfe_mal2(b%, c%)
    EndIf
  EndIf
Return
>Procedure a20                      ' Einmaleins: 12=x*4 | 12:4=x
  antwort% = b%
  If b% * c% = 0
    antwort% = 0
  EndIf
  grenze% = 11
  If ((art| > 19 And art| < 23) Or ((art| = 35 Or art| = 24) And stufe| = 1 And aufgabenwahl| = 1)) And alertf| = 0
    DefMouse 0
    Repeat
      PeekEvent
    Until _Mess = 0
    Get (319 - 245) * fx + vx%, (239 - 65) * fy + vy%, (319 + 245) * fx + vx%, (239 + 65) * fy + vy%, alert$
    If einzelner| = 1
      alert2("Wie willst du rechnen?", "mal", "geteilt")
    Else
      alert2("Wie wollt ihr rechnen?", "mal", "geteilt")
    EndIf
    Repeat
      PeekEvent
    Until _Mess = 0
    Put (319 - 245) * fx + vx%, (239 - 65) * fy + vy%, alert$
    Clr alert$
    DefMouse V:aaa%(0)        ' transparente Mausform
    GraphMode R2_COPYPEN, TRANSPARENT
    Color RGB(255, 255, 255) ' weiß
    SetFont schrift0%
    Text Int((_X - vx% - TxtLen(nam$)) / 2), 464 * fy + vy%, nam$
    SetFont schrift3%
    Color RGB(0, 0, 0) ' schwarz
  EndIf
  If ((art| = 24 Or art| = 35) And stufe| = 3) Or alertf| = 2
    If c% = 0
      If art| = 24
        c% = 2
        zc$ = "2"
      Else
        c% = 20
        zc$ = "20"
      EndIf
    EndIf
    Text Int(42 * fx + vx%), 29 * fy + vy%, Trim$(Str$(b% * c% + rest%)) + " : " + zc$ + " = "
    antwx% = TxtLen(Trim$(Str$(b% * c% + rest%))) + TxtLen(zc$) + Int(42 * fx + vx%) + zeichenbr% * 6
  Else
    Text Int(42 * fx + vx%), 29 * fy + vy%, Trim$(Str$(b% * c% + rest%)) + " = " + Space$(Len(zb$)) + " · " + zc$
    schreibweise| = 1
    antwx% = TxtLen(Trim$(Str$(b% * c% + rest%))) + Int(42 * fx + vx%) + zeichenbr% * 3
  EndIf
  If hilfe| = 2 Or falsch1| > 1
    If art| < 27
      hilfe_mal1(b%, c%)
    Else
      hilfe_mal2(b%, c%)
    EndIf
  EndIf
Return
>Procedure a25                      ' Verdoppeln
  antwort% = b% * 2
  If art| = 38
    grenze% = 11
  Else If art| = 25
    If stufe| = 1 Or stufe| = 2
      grenze% = 11
    Else
      grenze% = 51
    EndIf
  Else If art| = 51
    grenze% = 85
  EndIf
  Text Int(42 * fx + vx%), 29 * fy + vy%, "2 · " + zb$ + " = "
  antwx% = TxtLen(zb$) + Int(42 * fx + vx%) + zeichenbr% * 7
  If hilfe| = 2 Or falsch1| > 1
    If art| = 25
      hilfe1(b%, 2 * b%)
    Else If art| = 38
      hilfe2(b%, 2 * b%)
    Else If art| = 51
      If Right$(zb$, 3) = "000" Or b% = 0
        tausend| = 1
        hilfe2(Int(b% / 1000), Int(b% / 500))
      EndIf
    EndIf
  EndIf
Return
>Procedure a26                      ' Halbieren
  antwort% = Div(b%, 2)
  If art| = 26
    If stufe| = 1
      grenze% = 21
    Else If stufe| = 2
      grenze% = 11
    Else If stufe| = 3
      Inc zahlenraum_b%
      grenze% = 101
    EndIf
  Else If art| = 39
    grenze% = 11
  Else
    grenze% = 101
    If zahlenraum_b% < 101
      Inc zahlenraum_b%
    EndIf
  EndIf
  rest% = Mod(b%, 2)
  Text Int(42 * fx + vx%), 29 * fy + vy%, zb$ + " : 2 = "
  antwx% = TxtLen(zb$) + Int(42 * fx + vx%) + zeichenbr% * 7
  c% = Div(b%, 2)
  If hilfe| = 2 Or falsch1| > 1
    If art| = 26
      hilfe_mal1(2, Int(b% / 2))
    Else If art| = 39
      hilfe_mal2(2, Int(b% / 2))
    Else If art| = 52
      If Right$(zb$, 3) = "000"
        tausend| = 1
        hilfe_mal2(2, Int(b% / 2000))
      EndIf
    EndIf
  EndIf
Return
>Procedure a27                      '               * Rechnen 3
  antwx% = Int(42 * fx + vx%)
  antwort% = a%
  Color RGB(0, 0, 235) ' blau
  If hilfe| = 2 Or falsch1| > 0
    i% = 100
    While antwort% >= i%
      hilfe_tausend(i%)
      i% = i% + 100
    Wend
    If antwort% - i% + 100 > 0
      hilfe_tausend(antwort%)
    EndIf
  EndIf
  If a% > 0
'##B#
    abstand% = 2 * fx
'##B#
    abstand1% = 6 * fx
    For l% = 1 To a%
      tausendfeld
      PBox 42 * fx + vx% + llx%, 282 * fy + vy% + lly%, 46 * fx + vx% + llx%, 286 * fy + vy% + lly%
    Next l%
  EndIf
  Color RGB(0, 0, 0) ' schwarz
  Text Int(42 * fx + vx%), Int(28 * fy + vy%) + zeichenh% * 10, "Wie viele sind es?"
Return
>Procedure a28
  Text Int(42 * fx + vx%), Int(29 * fy + vy%), za$
  SetFont schriftw3%
  Color RGB(255, 0, 0) ' rot
  Text 41 * fx + vx%, 28 * fy + vy% + zeichenh% * 9, "ò"
  Text 41 * fx + vx% + zeichenbr% * 2, 28 * fy + vy% + zeichenh% * 9, "ò"
  Text 41 * fx + vx% + zeichenbr% * 4, 28 * fy + vy% + zeichenh% * 9, "ò"
  SetFont schrift3%
  Color RGB(0, 0, 0) ' schwarz
  Text Int(42 * fx + vx%), 28 * fy + vy% + zeichenh% * 10, "H Z E"
  antwx% = Int(42 * fx + vx%)
  antwy% = 278 * fy + vy%
Return
>Procedure a29                      ' 400+35=x
  antwort% = a% + b%
  If stufe| = 3
    If art| <> 42 And art| <> 43
      grenze% = 10
    Else
      grenze% = 81
    EndIf
  Else
    grenze% = 81
  EndIf
  If art| = 32
    grenze% = 11
  EndIf
  Text Int(42 * fx + vx%), 29 * fy + vy%, za$ + " + " + zb$ + " = "
  antwx% = TxtLen(za$) + TxtLen(zb$) + Int(42 * fx + vx%) + zeichenbr% * 6
  If (hilfe| = 2 Or falsch1| > 1) And a% >= 0
    If art| = 42
      If (Right$(zb$, 3) = "000" Or b% = 0) And (Right$(za$, 3) = "000" Or a% = 0)
        tausend| = 1
        hilfe2(Int(a% / 1000), Int(b% / 1000) + Int(a% / 1000))
      EndIf
    Else
      hilfe2(a%, b% + a%)
    EndIf
  EndIf
Return
>Procedure a30                      ' 400-6=x
  antwort% = a% - b%
  If stufe| = 3
    grenze% = 10
  Else
    grenze% = 81
  EndIf
  If art| = 33
    grenze% = 11
  EndIf
  Text Int(42 * fx + vx%), 29 * fy + vy%, za$ + " - " + zb$ + " = "
  antwx% = TxtLen(za$) + TxtLen(zb$) + Int(42 * fx + vx%) + zeichenbr% * 6
  If (hilfe| = 2 Or falsch1| > 1) And a% >= 0
    If art| = 43
      If (Right$(zb$, 3) = "000" Or b% = 0) And (Right$(za$, 3) = "000" Or a% = 0)
        tausend| = 1
        hilfe2(Int(a% / 1000) - Int(b% / 1000), Int(a% / 1000))
      EndIf
    Else
      hilfe2(a% - b%, a%)
    EndIf
  EndIf
Return
>Procedure a31                      ' 416+x=500 / 470+x=1000 / 319+x=1000
  antwort% = b%
  grenze% = 10
  Text Int(42 * fx + vx%), 29 * fy + vy%, za$ + " + " + Space$(Len(zb$)) + " = " + zc$
  antwx% = TxtLen(za$) + Int(42 * fx + vx%) + zeichenbr% * 3
  If hilfe| = 2 Or falsch1| > 1
    If art| = 44
      If Right$(zb$, 3) = "000" Or b% = 0
        tausend| = 1
        hilfe2(Int(c% / 1000) - Int(b% / 1000), Int(c% / 1000))
      EndIf
    Else
      hilfe2(c% - b%, c%)
    EndIf
  EndIf
Return
>Procedure a36                      ' schriftlich addieren
  antwort_$ = Trim$(Str$(antwort%))
  If stufe| = 1
    grenze% = 6
  Else
    grenze% = 7
  EndIf
  If stufe| = 3 And uebertr| = 0 And hilfe| = 1
    DefMouse 0
    Repeat
      PeekEvent
    Until _Mess = 0
    If einzelner| = 1
      alert2("Willst du die Merkzahlen auswendig behalten?", "ja", "nein")
    Else
      alert2("Wollt ihr die Merkzahlen auswendig behalten?", "ja", "nein")
    EndIf
    uebertr| = alertf|
    Color RGB(255, 255, 198) ' creme
    PBox 500 * fx + vx%, 170 * fy + vy%, 570 * fx + vx%, 320 * fy + vy%
    Repeat
      PeekEvent
    Until _Mess = 0
    DefMouse V:aaa%(0)        ' transparente Mausform
  EndIf
  neu3:
  antwx% = Int(41 * fx + vx%) + zeichenbr% * 18
  antwy% = Int(29 * fy + vy%) + zeichenh% * 2 + (zahlenraum_b% - 3) * zeichenh%
  saeule
  Clr eingabe_$, stelle|, uebertrag_$, xxx$
  Repeat
    SetFont schrift3%
    Color RGB(0, 0, 0) ' schwarz
    PeekEvent
    Inc stelle|
    Text Int(41 * fx + vx%) + zeichenbr% * 18 - TxtLen(za$), Int(29 * fy + vy%), za$
    Text Int(41 * fx + vx%) + zeichenbr% * 18 - TxtLen(zb$), Int(29 * fy + vy%) + zeichenh%, zb$
    If zahlenraum_b% > 3
      Text Int(41 * fx + vx%) + zeichenbr% * 18 - TxtLen(zc$), Int(29 * fy + vy%) + zeichenh% * 2, zc$
      If zahlenraum_b% > 4
        Text Int(41 * fx + vx%) + zeichenbr% * 18 - TxtLen(zd$), Int(29 * fy + vy%) + zeichenh% * 3, zd$
        If zahlenraum_b% > 5
          Text Int(41 * fx + vx%) + zeichenbr% * 18 - TxtLen(ze$), Int(29 * fy + vy%) + zeichenh% * 4, ze$
          If zahlenraum_b% > 6
            Text Int(41 * fx + vx%) + zeichenbr% * 18 - TxtLen(zf$), Int(29 * fy + vy%) + zeichenh% * 5, zf$
          EndIf
        EndIf
      EndIf
    EndIf
    Text Int(41 * fx + vx%) + zeichenbr% * 18 - TxtLen(Trim$(Str$(antwort%))) - zeichenbr%, antwy% - zeichenh%, "+"
    Line Int(41 * fx + vx%) + zeichenbr% * 17 - TxtLen(Trim$(Str$(antwort%))), antwy% + Ceil(19 * fy), Int(41 * fx + vx%) + zeichenbr% * 18, antwy% + Ceil(19 * fy)
    Color RGB(255, 0, 0) ' rot
    If Len(eingabe_$) < Len(antwort_$)
      Box antwx% - Int(fx), antwy% + 4 * fy + zeichenh%, antwx% + Int(fx) - zeichenbr%, antwy% + zeichenh% * 2 ' Kursor
    EndIf
    f2:
    If (hilfe| = 2 Or falsch1| > 0) And Len(eingabe_$) < Len(antwort_$)
      If ueb% = 1
        Clr ueb%
        abdecken
      EndIf
      Color RGB(0, 0, 0) ' schwarz
      SetFont schrift1%
      If einzelner| = 1
        Text Int(42 * fx + vx%), 300 * fy + vy%, "Addiere die eingerahmten Zahlen und gib"
      Else
        Text Int(42 * fx + vx%), 300 * fy + vy%, "Addiert die eingerahmten Zahlen und gebt"
      EndIf
      Text Int(42 * fx + vx%), 325 * fy + vy%, "die letzte Ziffer des Ergebnisses ein!"
      SetFont schrift3%
      DefLine 0, 1
      Color RGB(0, 190, 255) ' hell blaugrün
      Box Int(41 * fx + vx%) + (19 - stelle|) * zeichenbr%, Int(30 * fy + vy%), Int(41 * fx + vx%) + (20 - stelle|) * zeichenbr%, antwy% + 18 * fy
      Color RGB(255, 255, 198) ' creme
      Line Int(42 * fx + vx%) + (19 - stelle|) * zeichenbr%, antwy% + 18 * fy, Int(41 * fx + vx%) + (20 - stelle|) * zeichenbr%, antwy% + 18 * fy
      Color RGB(255, 0, 0) ' rot
      Box Int(41 * fx + vx%) + (18 - stelle|) * zeichenbr%, Int(30 * fy + vy%), Int(41 * fx + vx%) + (19 - stelle|) * zeichenbr%, antwy% + 18 * fy
    EndIf
    Color RGB(0, 0, 0) ' schwarz
    Repeat
      Sleep
      antw$ = InKey$
    Until Asc(antw$) > 47 And Asc(antw$) < 58 Or (Len(antw$) = 2 And (Asc(Right$(antw$)) = 119 Or (Asc(Right$(antw$)) = 112)) Or antw$ = Chr$(13))
    If Len(antw$) = 2 And Asc(Right$(antw$)) = 112
      If hilfe| = 1
        hilfe| = 2
        hilferuf| = 1
      Else
        hilfe| = 1
        DefLine 0, 1
        Color RGB(0, 190, 255) ' hell blaugrün
        Box Int(41 * fx + vx%) + (18 - stelle|) * zeichenbr%, Int(30 * fy + vy%), Int(41 * fx + vx%) + (19 - stelle|) * zeichenbr%, antwy% + 18 * fy
        Color RGB(255, 255, 198) ' creme
        Line Int(42 * fx + vx%) + (18 - stelle|) * zeichenbr%, antwy% + 18 * fy, Int(41 * fx + vx%) + (19 - stelle|) * zeichenbr%, antwy% + 18 * fy
        abdecken
      EndIf
      GoTo f2
    EndIf
    Exit If antw$ = Chr$(13)                            ' Return
    abfrage
    If ende| = 1
      GoTo ende36
    EndIf
    If Len(eingabe_$) <= Len(antwort_$)
      If Right$(eingabe_$, stelle|) <> Right$(antwort_$, stelle|)
        falsch
        Color RGB(200, 0, 0) ' dunkelrot
        If Len(xxx$) >= stelle|
          SetFont schrift0%
          Text antwx% - 11 * fx, antwy% + 4 * fy, Left$(xxx$)
        EndIf
        Color RGB(0, 0, 0) ' schwarz
        SetFont schrift1%
        If einzelner| = 1
          Text Int(42 * fx + vx%), 300 * fy + vy%, "Addiere die eingerahmten Zahlen und gib"
        Else
          Text Int(42 * fx + vx%), 300 * fy + vy%, "Addiert die eingerahmten Zahlen und gebt"
        EndIf
        Text Int(42 * fx + vx%), 325 * fy + vy%, "die letzte Ziffer des Ergebnisses ein!"
        Inc fehleradd|
        DefLine 0, 1
        Color RGB(0, 190, 255) ' hell blaugrün
        Box Int(41 * fx + vx%) + (19 - stelle|) * zeichenbr%, Int(30 * fy + vy%), Int(41 * fx + vx%) + (20 - stelle|) * zeichenbr%, antwy% + 18 * fy
        Color RGB(255, 255, 198) ' creme
        Line Int(42 * fx + vx%) + (19 - stelle|) * zeichenbr%, antwy% + 18 * fy, Int(42 * fx + vx%) + (20 - stelle|) * zeichenbr%, antwy% + 18 * fy
        Color RGB(255, 0, 0) ' rot
        Box Int(41 * fx + vx%) + (18 - stelle|) * zeichenbr%, Int(30 * fy + vy%), Int(41 * fx + vx%) + (19 - stelle|) * zeichenbr%, antwy% + 18 * fy
        Repeat
          Sleep
        Until InKey$ <> ""
        abdecken
        If Len(eingabe_$) = Len(antwort_$)
          falsch1| = 1
          fehler| = 1
          kontrolle
        EndIf
        GoTo neu3
      EndIf
      Color RGB(0, 0, 0) ' schwarz
      xxx$ = Trim$(Str$(Val(Right$(za$, stelle|)) + Val(Right$(zb$, stelle|))))
      If zahlenraum_b% > 3
        xxx$ = Trim$(Str$(Val(xxx$) + (Val(Right$(zc$, stelle|)))))
        If zahlenraum_b% > 4
          xxx$ = Trim$(Str$(Val(xxx$) + (Val(Right$(zd$, stelle|)))))
          If zahlenraum_b% > 5
            xxx$ = Trim$(Str$(Val(xxx$) + (Val(Right$(ze$, stelle|)))))
            If zahlenraum_b% > 6
              xxx$ = Trim$(Str$(Val(xxx$) + (Val(Right$(zf$, stelle|)))))
            EndIf
          EndIf
        EndIf
      EndIf
      If Len(xxx$) > stelle|
        f3:
        If stufe| = 1 Or (stufe| = 2 And hilfe| = 2) Or falsch1 > 0     ' autom. Übertrag
          Color RGB(200, 0, 0) ' dunkelrot
          SetFont schrift0%
          If Len(xxx$) > 1
            Text antwx% - zeichenbr% - 11 * fx, antwy% + 4 * fy, Left$(xxx$)
          EndIf
          SetFont schrift3%
          Color RGB(0, 0, 0) ' schwarz
        Else If stufe| = 2 Or (stufe| = 3 And (hilfe| = 2 Or uebertr| = 2)) 'Kasten
          Color RGB(255, 0, 0) ' rot
          Box antwx% + fx - zeichenbr% * 2, antwy% + 4 * fy, antwx% - 3 * fx - zeichenbr%, antwy% + 18 * fy 'Kasten
          If hilfe| = 2 Or falsch1 > 0
            ueb% = 1
            abdecken
            Color RGB(0, 0, 0) ' schwarz
            SetFont schrift1%
            Text Int(42 * fx + vx%), 300 * fy + vy%, gib$ + "als Merkzahl die erste"
            If einzelner| = 1
              Text Int(42 * fx + vx%), 325 * fy + vy%, "Ziffer deines Ergebnisses ein!"
            Else
              Text Int(42 * fx + vx%), 325 * fy + vy%, "Ziffer eures Ergebnisses ein!"
            EndIf
          EndIf
          Color RGB(0, 0, 0) ' schwarz
          Repeat
            Sleep
            uebertrag_$ = InKey$
          Until Asc(uebertrag_$) > 47 And Asc(uebertrag_$) < 58 Or (Len(uebertrag_$) = 2 And (Asc(Right$(uebertrag_$)) = 119 Or Asc(Right$(uebertrag_$)) = 112)) Or uebertrag_$ = Chr$(13)
          If Len(uebertrag_$) = 2 And Asc(Right$(uebertrag_$)) = 112
            If hilfe| = 1
              hilfe| = 2
              hilferuf| = 1
              Color RGB(255, 255, 198) ' creme
              Box antwx% + fx - zeichenbr% * 2, antwy% + 4 * fy, antwx% - 3 * fx - zeichenbr%, antwy% + 18 * fy 'Kasten
            Else
              hilfe| = 1
              abdecken
            EndIf
            GoTo f3
          EndIf
          If Len(uebertrag_$) = 2 And Asc(Right$(uebertrag_$)) = 119
            ende| = 1
            GoTo ende36   'kontrolle
          EndIf
          Color RGB(255, 255, 198) ' creme
          Box antwx% + fx - zeichenbr% * 2, antwy% + 4 * fy, antwx% - 3 * fx - zeichenbr%, antwy% + 18 * fy
          If Asc(uebertrag_$) > 47 And Asc(uebertrag_$) < 58
            Color RGB(200, 0, 0) ' dunkelrot
            SetFont schrift0%
            Text antwx% - zeichenbr% - 11 * fx, antwy% + 4 * fy, uebertrag_$
            SetFont schrift3%
          EndIf
          Color RGB(0, 0, 0) ' schwarz
          If uebertrag_$ <> Left$(xxx$)
            abdecken
            falsch
            SetFont schrift1%
            Text Int(42 * fx + vx%), 300 * fy + vy%, gib$ + "als Merkzahl die erste"
            If einzelner| = 1
              Text Int(42 * fx + vx%), 325 * fy + vy%, "Ziffer deines Ergebnisses ein!"
            Else
              Text Int(42 * fx + vx%), 325 * fy + vy%, "Ziffer eures Ergebnisses ein!"
            EndIf
            Inc fehleradd|
            Repeat
              Sleep
            Until InKey$ <> ""
            abdecken
            GoTo neu3
          EndIf
        EndIf
        Color RGB(255, 255, 198) ' creme
        Box antwx% + fx - zeichenbr% * 2, antwy% + 4 * fy, antwx% - 3 * fx - zeichenbr%, antwy% + 18 * fy 'Kasten
      EndIf
    EndIf
    Sub antwx%, zeichenbr%
  Until Len(eingabe_$) > Len(Trim$(Str$(antwort%)))
  If eingabe_$ <> "" And Len(eingabe_$) < Len(Trim$(Str$(antwort%)))
    GoTo neu3
  EndIf
  If Len(eingabe_$) > Len(Trim$(Str$(antwort%)))
    SetFont schrift1%
    Color RGB(0, 0, 0) ' schwarz
    If Left$(eingabe_$) = "0"
      abdecken
      falsch
      SetFont schrift1%
      Color RGB(0, 0, 0) ' schwarz
      Text Int(42 * fx + vx%), 300 * fy + vy%, richt$
      Text Int(42 * fx + vx%), 325 * fy + vy%, "Null vor dem Ergebnis weg!"
      SetFont schrift3%
      Repeat
        Sleep
      Until InKey$ <> ""
      abdecken
    Else
      abdecken
      falsch
      Color RGB(0, 0, 0) ' schwarz
      SetFont schrift1%
      Text Int(42 * fx + vx%), 300 * fy + vy%, du$ + "zu weit gerechnet!"
      SetFont schrift3%
      Repeat
        Sleep
      Until InKey$ <> ""
      abdecken
      GoTo neu3
    EndIf
    SetFont schrift3%
  EndIf
  If fehleradd| > 0
    Clr fehleradd|
    If zahlenraum_b% > 3
      Dec zahlenraum_b%
    EndIf
  EndIf
  ende36:
Return
>Procedure a37                      ' schriftlich subtrahieren
  DefLine 0, 1
  ArrayFill uebertrag%(), 0
  antwort_$ = Trim$(Str$(antwort%))
  If stufe| = 1
    grenze% = 6
  Else
    grenze% = 7
  EndIf
  If stufe| = 3 And uebertr| = 0 And hilfe| = 1
    DefMouse 0
    Repeat
      PeekEvent
    Until _Mess = 0
    If einzelner| = 1
      alert2("Willst du die Merkzahlen auswendig behalten?", "ja", "nein")
    Else
      alert2("Wollt ihr die Merkzahlen auswendig behalten?", "ja", "nein")
    EndIf
    Color RGB(255, 255, 198) ' creme
    PBox 500 * fx + vx%, 170 * fy + vy%, 570 * fx + vx%, 320 * fy + vy%
    uebertr| = alertf|
    Repeat
      PeekEvent
    Until _Mess = 0
    DefMouse V:aaa%(0)        ' transparente Mausform
  EndIf
  neu5:
  antwx% = Int(41 * fx + vx%) + zeichenbr% * 18
  If rechnen| = 3
    antwy% = Int(29 * fy + vy%) + zeichenh% * 2
  Else
    antwy% = Int(29 * fy + vy%) + zeichenh% * 2 + (zahlenraum_b% - 3) * zeichenh%
  EndIf
  saeule
  Clr eingabe_$, stelle|, ueber$, antw$
  Repeat
    Color RGB(0, 0, 0) ' schwarz
    PeekEvent
    Inc stelle|
    Text Int(41 * fx + vx%) + zeichenbr% * 18 - TxtLen(za$), Int(29 * fy + vy%), za$
    Text Int(41 * fx + vx%) + zeichenbr% * 18 - TxtLen(zb$), Int(29 * fy + vy%) + zeichenh%, zb$
    Text Int(41 * fx + vx%) + zeichenbr% * 17 - TxtLen(za$), Int(29 * fy + vy%) + zeichenh%, "-"
    If zahlenraum_b% > 3 And rechnen| = 4
      Text Int(41 * fx + vx%) + zeichenbr% * 18 - TxtLen(zc$), Int(29 * fy + vy%) + zeichenh% * 2, zc$
      Text Int(41 * fx + vx%) + zeichenbr% * 17 - TxtLen(za$), Int(29 * fy + vy%) + zeichenh% * 2, "-"
      If zahlenraum_b% > 4
        Text Int(41 * fx + vx%) + zeichenbr% * 18 - TxtLen(zd$), Int(29 * fy + vy%) + zeichenh% * 3, zd$
        Text Int(41 * fx + vx%) + zeichenbr% * 17 - TxtLen(za$), Int(29 * fy + vy%) + zeichenh% * 3, "-"
        If zahlenraum_b% > 5
          Text Int(41 * fx + vx%) + zeichenbr% * 18 - TxtLen(ze$), Int(29 * fy + vy%) + zeichenh% * 4, ze$
          Text Int(41 * fx + vx%) + zeichenbr% * 17 - TxtLen(za$), Int(29 * fy + vy%) + zeichenh% * 4, "-"
          If zahlenraum_b% > 6
            Text Int(41 * fx + vx%) + zeichenbr% * 18 - TxtLen(zf$), Int(29 * fy + vy%) + zeichenh% * 5, zf$
            Text Int(41 * fx + vx%) + zeichenbr% * 17 - TxtLen(za$), Int(29 * fy + vy%) + zeichenh% * 5, "-"
          EndIf
        EndIf
      EndIf
    EndIf
    If rechnen| = 3
      Clr zc$, zd$, ze$, zf$
    Else If zahlenraum_b% < 7
      Clr zf$
      If zahlenraum_b% < 6
        Clr ze$
        If zahlenraum_b% < 5
          Clr zd$
          If zahlenraum_b% < 4
            Clr zc$
          EndIf
        EndIf
      EndIf
    EndIf
    Color RGB(0, 0, 0) ' schwarz
    Line Int(41 * fx + vx%) + zeichenbr% * 17 - TxtLen(za$), antwy% + Ceil(19 * fy), Int(41 * fx + vx%) + zeichenbr% * 18, antwy% + Ceil(19 * fy)
    Color RGB(255, 0, 0) ' rot
    If Len(eingabe_$) < Len(antwort_$)
'##B#
      Box antwx% - Int(fx), antwy% + 4 * fy + zeichenh%, antwx% + Int(fx) - zeichenbr%, antwy% + zeichenh% * 2
    EndIf
    xxx$ = Trim$(Str$(Val(Right$(zb$, stelle|)) + Val(Right$(antwort_$, stelle|))))
    If zahlenraum_b% > 3 And rechnen| = 4
      xxx$ = Trim$(Str$(Val(xxx$) + (Val(Right$(zc$, stelle|)))))
      If zahlenraum_b% > 4
        xxx$ = Trim$(Str$(Val(xxx$) + (Val(Right$(zd$, stelle|)))))
        If zahlenraum_b% > 5
          xxx$ = Trim$(Str$(Val(xxx$) + (Val(Right$(ze$, stelle|)))))
          If zahlenraum_b% > 6
            xxx$ = Trim$(Str$(Val(xxx$) + (Val(Right$(zf$, stelle|)))))
          EndIf
        EndIf
      EndIf
    EndIf
    If Len(xxx$) = stelle|
      z% = Val(Left$(xxx$))
      z_$ = Trim$(Str$(z%))
    Else If Len(xxx$) > stelle|
      z% = Val(Left$(xxx$, 2))
      z_$ = Trim$(Str$(z%))
      uebertrag%(stelle|) = Val(Left$(z_$))
    Else
      z% = 0
      z_$ = "0"
    EndIf
    f4:
    If (hilfe| = 2 Or falsch1| > 0) And Len(eingabe_$) < Len(za$)
      Color RGB(0, 0, 0) ' schwarz
      SetFont schrift1%
      hilfe37
      SetFont schrift3%
    EndIf
    Repeat
      Sleep
      antw$ = InKey$
    Until Asc(antw$) > 47 And Asc(antw$) < 58 Or (Len(antw$) = 2 And (Asc(Right$(antw$)) = 119 Or Asc(Right$(antw$)) = 112)) Or antw$ = Chr$(13)
    If Asc(Right$(antw$)) = 112                          'F1-Taste
      If hilfe| = 2
        hilfe| = 1
        DefLine 0, 1
        Color RGB(0, 190, 255) ' hell blaugrün
        Box Int(41 * fx + vx%) + (18 - stelle|) * zeichenbr%, Int(30 * fy + vy%), Int(41 * fx + vx%) + (19 - stelle|) * zeichenbr%, antwy% + 18 * fy
        Color RGB(255, 25, 198) ' creme
        Line Int(42 * fx + vx%) + (18 - stelle|) * zeichenbr%, antwy% + 18 * fy, Int(41 * fx + vx%) + (19 - stelle|) * zeichenbr%, antwy% + 18 * fy
        abdecken
      Else
        hilfe| = 2
        hilferuf| = 1
      EndIf
      GoTo f4
    EndIf
    If hilfe| = 2 Or falsch1| > 0
      abdecken
    EndIf
    Exit If antw$ = Chr$(13)                            ' Return
    abfrage
    If ende| = 1
      GoTo ende37
    EndIf
    If Len(eingabe_$) > Len(antwort_$)
      SetFont schrift1%
      Color RGB(0, 0, 0) ' schwarz
      If Left$(eingabe_$) = "0"
        abdecken
        falsch
        Color RGB(0, 0, 0) ' schwarz
        SetFont schrift1%
        Text Int(42 * fx + vx%), 300 * fy + vy%, richt$
        Text Int(42 * fx + vx%), 325 * fy + vy%, "Null vor dem Ergebnis weg!"
        Repeat
          Sleep
        Until InKey$ <> ""
        abdecken
        SetFont schrift3%
        GoTo weiter2
      Else
        abdecken
        falsch
        SetFont schrift1%
        Text Int(42 * fx + vx%), 300 * fy + vy%, du$ + "zu weit gerechnet!"
        Repeat
          Sleep
        Until InKey$ <> ""
        SetFont schrift3%
        GoTo neu5
        abdecken
      EndIf
    EndIf
    If Right$(eingabe_$, stelle|) <> Right$(antwort_$, stelle|)
      fehlersub| = 1
      abdecken
      falsch
      SetFont schrift1%
      hilfe37
      Repeat
        Sleep
      Until InKey$ <> ""
      abdecken
      Color RGB(0, 0, 0) ' schwarz
      SetFont schrift3%
      If Len(eingabe_$) = Len(antwort_$)
        falsch1| = 1
        fehler| = 1
        kontrolle
      EndIf
      GoTo neu5
    EndIf
    If Len(xxx$) > stelle|
      f5:
      If stufe| = 1 Or (stufe| = 2 And hilfe| = 2) Or falsch1 > 0 ' autom. Übertrag
        Color RGB(200, 0, 0) ' dunkelrot
        SetFont schrift0%
        Text antwx% - zeichenbr% - 11 * fx, antwy% + 4 * fy, Left$(xxx$) ' autom. Übertrag
        SetFont schrift3%
        Color RGB(0, 0, 0) ' schwarz
      Else If stufe| = 2 Or (stufe| = 3 And (hilfe| = 2 Or uebertr| = 2)) 'Kasten
        Color RGB(255, 0, 0) ' rot
        Box antwx% + fx  - zeichenbr% * 2, antwy% + 4 * fy, antwx% - 3 * fx - zeichenbr%, antwy% + 18 * fy 'Kasten
        Color RGB(0, 0, 0) ' schwarz
        Repeat
          Sleep
          ueber$ = InKey$
        Until Asc(ueber$) > 47 And Asc(ueber$) < 58 Or (Len(ueber$) = 2 And (Asc(Right$(ueber$)) = 119 Or Asc(Right$(ueber$)) = 112)) Or ueber$ = Chr$(13)
        If Asc(Right$(ueber$)) = 112                          'F1-Taste
          If hilfe| = 2
            hilfe| = 1
            Color RGB(255, 0, 0) ' rot
            Box antwx% + fx - zeichenbr% * 2, antwy% + 4 * fy, antwx% - 3 * fx - zeichenbr%, antwy% + 18 * fy 'Kasten
            abdecken
          Else
            hilfe| = 2
            hilferuf| = 1
            abdecken
            Color RGB(0, 0, 0) ' schwarz
            SetFont schrift1%
            Text Int(42 * fx + vx%), 300 * fy + vy%, gib$ + "als Merkzahl die erste"
            If einzelner| = 1
              Text Int(42 * fx + vx%), 325 * fy + vy%, "Ziffer deines Ergebnisses ein!"
            Else
              Text Int(42 * fx + vx%), 325 * fy + vy%, "Ziffer eures Ergebnisses ein!"
            EndIf
          EndIf
          GoTo f5
        EndIf
        If Len(ueber$) = 2 And Asc(Right$(ueber$)) = 119
          ende| = 1
          GoTo ende37 : 'kontrolle
        EndIf
        Color RGB(255, 255, 198) ' creme
        Box antwx% + fx - zeichenbr% * 2, antwy% + 4 * fy, antwx% - 3 * fx - zeichenbr%, antwy% + 18 * fy 'Kasten
        If Asc(ueber$) > 47 And Asc(ueber$) < 58
          Color RGB(200, 0, 0) ' dunkelrot
          SetFont schrift0%
          Text antwx% - zeichenbr% - 11 * fx, antwy% + 4 * fy, ueber$
          SetFont schrift3%
          Color RGB(0, 0, 0) ' schwarz
        EndIf
        If ueber$ <> Left$(xxx$)
          fehlersub| = 1
          abdecken
          falsch
          Color RGB(0, 0, 0) ' schwarz
          SetFont schrift1%
          Text Int(42 * fx + vx%), 300 * fy + vy%, gib$ + "als Merkzahl die erste"
          If einzelner| = 1
            Text Int(42 * fx + vx%), 325 * fy + vy%, "Ziffer deines Ergebnisses ein!"
          Else
            Text Int(42 * fx + vx%), 325 * fy + vy%, "Ziffer eures Ergebnisses ein!"
          EndIf
          Repeat
            Sleep
          Until InKey$ <> ""
          abdecken
          SetFont schrift3%
          GoTo neu5
        EndIf
      EndIf
      Color RGB(255, 255, 198) ' creme
      Box antwx% + fx - zeichenbr% * 2, antwy% + 4 * fy, antwx% - 3 * fx - zeichenbr%, antwy% + 18 * fy 'Kasten
    EndIf
    Sub antwx%, zeichenbr%
  Until Len(eingabe_$) > Len(Trim$(Str$(antwort%)))
  If eingabe_$ <> "" And eingabe_$ <> Trim$(Str$(antwort%))
    abdecken
    falsch
    Color RGB(0, 0, 0) ' schwarz
    SetFont schrift1%
    hilfe37
    Repeat
      Sleep
    Until InKey$ <> ""
    abdecken
    Color RGB(0, 0, 0) ' schwarz
    SetFont schrift3%
    GoTo neu5
  EndIf
  weiter2:
  If fehlersub| > 0
    Clr fehlersub|
    If zahlenraum_b% > 3
      Dec zahlenraum_b%
    EndIf
  EndIf
  ende37:
Return
>Procedure hilfe37
  x% = 135 * fx + vx%
  Color RGB(0, 0, 0) ' schwarz
  Text Int(42 * fx + vx%), 300 * fy + vy%, rechne$ + ":"
  If uebertrag%(stelle| - 1) > 0
    Color RGB(200, 0, 0) ' dunkelrot
    Text x%, 300 * fy + vy%, Left$(Trim$(Str$(uebertrag%(stelle| - 1))))
    SetFont schrift0%
    Text antwx% - 11 * fx, antwy% + 4 * fy, Left$(Trim$(Str$(uebertrag%(stelle| - 1))))
    SetFont schrift1%
    Add x%, TxtLen(Left$(Trim$(Str$(uebertrag%(stelle| - 1)))))
    Color RGB(0, 0, 0) ' schwarz
    Text x%, 300 * fy + vy%, " + "
    Add x%, TxtLen(" + ")
  Else If Len(zf$) < stelle| And Len(ze$) < stelle| And Len(zd$) < stelle| And Len(zc$) < stelle| And Len(zb$) < stelle|
    Text x%, 300 * fy + vy%, "0 + "
    Add x%, TxtLen("0 + ")
  EndIf
  If zahlenraum_b% > 6 And rechnen| = 4
    If Len(zf$) >= stelle|
      Text x%, 300 * fy + vy%, Mid$(zf$, Len(zf$) + 1 - stelle|, 1) + " + "
      Add x%, TxtLen(Mid$(zf$, Len(zf$) + 1 - stelle|, 1) + " + ")
    EndIf
  EndIf
  If zahlenraum_b% > 5 And rechnen| = 4
    If Len(ze$) >= stelle|
      Text x%, 300 * fy + vy%, Mid$(ze$, Len(ze$) + 1 - stelle|, 1) + " + "
      Add x%, TxtLen(Mid$(ze$, Len(ze$) + 1 - stelle|, 1) + " + ")
    EndIf
  EndIf
  If zahlenraum_b% > 4 And rechnen| = 4
    If Len(zd$) >= stelle|
      Text x%, 300 * fy + vy%, Mid$(zd$, Len(zd$) + 1 - stelle|, 1) + " + "
      Add x%, TxtLen(Mid$(zd$, Len(zd$) + 1 - stelle|, 1) + " + ")
    EndIf
  EndIf
  If zahlenraum_b% > 3 And rechnen| = 4
    If Len(zc$) >= stelle|
      Text x%, 300 * fy + vy%, Mid$(zc$, Len(zc$) + 1 - stelle|, 1) + " + "
      Add x%, TxtLen(Mid$(zc$, Len(zc$) + 1 - stelle|, 1) + " + ")
    EndIf
  EndIf
  If Len(zb$) >= stelle|
    Text x%, 300 * fy + vy%, Mid$(zb$, Len(zb$) + 1 - stelle|, 1) + " + "
    Add x%, TxtLen(Mid$(zb$, Len(zb$) + 1 - stelle|, 1) + " + ")
  EndIf
  If x% = 135 * fx + vx%
    Text x%, 300 * fy + vy%, "0 + "
    Add x%, TxtLen("0 + ")
  EndIf
  Color RGB(255, 0, 0) ' rot
  Box x% + 2 * fx, 303 * fy + vy%, x% + zeichenbr% - 2 * fx, 316 * fy + vy%
  Add x%, 10 * fx + TxtLen(" ")
  Color RGB(0, 0, 0) ' schwarz
  Text x%, 300 * fy + vy%, " = " + z_$
  DefLine 0, 1
  Color RGB(0, 190, 255) ' hell blaugrün
  Box Int(41 * fx + vx%) + (19 - stelle|) * zeichenbr%, Int(30 * fy + vy%), Int(41 * fx + vx%) + (20 - stelle|) * zeichenbr%, antwy% + 18 * fy
  Color RGB(255, 255, 198) ' creme
  Line Int(42 * fx + vx%) + (19 - stelle|) * zeichenbr%, antwy% + 18 * fy + vy%, Int(41 * fx + vx%) + (20 - stelle|) * zeichenbr%, antwy% + 18 * fy
  Color RGB(255, 0, 0) ' rot
  Box Int(41 * fx + vx%) + (18 - stelle|) * zeichenbr%, Int(30 * fy + vy%), Int(41 * fx + vx%) + (19 - stelle|) * zeichenbr%, antwy% + 18 * fy
  Color RGB(0, 0, 0) ' schwarz
Return
>Procedure a40                                            '      * Rechnen 4
  neu40:
  antwort_$ = Trim$(Str$(antwort%))
  antwx% = Int(42 * fx + vx%)
  Color RGB(255, 0, 0) ' rot
  Box antwx%, antwy% + 4 * fy, antwx% + zeichenbr% - 2 * fx, antwy% + zeichenh%
  GraphMode R2_COPYPEN, TRANSPARENT
  Color RGB(0, 0, 0) ' schwarz
  SetFont schrift3%
  If stufe| = 1
    Text Int(42 * fx + vx%), Int(28 * fy + vy%) + zeichenh% * 7, "Jeder grüne Punkt bedeutet"
    Text Int(42 * fx + vx%), Int(28 * fy + vy%) + zeichenh% * 8, "1000 €."
    Text Int(42 * fx + vx%), Int(28 * fy + vy%) + zeichenh% * 10, "Wie viel € sind es?"
  Else If stufe| = 2
    Text Int(42 * fx + vx%), Int(28 * fy + vy%) + zeichenh% * 7, "Jeder Punkt bedeutet"
    Text Int(42 * fx + vx%), Int(28 * fy + vy%) + zeichenh% * 8, "einen Tausender."
    Text Int(42 * fx + vx%), Int(28 * fy + vy%) + zeichenh% * 10, "Wie viele Einer sind es?"
  Else If stufe| = 3
    Text Int(42 * fx + vx%), Int(28 * fy + vy%) + zeichenh% * 5, "Jeder Punkt bedeutet"
    Text Int(42 * fx + vx%), Int(28 * fy + vy%) + zeichenh% * 6, "einen Tausender."
    Text Int(42 * fx + vx%), Int(28 * fy + vy%) + zeichenh% * 8, "Wie viele Tausender sind es?"
    Text Int(42 * fx + vx%), Int(28 * fy + vy%) + zeichenh% * 10, "    * weiter:   T *"
    SetFont schriftw3%
    Color RGB(255, 0, 0) ' rot
    Text Int(40 * fx + vx%) + zeichenbr% * 14, Int(29 * fy + vy%) + zeichenh% * 10, "ò"
    SetFont schrift3%
  EndIf
  Clr eingabe_$, antw$
  If a% > 0
    Color RGB(0, 170, 0) ' grün
'##B#
    abstand% = 2 * fx
'##B#
    abstand1% = 6 * fx
    For l% = 1 To a%
      tausendfeld
      PBox 42 * fx + vx% + llx%, 282 * fy + vy% + lly%, 46 * fx + vx% + llx%, 286 * fy + vy% + lly%
    Next l%
  EndIf
  abfrage1
  If ende| = 1
    GoTo ende40
  EndIf
  If Val(eingabe_$) <> a% And stufe| = 3
    abdecken
    falsch
    Repeat
      Sleep
    Until InKey$ <> ""
    Clr eingabe_$, l%
    Put 0, 0, rechenblatt1$
    Color RGB(255, 255, 255), ' weiß
    SetFont schrift0
    Text Int((_X - vx% - TxtLen(nam$)) / 2), 464 * fy + vy%, nam$
    SetFont schrift3%
    abdecken
    GoTo neu40
  EndIf
  If a% = 0 And stufe| = 3
    Clr eingabe_$
  EndIf
  If stufe| = 3
    Put 0, 0, rechenblatt1$
    Color RGB(255, 255, 255), ' weiß
    SetFont schrift0
    Text Int((_X - vx% - TxtLen(nam$)) / 2), 464 * fy + vy%, nam$
    SetFont schrift3%
    abdecken
    Color RGB(0, 0, 0)
    Text Int(42 * fx + vx%), Int(29 * fy + vy%), eingabe_$
    Color RGB(255, 0, 0) ' rot
    Box antwx%, antwy% + 4 * fy, antwx% + zeichenbr% - 2 * fx, antwy% + zeichenh%
    SetFont schrift3%
    Color RGB(0, 0, 0) ' schwarz
    Text Int(42 * fx + vx%), 28 * fy + vy% + zeichenh% * 7, "Jetzt bedeutet jeder"
    Text Int(42 * fx + vx%), 28 * fy + vy% + zeichenh% * 8, "Punkt einen Einer!"
    Text Int(42 * fx + vx%), 28 * fy + vy% + zeichenh% * 10, "Wie viele H, Z, E sind es?"
    If d% > 0
      Color RGB(0, 0, 235) ' blau
'##B#
      abstand% = 2 * fx
'##B#
      abstand1% = 6 * fx
      For l% = 1 To d%
        tausendfeld
        PBox 42 * fx + vx% + llx%, 282 * fy + vy% + lly%, 46 * fx + vx% + llx%, 286 * fy + vy% + lly%
      Next l%
    EndIf
    Color RGB(255, 0, 0) ' rot
    abfrage1
    If Len(eingabe_$) <> Len(antwort_$) And ende| = 0  ' Zahlen in 2 Stufen eingeben
      abdecken
      falsch
      Color RGB(0, 0, 0)
      SetFont schrift1%
      Text 42 * fx + vx%, 310 * fy + vy%, "Hunderter, Zehner und Einer müssen mit"
      Text 42 * fx + vx%, 335 * fy + vy%, "3 Stellen eingegeben werden,"
      Text 42 * fx + vx%, 360 * fy + vy%, "zum Beispiel: 21      021 oder 8      008 "
      i% = TxtLen("zum Beispiel: 21 ")
      j% = TxtLen("zum Beispiel: 21      021 oder 8 ")
      Color RGB(255, 0, 0) ' rot
      SetFont schriftw1%
      Text 42 * fx + vx% + i%, 360 * fy + vy%, "ð"
      Text 42 * fx + vx% + j%, 360 * fy + vy%, "ð"
      SetFont schrift3%
      Repeat
        Sleep
      Until InKey$ <> ""
      abdecken
      Clr eingabe_$, l%
      Put 0, 0, rechenblatt1$
      Color RGB(255, 255, 255), ' weiß
      SetFont schrift0
      Text Int((_X - vx% - TxtLen(nam$)) / 2), 464 * fy + vy%, nam$
      SetFont schrift3%
      GoTo neu40
    EndIf
  EndIf
  ende40:
Return
>Procedure a41
  antwx% = Int(42 * fx + vx%)
  antwy% = 268 * fy + vy%
  neu41:
  Clr gruen%
  If fortsetzung| = 0
    gruen% = 1
    If stufe| <> 3
      Text Int(42 * fx + vx%), Int(29 * fy + vy%), Trim$(Str$(Val(za$) * 1000))
    Else
      Text Int(42 * fx + vx%), Int(29 * fy + vy%), Trim$(Str$(Val(za$) * 1000 + d%))
    EndIf
    Text Int(42 * fx + vx%), 28 * fy + vy% + zeichenh% * 3, "Jeder grüne Punkt bedeutet"
    If stufe| = 1
      Text Int(42 * fx + vx%), 28 * fy + vy% + zeichenh% * 4, "1000 €."
    Else
      Text Int(42 * fx + vx%), 28 * fy + vy% + zeichenh% * 4, "einen Tausender."
    EndIf
    If stufe| = 3
      Text Int(42 * fx + vx%), 28 * fy + vy% + zeichenh% * 6, gib$ + "jetzt nur die Tausender ein!"
    Else
      Text Int(42 * fx + vx%), 28 * fy + vy% + zeichenh% * 6, gib$ + "die Zahl der Tausender ein!"
    EndIf
    Text Int(42 * fx + vx%), 28 * fy + vy% + zeichenh% * 8, "Für HT, für ZT, für T, fertig"
    Text Int(42 * fx + vx%), 28 * fy + vy% + zeichenh% * 10, "     H       Z      E       T"
    Color RGB(255, 0, 0) ' rot
    SetFont schriftw3%
    Text Int(41 * fx + vx%) + zeichenbr% * 5, 28 * fy + vy% + zeichenh% * 9, "ò"
    Text Int(41 * fx + vx%) + zeichenbr% * 13, 28 * fy + vy% + zeichenh% * 9, "ò"
    Text Int(41 * fx + vx%) + zeichenbr% * 20, 28 * fy + vy% + zeichenh% * 9, "ò"
    Text Int(41 * fx + vx%) + zeichenbr% * 28, 28 * fy + vy% + zeichenh% * 9, "ò"
    SetFont schrift3%
    Color RGB(0, 0, 0) ' schwarz
    If stufe| = 3
      fortsetzung| = 1
    EndIf
  Else
    If Len(eingabe_$) <> Val(za$)
      Clr eingabe_$, fortsetzung|
      falsch
      Repeat
        Sleep
      Until InKey$ <> ""
      abdecken
      Color RGB(255, 0, 0) ' rot
'##B#
      Box antwx%, antwy% + 4 * fy, antwx% + zeichenbr% - 2 * fx, antwy% + zeichenh%
      Color RGB(0, 0, 0) ' schwarz
      GoTo neu41
    EndIf
    Clr fortsetzung|
    Put 0, 0, rechenblatt1$
    Color RGB(255, 255, 255), ' weiß
    SetFont schrift0
    Text Int((_X - vx% - TxtLen(nam$)) / 2), 464 * fy + vy%, nam$
    SetFont schrift3%
    abdecken
    Color RGB(0, 0, 0)
    Text Int(42 * fx + vx%), Int(29 * fy + vy%), Trim$(Str$(Val(za$) * 1000 + d%))
    Color RGB(0, 0, 0) ' schwarz
    Text Int(42 * fx + vx%), 28 * fy + vy% + zeichenh% * 3, "Jetzt bedeutet jeder Punkt"
    Text Int(42 * fx + vx%), 28 * fy + vy% + zeichenh% * 4, "einen Einer!"
    Text Int(42 * fx + vx%), 28 * fy + vy% + zeichenh% * 6, gib$ + "H, Z und E ein!"
    Text Int(42 * fx + vx%), 28 * fy + vy% + zeichenh% * 10, "     H       Z      E"
    Color RGB(255, 0, 0) ' rot
    SetFont schriftw3%
    Text Int(41 * fx + vx%) + zeichenbr% * 5, Int(29 * fy + vy%) + zeichenh% * 9, "ò"
    Text Int(41 * fx + vx%) + zeichenbr% * 13, Int(29 * fy + vy%) + zeichenh% * 9, "ò"
    Text Int(41 * fx + vx%) + zeichenbr% * 20, Int(29 * fy + vy%) + zeichenh% * 9, "ò"
    SetFont schrift3%
    Color RGB(0, 0, 0) ' schwarz
    a% = d%
  EndIf
Return
>Procedure a46                      ' Maße mit dem Komma schreiben
  Clr antwort1%, antwort2%, antwort3%, antwort1_$, antwort2_$, antwort3_$
  SetFont schrift3%
  Color RGB(0, 0, 0) ' schwarz
  If neu$ = ""
    bildx% = Int(42 * fx + vx%) + zeichenbr% * 16
    If stufe| <> 2
      Get bildx%, antwy% + 4 * fy, bildx% + zeichenbr% * 15, antwy% + zeichenh% * 6, neu$
    Else
      Get bildx%, antwy% + 4 * fy, bildx% + zeichenbr% * 11, antwy% + zeichenh% * 6, neu$
    EndIf
  EndIf
  If stufe| = 3 And aufgabenwahl| = 1 And komma| = 2 And antwort% < 15  ' Subtrahieren
    Repeat
      PeekEvent
      zufall
    Until antwort% > 14
  EndIf
  antwy% = Int(29 * fy + vy%) + zeichenh% * 2
  fortsetzung| = 1
  neu9:
  saeule
  SetFont schrift3%
  Color RGB(0, 0, 0) ' schwarz
  If einzelner| = 1
    Text Int(42 * fx + vx%), Int(29 * fy + vy%), "Schreibe mit dem Komma als " + mass$ + ":"
  Else
    Text Int(42 * fx + vx%), Int(29 * fy + vy%), "Schreibt mit dem Komma als " + mass$ + ":"
  EndIf
  Clr eingabe_$
  If b% = 1 And wahl| = 8
    mass1$ = "100-m-Stück"
  EndIf
  If wahl| <> 8 Or (wahl| = 8 And stufe| = 3)
    If stufe| = 1
      antwx% = Int(42 * fx + vx%) + (Len(Trim$(Str$(Val(antwort_$)) + mass1$)) + 4) * zeichenbr%
      Text Int(42 * fx + vx%), antwy%, Trim$(Str$(Val(antwort_$))) + " " + mass1$ + " ="
    Else If stufe| = 2
      antwx% = Int(42 * fx + vx%) + (Len(za$ + zb$ + mass$ + mass1$) + 8) * zeichenbr%
      Text Int(42 * fx + vx%), antwy%, za$ + " " + mass$ + " + " + zb$ + " " + mass1$ + " ="
    Else If stufe| = 3                                                      ' schriftliches Rechnen
      If wahl| = 8
        antwx% = Int(42 * fx + vx%) + (31 - Len(antwort_$ + mass$)) * zeichenbr%
        Text Int(42 * fx + vx%) - zeichenbr% * 2, antwy%, za$ + " " + mass$ + " + " + zb$ + " " + mass1$ + ":"
      Else
        antwx% = Int(42 * fx + vx%) + (28 - Len(antwort_$ + mass$)) * zeichenbr%
        Text Int(42 * fx + vx%), antwy%, za$ + " " + mass$ + " + " + zb$ + " " + mass1$ + ":"
      EndIf
    EndIf
  Else
    If stufe| = 1
      antwx% = Int(42 * fx + vx%) + (Len(Trim$(Str$(Val(antwort_$) * 100))) + 5) * zeichenbr%
      Text Int(42 * fx + vx%), Int(29 * fy + vy%) + zeichenh% * 2, Trim$(Str$(Val(antwort_$) * 100)) + " m ="
    Else If stufe| = 2
      antwx% = Int(42 * fx + vx%) + (Len(za$ + zb$ + mass$) + 11) * zeichenbr%
      Text Int(42 * fx + vx%), Int(29 * fy + vy%) + zeichenh% * 2, za$ + " " + mass$ + " + " + Trim$(Str$(b% * 100)) + " m ="
    EndIf
  EndIf
  If b% = 1 And wahl| = 8
    mass1$ = "100-m-Stücke"
  EndIf
  Color RGB(255, 0, 0) ' rot
  Box antwx%, antwy% - 16 * fy + zeichenh%, antwx% + zeichenbr% - Ceil(2 * fx), antwy% + zeichenh%
  Color RGB(0, 0, 0) ' schwarz
  Repeat
    PeekEvent
    f13:
    If (hilfe| = 2 Or falsch1| > 0) And stufe| < 3
      If zehn| = 1
        Color RGB(255, 0, 0) ' rot
        Text Int(42 * fx + vx%), Int(29 * fy + vy%) + zeichenh% * 4, "Beispiel:"
        Color RGB(0, 0, 0) ' schwarz
        Text Int(41 * fx + vx%) + zeichenbr% * (3 - Len(mass$)), Int(29 * fy + vy%) + zeichenh% * 6, mass$
        Text Int(42 * fx + vx%) + zeichenbr% * 3, Int(29 * fy + vy%) + zeichenh% * 8, mass1$
        If wahl| <> 8
          Text Int(42 * fx + vx%), Int(29 * fy + vy%) + zeichenh% * 10, "2345 " + mass$ + "   (1 " + mass$ + " = 10 " + mass1$ + ")"
        Else
          Text Int(42 * fx + vx%), Int(29 * fy + vy%) + zeichenh% * 10, "2345 " + mass$ + "  (1 " + mass$ + " = 10 · 100 m)"
        EndIf
        DefLine 0, 2 * fy
        Line Int(42 * fx + vx%) + zeichenbr% * 3, Int(29 * fy + vy%) + zeichenh% * 11, Int(41 * fx + vx%) + zeichenbr% * 3, 33 * fy + vy% + zeichenh% * 11  ' Komma
        DefLine 0, 1
        Color RGB(255, 0, 0) ' rot
        SetFont schriftw3%
        Text Int(41 * fx + vx%) + zeichenbr% * 2, Int(29 * fy + vy%) + zeichenh% * 7, "ò"
        Text Int(41 * fx + vx%) + zeichenbr% * 3, Int(29 * fy + vy%) + zeichenh% * 9, "ò"
        SetFont schrift3%
      EndIf
      If hundert| = 1
        Color RGB(255, 0, 0) ' rot
        Text Int(42 * fx + vx%), Int(29 * fy + vy%) + zeichenh% * 5, "Beispiel:"
        Color RGB(0, 0, 0) ' schwarz
        Text Int(42 * fx + vx%) + zeichenbr% * 4, Int(29 * fy + vy%) + zeichenh% * 7, mass1$
        Text Int(41 * fx + vx%) + zeichenbr% * (3 - Len(mass$)), Int(29 * fy + vy%) + zeichenh% * 7, mass$
        Text Int(42 * fx + vx%), Int(29 * fy + vy%) + zeichenh% * 10, "23405 " + mass$ + "   (1 " + mass$ + " = 100 " + mass1$ + ")"
        DefLine 0, 2 * fy
        Line Int(42 * fx + vx%) + zeichenbr% * 3, Int(29 * fy + vy%) + zeichenh% * 11, Int(41 * fx + vx%) + zeichenbr% * 3, 33 * fy + vy% + zeichenh% * 11  ' Komma
        DefLine 0, 1
        Color RGB(255, 0, 0) ' rot
        SetFont schriftw3%
        Text Int(41 * fx + vx%) + zeichenbr% * 2, Int(29 * fy + vy%) + zeichenh% * 8, "ò"
        Text Int(41 * fx + vx%) + zeichenbr% * 4, Int(29 * fy + vy%) + zeichenh% * 8, "ò"
        SetFont schrift3%
      EndIf
      If tausend| = 1
        Color RGB(255, 0, 0) ' rot
        Text Int(42 * fx + vx%), Int(29 * fy + vy%) + zeichenh% * 5, "Beispiel:"
        Color RGB(0, 0, 0) ' schwarz
        Text Int(41 * fx + vx%) + zeichenbr% * (3 - Len(mass$)), Int(29 * fy + vy%) + zeichenh% * 7, mass$
        Text Int(42 * fx + vx%) + zeichenbr% * 5, Int(29 * fy + vy%) + zeichenh% * 7, mass1$
        Text Int(42 * fx + vx%), Int(29 * fy + vy%) + zeichenh% * 10, "123005 " + mass$ + "   (1 " + mass$ + " = 1000 " + mass1$ + ")"
        DefLine 0, 2 * fy
        Line Int(42 * fx + vx%) + zeichenbr% * 3, Int(29 * fy + vy%) + zeichenh% * 11, Int(41 * fx + vx%) + zeichenbr% * 3, 33 * fy + vy% + zeichenh% * 11  ' Komma
        DefLine 0, 1
        Color RGB(255, 0, 0) ' rot
        SetFont schriftw3%
        Text Int(41 * fx + vx%) + zeichenbr% * 2, Int(29 * fy + vy%) + zeichenh% * 8, "ò"
        Text Int(41 * fx + vx%) + zeichenbr% * 5, Int(29 * fy + vy%) + zeichenh% * 8, "ò"
        SetFont schrift3%
      EndIf
    EndIf
    Repeat
      Sleep
      antw$ = InKey$
    Until antw$ = Chr$(13) Or antw$ = Chr$(8) Or (Asc(antw$) > 47 And Asc(antw$) < 58) Or Asc(antw$) = 44 Or Asc(antw$) = 46 Or (Len(antw$) = 2 And (Asc(Right$(antw$)) = 112 Or Asc(Right$(antw$)) = 119))
    If Len(antw$) = 2 And Asc(Right$(antw$)) = 112 And stufe| < 3 ' F1
      If hilfe| = 2
        hilfe| = 1
      Else
        hilfe| = 2
        hilferuf| = 1
      EndIf
      GoTo f13
    EndIf
    Exit If antw$ = Chr$(13)                            ' Return
    Color RGB(255, 255, 198) ' creme
    If Len(antw$) = 2 And Asc(Right$(antw$)) = 119         ' F8
      ende| = 1
      GoTo ende46
    Else If antw$ = Chr$(8)                                 ' Backspace
      If Len(eingabe_$) > 0
        If Right$(eingabe_$) <> ","
          Color RGB(255, 255, 198) ' creme
          Sub antwx%, zeichenbr%
          PBox antwx%, antwy% - 16 * fy + zeichenh%, antwx% + zeichenbr% - Int(2 * fx), antwy% + zeichenh%
        Else
          Color RGB(255, 255, 198) ' creme
          DefLine 0, 2 * fy
          Line antwx% - fx, antwy% + zeichenh%, antwx% - Int(2 * fx), antwy% + 4 * fy + zeichenh%    ' Komma
          DefLine 0, 1
          Color RGB(0, 190, 255) ' hell blaugrün
          Line antwx% - fx, antwy% - 4 * fy + zeichenh%, antwx% - fx, antwy% + 6 * fy + zeichenh%
          Line antwx% - 3 * fx, antwy% + fy + zeichenh%, antwx% + 3 * fx, antwy% + fy + zeichenh%
        EndIf
        eingabe_$ = Left$(eingabe_$, Len(eingabe_$) - 1)
      EndIf
    Else If Asc(antw$) > 47 And Asc(antw$) < 58           ' Zahlen von 0 bis 9
      eingabe_$ = eingabe_$ + antw$
      Color RGB(255, 255, 198) ' creme
      Box antwx%, antwy% - 16 * fy + zeichenh%, antwx% + zeichenbr% - Ceil(2 * fx), antwy% + zeichenh%
      Color RGB(0, 0, 0) ' schwarz
      Text antwx%, antwy%, antw$
      Add antwx%, zeichenbr%
    Else If Asc(antw$) = 44 Or Asc(antw$) = 46            ' Komma
      Color RGB(0, 0, 0) ' schwarz
      DefLine 0, 2 * fy
      Line antwx% - fx, antwy% + zeichenh%, antwx% - Int(2 * fx), antwy% + 4 * fy + zeichenh%    ' Komma
      DefLine 0, 1
      eingabe_$ = eingabe_$ + ","
      If Right$(eingabe_$, 2) = ",,"
        eingabe_$ = Left$(eingabe_$, Len(eingabe_$) - 1)
      EndIf
    EndIf
  Until Len(eingabe_$) = Len(antwort_$) + 2
  If zehn| = 1
    stelle| = 1
  Else If hundert| = 1
    stelle| = 2
  Else If tausend| = 1
    stelle| = 3
  EndIf
  SetFont schrift1%
  st% = Max(Len(eingabe_$) - stelle|, 1)
  If InStr(eingabe_$, ",") = 0 And eingabe_$ <> ""
    Inc falsch1|
    fehler| = 1
    Inc falsch%
    saeule
    abdecken
    falsch
    Color RGB(0, 0, 0) ' schwarz
    SetFont schrift1%
    If einzelner| = 1
      Text Int(42 * fx + vx%), 300 * fy + vy%, "Du hast das Komma vergessen!"
    Else
      Text Int(42 * fx + vx%), 300 * fy + vy%, "Ihr habt das Komma vergessen!"
    EndIf
    Repeat
      Sleep
    Until InKey$ <> ""
    If stufe| = 3
      Put bildx%, antwy% + 4 * fy + vy%, neu$
    Else
      Put antwx% - (Len(eingabe_$) + 1) * zeichenbr%, antwy% + 4 * fy, neu$
    EndIf
    abdecken
    SetFont schrift3%
    GoTo neu9
  Else If Mid$(eingabe_$, st%, 1) <> ","
    Inc falsch1|
    fehler| = 1
    Inc falsch%
    saeule
    abdecken
    falsch
    Color RGB(0, 0, 0) ' schwarz
    SetFont schrift1%
    Text Int(42 * fx + vx%), 300 * fy + vy%, gib$ + "zuerst die " + mass2$ + " ein,"
    Text Int(42 * fx + vx%), 325 * fy + vy%, "dann das Komma,"
    If stelle| = 1
      Text Int(42 * fx + vx%), 350 * fy + vy%, "dahinter mit " + Trim$(Str$(stelle|)) + " Stelle die " + mass3$ + "!"
    Else
      Text Int(42 * fx + vx%), 350 * fy + vy%, "dahinter mit " + Trim$(Str$(stelle|)) + " Stellen die " + mass3$ + "!"
    EndIf
    If wahl| = 8      'km/100-m-Stücke
      SetFont schrift0%
      Text Int(42 * fx + vx%), 375 * fy + vy%, "(Die Nullen für die 10-m-Stücke und 1-m-Stücke werden weggelassen.)"
      SetFont schrift1%
    EndIf
    Repeat
      Sleep
    Until InKey$ <> ""
    If stufe| = 3
      Put bildx%, antwy% + 4 * fy, neu$
    Else
      Put antwx% - (Len(eingabe_$) + 1) * zeichenbr%, antwy% + 4 * fy, neu$
    EndIf
    abdecken
    SetFont schrift3%
    GoTo neu9
  Else If Left$(eingabe_$) = ","
    eingabe_$ = Right$(eingabe_$, Len(eingabe_$) - 1)
    If Val(eingabe_$) = Val(antwort_$) And Len(eingabe_$) < Len(antwort_$)
      Inc falsch1|
      fehler| = 1
      Inc falsch%
      saeule
      abdecken
      falsch
      Color RGB(0, 0, 0) ' schwarz
      SetFont schrift1%
      Text Int(42 * fx + vx%), 300 * fy + vy%, "Vor dem Komma fehlt eine 0!"
      SetFont schrift3%
      Repeat
        Sleep
      Until InKey$ <> ""
      If stufe| = 3
        Put bildx%, antwy% + 4 * fy, neu$
      Else
        Put antwx% - (Len(eingabe_$) + 1) * zeichenbr%, antwy% + 4 * fy, neu$
      EndIf
      abdecken
      GoTo neu9
    EndIf
  Else
    eingabe_$ = Left$(eingabe_$, Len(eingabe_$) - stelle| - 1) + Right$(eingabe_$, stelle|)
  EndIf
  Clr st%
  If eingabe_$ <> antwort_$
    Inc falsch1|
    fehler| = 1
    Inc falsch%
    saeule
    abdecken
    falsch
    Color RGB(0, 0, 0) ' schwarz
    SetFont schrift1%
    Text Int(42 * fx + vx%), 300 * fy + vy%, gib$ + "zuerst die " + mass2$ + " ein,"
    Text Int(42 * fx + vx%), 325 * fy + vy%, "dann das Komma,"
    If stelle| = 1
      Text Int(42 * fx + vx%), 350 * fy + vy%, "dahinter mit " + Trim$(Str$(stelle|)) + " Stelle die " + mass3$ + "!"
    Else
      Text Int(42 * fx + vx%), 350 * fy + vy%, "dahinter mit " + Trim$(Str$(stelle|)) + " Stellen die " + mass3$ + "!"
    EndIf
    Repeat
      Sleep
    Until InKey$ <> ""
    If stufe| = 3
      Put bildx%, antwy% + 4 * fy, neu$
    Else
      Put antwx% - (Len(eingabe_$) + 1) * zeichenbr%, antwy% + 4 * fy, neu$
    EndIf
    abdecken
    GoTo neu9
  EndIf
  SetFont schrift3%
  Add antwx%, zeichenbr%
  Color RGB(255, 0, 0) ' rot
  Box antwx%, antwy% - 16 * fy + zeichenh%, antwx% + zeichenbr% - Ceil(2 * fx), antwy% + zeichenh%
  Repeat
    PeekEvent
  Until And(_Mess = 0, InKey$ = "")
  mass_eingeben                                ' Maßangabe
  If ende| = 1
    GoTo ende46
  EndIf
  Repeat
    PeekEvent
  Until And(_Mess = 0, GetAsyncKeyState(VK_RETURN) = 0)
  SetFont schrift1%
  If eing$ <> mass$
    SetFont schrift3%
    Color RGB(255, 0, 255) ' violett
    If eing$ <> ""
      Box antwx% - Len(eing$) * zeichenbr% - fx, antwy% - 19 * fy + zeichenh%, antwx% - fx, antwy% + fy + zeichenh%
    Else
      Box antwx% - zeichenbr% - fx, antwy% - 19 * fy + zeichenh%, antwx% + zeichenbr% * 2 - fx, antwy% + fy + zeichenh%
    EndIf
    Inc falsch%
    Inc falsch1|
    fehler| = 1
    saeule
    abdecken
    falsch
    SetFont schrift1%
    Text Int(42 * fx + vx%), 300 * fy + vy%, "Die richtige Maßangabe heißt " + Chr$(132) + mass$ + Chr$(147) + ","
    Text Int(42 * fx + vx%), 325 * fy + vy%, "sie gehört zur Zahl vor dem Komma!"
    SetFont schrift3%
    Repeat
      Sleep
    Until InKey$ <> ""
    If stufe| = 3
      Color RGB(0, 190, 255) ' hell blaugrün
      DefLine 0, 1
      If eing$ <> ""
        Box antwx% - Len(eing$) * zeichenbr% - fx, antwy% - 19 * fy + zeichenh%, antwx% - fx, antwy% + fy + zeichenh%
      Else
        Box antwx% - zeichenbr% - fx, antwy% - 19 * fy + zeichenh%, antwx% + zeichenbr% * 2 - fx, antwy% + fy + zeichenh%
      EndIf
      Add antwx%, zeichenbr%
      Put bildx%, antwy% + 4 * fy, neu$
    Else
      Put antwx% - (1 + Len(antwort_$ + eing$)) * zeichenbr%, antwy% - zeichenh% + 4 * fy, neu$
    EndIf
    abdecken
    SetFont schrift3%
    GoTo neu9
  EndIf
  SetFont schrift3%
  If stufe| = 3
    Select komma|
    Case 1, 2              ' Addieren, Subtrahieren
      If antwort1% = 0
        antwort1% = antwort%
        antwort1_$ = antwort_$
        antwy% = antwy% + zeichenh%
        Inc richtig1%
        Clr falsch1|
        Clr fehler|
        saeule
        If aufgabenwahl| = 1
          If komma| = 1
            zufall
          Else
            Repeat
              PeekEvent
              zufall
            Until antwort1% - antwort% > 9
          EndIf
        Else
          abdecken
          selbsteingabe
        EndIf
        abdecken
        GoTo neu9
      Else If antwort2% = 0
        antwort2% = antwort%
        antwort2_$ = antwort_$
        antwy% = antwy% + zeichenh%
        Inc richtig1%
        Clr falsch1|
        Clr fehler|
        saeule
        If aufgabenwahl| = 1
          If komma| = 1
            zufall
          Else
            Repeat
              PeekEvent
              zufall
            Until antwort1% - antwort2% - antwort% >= 0
          EndIf
        Else
          abdecken
          selbsteingabe
        EndIf
        abdecken
        GoTo neu9
      Else If antwort3% = 0
        antwort3% = antwort%
        antwort3_$ = antwort_$
        If komma| = 1
          antwort% = antwort1% + antwort2% + antwort3%
        Else
          antwort% = antwort1% - antwort2% - antwort3%
        EndIf
        If zehn| = 1 And antwort% < 10
          antwort_$ = Right$(Trim$(Str$(100 + antwort%)), 2)
        Else If hundert| = 1 And antwort% < 100
          antwort_$ = Right$(Trim$(Str$(1000 + antwort%)), 3)
        Else If tausend| = 1 And antwort% < 1000
          antwort_$ = Right$(Trim$(Str$(10000 + antwort%)), 4)
        Else
          antwort_$ = Trim$(Str$(antwort%))
        EndIf
        Inc richtig1%
        Clr falsch1|, fehler|, antwort1%, antwort2%, antwort3%
        saeule
        Repeat
          PeekEvent
        Until And(_Mess = 0, GetAsyncKeyState(VK_RETURN) = 0)
        hinweis
        If komma| = 1
          masse_add
        Else
          masse_sub
        EndIf
      EndIf
    Case 3, 4  ' Multiplizieren, Dividieren
      Inc richtig1%
      Clr falsch1|
      Clr fehler|
      saeule
      If aufgabenwahl| = 1            'Computer
        Repeat
          PeekEvent
          If komma| = 3
            b% = Random(100)
          Else
            b% = Random(16)
          EndIf
        Until b% > 1
      Else
        f33:
        Clr ink$, zb$
        abdecken
        Color RGB(0, 0, 0)   ' schwarz
        SetFont schrift1%
        If komma| = 3
          If einzelner| = 1
            ze$ = "Gib ein: Mit welcher Zahl soll malgenommen werden?"
          Else
            ze$ = "Gebt ein: Mit welcher Zahl soll malgenommen werden?"
          EndIf
        Else
          If einzelner| = 1
            ze$ = "Gib ein: Durch welche Zahl soll geteilt werden?"
          Else
            ze$ = "Gebt ein: Durch welche Zahl soll geteilt werden?"
          EndIf
        EndIf
        Text Int(42 * fx + vx%), 380 * fy + vy%, ze$
        Text Int(42 * fx + vx%), 270 * fy + vy%, "1. Zahl  ?"
        Repeat
          Repeat
            Sleep
            ink$ = InKey$
          Until ink$ <> ""
          If Len(ink$) > 1 And Asc(Right$(ink$)) = 119  ' F8
            ende| = 1
            GoTo ende46
          EndIf
          If ink$ = Chr$(08) And zb$ <> ""             ' Backspace
            zb$ = Left$(zb$, Len(zb$) - 1)
            Color RGB(255, 255, 198) ' creme
            PBox 160 * fx + vx% + TxtLen(zb$), 270 * fy + vy%, 160 * fx + vx% + TxtLen(zb$) + zeichenbr%, 270 * fy + vy% + zeichenh%
            b% = Val(zb$)
          Else If ink$ <> Chr$(8) And Asc(ink$) > 47 And Asc(ink$) < 58
            zb$ = zb$ + ink$
            b% = Val(zb$)
          EndIf
          Exit If ink$ = Chr$(13)                      ' Return
          Color RGB(0, 0, 0) ' schwarz
          Text 160 * fx + vx%, 270 * fy + vy%, zb$
        Until Len(zb$) > 1
        If ink$ = Chr$(13) And (zb$ = "" Or ((komma| = 3 Or komma| = 4) And b% = 0))             'Return
          SetFont schrift1%
          Color RGB(0, 0, 0) ' schwarz
          If komma| = 4 And b% = 0
            Text Int(42 * fx + vx%), 300 * fy + vy%, "Durch Null kann nicht geteilt werden!"
          Else
            Text Int(42 * fx + vx%), 300 * fy + vy%, "Gib eine größere Zahl ein!"
          EndIf
          falsch
          Repeat
            Sleep
          Until InKey$ <> ""
          abdecken
          GoTo f33
        EndIf
      EndIf
      a% = antwort%
      If zehn| = 1 And a% < 10
        za$ = Right$(Trim$(Str$(100 + antwort%)), 2)
      Else If hundert| = 1 And a% < 100
        za$ = Right$(Trim$(Str$(1000 + antwort%)), 3)
      Else If tausend| = 1 And a% < 1000
        za$ = Right$(Trim$(Str$(10000 + antwort%)), 4)
      Else
        za$ = Trim$(Str$(antwort%))
      EndIf
      zb$ = Trim$(Str$(b%))
      abdecken
      Repeat
        PeekEvent
      Until And(_Mess = 0, GetAsyncKeyState(VK_RETURN) = 0)
      If komma| = 3
        hinweis
        masse_mul
      Else
        If beginn| = 0
          SetFont schrift1%
          Color RGB(0, 0, 0) ' schwarz
          If einzelner| = 1
            Text Int(42 * fx + vx%), 300 * fy + vy%, "Achtung! Ehe du die erste " + Chr$(132) + mass1$ + Chr$(147) + "-Stelle teilst,"
            Text Int(42 * fx + vx%), 325 * fy + vy%, "klicke mit der Maus an den Platz für das Komma"
            Text Int(42 * fx + vx%), 350 * fy + vy%, "oder gib das Komma mit der Tastatur ein!"
          Else
            Text Int(42 * fx + vx%), 300 * fy + vy%, "Achtung! Ehe ihr die erste " + Chr$(132) + mass1$ + Chr$(147) + "-Stelle teilt,"
            Text Int(42 * fx + vx%), 325 * fy + vy%, "klickt mit der Maus an den Platz für das Komma"
            Text Int(42 * fx + vx%), 350 * fy + vy%, "oder gebt das Komma mit der Tastatur ein!"
          EndIf
          Color RGB(0, 0, 235) ' blau
          Text 180 * fx + vx%, 440 * fy + vy%, "weiter:     Leertaste!"
          Color RGB(255, 0, 0) ' rot
          SetFont schriftw1%
          Text 240 * fx + vx%, 441 * fy + vy%, "ò"
          SetFont schrift3%
          Repeat
            Sleep
          Until InKey$ <> ""
          Repeat
            PeekEvent
          Until _Mess = 0
          abdecken
          beginn| = 1
        EndIf
        masse_div
      EndIf
    EndSelect
  EndIf
  ende46:
  Clr fortsetzung|
Return
>Procedure hinweis
  If beginn| = 0
    abdecken
    SetFont schrift1%
    Color RGB(0, 0, 0) ' schwarz
    If einzelner| = 1
      Text Int(42 * fx + vx%), 300 * fy + vy%, "Rechne die Aufgabe so,"
    Else
      Text Int(42 * fx + vx%), 300 * fy + vy%, "Rechnet die Aufgabe so,"
    EndIf
    Text Int(42 * fx + vx%), 325 * fy + vy%, "als gäbe es kein Komma!"
    Color RGB(0, 0, 235) ' blau
    Text 180 * fx + vx%, 440 * fy + vy%, "weiter:     Leertaste!"
    Color RGB(255, 0, 0) ' rot
    SetFont schriftw1%
    Text 240 * fx + vx%, 441 * fy + vy%, "ò"
    Color RGB(0, 0, 0) ' schwarz
    SetFont schrift3%
    Repeat
      Sleep
    Until InKey$ <> ""
    Repeat
      PeekEvent
    Until _Mess = 0
    abdecken
    beginn| = 1
  EndIf
Return
>Procedure mass_eingeben
  f14:
  Color RGB(0, 0, 0) ' schwarz
  Clr eing$
  If hilfe| = 2
    SetFont schrift1%
    If einzelner| = 1
      Text Int(42 * fx + vx%), 300 * fy + vy%, "Gib jetzt die Maßeinheit ein!"
    Else
      Text Int(42 * fx + vx%), 300 * fy + vy%, "Gebt jetzt die Maßeinheit ein!"
    EndIf
    SetFont schrift3%
  EndIf
  Repeat
    Repeat
      Sleep
      antw$ = InKey$
    Until antw$ = Chr$(13) Or antw$ = Chr$(8) Or Asc(antw$) = 44 Or Asc(antw$) = 46 Or (Len(antw$) = 2 And (Asc(Right$(antw$)) = 112 Or Asc(Right$(antw$)) = 119)) Or (((Asc(antw$) > 64 And Asc(antw$) < 91) Or (Asc(antw$) > 96 And Asc(antw$) < 123)) And Len(antw$) = 1) Or antw$ = "€"
    If Len(antw$) = 2 And Asc(Right$(antw$)) = 112 And eing$ = "" ' F1
      abdecken
      If hilfe| = 2
        hilfe| = 1
      Else
        hilfe| = 2
        hilferuf| = 1
      EndIf
      GoTo f14
    EndIf
    Exit If antw$ = Chr$(13)                            ' Return
    Color RGB(255, 255, 198) ' creme
    If Len(antw$) = 2 And Asc(Right$(antw$)) = 119         ' F8
      ende| = 1
      GoTo ende43 '  kontrolle
    Else If antw$ = Chr$(8)                                 ' Backspace
      If Len(eing$) > 0
        eing$ = Left$(eing$, Len(eing$) - 1)
        Color RGB(255, 255, 198) ' creme
        Sub antwx%, zeichenbr%
        PBox antwx%, antwy% - 16 * fy + zeichenh%, antwx% + zeichenbr% - Int(2 * fx), antwy% + 5 * fy + zeichenh%
        Line antwx% + zeichenbr%, antwy% - 17 * fy + zeichenh%, antwx% + zeichenbr%, antwy% + zeichenh%
        Color RGB(0, 190, 255) ' hell blaugrün
        DefLine 0, 1
        Line antwx% + 13 * fx, antwy% - 17 * fy + zeichenh%, antwx% + 13 * fx, antwy% + 5 * fy + zeichenh%
        Line antwx%, antwy% + fy + zeichenh%, antwx% + 13 * fx, antwy% + fy + zeichenh%
      EndIf
    Else If (((Asc(antw$) > 64 And Asc(antw$) < 91) Or (Asc(antw$) > 96 And Asc(antw$) < 123)) And Len(antw$) = 1) Or antw$ = "€"
      If antw$ = "E" And mass$ = "€"
        antw$ = "€"
      EndIf
      eing$ = eing$ + antw$
      Color RGB(255, 255, 198) ' creme
      Box antwx%, antwy% - 16 * fy + zeichenh%, antwx% + zeichenbr% - Ceil(2 * fx), antwy% + zeichenh%
      Color RGB(0, 0, 0) ' schwarz
      Text antwx%, antwy%, antw$
      Add antwx%, zeichenbr%
    EndIf
  Until Len(eing$) > Len(mass$)
  ende43:
Return
>Procedure masse_add                ' Kommazahlen addieren
  neu23:
  abdecken
  If wahl| = 8
    antwx% = Int(41 * fx + vx%) + zeichenbr% * (31 - Len(mass$))
  Else
    antwx% = Int(41 * fx + vx%) + zeichenbr% * (28 - Len(mass$))
  EndIf
  antwy% = Int(29 * fy + vy%) + zeichenh% * 5
  Clr eingabe_$, stelle|, uebertrag_$, xxx$
  Repeat
    SetFont schrift3%
    Color RGB(0, 0, 0) ' schwarz
    PeekEvent
    Inc stelle|
    If wahl| = 8
      Text Int(41 * fx + vx%) + zeichenbr% * (29 - Len(antwort_$ + mass$)), antwy% - zeichenh%, "+"
      Line Int(41 * fx + vx%) + zeichenbr% * (29 - Len(antwort_$ + mass$)), antwy% + Int(19 * fy), Int(42 * fx + vx%) + zeichenbr% * 32, antwy% + Int(19 * fy)
    Else
      Text Int(41 * fx + vx%) + zeichenbr% * (26 - Len(antwort_$ + mass$)), antwy% - zeichenh%, "+"
      Line Int(41 * fx + vx%) + zeichenbr% * (26 - Len(antwort_$ + mass$)), antwy% + Int(19 * fy), Int(42 * fx + vx%) + zeichenbr% * 29, antwy% + Int(19 * fy)
    EndIf
    Color RGB(255, 0, 0) ' rot
    If Len(eingabe_$) < Len(antwort_$)
      Box antwx% - Int(fx), antwy% + 4 * fy + zeichenh%, antwx% + Int(fx) - zeichenbr%, antwy% + zeichenh% * 2 ' Kursor
    EndIf
    f22:
    If hilfe| = 2 And Len(eingabe_$) < Len(antwort_$)
      If ueb% = 1
        Clr ueb%
      EndIf
      Color RGB(0, 0, 0) ' schwarz
      SetFont schrift1%
      abdecken
      If einzelner| = 1
        Text Int(42 * fx + vx%), 300 * fy + vy%, "Addiere die eingerahmten Zahlen und gib"
      Else
        Text Int(42 * fx + vx%), 300 * fy + vy%, "Addiert die eingerahmten Zahlen und gebt"
      EndIf
      Text Int(42 * fx + vx%), 325 * fy + vy%, "die letzte Ziffer des Ergebnisses ein!"
      SetFont schrift3%
      DefLine 0, 1
      If wahl| = 8
        Color RGB(0, 190, 255) ' hell blaugrün
        Box Int(41 * fx + vx%) + zeichenbr% * (32 - Len(mass$) - stelle|), Int(30 * fy + vy%) + zeichenh% * 2, Int(41 * fx + vx%) + zeichenbr% * (33 - Len(mass$) - stelle|), antwy% + Int(18 * fy)
        Color RGB(255, 255, 198) ' creme
        Line Int(42 * fx + vx%) + zeichenbr% * (32 - Len(mass$) - stelle|), antwy% + Int(18 * fy), Int(41 * fx + vx%) + zeichenbr% * (33 - Len(mass$) - stelle|), antwy% + Int(18 * fy)
        Color RGB(255, 0, 0) ' rot
        Box Int(41 * fx + vx%) + zeichenbr% * (31 - Len(mass$) - stelle|), Int(30 * fy + vy%) + zeichenh% * 2, Int(41 * fx + vx%) + zeichenbr% * (32 - Len(mass$) - stelle|), antwy% + Int(18 * fy)
      Else
        Color RGB(0, 190, 255) ' hell blaugrün
        Box Int(41 * fx + vx%) + zeichenbr% * (29 - Len(mass$) - stelle|), Int(30 * fy + vy%) + zeichenh% * 2, Int(41 * fx + vx%) + zeichenbr% * (30 - Len(mass$) - stelle|), antwy% + Int(18 * fy)
        Color RGB(255, 255, 198) ' creme
        Line Int(42 * fx + vx%) + zeichenbr% * (29 - Len(mass$) - stelle|), antwy% + Int(18 * fy), Int(41 * fx + vx%) + zeichenbr% * (30 - Len(mass$) - stelle|), antwy% + Int(18 * fy)
        Color RGB(255, 0, 0) ' rot
        Box Int(41 * fx + vx%) + zeichenbr% * (28 - Len(mass$) - stelle|), Int(30 * fy + vy%) + zeichenh% * 2, Int(41 * fx + vx%) + zeichenbr% * (29 - Len(mass$) - stelle|), antwy% + Int(18 * fy)
      EndIf
    EndIf
    Color RGB(0, 0, 0) ' schwarz
    Repeat
      Sleep
      antw$ = InKey$
    Until Asc(antw$) > 47 And Asc(antw$) < 58 Or (Len(antw$) = 2 And (Asc(Right$(antw$)) = 119 Or (Asc(Right$(antw$)) = 112)) Or antw$ = Chr$(13))
    If Len(antw$) = 2 And Asc(Right$(antw$)) = 112
      If hilfe| = 1
        hilfe| = 2
        Color RGB(200, 0, 0) ' dunkelrot
        If Len(xxx$) >= stelle|            ' automatischer Übertrag
          SetFont schrift0%
          Text antwx% - 11 * fx, antwy% + 4 * fy, Left$(xxx$)
        EndIf
        Color RGB(0, 0, 0) ' schwarz
        SetFont schrift1%
        hilferuf| = 1
      Else
        hilfe| = 1
        DefLine 0, 1
        If wahl| = 8
          Color RGB(0, 190, 255) ' hell blaugrün
          Box Int(41 * fx + vx%) + zeichenbr% * (31 - Len(mass$) - stelle|), Int(30 * fy + vy%) + zeichenh% * 2, Int(41 * fx + vx%) + zeichenbr% * (32 - Len(mass$) - stelle|), antwy% + Int(18 * fy)
          Color RGB(255, 255, 198) ' creme
          Line Int(42 * fx + vx%) + zeichenbr% * (31 - Len(mass$) - stelle|), antwy% + Int(18 * fy), Int(42 * fx + vx%) + zeichenbr% * (32 - Len(mass$) - stelle|), antwy% + Int(18 * fy)
        Else
          Color RGB(0, 190, 255) ' hell blaugrün
          Box Int(41 * fx + vx%) + zeichenbr% * (28 - Len(mass$) - stelle|), Int(30 * fy + vy%) + zeichenh% * 2, Int(41 * fx + vx%) + zeichenbr% * (29 - Len(mass$) - stelle|), antwy% + Int(18 * fy)
          Color RGB(255, 255, 198) ' creme
          Line Int(42 * fx + vx%) + zeichenbr% * (28 - Len(mass$) - stelle|), antwy% + Int(18 * fy), Int(42 * fx + vx%) + zeichenbr% * (29 - Len(mass$) - stelle|), antwy% + Int(18 * fy)
        EndIf
        abdecken
      EndIf
      GoTo f22
    EndIf
    Exit If antw$ = Chr$(13)                            ' Return
    abfrage
    If ende| = 1
      GoTo ende44
    EndIf
    If Len(eingabe_$) <= Len(antwort_$)
      If Right$(eingabe_$, stelle|) <> Right$(antwort_$, stelle|)
        Inc falsch%
        Inc falsch1|
        fehler| = 1
        saeule
        abdecken
        falsch
        Color RGB(200, 0, 0) ' dunkelrot
        If Len(xxx$) >= stelle|            ' automatischer Übertrag
          SetFont schrift0%
          Text antwx% - 11 * fx, antwy% + 4 * fy, Left$(xxx$)
        EndIf
        Color RGB(0, 0, 0) ' schwarz
        SetFont schrift1%
        If einzelner| = 1
          Text Int(42 * fx + vx%), 300 * fy + vy%, "Addiere die eingerahmten Zahlen und gib"
        Else
          Text Int(42 * fx + vx%), 300 * fy + vy%, "Addiert die eingerahmten Zahlen und gebt"
        EndIf
        Text Int(42 * fx + vx%), 325 * fy + vy%, "die letzte Ziffer des Ergebnisses ein!"
        SetFont schrift3%
        DefLine 0, 1
        If wahl| = 8
          Color RGB(0, 190, 255) ' hell blaugrün
          Box Int(41 * fx + vx%) + zeichenbr% * (32 - Len(mass$) - stelle|), Int(30 * fy + vy%) + zeichenh% * 2, Int(41 * fx + vx%) + zeichenbr% * (33 - Len(mass$) - stelle|), antwy% + Int(18 * fy)
          Color RGB(255, 255, 198) ' creme
          Line Int(41 * fx + vx%) + zeichenbr% * (32 - Len(mass$) - stelle|), antwy% + Int(18 * fy), Int(42 * fx + vx%) + zeichenbr% * (33 - Len(mass$) - stelle|), antwy% + Int(18 * fy)
          Color RGB(255, 0, 0) ' rot
          Box Int(41 * fx + vx%) + zeichenbr% * (31 - Len(mass$) - stelle|), Int(30 * fy + vy%) + zeichenh% * 2, Int(41 * fx + vx%) + zeichenbr% * (32 - Len(mass$) - stelle|), antwy% + Int(18 * fy)
        Else
          Color RGB(0, 190, 255) ' hell blaugrün
          Box Int(41 * fx + vx%) + zeichenbr% * (29 - Len(mass$) - stelle|), Int(30 * fy + vy%) + zeichenh% * 2, Int(41 * fx + vx%) + zeichenbr% * (30 - Len(mass$) - stelle|), antwy% + Int(18 * fy)
          Color RGB(255, 255, 198) ' creme
          Line Int(41 * fx + vx%) + zeichenbr% * (29 - Len(mass$) - stelle|), antwy% + Int(18 * fy), Int(42 * fx + vx%) + zeichenbr% * (30 - Len(mass$) - stelle|), antwy% + Int(18 * fy)
          Color RGB(255, 0, 0) ' rot
          Box Int(41 * fx + vx%) + zeichenbr% * (28 - Len(mass$) - stelle|), Int(30 * fy + vy%) + zeichenh% * 2, Int(41 * fx + vx%) + zeichenbr% * (29 - Len(mass$) - stelle|), antwy% + Int(18 * fy)
        EndIf
        Repeat
          Sleep
        Until InKey$ <> ""
        falsch_komma
        Put bildx%, antwy% + 4 * fy, neu$
        GoTo neu23
      EndIf
      Color RGB(0, 0, 0) ' schwarz
      xxx$ = Trim$(Str$(Val(Right$(antwort1_$, stelle|)) + Val(Right$(antwort2_$, stelle|)) + Val(Right$(antwort3_$, stelle|))))
      If Len(xxx$) > stelle|
        f23:
        If hilfe| = 2 Or falsch1 > 0 Or uebertr| = 2        'Kasten
          Color RGB(255, 0, 0)    ' rot
          Box antwx% + fx - zeichenbr% * 2, antwy% + 4 * fy, antwx% - 3 * fx - zeichenbr%, antwy% + Int(18 * fy) 'Kasten
          If hilfe| = 2 Or falsch1 > 0
            ueb% = 1
            abdecken
            Color RGB(0, 0, 0) ' schwarz
            SetFont schrift1%
            Text Int(42 * fx + vx%), 300 * fy + vy%, gib$ + "als Merkzahl die erste"
            If einzelner| = 1
              Text Int(42 * fx + vx%), 325 * fy + vy%, "Ziffer deines Ergebnisses ein!"
            Else
              Text Int(42 * fx + vx%), 325 * fy + vy%, "Ziffer eures Ergebnisses ein!"
            EndIf
          EndIf
          Color RGB(0, 0, 0) ' schwarz
          Repeat
            Sleep
            uebertrag_$ = InKey$
          Until Asc(uebertrag_$) > 47 And Asc(uebertrag_$) < 58 Or (Len(uebertrag_$) = 2 And (Asc(Right$(uebertrag_$)) = 119 Or Asc(Right$(uebertrag_$)) = 112)) Or uebertrag_$ = Chr$(13)
          If Len(uebertrag_$) = 2 And Asc(Right$(uebertrag_$)) = 112
            If hilfe| = 1
              hilfe| = 2
              hilferuf| = 1
              Color RGB(255, 255, 198) ' creme
              Box antwx% + fx - zeichenbr% * 2, antwy% + 4 * fy, antwx% - 3 * fx - zeichenbr%, antwy% + Int(18 * fy) 'Kasten
            Else
              hilfe| = 1
              DefLine 0, 1
              If wahl| = 8
                Color RGB(0, 190, 255) ' hell blaugrün
                Box Int(41 * fx + vx%) + zeichenbr% * (31 - Len(mass$) - stelle|), Int(30 * fy + vy%) + zeichenh% * 2, Int(41 * fx + vx%) + zeichenbr% * (32 - Len(mass$) - stelle|), antwy% + Int(18 * fy)
                Color RGB(255, 255, 198) ' creme
                Line Int(42 * fx + vx%) + zeichenbr% * (31 - Len(mass$) - stelle|), antwy% + Int(18 * fy), Int(41 * fx + vx%) + zeichenbr% * (32 - Len(mass$) - stelle|), antwy% + Int(18 * fy)
              Else
                Color RGB(0, 190, 255) ' hell blaugrün
                Box Int(41 * fx + vx%) + zeichenbr% * (28 - Len(mass$) - stelle|), Int(30 * fy + vy%) + zeichenh% * 2, Int(41 * fx + vx%) + zeichenbr% * (29 - Len(mass$) - stelle|), antwy% + Int(18 * fy)
                Color RGB(255, 255, 198) ' creme
                Line Int(42 * fx + vx%) + zeichenbr% * (28 - Len(mass$) - stelle|), antwy% + Int(18 * fy), Int(41 * fx + vx%) + zeichenbr% * (29 - Len(mass$) - stelle|), antwy% + Int(18 * fy)
              EndIf
              abdecken
            EndIf
            GoTo f23
          EndIf
          If Len(uebertrag_$) = 2 And Asc(Right$(uebertrag_$)) = 119
            ende| = 1
            GoTo ende44 '   kontrolle
          EndIf
          Color RGB(255, 255, 198) ' creme
          Box antwx% + fx - zeichenbr% * 2, antwy% + 4 * fy, antwx% - 3 * fx - zeichenbr%, antwy% + Int(18 * fy) 'Kasten
          If Asc(uebertrag_$) > 47 And Asc(uebertrag_$) < 58
            Color RGB(200, 0, 0) ' dunkelrot
            SetFont schrift0%
            Text antwx% - zeichenbr% - 11 * fx, antwy% + 4 * fy, uebertrag_$
            SetFont schrift3%
          EndIf
          Color RGB(0, 0, 0) ' schwarz
          If uebertrag_$ <> Left$(xxx$)
            Inc falsch%
            Inc falsch1|
            fehler| = 1
            saeule
            abdecken
            falsch
            SetFont schrift1%
            Text Int(42 * fx + vx%), 300 * fy + vy%, gib$ + "als Merkzahl die erste"
            If einzelner| = 1
              Text Int(42 * fx + vx%), 325 * fy + vy%, "Ziffer deines Ergebnisses ein!"
            Else
              Text Int(42 * fx + vx%), 325 * fy + vy%, "Ziffer eures Ergebnisses ein!"
            EndIf
            SetFont schrift3%
            Repeat
              Sleep
            Until InKey$ <> ""
            falsch_komma
            Put bildx%, antwy% + 4 * fy, neu$
            GoTo neu23
          EndIf
        EndIf
        Color RGB(255, 255, 198) ' creme
        Box antwx% + fx - zeichenbr% * 2, antwy% + 4 * fy, antwx% - 3 * fx - zeichenbr%, antwy% + Int(18 * fy) 'Kasten
      EndIf
    EndIf
    Sub antwx%, zeichenbr%
  Until Len(eingabe_$) > Len(antwort_$)
  DefLine 0, 1
  If Len(eingabe_$) < Len(antwort_$)
    If wahl| = 8
      Color RGB(0, 0, 0)' (0, 190, 255) ' hell blaugrün
      Box Int(41 * fx + vx%) + zeichenbr% * (30 - Len(mass$) - Len(eingabe_$)), Int(30 * fy + vy%) + zeichenh% * 2, Int(41 * fx + vx%) + zeichenbr% * (31 - Len(mass$) - Len(eingabe_$)), antwy% + Int(18 * fy)
      Color RGB(255, 255, 198) ' creme
      Line Int(42 * fx + vx%) + zeichenbr% * (30 - Len(mass$) - Len(eingabe_$)), antwy% + Int(18 * fy), Int(41 * fx + vx%) + zeichenbr% * (31 - Len(mass$) - Len(eingabe_$)), antwy% + Int(18 * fy)
    Else
      Color RGB(0, 0, 0)' (0, 190, 255) ' hell blaugrün
      Box Int(41 * fx + vx%) + zeichenbr% * (27 - Len(mass$) - Len(eingabe_$)), Int(30 * fy + vy%) + zeichenh% * 2, Int(41 * fx + vx%) + zeichenbr% * (28 - Len(mass$) - Len(eingabe_$)), antwy% + Int(18 * fy)
      Color RGB(255, 255, 198) ' creme
      Line Int(42 * fx + vx%) + zeichenbr% * (27 - Len(mass$) - Len(eingabe_$) ), antwy% + Int(18 * fy), Int(41 * fx + vx%) + zeichenbr% * (28 - Len(mass$) - Len(eingabe_$)), antwy% + Int(18 * fy)
    EndIf
  Else
    If wahl| = 8
      Color RGB(0, 190, 255) ' hell blaugrün
      Box Int(41 * fx + vx%) + zeichenbr% * (32 - Len(mass$) - stelle|), Int(30 * fy + vy%) + zeichenh% * 2, Int(41 * fx + vx%) + zeichenbr% * (33 - Len(mass$) - stelle|), antwy% + Int(18 * fy)
      Color RGB(255, 255, 198) ' creme
      Line Int(42 * fx) + zeichenbr% * (32 - Len(mass$) - stelle|), antwy% + Int(18 * fy), Int(41 * fx) + zeichenbr% * (33 - Len(mass$) - stelle|), antwy% + Int(18 * fy)
    Else
      Color RGB(0, 190, 255) ' hell blaugrün
      Box Int(41 * fx + vx%) + zeichenbr% * (29 - Len(mass$) - stelle|), Int(30 * fy + vy%) + zeichenh% * 2, Int(41 * fx + vx%) + zeichenbr% * (30 - Len(mass$) - stelle|), antwy% + Int(18 * fy)
      Color RGB(255, 255, 198) ' creme
      Line Int(42 * fx + vx%) + zeichenbr% * (29 - Len(mass$) - stelle|), antwy% + Int(18 * fy), Int(41 * fx + vx%) + zeichenbr% * (30 - Len(mass$) - stelle|), antwy% + Int(18 * fy)
    EndIf
  EndIf
  If Val(eingabe_$) = Val(antwort_$) And Len(eingabe_$) < Len(antwort_$)
    Inc falsch1|
    fehler| = 1
    Inc falsch%
    saeule
    abdecken
    falsch
    Color RGB(0, 0, 0) ' schwarz
    SetFont schrift1%
    If einzelner| = 1
      Text Int(42 * fx + vx%), 300 * fy + vy%, "Bis zur " + mass2$ + "-Stelle musst du Nullen eingeben!"
    Else
      Text Int(42 * fx + vx%), 300 * fy + vy%, "Bis zur " + mass2$ + "-Stelle müsst ihr Nullen eingeben!"
    EndIf
    SetFont schrift3%
    Repeat
      Sleep
    Until InKey$ <> ""
    Put bildx%, antwy% + 4 * fy, neu$
    GoTo neu23
  EndIf
  If eingabe_$ <> "" And Len(eingabe_$) < Len(antwort_$)
    falsch_komma
    Put bildx%, antwy% + 4 * fy, neu$
    GoTo neu23
  EndIf
  If Len(eingabe_$) > Len(antwort_$)
    SetFont schrift1%
    Color RGB(0, 0, 0) ' schwarz
    abdecken
    If Left$(eingabe_$) = "0"
      falsch
      SetFont schrift1%
      Color RGB(0, 0, 0) ' schwarz
      Text Int(42 * fx + vx%), 300 * fy + vy%, richt$
      Text Int(42 * fx + vx%), 325 * fy + vy%, "Null vor dem Ergebnis weg!"
      SetFont schrift3%
      Repeat
        Sleep
      Until InKey$ <> ""
      abdecken
    Else
      Inc falsch%
      Inc falsch1|
      fehler| = 1
      falsch
      saeule
      Color RGB(0, 0, 0) ' schwarz
      SetFont schrift1%
      Text Int(42 * fx + vx%), 300 * fy + vy%, du$ + "zu weit gerechnet!"
      SetFont schrift3%
      Repeat
        Sleep
      Until InKey$ <> ""
      falsch_komma
      Put bildx%, antwy% + 4 * fy, neu$
      GoTo neu23
    EndIf
    SetFont schrift3%
  EndIf
  Inc richtig1%
  Clr falsch1|
  Clr fehler|
  saeule
  If zehn| = 1
    stelle| = 1
    zd$ = "10"
  Else If hundert| = 1
    stelle| = 2
    zd$ = "100"
  Else If tausend| = 1
    stelle| = 3
    zd$ = "1000"
  EndIf
  Color RGB(190, 225, 255) ' hellblau
  PBox 27 * fx + vx%, 280 * fy + vy%, 510 * fx + vx%, 360 * fy + vy%
  SetFont schrift1%
  Color RGB(0, 0, 0) ' schwarz
  If  einzelner| = 1
    Text 32 * fx + vx%, 300 * fy + vy%, "Klicke jetzt mit der Maus an die Stelle,"
  Else
    Text 32 * fx + vx%, 300 * fy + vy%, "Klickt jetzt mit der Maus an die Stelle,"
  EndIf
  If wahl| = 8
    Text 32 * fx + vx%, 325 * fy + vy%, "an der das Komma  " + Chr$(132) + mass$ + Chr$(147) + "  von  " + Chr$(132) + mass3$ + "n" + Chr$(147) + "  trennt!"
  Else
    If geldwahl| <> 2
      Text 32 * fx + vx%, 325 * fy + vy%, "an der das Komma  " + Chr$(132) + mass$ + Chr$(147) + "  von  " + Chr$(132) + mass1$ + Chr$(147) + "  trennt!"
    Else 'Euro
      Text 32 * fx + vx%, 325 * fy + vy%, "an der das Komma  " + Chr$(132) + "Euro" + Chr$(147) + "  von  " + Chr$(132) + "Cent" + Chr$(147) + "  trennt!"
    EndIf
  EndIf
  DefMouse 0
  Repeat
    Mouse x%, y%, k%
    PeekEvent
  Until k% <> 0
  Repeat
    PeekEvent
  Until And(_Mess = 0, InKey$ = "")
  DefMouse V:aaa%(0)        ' transparente Mausform
  If wahl| = 8
    antwx% = Int(41 * fx + vx%) + (31 - Len(mass$) - stelle|) * zeichenbr%
  Else
    antwx% = Int(41 * fx + vx%) + (28 - Len(mass$) - stelle|) * zeichenbr%
  EndIf
  Color RGB(0, 0, 0) ' schwarz
  If x% > antwx% - 4 * fx And x% < antwx% + 4 * fx And y% > antwy% + zeichenh% * 2 - 6 * fy And y% < antwy% + zeichenh% * 2 + 6 * fy
    DefLine 0, 2 * fy
    Line antwx%, antwy% + zeichenh% * 2, antwx% - fx, antwy% + zeichenh% * 2 + 4 * fy  ' Komma
    DefLine 0, 1
    Inc richtig1%
    Clr falsch1|
    Clr fehler|
    saeule
  Else
    Inc falsch%
    Inc falsch1|
    fehler| = 1
    abdecken
    falsch
    saeule
    SetFont schrift1%
    Color RGB(0, 0, 0) ' schwarz
    If wahl| = 8
      Text Int(42 * fx + vx%), 300 * fy + vy%, "1 " + mass2$ + " besteht aus " + zd$ + " " + Chr$(132) + mass3$ + "n" + Chr$(147) + "!"
    Else If geldwahl| = 2
      Text Int(42 * fx + vx%), 300 * fy + vy%, "1 € besteht aus " + zd$ + " Cent!"
    Else
      Text Int(42 * fx + vx%), 300 * fy + vy%, "1 " + mass$ + " besteht aus " + zd$ + " " + mass1$ + "!"
    EndIf
    If stelle| = 1
      Text Int(42 * fx + vx%), 325 * fy + vy%, "Deshalb wird hinter dem Komma 1 Stelle gebraucht!"
    Else
      Text Int(42 * fx + vx%), 325 * fy + vy%, "Deshalb werden hinter dem Komma " + Trim$(Str$(stelle|)) + " Stellen gebraucht!"
    EndIf
    SetFont schrift3%
    Repeat
      Sleep
    Until InKey$ <> ""
    falsch_komma
    Put bildx%, antwy% + 4 * fy, neu$
    GoTo neu23
  EndIf
  If wahl| = 8
    antwx% = Int(42 * fx + vx%) + (32 - Len(mass$)) * zeichenbr%
  Else
    antwx% = Int(42 * fx + vx%) + (29 - Len(mass$)) * zeichenbr%
  EndIf
  antwy% = antwy% + zeichenh%
  abdecken
  Color RGB(255, 0, 0) ' rot
  Box antwx%, antwy% - 16 * fy + zeichenh%, antwx% + zeichenbr% - Ceil(2 * fx), antwy% + zeichenh%
  mass_eingeben
  If ende| = 1
    GoTo ende44
  EndIf
  SetFont schrift1%
  If eing$ <> mass$
    SetFont schrift3%
    Color RGB(255, 0, 255) ' violett
    If eing$ <> ""
      Box antwx% - Len(eing$) * zeichenbr% - fx, antwy% - 19 * fy + zeichenh%, antwx% - fx, antwy% + fy + zeichenh%
    Else
      Box antwx% - zeichenbr% - fx, antwy% - 19 * fy + zeichenh%, antwx% + zeichenbr% * 2 - fx, antwy% + fy + zeichenh%
    EndIf
    Inc falsch%
    Inc falsch1|
    fehler| = 1
    abdecken
    falsch
    saeule
    SetFont schrift1%
    Color RGB(0, 0, 0)   ' schwarz
    Text Int(42 * fx + vx%), 300 * fy + vy%, "Die richtige Maßangabe heißt " + Chr$(132) + mass$ + Chr$(147) + ","
    Text Int(42 * fx + vx%), 325 * fy + vy%, "sie gehört zur Zahl vor dem Komma!"
    SetFont schrift3%
    Repeat
      Sleep
    Until InKey$ <> ""
    DefLine 0, 1
    antwy% = antwy% - zeichenh%
    falsch_komma
    Put bildx%, antwy% + 4 * fy + vy%, neu$
    GoTo neu23
  EndIf
  ende44:
Return
>Procedure masse_sub                ' Kommazahlen subtrahieren
  ArrayFill uebertrag%(), 0
  Color RGB(0, 0, 0) ' schwarz
  If wahl| = 8 And komma| = 2
    Text Int(41 * fx + vx%) + zeichenbr% * (29 - Len(antwort1_$ + mass$)), Int(29 * fy + vy%) + zeichenh% * 3, "-"
    Text Int(41 * fx + vx%) + zeichenbr% * (29 - Len(antwort1_$ + mass$)), Int(29 * fy + vy%) + zeichenh% * 4, "-"
  Else If komma| = 2
    Text Int(41 * fx + vx%) + zeichenbr% * (26 - Len(antwort1_$ + mass$)), Int(29 * fy + vy%) + zeichenh% * 3, "-"
    Text Int(41 * fx + vx%) + zeichenbr% * (26 - Len(antwort1_$ + mass$)), Int(29 * fy + vy%) + zeichenh% * 4, "-"
  EndIf
  neu25:
  abdecken
  If wahl| = 8
    antwx% = Int(41 * fx + vx%) + zeichenbr% * (31 - Len(mass$))
  Else
    antwx% = Int(41 * fx + vx%) + zeichenbr% * (28 - Len(mass$))
  EndIf
  antwy% = Int(29 * fy + vy%) + zeichenh% * 5
  Clr eingabe_$, stelle|, ueber$, antw$
  Color RGB(0, 0, 0) ' schwarz
  If wahl| = 8
    Line Int(42 * fx + vx%) + zeichenbr% * (29 - Len(antwort1_$ + mass$)), antwy% + Int(19 * fy), 42 * fx + vx% + zeichenbr% * 32, antwy% + Int(19 * fy)
  Else
    Line Int(42 * fx + vx%) + zeichenbr% * (26 - Len(antwort1_$ + mass$)), antwy% + Int(19 * fy), 42 * fx + vx% + zeichenbr% * 29, antwy% + Int(19 * fy)
  EndIf
  Repeat
    PeekEvent
    Inc stelle|
    Color RGB(255, 0, 0) ' rot
    If Len(eingabe_$) < Len(antwort_$)
      Box antwx% - Int(fx), antwy% + 4 * fy + zeichenh%, antwx% + Int(fx) - zeichenbr%, antwy% + zeichenh% * 2 ' Kursor
    EndIf
    xxx$ = Trim$(Str$(Val(Right$(antwort2_$, stelle|)) + Val(Right$(antwort_$, stelle|)) + Val(Right$(antwort3_$, stelle|))))
    If Len(xxx$) = stelle|
      z% = Val(Left$(xxx$))
      z_$ = Trim$(Str$(z%))
    Else If Len(xxx$) > stelle|
      z% = Val(Left$(xxx$, 2))
      z_$ = Trim$(Str$(z%))
      uebertrag%(stelle|) = Val(Left$(z_$))
    Else
      z% = 0
      z_$ = "0"
    EndIf
    f24:
    If hilfe| = 2  And Len(eingabe_$) < Len(antwort_$)
      Color RGB(0, 0, 0) ' schwarz
      SetFont schrift1%
      abdecken
      hilfe_sub
      SetFont schrift3%
    EndIf
    Repeat
      Sleep
      antw$ = InKey$
    Until Asc(antw$) > 47 And Asc(antw$) < 58 Or (Len(antw$) = 2 And (Asc(Right$(antw$)) = 119 Or Asc(Right$(antw$)) = 112)) Or antw$ = Chr$(13)
    If Asc(Right$(antw$)) = 112                          'F1-Taste
      If hilfe| = 2
        hilfe| = 1
        DefLine 0, 1
        If wahl| = 8
          Color RGB(0, 190, 255) ' hell blaugrün
          Box Int(41 * fx + vx%) + zeichenbr% * (31 - Len(mass$) - stelle|), Int(30 * fy + vy%) + zeichenh% * 2, Int(41 * fx + vx%) + zeichenbr% * (32 - Len(mass$) - stelle|), antwy% + Int(18 * fy)
          Color RGB(255, 255, 198) ' creme
          Line Int(42 * fx + vx%) + zeichenbr% * (31 - Len(mass$) - stelle|), antwy% + Int(18 * fy + vy%), Int(41 * fx + vx%) + zeichenbr% * (32 - Len(mass$) - stelle|), antwy% + Int(18 * fy)
        Else
          Color RGB(0, 190, 255) ' hell blaugrün
          Box Int(41 * fx + vx%) + zeichenbr% * (28 - Len(mass$) - stelle|), Int(30 * fy + vy%) + zeichenh% * 2, Int(41 * fx + vx%) + zeichenbr% * (29 - Len(mass$) - stelle|), antwy% + Int(18 * fy)
          Color RGB(255, 255, 198) ' creme
          Line Int(42 * fx + vx%) + zeichenbr% * (28 - Len(mass$) - stelle|), antwy% + Int(18 * fy + vy%), Int(41 * fx + vx%) + zeichenbr% * (29 - Len(mass$) - stelle|), antwy% + Int(18 * fy)
        EndIf
        abdecken
      Else
        hilfe| = 2
        hilferuf| = 1
      EndIf
      GoTo f24
    EndIf
    abdecken
    Exit If antw$ = Chr$(13)                            ' Return
    abfrage
    If ende| = 1
      GoTo ende45
    EndIf
    If Len(eingabe_$) > Len(antwort_$)
      SetFont schrift1%
      Color RGB(0, 0, 0) ' schwarz
      If Left$(eingabe_$) = "0"
        falsch
        Color RGB(0, 0, 0) ' schwarz
        SetFont schrift1%
        Text Int(42 * fx + vx%), 300 * fy + vy%, richt$
        Text Int(42 * fx + vx%), 325 * fy + vy%, "Null vor dem Ergebnis weg!"
        Repeat
          Sleep
        Until InKey$ <> ""
        abdecken
        SetFont schrift3%
        GoTo weiter12
      Else
        Inc falsch%
        Inc falsch1|
        fehler| = 1
        saeule
        abdecken
        falsch
        SetFont schrift1%
        Text Int(42 * fx + vx%), 300 * fy + vy%, du$ + "zu weit gerechnet!"
        Repeat
          Sleep
        Until InKey$ <> ""
        SetFont schrift3%
        falsch_komma
        Put bildx%, antwy% + 4 * fy, neu$
        GoTo neu25
      EndIf
    EndIf
    If Right$(eingabe_$, stelle|) <> Right$(antwort_$, stelle|)
      fehler| = 1
      Inc falsch%
      Inc falsch1|
      saeule
      abdecken
      falsch
      Color RGB(0, 0, 0) ' schwarz
      SetFont schrift1%
      hilfe_sub
      SetFont schrift3%
      Repeat
        Sleep
      Until InKey$ <> ""
      fehler| = 1
      falsch_komma
      Put bildx%, antwy% + 4 * fy, neu$
      GoTo neu25
    EndIf
    If Len(xxx$) > stelle|
      f25:
      If hilfe| = 2 Or falsch1| > 0 Or uebertr| = 2 'Kasten
        Color RGB(255, 0, 0) ' rot
        Box antwx% + fx - zeichenbr% * 2, antwy% + 4 * fy, antwx% - 3 * fx - zeichenbr%, antwy% + Int(18 * fy) 'Kasten
        Color RGB(0, 0, 0) ' schwarz
        Repeat
          Sleep
          ueber$ = InKey$
        Until Asc(ueber$) > 47 And Asc(ueber$) < 58 Or (Len(ueber$) = 2 And (Asc(Right$(ueber$)) = 119 Or Asc(Right$(ueber$)) = 112)) Or ueber$ = Chr$(13)
        If Asc(Right$(ueber$)) = 112                          'F1-Taste
          If hilfe| = 2
            hilfe| = 1
            DefLine 0, 1
            If wahl| = 8
              Color RGB(0, 190, 255) ' hell blaugrün
              Box Int(41 * fx + vx%) + zeichenbr% * (31 - Len(mass$) - stelle|), Int(30 * fy + vy%) + zeichenh% * 2, Int(41 * fx + vx%) + zeichenbr% * (32 - Len(mass$) - stelle|), antwy% + Int(18 * fy)
              Color RGB(255, 255, 198) ' creme
              Line Int(42 * fx + vx%) + zeichenbr% * (31 - Len(mass$) - stelle|), antwy% + Int(18 * fy), Int(41 * fx + vx%) + zeichenbr% * (32 - Len(mass$) - stelle|), antwy% + Int(18 * fy)
            Else
              Color RGB(0, 190, 255) ' hell blaugrün
              Box Int(41 * fx + vx%) + zeichenbr% * (28 - Len(mass$) - stelle|), Int(30 * fy + vy%) + zeichenh% * 2, Int(41 * fx + vx%) + zeichenbr% * (29 - Len(mass$) - stelle|), antwy% + Int(18 * fy)
              Color RGB(255, 255, 198) ' creme
              Line Int(42 * fx + vx%) + zeichenbr% * (28 - Len(mass$) - stelle|), antwy% + Int(18 * fy), Int(41 * fx + vx%) + zeichenbr% * (29 - Len(mass$) - stelle|), antwy% + Int(18 * fy)
            EndIf
            Color RGB(255, 0, 0) ' rot
            Box antwx% + fx - zeichenbr% * 2, antwy% + 4 * fy, antwx% - 3 * fx - zeichenbr%, antwy% + Int(18 * fy) 'Kasten
            abdecken
          Else
            hilfe| = 2
            hilferuf| = 1
            abdecken
            Color RGB(0, 0, 0) ' schwarz
            SetFont schrift1%
            Text Int(42 * fx + vx%), 300 * fy + vy%, gib$ + "als Merkzahl die erste"
            If einzelner| = 1
              Text Int(42 * fx + vx%), 325 * fy + vy%, "Ziffer deines Ergebnisses ein!"
            Else
              Text Int(42 * fx + vx%), 325 * fy + vy%, "Ziffer eures Ergebnisses ein!"
            EndIf
          EndIf
          GoTo f25
        EndIf
        If Len(ueber$) = 2 And Asc(Right$(ueber$)) = 119    ' F8-Taste
          ende| = 1
          GoTo ende45 : ' kontrolle
        EndIf
        Color RGB(255, 255, 198) ' creme
        Box antwx% + fx - zeichenbr% * 2, antwy% + 4 * fy, antwx% - 3 * fx - zeichenbr%, antwy% + Int(18 * fy) 'Kasten
        If Asc(ueber$) > 47 And Asc(ueber$) < 58
          Color RGB(200, 0, 0) ' dunkelrot
          SetFont schrift0%
          Text antwx% - zeichenbr% - 11 * fx, antwy% + 4 * fy, ueber$
          SetFont schrift3%
          Color RGB(0, 0, 0) ' schwarz
        EndIf
        If ueber$ <> Left$(xxx$)
          Inc falsch%
          Inc falsch1|
          fehler| = 1
          saeule
          abdecken
          falsch
          Color RGB(0, 0, 0) ' schwarz
          SetFont schrift1%
          Text Int(42 * fx + vx%), 300 * fy + vy%, gib$ + "als Merkzahl die erste"
          If einzelner| = 1
            Text Int(42 * fx + vx%), 325 * fy + vy%, "Ziffer deines Ergebnisses ein!"
          Else
            Text Int(42 * fx + vx%), 325 * fy + vy%, "Ziffer eures Ergebnisses ein!"
          EndIf
          Repeat
            Sleep
          Until InKey$ <> ""
          falsch_komma
          SetFont schrift3%
          Put bildx%, antwy% + 4 * fy, neu$
          GoTo neu25
        EndIf
      EndIf
      Color RGB(255, 255, 198) ' creme
      Box antwx% + fx - zeichenbr% * 2, antwy% + 4 * fy, antwx% - 3 * fx - zeichenbr%, antwy% + Int(18 * fy) 'Kasten
    EndIf
    Sub antwx%, zeichenbr%
  Until Len(eingabe_$) > Len(antwort_$)
  weiter12:
  DefLine 0, 1
  If Len(eingabe_$) < Len(antwort_$)
    If wahl| = 8
      Color RGB(0, 190, 255) ' hell blaugrün
      Box Int(41 * fx + vx%) + zeichenbr% * (30 - Len(mass$) - Len(eingabe_$)), Int(30 * fy + vy%) + zeichenh% * 2, Int(41 * fx + vx%) + zeichenbr% * (31 - Len(mass$) - Len(eingabe_$)), antwy% + Int(18 * fy)
      Color RGB(255, 255, 198) ' creme
      Line Int(42 * fx + vx%) + zeichenbr% * (30 - Len(mass$) - Len(eingabe_$)), antwy% + Int(18 * fy), Int(41 * fx + vx%) + zeichenbr% * (31 - Len(mass$) - Len(eingabe_$)), antwy% + Int(18 * fy)
    Else
      Color RGB(0, 190, 255) ' hell blaugrün
      Box Int(41 * fx + vx%) + zeichenbr% * (27 - Len(mass$) - Len(eingabe_$)), Int(30 * fy + vy%) + zeichenh% * 2, Int(41 * fx + vx%) + zeichenbr% * (28 - Len(mass$) - Len(eingabe_$)), antwy% + Int(18 * fy)
      Color RGB(255, 255, 198) ' creme
      Line Int(42 * fx + vx%) + zeichenbr% * (27 - Len(mass$) - Len(eingabe_$) ), antwy% + Int(18 * fy), Int(41 * fx + vx%) + zeichenbr% * (28 - Len(mass$) - Len(eingabe_$)), antwy% + Int(18 * fy)
    EndIf
  Else
    If wahl| = 8
      Color RGB(0, 190, 255) ' hell blaugrün
      Box Int(41 * fx + vx%) + zeichenbr% * (32 - Len(mass$) - stelle|), Int(30 * fy + vy%) + zeichenh% * 2, Int(41 * fx + vx%) + zeichenbr% * (33 - Len(mass$) - stelle|), antwy% + Int(18 * fy)
      Color RGB(255, 255, 198) ' creme
      Line Int(42 * fx + vx%) + zeichenbr% * (32 - Len(mass$) - stelle|), antwy% + Int(18 * fy), Int(41 * fx + vx%) + zeichenbr% * (33 - Len(mass$) - stelle|), antwy% + Int(18 * fy)
    Else
      Color RGB(0, 190, 255) ' hell blaugrün
      Box Int(41 * fx + vx%) + zeichenbr% * (29 - Len(mass$) - stelle|), Int(30 * fy + vy%) + zeichenh% * 2, Int(41 * fx + vx%) + zeichenbr% * (30 - Len(mass$) - stelle|), antwy% + Int(18 * fy)
      Color RGB(255, 255, 198) ' creme
      Line Int(42 * fx + vx%) + zeichenbr% * (29 - Len(mass$) - stelle|), antwy% + Int(18 * fy), Int(41 * fx + vx%) + zeichenbr% * (30 - Len(mass$) - stelle|), antwy% + Int(18 * fy)
    EndIf
  EndIf
  If Val(eingabe_$) = Val(antwort_$) And Len(eingabe_$) < Len(antwort_$)
    Inc falsch1|
    fehler| = 1
    Inc falsch%
    saeule
    abdecken
    falsch
    Color RGB(0, 0, 0) ' schwarz
    SetFont schrift1%
    If einzelner| = 1
      Text Int(42 * fx + vx%), 300 * fy + vy%, "Bis zur " + mass2$ + "-Stelle musst du Nullen eingeben!"
    Else
      Text Int(42 * fx + vx%), 300 * fy + vy%, "Bis zur " + mass2$ + "-Stelle müsst ihr Nullen eingeben!"
    EndIf
    SetFont schrift3%
    Repeat
      Sleep
    Until InKey$ <> ""
    Put bildx%, antwy% + 4 * fy, neu$
    GoTo neu25
  EndIf
  If eingabe_$ <> "" And Len(eingabe_$) < Len(antwort_$)
    abdecken
    falsch_komma
    Put bildx%, antwy% + 4 * fy, neu$
    GoTo neu25
  EndIf
  Inc richtig1%
  Clr falsch1|
  Clr fehler|
  saeule
  If zehn| = 1
    stelle| = 1
    zd$ = "10"
  Else If hundert| = 1
    stelle| = 2
    zd$ = "100"
  Else If tausend| = 1
    stelle| = 3
    zd$ = "1000"
  EndIf
  Color RGB(190, 225, 255) ' hellblau
  PBox 27 * fx + vx%, 280 * fy + vy%, 506 * fx + vx%, 360 * fy + vy%
  SetFont schrift1%
  Color RGB(0, 0, 0) ' schwarz
  If  einzelner| = 1
    Text 32 * fx + vx%, 300 * fy + vy%, "Klicke jetzt mit der Maus an die Stelle,"
  Else
    Text 32 * fx + vx%, 300 * fy + vy%, "Klickt jetzt mit der Maus an die Stelle,"
  EndIf
  If wahl| = 8
    Text 32 * fx + vx%, 325 * fy + vy%, "an der das Komma  " + Chr$(132) + mass$ + Chr$(147) + "  von  " + mass3$ + "n" + "  trennt!"
  Else If geldwahl| = 2
    Text 32 * fx + vx%, 325 * fy + vy%, "an der das Komma  " + Chr$(132) + "Euro" + Chr$(147) + "  von  " + Chr$(132) + "Cent" + Chr$(147) + "  trennt!"
  Else
    Text 32 * fx + vx%, 325 * fy + vy%, "an der das Komma  " + Chr$(132) + mass$ + Chr$(147) + "  von  " + Chr$(132) + mass1$ + Chr$(147) + "  trennt!"
  EndIf
  DefMouse 0
  Repeat
    Mouse x%, y%, k%
    PeekEvent
  Until k% <> 0
  Repeat
    PeekEvent
  Until And(_Mess = 0, InKey$ = "")
  DefMouse V:aaa%(0)        ' transparente Mausform
  If wahl| = 8
    antwx% = Int(41 * fx + vx%) + (31 - Len(mass$) - stelle|) * zeichenbr%
  Else
    antwx% = Int(41 * fx + vx%) + (28 - Len(mass$) - stelle|) * zeichenbr%
  EndIf
  Color RGB(0, 0, 0) ' schwarz
  If x% > antwx% - 4 * fx And x% < antwx% + 4 * fx And y% > antwy% + zeichenh% * 2 - 6 * fy And y% < antwy% + zeichenh% * 2 + 6 * fy
    DefLine 0, 2 * fy
    Line antwx% - fx, antwy% + zeichenh% * 2, antwx% - 2 * fx, antwy% + zeichenh% * 2 + 4 * fy  ' Komma
    DefLine 0, 1
    Inc richtig1%
    Clr falsch1|
    Clr fehler|
    saeule
  Else
    Inc falsch%
    Inc falsch1|
    fehler| = 1
    saeule
    abdecken
    falsch
    SetFont schrift1%
    Color RGB(0, 0, 0) ' schwarz
    If wahl| = 8
      Text Int(42 * fx + vx%), 300 * fy + vy%, "1 " + mass$ + " besteht aus " + zd$ + " " + Chr$(132) + mass3$ + "n" + Chr$(147) + "!"
    Else If geldwahl| = 2
      Text Int(42 * fx + vx%), 300 * fy + vy%, "1 Euro besteht aus " + zd$ + " Cent!"
    Else
      Text Int(42 * fx + vx%), 300 * fy + vy%, "1 " + mass$ + " besteht aus " + zd$ + " " + mass1$ + "!"
    EndIf
    If stelle| = 1
      Text Int(42 * fx + vx%), 325 * fy + vy%, "Deshalb wird hinter dem Komma 1 Stelle gebraucht!"
    Else
      Text Int(42 * fx + vx%), 325 * fy + vy%, "Deshalb werden hinter dem Komma " + Trim$(Str$(stelle|)) + " Stellen gebraucht!"
    EndIf
    SetFont schrift3%
    Repeat
      Sleep
    Until InKey$ <> ""
    falsch_komma
    Put bildx%, antwy% + 4 * fy, neu$
    GoTo neu25
  EndIf
  Color RGB(190, 225, 255) ' hellblau
  PBox 27 * fx + vx%, 280 * fy + vy%, 506 * fx + vx%, 360 * fy + vy%
  SetFont schrift1%
  Color RGB(0, 0, 0) ' schwarz
  If  einzelner| = 1
    Text 32 * fx + vx%, 300 * fy + vy%, "Gib jetzt die Maßeinheit ein!"
  Else
    Text 32 * fx + vx%, 300 * fy + vy%, "Gebt jetzt die Maßeinheit ein!"
  EndIf
  SetFont schrift3%
  If wahl| = 8
    antwx% = Int(42 * fx + vx%) + (32 - Len(mass$)) * zeichenbr%
  Else
    antwx% = Int(42 * fx + vx%) + (29 - Len(mass$)) * zeichenbr%
  EndIf
  antwy% = antwy% + zeichenh%
  abdecken
  Color RGB(255, 0, 0) ' rot
  Box antwx%, antwy% - 16 * fy + zeichenh%, antwx% + zeichenbr% - Ceil(2 * fx), antwy% + zeichenh%
  mass_eingeben
  If ende| = 1
    GoTo ende45
  EndIf
  SetFont schrift1%
  If eing$ <> mass$
    SetFont schrift3%
    Color RGB(255, 0, 255) ' violett
    If eing$ <> ""
      Box antwx% - Len(eing$) * zeichenbr% - fx, antwy% - 19 * fy + zeichenh%, antwx% - fx, antwy% + fy + zeichenh%
    Else
      Box antwx% - zeichenbr% - fx, antwy% - 19 * fy + zeichenh%, antwx% + zeichenbr% * 2 - fx, antwy% + fy + zeichenh%
    EndIf
    Inc falsch%
    Inc falsch1|
    fehler| = 1
    saeule
    abdecken
    falsch
    SetFont schrift1%
    Color RGB(0, 0, 0)
    Text Int(42 * fx + vx%), 300 * fy + vy%, "Die richtige Maßangabe heißt " + Chr$(132) + mass$ + Chr$(147) + ","
    Text Int(42 * fx + vx%), 325 * fy + vy%, "sie gehört zur Zahl vor dem Komma!"
    SetFont schrift3%
    Repeat
      Sleep
    Until InKey$ <> ""
    DefLine 0, 1
    antwy% = antwy% - zeichenh%
    falsch_komma
    Put bildx%, antwy% + 4 * fy, neu$
    GoTo neu25
  EndIf
  ende45:
Return
>Procedure hilfe_sub
'##B#
  x% = 135 * fx + vx%
  Color RGB(0, 0, 0) ' schwarz
  Text Int(42 * fx + vx%), 300 * fy + vy%, rechne$ + ":"
  If uebertrag%(stelle| - 1) > 0
    Color RGB(200, 0, 0) ' dunkelrot
    Text x%, 300 * fy + vy%, Left$(Trim$(Str$(uebertrag%(stelle| - 1))))
    SetFont schrift0%
    Text antwx% - 11 * fx, antwy% + 4 * fy, Left$(Trim$(Str$(uebertrag%(stelle| - 1))))
    SetFont schrift1%
    Add x%, TxtLen(Left$(Trim$(Str$(uebertrag%(stelle| - 1)))))
    Color RGB(0, 0, 0) ' schwarz
    Text x%, 300 * fy + vy%, " + "
    Add x%, TxtLen(" + ")
  Else If Len(antwort3_$) < stelle| And Len(antwort2_$) < stelle|
    Text x%, 300 * fy + vy%, "0 + "
    Add x%, TxtLen("0 + ")
  EndIf
  If Len(antwort3_$) >= stelle|
    Text x%, 300 * fy + vy%, Mid$(antwort3_$, Len(antwort3_$) + 1 - stelle|, 1) + " + "
    Add x%, TxtLen(Mid$(antwort3_$, Len(antwort3_$) + 1 - stelle|, 1) + " + ")
  EndIf
  If Len(antwort2_$) >= stelle|
    Text x%, 300 * fy + vy%, Mid$(antwort2_$, Len(antwort2_$) + 1 - stelle|, 1) + " + "
    Add x%, TxtLen(Mid$(antwort2_$, Len(antwort2_$) + 1 - stelle|, 1) + " + ")
  EndIf
  If x% = 135 * fx + vx%
    Text x%, 300 * fy + vy%, "0 + "
    Add x%, TxtLen("0 + ")
  EndIf
  Color RGB(255, 0, 0) ' rot
'##B#
  Box x% + 2 * fx, 303 * fy + vy%, x% + zeichenbr% - 2 * fx, 316 * fy + vy%
  Add x%, 10 * fx + TxtLen(" ")
  Color RGB(0, 0, 0) ' schwarz
  Text x%, 300 * fy + vy%, " = " + z_$
  DefLine 0, 1
  If wahl| = 8
    Color RGB(0, 190, 255) ' hell blaugrün
    Box Int(41 * fx + vx%) + zeichenbr% * (32 - Len(mass$) - stelle|), Int(30 * fy + vy%) + zeichenh% * 2, Int(41 * fx + vx%) + zeichenbr% * (33 - Len(mass$) - stelle|), antwy% + Int(18 * fy)
    Color RGB(255, 255, 198) ' creme
    Line Int(42 * fx + vx%) + zeichenbr% * (32 - Len(mass$) - stelle|), antwy% + Int(18 * fy), Int(41 * fx + vx%) + zeichenbr% * (33 - Len(mass$) - stelle|), antwy% + Int(18 * fy)
    Color RGB(255, 0, 0) ' rot
    Box Int(41 * fx + vx%) + zeichenbr% * (31 - Len(mass$) - stelle|), Int(30 * fy + vy%) + zeichenh% * 2, Int(41 * fx + vx%) + zeichenbr% * (32 - Len(mass$) - stelle|), antwy% + Int(18 * fy)
  Else
    Color RGB(0, 190, 255) ' hell blaugrün
    Box Int(41 * fx + vx%) + zeichenbr% * (29 - Len(mass$) - stelle|), Int(30 * fy + vy%) + zeichenh% * 2, Int(41 * fx + vx%) + zeichenbr% * (30 - Len(mass$) - stelle|), antwy% + Int(18 * fy)
    Color RGB(255, 255, 198) ' creme
    Line Int(42 * fx + vx%) + zeichenbr% * (29 - Len(mass$) - stelle|), antwy% + Int(18 * fy), Int(41 * fx + vx%) + zeichenbr% * (30 - Len(mass$) - stelle|), antwy% + Int(18 * fy)
    Color RGB(255, 0, 0) ' rot
    Box Int(41 * fx + vx%) + zeichenbr% * (28 - Len(mass$) - stelle|), Int(30 * fy + vy%) + zeichenh% * 2, Int(41 * fx + vx%) + zeichenbr% * (29 - Len(mass$) - stelle|), antwy% + Int(18 * fy)
  EndIf
Return
>Procedure masse_mul                ' Kommazahlen multiplizieren
  bildx1% = Int(42 * fx + vx%) + zeichenbr% * 4
  bildy% = Int(33 * fy + vy%) + zeichenh% * 5
  neu17:
  Put bildx1%, bildy%, neu$
  Color RGB(255, 255, 198) ' creme
  For i% = Int(41 * fx + vx%) + zeichenbr% * (18 - Len(zb$ + za$)) To Int(41 * fx + vx%) + zeichenbr% * 18 Step zeichenbr%
    PBox i% + Int(fx), Int(29 * fy + vy%) + zeichenh% * 5 + Int(2 * fy), i% + zeichenbr% - Int(fx), Int(29 * fy + vy%) + zeichenh% * 6 - Ceil(2 * fy)
  Next i%
  abdecken
  Clr stelle_a|, stelle_b|
  For i% = 0 To 9
    teilantwort$(i%) = ""
  Next i%
  antwort% = a% * b%
  If zehn| = 1 And antwort% < 10
    antwort_$ = Right$(Trim$(Str$(100 + antwort%)), 2)
  Else If hundert| = 1 And antwort% < 100
    antwort_$ = Right$(Trim$(Str$(1000 + antwort%)), 3)
  Else If tausend| = 1 And antwort% < 1000
    antwort_$ = Right$(Trim$(Str$(10000 + antwort%)), 4)
  Else
    antwort_$ = Trim$(Str$(antwort%))
  EndIf
  antwy% = Int(29 * fy + vy%) + zeichenh% * 4
  SetFont schrift3%
  Color RGB(0, 0, 0) ' schwarz
  Text Int(41 * fx + vx%) + zeichenbr% * (16 - Len(za$) - Len(zb$)), antwy%, za$ + " · " + zb$
  Line Int(41 * fx + vx%) + zeichenbr% * (16 - Len(za$) - Len(zb$)), antwy% + fy + zeichenh%, Int(41 * fx + vx%) + zeichenbr% * 19, antwy% + fy + zeichenh%
  DefLine 0, 2 * fy
  Line Int(41 * fx + vx%) + zeichenbr% * (16 - Len(zb$) - stelle|), antwy% + zeichenh%, Int(41 * fx + vx%) + zeichenbr% * (16 - Len(zb$) - stelle|) - 2 * fx, antwy% + 4 * fy + zeichenh%    ' Komma
  DefLine 0, 1
  Repeat
    PeekEvent
    Clr eingabe_$
    Inc stelle_b|
    antwx% = Int(41 * fx + vx%) + zeichenbr% * (19 - Len(zb$) + stelle_b|)
    teilantwort$(stelle_b|) = Trim$(Str$(a% * Val(Mid$(zb$, stelle_b|, 1))))
    If zehn| = 1 And Val(teilantwort$(stelle_b|)) < 10 And Val(teilantwort$(stelle_b|)) > 0
      teilantwort$(stelle_b|) = Right$(Trim$(Str$(100 + Val(teilantwort$(stelle_b|)))), 2)
    Else If hundert| = 1 And antwort% < 100 And Val(teilantwort$(stelle_b|)) > 0
      teilantwort$(stelle_b|) = Right$(Trim$(Str$(1000 + Val(teilantwort$(stelle_b|)))), 3)
    Else If tausend| = 1 And antwort% < 1000 And Val(teilantwort$(stelle_b|)) > 0
      teilantwort$(stelle_b|) = Right$(Trim$(Str$(10000 + Val(teilantwort$(stelle_b|)))), 4)
    EndIf
    If fehlermal| = 0
      ArrayFill uebertrag%(), 0
    Else
      Clr fehlermal|
    EndIf
    Repeat
      PeekEvent
      Inc stelle_a|
      If stelle_a| <= Len(teilantwort$(stelle_b|))
        Color RGB(255, 0, 0) ' rot
        Box antwx% - fx, antwy% + 4 * fy + zeichenh%, antwx% + fx - zeichenbr%, antwy% + zeichenh% * 2 ' Kursor
      EndIf
      f26:
      If hilfe| = 2 Or falsch1| > 0
        Color RGB(255, 0, 0) ' rot
        Box Int(41 * fx + vx%) + zeichenbr% * (18 - Len(zb$) + stelle_b|), Int(30 * fy + vy%) + zeichenh% * 4, Int(41 * fx + vx%) + zeichenbr% * (19 - Len(zb$) + stelle_b|), Int(30 * fy + vy%) + zeichenh% * 5
        Box Int(41 * fx + vx%) + zeichenbr% * (16 - Len(zb$) - stelle_a|), Int(30 * fy + vy%) + zeichenh% * 4, Int(41 * fx + vx%) + zeichenbr% * (17 - Len(zb$) - stelle_a|), Int(30 * fy + vy%) + zeichenh% * 5
      EndIf
      Repeat
        Sleep
        antw$ = InKey$
      Until Asc(antw$) > 47 And Asc(antw$) < 58 Or (Len(antw$) = 2 And (Asc(Right$(antw$)) = 119 Or Asc(Right$(antw$)) = 112)) Or antw$ = Chr$(13)
      abdecken
      If Len(antw$) = 2 And Asc(Right$(antw$)) = 119          ' F8-Taste
        ende| = 1
        GoTo ende47
      EndIf
      If Len(antw$) = 2 And Asc(Right$(antw$)) = 112                ' F1-Taste
        If hilfe| = 2
          hilfe| = 1
          DefLine 0, 1
          Color RGB(0, 190, 255) ' hell blaugrün
          Box Int(41 * fx + vx%) + zeichenbr% * (18 - Len(zb$) + stelle_b|), Int(30 * fy + vy%) + zeichenh% * 4, Int(41 * fx + vx%) + zeichenbr% * (19 - Len(zb$) + stelle_b|), Int(30 * fy + vy%) + zeichenh% * 5
          Box Int(41 * fx + vx%) + zeichenbr% * (16 - Len(zb$) - stelle_a|), Int(30 * fy + vy%) + zeichenh% * 4, Int(41 * fx + vx%) + zeichenbr% * (17 - Len(zb$) - stelle_a|), Int(30 * fy + vy%) + zeichenh% * 5
          Color RGB(0, 0, 0) ' schwarz
          Line Int(41 * fx + vx%) + zeichenbr% * (18 - Len(zb$) + stelle_b|), Int(30 * fy + vy%) + zeichenh% * 5, Int(41 * fx + vx%) + zeichenbr% * (19 - Len(zb$) + stelle_b|), Int(30 * fy + vy%) + zeichenh% * 5
          If stelle_a| <= Len(za$)
            Line Int(41 * fx + vx%) + zeichenbr% * (16 - Len(zb$) - stelle_a|), Int(30 * fy + vy%) + zeichenh% * 5, Int(41 * fx + vx%) + zeichenbr% * (17 - Len(zb$) - stelle_a|), Int(30 * fy + vy%) + zeichenh% * 5
          EndIf
        Else
          hilfe| = 2
          hilferuf| = 1
        EndIf
        GoTo f26
      EndIf
      If antw$ = Chr$(13)                      ' Return
        If eingabe_$ = "" And stelle_b| < 2
          GoTo weiter3
        Else
          GoTo neu17
        EndIf
      EndIf
      If hilfe| = 2 Or falsch1| > 0
        DefLine 0, 1
        Color RGB(0, 190, 255) ' hell blaugrün
        Box Int(41 * fx + vx%) + zeichenbr% * (18 - Len(zb$) + stelle_b|), Int(30 * fy + vy%) + zeichenh% * 4, Int(41 * fx + vx%) + zeichenbr% * (19 - Len(zb$) + stelle_b|), Int(30 * fy + vy%) + zeichenh% * 5
        Box Int(41 * fx + vx%) + zeichenbr% * (16 - Len(zb$) - stelle_a|), Int(30 * fy + vy%) + zeichenh% * 4, Int(41 * fx + vx%) + zeichenbr% * (17 - Len(zb$) - stelle_a|), Int(30 * fy + vy%) + zeichenh% * 5
        Color RGB(0, 0, 0) ' schwarz
        Line Int(41 * fx + vx%) + zeichenbr% * (18 - Len(zb$) + stelle_b|), Int(30 * fy + vy%) + zeichenh% * 5, Int(41 * fx + vx%) + zeichenbr% * (19 - Len(zb$) + stelle_b|), Int(30 * fy + vy%) + zeichenh% * 5
        If stelle_a| <= Len(za$)
          Line Int(41 * fx + vx%) + zeichenbr% * (16 - Len(zb$) - stelle_a|), Int(30 * fy + vy%) + zeichenh% * 5, Int(41 * fx + vx%) + zeichenbr% * (17 - Len(zb$) - stelle_a|), Int(30 * fy + vy%) + zeichenh% * 5
        EndIf
      EndIf
      Color RGB(255, 255, 198) ' creme
      Box antwx% - fx, antwy% + 4 * fy + zeichenh%, antwx% + fx - zeichenbr%, antwy% + zeichenh% * 2
      Color RGB(0, 0, 0) ' schwarz
      abfrage
      If ende| = 1
        GoTo ende47
      EndIf
      If Right$(eingabe_$, stelle_a|) <> Right$(teilantwort$(stelle_b|), stelle_a|)
        Inc falsch%
        Inc falsch1|
        fehler| = 1
        saeule
        abdecken
        falsch
        Color RGB(255, 0, 0) ' rot
        Box Int(41 * fx + vx%) + zeichenbr% * (18 - Len(zb$) + stelle_b|), Int(30 * fy + vy%) + zeichenh% * 4, Int(41 * fx + vx%) + zeichenbr% * (19 - Len(zb$) + stelle_b|), Int(30 * fy + vy%) + zeichenh% * 5
        Box Int(41 * fx + vx%) + zeichenbr% * (16 - Len(zb$) - stelle_a|), Int(30 * fy + vy%) + zeichenh% * 4, Int(41 * fx + vx%) + zeichenbr% * (17 - Len(zb$) - stelle_a|), Int(30 * fy + vy%) + zeichenh% * 5
        SetFont schrift1%
        If uebertrag%(stelle_a| - 1) = 0
          Color RGB(0, 0, 0) ' schwarz
          r$ = rechne$ + ":     " + Trim$(Str$(Val(Mid$(zb$, stelle_b|, 1)))) + " · " + Trim$(Str$(Val(Mid$(za$, Len(za$) - stelle_a| + 1, 1)))) + " = "
          Text Int(42 * fx + vx%), 300 * fy + vy%, r$
          Color RGB(255, 0, 0) ' rot
          Box Int(42 * fx + vx%) + TxtLen(r$), 303 * fy + vy%, 50 * fx + vx% + TxtLen(r$), 316 * fy + vy%
          Color RGB(0, 0, 0) ' schwarz
          Text Int(42 * fx + vx%), 350 * fy + vy%, gib$ + "nur die letzte Ziffer des Ergebnisses ein!"
        Else
          If stelle_a| <= Len(za$)
            r$ = rechne$ + ":     " + Trim$(Str$(Val(Mid$(zb$, stelle_b|, 1)))) + " · " + Trim$(Str$(Val(Mid$(za$, Len(za$) - stelle_a| + 1, 1)))) + " + "
          Else
            r$ = rechne$ + ":     " + Trim$(Str$(Val(Mid$(zb$, stelle_b|, 1)))) + " · " + "0" + " + "
          EndIf
          Color RGB(0, 0, 0) ' schwarz
          Text Int(42 * fx + vx%), 300 * fy + vy%, r$
          Color RGB(200, 0, 0) ' dunkelrot
          Text Int(42 * fx + vx%) + TxtLen(r$), 300 * fy + vy%, Trim$(Str$(uebertrag%(stelle_a| - 1)))
          Color RGB(0, 0, 0) ' schwarz
          r$ = r$ + Trim$(Str$(uebertrag%(stelle_a| - 1)))
          Text Int(42 * fx + vx%) + TxtLen(r$), 300 * fy + vy%, " = "
          Text Int(42 * fx + vx%), 350 * fy + vy%, gib$ + "nur die letzte Ziffer des Ergebnisses ein!"
          Color RGB(255, 0, 0) ' rot
          Box Int(42 * fx + vx%) + TxtLen(r$) + TxtLen(" = "), 303 * fy + vy%, 50 * fx + vx% + TxtLen(r$) + TxtLen(" = "), 316 * fy + vy%
        EndIf
        Inc fehlermal|
        SetFont schrift3%
        Repeat
          Sleep
        Until InKey$ <> ""
        DefLine 0, 1
        Color RGB(0, 190, 255) ' hell blaugrün
        Box Int(41 * fx + vx%) + zeichenbr% * (18 - Len(zb$) + stelle_b|), Int(30 * fy + vy%) + zeichenh% * 4, Int(41 * fx + vx%) + zeichenbr% * (19 - Len(zb$) + stelle_b|), Int(30 * fy + vy%) + zeichenh% * 5
        Box Int(41 * fx + vx%) + zeichenbr% * (16 - Len(zb$) - stelle_a|), Int(30 * fy + vy%) + zeichenh% * 4, Int(41 * fx + vx%) + zeichenbr% * (17 - Len(zb$) - stelle_a|), Int(30 * fy + vy%) + zeichenh% * 5
        Color RGB(0, 0, 0) ' schwarz
        Line Int(41 * fx + vx%) + zeichenbr% * (18 - Len(zb$) + stelle_b|), Int(30 * fy + vy%) + zeichenh% * 5, Int(41 * fx + vx%) + zeichenbr% * (19 - Len(zb$) + stelle_b|), Int(30 * fy + vy%) + zeichenh% * 5
        Line Int(41 * fx + vx%) + zeichenbr% * (16 - Len(zb$) - stelle_a|), Int(30 * fy + vy%) + zeichenh% * 5, Int(41 * fx + vx%) + zeichenbr% * (17 - Len(zb$) - stelle_a|), Int(30 * fy + vy%) + zeichenh% * 5
        GoTo neu17
      EndIf
      xxx$ = Trim$(Str$(Val(Right$(za$, stelle_a|)) * Val(Mid$(zb$, stelle_b|, 1))))
      If Len(xxx$) > stelle_a|
        uebertrag%(stelle_a|) = Val(Left$(xxx$))
        If hilfe| = 2 Or falsch1| > 0 Or uebertr| = 2
          SetFont schrift0%
          Color RGB(200, 0, 0) ' dunkelrot
          Text antwx% - 11 * fx - zeichenbr%, antwy% + fy + zeichenh% * 2, Left$(xxx$)
          Color RGB(0, 0, 0) ' schwarz
          SetFont schrift3%
        EndIf
      EndIf
      Sub antwx%, zeichenbr%
    Until Len(eingabe_$) = Len(teilantwort$(stelle_b|))
    Clr stelle_a|
    If Mid$(zb$, stelle_b| + 1, 1) <> "0"
      Add antwy%, zeichenh%
      Color RGB(255, 255, 198) ' creme
      For i% = antwx% + zeichenbr% * 9 + fx To antwx% - zeichenbr% * 7 + fx Step -zeichenbr%
        PBox i%, antwy% + Ceil(2 * fy) + zeichenh%, i% + zeichenbr% - 2 * fx, antwy% + zeichenh% * 2
      Next i%
    Else
      Color RGB(255, 255, 198) ' creme
      For i% = antwx% + zeichenbr% * 9 + fx To antwx% - zeichenbr% * 7 + fx Step -zeichenbr%
        PBox i%, antwy% + Ceil(2 * fy) + zeichenh% * 2, i% + zeichenbr% - 2 * fx, antwy% + zeichenh% * 3
      Next i%
    EndIf
  Until stelle_b| = Len(zb$)
  antwx% = Int(41 * fx + vx%) + zeichenbr% * 19
  If antwy% < Int(30 * fy + vy%) + zeichenh% * 5          ' Null am Ende von zb$ oder zb$ einstellig
    antwy% = antwy% - zeichenh%
    If Len(zb$) > 1 And Right$(zb$) = "0"
      Color RGB(0, 0, 0)
      eingabe_$ = teilantwort$(1)
      For i% = 1 To Len(zb$) - 1
        eingabe_$ = eingabe_$ + "0"
      Next i%
      Repeat
        Sleep
        ink$ = InKey$
      Until ink$ = Chr$(13)
      GoTo weiter3
    EndIf
    f27:
    Repeat
      Sleep
      antw$ = InKey$
    Until Asc(antw$) > 47 And Asc(antw$) < 58 Or (Len(antw$) = 2 And (Asc(Right$(antw$)) = 119 Or Asc(Right$(antw$)) = 112)) Or antw$ = Chr$(13)
    If Len(antw$) = 2 And Asc(Right$(antw$)) = 112
      If hilfe| = 2
        hilfe| = 1
      Else
        hilfe| = 2
        hilferuf| = 1
      EndIf
      GoTo f27
    EndIf
    If Len(antw$) = 2 And Asc(Right$(antw$)) = 119
      ende| = 1
      GoTo ende47
    EndIf
    abdecken
    If antw$ <> Chr$(13)
      falsch
      If antw$ = "0"
        Text Int(42 * fx + vx%), 300 * fy + vy%, richt$
        Text Int(42 * fx + vx%), 325 * fy + vy%, "Null vor dem Ergebnis weg!"
        Repeat
          Sleep
        Until InKey$ <> ""
      Else
        Inc falsch%
        Inc falsch1|
        fehler| = 1
        saeule
        SetFont schrift1%
        Color RGB(0, 0, 0) ' schwarz
        Text Int(42 * fx + vx%), 300 * fy + vy%, du$ + "zu weit gerechnet!"
        SetFont schrift3%
        Repeat
          Sleep
        Until InKey$ <> ""
        GoTo neu17
      EndIf
      SetFont schrift3%
    EndIf
  Else If antw$ <> Chr$(13)                   ' keine Null am Ende von zb$
    Color RGB(0, 0, 0) ' schwarz
    Line Int(41 * fx + vx%) + zeichenbr% * 16 - TxtLen(za$) - TxtLen(zb$), antwy% + fy + zeichenh%, Int(42 * fx + vx%) + zeichenbr% * 19, antwy% + fy + zeichenh%
    Clr eingabe_$
    Clr stelle_a|
    ArrayFill uebertrag%(), 0
    For i% = 1 To Len(zb$)
      teilantwort$(Len(zb$) + 1 - i%) = Trim$(Str$(Val(teilantwort$(Len(zb$) + 1 - i%)) * 10 ^ (i% - 1)))
    Next i%
    Repeat                                              ' Addieren der Ergebnisse
      PeekEvent
      Inc stelle_a|
      If stelle_a| <= Len(antwort_$)
        Color RGB(255, 0, 0) ' rot
        Box antwx% - Int(fx), antwy% + 4 * fy + zeichenh%, antwx% + Int(fx) - zeichenbr%, antwy% + zeichenh% * 2 ' Kursor
      EndIf
      f28:
      If hilfe| = 2
        SetFont schrift1%
        abdecken
        Color RGB(0, 0, 0) ' schwarz
        If einzelner| = 1
          Text Int(42 * fx + vx%), 300 * fy + vy%, "Addiere die Zahlen und gib die"
        Else
          Text Int(42 * fx + vx%), 300 * fy + vy%, "Addiert die Zahlen und gebt die"
        EndIf
        Text Int(42 * fx + vx%), 325 * fy + vy%, "letzte Ziffer des Ergebnisses ein!"
        SetFont schrift3%
      EndIf
      Repeat
        Sleep
        antw$ = InKey$
      Until Asc(antw$) > 47 And Asc(antw$) < 58 Or (Len(antw$) = 2 And (Asc(Right$(antw$)) = 119 Or Asc(Right$(antw$)) = 112)) Or antw$ = Chr$(13)
      If Len(antw$) = 2 And Asc(Right$(antw$)) = 112
        If hilfe| = 2
          hilfe| = 1
          abdecken
        Else
          hilfe| = 2
          hilferuf| = 1
        EndIf
        GoTo f28
      EndIf
      If antw$ = Chr$(13)                            ' Return
        If (eingabe_$ = "" And stelle_b| < 2) Or Len(eingabe_$) >= Len(antwort_$)
          GoTo weiter3
        Else
          Inc falsch%
          Inc falsch1|
          fehler| = 1
          saeule
          GoTo neu17
        EndIf
      EndIf
      Color RGB(0, 0, 0) ' schwarz
      abfrage
      If ende| = 1
        GoTo ende47
      EndIf
      If Len(eingabe_$) <= Len(antwort_$)
        If Right$(eingabe_$, stelle_a|) <> Right$(antwort_$, stelle_a|)
          abdecken
          Color RGB(255, 0, 0) ' rot
          Box antwx% - zeichenbr%, antwy% + Int(fy) + zeichenh%, antwx%, Int(30 * fy + vy%) + zeichenh% * 5
          Inc falsch%
          Inc falsch1|
          fehler| = 1
          saeule
          falsch
          SetFont schrift1%
          Color RGB(0, 0, 0) ' schwarz
          If einzelner| = 1
            Text Int(42 * fx + vx%), 300 * fy + vy%, "Addiere die eingerahmten Zahlen und gib"
          Else
            Text Int(42 * fx + vx%), 300 * fy + vy%, "Addiert die eingerahmten Zahlen und gebt"
          EndIf
          Text Int(42 * fx + vx%), 325 * fy + vy%, "die letzte Ziffer des Ergebnisses ein!"
          If uebertrag%(stelle_a| - 1) <> 0
            SetFont schrift0%
            Color RGB(200, 0, 0) ' dunkelrot
            Text antwx% - 11 * fx, antwy% + Int(fy) + zeichenh% * 2, Trim$(Str$(uebertrag%(stelle_a| - 1)))
            Color RGB(255, 0, 0) ' rot
            Box antwx% - zeichenbr% - Int(fx), antwy% + Int(fy) + zeichenh% * 2, antwx% - Int(fx), antwy% + Int(fy) + zeichenh% * 3
            Color RGB(0, 0, 0) ' schwarz
          EndIf
          SetFont schrift3%
          Inc fehlermal|
          Repeat
            Sleep
          Until InKey$ <> ""
          DefLine 0, 1
          Color RGB(0, 190, 255) ' hell blaugrün
          Box antwx% - zeichenbr% - Int(fx), antwy% + Int(fy) + zeichenh%, antwx% - Int(fx), Int(30 * fy) + zeichenh% * 5
          Color RGB(255, 255, 198) ' creme
          Line antwx% - zeichenbr%, 31 * fy  + vy% + zeichenh% * 5, antwx% - Int(fx), 31 * fy + vy% + zeichenh% * 5
          GoTo neu17
        EndIf
        Clr xxx$
        For i% = 1 To Len(zb$)
          xxx$ = Trim$(Str$(Val(xxx$) + Val(Right$(teilantwort$(i%), stelle_a|))))
        Next i%
        If Len(xxx$) > stelle_a|
          uebertrag%(stelle_a|) = Val(Left$(xxx$))
          If hilfe| = 2 Or falsch1| > 0 Or uebertr| = 2
            SetFont schrift0%
            Color RGB(200, 0, 0) ' dunkelrot
            Text antwx% - 11 * fx - zeichenbr%, antwy% + Int(fy) + zeichenh% * 2, Trim$(Str$(uebertrag%(stelle_a|)))
            Color RGB(0, 0, 0) ' schwarz
            SetFont schrift3%
          EndIf
        EndIf
      EndIf
      Sub antwx%, zeichenbr%
      If (hilfe| = 2 Or falsch1| > 0 Or uebertr| = 2) And Len(eingabe_$) = Len(antwort_$)
        Color RGB(255, 255, 198) ' creme
        For i% = antwx% + zeichenbr% * 9 + fx To antwx% - zeichenbr% * 7 + fx Step -zeichenbr%
          PBox i%, antwy% + Ceil(2 * fy) + zeichenh% * 2, i% + zeichenbr% - 2 * fx, antwy% + zeichenh% * 3
        Next i%
      EndIf
    Until Len(eingabe_$) > Len(antwort_$)
    weiter3:
    If Len(eingabe_$) > Len(antwort_$)
      SetFont schrift1%
      abdecken
      If Left$(eingabe_$) = "0" And Len(Trim$(Str$(antwort%))) = Len(antwort_$)
        falsch
        Color RGB(0, 0, 0) ' schwarz
        SetFont schrift1%
        Text Int(42 * fx + vx%), 300 * fy + vy%, richt$
        Text Int(42 * fx + vx%), 325 * fy + vy%, "Null vor dem Ergebnis weg!"
        SetFont schrift3%
        Repeat
          Sleep
        Until InKey$ <> ""
      Else If Len(Trim$(Str$(antwort%))) = Len(antwort_$)
        Inc falsch%
        Inc falsch1|
        fehler| = 1
        saeule
        falsch
        Color RGB(0, 0, 0) ' schwarz
        SetFont schrift1%
        Text Int(42 * fx + vx%), 300 * fy + vy%, du$ + "zu weit gerechnet!"
        SetFont schrift3%
        Repeat
          Sleep
        Until InKey$ <> ""
        GoTo neu17
      EndIf
    EndIf
  EndIf
  If zehn| = 1
    stelle| = 1
    zd$ = "10"
  Else If hundert| = 1
    stelle| = 2
    zd$ = "100"
  Else If tausend| = 1
    stelle| = 3
    zd$ = "1000"
  EndIf
  abdecken
  Color RGB(190, 225, 255) ' hellblau
  PBox 27 * fx + vx%, 280 * fy + vy%, 506 * fx + vx%, 360 * fy + vy%
  SetFont schrift1%
  Color RGB(0, 0, 0) ' schwarz
  If  einzelner| = 1
    Text 32 * fx + vx%, 300 * fy + vy%, "Klicke jetzt mit der Maus an die Stelle,"
  Else
    Text 32 * fx + vx%, 300 * fy + vy%, "Klickt jetzt mit der Maus an die Stelle,"
  EndIf
  If wahl| = 8
    Text 32 * fx + vx%, 325 * fy + vy%, "an der das Komma  " + Chr$(132) + mass$ + Chr$(147) + "  von  " + mass3$ + "n" + "  trennt!"
  Else
    If geldwahl| = 2
      Text 32 * fx + vx%, 325 * fy + vy%, "an der das Komma  " + Chr$(132) + "Euro" + Chr$(147) + "  von  " + Chr$(132) + "Cent" + Chr$(147) + "  trennt!"
    Else
      Text 32 * fx + vx%, 325 * fy + vy%, "an der das Komma  " + Chr$(132) + mass$ + Chr$(147) + "  von  " + Chr$(132) + mass1$ + Chr$(147) + "  trennt!"
    EndIf
  EndIf
  DefMouse 0
  Repeat
    Mouse x%, y%, k%
    PeekEvent
  Until k% <> 0
  Repeat
    Mouse x%, y%, k%
    PeekEvent
  Until And(_Mess = 0, InKey$ = "", k% = 0)
  DefMouse V:aaa%(0)        ' transparente Mausform
  antwx% = Int(41 * fx + vx%) + (19 - stelle|) * zeichenbr%
  Color RGB(0, 0, 0) ' schwarz
  If x% > antwx% - 4 * fx And x% < antwx% + 4 * fx And y% > antwy% + zeichenh% * 2 - 6 * fy And y% < antwy% + zeichenh% * 2 + 6 * fy
    DefLine 0, 2 * fy
    Line antwx% - fx, antwy% + zeichenh% * 2, antwx% - 2 * fx, antwy% + zeichenh% * 2 + 4 * fy  ' Komma
    DefLine 0, 1
  Else
    Inc falsch%
    Inc falsch1|
    fehler| = 1
    saeule
    abdecken
    falsch
    SetFont schrift1%
    Color RGB(0, 0, 0) ' schwarz
    If wahl| = 8
      Text Int(42 * fx + vx%), 300 * fy + vy%, "1 " + mass$ + " besteht aus " + zd$ + " " + Chr$(132) + mass3$ + "n" + Chr$(147) + "!"
    Else If geldwahl| = 2
      Text Int(42 * fx + vx%), 300 * fy + vy%, "1 Euro besteht aus " + zd$ + " Cent!"
    Else
      Text Int(42 * fx + vx%), 300 * fy + vy%, "1 " + mass$ + " besteht aus " + zd$ + " " + mass1$ + "!"
    EndIf
    If stelle| = 1
      Text Int(42 * fx + vx%), 325 * fy + vy%, "Deshalb wird hinter dem Komma 1 Stelle gebraucht!"
    Else
      Text Int(42 * fx + vx%), 325 * fy + vy%, "Deshalb werden hinter dem Komma " + Trim$(Str$(stelle|)) + " Stellen gebraucht!"
    EndIf
    SetFont schrift3%
    Repeat
      Sleep
    Until InKey$ <> ""
    falsch_komma
    GoTo neu17
  EndIf
  Repeat
    Sleep
    ink$ = InKey$
  Until ink$ = Chr$(13)
  ende47:
Return
>Procedure masse_div                ' Kommazahlen dividieren
  Clr rest50%, rest_$
  bildx1% = Int(42 * fx + vx%) - zeichenbr%
  bildy% = Int(33 * fy + vy%) + zeichenh% * 5
  antwort% = Div(a%, b%)
  rest% = a% - b% * antwort%
  If zehn| = 1 And antwort% < 10
    antwort_$ = Right$(Trim$(Str$(100 + antwort%)), 2)
  Else If hundert| = 1 And antwort% < 100
    antwort_$ = Right$(Trim$(Str$(1000 + antwort%)), 3)
  Else If tausend| = 1 And antwort% < 1000
    antwort_$ = Right$(Trim$(Str$(10000 + antwort%)), 4)
  Else
    antwort_$ = Trim$(Str$(antwort%))
  EndIf
  neu18:
  Clr eingabe_$, rest_$
  Clr stelle_b|, textl%, linie%
  For i% = 1 To 27
    lin%(i%) = 0
  Next i%
  antwx% = Int(41 * fx + vx%) + zeichenbr% * (5 + Len(za$ + zb$))
  antwy% = Int(29 * fy + vy%) + zeichenh% * 4
  antwy1% = antwy% + zeichenh%
  Put bildx1%, bildy%, neu$
  Put Int(42 * fx + vx%) + (5 + Len(za$ + zb$)) * zeichenbr%, Int(33 * fy + vy%) + zeichenh% * 3, neu$
  Put Int(42 * fx + vx%) + 17 * zeichenbr%, Int(33 * fy + vy%) + zeichenh% * 3, neu$
  Color RGB(255, 255, 198) ' creme
  PRBox 38 * fx + vx%, 31 * fy + vy% + 11 * zeichenh%, 510 * fx + vx%, 464 * fy + vy%     ' genaue Textabdeckung unter Rechenhäuschen
  PBox 43 * fx + vx% + 32 * zeichenbr%, Int(29 * fy + vy%) + zeichenh% * 4, 550 * fx + vx%, 33 * fy + vy% + zeichenh% * 5     ' Abdeckung Rest 100 m-Stücke
  DefLine 0, 1
  Color RGB(0, 190, 255) ' hell blaugrün
  Line 11 * fx + vx%, Int(30 * fy + vy%) + 11 * zeichenh%, zeichenbr% * 32 + Int(41 * fx + vx%), Int(30 * fy + vy%) + 11 * zeichenh%   ' Rechenlinie waagerecht
  saeule
  Color RGB(0, 0, 0) ' schwarz
  Text Int(41 * fx + vx%), antwy%, za$ + " : " + zb$ + " = "
  DefLine 0, 2 * fy
  Line Int(41 * fx + vx%) + zeichenbr% * (Len(za$) - stelle|), antwy% + zeichenh%, Int(41 * fx + vx%) + zeichenbr% * (Len(za$) - stelle|) - 2 * fx, antwy% + 4 * fy + zeichenh%    ' Komma
  DefLine 0, 1
  Clr teil$, komm%
  fnull:
  Repeat                                                       'Teilen #############################
    PeekEvent
    Inc komm%
    teil$ = teil$ + Mid$(za$, komm%, 1)
  Until Val(teil$) >= Val(zb$) Or Len(za$) - komm% = stelle| Or (Mid$(antwort_$, komm%, 1) = "0" And Len(za$) = Len(antwort_$)) Or Len(eingabe_$) = Len(antwort_$)
  If Len(antwort_$) = Len(eingabe_$)
    GoTo f34
  EndIf
  stelle_a| = Len(teil$)
  Repeat
    PeekEvent
    Inc stelle_b|
    antwx1% = Int(41 * fx + vx%) + stelle_a| * zeichenbr%
    Add antwx%, zeichenbr%
    If Len(za$) - komm% = stelle| - 1        ' Platz für das Komma
      Color RGB(255, 255, 198) ' creme
      PRBox 38 * fx + vx%, 374 * fy + vy%, 510 * fx + vx%, 464 * fy + vy%     ' Textabdeckung
      DefMouse 0
      neukomma:
      Clr ze$
      Repeat
        Sleep
        Mouse x%, y%, k%
        ze$ = InKey$
      Until k% <> 0 Or ze$ = "," Or (Len(Asc(ze$)) = 2 And (Asc(Right$(ze$)) = 112 Or Asc(Right$(ze$)) = 119))
      Color RGB(255, 255, 198) ' creme
      PRBox 38 * fx + vx%, 374 * fy + vy%, 510 * fx + vx%, 464 * fy + vy%     ' Textabdeckung
      Repeat
        PeekEvent
      Until _Mess = 0
      If Len(Asc(ze$)) = 2 And Asc(Right$(ze$)) = 119 ' F8
        ende| = 1
        GoTo ende48
      Else If Len(Asc(ze$)) = 2 And Asc(Right$(ze$)) = 112 ' F1
        hilfe| = 2
        hilferuf| = 1
        SetFont schrift1%
        Color RGB(0, 0, 0)
        Text 42 * fx + vx%, 380 * fy + vy%, "Komma?"
        GoTo neukomma
      EndIf
      DefMouse V:aaa%(0)        ' transparente Mausform
      xx% = Int(41 * fx + vx%) + (6 + Len(za$ + zb$ + antwort_$) - stelle|) * zeichenbr%
      yy% = Int(29 * fy + vy%) + zeichenh% * 5
      Color RGB(0, 0, 0) ' schwarz
      If (k% <> 0 And x% > xx% - 4 * fx And x% < xx% + 4 * fx And y% > yy% - 6 * fy And y% < yy% + 6 * fy) Or ze$ = ","
        DefLine 0, 2 * fy
        Line xx%, yy%, xx% - 2 * fx, yy% + 4 * fy                ' Komma
        DefLine 0, 1
      Else
        DefLine 0, 2 * fy
        Color RGB(255, 0, 0) ' rot
        Line xx%, yy%, xx% - 2 * fx, yy% + 4 * fy                ' Komma
        DefLine 0, 1
        Inc falsch%
        Inc falsch1|
        fehler| = 1
        saeule
        falsch
        SetFont schrift1%
        Color RGB(0, 0, 0) ' schwarz
        If einzelner| = 1
          If geldwahl| = 2
            Text Int(42 * fx + vx%), 350 * fy + vy%, "Du hast die letzte " + Chr$(132) + "Euro" + Chr$(147) + "-Stelle geteilt."
          Else
            Text Int(42 * fx + vx%), 350 * fy + vy%, "Du hast die letzte " + Chr$(132) + mass$ + Chr$(147) + "-Stelle geteilt."
          EndIf
        Else
          If geldwahl| = 2
            Text Int(42 * fx + vx%), 350 * fy + vy%, "Ihr habt die letzte " + Chr$(132) + "Euro" + Chr$(147) + "-Stelle geteilt."
          Else
            Text Int(42 * fx + vx%), 350 * fy + vy%, "Ihr habt die letzte " + Chr$(132) + mass$ + Chr$(147) + "-Stelle geteilt."
          EndIf
        EndIf
        If geldwahl| = 2
          Text Int(42 * fx + vx%), 370 * fy + vy%, "Hier muss das Komma " + Chr$(132) + "Euro" + Chr$(147) + " von " + Chr$(132) + "Cent" + Chr$(147) + " trennen!"
        Else
          Text Int(42 * fx + vx%), 370 * fy + vy%, "Hier muss das Komma " + Chr$(132) + mass$ + Chr$(147) + " von " + Chr$(132) + mass1$ + Chr$(147) + " trennen!"
        EndIf
        If einzelner| = 1
          Text Int(42 * fx + vx%), 395 * fy + vy%, "Gib das Komma mit der Maus oder mit der Tastatur ein!"
        Else
          Text Int(42 * fx + vx%), 395 * fy + vy%, "Gebt das Komma mit der Maus oder mit der Tastatur ein!"
        EndIf
        SetFont schrift3%
        Repeat
          Sleep
        Until InKey$ <> ""
        GoTo neu18
      EndIf
    EndIf
    If stelle_a| <= Len(za$)
      Color RGB(255, 0, 0) ' rot
      Box antwx% + 2 * fx, antwy% + 4 * fy, antwx% + zeichenbr% - 2 * fx, antwy% + zeichenh%  ' Kursor
    EndIf
    f29:
    If (hilfe| = 2 Or falsch1| > 0) And eingabe_$ < antwort_$
      SetFont schrift3%
      Color RGB(255, 0, 0) ' rot
      Box Int(41 * fx + vx%) + stelle_a| * zeichenbr% - Len(teil$) * zeichenbr%, antwy1% + Ceil(fy) - zeichenh%, Int(41 * fx + vx%) + stelle_a| * zeichenbr%, antwy1% + Ceil(fy)
      Box Int(41 * fx + vx%) + TxtLen(za$) + zeichenbr% * 3, Int(30 * fy + vy%) + zeichenh% * 4, Int(41 * fx + vx%) + TxtLen(za$ + zb$) + zeichenbr% * 3, Int(30 * fy + vy%) + zeichenh% * 5
      Color RGB(255, 255, 198) ' creme
      PRBox 38 * fx + vx%, 374 * fy + vy%, 510 * fx + vx%, 464 * fy + vy%     ' Textabdeckung
      Color RGB(0, 0, 0) ' schwarz
      SetFont schrift1%
      Text Int(42 * fx + vx%), 380 * fy + vy%, "Wie viele erhält jeder?"
      SetFont schrift3%
    EndIf
    Repeat
      Sleep
      antw$ = InKey$
    Until Asc(antw$) > 47 And Asc(antw$) < 58 Or (Len(antw$) = 2 And (Asc(Right$(antw$)) = 119 Or Asc(Right$(antw$)) = 112) Or antw$ = Chr$(13) )
    If Len(antw$) = 2 And Asc(Right$(antw$)) = 112
      If hilfe| = 2
        hilfe| = 1
        Color RGB(255, 255, 198) ' creme
        PRBox 38 * fx + vx%, 374 * fy + vy%, 510 * fx + vx%, 464 * fy + vy%     ' Textabdeckung
      Else
        hilfe| = 2
        hilferuf| = 1
      EndIf
      GoTo f29
    EndIf
    Color RGB(0, 190, 255) ' hell blaugrün
    Box Int(41 * fx + vx%) + stelle_a| * zeichenbr% - TxtLen(teil$), antwy1% + Ceil(fy) - zeichenh%, Int(41 * fx + vx%) + stelle_a| * zeichenbr%, antwy1% + Ceil(fy)
    Box Int(41 * fx + vx%) + TxtLen(za$) + zeichenbr% * 3, Int(30 * fy + vy%) + zeichenh% * 4, Int(41 * fx + vx%) + TxtLen(za$ + zb$) + zeichenbr% * 3, Int(30 * fy + vy%) + zeichenh% * 5
    Color RGB(0, 0, 0) ' schwarz
    DefLine 0, 2 * fy
    Line 41 * fx + vx% + zeichenbr% * (Len(za$) - stelle|), antwy% + zeichenh%, 41 * fx + vx% + zeichenbr% * (Len(za$) - stelle|) - 2 * fx, antwy% + 4 * fy + zeichenh%    ' Komma
    DefLine 0, 1
    For i% = 1 To linie% Step 3
      Line lin%(i%), lin%(i% + 1), lin%(i% + 2), lin%(i% + 1)
    Next i%
    If textl% > 0 And Right$(eingabe_$) = "0"
      Inc l%
      If l% = 1
        t% = textl%
      EndIf
    EndIf
    If antw$ = Chr$(13)                                  ' Return
      If eingabe_$ = ""
        GoTo f29
      Else
        Exit If antw$ = Chr$(13)
      EndIf
    EndIf
    If Len(antw$) = 2 And Asc(Right$(antw$)) = 119         ' F8
      ende| = 1
      GoTo ende48 '   kontrolle
    EndIf
    Color RGB(255, 255, 198) ' creme
    Box antwx% + 2 * fx, antwy% + 4 * fy, antwx% + zeichenbr% - 2 * fx, antwy% + zeichenh%  ' Kursor
    eingabe_$ = eingabe_$ + antw$
    Color RGB(0, 0, 0) ' schwarz
    Text antwx%, antwy%, antw$
    If (Val(eingabe_$) = 0 And (Val(teil$) < Val(zb$) And teil$ = Left$(za$, Len(teil$))) And Left$(eingabe_$, komm%) = Left$(antwort_$, komm%) )
      GoTo fnull
    EndIf
    If Len(eingabe_$) <= Len(antwort_$)
      If eingabe_$ <> Left$(antwort_$, stelle_b|)
        Inc falsch%
        Inc falsch1|
        fehler| = 1
        Color RGB(255, 255, 198) ' creme
        PRBox 38 * fx + vx%, 374 * fy + vy%, 510 * fx + vx%, 464 * fy + vy%     ' Textabdeckung
        saeule
        falsch
        Color RGB(0, 170, 0) ' grün
        If Left$(teil$) = "0"
          teil1$ = Right$(teil$, Len(teil$) - 1)
        Else
          teil1$ = teil$
        EndIf
        Color RGB(255, 0, 0) ' rot
        Box Int(41 * fx + vx%) + stelle_a| * zeichenbr% - TxtLen(teil$), antwy1% + Ceil(fy) - zeichenh%, Int(41 * fx + vx%) + stelle_a| * zeichenbr%, antwy1% + Ceil(fy)
        Box Int(41 * fx + vx%) + TxtLen(za$) + zeichenbr% * 3, Int(30 * fy + vy%) + zeichenh% * 4, Int(41 * fx + vx%) + TxtLen(za$ + zb$) + zeichenbr% * 3, Int(30 * fy + vy%) + zeichenh% * 5
        Color RGB(0, 0, 0) ' schwarz
        SetFont schrift1%
        r$ = "Wie viele erhält jeder?   " + rechne$ + ":   " + teil$ + " : " + zb$ + " = "
        Text Int(42 * fx + vx%), 380 * fy + vy%, r$
        Color RGB(255, 0, 0) ' rot
        Box Int(42 * fx + vx%) + TxtLen(r$), 383 * fy + vy%, 52 * fx + vx% + TxtLen(r$), 396 * fy + vy%
        SetFont schrift3%
        Clr teil1$
        Repeat
          Sleep
        Until InKey$ <> ""
        Put bildx1%, bildy%, neu$
        Put Int(42 * fx + vx%) + (5 + Len(za$ + zb$)) * zeichenbr%, 33 * fy + vy% + zeichenh% * 3, neu$
        Color RGB(0, 190, 255) ' hell blaugrün
        Box Int(41 * fx + vx%) + stelle_a| * zeichenbr% - TxtLen(teil$), antwy1% + fy - zeichenh%, Int(41 * fx + vx%) + stelle_a| * zeichenbr%, antwy1% + fy
        Box Int(41 * fx + vx%) + TxtLen(za$) + zeichenbr% * 3, Int(30 * fy + vy%) + zeichenh% * 4, Int(41 * fx + vx%) + TxtLen(za$ + zb$) + zeichenbr% * 3, Int(30 * fy + vy%) + zeichenh% * 5
        GoTo neu18
      EndIf
      a1% = antwx1%
      Color RGB(0, 190, 255) ' hell blaugrün
      For j% = 1 To Len(teil$)                ' Rechenhäuschen nachzeichnen
        Box a1%  + (1 - j%) * zeichenbr%, antwy1% + Ceil(fy), a1% + (2 - j%) * zeichenbr%, antwy1% + Ceil(fy) + zeichenh%
        Box a1%  + (1 - j%) * zeichenbr%, antwy1% + Ceil(fy) + zeichenh%, a1% + (2 - j%) * zeichenbr%, antwy1% + Ceil(fy) + zeichenh% * 2
        Box a1%  - j% * zeichenbr%, antwy1% + Ceil(fy), a1% + (1 - j%) * zeichenbr%, antwy1% + Ceil(fy) + zeichenh%
'##B#
        Box a1%  - j% * zeichenbr%, antwy1% + Ceil(fy) + zeichenh%, a1% + (1 - j%) * zeichenbr%, antwy1% + Ceil(fy) + zeichenh% * 2
      Next j%
      If Len(za$) - komm% < stelle| - 1
        Color RGB(0, 0, 0) ' schwarz
        DefLine 0, 2 * fy
        Line xx%, yy%, xx% - 2 * fx, yy% + 4 * fy                ' Komma
        DefLine 0, 1
      EndIf
      If Right$(eingabe_$) <> "0"
        mal$ = Trim$(Str$(b% * Val(Mid$(antwort_$, stelle_b|, 1))))   ' Malnehmen #################################
        Clr m$
        Repeat
          PeekEvent
          Color RGB(255, 0, 0) ' rot
          Box antwx1% - zeichenbr% + 2 * fx, antwy1% + 4 * fy, antwx1% - 2 * fx, antwy1% + zeichenh% ' Kursor
          f30:
          If hilfe| = 2 Or falsch1| > 0
            Color RGB(255, 0, 0) ' rot
            Box Int(41 * fx + vx%) + TxtLen(za$) + zeichenbr% * 3, Int(30 * fy + vy%) + zeichenh% * 4, Int(41 * fx + vx%) + TxtLen(za$ + zb$) + zeichenbr% * 3, Int(30 * fy + vy%) + zeichenh% * 5
            Box Int(41 * fx + vx%) + TxtLen(zb$ + za$ + eingabe_$) + zeichenbr% * 5, Int(30 * fy + vy%) + zeichenh% * 4, Int(41 * fx + vx%) + TxtLen(zb$ + za$ + eingabe_$) + zeichenbr% * 6, Int(30 * fy + vy%) + zeichenh% * 5
            Color RGB(255, 255, 198) ' creme
            PRBox 38 * fx + vx%, 374 * fy + vy%, 510 * fx + vx%, 464 * fy + vy%     ' Textabdeckung
            Color RGB(0, 0, 0) ' schwarz
            SetFont schrift1%
            Text Int(42 * fx + vx%), 380 * fy + vy%, "Wie viele haben alle zusammen erhalten?"
            SetFont schrift3%
          EndIf
          Repeat
            Sleep
            antw$ = InKey$
          Until Asc(antw$) > 47 And Asc(antw$) < 58 Or (Len(antw$) = 2 And (Asc(Right$(antw$)) = 119 Or Asc(Right$(antw$)) = 112)) Or antw$ = Chr$(8)
          If Len(antw$) = 2 And Asc(Right$(antw$)) = 112
            If hilfe| = 2
              hilfe| = 1
              Color RGB(255, 255, 198) ' creme
              PRBox 38 * fx + vx%, 374 * fy + vy%, 510 * fx + vx%, 464 * fy + vy%     ' Textabdeckung
            Else
              hilfe| = 2
              hilferuf| = 1
            EndIf
            GoTo f30
          EndIf
          Color RGB(0, 190, 255) ' hell blaugrün
          Box Int(41 * fx + vx%) + TxtLen(za$) + zeichenbr% * 3, Int(30 * fy + vy%) + zeichenh% * 4, Int(41 * fx + vx%) + TxtLen(za$ + zb$) + zeichenbr% * 3, Int(30 * fy + vy%) + zeichenh% * 5
          Box Int(41 * fx + vx%) + TxtLen(zb$ + za$ + eingabe_$) + zeichenbr% * 5, Int(30 * fy + vy%) + zeichenh% * 4, Int(41 * fx + vx%) + TxtLen(zb$ + za$ + eingabe_$) + zeichenbr% * 6, Int(30 * fy + vy%) + zeichenh% * 5
          Color RGB(0, 0, 0) ' schwarz
          DefLine 0, 2 * fy
          Line Int(41 * fx + vx%) + zeichenbr% * (Len(za$) - stelle|), antwy% + zeichenh%, Int(41 * fx + vx%) + zeichenbr% * (Len(za$) - stelle|) - 2 * fx, antwy% + 4 * fy + zeichenh%    ' Komma
          DefLine 0, 1
          For i% = 1 To linie% Step 3
            Line lin%(i%), lin%(i% + 1), lin%(i% + 2), lin%(i% + 1)
          Next i%
          Color RGB(255, 255, 198) ' creme
          If Len(antw$) = 2 And Asc(Right$(antw$)) = 119         ' F8
            ende| = 1
            GoTo ende48
          Else
            If antw$ = Chr$(8)                                    ' Backspace
              If Len(m$) > 0
                m$ = Right$(m$, Len(m$) - 1)
                Color RGB(255, 255, 198) ' creme
                Box antwx1% - zeichenbr% + 2 * fx, antwy1% + 4 * fy, antwx1% - 2 * fx, antwy1% + zeichenh% ' Kursor
                Add antwx1%, zeichenbr%
                PBox antwx1% - zeichenbr% + fx, antwy1% + 4 * fy, antwx1% - fx, antwy1% + zeichenh%
              EndIf
            Else If Asc(antw$) > 47 And Asc(antw$) < 58
              m$ = antw$ + m$
              Color RGB(255, 255, 198) ' creme
              Box antwx1% - zeichenbr% + 2 * fx, antwy1% + 4 * fy, antwx1% - 2 * fx, antwy1% + zeichenh% ' Kursor
              Color RGB(0, 0, 0) ' schwarz
              Text antwx1% - zeichenbr%, antwy1%, antw$
              Sub antwx1%, zeichenbr%
            EndIf
          EndIf
        Until Len(m$) = Len(mal$)
        If m$ <> mal$
          Inc falsch%
          Inc falsch1|
          fehler| = 1
          Color RGB(255, 255, 198) ' creme
          PRBox 38 * fx + vx%, 374 * fy + vy%, 510 * fx + vx%, 464 * fy + vy%     ' Textabdeckung
          saeule
          falsch
          Color RGB(255, 0, 0) ' rot
          Box Int(41 * fx + vx%) + TxtLen(za$) + zeichenbr% * 3, Int(30 * fy + vy%) + zeichenh% * 4, Int(41 * fx + vx%) + TxtLen(za$ + zb$) + zeichenbr% * 3, Int(30 * fy + vy%) + zeichenh% * 5
          Box Int(41 * fx + vx%) + TxtLen(zb$ + za$ + eingabe_$) + zeichenbr% * 5, Int(30 * fy + vy%) + zeichenh% * 4, Int(41 * fx + vx%) + TxtLen(zb$ + za$ + eingabe_$) + zeichenbr% * 6, Int(30 * fy + vy%) + zeichenh% * 5
          Color RGB(0, 0, 0) ' schwarz
          SetFont schrift1%
          Text Int(42 * fx + vx%), 380 * fy + vy%, "Wie viele haben alle zusammen erhalten?"
          r$ = rechne$ + ":   " + Right$(eingabe_$) + " · " + zb$ + " = "
          Text Int(42 * fx + vx%), 400 * fy + vy%, r$
          Color RGB(255, 0, 0) ' rot
          Box Int(42 * fx + vx%) + TxtLen(r$), 403 * fy + vy%, 52 * fx + vx% + TxtLen(r$), 416 * fy + vy%
          SetFont schrift3%
          Clr teil1$
          Repeat
            Sleep
          Until InKey$ <> ""
          GoTo neu18
        EndIf
        antwx1% = Int(41 * fx + vx%) + stelle_a| * zeichenbr% - zeichenbr%       ' Abziehen ################################
        DefLine 0, fy
        Color RGB(0, 0, 0) ' schwarz
        lin%(linie% + 1) = antwx1% - TxtLen(teil$) + zeichenbr%
        lin%(linie% + 2) = antwy1% + Ceil(fy) + zeichenh%
        lin%(linie% + 3) = antwx1% + zeichenbr%
        Line lin%(linie% + 1), lin%(linie% + 2), lin%(linie% + 3), lin%(linie% + 2)
        DefLine 0, 1
        Add linie%, 3
        Add antwy1%, zeichenh%
        sub$ = Trim$(Str$(Val(teil$) - Val(mal$)))
        Color RGB(255, 0, 0) ' rot
        Clr s_$
        a1% = antwx1%
        Repeat
          PeekEvent
          Color RGB(255, 0, 0) ' rot
          Box antwx1% + 2 * fx, antwy1% + 4 * fy, antwx1% + zeichenbr% - 2 * fx, antwy1% + zeichenh%  ' Kursor
          f31:
          If hilfe| = 2 Or falsch1| > 0
            Color RGB(255, 0, 0) ' rot
            Box a1% + zeichenbr% - TxtLen(teil$), antwy1% + Ceil(fy) - zeichenh% * 2, a1% + zeichenbr%, antwy1% + Ceil(fy)
            Color RGB(255, 255, 198) ' creme
            PRBox 38 * fx + vx%, 374 * fy + vy%, 510 * fx + vx%, 464 * fy + vy%     ' Textabdeckung
            Color RGB(0, 0, 0) ' schwarz
            SetFont schrift1%
            Text Int(42 * fx + vx%), 380 * fy + vy%, "Wie viele bleiben übrig?"
            SetFont schrift3%
          EndIf
          Repeat
            Sleep
            antw$ = InKey$
          Until Asc(antw$) > 47 And Asc(antw$) < 58 Or (Len(antw$) = 2 And (Asc(Right$(antw$)) = 119 Or Asc(Right$(antw$)) = 112)) Or antw$ = Chr$(8)
          If Len(antw$) = 2 And Asc(Right$(antw$)) = 112
            If hilfe| = 2
              hilfe| = 1
              Color RGB(255, 255, 198) ' creme
              PRBox 38 * fx + vx%, 374 * fy, 510 * fx + vx%, 464 * fy     ' Textabdeckung
            Else
              hilfe| = 2
              hilferuf| = 1
            EndIf
            GoTo f31
          EndIf
          Color RGB(0, 190, 255) ' hell blaugrün
          Box a1% + zeichenbr% - TxtLen(teil$), antwy1% + Ceil(fy) - zeichenh% * 2, a1% + zeichenbr%, antwy1% + Ceil(fy)
          Color RGB(0, 0, 0) ' schwarz
          DefLine 0, 2 * fy
          Line Int(41 * fx + vx%) + zeichenbr% * (Len(za$) - stelle|), antwy% + zeichenh%, Int(41 * fx + vx%) + zeichenbr% * (Len(za$) - stelle|) - 2 * fx, antwy% + 4 * fy + zeichenh%    ' Komma
'##B#
          DefLine 0, fy
          For i% = 1 To linie% Step 3
            Line lin%(i%), lin%(i% + 1), lin%(i% + 2), lin%(i% + 1)
          Next i%
'##B#
          DefLine 0, 1
          If Len(antw$) = 2 And Asc(Right$(antw$)) = 119         ' F8
            ende| = 1
            GoTo ende48
          Else If antw$ = Chr$(8)                                 ' Backspace
            If Len(s_$) > 0
              s_$ = Right$(s_$, Len(s_$) - 1)
              Color RGB(255, 255, 198) ' creme
              PBox antwx1%, antwy1% + 4 * fy, antwx1% + zeichenbr% - 2 * fx, antwy1% + zeichenh%
              Add antwx1%, zeichenbr%
              PBox antwx1%, antwy1% + 4 * fy, antwx1% + zeichenbr% - 2 * fx, antwy1% + zeichenh%
            EndIf
          Else If Asc(antw$) > 47 And Asc(antw$) < 58
            s_$ = antw$ + s_$
            Color RGB(255, 255, 198) ' creme
            Box antwx1% + 2 * fx, antwy1% + 4 * fy, antwx1% + zeichenbr% - 2 * fx, antwy1% + zeichenh% ' Kursor
            Color RGB(0, 0, 0) ' schwarz
            Text antwx1%, antwy1%, antw$
            Sub antwx1%, zeichenbr%
          EndIf
        Until Len(s_$) = Len(sub$)
        Inc stelle_a|
        antwx1% = Int(41 * fx + vx%) + stelle_a| * zeichenbr% - zeichenbr%
        If s_$ <> sub$
          Inc falsch%
          Inc falsch1|
          fehler| = 1
          Color RGB(255, 255, 198) ' creme
          PRBox 38 * fx + vx%, 374 * fy + vy%, 510 * fx + vx%, 464 * fy + vy%     ' Textabdeckung
          saeule
          falsch
          Color RGB(255, 0, 0) ' rot
          Box a1% - Int(fx) + zeichenbr% - Len(teil$) * zeichenbr%, antwy1% + fy - zeichenh% * 2, a1% - Int(fx) + zeichenbr%, antwy1% + fy
          Color RGB(0, 0, 0) ' schwarz
          SetFont schrift1%
          r$ = "Wie viele bleiben übrig?  " + rechne$ + ":   " + teil$ + " - " + mal$ + " = "
          Text Int(42 * fx + vx%), 380 * fy + vy%, r$
          Color RGB(255, 0, 0) ' rot
          Box Int(42 * fx + vx%) + TxtLen(r$), 383 * fy + vy%, 52 * fx + vx% + TxtLen(r$), 396 * fy + vy%
          Color RGB(0, 0, 0) ' schwarz
          Clr s_$
          SetFont schrift3%
          Repeat
            Sleep
          Until InKey$ <> ""
          Color RGB(0, 190, 255) ' hell blaugrün
          Box a1% - Int(fx) + zeichenbr% - TxtLen(teil$), antwy1% + fy - zeichenh% * 2, a1% - Int(fx) + zeichenbr%, antwy1% + fy
          GoTo neu18
        EndIf
        Clr a1%
      Else
        Inc stelle_a|
        Sub antwy1%, zeichenh%                            '20*fy
      EndIf
      If Len(eingabe_$) < Len(antwort_$)                             'Wechseln ###################################
        Color RGB(255, 0, 0) ' rot
        Box antwx1% + 2 * fx, antwy1% + 4 * fy, antwx1% + zeichenbr% - 2 * fx, antwy1% + zeichenh%  ' Kursor
        f32:
        If hilfe| = 2 Or falsch1| > 0
          Color RGB(255, 255, 198) ' creme
          PRBox 38 * fx + vx%, 374 * fy + vy%, 510 * fx + vx%, 464 * fy + vy%    ' Textabdeckung
          Color RGB(255, 0, 0) ' rot
          Box antwx1%, Int(30 * fy + vy%) + zeichenh% * 4, antwx1% + zeichenbr%, Int(30 * fy + vy%) + zeichenh% * 5
          Color RGB(0, 0, 0) ' schwarz
          SetFont schrift1%
          If einzelner| = 1
            Text Int(42 * fx + vx%), 380 * fy + vy%, "Wechsle durch Anfügen der eingerahmten " + Mid$(za$, stelle_a|, 1) + "!"
          Else
            Text Int(42 * fx + vx%), 380 * fy + vy%, "Wechselt durch Anfügen der eingerahmten " + Mid$(za$, stelle_a|, 1) + "!"
          EndIf
          SetFont schrift3%
        EndIf
        Repeat
          Sleep
          antw$ = InKey$
        Until Asc(antw$) > 47 And Asc(antw$) < 58 Or (Len(antw$) = 2 And (Asc(Right$(antw$)) = 119 Or Asc(Right$(antw$)) = 112))
        If Len(antw$) = 2 And Asc(Right$(antw$)) = 112
          If hilfe| = 2
            hilfe| = 1
            Color RGB(255, 255, 198) ' creme
            PRBox 38 * fx + vx%, 374 * fy + vy%, 510 * fx + vx%, 464 * fy + vy%     ' Textabdeckung
          Else
            hilfe| = 2
            hilferuf| = 1
          EndIf
          GoTo f32
        EndIf
        If Len(antw$) = 2 And Asc(Right$(antw$)) = 119         ' F8
          ende| = 1
          GoTo ende48
        EndIf
        Color RGB(0, 190, 255) ' hell blaugrün
        Box antwx1%, Int(30 * fy + vy%) + zeichenh% * 4, antwx1% + zeichenbr%, Int(30 * fy + vy%) + zeichenh% * 5
        If Len(antw$) = 2 And Asc(Right$(antw$)) = 119
          ende| = 1
          GoTo ende48
        EndIf
        Color RGB(255, 255, 198) ' creme
        Box antwx1% + 2 * fx, antwy1% + 4 * fy, antwx1% + zeichenbr% - 2 * fx, antwy1% + zeichenh%  ' Kursor
        Color RGB(0, 0, 0) ' schwarz
        Text antwx1%, antwy1%, antw$
        If antw$ <> Mid$(za$, stelle_a|, 1)
          Inc falsch%
          Inc falsch1|
          fehler| = 1
          Color RGB(255, 255, 198) ' creme
          PRBox 38 * fx + vx%, 374 * fy + vy%, 510 * fx + vx%, 464 * fy + vy%     ' Textabdeckung
          saeule
          falsch
          Color RGB(255, 0, 0) ' rot
          Box antwx1%, Int(30 * fy + vy%) + zeichenh% * 4, antwx1% + zeichenbr%, Int(30 * fy + vy%) + zeichenh% * 5
          Color RGB(0, 0, 0) ' schwarz
          SetFont schrift1%
          If einzelner| = 1
            r$ = "Wechsle durch Anfügen der eingerahmten " + Mid$(za$, stelle_a|, 1) + "!"
          Else
            r$ = "Wechselt durch Anfügen der eingerahmten " + Mid$(za$, stelle_a|, 1) + "!"
          EndIf
          Text Int(42 * fx + vx%), 380 * fy + vy%, r$
          SetFont schrift3%
          Repeat
            Sleep
          Until InKey$ <> ""
          Color RGB(0, 190, 255) ' hell blaugrün
          Box antwx1%, Int(30 * fy) + zeichenh% * 4, antwx1% + zeichenbr%, Int(30 * fy) + zeichenh% * 5
          GoTo neu18
        EndIf
        textl% = Len(teil$) * zeichenbr%
        If stufe| < 3 Or (stufe| = 3 And Right$(eingabe_$) <> "0")
          teil$ = sub$ + Mid$(za$, stelle_a|, 1)
        Else
          teil$ = teil$ + Mid$(za$, stelle_a|, 1)
        EndIf
        Color RGB(0, 0, 0) ' schwarz
        Text antwx1%, antwy1%, Mid$(za$, stelle_a|, 1)
        Add antwy1%, zeichenh%
      EndIf
    EndIf
    komm% = komm% + 1
  Until Len(eingabe_$) > Len(antwort_$) Or (Len(eingabe_$) = Len(antwort_$) And rest% <> 0)
  f34:
  If Len(eingabe_$) < Len(antwort_$)
    GoTo neu18
  EndIf
  If Len(eingabe_$) > Len(antwort_$) And antw$ <> Chr$(13)
    Inc falsch%
    Inc falsch1|
    fehler| = 1
    Color RGB(255, 255, 198) ' creme
    PRBox 38 * fx + vx%, 374 * fy + vy%, 510 * fx + vx%, 464 * fy + vy%     ' Textabdeckung
    saeule
    falsch
    SetFont schrift1%
    Text Int(42 * fx + vx%), 380 * fy + vy%, du$ + "zu weit gerechnet!"
    SetFont schrift3%
    Repeat
      Sleep
    Until InKey$ <> ""
    GoTo neu18
  EndIf
  If rest% <> 0
    If rest% = 1 And wahl| = 8
      mass1$ = "100-m-Stück"
    EndIf
    Color RGB(0, 0, 0)     ' schwarz
    Text Int(42 * fx + vx%) + (7 + Len(za$ + zb$ + antwort_$)) * zeichenbr%, antwy%, "Rest" + Space$(2 + Len(Trim$(Str$(rest%)))) + mass1$
    If rest% = 1 And wahl| = 8
      mass1$ = "100-m-Stücke"
    EndIf
    Color RGB(255, 0, 0) ' rot
    Box Int(42 * fx + vx%) + (12 + Len(za$ + zb$ + antwort_$)) * zeichenbr%, antwy% + 4 * fy, 40 * fx + vx% + (13 + Len(za$ + zb$ + antwort_$)) * zeichenbr%, antwy% + zeichenh%
    f35:
    If hilfe| = 2
      Color RGB(255, 255, 198) ' creme
      PRBox 38 * fx + vx%, 374 * fy + vy%, 510 * fx + vx%, 464 * fy + vy%     ' Textabdeckung
      SetFont schrift1%
      Color RGB(0, 0, 0)     ' schwarz
      Text Int(42 * fx + vx%), 380 * fy + vy%, gib$ + "den Rest ein! Er steht in der letzten Zeile."
      SetFont schrift3%
    EndIf
    Repeat
      Repeat
        Sleep
        antw$ = InKey$
      Until Asc(antw$) > 47 And Asc(antw$) < 58 Or (Len(antw$) = 2 And (Asc(Right$(antw$)) = 119 Or Asc(Right$(antw$)) = 112) Or antw$ = Chr$(13) Or antw$ = Chr$(8))
      Exit If antw$ = Chr$(13)     ' Return
      If antw$ = Chr$(08)                                    ' Backspace
        If Len(rest_$) > 0
          rest_$ = Left$(rest_$, Len(rest_$) - 1)
          Color RGB(255, 255, 198) ' creme
          PBox Int(42 * fx + vx%) + (12 + Len(za$ + zb$ + antwort_$ + rest_$)) * zeichenbr%, antwy% + 4 * fy, Int(42 * fx + vx%) + (13 + Len(za$ + zb$ + antwort_$ + rest_$)) * zeichenbr% - 2 * fx, antwy% + zeichenh%
          GoTo f35
        EndIf
      Else If Len(antw$) = 2 And Asc(Right$(antw$)) = 112      ' F1
        If hilfe| = 2
          hilfe| = 1
        Else
          hilfe| = 2
          hilferuf| = 1
        EndIf
        GoTo f35
      EndIf
      If Len(antw$) = 2 And Asc(Right$(antw$)) = 119         ' F8
        ende| = 1
        GoTo ende48 '   kontrolle
      EndIf
      If Asc(antw$) > 47 And Asc(antw$) < 58
        Color RGB(255, 255, 198) ' creme
        Box Int(42 * fx + vx%) + (12 + Len(za$ + zb$ + antwort_$)) * zeichenbr%, antwy% + 4 * fy, 40 * fx + vx% + (13 + Len(za$ + zb$ + antwort_$)) * zeichenbr%, antwy% + zeichenh%
        rest_$ = rest_$ + antw$
        SetFont schrift3%
        Color RGB(0, 0, 0)
        Text Int(42 * fx + vx%) + (12 + Len(za$ + zb$ + antwort_$)) * zeichenbr%, antwy%, rest_$
      EndIf
    Until Len(rest_$) > Len(Trim$(Str$(rest%)))
    If rest_$ <> Trim$(Str$(rest%))
      Inc falsch%
      Inc falsch1|
      fehler| = 1
      Color RGB(255, 255, 198) ' creme
      PRBox 38 * fx + vx%, 374 * fy, 510 * fx + vx%, 464 * fy     ' Textabdeckung
      saeule
      falsch
      SetFont schrift1%
      Color RGB(0, 0, 0)     ' schwarz
      If einzelner| = 1
        Text Int(42 * fx + vx%), 380 * fy + vy%, "Achtung! Du findest den Rest in deiner letzten Zeile!"
      Else
        Text Int(42 * fx + vx%), 380 * fy + vy%, "Achtung! Ihr findet den Rest in eurer letzten Zeile!"
      EndIf
      SetFont schrift3%
      Repeat
        Sleep
      Until InKey$ <> ""
      GoTo neu18
    EndIf
    Clr rest%, rest_$
    Inc richtig1%
    Clr falsch1|
    Clr fehler|
    Color RGB(255, 255, 198) ' creme
    PBox 43 * fx + vx% + 32 * zeichenbr%, Int(29 * fy + vy%) + zeichenh% * 4, 550 * fx + vx%, 33 * fy + vy% + zeichenh% * 5     ' Abdeckung Rest 100 m-Stücke
    saeule
  EndIf
  ende48:
Return
>Procedure a49                      ' schriftlich multiplizieren
  neu7:
  aa1# = a%
  bb1# = b%
  If aa1# * bb1# > 2147483647 Or aa1# * bb1# < -2147483647
    SetFont schrift1%
    Text Int(42 * fx + vx%), 300 * fy + vy%, gib$ + "kleinere Zahlen ein!"
    jz# = oTimer
    Repeat
      PeekEvent
      zeitneu# = oTimer
    Until zeitneu# > jz# + 1000
    Repeat
      PeekEvent
    Until _Mess = 0
    zugross| = 1
    SetFont schrift3%
    ende| = 1
    GoTo ende49  ' hauptmenue
  EndIf
  Clr stelle_a|, stelle_b|, aa1#, bb1#
  For i% = 0 To 9
    teilantwort$(i%) = ""
  Next i%
  antwort% = a% * b%
  antwort_$ = Trim$(Str$(antwort%))
  grenze% = 9
  antwy% = Int(29 * fy + vy%)
  saeule
  SetFont schrift3%
  Color RGB(0, 0, 0) ' schwarz
  Text Int(41 * fx + vx%) + zeichenbr% * 18 - TxtLen(za$) - TxtLen(zb$) - Int(42 * fx), Int(29 * fy + vy%), za$ + " · " + zb$
  DefLine 0, fy
  Line Int(41 * fx + vx%) + zeichenbr% * 18 - TxtLen(za$) - TxtLen(zb$) - Int(42 * fx), Int(30 * fy + vy%) + zeichenh%, Int(41 * fx + vx%) + zeichenbr% * 18, Int(30 * fy + vy%) + zeichenh%
  DefLine 0, 1
  Repeat
    PeekEvent
    Clr eingabe_$
    Inc stelle_b|
    antwx% = Int(41 * fx + vx%) + zeichenbr% * 18 - TxtLen(zb$) + stelle_b| * zeichenbr%
    teilantwort$(stelle_b|) = Trim$(Str$(a% * Val(Mid$(zb$, stelle_b|, 1))))
    If fehlermal| = 0
      ArrayFill uebertrag%(), 0
    Else
      Clr fehlermal|
    EndIf
    Repeat
      PeekEvent
      Inc stelle_a|
      If stelle_a| <= Len(teilantwort$(stelle_b|))
        Color RGB(255, 0, 0) ' rot
        Box antwx% - fx, antwy% + 4 * fy  + zeichenh%, antwx% + fx - zeichenbr%, antwy% + zeichenh% * 2
      EndIf
      f6:
      If hilfe| = 2 Or falsch1| > 0
        Color RGB(255, 0, 0) ' rot
        Box Int(41 * fx + vx%) + zeichenbr% * 17 - TxtLen(zb$) + (stelle_b|) * zeichenbr%, Int(30 * fy + vy%), Int(41 * fx + vx%) + zeichenbr% * 18 - TxtLen(zb$) + (stelle_b|) * zeichenbr%, Int(30 * fy + vy%) + zeichenh%
        Box Int(41 * fx + vx%) + zeichenbr% * 17 - TxtLen(zb$) - (stelle_a| + 2) * zeichenbr%, Int(30 * fy + vy%), Int(41 * fx + vx%) + zeichenbr% * 18 - TxtLen(zb$) - (stelle_a| + 2) * zeichenbr%, Int(30 * fy + vy%) + zeichenh%
      EndIf
      Repeat
        Sleep
        antw$ = InKey$
      Until Asc(antw$) > 47 And Asc(antw$) < 58 Or (Len(antw$) = 2 And (Asc(Right$(antw$)) = 119 Or Asc(Right$(antw$)) = 112)) Or antw$ = Chr$(13)
      If Len(antw$) = 2 And Asc(Right$(antw$)) = 112
        If hilfe| = 2
          hilfe| = 1
          DefLine 0, 1
          Color RGB(0, 190, 255) ' hell blaugrün
          Box Int(41 * fx + vx%) + zeichenbr% * 17 - TxtLen(zb$) + (stelle_b|) * zeichenbr%, Int(30 * fy + vy%), Int(41 * fx + vx%) + zeichenbr% * 18 - TxtLen(zb$) + (stelle_b|) * zeichenbr%, Int(30 * fy + vy%) + zeichenh%
          Box Int(41 * fx + vx%) + zeichenbr% * 17 - TxtLen(zb$) - (stelle_a| + 2) * zeichenbr%, Int(30 * fy + vy%), Int(41 * fx + vx%) + zeichenbr% * 18 - TxtLen(zb$) - (stelle_a| + 2) * zeichenbr%, Int(30 * fy + vy%) + zeichenh%
          Color RGB(0, 0, 0) ' schwarz
          Line Int(41 * fx + vx%) + zeichenbr% * 17 - TxtLen(zb$) + (stelle_b|) * zeichenbr%, Int(30 * fy + vy%) + zeichenh%, Int(41 * fx + vx%) + zeichenbr% * 18 - TxtLen(zb$) + (stelle_b|) * zeichenbr%, Int(30 * fy + vy%) + zeichenh%
          If stelle_a| <= Len(za$)
            Line Int(41 * fx + vx%) + zeichenbr% * 17 - TxtLen(zb$) - (stelle_a| + 2) * zeichenbr%, Int(30 * fy + vy%) + zeichenh%, Int(41 * fx + vx%) + zeichenbr% * 18 - TxtLen(zb$) - (stelle_a| + 2) * zeichenbr%, Int(30 * fy + vy%) + zeichenh%
          EndIf
        Else
          hilfe| = 2
          hilferuf| = 1
        EndIf
        GoTo f6
      EndIf
      If antw$ = Chr$(13)                      ' Return
        If eingabe_$ = "" And stelle_b| < 2
          GoTo weiter1
        Else
          GoTo neu7
        EndIf
      EndIf
      If hilfe| = 2 Or falsch1| > 0
        DefLine 0, 1
        Color RGB(0, 190, 255) ' hell blaugrün
        Box Int(41 * fx + vx%) + zeichenbr% * 17 - TxtLen(zb$) + (stelle_b|) * zeichenbr%, Int(30 * fy + vy%), Int(41 * fx + vx%) + zeichenbr% * 18 - TxtLen(zb$) + (stelle_b|) * zeichenbr%, Int(30 * fy + vy%) + zeichenh%
        Box Int(41 * fx + vx%) + zeichenbr% * 17 - TxtLen(zb$) - (stelle_a| + 2) * zeichenbr%, Int(30 * fy + vy%), Int(41 * fx + vx%) + zeichenbr% * 18 - TxtLen(zb$) - (stelle_a| + 2) * zeichenbr%, Int(30 * fy + vy%) + zeichenh%
        Color RGB(0, 0, 0) ' schwarz
        Line Int(41 * fx + vx%) + zeichenbr% * 17 - TxtLen(zb$) + (stelle_b|) * zeichenbr%, Int(30 * fy + vy%) + zeichenh%, Int(41 * fx + vx%) + zeichenbr% * 18 - TxtLen(zb$) + (stelle_b|) * zeichenbr%, Int(30 * fy + vy%) + zeichenh%
        If stelle_a| <= Len(za$)
          Line Int(41 * fx + vx%) + zeichenbr% * 17 - TxtLen(zb$) - (stelle_a| + 2) * zeichenbr%, Int(30 * fy + vy%) + zeichenh%, Int(41 * fx + vx%) + zeichenbr% * 18 - TxtLen(zb$) - (stelle_a| + 2) * zeichenbr%, Int(30 * fy + vy%) + zeichenh%
        EndIf
      EndIf
      Color RGB(255, 255, 198) ' creme
'##B#
      Box antwx% - fx, antwy% + 4 * fy + zeichenh%, antwx% + fx - zeichenbr%, antwy% + zeichenh% * 2
      Color RGB(0, 0, 0) ' schwarz
      abfrage
      If ende| = 1
        GoTo ende49
      EndIf
      If Right$(eingabe_$, stelle_a|) <> Right$(teilantwort$(stelle_b|), stelle_a|)
        falsch
        Color RGB(255, 0, 0) ' rot
        Box Int(41 * fx + vx%) + zeichenbr% * 17 - TxtLen(zb$) + (stelle_b|) * zeichenbr%, Int(30 * fy + vy%), Int(41 * fx + vx%) + zeichenbr% * 18 - TxtLen(zb$) + (stelle_b|) * zeichenbr%, Int(30 * fy + vy%) + zeichenh%
        Box Int(41 * fx + vx%) + zeichenbr% * 17 - TxtLen(zb$) - (stelle_a| + 2) * zeichenbr%, Int(30 * fy + vy%), Int(41 * fx + vx%) + zeichenbr% * 18 - TxtLen(zb$) - (stelle_a| + 2) * zeichenbr%, Int(30 * fy + vy%) + zeichenh%
        SetFont schrift1%
        If uebertrag%(stelle_a| - 1) = 0
          Color RGB(0, 0, 0) ' schwarz
          r$ = rechne$ + ":     " + Trim$(Str$(Val(Mid$(zb$, stelle_b|, 1)))) + " · " + Trim$(Str$(Val(Mid$(za$, Len(za$) - stelle_a| + 1, 1)))) + " = "
          Text Int(42 * fx + vx%), 300 * fy + vy%, r$
          Color RGB(255, 0, 0) ' rot
          Box Int(42 * fx + vx%) + TxtLen(r$), 303 * fy + vy%, 50 * fx + vx% + TxtLen(r$), 316 * fy + vy%
          Color RGB(0, 0, 0) ' schwarz
          Text Int(42 * fx + vx%), 350 * fy + vy%, gib$ + "nur die letzte Ziffer des Ergebnisses ein!"
        Else
          If stelle_a| <= Len(za$)
            r$ = rechne$ + ":     " + Trim$(Str$(Val(Mid$(zb$, stelle_b|, 1)))) + " · " + Trim$(Str$(Val(Mid$(za$, Len(za$) - stelle_a| + 1, 1)))) + " + "
          Else
            r$ = rechne$ + ":     " + Trim$(Str$(Val(Mid$(zb$, stelle_b|, 1)))) + " · " + "0" + " + "
          EndIf
          Color RGB(0, 0, 0) ' schwarz
          Text Int(42 * fx + vx%), 300 * fy + vy%, r$
          Color RGB(200, 0, 0) ' dunkelrot
          Text Int(42 * fx + vx%) + TxtLen(r$), 300 * fy + vy%, Trim$(Str$(uebertrag%(stelle_a| - 1)))
          Color RGB(0, 0, 0) ' schwarz
          r$ = r$ + Trim$(Str$(uebertrag%(stelle_a| - 1)))
          Text Int(42 * fx + vx%) + TxtLen(r$), 300 * fy + vy%, " = "
          Text Int(42 * fx + vx%), 350 * fy + vy%, gib$ + "nur die letzte Ziffer des Ergebnisses ein!"
          Color RGB(255, 0, 0) ' rot
          Box Int(42 * fx + vx%) + TxtLen(r$) + TxtLen(" = "), 303 * fy + vy%, 50 * fx + vx% + TxtLen(r$) + TxtLen(" = "), 316 * fy + vy%
        EndIf
        Inc fehlermal|
        SetFont schrift3%
        Repeat
          Sleep
        Until InKey$ <> ""
        DefLine 0, 1
        Color RGB(0, 190, 255) ' hell blaugrün
        Box Int(41 * fx + vx%) + zeichenbr% * 17 - TxtLen(zb$) + (stelle_b|) * zeichenbr%, Int(30 * fy + vy%), Int(41 * fx + vx%) + zeichenbr% * 18 - TxtLen(zb$) + (stelle_b|) * zeichenbr%, Int(30 * fy + vy%) + zeichenh%
        Box Int(41 * fx + vx%) + zeichenbr% * 17 - TxtLen(zb$) - (stelle_a| + 2) * zeichenbr%, Int(30 * fy + vy%), Int(41 * fx + vx%) + zeichenbr% * 18 - TxtLen(zb$) - (stelle_a| + 2) * zeichenbr%, Int(30 * fy + vy%) + zeichenh%
        Color RGB(0, 0, 0) ' schwarz
        Line Int(41 * fx + vx%) + zeichenbr% * 17 - TxtLen(zb$) + (stelle_b|) * zeichenbr%, Int(30 * fy + vy%) + zeichenh%, Int(41 * fx + vx%) + zeichenbr% * 18 - TxtLen(zb$) + (stelle_b|) * zeichenbr%, Int(30 * fy + vy%) + zeichenh%
        Line Int(41 * fx + vx%) + zeichenbr% * 17 - TxtLen(zb$) - (stelle_a| + 2) * zeichenbr%, Int(30 * fy + vy%) + zeichenh%, Int(41 * fx + vx%) + zeichenbr% * 18 - TxtLen(zb$) - (stelle_a| + 2) * zeichenbr%, Int(30 * fy + vy%) + zeichenh%
        If stufe| = 1 And Len(eingabe_$) = Len(teilantwort$(stelle_b|))
          falsch1| = 1
          fehler| = 1
          kontrolle
        EndIf
        GoTo neu7
      EndIf
      xxx$ = Trim$(Str$(Val(Right$(za$, stelle_a|)) * Val(Mid$(zb$, stelle_b|, 1))))
      If Len(xxx$) > stelle_a|
        uebertrag%(stelle_a|) = Val(Left$(xxx$))
        If hilfe| = 2 Or falsch1| > 0
          SetFont schrift0%
          Color RGB(200, 0, 0) ' dunkelrot
          Text antwx% - 11 * fx - zeichenbr%, antwy% + fy + zeichenh% * 2, Left$(xxx$)
          Color RGB(0, 0, 0) ' schwarz
          SetFont schrift3%
        EndIf
      EndIf
      Sub antwx%, zeichenbr%
    Until Len(eingabe_$) = Len(teilantwort$(stelle_b|))
    Clr stelle_a|
    If Mid$(zb$, stelle_b| + 1, 1) <> "0" Or stufe| < 3
      Add antwy%, zeichenh%
      Color RGB(255, 255, 198) ' creme
      For i% = antwx% + zeichenbr% * 9 + fx To antwx% - zeichenbr% * 7 + fx Step -zeichenbr%
        PBox i%, antwy% + Ceil(2 * fy) + zeichenh%, i% + zeichenbr% - 2 * fx, antwy% + zeichenh% * 2
      Next i%
    Else
      Color RGB(255, 255, 198) ' creme
      For i% = antwx% + zeichenbr% * 9 + fx To antwx% - zeichenbr% * 7 + fx Step -zeichenbr%
        PBox i%, antwy% + Ceil(2 * fy) + zeichenh% * 2, i% + zeichenbr% - 2 * fx, antwy% + zeichenh% * 3
      Next i%
    EndIf
  Until stelle_b| = Len(zb$)
  antwx% = Int(41 * fx + vx%) + zeichenbr% * 18
  If antwy% < Int(30 * fy + vy%) + zeichenh%                      ' Null am Ende von zb$
    If stufe| = 3 And Len(zb$) > 1 And Right$(zb$) = "0"
      eingabe_$ = teilantwort$(1)
      For i% = 1 To Len(zb$) - 1
        eingabe_$ = eingabe_$ + "0"
      Next i%
      Repeat
        Sleep
        ink$ = InKey$
      Until ink$ = Chr$(13)
      GoTo weiter1
    EndIf
    f7:
    Repeat
      Sleep
      antw$ = InKey$
    Until Asc(antw$) > 47 And Asc(antw$) < 58 Or (Len(antw$) = 2 And (Asc(Right$(antw$)) = 119 Or Asc(Right$(antw$)) = 112)) Or antw$ = Chr$(13)
    If Len(antw$) = 2 And Asc(Right$(antw$)) = 112
      If hilfe| = 2
        hilfe| = 1
      Else
        hilfe| = 2
        hilferuf| = 1
      EndIf
      GoTo f7
    EndIf
    If Len(antw$) = 2 And Asc(Right$(antw$)) = 119
      ende| = 1
      GoTo ende49 '  kontrolle
    EndIf
    If antw$ <> Chr$(13)
      SetFont schrift1%
      If antw$ = "0"
        falsch
        Text Int(42 * fx + vx%), 300 * fy + vy%, richt$
        Text Int(42 * fx + vx%), 325 * fy + vy%, "Null vor dem Ergebnis weg!"
        Repeat
          Sleep
        Until InKey$ <> ""
      Else
        falsch
        Text Int(42 * fx + vx%), 300 * fy + vy%, du$ + "zu weit gerechnet!"
        SetFont schrift3%
        Repeat
          Sleep
        Until InKey$ <> ""
        GoTo neu7
      EndIf
      SetFont schrift3%
    EndIf
  Else If antw$ <> Chr$(13)
    Color RGB(0, 0, 0) ' schwarz
    DefLine 0, fy
    Line Int(41 * fx + vx%) + zeichenbr% * 15 - TxtLen(za$) - TxtLen(zb$), antwy% + fy + zeichenh%, Int(41 * fx + vx%) + zeichenbr% * 18, antwy% + fy + zeichenh%
    DefLine    0, 1
    Clr eingabe_$
    Clr stelle_a|
    ArrayFill uebertrag%(), 0
    For i% = 1 To Len(zb$)
      teilantwort$(Len(zb$) + 1 - i%) = Trim$(Str$(Val(teilantwort$(Len(zb$) + 1 - i%)) * 10 ^ (i% - 1)))
    Next i%
    Repeat                            ' Addieren der Ergebnisse
      PeekEvent
      Inc stelle_a|
      If stelle_a| <= Len(antwort_$)
        Color RGB(255, 0, 0) ' rot
        Box antwx% - Int(fx), antwy% + 4 * fy + zeichenh%, antwx% + Int(fx) - zeichenbr%, antwy% + zeichenh% * 2 ' Kursor
      EndIf
      f8:
      If hilfe| = 2
        SetFont schrift1%
        Color RGB(0, 0, 0) ' schwarz
        If einzelner| = 1
          Text Int(42 * fx + vx%), 300 * fy + vy%, "Addiere die Zahlen und gib die"
        Else
          Text Int(42 * fx + vx%), 300 * fy + vy%, "Addiert die Zahlen und gebt die"
        EndIf
        Text Int(42 * fx + vx%), 325 * fy + vy%, "letzte Ziffer des Ergebnisses ein!"
        SetFont schrift3%
      EndIf
      Repeat
        Sleep
        antw$ = InKey$
      Until Asc(antw$) > 47 And Asc(antw$) < 58 Or (Len(antw$) = 2 And (Asc(Right$(antw$)) = 119 Or Asc(Right$(antw$)) = 112)) Or antw$ = Chr$(13)
      If Len(antw$) = 2 And Asc(Right$(antw$)) = 112
        If hilfe| = 2
          hilfe| = 1
          abdecken
        Else
          hilfe| = 2
          hilferuf| = 1
        EndIf
        GoTo f8
      EndIf
      If antw$ = Chr$(13)                            ' Return
        If (eingabe_$ = "" And stelle_b| < 2) Or Len(eingabe_$) >= Len(antwort_$)
          GoTo weiter1
        Else
          GoTo neu7
        EndIf
      EndIf
      Color RGB(0, 0, 0) ' schwarz
      abfrage
      If ende| = 1
        GoTo ende49
      EndIf
      If Len(eingabe_$) <= Len(antwort_$)
        If Right$(eingabe_$, stelle_a|) <> Right$(antwort_$, stelle_a|)
          abdecken
          Color RGB(255, 0, 0) ' rot
          Box antwx% - zeichenbr%, Int(30 * fy + vy%) + zeichenh%, antwx%, antwy% + 21 * fy
          falsch
          SetFont schrift1%
          Color RGB(0, 0, 0) ' schwarz
          If einzelner| = 1
            Text Int(42 * fx + vx%), 300 * fy + vy%, "Addiere die eingerahmten Zahlen und gib"
          Else
            Text Int(42 * fx + vx%), 300 * fy + vy%, "Addiert die eingerahmten Zahlen und gebt"
          EndIf
          Text Int(42 * fx + vx%), 325 * fy + vy%, "die letzte Ziffer des Ergebnisses ein!"
          If uebertrag%(stelle_a| - 1) <> 0
            SetFont schrift0%
            Color RGB(200, 0, 0) ' dunkelrot
            Text antwx% - 11 * fx + vx%, antwy% + Int(fy + vy%) + zeichenh% * 2, Trim$(Str$(uebertrag%(stelle_a| - 1)))
            Color RGB(255, 0, 0) ' rot
            Box antwx% - zeichenbr% - fx + vx%, antwy% + Int(fy + vy%) + zeichenh% * 2, antwx% - fx + vx%, antwy% + Int(fy + vy%) + zeichenh% * 3
            Color RGB(0, 0, 0) ' schwarz
          EndIf
          SetFont schrift3%
          Inc fehlermal|
          Repeat
            Sleep
          Until InKey$ <> ""
          If Len(eingabe_$) = Len(antwort_$)
            falsch1| = 1
            fehler| = 1
            kontrolle
          EndIf
          GoTo neu7
        EndIf
        Clr xxx$
        For i% = 1 To Len(zb$)
          xxx$ = Trim$(Str$(Val(xxx$) + Val(Right$(teilantwort$(i%), stelle_a|))))
        Next i%
        If Len(xxx$) > stelle_a|
          uebertrag%(stelle_a|) = Val(Left$(xxx$))
          If hilfe| = 2 Or falsch1| > 0
            SetFont schrift0%
            Color RGB(200, 0, 0) ' dunkelrot
            Text antwx% - 11 * fx - zeichenbr%, antwy% + Int(fy) + zeichenh% * 2, Trim$(Str$(uebertrag%(stelle_a|)))
            Color RGB(0, 0, 0) ' schwarz
            SetFont schrift3%
          EndIf
        EndIf
      EndIf
      Sub antwx%, zeichenbr%
      If (hilfe| = 2 Or falsch1| > 0) And Len(eingabe_$) = Len(antwort_$)
        Color RGB(255, 255, 198) ' creme
        For i% = antwx% + zeichenbr% * 9 + fx To antwx% - zeichenbr% * 7 + fx Step -zeichenbr%
          PBox i%, antwy% + Ceil(2 * fy) + zeichenh% * 2, i% + zeichenbr% - 2 * fx, antwy% + zeichenh% * 3
        Next i%
      EndIf
    Until Len(eingabe_$) > Len(antwort_$)
    weiter1:
    If Len(eingabe_$) > Len(antwort_$)
      SetFont schrift1%
      Color RGB(0, 0, 0) ' schwarz
      If Left$(eingabe_$) = "0"
        falsch
        SetFont schrift1%
        Text Int(42 * fx + vx%), 300 * fy + vy%, richt$
        Text Int(42 * fx + vx%), 325 * fy + vy%, "Null vor dem Ergebnis weg!"
        SetFont schrift3%
        Repeat
          Sleep
        Until InKey$ <> ""
      Else
        falsch
        SetFont schrift1%
        Text Int(42 * fx + vx%), 300 * fy + vy%, du$ + "zu weit gerechnet!"
        SetFont schrift3%
        Repeat
          Sleep
        Until InKey$ <> ""
        GoTo neu7
      EndIf
    EndIf
  EndIf
  ende49:
Return
>Procedure a50                       ' schriftlich dividieren
  Clr rest50%
  grenze% = 10
  neu8:
  Color RGB(255, 255, 198) ' creme
  PRBox 38 * fx + vx%, 31 * fy + vy% + 11 * zeichenh%, 510 * fx + vx%, 464 * fy + vy%     ' genaue Textabdeckung unter Rechenhäuschen
  DefLine 0, 1
  Color RGB(0, 190, 255) ' hell blaugrün
  Line 11 * fx + vx%, Int(30 * fy + vy%) + 11 * zeichenh%, zeichenbr% * 32 + Int(41 * fx + vx%), Int(30 * fy + vy%) + 11 * zeichenh%   ' Rechenlinie waagerecht
  Clr eingabe_$
  Clr stelle_b|, textl%, linie%
  If b% = 0
    Color RGB(0, 0, 0) ' schwarz
    SetFont schrift1%
    Text Int(42 * fx + vx%), 300 * fy + vy%, "Nicht durch Null teilen!"
    SetFont schrift3%
    jz# = oTimer
    Repeat
      PeekEvent
      zeitneu# = oTimer
    Until zeitneu# > jz# + 1000
    Repeat
      PeekEvent
    Until _Mess = 0
    zugross| = 1
    GoTo ende50
  EndIf
  For i% = 1 To 27
    lin%(i%) = 0
  Next i%
  antwort% = Div(a%, b%)
  rest% = a% - b% * antwort%
  antwort_$ = Trim$(Str$(antwort%))
  antwx% = Int(41 * fx + vx%) + zeichenbr% * 5 + TxtLen(za$ + zb$)
  antwy% = Int(29 * fy + vy%)
  antwy1% = Int(29 * fy + vy%) + zeichenh%
  saeule
  Color RGB(0, 0, 0) ' schwarz
  Text Int(41 * fx + vx%), Int(29 * fy + vy%), za$ + " : " + zb$ + " = "
  Clr teil$, i%
  Repeat                                                       'Teilen
    PeekEvent
    Inc i%
    teil$ = teil$ + Mid$(za$, i%, 1)
  Until Val(teil$) >= Val(zb$) Or antwort% = 0
  stelle_a| = Len(teil$)
  Repeat
    PeekEvent
    Inc stelle_b|
    antwx1% = Int(41 * fx + vx%) + stelle_a| * zeichenbr%
    Add antwx%, zeichenbr%
    If stelle_a| <= Len(za$)
      Color RGB(255, 0, 0) ' rot
      Box antwx% + 2 * fx, antwy% + 4 * fy, antwx% + zeichenbr% - 2 * fx, antwy% + zeichenh%
    EndIf
    f9:
    If (hilfe| = 2 Or falsch1| > 0) And eingabe_$ < antwort_$
      Color RGB(255, 0, 0) ' rot
      Box Int(41 * fx + vx%) + stelle_a| * zeichenbr% - Len(teil$) * zeichenbr%, antwy1% + Ceil(fy) - zeichenh%, Int(41 * fx + vx%) + stelle_a| * zeichenbr%, antwy1% + Ceil(fy)
      Box Int(41 * fx + vx%) + TxtLen(za$) + zeichenbr% * 3, Int(30 * fy + vy%), Int(41 * fx + vx%) + TxtLen(za$ + zb$) + zeichenbr% * 3, Int(30 * fy + vy%) + zeichenh%
      Color RGB(255, 255, 198) ' creme
      PRBox 38 * fx + vx%, 374 * fy + vy%, 510 * fx + vx%, 464 * fy + vy%     ' Textabdeckung
      Color RGB(0, 0, 0) ' schwarz
      SetFont schrift1%
      Text Int(42 * fx + vx%), 375 * fy + vy%, "Wie viele erhält jeder?"
      SetFont schrift3%
    EndIf
    Repeat
      Sleep
      antw$ = InKey$
    Until Asc(antw$) > 47 And Asc(antw$) < 58 Or (Len(antw$) = 2 And (Asc(Right$(antw$)) = 119 Or Asc(Right$(antw$)) = 112) Or antw$ = Chr$(13))
    If Len(antw$) = 2 And Asc(Right$(antw$)) = 112
      If hilfe| = 2
        hilfe| = 1
      Else
        hilfe| = 2
        hilferuf| = 1
      EndIf
      GoTo f9
    EndIf
    Color RGB(0, 190, 255) ' hell blaugrün
    Box Int(41 * fx + vx%) + stelle_a| * zeichenbr% - TxtLen(teil$), antwy1% + Ceil(fy) - zeichenh%, Int(41 * fx + vx%) + stelle_a| * zeichenbr%, antwy1% + Ceil(fy)
    Box Int(41 * fx + vx%) + TxtLen(za$) + zeichenbr% * 3, Int(30 * fy + vy%), Int(41 * fx + vx%) + TxtLen(za$ + zb$) + zeichenbr% * 3, Int(30 * fy + vy%) + zeichenh%
    Color RGB(0, 0, 0) ' schwarz
    DefLine 0, fy
    For i% = 1 To linie% Step 3
      Line lin%(i%), lin%(i% + 1), lin%(i% + 2), lin%(i% + 1)
    Next i%
    DefLine 0, 1
    If textl% > 0 And stufe| = 3 And Right$(eingabe_$) = "0"
      Inc l%
      If l% = 1
        t% = textl%
      EndIf
    EndIf
    Exit If antw$ = Chr$(13)                            ' Return
    If Len(antw$) = 2 And Asc(Right$(antw$)) = 119         ' F8
      ende| = 1
      GoTo ende50 '  kontrolle
    EndIf
    Color RGB(255, 255, 198) ' creme
    Box antwx% + 2 * fx, antwy% + 4 * fy, antwx% + zeichenbr% - 2 * fx, antwy% + zeichenh%
    eingabe_$ = eingabe_$ + antw$
    Color RGB(0, 0, 0) ' schwarz
    Text antwx%, antwy%, antw$
    If Len(eingabe_$) <= Len(antwort_$)
      If eingabe_$ <> Left$(antwort_$, stelle_b|)
        falsch
        Color RGB(0, 170, 0) ' grün
        If Left$(teil$) = "0"
          teil1$ = Right$(teil$, Len(teil$) - 1)
        Else
          teil1$ = teil$
        EndIf
        Color RGB(255, 0, 0) ' rot
        Box Int(41 * fx + vx%) + stelle_a| * zeichenbr% - TxtLen(teil$), antwy1% + Ceil(fy) - zeichenh%, Int(41 * fx + vx%) + stelle_a| * zeichenbr%, antwy1% + Ceil(fy)
        Box Int(41 * fx + vx%) + TxtLen(za$) + zeichenbr% * 3, Int(30 * fy + vy%), Int(41 * fx + vx%) + TxtLen(za$ + zb$) + zeichenbr% * 3, Int(30 * fy + vy%) + zeichenh%
        Color RGB(0, 0, 0) ' schwarz
        SetFont schrift1%
        r$ = "Wie viele erhält jeder?   " + rechne$ + ":   " + teil1$ + " : " + zb$ + " = "
        Text Int(42 * fx + vx%), 375 * fy + vy%, r$
        Color RGB(255, 0, 0) ' rot
        Box Int(42 * fx + vx%) + TxtLen(r$), 378 * fy + vy%, Int(52 * fx + vx%) + TxtLen(r$), 391 * fy + vy%
        SetFont schrift3%
        Clr teil1$
        Repeat
          Sleep
        Until InKey$ <> ""
        If Len(eingabe_$) = Len(antwort_$) And rest% = 0
          falsch1| = 1
          fehler| = 1
          kontrolle
        EndIf
        GoTo neu8
      EndIf
      a1% = antwx1%
      Color RGB(0, 190, 255) ' hell blaugrün
      For j% = 1 To Len(teil$)                ' Rechenhäuschen nachzeichnen
        Box a1% + (1 - j%) * zeichenbr%, antwy1% + Ceil(fy), a1% + (2 - j%) * zeichenbr%, antwy1% + Ceil(fy) + zeichenh%
        Box a1% + (1 - j%) * zeichenbr%, antwy1% + Ceil(fy) + zeichenh%, a1% + (2 - j%) * zeichenbr%, antwy1% + Ceil(fy) + zeichenh% * 2
        Box a1% - j% * zeichenbr%, antwy1% + Ceil(fy), a1% + (1 - j%) * zeichenbr%, antwy1% + Ceil(fy) + zeichenh%
        Box a1% - j% * zeichenbr%, antwy1% + Ceil(fy) + zeichenh%, a1% + (1 - j%) * zeichenbr%, antwy1% + Ceil(fy) + zeichenh% * 2
      Next j%
      If stufe| < 3 Or (stufe| = 3 And Right$(eingabe_$) <> "0")
        mal$ = Trim$(Str$(b% * Val(Mid$(antwort_$, stelle_b|, 1))))      ' Malnehmen
        Clr m$
        Repeat
          PeekEvent
          Color RGB(255, 0, 0) ' rot
          If stufe| = 3
            Box antwx1% + 2 * fx - zeichenbr%, antwy1% + 4 * fy, antwx1% - 2 * fx, antwy1% + zeichenh%
          Else
            Box antwx1% + 2 * fx - TxtLen(mal$), antwy1% + 4 * fy, antwx1% - TxtLen(mal$) + zeichenbr% - 2 * fx, antwy1% + zeichenh%
          EndIf
          f10:
          If hilfe| = 2 Or falsch1| > 0
            Color RGB(255, 0, 0) ' rot
            Box Int(41 * fx + vx%) + TxtLen(za$) + zeichenbr% * 3, Int(30 * fy + vy%), Int(41 * fx + vx%) + TxtLen(za$ + zb$) + zeichenbr% * 3, Int(30 * fy + vy%) + zeichenh%
            Box Int(41 * fx + vx%) + TxtLen(zb$ + za$ + eingabe_$) + zeichenbr% * 5, Int(30 * fy + vy%), Int(41 * fx + vx%) + TxtLen(zb$ + za$ + eingabe_$) + zeichenbr% * 6, Int(30 * fy + vy%) + zeichenh%
            Color RGB(255, 255, 198) ' creme
            PRBox 38 * fx + vx%, 374 * fy + vy%, 510 * fx + vx%, 464 * fy + vy%     ' Textabdeckung
            Color RGB(0, 0, 0) ' schwarz
            SetFont schrift1%
            Text Int(42 * fx + vx%), 375 * fy + vy%, "Wie viele haben alle zusammen erhalten?"
            SetFont schrift3%
          EndIf
          Repeat
            Sleep
            antw$ = InKey$
          Until Asc(antw$) > 47 And Asc(antw$) < 58 Or (Len(antw$) = 2 And (Asc(Right$(antw$)) = 119 Or Asc(Right$(antw$)) = 112)) Or antw$ = Chr$(13) Or antw$ = Chr$(8)
          If Len(antw$) = 2 And Asc(Right$(antw$)) = 112 ' F1
            If hilfe| = 2
              hilfe| = 1
              Color RGB(255, 255, 198) ' creme
              PRBox 38 * fx + vx%, 374 * fy + vy%, 510 * fx + vx%, 464 * fy + vy%     ' Textabdeckung
            Else
              hilfe| = 2
              hilferuf| = 1
            EndIf
            GoTo f10
          EndIf
          Color RGB(0, 190, 255) ' hell blaugrün
          Box Int(41 * fx + vx%) + TxtLen(za$) + zeichenbr% * 3, Int(30 * fy + vy%), Int(41 * fx + vx%) + TxtLen(za$ + zb$) + zeichenbr% * 3, Int(30 * fy + vy%) + zeichenh%
          Box Int(41 * fx + vx%) + TxtLen(zb$ + za$ + eingabe_$) + zeichenbr% * 5, Int(30 * fy + vy%), Int(41 * fx + vx%) + TxtLen(zb$ + za$ + eingabe_$) + zeichenbr% * 6, Int(30 * fy + vy%) + zeichenh%
          Color RGB(0, 0, 0) ' schwarz
          DefLine 0, fy
          For i% = 1 To linie% Step 3
            Line lin%(i%), lin%(i% + 1), lin%(i% + 2), lin%(i% + 1)
          Next i%
          DefLine 0, 1
          Exit If antw$ = Chr$(13)                            ' Return
          Color RGB(255, 255, 198) ' creme
          If Len(antw$) = 2 And Asc(Right$(antw$)) = 119         ' F8
            ende| = 1
            GoTo ende50
          Else If stufe| = 3
            If antw$ = Chr$(8)                                    ' Backspace
              If Len(m$) > 0
                m$ = Right$(m$, Len(m$) - 1)
                Color RGB(255, 255, 198) ' creme
                Box antwx1% + 2 * fx - zeichenbr%, antwy1% + 4 * fy, antwx1% - 2 * fx, antwy1% + zeichenh%
                Add antwx1%, zeichenbr%
                PBox antwx1% + 2 * fx - zeichenbr%, antwy1% + 4 * fy, antwx1% - 2 * fx, antwy1% + zeichenh%
              EndIf
            Else If Asc(antw$) > 47 And Asc(antw$) < 58
              m$ = antw$ + m$
              Color RGB(255, 255, 198) ' creme
              Box antwx1% + 2 * fx - zeichenbr%, antwy1% + 4 * fy, antwx1% - 2 * fx, antwy1% + zeichenh%
              Color RGB(0, 0, 0) ' schwarz
              Text antwx1% - zeichenbr%, antwy1%, antw$
              Sub antwx1%, zeichenbr%
            EndIf
          Else If stufe| <> 3
            If antw$ = Chr$(8)                                 ' Backspace
              If Len(m$) > 0
                m$ = Left$(m$, Len(m$) - 1)
                Color RGB(255, 255, 198) ' creme
                Box antwx1% + fx - TxtLen(mal$), antwy1% + 4 * fy, antwx1% - TxtLen(mal$) + zeichenbr% - 2 * fx, antwy1% + zeichenh%
                Sub antwx1%, zeichenbr%
                PBox antwx1% + Int(fx) - TxtLen(mal$), antwy1% + 4 * fy, antwx1% - TxtLen(mal$) + zeichenbr% - 2 * fx, antwy1% + zeichenh%
              EndIf
            Else If Asc(antw$) > 47 And Asc(antw$) < 58
              Color RGB(255, 255, 198) ' creme
              Box antwx1% + 2 * fx  - TxtLen(mal$), antwy1% + 4 * fy, antwx1% - TxtLen(mal$) + zeichenbr% - 2 * fx, antwy1% + zeichenh%
              Color RGB(0, 0, 0) ' schwarz
              Text antwx1% - TxtLen(mal$), antwy1%, antw$
              m$ = m$ + antw$
              Add antwx1%, zeichenbr%
            EndIf
          EndIf
        Until Len(m$) = Len(mal$)
        If m$ <> mal$
          falsch
          Color RGB(255, 0, 0) ' rot
          Box Int(41 * fx + vx%) + TxtLen(za$) + zeichenbr% * 3, Int(30 * fy + vy%), Int(41 * fx + vx%) + TxtLen(za$ + zb$) + zeichenbr% * 3, Int(30 * fy + vy%) + zeichenh%
          Box Int(41 * fx + vx%) + TxtLen(zb$ + za$ + eingabe_$) + zeichenbr% * 5, Int(30 * fy + vy%), Int(41 * fx + vx%) + TxtLen(zb$ + za$ + eingabe_$) + zeichenbr% * 6, Int(30 * fy + vy%) + zeichenh%
          Color RGB(0, 0, 0) ' schwarz
          SetFont schrift1%
          r$ = rechne$ + ":   " + Right$(eingabe_$) + " · " + zb$ + " = "
          Text Int(42 * fx + vx%), 375 * fy + vy%, "Wie viele haben alle zusammen erhalten? "
          Text Int(42 * fx + vx%), 395 * fy + vy%, r$
          Color RGB(255, 0, 0) ' rot
          Box Int(42 * fx + vx%) + TxtLen(r$), 398 * fy + vy%, 52 * fx + vx% + TxtLen(r$), 411 * fy + vy%
          SetFont schrift3%
          Clr teil1$
          Repeat
            PeekEvent
          Until InKey$ <> ""
          GoTo neu8
        EndIf
        antwx1% = 41 * fx + vx% + stelle_a| * zeichenbr% - zeichenbr%                                                      ' Abziehen
        Color RGB(0, 0, 0) ' schwarz
        DefLine 0, fy
        lin%(linie% + 1) = antwx1% - TxtLen(teil$) + zeichenbr%
        lin%(linie% + 2) = antwy1% + fy + zeichenh%
        lin%(linie% + 3) = antwx1% + zeichenbr%
        Line lin%(linie% + 1), lin%(linie% + 2), lin%(linie% + 3), lin%(linie% + 2)
        DefLine 0, 1
        Add linie%, 3
        Add antwy1%, zeichenh%
        sub$ = Trim$(Str$(Val(teil$) - Val(mal$)))
        Clr s_$
        a1% = antwx1%
        Repeat
          PeekEvent
          Color RGB(255, 0, 0) ' rot
          Box antwx1% + 2 * fx, antwy1% + 4 * fy, antwx1% + zeichenbr% - 2 * fx, antwy1% + zeichenh%
          f11:
          If hilfe| = 2 Or falsch1| > 0
            Color RGB(255, 0, 0) ' rot
            If _Y < 601 Or _Y > 1024  ' bis 800 * 600 oder nach 1280 * 1024
              Box a1% + zeichenbr% - TxtLen(teil$), antwy1% + Ceil(fy) - zeichenh% * 2, a1% + zeichenbr%, antwy1% + Ceil(fy)
            Else
              Box a1% - Int(fx) + zeichenbr% - TxtLen(teil$), antwy1% + fy - zeichenh% * 2, a1% - Int(fx) + zeichenbr%, antwy1% + fy
            EndIf
            Color RGB(255, 255, 198) ' creme
            PRBox 38 * fx + vx%, 374 * fy + vy%, 510 * fx + vx%, 464 * fy + vy%     ' Textabdeckung
            Color RGB(0, 0, 0) ' schwarz
            SetFont schrift1%
            Text Int(42 * fx + vx%), 375 * fy + vy%, "Wie viele bleiben übrig?"
            SetFont schrift3%
          EndIf
          Repeat
            Sleep
            antw$ = InKey$
          Until Asc(antw$) > 47 And Asc(antw$) < 58 Or (Len(antw$) = 2 And (Asc(Right$(antw$)) = 119 Or Asc(Right$(antw$)) = 112)) Or antw$ = Chr$(13) Or antw$ = Chr$(8)
          If Len(antw$) = 2 And Asc(Right$(antw$)) = 112
            If hilfe| = 2
              hilfe| = 1
              Color RGB(255, 255, 198) ' creme
              PRBox 38 * fx + vx%, 374 * fy + vy%, 510 * fx + vx%, 464 * fy + vy%     ' Textabdeckung
            Else
              hilfe| = 2
              hilferuf| = 1
            EndIf
            GoTo f11
          EndIf
          Color RGB(0, 190, 255) ' hell blaugrün
          If _Y < 601 Or _Y > 1024  ' bis 800 * 600 oder nach 1280 * 1024
            Box a1% + zeichenbr% - TxtLen(teil$), antwy1% + Ceil(fy) - zeichenh% * 2, a1% + zeichenbr%, antwy1% + Ceil(fy)
          Else
            Box a1% + zeichenbr% - TxtLen(teil$) - Int(fx), antwy1% + fy - zeichenh% * 2, a1% + zeichenbr% - Int(fx), antwy1% + fy
          EndIf
          Color RGB(0, 0, 0) ' schwarz
          DefLine 0, fy
          For i% = 1 To linie% Step 3
            Line lin%(i%), lin%(i% + 1), lin%(i% + 2), lin%(i% + 1)
          Next i%
          DefLine 0, 1
          Exit If antw$ = Chr$(13)                            ' Return
          If Len(antw$) = 2 And Asc(Right$(antw$)) = 119         ' F8
            ende| = 1
            GoTo ende50 '  kontrolle
          Else If antw$ = Chr$(8)                                 ' Backspace
            If Len(s_$) > 0
              s_$ = Right$(s_$, Len(s_$) - 1)
              Color RGB(255, 255, 198) ' creme
              PBox antwx1%, antwy1% + 4 * fy, antwx1% + zeichenbr% - 2 * fx, antwy1% + zeichenh%
              Add antwx1%, zeichenbr%
              PBox antwx1%, antwy1% + 4 * fy, antwx1% + zeichenbr% - 2 * fx, antwy1% + zeichenh%
            EndIf
          Else If Asc(antw$) > 47 And Asc(antw$) < 58
            s_$ = antw$ + s_$
            Color RGB(255, 255, 198) ' creme
            Box antwx1% + 2 * fx, antwy1% + 4 * fy, antwx1% + zeichenbr% - 2 * fx, antwy1% + zeichenh%
            Color RGB(0, 0, 0) ' schwarz
            Text antwx1%, antwy1%, antw$
            Sub antwx1%, zeichenbr%
          EndIf
        Until Len(s_$) = Len(sub$)
        Inc stelle_a|
        antwx1% = 41 * fx + vx% + stelle_a| * zeichenbr% - zeichenbr%
        If s_$ <> sub$
          falsch
          Color RGB(255, 0, 0) ' rot
          Box a1% - Int(fx) + zeichenbr% - Len(teil$) * zeichenbr%, antwy1% + fy - zeichenh% * 2, a1% - Int(fx) + zeichenbr%, antwy1% + fy
          Color RGB(255, 255, 198) ' creme
          PRBox 38 * fx + vx%, 372 * fy + vy%, 510 * fx + vx%, 464 * fy + vy%     ' Textabdeckung
          Color RGB(0, 0, 0) ' schwarz
          SetFont schrift1%
          r$ = "Wie viele bleiben übrig?  " + rechne$ + ":   " + teil$ + " - " + mal$ + " = "
          Text Int(42 * fx + vx%), 375 * fy + vy%, r$
          Color RGB(255, 0, 0) ' rot
          Box Int(42 * fx + vx%) + TxtLen(r$), 378 * fy + vy%, Int(52 * fx + vx%) + TxtLen(r$), 391 * fy + vy%
          Color RGB(0, 0, 0) ' schwarz
          Clr s_$
          SetFont schrift3%
          Repeat
            Sleep
          Until InKey$ <> ""
          GoTo neu8
        EndIf
        Clr a1%
      Else
        Inc stelle_a|
        Sub antwy1%, 20
      EndIf
      If Len(eingabe_$) < Len(antwort_$)                       'Wechseln
        Color RGB(255, 0, 0) ' rot
        Box antwx1% + 2 * fx, antwy1% + 4 * fy, antwx1% + zeichenbr% - 2 * fx, antwy1% + zeichenh%
        f12:
        If hilfe| = 2 Or falsch1| > 0
          Color RGB(255, 255, 198) ' creme
          PRBox 38 * fx + vx%, 374 * fy + vy%, 510 * fx + vx%, 464 * fy + vy%     ' Textabdeckung
          Color RGB(255, 0, 0) ' rot
          If _Y < 601 Or _Y > 1024  ' bis 800 * 600 oder nach 1280 * 1024
            Box antwx1%, Int(30 * fy + vy%), antwx1% + zeichenbr%, Int(30 * fy + vy%) + zeichenh%
          Else
            Box antwx1% - Int(fx), Int(30 * fy + vy%), antwx1% - Int(fx) + zeichenbr%, Int(30 * fy + vy%) + zeichenh%
          EndIf
          Color RGB(0, 0, 0) ' schwarz
          SetFont schrift1%
          If einzelner| = 1
            Text Int(42 * fx + vx%), 375 * fy + vy%, "Wechsle durch Anfügen der eingerahmten " + Mid$(za$, stelle_a|, 1) + "!"
          Else
            Text Int(42 * fx + vx%), 375 * fy + vy%, "Wechselt durch Anfügen der eingerahmten " + Mid$(za$, stelle_a|, 1) + "!"
          EndIf
          SetFont schrift3%
        EndIf
        Repeat
          Sleep
          antw$ = InKey$
        Until Asc(antw$) > 47 And Asc(antw$) < 58 Or (Len(antw$) = 2 And (Asc(Right$(antw$)) = 119 Or Asc(Right$(antw$)) = 112)) Or antw$ = Chr$(13)
        If Len(antw$) = 2 And Asc(Right$(antw$)) = 112
          If hilfe| = 2
            hilfe| = 1
            Color RGB(255, 255, 198) ' creme
            PRBox 38 * fx + vx%, 374 * fy + vy%, 510 * fx + vx%, 464 * fy + vy%     ' Textabdeckung
          Else
            hilfe| = 2
            hilferuf| = 1
          EndIf
          GoTo f12
        EndIf
        If Len(antw$) = 2 And Asc(Right$(antw$)) = 119         ' F8
          ende| = 1
          GoTo ende50
        EndIf
        Color RGB(0, 190, 255) ' hell blaugrün
        If _Y < 601 Or _Y > 1024  ' bis 800 * 600 oder nach 1280 * 1024
          Box antwx1%, Int(30 * fy + vy%), antwx1% + zeichenbr%, Int(30 * fy + vy%) + zeichenh%
        Else
          Box antwx1% - Int(fx), Int(30 * fy + vy%), antwx1% - Int(fx) + zeichenbr%, Int(30 * fy + vy%) + zeichenh%
        EndIf
        If Len(antw$) = 2 And Asc(Right$(antw$)) = 119
          ende| = 1
          GoTo ende50 '    kontrolle
        EndIf
        Color RGB(255, 255, 198) ' creme
        Box antwx1% + 2 * fx, antwy1% + 4 * fy, antwx1% + zeichenbr% - 2 * fx, antwy1% + zeichenh%
        Color RGB(0, 0, 0) ' schwarz
        Text antwx1%, antwy1%, antw$
        If antw$ <> Mid$(za$, stelle_a|, 1)
          falsch
          Color RGB(255, 0, 0) ' rot
          Box antwx1% - Int(fx), Int(30 * fy + vy%), antwx1% - Int(fx) + zeichenbr%, Int(30 * fy + vy%) + zeichenh%
          Color RGB(0, 0, 0) ' schwarz
          SetFont schrift1%
          If einzelner| = 1
            r$ = "Wechsle durch Anfügen der eingerahmten " + Mid$(za$, stelle_a|, 1) + "!"
          Else
            r$ = "Wechselt durch Anfügen der eingerahmten " + Mid$(za$, stelle_a|, 1) + "!"
          EndIf
          Text Int(42 * fx + vx%), 375 * fy + vy%, r$
          SetFont schrift3%
          Repeat
            Sleep
          Until InKey$ <> ""
          GoTo neu8
        EndIf
        textl% = Len(teil$) * zeichenbr%
        If stufe| < 3 Or (stufe| = 3 And Right$(eingabe_$) <> "0")
          teil$ = sub$ + Mid$(za$, stelle_a|, 1)
        Else
          teil$ = teil$ + Mid$(za$, stelle_a|, 1)
        EndIf
        Color RGB(0, 0, 0) ' schwarz
        Text antwx1%, antwy1%, Mid$(za$, stelle_a|, 1)
        Add antwy1%, zeichenh%
      EndIf
    EndIf
  Until Len(eingabe_$) > Len(antwort_$) Or (Len(eingabe_$) = Len(antwort_$) And rest% <> 0)
  Sub antwx%, TxtLen(antwort_$) - zeichenbr%
  If Len(eingabe_$) > Len(antwort_$) And antw$ <> Chr$(13)
    falsch
    SetFont schrift1%
    Text Int(42 * fx + vx%), 375 * fy + vy%, du$ + "zu weit gerechnet!"
    SetFont schrift3%
    Repeat
      Sleep
    Until InKey$ <> ""
    GoTo neu8
  EndIf
  ende50:
Return
>Procedure geld_uhr                 '               * Geld und Uhr * art=53
  If beginn| = 0 And wahl| < 9
    Color RGB(255, 255, 198) ' creme
    PRBox 3 * fx + vx%, 3 * fy + vy%, 633 * fx + vx%, 475 * fy + vy%
    DefLine 0, 12 * fy
    DefFill 42
    PRBox 7 * fx + vx%, 8 * fy + vy%, 631 * fx + vx%, 473 * fy + vy%
    Color RGB(255, 0, 0) ' rot
    PRBox 6 * fx + vx%, 6 * fy + vy%, 632 * fx + vx%, 473 * fy + vy%
    DefFill 0
    DefLine 0, 1
    Stretch 536 * fx + vx%, 225 * fy + vy%, grins, 50 * fx, 56 * fy
    Color RGB(255, 255, 255) ' weiß
    SetFont schrift0%
    Text Int((_X - vx% - TxtLen(nam$)) / 2), 464 * fy + vy%, nam$
    SetFont schrift3%
  EndIf
  Repeat
    PeekEvent
  Until And(_Mess = 0, InKey$ = "")
  If falsch1| > 0
    hilfe| = 2
    hilferuf| = 1
  EndIf
  firstrun! = True
  If wahl| < 7
    geld
  Else If wahl| = 7 Or wahl| = 8
    uhr
  Else If wahl| > 8
    zeit
  EndIf
  DefLine 0, 1
Return
>Procedure geld                     ' art=53, wahl<7
  Clr eing$
  Color RGB(255, 255, 198) ' creme
  PBox 399 * fx + vx%, 248 * fy + vy%, 510 * fx + vx%, 420 * fy + vy%   ' Abdeckung rechts
  If hilfe| = 2
    DefLine 0, 3 * fy
    Color RGB(255, 0, 0) ' rot
    RBox 401 * fx + vx%, 380 * fy + vy%, 508 * fx + vx%, 406 * fy + vy% ' Geldanzeige
    GraphMode R2_COPYPEN, OPAQUE
    Color RGB(0, 0, 0) ' schwarz
    Text 504 * fx + vx% - TxtLen(eing$), 383 * fy + vy%, eing$
    GraphMode R2_COPYPEN, TRANSPARENT
    DefLine 0, 1
  EndIf
  neu10:
  GraphMode R2_COPYPEN, TRANSPARENT
  Clr eingabe_$, eingabe%, eing$, wert%, wert%, hoehe%, breite%
  DefMouse V:aaa%(0)        ' transparente Mausform
  Color RGB(255, 255, 198) ' creme
  PRBox 404 * fx + vx%, 382 * fy + vy%, 505 * fx + vx%, 403 * fy + vy% ' Geldanzeige leeren
  PRBox 16 * fx + vx%, 243 * fy + vy%, 394 * fx + vx%, 463 * fy + vy%   ' Theke
  Color RGB(0, 190, 255) ' hell blaugrün
  DefLine 0, 5 * fy
  RBox 15 * fx + vx%, 242 * fy + vy%, 395 * fx + vx%, 464 * fy + vy%
  DefLine 0, 1
  If beginn| = 0
    beginn| = 1
    Color RGB(0, 0, 0) ' schwarz
    SetFont schrift1%
    Text 50 * fx + vx%, 270 * fy + vy%, "Wähle Geld mit der Maus aus,"
    Text 50 * fx + vx%, 290 * fy + vy%, "halte die Taste gedrückt und"
    Text 50 * fx + vx%, 310 * fy + vy%, "schiebe das Geld auf dieses Feld!"
    Text 50 * fx + vx%, 340 * fy + vy%, "fertig:"
    Text 130 * fx + vx%, 340 * fy + vy%, "Fertig-Taste!"
    Text 50 * fx + vx%, 360 * fy + vy%, "falsch:"
    Text 130 * fx + vx%, 360 * fy + vy%, "Zurück-Taste!"
    Text 50 * fx + vx%, 390 * fy + vy%, "      jetzt die Leertaste!"
    SetFont schriftw1%
    Color RGB(255, 0, 0) ' rot
    Text 110 * fx + vx%, 341 * fy + vy%, "ò"
    Text 110 * fx + vx%, 361 * fy + vy%, "ò"
    Text 50 * fx + vx%, 391 * fy + vy%, "ò"
    Repeat
      Sleep
    Until InKey$ <> ""
  EndIf
  Color RGB(255, 255, 198) ' creme
  PRBox 16 * fx + vx%, 243 * fy + vy%, 394 * fx + vx%, 463 * fy + vy%  ' Theke
  Color RGB(0, 190, 255) ' hell blaugrün
  DefLine 0, 5 * fy
  RBox 15 * fx + vx%, 242 * fy + vy%, 395 * fx + vx%, 464 * fy + vy%
  DefLine 0, fy
  Color RGB(0, 0, 0) ' schwarz
  SetFont schrift1%
  If geldwahl| = 1
    DM
  Else If geldwahl| = 2
    euro_
  EndIf
  antwort_$ = Trim$(Str$(antwort%))
  Repeat
    PeekEvent
  Until MouseK = 0
  Repeat
    PeekEvent
    DefMouse 0
    f15:
    Repeat
      Sleep
      Mouse x%, y%, k%
      ii$ = InKey$
    Until k% = 1 Or ii$ = Chr$(13) Or ii$ = Chr$(8) Or (Len(ii$) > 1 And (Asc(Right$(ii$)) = 119 Or Asc(Right$(ii$)) = 112)) Or ii$ = "€"
    Exit If ii$ = Chr$(13) Or (Len(ii$) > 1 And Asc(Right$(ii$)) = 119) ' Return, F8
    If Len(ii$) > 1 And Asc(Right$(ii$)) = 112  ' F1-Taste
      If hilfe| = 1
        hilfe| = 2
        hilferuf| = 1
        DefLine 0, 3 * fy
        Color RGB(255, 0, 0) ' rot
        RBox 401 * fx + vx%, 380 * fy + vy%, 508 * fx + vx%, 406 * fy + vy%
        GraphMode R2_COPYPEN, OPAQUE
        Color RGB(0, 0, 0) ' schwarz
        Text 504 * fx + vx% - TxtLen(eing$), 383 * fy + vy%, eing$
        GraphMode R2_COPYPEN, TRANSPARENT
        DefLine 0, 1
      Else
        hilfe| = 1
        Color RGB(255, 255, 198) ' creme
        PRBox 399 * fx + vx%, 378 * fy + vy%, 510 * fx + vx%, 408 * fy + vy%
      EndIf
      GoTo f15
    EndIf
    If ii$ = Chr$(8)                      ' Backspace
      ~DeleteDC(h3DC%)
      firstrun! = True
      GoTo neu10
    EndIf
    If geldwahl| = 1                                           ' DM/Pf
      If wahl| = 1 Or wahl| = 4         ' Pf
        If x% > 344 * fx + vx% And x% < 383 * fx + vx% And y% > 175 * fy + vy% And y% < 214 * fy + vy% And stufe| = 3
          kopie% = p_50%
          s% = p_50x%
          wert% = 50
          hoehe% = Int(39 * fy)
          breite% = Int(39 * fx)
        Else If x% > 391 * fx + vx% And x% < 430 * fx + vx% And y% > 175 * fy + vy% And y% < 214 * fy + vy%
          kopie% = p_10%
          s% = p_10x%
          wert% = 10
          hoehe% = Int(40 * fy)
          breite% = Int(40 * fx)
        Else If x% > 439 * fx + vx% And x% < 473 * fx + vx% And y% > 175 * fy + vy% And y% < 209 * fy + vy%
          kopie% = p_5%
          s% = p_5x%
          wert% = 5
          hoehe% = Int(35 * fy)
          breite% = Int(35 * fx)
        Else If x% > 463 * fx + vx% And x% < 499 * fx + vx% And y% > 210 * fy + vy% And y% < 246 * fy + vy%
          kopie% = p_2%
          s% = p_2x%
          wert% = 2
          hoehe% = Int(37 * fy)
          breite% = Int(37 * fx)
        Else If x% > 423 * fx + vx% And x% < 455 * fx + vx% And y% > 213 * fy + vy% And y% < 245 * fy + vy%
          kopie% = p_1%
          s% = p_1x%
          wert% = 1
          hoehe% = Int(33 * fy)
          breite% = Int(33 * fx)
        Else
          GoTo f15
        EndIf
      Else If wahl| = 2 Or wahl| = 5           ' DM
        If x% > 40 * fx + vx% And x% < 215 * fx + vx% And y% > 17 * fy + vy% And y% < 100 * fy + vy% And stufe| = 3
          FreeBmp schein%
          Get Int(40 * fx + vx%), Ceil(17 * fy + vy%), Int(215 * fx + vx%), Int(100 * fy + vy%), schein%
          wert% = 1000
          hoehe% = Int(82 * fy)
          breite% = Int(174 * fx)
        Else If x% > 220 * fx + vx% And x% < 393 * fx + vx% And y% > 17 * fy + vy% And y% < 98 * fy + vy% And stufe| = 3
          FreeBmp schein%
          Get Int(220 * fx + vx%), Ceil(17 * fy + vy%), Int(393 * fx + vx%), Int(98 * fy + vy%), schein%
          wert% = 500
          hoehe% = Int(80 * fy)
          breite% = Int(172 * fx)
        Else If x% > 400 * fx + vx% And x% < 562 * fx + vx% And y% > 17 * fy + vy% And y% < 95 * fy + vy% And stufe| = 3
          FreeBmp schein%
          Get Int(400 * fx + vx%), Ceil(17 * fy + vy%), Int(562 * fx + vx%), Int(95 * fy + vy%), schein%
          wert% = 200
          hoehe% = Int(77 * fy)
          breite% = Int(161 * fx)
        Else If x% > 40 * fx + vx% And x% < 193 * fx + vx% And y% > 100 * fy + vy% And y% < 173 * fy + vy% And stufe| > 1
          FreeBmp schein%
          Get Int(40 * fx + vx%), Int(100 * fy + vy%), Int(193 * fx + vx%), Int(173 * fy + vy%), schein%
          wert% = 100
          hoehe% = Int(72 * fy)
          breite% = Int(152 * fx)
        Else If x% > 197 * fx + vx% And x% < 346 * fx + vx% And y% > 100 * fy + vy% And y% < 173 * fy + vy% And stufe| > 1
          FreeBmp schein%
          Get Int(198 * fx + vx%), Int(100 * fy + vy%), Int(346 * fx + vx%), Int(173 * fy + vy%), schein%
          wert% = 50
          hoehe% = Int(72 * fy)
          breite% = Int(147 * fx)
        Else If x% > 350 * fx + vx% And x% < 487 * fx + vx% And y% > 100 * fy + vy% And y% < 168 * fy + vy% And (stufe| > 1 Or wahl| = 5)
          FreeBmp schein%
          Get Int(350 * fx + vx%), Int(100 * fy + vy%), Int(487 * fx + vx%), Int(168 * fy + vy%), schein%
          wert% = 20
          hoehe% = Int(67 * fy)
          breite% = Int(136 * fx)
        Else If x% > 490 * fx + vx% And x% < 619 * fx + vx% And y% > 100 * fy + vy% And y% < 165 * fy + vy%
          FreeBmp schein%
          Get Int(490 * fx + vx%), Int(100 * fy + vy%), Int(619 * fx + vx%), Int(165 * fy + vy%), schein%
          wert% = 10
          hoehe% = Int(64 * fy)
          breite% = Int(128 * fx)
        Else If x% > 40 * fx + vx% And x% < 159 * fx + vx% And y% > 175 * fy + vy% And y% < 236 * fy + vy%
          FreeBmp schein%
          Get Int(40 * fx + vx%), Int(175 * fy + vy%), Int(159 * fx + vx%), Int(236 * fy + vy%), schein%
          wert% = 5
          hoehe% = Int(60 * fy)
          breite% = Int(118 * fx)
        Else If x% > 165 * fx + vx% And x% < 224 * fx + vx% And y% > 175 * fy + vy% And y% < 234 * fy + vy%
          kopie% = d_5r%
          s% = d_5rx%
          wert% = 5
