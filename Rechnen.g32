    EndIf
    DefMouse 0
    Clr i%
    If firstrun!
      FreeBmp bild%
      Get 0, 0, _X, _Y, bild%
      firstrun! = False
      h3DC% = CreateCompatibleDC(Win_1.hDC)
    EndIf
    GraphMode R2_COPYPEN, TRANSPARENT
    h2DC% = CreateCompatibleDC(Win_1.hDC)
    If breite% < 60 * fx  ' Münzen
      hNULL% = SelectObject(h2DC%, kopie%) 'selektiert logisches DC und Bitmap
      h6DC% = CreateCompatibleDC(Win_1.hDC)
      ~SelectObject(h6DC%, s%)
    Else                  ' Geldscheine
      h6DC% = 0
      hNULL% = SelectObject(h2DC%, schein%) 'selektiert logisches DC und Bitmap
    EndIf
    h4% = CreateCompatibleBitmap(Win_1.hDC, breite%, hoehe%) 'erzeugt eine Bitmap mit Handle h4%
    h4DC% = CreateCompatibleDC(Win_1.hDC)
    ~SelectObject(h4DC%, h4%)
    ~SelectObject(h3DC%, bild%)
    h5% = CreateCompatibleBitmap(Win_1.hDC, breite% * 2, hoehe% * 2)
    h5DC% = CreateCompatibleDC(Win_1.hDC)
    ~SelectObject(h5DC%, h5%)
    Do
      f16:
      PeekEvent
      Mouse x%, y%, k%
      Exit If k% = 0
      ii$ = InKey$
      If ii$ = Chr$(8)
        GoTo neu10
      EndIf
      xx% = x% - breite%
      yy% = y% - hoehe%
      If xx% <> altx% Or yy% <> alty%
        ~BitBlt(h4DC%, 0, 0, breite%, hoehe%, h2DC%, 0, 0, SRCCOPY)
        rechtsx% = xx% + breite%
        unteny% = yy% + hoehe%
        altrechts% = altx% + breite%
        altunten% = alty% + hoehe%
        If rechtsx% < altx% Or unteny% < alty% Or yy% > altunten%
          GoTo n1
        EndIf
        If xx% < altrechts%
          If altx% > xx%
            rechtsx% = xx%
            altrechts% = breite% + altx% - xx%
          Else
            rechtsx% = altx%
            altrechts% = breite% + xx% - altx%
          EndIf
          If alty% > yy%
            unteny% = yy%
            altunten% = hoehe% + alty% - yy%
          Else
            unteny% = alty%
            altunten% = hoehe% + yy% - alty%
          EndIf
          If breite% < 60 * fx  ' Münzen
            ~BitBlt(h5DC%, 0, 0, altrechts%, altunten%, h3DC%, rechtsx%, unteny%, SRCCOPY)
            ~BitBlt(h5DC%, xx% - rechtsx%, yy% - unteny%, breite%, hoehe%, h6DC%, 0, 0, SRCAND)
            ~BitBlt(h5DC%, xx% - rechtsx%, yy% - unteny%, breite%, hoehe%, h4DC%, 0, 0, SRCPAINT)
            ~BitBlt(Win_1.hDC, rechtsx%, unteny%, altrechts%, altunten%, h5DC%, 0, 0, SRCCOPY)
          Else
            ~BitBlt(h5DC%, 0, 0, altrechts%, altunten%, h3DC%, rechtsx%, unteny%, SRCCOPY)
            ~BitBlt(h5DC%, xx% - rechtsx%, yy% - unteny%, breite%, hoehe%, h4DC%, 0, 0, SRCCOPY)
            ~BitBlt(Win_1.hDC, rechtsx%, unteny%, altrechts%, altunten%, h5DC%, 0, 0, SRCCOPY)
          EndIf
        Else
          n1:
          If breite% < 60 * fx  ' Münzen
            ~BitBlt(Win_1.hDC, xx%, yy%, breite%, hoehe%, h6DC%, 0, 0, SRCAND)
            ~BitBlt(Win_1.hDC, xx%, yy%, breite%, hoehe%, h4DC%, 0, 0, SRCPAINT)
          Else
            ~BitBlt(Win_1.hDC, xx%, yy%, breite%, hoehe%, h4DC%, 0, 0, SRCCOPY)
          EndIf
          ~BitBlt(Win_1.hDC, altx%, alty%, breite%, hoehe%, h3DC%, altx%, alty%, SRCCOPY)
        EndIf
      EndIf
      altx% = xx%
      alty% = yy%
    Loop
    If h2DC% Then ~SelectObject(h2DC%, hNULL%)
    If h4DC% Then ~SelectObject(h4DC%, hNULL%)
    If h5DC% Then ~SelectObject(h5DC%, hNULL%)
    If h6DC% Then ~SelectObject(h6DC%, hNULL%)
    ~DeleteDC(h2DC%)
    ~DeleteDC(h4DC%)
    ~DeleteDC(h5DC%)
    ~DeleteDC(h6DC%)
    FreeBmp h4%
    FreeBmp h5%
    Exit If ii$ = Chr$(13) Or (Len(ii$) > 1 And Asc(Right$(ii$)) = 119)
    If x% - breite% > 16 * fx + vx% And x% < 395 * fx + vx% And y% - hoehe% > 240 * fy + vy% And y% < 462 * fy + vy% ' Theke
      Add eingabe%, wert%
      Clr wert%
      ~BitBlt(h3DC%, 0, 0, _X, _Y, Win_1.hDC, 0, 0, SRCCOPY)
    Else
      ~BitBlt(Win_1.hDC, 0, 0, _X, _Y, h3DC%, 0, 0, SRCCOPY)
      Put 0, 0, bild%
    EndIf
    eing$ = Trim$(Str$(eingabe%))
    If wahl| = 1
      If geldwahl| = 1
        eing$ = eing$ + " Pf"
      Else
        eing$ = eing$ + " ct"
      EndIf
    Else If wahl| = 2
      If geldwahl| = 1
        eing$ = eing$ + " DM"
      Else
        eing$ = eing$ + " €"
      EndIf
    Else If wahl| = 4
      If geldwahl| = 1
        eing$ = Trim$(Str$(a% + eingabe%)) + " Pf"
      Else
        eing$ = Trim$(Str$(a% + eingabe%)) + " ct"
      EndIf
    Else If wahl| = 5
      If geldwahl| = 1
        eing$ = Trim$(Str$(a% + eingabe%)) + " DM"
      Else
        eing$ = Trim$(Str$(a% + eingabe%)) + " €"
      EndIf
    Else If wahl| = 3 Or wahl| = 6
      If wahl| = 6
        eing$ = Trim$(Str$(a% + eingabe%))
      Else
        eing$ = Trim$(Str$(eingabe%))
      EndIf
      Select Len(eing$)
      Case 1
        eing$ = "00" + eing$
      Case 2
        eing$ = "0" + eing$
      EndSelect
      If InStr(eing$, ",") = 0
        If geldwahl| = 1
          eing$ = Left$(eing$, Len(eing$) - 2) + "," + Right$(eing$, 2) + " DM"
        Else
          eing$ = Left$(eing$, Len(eing$) - 2) + "," + Right$(eing$, 2) + " €"
        EndIf
      EndIf
    EndIf
    If hilfe| = 2
      Color RGB(255, 255, 198) ' creme
      PRBox 399 * fx + vx%, 378 * fy + vy%, 510 * fx + vx%, 408 * fy + vy%
      DefLine 0, 3 * fy
      Color RGB(255, 0, 0) ' rot
      RBox 401 * fx + vx%, 380 * fy + vy%, 508 * fx + vx%, 406 * fy + vy%
      GraphMode R2_COPYPEN, OPAQUE
      Color RGB(0, 0, 0) ' schwarz
'##B#
      Text 504 * fx + vx% - TxtLen(eing$), 383 * fy + vy%, eing$
      GraphMode R2_COPYPEN, TRANSPARENT
      DefLine 0, 1
    EndIf
    beginn1| = 1
  Until ii$ = Chr$(13) Or ii$ = Chr$(8) Or (Len(ii$) > 1 And Asc(Right$(ii$)) = 119) ' F8
  If (Len(ii$) > 1 And Asc(Right$(ii$)) = 119)
    ende| = 1
  EndIf
  eingabe_$ = Trim$(Str$(eingabe%))
  DefLine 0, 1
  If h3DC% Then ~SelectObject(h3DC%, hNULL%)
  ~DeleteDC(h3DC%)
Return
>Procedure DM
