    Put Int(428 * fx + vx%), Int(183 * fy + vy%), e_2x%, SRCAND
    Put Int(428 * fx + vx%), Int(183 * fy + vy%), e_2%, SRCPAINT
    Put Int(376 * fx + vx%), Int(189 * fy + vy%), e_1x%, SRCAND
    Put Int(376 * fx + vx%), Int(189 * fy + vy%), e_1%, SRCPAINT
    Put Int(322 * fx + vx%), Int(186 * fy + vy%), c_50x%, SRCAND
    Put Int(322 * fx + vx%), Int(186 * fy + vy%), c_50%, SRCPAINT
    Put Int(270 * fx + vx%), Int(191 * fy + vy%), c_20x%, SRCAND
    Put Int(270 * fx + vx%), Int(191 * fy + vy%), c_20%, SRCPAINT
