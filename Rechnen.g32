      Stretch Int(186 * fx + vx%), Int(108 * fy + vy%), euro_20, Int(148 * fx), Int(80 * fy)
    EndIf
    Stretch Int(338 * fx + vx%), Int(108 * fy + vy%), euro_10, Int(141 * fx), Int(74 * fy), SRCCOPY
