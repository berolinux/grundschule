>Procedure uhr                      ' art=53, wahl= 7 oder 8
  neu13:
  While Len(InKey$)    ' Tastaturpuffer löschen
  Wend
  While GetAsyncKeyState(VK_RETURN) ' Tastaturpuffer löschen
  Wend
  GraphMode R2_COPYPEN, OPAQUE
  Clr eingabe_$, eingabe%, eing$
  beginn| = 1
  SetFont schrift2%
  DefMouse V:aaa%(0)        ' transparente Mausform
  zb$ = Right$(Trim$(Str$(100 + b%)), 2)
  antwort_$ = za$ + zb$
  antwort% = Val(antwort_$)
  Color RGB(255, 0, 0) ' rot
  For i% = 0 To 354 Step 6
'##B#
    PCircle 240 * fx + vx% + 180 * CosQ(i%) * fx, 230 * fy + vy% + 180 * SinQ(i%) * fy, 2 * fx
  Next i%
  Color RGB(0, 0, 235) ' blau
  For i% = 0 To 330 Step 30
    PCircle 240 * fx + vx% + 180 * CosQ(i%) * fx, 230 * fy + vy% + 180 * SinQ(i%) * fy, 4 * fx
  Next i%
  Color RGB(0, 0, 0) ' schwarz
  Text 225 * fx + vx%, 21 * fy + vy%, "12"
  Text 337 * fx + vx%, 51 * fy + vy%, "1"
  Text 115 * fx + vx%, 51 * fy + vy%, "11"
  Text 405 * fx + vx%, 120 * fy + vy%, "2"
  Text 43 * fx + vx%, 120 * fy + vy%, "10"
  Text 433 * fx + vx%, 218 * fy + vy%, "3"
  Text 35 * fx + vx%, 218 * fy + vy%, "9"
  Text 406 * fx + vx%, 313 * fy + vy%, "4"
  Text 59 * fx + vx%, 313 * fy + vy%, "8"
  Text 335 * fx + vx%, 388 * fy + vy%, "5"
  Text 130 * fx + vx%, 388 * fy + vy%, "7"
  Text 234 * fx + vx%, 415 * fy + vy%, "6"
  Color RGB(220, 220, 220) ' hellgrau
  SetFont schriftw1%
  Text 355 * fx + vx%, 30 * fy + vy%, "ò"
  SetFont schrift1%
  Text 505 * fx + vx%, 60 * fy + vy%, "s: schnell"
  Text 505 * fx + vx%, 85 * fy + vy%, "m: mittel"
  Text 505 * fx + vx%, 110 * fy + vy%, "l: langsam"
  Text 375 * fx + vx%, 31 * fy + vy%, "Fertig-Taste bei"
  DefLine 0, 3 * fy
  Color RGB(255, 0, 0) ' rot
  RBox 512 * fx + vx%, 28 * fy + vy%, 606 * fx + vx%, 54 * fy + vy%
  Color RGB(255, 255, 198) ' creme
  PBox 517 * fx + vx%, 32 * fy + vy%, 600 * fx + vx%, 50 * fy + vy%
  Color RGB(0, 0, 0) ' schwarz
  Text 540 * fx + vx% - TxtLen(za$), 31 * fy + vy%, za$ + "." + zb$ + " Uhr"
  DefLine 0, 1
  If falsch1| > 0
    Get 80 * fx + vx%, 330 * fy + vy%, 400 * fx + vx%, 444 * fy + vy%, ab$
    Color RGB(0, 0, 235) ' blau: Minutenzeiger
    Line 240 * fx + vx%, 230 * fy + vy%, 240 * fx + vx% + 170 * CosQ(b% * 6 - 90) * fx, 230 * fy + vy% + 170 * SinQ(b% * 6 - 90) * fy
    Color RGB(255, 0, 0) ' rot: Stundenzeiger
    Line 240 * fx + vx%, 230 * fy + vy%, 240 * fx + vx% + 120 * CosQ((Mod(a%, 12) + b% / 60) * 30 - 90) * fx, 230 * fy + vy% + 120 * SinQ((Mod(a%, 12) + b% / 60) * 30 - 90) * fy
    Color RGB(255, 0, 0) ' rot
    Text 240 * fx + vx% - Int(TxtLen("Achtung! Fehler") / 2), 350 * fy + vy%, "Achtung! Fehler!"
    Text 240 * fx + vx% - Int(TxtLen("weiter: Leertaste!") / 2), 370 * fy + vy%, "weiter: Leertaste!"
    Color RGB(0, 0, 235) ' blau
    Text 240 * fx + vx% - Int(TxtLen("So zeigt die Uhr die richtige Zeit an!") / 2), 420 * fy + vy%, "So zeigt die Uhr die richtige Zeit an!"
    SetFont schrift2%
    Repeat
      PeekEvent
    Until And(_Mess = 0, InKey$ = "")
    Repeat
      Sleep
    Until InKey$ <> ""
    Put 80 * fx + vx%, 330 * fy + vy%, ab$
    Clr ab$
    Color RGB(255, 255, 198) ' creme
    Line 240 * fx + vx%, 230 * fy + vy%, 240 * fx + vx% + 170 * CosQ(b% * 6 - 90) * fx, 230 * fy + vy% + 170 * SinQ(b% * 6 - 90) * fy
    Line 240 * fx + vx%, 230 * fy + vy%, 240 * fx + vx% + 120 * CosQ((Mod(a%, 12) + b% / 60) * 30 - 90) * fx, 230 * fy + vy% + 120 * SinQ((Mod(a%, 12) + b% / 60) * 30 - 90) * fy
  EndIf
  p% = 150
  i% = -1170
  Do
    If hilfe| = 2 Or falsch1| > 0
      DefLine 0, 3 * fy
      Color RGB(255, 0, 0) ' rot
      RBox 367 * fx + vx%, 398 * fy + vy%, 484 * fx + vx%, 428 * fy + vy%
      DefLine 0, 1
      Color RGB(255, 255, 198) ' creme
      PRBox 369 * fx + vx%, 401 * fy + vy%, 437 * fx + vx%, 425 * fy + vy%
      Color RGB(0, 0, 0) ' schwarz
      SetFont schrift2%
      Text 438 * fx + vx%, 402 * fy + vy%, "Uhr"
    Else
      Color RGB(255, 255, 198) ' creme
      PRBox 365 * fx + vx%, 396 * fy + vy%, 486 * fx + vx%, 430 * fy + vy%
    EndIf
    For i% = i% To 7464 Step 6
      Color RGB(255, 255, 198) ' creme
      If i% = -1164 Or i% = 3156
        Line 240 * fx + vx% + 120 * CosQ(i% - 6) * fx, 230 * fy + vy% + 120 * SinQ(i% - 6) * fy, 240 * fx + vx% + 170 * CosQ(i% - 6) * fx, 230 * fy + vy% + 170 * SinQ(i% - 6) * fy
      Else
        Line 240 * fx + vx%, 230 * fy + vy%, 240 * fx + vx% + 170 * CosQ(i% - 6) * fx, 230 * fy + vy% + 170 * SinQ(i% - 6) * fy
      EndIf
      If Abs(Mod(i%, 12)) = 6
        Line 240 * fx + vx%, 230 * fy + vy%, 240 * fx + vx% + 120 * Cos((i% + 78) / 12 / 180 * PI) * fx, 230 * fy + vy% + 120 * Sin((i% + 78) / 12 / 180 * PI) * fy
      EndIf
      Color RGB(0, 0, 235) ' blau
      Line 240 * fx + vx%, 230 * fy + vy%, 240 * fx + vx% + 170 * CosQ(i%) * fx, 230 * fy + vy% + 170 * SinQ(i%) * fy
      If Abs(Mod(i%, 12)) = 6
        Color RGB(255, 0, 0) ' rot
        Line 240 * fx + vx%, 230 * fy + vy%, 240 * fx + vx% + 120 * Cos((i% + 90) / 12 / 180 * PI) * fx, 230 * fy + vy% + 120 * Sin((i% + 90) / 12 / 180 * PI) * fy
      EndIf
      If hilfe| = 2 Or falsch1| > 0
        If wahl| = 7
          If i% < -810
            ii$ = Trim$(Str$(Mod(Trunc((i% + 5490) / 360), 24)))
            jj$ = "." + Right$(Trim$(Str$(100 + Mod(Trunc((i% + 1170) / 6), 60))), 2)
          Else If i% > 3144 And i% < 3510
            ii$ = Trim$(Str$(Mod(Trunc((i% + 1170) / 360), 24)))
            jj$ = "." + Right$(Trim$(Str$(100 + Mod(Trunc((i% + 1170) / 6), 60))), 2)
          Else
            ii$ = Trim$(Str$(Mod(Trunc((i% + 1170) / 360), 12)))
            jj$ = "." + Right$(Trim$(Str$(100 + Mod(Trunc((i% + 1170) / 6), 60))), 2)
          EndIf
        Else
          ii$ = Trim$(Str$(Mod(Trunc((i% + 1170) / 360), 24)))
          jj$ = "." + Right$(Trim$(Str$(100 + Mod(Trunc((i% + 1170) / 6), 60))), 2)
        EndIf
        If ii$ = "0" Or ii$ = "1"
          Color RGB(255, 255, 198) ' creme
          PBox 372 * fx + vx%, 405 * fy + vy%, 390 * fx + vx%, 421 * fy + vy%
        EndIf
        Color RGB(0, 0, 0) ' schwarz
        Text 435 * fx + vx% - TxtLen(jj$) - TxtLen(ii$), 402 * fy + vy%, ii$ + jj$
      EndIf
      If taste% = 3
        p% = 5
      Else If taste% = 4
        p% = 150
      Else If taste% = 5
        p% = 1200
      EndIf
      t% = oTimer
      SetCapture 1     ' Alle Tastatur- und Mausevents zum Fenster #1
      While Len(InKey$)    ' Tastaturpuffer löschen
      Wend
      Repeat
        PeekEvent
        taste% = 1
        Exit If GetAsyncKeyState(VK_RETURN) < 0
        taste% = 2
        Exit If GetAsyncKeyState(VK_F8) < 0
        taste% = 3
        Exit If GetAsyncKeyState($53) < 0 ' s
        taste% = 4
        Exit If GetAsyncKeyState($4D) < 0 ' m
        taste% = 5
        Exit If GetAsyncKeyState($4C) < 0 ' l
        taste% = 6
        Exit If GetAsyncKeyState(VK_F1) < 0
        taste% = 0
      Until taste% > 0 Or oTimer - t% > p%
      ReleaseCapture
      While GetAsyncKeyState(VK_RETURN) | GetAsyncKeyState(VK_F8) | GetAsyncKeyState($53) | GetAsyncKeyState($4D) | GetAsyncKeyState($4c) | GetAsyncKeyState(VK_F1) ' Tastaturpuffer löschen
      Wend
      Exit If taste% = 1 Or taste% = 2
      If taste% = 6
        If hilfe| = 2
          hilfe| = 1
          Color RGB(255, 255, 198) ' creme
          PRBox 365 * fx + vx%, 396 * fy + vy%, 486 * fx + vx%, 430 * fy + vy%
        Else
          hilfe| = 2
          hilferuf| = 1
          DefLine 0, 3 * fy
          Color RGB(255, 0, 0) ' rot
          RBox 367 * fx + vx%, 398 * fy + vy%, 484 * fx + vx%, 428 * fy + vy%
          DefLine 0, 1
          Color RGB(255, 255, 198) ' creme
          PBox 373 * fx + vx%, 408 * fy + vy%, 435 * fx + vx%, 422 * fy + vy%
          Color RGB(0, 0, 0) ' schwarz
          SetFont schrift2%
          Text 438 * fx + vx%, 402 * fy + vy%, "Uhr"
        EndIf
      EndIf
    Next i%
    Exit If taste% = 1 Or taste% = 2
    i% = -1170
  Loop
  Color RGB(0, 0, 0) ' schwarz
  DefMouse 0
  If taste% = 2
    ende| = 1
  EndIf
  If wahl| = 7 ' 12 Stunden
    eingabe_$ = Trim$(Str$(Mod(Trunc((i% + 1170) / 360), 12))) + Right$(Trim$(Str$(100 + Mod(Trunc((i% + 1170) / 6), 60))), 2)
    If Mod(Trunc((i% + 1170) / 360), 12) = 0 And Left$(antwort_$) <> "0"
      eingabe_$ = "12" + Right$(Trim$(Str$(100 + Mod(Trunc((i% + 1170) / 6), 60))), 2)
    EndIf
  Else '          24 Stunden
    eingabe_$ = Trim$(Str$(Mod(Trunc((i% + 1170) / 360), 24))) + Right$(Trim$(Str$(100 + Mod(Trunc((i% + 1170) / 6), 60))), 2)
    If hilfe| < 2 And falsch1| = 0
      eingabe_$ = Trim$(Str$(Mod(Trunc((i% + 1170) / 360), 12))) + Right$(Trim$(Str$(100 + Mod(Trunc((i% + 1170) / 6), 60))), 2)
      If a% > 12
        antwort% = Val(Trim$(Str$(a% - 12) + zb$))
      EndIf
      If Mod(Trunc((i% + 1170) / 360), 12) = 0 And Left$(antwort_$) <> "0"
        eingabe_$ = "12" + Right$(Trim$(Str$(100 + Mod(Trunc((i% + 1170) / 6), 60))), 2)
      Else If Mod(Trunc((i% + 1170) / 360), 12) = 0 And Left$(antwort_$, 2) = "12" And Len(antwort_$) = 4
        eingabe_$ = "12" + Right$(Trim$(Str$(100 + Mod(Trunc((i% + 1170) / 6), 60))), 2)
      EndIf
    EndIf
  EndIf
  If richtig1% = 45 Or falsch% = 45
    ende| = 1
  EndIf
  Repeat
    PeekEvent
  Until InKey$ = ""
  DefLine 0, 1
Return
'##E#
>Procedure zeit                     ' art=53, wahl>8
  beginn| = 1
  neu12:
  GraphMode R2_COPYPEN, OPAQUE
  Clr eingabe_$, eingabe%, eing$, alt%
  GraphMode R2_COPYPEN, TRANSPARENT
  If hilfe| = 3
    hilfe| = 1
  EndIf
  SetFont schrift3%
  Color RGB(0, 0, 0) ' schwarz
  If einzelner| = 1
    Text Int(42 * fx + vx%), Int(29 * fy + vy%), "Berechne die Zeitdauer:"
  Else
    Text Int(42 * fx + vx%), Int(29 * fy + vy%), "Berechnet die Zeitdauer:"
  EndIf
  If wahl| > 8 And wahl| < 12
    f17:
    If hilfe| > 1 Or falsch1| > 0
      Color RGB(0, 0, 235) ' blau
      DefLine 0, 1
      For i% = 0 To 354 Step 6
        Draw 120 * fx + vx% + 90 * CosQ(i%) * fx, 350 * fy + vy% + 90 * SinQ(i%) * fy
        Draw 350 * fx + vx% + 90 * CosQ(i%) * fx, 350 * fy + vy% + 90 * SinQ(i%) * fy
      Next i%
      Color RGB(255, 0, 0) ' rot
      DefLine 0, 3 * fy
      For i% = 0 To 330 Step 30
        Draw 120 * fx + vx% + 90 * CosQ(i%) * fx, 350 * fy + vy% + 90 * SinQ(i%) * fy To 120 * fx + vx% + 90 * CosQ(i%) * fx, 350 * fy + vy% + 90 * SinQ(i%) * fy
        Draw 350 * fx + vx% + 90 * CosQ(i%) * fx, 350 * fy + vy% + 90 * SinQ(i%) * fy To 350 * fx + vx% + 90 * CosQ(i%) * fx, 350 * fy + vy% + 90 * SinQ(i%) * fy
      Next i%
      DefLine 0, 1
      Color RGB(0, 0, 235) ' blau
      Line 120 * fx + vx%, 350 * fy + vy%, 120 * fx + vx% + 85 * CosQ(b% * 6 - 90) * fx, 350 * fy + vy% + 85 * SinQ(b% * 6 - 90) * fy
      Line 350 * fx + vx%, 350 * fy + vy%, 350 * fx + vx% + 85 * CosQ(d% * 6 - 90) * fx, 350 * fy + vy% + 85 * SinQ(d% * 6 - 90) * fy
      Color RGB(255, 0, 0) ' rot
      Line 120 * fx + vx%, 350 * fy + vy%, 120 * fx + vx% + 55 * CosQ((Mod(a%, 12) + b% / 60) * 30 - 90) * fx, 350 * fy + vy% + 55 * SinQ((Mod(a%, 12) + b% / 60) * 30 - 90) * fy
      Line 350 * fx + vx%, 350 * fy + vy%, 350 * fx + vx% + 55 * CosQ((Mod(c%, 12) + d% / 60) * 30 - 90) * fx, 350 * fy + vy% + 55 * SinQ((Mod(c%, 12) + d% / 60) * 30 - 90) * fy
    EndIf
    If Len(zb$) < 2
      zb$ = "0" + zb$
    EndIf
    If Len(zd$) < 2
      zd$ = "0" + zd$
    EndIf
    antwy% = Int(29 * fy + vy%) + zeichenh% * 5
    Color RGB(0, 0, 0) ' schwarz
    Text Int(42 * fx + vx%), Int(29 * fy + vy%) + zeichenh% * 2, "von      bis      Ergebnis"
    Text Int(42 * fx + vx%) + zeichenbr% * 2 - TxtLen(za$), Int(29 * fy + vy%) + zeichenh% * 4, za$ + "." + zb$ + " h"
    Text Int(42 * fx + vx%) + zeichenbr% * 11 - TxtLen(zc$), Int(29 * fy + vy%) + zeichenh% * 4, zc$ + "." + zd$ + " h:"
    If hilfe| > 1 Or falsch1| > 0
      Add antwy%, zeichenh%
      Color RGB(200, 0, 0) ' dunkelrot
      DefLine 0, fy
      Line Int(42 * fx + vx%), 30 * fy + vy% + zeichenh% * 5, 43 * fx + vx% + zeichenbr% * 29, 30 * fy + vy% + zeichenh% * 5
      DefLine 0, 1
    Else
      Color RGB(0, 0, 0) ' schwarz
      Text Int(42 * fx + vx%) + zeichenbr% * 21, Int(29 * fy + vy%) + zeichenh% * 4, "h    min"
      antwy% = Int(29 * fy + vy%) + zeichenh% * 4
    EndIf
    If Val(zb$) <= Val(zd$)
      If hilfe| > 1 Or falsch1| > 0
        Color RGB(0, 0, 0) ' schwarz
        Text Int(42 * fx + vx%) + zeichenbr% * 2 - TxtLen(za$), Int(29 * fy + vy%) + zeichenh% * 6, za$ + "." + zb$ + " h"
        Text Int(42 * fx + vx%) + zeichenbr% * 11 - TxtLen(zc$), Int(29 * fy + vy%) + zeichenh% * 6, zc$ + "." + zb$ + " h:    h"
      EndIf
      ze$ = zc$
      If Val(zc$) >= Val(za$)
        antwort_$ = Trim$(Str$(c% - a%))
        antwx% = Int(42 * fx + vx%) + zeichenbr% * 20 - TxtLen(antwort_$)
        eingabe_zeit
        If ende| = 1
          GoTo ende_zeit
        Else  If Len(antw$) = 2 And Asc(Right$(antw$)) = 112  ' F1
          GoTo f17
        EndIf
      Else
        antwort_$ = Trim$(Str$(24 - a% + c%))
        antwx% = Int(42 * fx + vx%) + zeichenbr% * 20 - TxtLen(antwort_$)
        eingabe_zeit
        If ende| = 1
          GoTo ende_zeit
        EndIf
        If Len(antw$) = 2 And Asc(Right$(antw$)) = 112  ' F1
          GoTo f17
        EndIf
      EndIf
    Else
      If hilfe| > 1 Or falsch1| > 0
        Color RGB(0, 0, 0) ' schwarz
        Text Int(42 * fx + vx%) + zeichenbr% * 2 - TxtLen(za$), Int(29 * fy + vy%) + zeichenh% * 6, za$ + "." + zb$ + " h"
      EndIf
      If zc$ <> "0"
        ze$ = Trim$(Str$(Val(zc$) - 1))
        If hilfe| > 1 Or falsch1| > 0
          Color RGB(0, 0, 0) ' schwarz
          Text Int(42 * fx + vx%) + zeichenbr% * 11 - TxtLen(ze$), Int(29 * fy + vy%) + zeichenh% * 6, Trim$(Str$(Val(zc$) - 1)) + "." + zb$ + " h:    h"
        EndIf
      Else
        ze$ = "23"
        If hilfe| > 1 Or falsch1| > 0
          Color RGB(0, 0, 0) ' schwarz
          Text Int(42 * fx + vx%) + zeichenbr% * 9, Int(29 * fy + vy%) + zeichenh% * 6, "23." + zb$ + " h:    h"
        EndIf
      EndIf
      If Val(zc$) > Val(za$)
        antwort_$ = Trim$(Str$(c% - a% - 1))
      Else
        antwort_$ = Trim$(Str$(23 - a% + c%))
      EndIf
      antwx% = Int(42 * fx + vx%) + zeichenbr% * 20 - TxtLen(antwort_$)
      eingabe_zeit
      If ende| = 1
        GoTo ende_zeit
      EndIf
      If Len(antw$) = 2 And Asc(Right$(antw$)) = 112  ' F1
        GoTo f17
      EndIf
    EndIf
    If eingabe_$ <> antwort_$
      falsch
      Repeat
        Sleep
      Until InKey$ <> ""
      falsch1| = 1
      Put 0, 0, rechenblatt1$
      Color RGB(255, 255, 255), ' weiß
      SetFont schrift0
      Text Int((_X - vx% - TxtLen(nam$)) / 2), 464 * fy + vy%, nam$
      SetFont schrift3%
      abdecken
      saeule
      GoTo neu12
    EndIf
    eing$ = eingabe_$
    Clr eingabe_$, antwort_$
    antwx% = Int(42 * fx + vx%) + zeichenbr% * 24
    If hilfe| > 1 Or falsch1| > 0
      Add antwy%, zeichenh%
      Color RGB(0, 0, 0) ' schwarz
      Text Int(42 * fx + vx%) + zeichenbr% * 2 - TxtLen(ze$), Int(29 * fy + vy%) + zeichenh% * 7, ze$ + "." + zb$ + " h"
      Text Int(42 * fx + vx%) + zeichenbr% * 11 - TxtLen(zc$), Int(29 * fy + vy%) + zeichenh% * 7, zc$ + "." + zd$ + " h:         min"
    EndIf
    If Val(zb$) <= Val(zd$)
      antwort_$ = Trim$(Str$(d% - b%))
      antwx% = Int(42 * fx + vx%) + zeichenbr% * 25 - TxtLen(antwort_$)
    Else
      antwort_$ = Trim$(Str$(60 - b% + d%))
      antwx% = Int(42 * fx + vx%) + zeichenbr% * 25 - TxtLen(antwort_$)
    EndIf
    eingabe_zeit
    If ende| = 1
      GoTo ende_zeit
    EndIf
    If Len(antw$) = 2 And Asc(Right$(antw$)) = 112  ' F1
      eingabe_zeit
      If ende| = 1
        GoTo ende_zeit
      EndIf
    EndIf
    antwort% = Val(antwort_$)
    If hilfe| > 1 Or falsch1| > 0
      Color RGB(200, 0, 0) ' dunkelrot
      DefLine 0, fy
      Line Int(42 * fx + vx%), 30 * fy + vy% + zeichenh% * 8, Int(42 * fx + vx%) + zeichenbr% * 29, 30 * fy + vy% + zeichenh% * 8
      DefLine 0, 1
      Color RGB(0, 0, 0) ' schwarz
      Text Int(42 * fx + vx%) + zeichenbr% * 2 - TxtLen(za$), Int(29 * fy + vy%) + zeichenh% * 8, za$ + "." + zb$ + " h"
      Text Int(42 * fx + vx%) + zeichenbr% * 11 - TxtLen(zc$), Int(29 * fy + vy%) + zeichenh% * 8, zc$ + "." + zd$ + " h:"
      Text Int(42 * fx + vx%) + zeichenbr% * 20 - TxtLen(eing$), Int(29 * fy + vy%) + zeichenh% * 8, eing$ + " h"
      Text Int(42 * fx + vx%) + zeichenbr% * 25 - TxtLen(eingabe_$), Int(29 * fy + vy%) + zeichenh% * 8, eingabe_$ + " min"
      Repeat
        Sleep
        antw$ = InKey$
      Until antw$ <> ""
    EndIf
  Else If wahl| > 11                                                                           ' Rechnen mit Kalenderdaten
    SetFont schrift3%
    Color RGB(0, 0, 0) ' schwarz
    Text Int(42 * fx + vx%), Int(29 * fy + vy%) + zeichenh% * 2, "vom " + Space$(2 - Len(za$)) + za$ + "." + Space$(2 - Len(zb$)) + zb$ + "." + zc$
    Text Int(42 * fx + vx%), Int(29 * fy + vy%) + zeichenh% * 6, "bis " + Space$(2 - Len(zd$)) + zd$ + "." + Space$(2 - Len(ze$)) + ze$ + "." + zf$
    f18:
    If (hilfe| > 1 Or falsch1| > 0) And (stufe| = 3 Or (stufe| = 2 And wahl| = 12))
      Color RGB(220, 220, 220) ' hellgrau
      SetFont schrift1%
      Text Int(42 * fx + vx%), 270 * fy + vy%, "So viele Tage haben die Monate:"
      Text Int(42 * fx + vx%), 300 * fy + vy%, "Januar:"
      Text Int(42 * fx + vx%), 320 * fy + vy%, "Februar:"
      Text Int(42 * fx + vx%), 340 * fy + vy%, "März:"
      Text Int(42 * fx + vx%), 360 * fy + vy%, "April:"
      Text Int(42 * fx + vx%), 380 * fy + vy%, "Mai:"
      Text Int(42 * fx + vx%), 400 * fy + vy%, "Juni:"
      Text 142 * fx + vx%, 300 * fy + vy%, "31"
      Text 142 * fx + vx%, 320 * fy + vy%, "28/29"
      Text 142 * fx + vx%, 340 * fy + vy%, "31"
      Text 142 * fx + vx%, 360 * fy + vy%, "30"
      Text 142 * fx + vx%, 380 * fy + vy%, "31"
      Text 142 * fx + vx%, 400 * fy + vy%, "30"
      Text 242 * fx + vx%, 300 * fy + vy%, "Juli:"
      Text 242 * fx + vx%, 320 * fy + vy%, "August:"
      Text 242 * fx + vx%, 340 * fy + vy%, "September:"
      Text 242 * fx + vx%, 360 * fy + vy%, "Oktober:"
      Text 242 * fx + vx%, 380 * fy + vy%, "November:"
      Text 242 * fx + vx%, 400 * fy + vy%, "Dezember:"
      Text 342 * fx + vx%, 300 * fy + vy%, "31"
      Text 342 * fx + vx%, 320 * fy + vy%, "31"
      Text 342 * fx + vx%, 340 * fy + vy%, "30"
      Text 342 * fx + vx%, 360 * fy + vy%, "31"
      Text 342 * fx + vx%, 380 * fy + vy%, "30"
      Text 342 * fx + vx%, 400 * fy + vy%, "31"
      SetFont schrift3%
      Color RGB(0, 0, 0) ' schwarz
    EndIf
    alta_$ = za$
    Color RGB(200, 0, 0) ' dunkelrot
    DefLine 0, fy
    Box Int(41 * fx + vx%), 30 * fy + vy% + zeichenh% * 2, Int(41 * fx + vx%) + zeichenbr% * 14, 30 * fy + vy% + zeichenh% * 3
    Box Int(41 * fx + vx%), 30 * fy + vy% + zeichenh% * 6, Int(41 * fx + vx%) + zeichenbr% * 14, 30 * fy + vy% + zeichenh% * 7
    DefLine 0, 1
    antwy% = Int(29 * fy + vy%) + zeichenh% * 4
    If (d% = 30 And (e% = 4 Or e% = 6 Or e% = 9 Or e% = 11)) Or (d% = 29 And e% = 2) Or (d% = 28 And e% = 2 And (Mod(f%, 4) <> 0 Or f% = 2000 Or f% = 1600))
      If a% > d%
        a% = d%
        za$ = zd$
      EndIf
    EndIf
    If Val(zb$) < Val(ze$) Or (zb$ = ze$ And Val(za$) <= Val(zd$))      ' Jahre
      zh$ = zf$
      If hilfe| > 1 Or falsch1| > 0
        Color RGB(0, 0, 0) ' schwarz
        Text Int(42 * fx + vx%), Int(29 * fy + vy%) + zeichenh% * 4, "bis " + Space$(2 - Len(alta_$)) + alta_$ + "." + Space$(2 - Len(zb$)) + zb$ + "." + zh$
      EndIf
      antwort_$ = Trim$(Str$(Val(zf$) - Val(zc$)))
      antwx% = Int(42 * fx + vx%) + zeichenbr% * 24 - TxtLen(antwort_$)
      Color RGB(0, 0, 0) ' schwarz
      If antwort_$ <> "1"
        Text Int(42 * fx + vx%) + zeichenbr% * 25, Int(29 * fy + vy%) + zeichenh% * 4, "Jahre"
      Else
        Text Int(42 * fx + vx%) + zeichenbr% * 25, Int(29 * fy + vy%) + zeichenh% * 4, "Jahr"
      EndIf
'##B#
      eingabe_zeit
      If ende| = 1
        GoTo ende_zeit
      EndIf
      If Len(antw$) = 2 And Asc(Right$(antw$)) = 112  ' F1
        GoTo f18
      EndIf
    Else
      zh$ = Trim$(Str$(f% - 1))
      If hilfe| > 1 Or falsch1| > 0
        Color RGB(0, 0, 0) ' schwarz
        Text Int(42 * fx + vx%), Int(29 * fy + vy%) + zeichenh% * 4, "bis " + Space$(2 - Len(alta_$)) + alta_$ + "." + Space$(2 - Len(zb$)) + zb$ + "." + zh$
      EndIf
      antwort_$ = Trim$(Str$(Val(zf$) - Val(zc$) - 1))
      antwx% = Int(42 * fx + vx%) + zeichenbr% * 24 - TxtLen(antwort_$)
      Color RGB(0, 0, 0) ' schwarz
      If antwort_$ <> "1"
        Text Int(42 * fx + vx%) + zeichenbr% * 25, Int(29 * fy + vy%) + zeichenh% * 4, "Jahre"
      Else
        Text Int(42 * fx + vx%) + zeichenbr% * 25, Int(29 * fy + vy%) + zeichenh% * 4, "Jahr"
      EndIf
'##B#
      eingabe_zeit
      If ende| = 1
        GoTo ende_zeit
      EndIf
      If Len(antw$) = 2 And Asc(Right$(antw$)) = 112  ' F1
        GoTo f18
      EndIf
    EndIf
    Clr alta_$
    If eingabe_$ <> antwort_$
      falsch
      Repeat
        Sleep
      Until InKey$ <> ""
      falsch1| = 1
      Put 0, 0, rechenblatt1$
      Color RGB(255, 255, 255), ' weiß
      SetFont schrift0
      Text Int((_X - vx% - TxtLen(nam$)) / 2), 464 * fy + vy%, nam$
      SetFont schrift3%
      abdecken
      saeule
      GoTo neu12
    EndIf
    Clr eingabe_$
    Add antwy%, zeichenh%                                              ' Monate
    If a% <= d%
      zg$ = ze$
      If hilfe| > 1 Or falsch1| > 0
        Color RGB(0, 0, 0) ' schwarz
        Text Int(42 * fx + vx%), Int(29 * fy + vy%) + zeichenh% * 5, "bis " + Space$(2 - Len(za$)) + za$ + "." + Space$(2 - Len(zg$)) + zg$ + "." + zf$
      EndIf
      antwort_$ = Trim$(Str$(Val(ze$) - Val(zb$)))
    Else If e% <> 1
      zg$ = Trim$(Str$(e% - 1))
      If (Val(zg$) = 4 Or Val(zg$) = 6 Or Val(zg$) = 9 Or Val(zg$) = 11) And Val(za$) = 31
        a% = 30
        za$ = "30"
      EndIf
      If Val(zg$) = 2 And Val(za$) > 28
        If Mod(f%, 4) <> 0 Or f% = 2000 Or f% = 1600
          a% = 28
          za$ = "28"
        Else
          a% = 29
          za$ = "29"
        EndIf
      EndIf
      If hilfe| > 1 Or falsch1| > 0
        Color RGB(0, 0, 0) ' schwarz
        Text Int(42 * fx + vx%), Int(29 * fy + vy%) + zeichenh% * 5, "bis " + Space$(2 - Len(za$)) + za$ + "." + Space$(2 - Len(zg$)) + zg$ + "." + zf$
      EndIf
      antwort_$ = Trim$(Str$(Val(ze$) - Val(zb$) - 1))
    Else
      zg$ = "12"
      If hilfe| = 2 Or falsch1| > 0
        Color RGB(0, 0, 0) ' schwarz
        Text Int(42 * fx + vx%), Int(29 * fy + vy%) + zeichenh% * 5, "bis " + Space$(2 - Len(za$)) + za$ + "." + Space$(2 - Len(zg$)) + zg$ + "." + zh$
      EndIf
      antwort_$ = Trim$(Str$(Val(ze$) - Val(zb$) - 1))
    EndIf
    If Val(antwort_$) < 0
      antwort_$ = Trim$(Str$(Val(antwort_$) + 12))
    EndIf
    antwx% = Int(42 * fx + vx%) + zeichenbr% * 24 - TxtLen(antwort_$)
    Color RGB(0, 0, 0) ' schwarz
    If antwort_$ <> "1"
      Text Int(42 * fx + vx%) + zeichenbr% * 25, Int(29 * fy + vy%) + zeichenh% * 5, "Monate"
    Else
      Text Int(42 * fx + vx%) + zeichenbr% * 25, Int(29 * fy + vy%) + zeichenh% * 5, "Monat"
    EndIf
'##B#
    eingabe_zeit
    If ende| = 1
      GoTo ende_zeit
    EndIf
    If Len(antw$) = 2 And Asc(Right$(antw$)) = 112  ' F1
'##B#
      eingabe_zeit
      If ende| = 1
        GoTo ende_zeit
      EndIf
    EndIf
    If eingabe_$ <> antwort_$
      falsch
      Repeat
        Sleep
      Until InKey$ <> ""
      falsch1| = 1
      Put 0, 0, rechenblatt1$
      Color RGB(255, 255, 255), ' weiß
      SetFont schrift0
      Text Int((_X - vx% - TxtLen(nam$)) / 2), 464 * fy + vy%, nam$
      SetFont schrift3%
      abdecken
      saeule
      GoTo neu12
    EndIf
    Clr eingabe_$                                       ' Tage
    Add antwy%, zeichenh%
    antwort% = Val(zd$) - Val(za$)
    If antwort% < 0
      If e% = 3
        If Mod(f%, 4) <> 0 Or f% = 2000 Or f% = 1600
          Add antwort%, 28
        Else
          Add antwort%, 29
        EndIf
      Else If e% = 5 Or e% = 7 Or e% = 10 Or e% = 12
        Add antwort%, 30
      Else
        Add antwort%, 31
      EndIf
    EndIf
    antwort_$ = Trim$(Str$(antwort%))
    Color RGB(0, 0, 0) ' schwarz
    If antwort_$ <> "1"
      Text Int(42 * fx + vx%) + zeichenbr% * 25, Int(29 * fy + vy%) + zeichenh% * 6, "Tage"
    Else
      Text Int(42 * fx + vx%) + zeichenbr% * 25, Int(29 * fy + vy%) + zeichenh% * 6, "Tag"
    EndIf
    antwx% = Int(42 * fx + vx%) + zeichenbr% * 24 - TxtLen(antwort_$)
'##B#
    eingabe_zeit
    If ende| = 1
      GoTo ende_zeit
    EndIf
    If Len(antw$) = 2 And Asc(Right$(antw$)) = 112  ' F1
      eingabe_zeit
      If ende| = 1
        GoTo ende_zeit
      EndIf
    EndIf
  EndIf
  If wahl| > 8 And hilfe| > 1                     '    And antw$ <> Chr$(13)                       ' Return
    Repeat
      Sleep
    Until InKey$ <> ""
  EndIf
  ende_zeit:
  DefLine 0, 1
Return
>Procedure eingabe_zeit
  Color RGB(255, 0, 0) ' rot
  Box antwx%, antwy% + 4 * fy, antwx% + zeichenbr% - 2 * fx, antwy% + zeichenh%
  Repeat
    PeekEvent
    Repeat
      Sleep
      antw$ = InKey$
    Until antw$ <> ""
    If Len(antw$) = 2 And Asc(Right$(antw$)) = 112    ' F1
      If hilfe| < 2
        hilfe| = 2
        hilferuf| = 1
        Color RGB(255, 255, 198) ' creme
        Box antwx%, antwy% + 4 * fy, antwx% + zeichenbr% - 2 * fx, antwy% + zeichenh%
        GoTo ende_eingabe
      Else
        hilfe| = 3
        GoTo ende_eingabe
      EndIf
      Color RGB(255, 255, 198) ' creme
    Else If Len(antw$) = 2 And Asc(Right$(antw$)) = 119         ' F8
      ende| = 1
      GoTo ende_eingabe
    Else If antw$ = Chr$(8)                                 ' Backspace
      If wahl| > 8
        If Len(eingabe_$) > 0
          Sub antwx%, zeichenbr%
          Color RGB(255, 255, 198) ' creme
          PBox antwx%, antwy% + 4 * fy, antwx% + zeichenbr% - 2 * fx, antwy% + zeichenh%
          eingabe_$ = Left$(eingabe_$, Len(eingabe_$) - 1)
        EndIf
      EndIf
    Else If Asc(antw$) > 47 And Asc(antw$) < 58           ' Zahlen von 0 bis 9
      eingabe_$ = eingabe_$ + antw$
      Color RGB(255, 255, 198) ' creme
      Box antwx%, antwy% + 4 * fy, antwx% + zeichenbr% - 2 * fx, antwy% + zeichenh%
      Color RGB(0, 0, 0) ' schwarz
      Text antwx%, antwy%, antw$
      Add antwx%, zeichenbr%
    EndIf
    Exit If Len(eingabe_$) > Len(antwort_$)
  Until antw$ = Chr$(13)   ' Return
  ende_eingabe:
Return
>Procedure abfrage                  ' Eingabe für schriftliche Rechenarten
  Color RGB(255, 255, 198) ' creme
  If Len(antw$) = 2 And Asc(Right$(antw$)) = 119
    ende| = 1
  Else If Asc(antw$) > 47 And Asc(antw$) < 58        ' Zahlen von 0 bis 9
    eingabe_$ = antw$ + eingabe_$
    Box antwx% - Int(fx), antwy% + 4 * fy + zeichenh%, antwx% + Int(fx) - zeichenbr%, antwy% + zeichenh% * 2 ' Kursor
    Color RGB(0, 0, 0) ' schwarz
    Text antwx% - zeichenbr%, antwy% + zeichenh%, eingabe_$
  EndIf
Return
>Procedure abfrage1                 ' Eingabe zu a40
  alt% = antwx%
  Repeat
    PeekEvent
    Repeat
      Sleep
      antw$ = InKey$
    Until (Asc(antw$) > 47 And Asc(antw$) < 58) Or antw$ = Chr(8) Or antw$ = Chr$(13) Or (Len(antw$) = 2 And Asc(Right$(antw$)) = 119) Or antw$ = "T" Or antw$ = "t"
    If Len(antw$) = 2 And Asc(Right$(antw$)) = 119               ' F8
      ende| = 1
      Exit If ende| = 1
    Else If antw$ = Chr$(8) And antwx% > alt%                       ' Backspace
      eingabe_$ = Left$(eingabe_$, Max(0, Len(eingabe_$) - 1))
      Color RGB(255, 255, 198) ' creme
      Sub antwx%, zeichenbr%
      PBox antwx%, antwy% + 4 * fy, antwx% + zeichenbr% - 2 * fx, antwy% + zeichenh%
    Else If Asc(antw$) > 47 And Asc(antw$) < 58              ' Zahlen von 0 bis 9
      Color RGB(255, 255, 198) ' creme
      Box antwx%, antwy% + 4 * fy, antwx% + zeichenbr% - 2 * fx, antwy% + zeichenh%
      eingabe_$ = eingabe_$ + antw$
      Color RGB(0, 0, 0) ' schwarz
      Text antwx%, antwy%, antw$
      Add antwx%, zeichenbr%
    EndIf
  Until antw$ = Chr$(13) Or antw$ = "T" Or antw$ = "t"
Return
>Procedure hilfe1(blau%, gesamt%)
  If Max(blau%, gesamt%) < 101 And blau% >= 0 And gesamt% >= 0 And blau% <= gesamt%
    Color RGB(0, 0, 235) ' blau
    l% = 1
    While l% <= gesamt%
      hundertfeld
      If l% = blau% + 1
        Color RGB(255, 0, 0) ' rot
      EndIf
      PCircle 62 * fx + vx% + llx%, 282 * fy + vy% + lly%, 6 * fy
      Inc l%
    Wend
  EndIf
Return
>Procedure hilfe2(blau%, gesamt%)
  If Max(blau%, gesamt%) < 1001 And blau% >= 0 And gesamt% >= 0 And blau% <= gesamt%
    If tausend| = 0
      Color RGB(0, 0, 235) ' blau
    Else
      Color RGB(0, 0, 0) ' schwarz
      SetFont schrift3%
      Text Int(42 * fx + vx%), 28 * fy + vy% + zeichenh% * 8, "Jeder Punkt bedeutet"
      Text Int(42 * fx + vx%), 28 * fy + vy% + zeichenh% * 9, "einen Tausender!"
      Color RGB(0, 170, 0) ' grün
    EndIf
    l% = 1
    abstand% = 2 * fx
    abstand1% = 6 * fx
    While l% <= gesamt%
      tausendfeld
      If l% = blau% + 1
        Color RGB(255, 0, 0) ' rot
      EndIf
      PBox 42 * fx + vx% + llx%, 282 * fy + vy% + lly%, 46 * fx + llx% + vx%, 286 * fy + vy% + lly%
      Inc l%
    Wend
  EndIf
Return
>Procedure hilfe_mal1(mal%, blau%)
  Local farbe|
  Local farbe1|
  If mal% * blau% < 101
    l% = 1
    If mal% > 0 And blau% > 0
      farbe| = 4
      farbe1| = 2
      For i% = 1 To mal%
        If farbe| = 4
          Color RGB(0, 0, 235) ' blau
        Else
          Color RGB(255, 0, 0) ' rot
        EndIf
        Swap farbe|, farbe1|
        For j% = 1 To blau%
          hundertfeld
          PCircle 62 * fx + vx% + llx%, 287 * fy + vy% + lly%, 6 * fy
          Inc l%
        Next j%
      Next i%
    EndIf
    If rest% <> 0
      Color RGB(0, 170, 0) ' grün
      For i% = 1 To rest%
        hundertfeld
        PCircle 62 * fx + vx% + llx%, 287 * fy + vy% + lly%, 6 * fy
        Inc l%
      Next i%
    EndIf
  EndIf
Return
>Procedure hilfe_mal2(mal%, blau%)
  Local farbe|
  Local farbe1|
  If mal% * blau% < 1001
    l% = 1
    If mal% > 0 And blau% > 0
      If tausend| = 0
        farbe| = 4
      Else
        Color RGB(0, 0, 0) ' schwarz
        SetFont schrift3%
        Text Int(42 * fx + vx%), 28 * fy + vy% + zeichenh% * 8, "Jeder Punkt bedeutet"
        Text Int(42 * fx + vx%), 28 * fy + vy% + zeichenh% * 9, "einen Tausender!"
        farbe| = 4
        Color RGB(0, 170, 0) ' grün
      EndIf
      farbe1| = 2
      For i% = 1 To mal%
        If farbe| = 4
          If art| = 45
            Color RGB(0, 170, 0) ' grün
          Else
            Color RGB(0, 0, 235) ' blau
          EndIf
        Else
          Color RGB(255, 0, 0) ' rot
        EndIf
        Swap farbe|, farbe1|
        abstand% = 2 * fx
        abstand1% = 6 * fx
        For j% = 1 To blau%
          tausendfeld
          PBox 42 * fx + vx% + llx%, 282 * fy + vy% + lly%, 46 * fx + llx% + vx%, 286 * fy + vy% + lly%
          Inc l%
        Next j%
      Next i%
    EndIf
    If art| = 52 And Right$(Trim$(Str$(Int((b% / 2)))), 3) = "500"
      rest% = 1
    EndIf
    If rest% <> 0
      Color RGB(0, 170, 0) ' grün
      abstand% = 2 * fx
      abstand1% = 6 * fx
      For i% = 1 To rest%
        tausendfeld
        PBox 42 * fx + vx% + llx%, 282 * fy + vy% + lly%, 46 * fx + llx% + vx%, 286 * fy + vy% + lly%
        Inc l%
      Next i%
    EndIf
    If art| = 52 And Right$(Trim$(Str$(Int((b% / 2)))), 3) = "500"
      Clr rest%
    EndIf
  EndIf
Return
>Procedure hundertfeld
  lx% = Mod(l% - 1, 10)
  llx% = lx% * 16 * fx
  Clr lly%
  abstand% = Ceil(17 * fy)
  If l% > 10
    lly% = Val(Left$(Trim$(Str$(l% - 1)))) * abstand%
  EndIf
  If lx% > 4
    Add llx%, Ceil(8 * fx)
  EndIf
  If lly% > 80 * fy
    Add lly%, Ceil(8 * fy)
  EndIf
Return
>Procedure tausendfeld
  lx% = Mod(l% - 1, 10) + Mod(Int((l% - 1) / 100), 100) * 12
  ly% = Div(Mod(l% - 1, 100), 10)
  If l% > 500
    Add ly%, 15
    Sub lx%, 60
  EndIf
  llx% = lx% * abstand1%
  lly% = ly% * abstand1%
  If lx% > 4
    Add llx%, abstand%
    If lx% > 16
      Add llx%, abstand%
      If lx% > 28
        Add llx%, abstand%
        If lx% > 40
          Add llx%, abstand%
          If lx% > 52
            Add llx%, abstand%
          EndIf
        EndIf
      EndIf
    EndIf
  EndIf
  If ly% > 4
    Add lly%, abstand%
    If ly% > 19
      Add lly%, abstand%
    EndIf
  EndIf
Return
>Procedure input1(x%, y%, ByRef aaaa$)
  GraphMode R2_COPYPEN, TRANSPARENT
  Color RGB(255, 255, 198) ' creme
  If eing$ = ""
    Clr pfeil%
  EndIf
  If restlaenge% = 0
    xx% = Len(Trim$(Str$(antwort%)))
  Else
    xx% = Len(Trim$(Str$(rest%)))
  EndIf
  If (art| = 44 Or art| = 31 Or (art| = 16 And stufe| = 3)) And aa2% = 0
    aa2% = 1
    SetFont schrift1%
    Color RGB(0, 0, 0) ' schwarz
    If einzelner| = 1
      Text Int(42 * fx + vx%), 353 * fy + vy%, "Wenn du die Zahlen von hinten eingeben"
      Text Int(42 * fx + vx%), 374 * fy + vy%, "willst, drücke bei jeder Aufgabe"
      a% = TxtLen("willst, drücke bei jeder Aufgabe  ")
    Else
      Text Int(42 * fx + vx%), 353 * fy + vy%, "Wenn ihr die Zahlen von hinten eingeben"
      Text Int(42 * fx + vx%), 374 * fy + vy%, "wollt, drückt bei jeder Aufgabe"
      a% = TxtLen("wollt, drückt bei jeder Aufgabe  ")
    EndIf
    If art| = 44 And stufe| = 1
      Text Int(42 * fx + vx%), 290 * fy + vy%, "Rechne zuerst bis zum nächsten Tausender,"
      Text Int(42 * fx + vx%), 311 * fy + vy%, "dann weiter bis 10000!"
    EndIf
    Color RGB(255, 0, 0) ' rot
    SetFont schriftw1%
    Text Int(42 * fx) + a% + vx%, 375 * fy + vy%, "ð" 'Pfeil nach rechts
    SetFont schrift3%
  EndIf
  If rechnen| = 1 Or rechnen| = 2
    Do
      h1:
      Repeat
        PeekEvent
        antwort_$ = InKey$
      Until antwort_$ <> ""
      Exit If antwort_$ = Chr$(13)                            ' Return
      If Len(antwort_$) = 2 And Asc(Right$(antwort_$)) = 119      ' F8-Taste
        ende| = 1
        Clr f1%, fortsetzung|
        GoTo beenden
      Else If Len(antwort_$) = 2 And Asc(Right$(antwort_$)) = 112 ' F1-Taste
        If hilfe| = 2
          hilfe| = 1
          If art| <> 1 And art| <> 2
            abdecken
            If eing$ = "" Or Right$(eing$) = "E" Or Right$(eing$) = "e"
              Clr l%, eing$ ' Aufbau des eigenen Hilfs-Hunderterfelds
            EndIf
          EndIf
        Else
          hilfe| = 2
          hilferuf| = 1
          f1% = 1
          If art| <> 1 And art| <> 2
            abdecken
          EndIf
          If rest% <> 0
            Clr f1%
            If art| = 13
              hilfe_mal1(2, c%)
            Else If art| = 26
              hilfe_mal1(2, Int(b% / 2))
            Else If art| = 20 Or art| = 21 Or art| = 22 Or art| = 24
              hilfe_mal1(b%, c%)
            EndIf
            GoTo h1
          Else
            hauptmenue
          EndIf
        EndIf
      Else If Len(antwort_$) = 2 And Asc(Right$(antwort_$)) = 39 And art| = 16 And stufe| = 3 And pfeil% = 0 ' Pfeil nach rechts, Ergänzen
        If eing$ = ""
          pfeil% = 1
          Color RGB(255, 255, 198) ' creme
          Box x%, y% + Int(4 * fy), x% + zeichenbr% - Ceil(2 * fx), y% + zeichenh%
          Color RGB(255, 0, 0) ' rot
          Box x% + TxtLen(Trim$(Str$(antwort%))) - zeichenbr%, y% + Int(4 * fy), x% + TxtLen(Trim$(Str$(antwort%))) - Ceil(2 * fx), y% + zeichenh%
        EndIf
      Else If antwort_$ = Chr$(8)                                ' Backspace
        If pfeil% = 0
          eing$ = Left$(eing$, Max(0, Len(eing$) - 1))
        Else                           ' beim Ergänzen hinten beginnen
          eing$ = Right$(eing$, Max(0, Len(eing$) - 1))
        EndIf
        If eing$ = "" And art| <> 1 And hilfe| < 2
          abdecken
          Clr l% ' Aufbau des eigenen Hilfs-Hunderterfelds
        EndIf
'##B#
        Color RGB(255, 255, 198) ' creme
        If art| <> 2 And Left$(eing$) <> "E" And Left$(eing$) <> "e"
          If pfeil% = 0
            PBox x% + TxtLen(eing$), y% + Int(4 * fy), x% + TxtLen(eing$) + zeichenbr% - Int(2 * fx), y% + zeichenh%
          Else
            PBox x% + (TxtLen(Trim$(Str$(antwort%)))) - TxtLen(eing$) - zeichenbr%, y% + Int(4 * fy), x% + (TxtLen(Trim$(Str$(antwort%)))) - TxtLen(eing$) - Ceil(2 * fx), y% + zeichenh%
          EndIf
        Else
          If art| = 2 Or (hilfe| = 1 And falsch1| < 2)
            l% = Len(eing$) + 1
            hundertfeld
            Color RGB(255, 255, 198) ' creme
            PBox llx% + Int(56 * fx) - 1 + vx%, lly% + Ceil(275 * fy + vy%), llx% + Int(69 * fx + vx%), lly% + Ceil(288 * fy + vy%)
            PBox 236 * fx + vx%, 270 * fy + vy%, 284 * fx + vx%, 465 * fy + vy%
            If hilfe| = 2 Or falsch1| > 1
              Color RGB(255, 0, 0) ' rot
              Text 236 * fx + vx%, 270 * fy + vy% + lly%, Trim$(Str$(l% - 1))
            EndIf
            Color RGB(0, 0, 235) ' blau
          EndIf
        EndIf
      Else If Asc(antwort_$) > 47 And Asc(antwort_$) < 58 And art| <> 2 ' Zahlen von 0 bis 9
        If pfeil% = 0
          If Len(eing$) < xx%
            eing$ = eing$ + antwort_$
          EndIf
        Else
          If Len(eing$) < xx%
            eing$ = antwort_$ + eing$
          EndIf
        EndIf
        If art| <> 2
          If pfeil% = 0
            If Left$(eing$) = "E" Or Left$(eing$) = "e"
              Repeat
                PeekEvent
                eing$ = Right$(eing$, Len(eing$) - 1)
              Until Left$(eing$) <> "E" And Left$(eing$) <> "e"
              eing$ = eing$ + antwort_$
            EndIf
          Else
            If Right$(eing$) = "E" Or Right$(eing$) = "e"
              Repeat
                PeekEvent
                eing$ = Left$(eing$, Len(eing$) - 1)
              Until Right$(eing$) <> "E" And Right$(eing$) <> "e"
              eing$ = antwort_$ + eing$
            EndIf
          EndIf
        EndIf
        If pfeil% = 0
          Color RGB(255, 255, 198) ' creme
          PBox x%, y% + Int(4 * fy), x% + zeichenbr% - Ceil(2 * fx), y% + zeichenh%
          Color RGB(0, 0, 0) ' schwarz
          Text x%, y%, eing$
        Else
          Color RGB(255, 255, 198) ' creme
          Box x% + TxtLen(Trim$(Str$(antwort%))) - TxtLen(eing$), y% + Int(4 * fy), x% + TxtLen(Trim$(Str$(antwort%))) - TxtLen(eing$) + zeichenbr% - Ceil(2 * fx), y% + zeichenh%
          Color RGB(0, 0, 0) ' schwarz
          Text x% + TxtLen(Trim$(Str$(antwort%))) - TxtLen(eing$), y%, eing$
        EndIf
      Else If Asc(antwort_$) = 45 And aufgabenwahl| = 2            ' Minuszeichen
        Color RGB(255, 255, 198) ' creme
        If pfeil% = 0
          If Len(eing$) < xx%
            eing$ = eing$ + antwort_$
          EndIf
          Box x%, y% + Int(4 * fy), x% + zeichenbr% - Ceil(2 * fx), y% + zeichenh%
          Color RGB(0, 0, 0) ' schwarz
          Text x%, y%, eing$
        Else
          If Len(eing$) < xx%
            eing$ = antwort_$ + eing$
          EndIf
          Box x% + TxtLen(Trim$(Str$(antwort%))) - TxtLen(eing$), y% + Int(4 * fy), x% + TxtLen(Trim$(Str$(antwort%))) - TxtLen(eing$) + zeichenbr% - Ceil(2 * fx), y% + zeichenh%
          Color RGB(0, 0, 0) ' schwarz
          Text x% + TxtLen(Trim$(Str$(antwort%))) - TxtLen(eing$), y%, eing$
        EndIf
      Else If (antwort_$ = "E" Or antwort_$ = "e") And Len(eing$) < 100 And Val(eing$) = 0 And art| <> 1  ' Einer
        Color RGB(0, 0, 235) ' blau
        eing$ = eing$ + antwort_$
        l% = Len(eing$)
        If l% = 1 And art| = 2
          Color RGB(255, 255, 198) ' creme
          Box x%, y% + Int(4 * fy), x% + zeichenbr% - Ceil(2 * fx), y% + zeichenh%
        EndIf
        Color RGB(0, 0, 235) ' blau
        If art| = 2 Or (hilfe| = 1 And falsch1| < 2)
          hundertfeld
          PCircle 62 * fx + vx% + llx%, 282 * fy + vy% + lly%, 6 * fy
          Color RGB(255, 255, 198) ' creme
          PBox 236 * fx + vx%, 270 * fy + vy%, 284 * fx + vx%, Ceil(290 * fy) + lly% + vy%
          If hilfe| = 2 Or falsch1| > 1
            Color RGB(255, 0, 0) ' rot
            Text 236 * fx + vx%, 270 * fy + vy% + lly%, Trim$(Str$(l%))
          EndIf
          Color RGB(0, 0, 235) ' blau
        EndIf
      Else If (antwort_$ = "Z" Or antwort_$ = "z") And Len(eing$) < 91 And Val(eing$) = 0 And art| <> 1   ' Zehner
        Color RGB(0, 0, 235) ' blau
        l% = Len(eing$) + 1
        eing$ = eing$ + String$(10, "E")
        If l% = 1 And art| = 2
          Color RGB(255, 255, 198) ' creme
          Box x%, y% + Int(4 * fy), x% + zeichenbr% - Ceil(2 * fx), y% + zeichenh%
        EndIf
        For i% = 0 To 9
          Color RGB(0, 0, 235) ' blau
          If art| = 2 Or (hilfe| = 1 And falsch1| < 2)
            hundertfeld
            PCircle 62 * fx + vx% + llx%, 282 * fy + vy% + lly%, 6 * fy
            Color RGB(255, 255, 198) ' creme
            PBox 236 * fx + vx%, 270 * fy + vy%, 284 * fx + vx%, Ceil(290 * fy + vy%) + lly%
            If hilfe| = 2 Or falsch1| > 1
              Color RGB(255, 0, 0) ' rot
              Text 236 * fx + vx%, 270 * fy + vy% + lly%, Trim$(Str$(l%))
            EndIf
            Color RGB(0, 0, 235) ' blau
          EndIf
          Inc l%
        Next i%
      EndIf
    Loop
  Else                                        ' Rechnen 3 und Rechnen 4
    Do
      h3:
      Repeat
        PeekEvent
        antwort_$ = InKey$
      Until antwort_$ <> ""
      Exit If antwort_$ = Chr$(13) Or antwort_$ = "T" Or antwort_$ = "t"           ' Return
      If Len(antwort_$) = 2 And Asc(Right$(antwort_$)) = 112 ' F1-Taste
        If art| = 41
          GoTo h3  ' keine Hilfe
        EndIf
        If hilfe| = 2
          hilfe| = 1
          If art| <> 27 And art| <> 28 And art| <> 40 And art| <> 41
            abdecken
            If eing$ = "" Or Right$(eing$) = "E" Or Right$(eing$) = "e"
              Clr l%, eing$ ' Aufbau des eigenen Hilfs-Hunderterfelds
            EndIf
          EndIf
        Else
          hilfe| = 2
          hilferuf| = 1
          f1% = 1
          If art| <> 27 And art| <> 28 And art| <> 40 And art| <> 41
            abdecken
          EndIf
          If art| = 50
            Clr f1%
            SetFont schrift1%
            Color RGB(0, 0, 0) ' schwarz
            If einzelner| = 1
              Text Int(42 * fx + vx%), 350 * fy + vy%, "Du findest den Rest in deiner letzten Zeile!"
            Else
              Text Int(42 * fx + vx%), 350 * fy + vy%, "Ihr findet den Rest in eurer letzten Zeile!"
            EndIf
            SetFont schrift3%
            GoTo h3
          Else If rest% <> 0
            If art| = 39 Or art| = 52
              If art| = 39
                hilfe_mal2(2, Int(b% / 2))
              Else If art| = 52
                If Right$(zb$, 3) = "000"
                  tausend| = 1
                  hilfe_mal2(2, Int(b% / 2000))
                EndIf
              EndIf
            Else If art| = 35
              hilfe_mal2(b%, c%)
            EndIf
            GoTo h3
          Else
            hauptmenue
          EndIf
        EndIf
      Else If Len(antwort_$) > 1 And Asc(Right$(antwort_$)) = 119      ' F8-Taste
        ende| = 1
        Clr f1%
        GoTo beenden
      Else If Len(antwort_$) = 2 And Asc(Right$(antwort_$)) = 39 And (art| = 31 Or art| = 44) And pfeil% = 0 ' Pfeil nach rechts, Ergänzen
        If eing$ = ""
          pfeil% = 1
          Color RGB(255, 255, 198) ' creme
          Box x%, y% + Int(4 * fy), x% + zeichenbr% - Ceil(2 * fx), y% + zeichenh%
          Color RGB(255, 0, 0) ' rot
          Box x% + TxtLen(Trim$(Str$(antwort%))) - zeichenbr%, y% + Int(4 * fy), x% + TxtLen(Trim$(Str$(antwort%))) - Ceil(2 * fx), y% + zeichenh%
        EndIf
      Else If antwort_$ = Chr$(8)                                 ' Backspace
        If pfeil% = 0
          eing$ = Left$(eing$, Max(0, Len(eing$) - 1))
        Else
          eing$ = Right$(eing$, Max(0, Len(eing$) - 1))
        EndIf
        If eing$ = "" And art| <> 27 And art| <> 40 And hilfe| < 2
          abdecken
          Clr l% ' Aufbau des eigenen Hilfs-Hunderterfelds
        EndIf
        Color RGB(255, 255, 198) ' creme
        If art| <> 28 And art| <> 41 And Left$(eing$) <> "E" And Left$(eing$) <> "e"
          Color RGB(255, 255, 198) ' creme
          If pfeil% = 0
            PBox x% + TxtLen(eing$), y% + Int(4 * fy), x% + TxtLen(eing$) + zeichenbr% - Ceil(2 * fx), y% + zeichenh%
          Else
            PBox x% + (TxtLen(Trim$(Str$(antwort%)))) - TxtLen(eing$) - zeichenbr%, y% + Int(4 * fy), x% + (TxtLen(Trim$(Str$(antwort%)))) - TxtLen(eing$) - Ceil(2 * fx), y% + zeichenh%
          EndIf
        Else
          l% = Len(eing$) + 1
          abstand% = 2 * fx
          abstand1% = 6 * fx
          tausendfeld
          If art| = 28
            hilfe_tausend(l% - 1)
          EndIf
          Color RGB(255, 255, 198) ' creme
          PBox 42 * fx + vx% + llx%, 282 * fy + vy% + lly%, 76 * fx + vx% + llx%, 286 * fy + vy% + lly%
        EndIf
      Else If Asc(antwort_$) > 47 And Asc(antwort_$) < 58 And art| <> 28 And art| <> 41 ' Zahlen von 0 bis 9
        If art| <> 28 And art| <> 41
          If pfeil% = 0
            If Left$(eing$) = "E" Or Left$(eing$) = "e"
              Repeat
                PeekEvent
                eing$ = Right$(eing$, Len(eing$) - 1)
              Until Left$(eing$) <> "E" And Left$(eing$) <> "e"
            EndIf
          Else
            If Right$(eing$) = "E" Or Right$(eing$) = "e"
              Repeat
                PeekEvent
                eing$ = Left$(eing$, Len(eing$) - 1)
              Until Right$(eing$) <> "E" And Right$(eing$) <> "e"
            EndIf
          EndIf
        EndIf
        If pfeil% = 0
          If Len(eing$) < xx%
            eing$ = eing$ + antwort_$
          EndIf
        Else
          If Len(eing$) < xx%
            eing$ = antwort_$ + eing$
          EndIf
        EndIf
        If pfeil% = 0
          Color RGB(255, 255, 198) ' creme
          PBox x%, y% + Int(4 * fy), x% + zeichenbr% - Ceil(2 * fx), y% + zeichenh%
          Color RGB(0, 0, 0) ' schwarz
          Text x%, y%, eing$
        Else
          Color RGB(255, 255, 198) ' creme
          Box x% + TxtLen(Trim$(Str$(antwort%))) - TxtLen(eing$), y% + Int(4 * fy), x% + TxtLen(Trim$(Str$(antwort%))) - TxtLen(eing$) + zeichenbr% - Ceil(2 * fx), y% + zeichenh%
          Color RGB(0, 0, 0) ' schwarz
          Text x% + TxtLen(Trim$(Str$(antwort%))) - TxtLen(eing$), y%, eing$
        EndIf
      Else If Asc(antwort_$) = 45 And aufgabenwahl| = 2             ' Minuszeichen
        Color RGB(255, 255, 198) ' creme
        If pfeil% = 0
          If Len(eing$) < xx%
            eing$ = eing$ + antwort_$
          EndIf
          Box x%, y% + Int(4 * fy), x% + zeichenbr% - Ceil(2 * fx), y% + zeichenh%
          Color RGB(0, 0, 0) ' schwarz
          Text x%, y%, eing$
        Else
          If Len(eing$) < xx%
            eing$ = antwort_$ + eing$
          EndIf
          Box x% + TxtLen(Trim$(Str$(antwort%))) - TxtLen(eing$), y% + Int(4 * fy), x% + TxtLen(Trim$(Str$(antwort%))) - TxtLen(eing$) + zeichenbr% - Ceil(2 * fx), y% + zeichenh%
          Color RGB(0, 0, 0) ' schwarz
          Text x% + TxtLen(Trim$(Str$(antwort%))) - TxtLen(eing$), y%, eing$
        EndIf
      Else If (antwort_$ = "E" Or antwort_$ = "e") And Len(eing$) < 1000 And Val(eing$) = 0 And ((art| = 28 Or art| = 41) Or (hilfe| = 1 And falsch1| < 2)) ' Einer
        eing$ = eing$ + antwort_$
        l% = Len(eing$)
        If l% = 1 And (art| = 28 Or art| = 41)
          Color RGB(255, 255, 198) ' creme
          Box antwx%, antwy% + Int(4 * fy), antwx% + zeichenbr% - Ceil(2 * fx), antwy% + zeichenh%
        EndIf
        If gruen% = 1
          Color RGB(0, 170, 0) ' grün
        Else
          Color RGB(0, 0, 235) ' blau
        EndIf
        abstand% = 2 * fx
        abstand1% = 6 * fx
        tausendfeld
        If art| = 28
          hilfe_tausend(l%)
        EndIf
        PBox 42 * fx + vx% + llx%, 282 * fy + lly% + vy%, 46 * fx + vx% + llx%, 286 * fy + lly% + vy%
      Else If (antwort_$ = "Z" Or antwort_$ = "z") And Len(eing$) < 991 And Val(eing$) = 0 And ((art| = 28 Or art| = 41) Or (hilfe| = 1 And falsch1| < 2)) ' Zehner
        l% = Len(eing$) + 1
        eing$ = eing$ + String$(10, "E")
        If l% = 1 And (art| = 28 Or art| = 41)
          Color RGB(255, 255, 198) ' creme
          Box antwx%, antwy% + Int(4 * fy), antwx% + zeichenbr% - Ceil(2 * fx), antwy% + zeichenh%
        EndIf
        If gruen% = 1
          Color RGB(0, 170, 0) ' grün
        Else
          Color RGB(0, 0, 235) ' blau
        EndIf
        abstand% = 2 * fx
        abstand1% = 6 * fx
        For i% = 0 To 9
          tausendfeld
          PBox 42 * fx + vx% + llx%, 282 * fy + vy% + lly%, 46 * fx + vx% + llx%, 286 * fy + vy% + lly%
          Inc l%
        Next i%
        If art| = 28
          hilfe_tausend(l% - 1)
        EndIf
      Else If (antwort_$ = "H" Or antwort_$ = "h") And Len(eing$) < 901 And Val(eing$) = 0 And ((art| = 28 Or art| = 41) Or (hilfe| = 1 And falsch1| < 2)) ' Hunderter
        l% = Len(eing$) + 1
        eing$ = eing$ + String$(100, "E")
        If l% = 1 And (art| = 28 Or art| = 41)
          Color RGB(255, 255, 198) ' creme
          Box antwx%, antwy% + Int(4 * fy), antwx% + zeichenbr% - Ceil(2 * fx), antwy% + zeichenh%
        EndIf
        If gruen% = 1
          Color RGB(0, 170, 0) ' grün
        Else
          Color RGB(0, 0, 235) ' blau
        EndIf
        abstand% = 2 * fx
        abstand1% = 6 * fx
        For i% = 0 To 99
          tausendfeld
          PBox 42 * fx + vx% + llx%, 282 * fy + vy% + lly%, 46 * fx + vx% + llx%, 286 * fy + vy% + lly%
          Inc l%
        Next i%
        If art| = 28
          hilfe_tausend(l% - 1)
        EndIf
      EndIf
    Loop
  EndIf
  aaaa$ = eing$  ' Übergabe an kontrolle
  beenden:
Return
>Procedure hilfe_tausend(i%)
  If hilfe| = 2 Or falsch1| > 0
    SetFont schrift1%
    Color RGB(255, 255, 198) ' creme
    If _Y < 481 Or _Y > 864  ' bis 640 x 480 oder nach 1152 *864
      If i% < 101
        PBox 70 * fx + vx%, 344 * fy + vy%, 106 * fx + vx%, 344 * fy + vy% + zeichenh%
        PBox 144 * fx + vx%, 344 * fy + vy%, 180 * fx + vx%, 344 * fy + vy% + zeichenh%
        Color RGB(255, 0, 0) ' rot
        Text 104 * fx + vx% - TxtLen(Trim$(Str$(i%))), 343 * fy + vy%, Trim$(Str$(i%))
      EndIf
      If i% > 100 And i% < 201
        PBox 70 * fx + vx%, 344 * fy + vy%, 106 * fx + vx%, 344 * fy + vy% + zeichenh%
        PBox 144 * fx + vx%, 344 * fy + vy%, 180 * fx + vx%, 344 * fy + vy% + zeichenh%
        PBox 218 * fx + vx%, 344 * fy + vy%, 254 * fx + vx%, 344 * fy + vy% + zeichenh%
        Color RGB(255, 0, 0) ' rot
        Text 104 * fx + vx% - TxtLen("100"), 343 * fy + vy%, "100"
        Text 178 * fx + vx% - TxtLen(Trim$(Str$(i%))), 343 * fy + vy%, Trim$(Str$(i%))
      EndIf
      If i% > 200 And i% < 301
        PBox 144 * fx + vx%, 344 * fy + vy%, 180 * fx + vx%, 344 * fy + vy% + zeichenh%
        PBox 218 * fx + vx%, 344 * fy + vy%, 254 * fx + vx%, 344 * fy + vy% + zeichenh%
        PBox 292 * fx + vx%, 344 * fy + vy%, 328 * fx + vx%, 344 * fy + vy% + zeichenh%
        Color RGB(255, 0, 0) ' rot
        Text 178 * fx + vx% - TxtLen("200"), 343 * fy + vy%, "200"
        Text 252 * fx + vx% - TxtLen(Trim$(Str$(i%))), 343 * fy + vy%, Trim$(Str$(i%))
      EndIf
      If i% > 300 And i% < 401
        PBox 218 * fx + vx%, 344 * fy + vy%, 254 * fx + vx%, 344 * fy + vy% + zeichenh%
        PBox 292 * fx + vx%, 344 * fy + vy%, 328 * fx + vx%, 344 * fy + vy% + zeichenh%
        PBox 366 * fx + vx%, 344 * fy + vy%, 402 * fx + vx%, 344 * fy + vy% + zeichenh%
        Color RGB(255, 0, 0) ' rot
        Text 252 * fx + vx% - TxtLen("300"), 343 * fy + vy%, "300"
        Text 326 * fx + vx% - TxtLen(Trim$(Str$(i%))), 343 * fy + vy%, Trim$(Str$(i%))
      EndIf
      If i% > 400 And i% < 501
        PBox 292 * fx + vx%, 344 * fy + vy%, 328 * fx + vx%, 344 * fy + vy% + zeichenh%
        PBox 366 * fx + vx%, 344 * fy + vy%, 402 * fx + vx%, 344 * fy + vy% + zeichenh%
        PBox 70 * fx + vx%, 436 * fy + vy%, 106 * fx + vx%, 436 * fy + vy% + zeichenh%
        Color RGB(255, 0, 0) ' rot
        Text 326 * fx + vx% - TxtLen("400"), 343 * fy + vy%, "400"
        Text 400 * fx + vx% - TxtLen(Trim$(Str$(i%))), 343 * fy + vy%, Trim$(Str$(i%))
      EndIf
      If i% > 500 And i% < 601
        PBox 366 * fx + vx%, 344 * fy + vy%, 402 * fx + vx%, 344 * fy + vy% + zeichenh%
        PBox 70 * fx + vx%, 436 * fy + vy%, 106 * fx + vx%, 436 * fy + vy% + zeichenh%
        PBox 144 * fx + vx%, 436 * fy + vy%, 180 * fx + vx%, 436 * fy + vy% + zeichenh%
        Color RGB(255, 0, 0) ' rot
        Text 400 * fx + vx% - TxtLen("500"), 343 * fy + vy%, "500"
        Text 104 * fx + vx% - TxtLen(Trim$(Str$(i%))), 435 * fy + vy%, Trim$(Str$(i%))
      EndIf
      If i% > 600 And i% < 701
        PBox 70 * fx + vx%, 436 * fy + vy%, 106 * fx + vx%, 436 * fy + vy% + zeichenh%
        PBox 144 * fx + vx%, 436 * fy + vy%, 180 * fx + vx%, 436 * fy + vy% + zeichenh%
        PBox 218 * fx + vx%, 436 * fy + vy%, 254 * fx + vx%, 436 * fy + vy% + zeichenh%
        Color RGB(255, 0, 0) ' rot
        Text 104 * fx + vx% - TxtLen("600"), 435 * fy + vy%, "600"
        Text 178 * fx + vx% - TxtLen(Trim$(Str$(i%))), 435 * fy + vy%, Trim$(Str$(i%))
      EndIf
      If i% > 700 And i% < 801
        PBox 144 * fx + vx%, 436 * fy + vy%, 180 * fx + vx%, 436 * fy + vy% + zeichenh%
        PBox 218 * fx + vx%, 436 * fy + vy%, 254 * fx + vx%, 436 * fy + vy% + zeichenh%
        PBox 292 * fx + vx%, 436 * fy + vy%, 328 * fx + vx%, 436 * fy + vy% + zeichenh%
        Color RGB(255, 0, 0) ' rot
        Text 178 * fx + vx% - TxtLen("700"), 435 * fy + vy%, "700"
        Text 252 * fx + vx% - TxtLen(Trim$(Str$(i%))), 435 * fy + vy%, Trim$(Str$(i%))
      EndIf
      If i% > 800 And i% < 901
        PBox 218 * fx + vx%, 436 * fy + vy%, 254 * fx + vx%, 436 * fy + vy% + zeichenh%
        PBox 292 * fx + vx%, 436 * fy + vy%, 328 * fx + vx%, 436 * fy + vy% + zeichenh%
        PBox 366 * fx + vx%, 436 * fy + vy%, 402 * fx + vx%, 436 * fy + vy% + zeichenh%
        Color RGB(255, 0, 0) ' rot
        Text 252 * fx + vx% - TxtLen("800"), 435 * fy + vy%, "800"
        Text 326 * fx + vx% - TxtLen(Trim$(Str$(i%))), 435 * fy + vy%, Trim$(Str$(i%))
      EndIf
      If i% > 900 And i% < 1001
        PBox 292 * fx + vx%, 436 * fy + vy%, 328 * fx + vx%, 436 * fy + vy% + zeichenh%
        PBox 350 * fx + vx%, 436 * fy + vy%, 402 * fx + vx%, 436 * fy + vy% + zeichenh%
        Color RGB(255, 0, 0) ' rot
        Text 326 * fx + vx% - TxtLen("900"), 435 * fy + vy%, "900"
        Text 400 * fx + vx% - TxtLen(Trim$(Str$(i%))), 435 * fy + vy%, Trim$(Str$(i%))
      EndIf
    Else If _Y < 601                                      ' 800 * 600
      If i% < 101
