SetFont schrift1%
Color RGB(0, 0, 235) ' blau
Text 30 * fx + vx%, 300 * fy + vy%, "Gib bitte deinen Namen ein,"
Text 30 * fx + vx%, 320 * fy + vy%, "danach       die Fertig-Taste (Return)!"
SetFont schriftw1%
Color RGB(255, 0, 0) ' rot
Text 98 * fx + vx%, 320 * fy + vy%, "ò"
DefLine 0, 1
Box 31 * fx + vx%, 362 * fy + vy%, 45 * fx + vx%, 380 * fy + vy%
SetFont schrift2%
Repeat
  Repeat
    Sleep
    ink$ = InKey$
  Until ink$ <> ""
  Exit If ink$ = Chr$(13)                  ' Return
  If ink$ = Chr$(8) And nam$ <> ""           ' Backspace
    nam$ = Left$(nam$, Len(nam$) - 1)
    Color RGB(255, 255, 198) ' creme
    PBox 29 * fx + vx% + TxtLen(nam$), 360 * fy + vy%, 68 * fx + vx% + TxtLen(nam$), 384 * fy + vy%
  EndIf
  If Len(ink$) = 1 And ((Asc(ink$) > 64 And Asc(ink$) < 91) Or (Asc(ink$) > 96 And Asc(ink$) < 123) Or ink$ = "Ä" Or ink$ = "Ö" Or ink$ = "Ü" Or ink$ = "ä" Or ink$ = "ö" Or ink$ = "ü" Or ink$ = "ß" Or ink$ = "+" Or ink$ = " ")
    Color RGB(255, 255, 198) ' creme
    Box 31 * fx + vx% + TxtLen(nam$), 362 * fy + vy%, 45 * fx + vx% + TxtLen(nam$), 380 * fy + vy%
    nam$ = nam$ + ink$
  EndIf
  If Left$(nam$) = " "
    nam$ = Right$(nam$, Len(nam$) - 1)
  EndIf
  Color RGB(0, 0, 0) ' schwarz
  Text 30 * fx + vx%, 360 * fy + vy%, nam$
  Color RGB(255, 0, 0) ' rot
  Box 31 * fx + vx% + TxtLen(nam$), 362 * fy + vy%, 45 * fx + vx% + TxtLen(nam$), 380 * fy + vy%
Until Len(nam$) > 32
If nam$ = ""
  nam$ = "???"
EndIf
Color RGB(255, 255, 198) ' creme
PBox 30 * fx + vx%, 300 * fy + vy%, 619 * fx + vx%, 400 * fy + vy%
SetFont schrift6%
Color RGB(255, 0, 0) ' rot
For i% = 1 To Min(22, Len(nam$))
  Text 30 * fx + vx%, 245 * fy + vy%, Left$(nam$, i%)
  zeit# = oTimer
  Repeat
    PeekEvent
    zeitneu# = oTimer
  Until zeitneu# > zeit# + 50
Next i%
Color RGB(0, 0, 235) ' blau
SetFont schrift4%
If InStr(nam$, " und ") = 0 And InStr(nam$, "+") = 0
  einzelner| = 1
  Text 30 * fx + vx%, 314 * fy + vy%, "rechnet"
  gib$ = "Gib "
  rechne$ = "Rechne"
  du$ = "Du hast "
  richt$ = "Richtig, lasse aber die"
Else
  Text 30 * fx + vx%, 314 * fy + vy%, "rechnen"
  gib$ = "Gebt "
  rechne$ = "Rechnet"
  du$ = "Ihr habt "
  richt$ = "Richtig, lasst aber die"
EndIf
