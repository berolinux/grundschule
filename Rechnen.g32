>Procedure falsch
  Color RGB(0, 0, 235) ' blau
  SetFont schrift1%
  Text 190 * fx + vx%, 419 * fy + vy%, "Achtung! Fehler!"
  Text 180 * fx + vx%, 440 * fy + vy%, "weiter:     Leertaste!"
  Color RGB(255, 0, 0) ' rot
  SetFont schriftw1%
  Text 240 * fx + vx%, 441 * fy + vy%, "ò"
  Color RGB(0, 0, 0) ' schwarz
  SetFont schrift3%
Return
>Procedure falsch_komma             ' Hilfsrechtecke übermalen
  DefLine 0, 1
  If wahl| = 8
    Color RGB(0, 190, 255) ' hell blaugrün
    Box Int(41 * fx + vx%) + zeichenbr% * (31 - Len(mass$) - stelle|), Int(30 * fy + vy%) + zeichenh% * 2, Int(41 * fx + vx%) + zeichenbr% * (32 - Len(mass$) - stelle|), antwy% + Int(18 * fy + vy%)
    Color RGB(255, 255, 198) ' creme
    Line Int(42 * fx + vx%) + zeichenbr% * (31 - Len(mass$) - stelle|), antwy% + Int(18 * fy + vy%), Int(41 * fx + vx%) + zeichenbr% * (32 - Len(mass$) - stelle|), antwy% + Int(18 * fy + vy%)
  Else
    Color RGB(0, 190, 255) ' hell blaugrün
    Box Int(41 * fx + vx%) + zeichenbr% * (28 - Len(mass$) - stelle|), Int(30 * fy + vy%) + zeichenh% * 2, Int(41 * fx + vx%) + zeichenbr% * (29 - Len(mass$) - stelle|), antwy% + Int(18 * fy + vy%)
    Color RGB(255, 255, 198) ' creme
    Line Int(42 * fx + vx%) + zeichenbr% * (28 - Len(mass$) - stelle|), antwy% + Int(18 * fy + vy%), Int(41 * fx + vx%) + zeichenbr% * (29 - Len(mass$) - stelle|), antwy% + Int(18 * fy + vy%)
  EndIf
Return
>Procedure abdecken                 ' Textabdeckung
