Color RGB(0, 0, 235) ' blau
jz# = 240
For i% = 1 To 16
  Text 30 * fx + vx%, 360 * fy + vy%, Left$(ii$, i%)
  zeit# = oTimer
  Repeat
    PeekEvent
    zeitneu# = oTimer
  Until zeitneu# > zeit# + jz#
  jz# = jz# / 1.4
Next i%
Clr ii$, jz#
zeit# = oTimer
Repeat
  PeekEvent
  zeitneu# = oTimer
Until zeitneu# > zeit# + 1000
hauptmenue
>Procedure alert2(al$, al1$, al2$)
  GraphMode R2_COPYPEN, TRANSPARENT
  DefLine 0, fy
  Color RGB(100, 0, 0) ' dunkelbraun
  PBox 75 * fx + vx%, 175 * fy + vy%, 563 * fx + vx%, 303 * fy + vy%
  Color RGB(255, 0, 0) ' rot
  Box 78 * fx + vx%, 178 * fy + vy%, 560 * fx + vx%, 300 * fy + vy%
  Color RGB(255, 255, 198) ' creme
  PBox 87 * fx + vx%, 187 * fy + vy%, 551 * fx + vx%, 291 * fy + vy%
  Color RGB(0, 0, 0) ' schwarz
  SetFont schrift1%
  Text 99 * fx + vx%, 215 * fy + vy%, al$
  DefLine 0, 2 * fy
  Color RGB(190, 225, 255) ' hellblau
  PBox 179 * fx + vx%, 258 * fy + vy%, 299 * fx + vx%, 280 * fy + vy%
  PBox 339 * fx + vx%, 258 * fy + vy%, 459 * fx + vx%, 280 * fy + vy%
  Color RGB(100, 0, 0) ' dunkelbraun
  Box 179 * fx + vx%, 258 * fy + vy%, 299 * fx + vx%, 280 * fy + vy%
  Box 339 * fx + vx%, 258 * fy + vy%, 459 * fx + vx%, 280 * fy + vy%
  DefLine 0, fy
  Stretch 489 * fx + vx%, 195 * fy + vy%, grins, 50 * fx, 56 * fy
  SetFont schrift1%
  Text 189 * fx + vx%, 258 * fy + vy%, al1$
  Text 349 * fx + vx%, 258 * fy + vy%, al2$
  Repeat
    PeekEvent
  Until MouseK = 0
  Repeat
    PeekEvent
    Mouse x%, y%, k%
  Until k% = 1 And ((x% > 179 * fx + vx% And x% < 299 * fx + vx%) Or (x% > 339 * fx + vx% And x% < 459 * fx + vx%)) And y% > 258 * fy + vy% And y% < 280 * fy + vy%
  If x% < 319 * fx + vx%
    alertf| = 1
  Else
    alertf| = 2
  EndIf
  DefLine 0, 1
Return
>Procedure alert3(al$, al1$, al2$, al3$)
  GraphMode R2_COPYPEN, TRANSPARENT
  DefLine 0, fy
  Color RGB(100, 0, 0) ' dunkelbraun
  PBox 75 * fx + vx%, 175 * fy + vy%, 563 * fx + vx%, 303 * fy + vy%
  Color RGB(255, 0, 0) ' rot
  Box 78 * fx + vx%, 178 * fy + vy%, 560 * fx + vx%, 300 * fy + vy%
  Color RGB(255, 255, 198) ' creme
  PBox 87 * fx + vx%, 187 * fy + vy%, 551 * fx + vx%, 291 * fy + vy%
  Color RGB(0, 0, 0) ' schwarz
  SetFont schrift1%
  Text 99 * fx + vx%, 215 * fy + vy%, al$
  DefLine 0, 2 * fy
  Color RGB(190, 225, 255) ' hellblau
  PBox 169 * fx + vx%, 258 * fy + vy%, 249 * fx + vx%, 280 * fy + vy%
  PBox 279 * fx + vx%, 258 * fy + vy%, 359 * fx + vx%, 280 * fy + vy%
  PBox 389 * fx + vx%, 258 * fy + vy%, 469 * fx + vx%, 280 * fy + vy%
  Color RGB(100, 0, 0) ' dunkelbraun
  Box 169 * fx + vx%, 258 * fy + vy%, 249 * fx + vx%, 280 * fy + vy%
  Box 279 * fx + vx%, 258 * fy + vy%, 359 * fx + vx%, 280 * fy + vy%
  Box 389 * fx + vx%, 258 * fy + vy%, 469 * fx + vx%, 280 * fy + vy%
  DefLine 0, fy
  Stretch 489 * fx + vx%, 195 * fy + vy%, grins, 50 * fx, 56 * fy
  SetFont schrift1%
  Text 179 * fx + vx%, 258 * fy + vy%, al1$
  Text 289 * fx + vx%, 258 * fy + vy%, al2$
  Text 399 * fx + vx%, 258 * fy + vy%, al3$
  Clr k%
  Repeat
    PeekEvent
  Until MouseK = 0
  Repeat
    PeekEvent
    Mouse x%, y%, k%
  Until k% = 1 And ((x% > 169 * fx + vx% And x% < 249 * fx + vx%) Or (x% > 279 * fx + vx% And x% < 359 * fx + vx%) Or (x% > 389 * fx + vx% And x% < 469 * fx + vx%)) And y% > 258 * fy + vy% And y% < 280 * fy + vy%
  If x% < 249 * fx + vx%
    alertf| = 1
  Else If x% < 359 * fx + vx%
    alertf| = 2
  Else
    alertf| = 3
  EndIf
  DefLine 0, 1
Return
>Procedure rechenblatt
  Color RGB(255, 255, 198), RGB(255, 255, 198)
  DefFill 0
  PRBox 3 * fx + vx%, 3 * fy + vy%, 633 * fx + vx%, 475 * fy + vy%
  DefLine 0, 12 * fy
  DefFill 42
  PRBox 7 * fx + vx%, 8 * fy + vy%, 631 * fx + vx%, 473 * fy + vy%
  Color RGB(255, 0, 0) ' rot
  PRBox 6 * fx + vx%, 6 * fy + vy%, 632 * fx + vx%, 473 * fy + vy%
  DefFill 0
  DefLine 0, 1
  Color RGB(0, 190, 255) ' hell blaugrün
  Line 18 * fx + vx%, Int(30 * fy + vy%), Int(41 * fx + vx%) + zeichenbr% * 32 + 1, Int(30 * fy + vy%) ' waagerecht
  For i% = 1 To 11                                                             ' Rechenhäuschen
    Line 11 * fx + vx%, Int(30 * fy + vy%) + i% * zeichenh%, Int(41 * fx + vx%) + zeichenbr% * 32 + 1, Int(30 * fy + vy%) + i% * zeichenh%
  Next i%
  Line Int(41 * fx + vx%) - zeichenbr%, 22 * fy + vy%, Int(41 * fx + vx%) - zeichenbr%, Int(30 * fy + vy%) + 11 * zeichenh% ' senkrecht
  For i% = 0 To 32
    Line Int(41 * fx + vx%) + i% * zeichenbr%, 12 * fy + vy%, Int(41 * fx + vx%) + i% * zeichenbr%, Int(30 * fy + vy%) + 11 * zeichenh%
  Next i%
  Color RGB(255, 0, 0) ' rot
  DefLine 0, 12 * fy
  DefFill 42
  PRBox 6 * fx + vx%, 6 * fy + vy%, 632 * fx + vx%, 473 * fy + vy%
  Color RGB(255, 255, 255), ' weiß
  SetFont schrift0
  Text Int((_X - vx% - TxtLen(nam$)) / 2), 464 * fy + vy%, nam$
  DefFill 0
  DefLine 0, 1
Return
>Procedure menue                         ' Aufbau und Abfrage des Hauptmenüs
  Output = Win_2
  Repeat
    PeekEvent
  Until MouseK = 0
  GraphMode R2_COPYPEN, OPAQUE
  DefLine 0, fy                            ' Aufbau des Hauptmenüs
  Color RGB(75, 0, 0)
  PBox 0, 0, _X, _Y
  Color RGB(100, 0, 0) ' dunkelbraun
  PRBox 3 * fx + vx%, 3 * fy + vy%, 633 * fx + vx%, 475 * fy + vy%
  Color RGB(255, 255, 198) ' creme
  PBox 4 * fx + vx%, 96 * fy + vy%, 632 * fx + vx%, 364 * fy + vy%
  PBox 61 * fx + vx%, 51 * fy + vy%, 299 * fx + vx%, 74 * fy + vy%
  PBox 337 * fx + vx%, 51 * fy + vy%, 577 * fx + vx%, 74 * fy + vy%
  Color RGB(255, 0, 0) ' rot
  DefLine 0, 12 * fy
  DefFill 42
  PRBox 6 * fx + vx%, 6 * fy + vy%, 632 * fx + vx%, 473 * fy + vy%
  DefFill 0
  DefLine 0, 3 * fy
  RBox 59 * fx + vx%, 50 * fy + vy%, 301 * fx + vx%, 75 * fy + vy%
  RBox 335 * fx + vx%, 50 * fy + vy%, 579 * fx + vx%, 75 * fy + vy%
  Line 4 * fx + vx%, 95 * fy + vy%, 632 * fx + vx%, 95 * fy + vy%
  Line 4 * fx + vx%, 185 * fy + vy%, 632 * fx + vx%, 185 * fy + vy%
  Line 4 * fx + vx%, 275 * fy + vy%, 632 * fx + vx%, 275 * fy + vy%
  Line 4 * fx + vx%, 365 * fy + vy%, 632 * fx + vx%, 365 * fy + vy%
  Line 318 * fx + vx%, 95 * fy + vy%, 318 * fx + vx%, 365 * fy + vy%
  Line 157 * fx + vx%, 275 * fy + vy%, 157 * fx + vx%, 365 * fy + vy%
  GraphMode R2_COPYPEN, TRANSPARENT
  Color RGB(255, 255, 255) ' weiß
  SetFont schrift0%
  If einzelner| = 1
    Text 60 * fx + vx%, 20 * fy + vy%, "Hier kannst du auswählen:"
  Else
    Text 60 * fx + vx%, 20 * fy + vy%, "Hier könnt ihr auswählen:"
  EndIf
  Text Int((_X - vx% - TxtLen(nam$)) / 2), 464 * fy + vy%, nam$
  SetFont schrift1%
  Color RGB(0, 0, 235) ' blau
  Text 110 * fx + vx%, 52 * fy + vy%, "Hilfe: ja"
  Text 381 * fx + vx%, 52 * fy + vy%, "Hilfe: nein"
  SetFont schrift4%
  Text 55 * fx + vx%, 118 * fy + vy%, "Rechnen  1"
  Text 360 * fx + vx%, 118 * fy + vy%, "Rechnen  2"
  Text 55 * fx + vx%, 208 * fy + vy%, "Rechnen  3"
  Text 360 * fx + vx%, 208 * fy + vy%, "Rechnen  4"
  SetFont schrift2%
  Text 509 * fx + vx%, 299 * fy + vy%, "1"
  SetFont schrift0%
  Text 500 * fx + vx%, 322 * fy + vy%, "EURO"
  SetFont schriftw5%
  Color RGB(0, 255, 0) ' hellgrün
  Text 52 * fx + vx%, 277 * fy + vy%, ":"     ' Computer
  Text 195 * fx + vx%, 277 * fy + vy%, "7"    ' Tastatur
  Color RGB(0, 0, 235) ' blau
  Text 385 * fx + vx%, 277 * fy + vy%, "¹"    ' Uhr
  Text 482 * fx + vx%, 277 * fy + vy%, "m"    ' Geld
  Color RGB(255, 255, 255) ' weiß
  Text 120 * fx + vx%, 380 * fy + vy%, "8"    ' Maus
  Text 425 * fx + vx%, 380 * fy + vy%, "7"    ' Tastatur
  SetFont schrift0%
  Text 40 * fx + vx%, 380 * fy + vy%, "linke Maustaste:"
  Text 40 * fx + vx%, 395 * fy + vy%, "          Auswahl"
  Text 200 * fx + vx%, 380 * fy + vy%, "rechte Maustaste:"
  Text 200 * fx + vx%, 395 * fy + vy%, "weiter"
  Text 356 * fx + vx%, 380 * fy + vy%, "Taste F1:"
  Text 356 * fx + vx%, 395 * fy + vy%, "Hilfe: ja/nein"
  Text 480 * fx + vx%, 380 * fy + vy%, "Taste F8: Ende"
  Color RGB(255, 0, 0) ' rot
  PBox 441 * fx + vx%, 420 * fy + vy%, 446 * fx + vx%, 425 * fy + vy%
  PBox 480 * fx + vx%, 420 * fy + vy%, 485 * fx + vx%, 425 * fy + vy%
  SetFont schriftw2%
  Text 435 * fx + vx%, 393 * fy + vy%, "ò"    'Pfeil
  Text 474 * fx + vx%, 393 * fy + vy%, "ò"
  Text 160 * fx + vx%, 381 * fy + vy%, "òò"
  Get 0, 0, _X, _Y, fenster$
  Output = Win_1
  Put 0, 0, fenster$
  Clr fenster$
  DefLine 0, 1
  DefMouse 0
  GraphMode R2_COPYPEN, OPAQUE
  Do
    Repeat
      Sleep
      Mouse x%, y%, k%
      ink$ = InKey$
    Until k% <> 0 Or (Len(ink$) > 1 And Asc(Right$(ink$)) = 119) Or ink$ = "S" Or ink$ = "s" ' F8
    Exit If k% = 2
    If ink$ = "S" Or ink$ = "s"
      Clr k%
      speichern_| = 1
      GraphMode R2_COPYPEN, TRANSPARENT
      Color RGB(255, 255, 255) ' weiß
      SetFont schrift0%
      Text 240 * fx + vx%, 445 * fy + vy%, "Ergebnis speichern"
      GraphMode R2_COPYPEN, OPAQUE
    EndIf
    If Len(ink$) > 1 And Asc(Right$(ink$)) = 119 ' F8
      Color RGB(0, 0, 0) ' schwarz
      DefMouse 0
      Repeat
        PeekEvent
      Until _Mess = 0
      If einzelner| = 1
        alert2("Willst du wirklich aufhören?", "Ende", "zurück")
      Else
        alert2("Wollt ihr wirklich aufhören?", "Ende", "zurück")
      EndIf
      DefMouse V:aaa%(0)        ' transparente Mausform
      If alertf| = 1
        ende
      EndIf
      Repeat
        PeekEvent
      Until MouseK = 0
      hauptmenue
    EndIf
    Repeat
      PeekEvent
    Until MouseK = 0
'##B#
    xx% = Int((x% - vx%) / fx)
    GraphMode R2_COPYPEN, TRANSPARENT
    SetFont schrift1%
    If y% < 74 * fy + vy% And y% > 51 * fy + vy%               ' Hilfe
      Select xx%
      Case 60 To 300
        Select hilfe|
        Case 0
          Color RGB(0, 0, 235) ' blau
          PBox 60 * fx + vx%, 52 * fy + vy%, 299 * fx + vx%, 73 * fy + vy%
          Color RGB(255, 255, 198) ' creme
          Text 110 * fx + vx%, 52 * fy + vy%, "Hilfe: ja"
          hilfe| = 2
          hilferuf| = 1
        Case 1
          Color RGB(0, 0, 235) ' blau
          PBox 60 * fx + vx%, 52 * fy + vy%, 299 * fx + vx%, 73 * fy + vy%
          Color RGB(255, 255, 198) ' creme
          Text 110 * fx + vx%, 52 * fy + vy%, "Hilfe: ja"
          PBox 337 * fx + vx%, 52 * fy + vy%, 577 * fx + vx%, 73 * fy + vy%
          Color RGB(0, 0, 235) ' blau
          Text 381 * fx + vx%, 52 * fy + vy%, "Hilfe: nein"
          hilfe| = 2
          hilferuf| = 1
        EndSelect
      Case 336 To 578
        Select hilfe|
        Case 0
          Color RGB(0, 0, 235) ' blau
          PBox 337 * fx + vx%, 52 * fy + vy%, 577 * fx + vx%, 73 * fy + vy%
          Color RGB(255, 255, 198) ' creme
          Text 381 * fx + vx%, 52 * fy + vy%, "Hilfe: nein"
          hilfe| = 1
        Case 2
          Color RGB(255, 255, 198) ' creme
          PBox 60 * fx + vx%, 52 * fy + vy%, 299 * fx + vx%, 73 * fy + vy%
          Color RGB(0, 0, 235) ' blau
          Text 110 * fx + vx%, 52 * fy + vy%, "Hilfe: ja"
          PBox 337 * fx + vx%, 52 * fy + vy%, 577 * fx + vx%, 73 * fy + vy%
          Color RGB(255, 255, 198) ' creme
          Text 381 * fx + vx%, 52 * fy + vy%, "Hilfe: nein"
          hilfe| = 1
        EndSelect
      EndSelect
    EndIf
    If (y% > 95 * fy + vy% And y% < 275 * fy + vy%) Or (y% > 275 * fy + vy% And y% < 365 * fy + vy% And xx% > 318) ' Rechnen
      If y% < 185 * fy + vy%
        Clr rechnenalt|
        Select xx%
        Case 5 To 317
          Select rechnen|
          Case 2, 3, 4, 5
            rechnenalt| = rechnen|
            rechnen| = 1
          Case 1
            rechnenalt| = 1
          Case 0
            rechnen| = 1
          EndSelect
        Case 319 To 631
          Select rechnen|
          Case 1, 3, 4, 5
            rechnenalt| = rechnen|
            rechnen| = 2
          Case 2
            rechnenalt| = 2
          Case 0
            rechnen| = 2
          EndSelect
        Default
          GoTo falsch
        EndSelect
      Else If y% < 275 * fy + vy%
        Clr rechnenalt|
        Select xx%
        Case 5 To 317
          Select rechnen|
          Case 1, 2, 4, 5
            rechnenalt| = rechnen|
            rechnen| = 3
          Case 3
            rechnenalt| = 3
          Case 0
            rechnen| = 3
          EndSelect
        Case 319 To 631
          Select rechnen|
          Case 1, 2, 3, 5
            rechnenalt| = rechnen|
            rechnen| = 4
          Case 4
            rechnenalt| = 4
          Case 0
            rechnen| = 4
          EndSelect
        Default
          GoTo falsch
        EndSelect
      Else If y% > 275 * fy + vy% And y% < 365 * fy + vy% And xx% > 318
        Clr rechnenalt|
        Select rechnen|
        Case 1, 2, 3, 4
          rechnenalt| = rechnen|
          rechnen| = 5
        Case 5
          rechnenalt| = 5
        Case 0
          rechnen| = 5
        EndSelect
      EndIf
      SetFont schrift4%
      Color RGB(255, 255, 198) ' creme
      Select rechnenalt|
      Case 1
        PBox 12 * fx + vx%, 97 * fy + vy%, 316 * fx + vx%, 183 * fy + vy%
        Color RGB(0, 0, 235) ' blau
        Text 55 * fx + vx%, 118 * fy + vy%, "Rechnen  1"
      Case 2
        PBox 320 * fx + vx%, 97 * fy + vy%, 626 * fx + vx%, 183 * fy + vy%
        Color RGB(0, 0, 235) ' blau
        Text 360 * fx + vx%, 118 * fy + vy%, "Rechnen  2"
      Case 3
        PBox 12 * fx + vx%, 187 * fy + vy%, 316 * fx + vx%, 273 * fy + vy%
        Color RGB(0, 0, 235) ' blau
        Text 55 * fx + vx%, 208 * fy + vy%, "Rechnen  3"
      Case 4
        PBox 320 * fx + vx%, 187 * fy + vy%, 626 * fx + vx%, 273 * fy + vy%
        Color RGB(0, 0, 235) ' blau
        Text 360 * fx + vx%, 208 * fy + vy%, "Rechnen  4"
      Case 5
        PBox 320 * fx + vx%, 277 * fy + vy%, 626 * fx + vx%, 363 * fy + vy%
        Color RGB(0, 0, 235) ' blau
        SetFont schriftw5%
        Text 385 * fx + vx%, 277 * fy + vy%, "¹"    ' Uhr
        Text 482 * fx + vx%, 277 * fy + vy%, "m"    ' Geld
        SetFont schrift2%
        Text 509 * fx + vx%, 299 * fy + vy%, "1"
        SetFont schrift0%
        Text 505 * fx + vx%, 322 * fy + vy%, "DM"
      EndSelect
      SetFont schrift4%
      Color RGB(0, 0, 235) ' blau
      Select rechnen|
      Case 1
        PBox 12 * fx + vx%, 97 * fy + vy%, 316 * fx + vx%, 183 * fy + vy%
        Color RGB(255, 255, 198) ' creme
        Text 55 * fx + vx%, 118 * fy + vy%, "Rechnen  1"
      Case 2
        PBox 320 * fx + vx%, 97 * fy + vy%, 626 * fx + vx%, 183 * fy + vy%
        Color RGB(255, 255, 198) ' creme
        Text 360 * fx + vx%, 118 * fy + vy%, "Rechnen  2"
      Case 3
        PBox 12 * fx + vx%, 187 * fy + vy%, 316 * fx + vx%, 273 * fy + vy%
        Color RGB(255, 255, 198) ' creme
        Text 55 * fx + vx%, 208 * fy + vy%, "Rechnen  3"
      Case 4
        PBox 320 * fx + vx%, 187 * fy + vy%, 626 * fx + vx%, 273 * fy + vy%
        Color RGB(255, 255, 198) ' creme
        Text 360 * fx + vx%, 208 * fy + vy%, "Rechnen  4"
      Case 5
        PBox 320 * fx + vx%, 277 * fy + vy%, 626 * fx + vx%, 363 * fy + vy%
        Color RGB(255, 255, 198) ' creme
        SetFont schriftw5%
        Text 385 * fx + vx%, 277 * fy + vy%, "¹"    ' Uhr
        Text 482 * fx + vx%, 277 * fy + vy%, "m"    ' Geld
        SetFont schrift2%
        Text 509 * fx + vx%, 299 * fy + vy%, "1"
        SetFont schrift0%
        Text 505 * fx + vx%, 322 * fy + vy%, "DM"
      EndSelect
    EndIf
    If y% > 275 * fy + vy% And y% < 365 * fy + vy% And xx% < 318
      SetFont schriftw5%
      Select xx%
      Case 5 To 156
        Select aufgabenwahl|
        Case 0
          Color RGB(0, 0, 235) ' blau
          PBox 12 * fx + vx%, 277 * fy + vy%, 155 * fx + vx%, 363 * fy + vy%
          Color RGB(255, 255, 198) ' creme
          Text 52 * fx + vx%, 277 * fy + vy%, ":"     ' Computer
          aufgabenwahl| = 1
        Case 2
          Color RGB(0, 0, 235) ' blau
          PBox 12 * fx + vx%, 277 * fy + vy%, 155 * fx + vx%, 363 * fy + vy%
          Color RGB(255, 255, 198) ' creme
          Text 52 * fx + vx%, 277 * fy + vy%, ":"     ' Computer
          PBox 159 * fx + vx%, 277 * fy + vy%, 316 * fx + vx%, 363 * fy + vy%
          Color RGB(0, 255, 0) ' hellgrün
          Text 195 * fx + vx%, 277 * fy + vy%, "7"    ' Tastatur
          aufgabenwahl| = 1
        EndSelect
      Case 158 To 317
        Select aufgabenwahl|
        Case 0
          Color RGB(0, 0, 235) ' blau
          PBox 159 * fx + vx%, 277 * fy + vy%, 316 * fx + vx%, 363 * fy + vy%
          Color RGB(255, 255, 198) ' creme
          Text 195 * fx + vx%, 277 * fy + vy%, "7"    ' Tastatur
          aufgabenwahl| = 2
        Case 1
          Color RGB(0, 0, 235) ' blau
          PBox 159 * fx + vx%, 277 * fy + vy%, 316 * fx + vx%, 363 * fy + vy%
          Color RGB(255, 255, 198) ' creme
          Text 195 * fx + vx%, 277 * fy + vy%, "7"    ' Tastatur
          PBox 12 * fx + vx%, 277 * fy + vy%, 155 * fx + vx%, 363 * fy + vy%
          Color RGB(0, 255, 0) ' hellgrün
          Text 52 * fx + vx%, 277 * fy + vy%, ":"     ' Computer
          aufgabenwahl| = 2
        EndSelect
      EndSelect
    EndIf
    falsch:
  Loop Until k% = 2
  If rechnen| = 0
    rechnen| = 1
  EndIf
  If aufgabenwahl| = 0
    aufgabenwahl| = 1
  EndIf
  If hilfe| = 0
    hilfe| = 1
  EndIf
  Output = Win_2
  menue0
  Select rechnen|
  Case 1
    menue1
  Case 2
    menue2
  Case 3
    menue3
  Case 4
    menue4
  Case 5
    art| = 53
    menue_geld_uhr
  EndSelect
  If rechnen| < 5
    Get 0, 0, _X, _Y, fenster$
    Output = Win_1
    Put 0, 0, fenster$
    Clr fenster$
  EndIf
  DefLine 0, 1
  DefMouse V:aaa%(0)        ' transparente Mausform
Return
>Procedure menue0                        ' Aufbau: weitere Menüs
  GraphMode R2_COPYPEN, OPAQUE
  DefLine 0, fy
  Color RGB(75, 0, 0)
  PBox 0, 0, _X, _Y
  Color RGB(100, 0, 0) ' dunkelbraun
  PRBox 3 * fx + vx%, 3 * fy + vy%, 633 * fx + vx%, 475 * fy + vy%
  Color RGB(255, 255, 198) ' creme
  PBox 4 * fx + vx%, 77 * fy + vy%, 632 * fx + vx%, 413 * fy + vy%
  PBox 103 * fx + vx%, 41 * fy + vy%, 209 * fx + vx%, 62 * fy + vy%
  PBox 265 * fx + vx%, 41 * fy + vy%, 371 * fx + vx%, 62 * fy + vy%
  PBox 427 * fx + vx%, 41 * fy + vy%, 533 * fx + vx%, 62 * fy + vy%
  Color RGB(255, 0, 0) ' rot
  DefLine 0, 12 * fy
  DefFill 42
  PRBox 6 * fx + vx%, 6 * fy + vy%, 632 * fx + vx%, 473 * fy + vy%
  DefFill 0
  DefLine 0, 3 * fy
  RBox 102 * fx + vx%, 40 * fy + vy%, 210 * fx + vx%, 63 * fy + vy%
  RBox 264 * fx + vx%, 40 * fy + vy%, 372 * fx + vx%, 63 * fy + vy%
  RBox 426 * fx + vx%, 40 * fy + vy%, 534 * fx + vx%, 63 * fy + vy%
  GraphMode R2_COPYPEN, TRANSPARENT
  Color RGB(255, 255, 255) ' weiß
  SetFont schrift0%
  Text Int((_X - vx% - TxtLen(nam$)) / 2), 464 * fy + vy%, nam$
  If einzelner| = 1
    Text 60 * fx + vx%, 20 * fy + vy%, "Hier kannst du auswählen:"
  Else
    Text 60 * fx + vx%, 20 * fy + vy%, "Hier könnt ihr auswählen:"
  EndIf
  Text 230 * fx + vx% - TxtLen("linke Maustaste:"), 425 * fy + vy%, "linke Maustaste:"
  Text 230 * fx + vx% - TxtLen("rechte Maustaste:"), 440 * fy + vy%, "rechte Maustaste:"
  Text 240 * fx + vx%, 425 * fy + vy%, "Auswahl"
  Text 240 * fx + vx%, 440 * fy + vy%, "weiter"
  Color RGB(255, 255, 198) ' creme
  PRBox 562 * fx + vx%, 23 * fy + vy%, 600 * fx + vx%, 68 * fy + vy%        ' Box für Kennzeichnung des Menüs
  Color RGB(255, 0, 0) ' rot
  RBox 560 * fx + vx%, 21 * fy + vy%, 602 * fx + vx%, 70 * fy + vy%
  DefLine 0, 2 * fy
  SetFont schrift2%
  j% = 1
  For i% = 54 To 400 Step 26
    Color RGB(255, 0, 0) ' rot
    Line 6 * fx + vx%, i% * fy + vy% + 22 * fy, 631 * fx + vx%, i% * fy + vy% + 22 * fy
    Color RGB(0, 0, 0) ' schwarz
    If j% > 1
      Text 45 * fx + vx% - TxtLen(Trim$(Str$(j% - 1))), i% * fy + vy% - 2 * fy, Trim$(Str$(j% - 1)) + "."
    EndIf
    Inc j%
  Next i%
  Clr j%
  DefLine 0, 1
Return
>Procedure menue1
  GraphMode R2_COPYPEN, TRANSPARENT
  DefLine 0, fy
  Color RGB(0, 0, 0) ' schwarz
  SetFont schrift6%
