  Color RGB(255, 0, 0) ' rot
  Box 97 * fx + vx% + TxtLen("14 + 1 = "), 80 * fy + vy%, 111 * fx + vx% + TxtLen("14 + 1 = "), 98 * fy + vy%                  ' 1.
