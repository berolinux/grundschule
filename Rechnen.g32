  Text 292 * fx + vx%, 43 * fy + vy%, "Stufe 2"
  Text 454 * fx + vx%, 43 * fy + vy%, "Stufe 3"
  Color RGB(255, 255, 255) ' weiß
  SetFont schrift0%
  Text Int((_X - vx% - TxtLen(nam$)) / 2), 464 * fy + vy%, nam$
  If einzelner| = 1
    Text 60 * fx + vx%, 20 * fy + vy%, "Hier kannst du auswählen:"
  Else
    Text 60 * fx + vx%, 20 * fy + vy%, "Hier könnt ihr auswählen:"
  EndIf
  Color RGB(255, 0, 0) ' rot
  SetFont schriftw3%
  Text 96 * fx + vx% + zeichenbr% * 20, 105 * fy + vy%, "ò"                                    ' 2.
  Text 96 * fx + vx% + zeichenbr% * 25, 105 * fy + vy%, "ò"                                    ' 2.
  Text 96 * fx + vx% + zeichenbr% * 30, 105 * fy + vy%, "ò"                                    ' 2.
  Color RGB(0, 0, 235) ' blau
  SetFont schrift3%
  Text 96 * fx + vx%, 104 * fy + vy%, "700                   H,   Z,   E "    ' 2.
  Text 96 * fx + vx%, 130 * fy + vy%, "400 + 300 =  "                         ' 3.
  Text 96 * fx + vx%, 156 * fy + vy%, "800 - 300 =                          " ' 4.
  Text 96 * fx + vx%, 182 * fy + vy%, "346 +     = 400                      " ' 5.
  Text 96 * fx + vx%, 208 * fy + vy%, "326 +   6 =                          " ' 6.
  Text 96 * fx + vx%, 234 * fy + vy%, "326 -   8 =                          " ' 7.
  Text 96 * fx + vx%, 260 * fy + vy%, "  7 ·  40 =                          " ' 8.
  Text 96 * fx + vx%, 286 * fy + vy%, "280 =   · 70     280 : 70 =          " ' 9.
  Text 96 * fx + vx%, 312 * fy + vy%, "schriftlich addieren"                  ' 10.
  Text 96 * fx + vx%, 338 * fy + vy%, "schriftlich subtrahieren"              ' 11.
  Text 96 * fx + vx%, 364 * fy + vy%, "  2 · 450 =          das Doppelte"     ' 12.
  Text 96 * fx + vx%, 390 * fy + vy%, "800 :   2 =          die Hälfte"       ' 13.
  Color RGB(255, 0, 0) ' rot
  Box 97 * fx + vx% + TxtLen("            "), 80 * fy + vy%, 111 * fx + vx% + TxtLen("            "), 98 * fy + vy%                              ' 1.
  Box 97 * fx + vx% + TxtLen("144 + 144 = "), 132 * fy + vy%, 111 * fx + vx% + TxtLen("144 + 144 = "), 150 * fy + vy%          ' 3.
  Box 97 * fx + vx% + TxtLen("144 + 144 = "), 158 * fy + vy%, 111 * fx + vx% + TxtLen("144 + 144 = "), 176 * fy + vy%         ' 4.
  Box 97 * fx + vx% + TxtLen("144 + "), 184 * fy + vy%, 111 * fx + vx% + TxtLen("144 = "), 202 * fy + vy%                              ' 5.
  Box 97 * fx + vx% + TxtLen("144 + 144 = "), 210 * fy + vy%, 111 * fx + vx% + TxtLen("144 + 144 = "), 228 * fy + vy%         ' 6.
  Box 97 * fx + vx% + TxtLen("144 + 144 = "), 236 * fy + vy%, 111 * fx + vx% + TxtLen("144 + 144 = "), 254 * fy + vy%         ' 7.
  Box 97 * fx + vx% + TxtLen("144 + 144 = "), 262 * fy + vy%, 111 * fx + vx% + TxtLen("144 + 144 = "), 280 * fy + vy%         ' 8.
  Box 97 * fx + vx% + TxtLen("144 = "), 288 * fy + vy%, 111 * fx + vx% + TxtLen("144 = "), 306 * fy + vy%                              ' 9.
  Box 97 * fx + vx% + TxtLen("144 =   · 70     280 : 70 = "), 288 * fy + vy%, 111 * fx + vx% + TxtLen("144 =   · 70     280 : 70 = "), 306 * fy + vy%   ' 9.
  Box 97 * fx + vx% + TxtLen("144 + 144 = "), 366 * fy + vy%, 111 * fx + vx% + TxtLen("144 + 144 = "), 384 * fy + vy%         ' 12.
  Box 97 * fx + vx% + TxtLen("144 + 144 = "), 392 * fy + vy%, 111 * fx + vx% + TxtLen("144 + 144 = "), 410 * fy + vy%         ' 13.
  Color RGB(0, 0, 0) ' schwarz
  SetFont schrift0%
  Text 282 * fx + vx%, 292 * fy + vy%, "oder"                                 ' 9.
  Color RGB(0, 0, 235) ' blau
'##B#
  b% = 84 * fy + vy%
'##B#
  c% = 5 * fx
  For j% = 0 To 2
'##B#
    a% = 100 * fx + vx%
    For i% = 0 To 10
      If i% <> 5
        PBox a%, b%, a% + 3 * fx, b% + 3 * fy
      EndIf
      Add a%, c%
    Next i%
    Add b%, c%
  Next j%
  DefLine 0, 1
Return
>Procedure menue4
  GraphMode R2_COPYPEN, TRANSPARENT
  DefLine 0, fy
  Color RGB(0, 0, 0) ' schwarz
  SetFont schrift6%
  Text 568 * fx + vx%, 16 * fy + vy%, "4"
  Color RGB(0, 0, 235) ' blau
  SetFont schrift1%
  Text 130 * fx + vx%, 43 * fy + vy%, "Stufe 1"
  Text 292 * fx + vx%, 43 * fy + vy%, "Stufe 2"
  Text 454 * fx + vx%, 43 * fy + vy%, "Stufe 3"
  Color RGB(255, 255, 255) ' weiß
  SetFont schrift0%
  Text Int((_X  - vx% - TxtLen(nam$)) / 2), 464 * fy + vy%, nam$
  If einzelner| = 1
    Text 60 * fx + vx%, 20 * fy + vy%, "Hier kannst du auswählen:"
  Else
    Text 60 * fx + vx%, 20 * fy + vy%, "Hier könnt ihr auswählen:"
  EndIf
  Color RGB(255, 0, 0) ' rot
  SetFont schriftw3%
  Text 96 * fx + vx% + zeichenbr% * 19, 105 * fy + vy%, "ò"                                    ' 2.
  Text 96 * fx + vx% + zeichenbr% * 24, 105 * fy + vy%, "ò"                                    ' 2.
  Text 96 * fx + vx% + zeichenbr% * 29, 105 * fy + vy%, "ò"                                    ' 2.
  Text 96 * fx + vx% + zeichenbr% * 34, 105 * fy + vy%, "ò"                                    ' 2.
  Color RGB(0, 0, 235) ' blau
  SetFont schrift3%
  Text 96 * fx + vx%, 104 * fy + vy%, "7000                 T,   H,   Z,   E "  ' 2.
  Text 96 * fx + vx%, 130 * fy + vy%, "4000 + 3000 =  "                         ' 3.
  Text 96 * fx + vx%, 156 * fy + vy%, "7000 - 3000 =                          " ' 4.
  Text 96 * fx + vx%, 182 * fy + vy%, "4000 +      =                          " ' 5.
  Text 96 * fx + vx%, 208 * fy + vy%, "   7 ·  400 =                          " ' 6.
  Text 96 * fx + vx%, 234 * fy + vy%, "Kommazahlen                            " ' 7.
  Text 96 * fx + vx%, 260 * fy + vy%, "schriftlich addieren                   " ' 8.
  Text 96 * fx + vx%, 286 * fy + vy%, "schriftlich subtrahieren               " ' 9.
  Text 96 * fx + vx%, 312 * fy + vy%, "schriftlich multiplizieren             " ' 10.
  Text 96 * fx + vx%, 338 * fy + vy%, "schriftlich dividieren  "                ' 11.
  Text 96 * fx + vx%, 364 * fy + vy%, "   2 · 4000 =       das Doppelte"        ' 12.
  Text 96 * fx + vx%, 390 * fy + vy%, "8000 :    2 =       die Hälfte  "        ' 13.
  Color RGB(255, 0, 0) ' rot
  Box 97 * fx + vx% + TxtLen("4000 + 3000 = "), 80 * fy + vy%, 111 * fx + vx% + TxtLen("4000 + 3000 = "), 98 * fy + vy%         ' 1.
  Box 97 * fx + vx% + TxtLen("4000 + 3000 = "), 132 * fy + vy%, 111 * fx + vx% + TxtLen("4000 + 3000 = "), 150 * fy + vy%     ' 3.
  Box 97 * fx + vx% + TxtLen("4000 + 3000 = "), 158 * fy + vy%, 111 * fx + vx% + TxtLen("4000 + 3000 = "), 176 * fy + vy%     ' 4.
  Text 96 * fx + vx%, 182 * fy + vy%, "              10000 "                                                                                               ' 5.
  Box 97 * fx + vx% + TxtLen("4000 = "), 184 * fy + vy%, 111 * fx + vx% + TxtLen("4000 = "), 202 * fy + vy%                             ' 5."
  Box 97 * fx + vx% + TxtLen("4000 + 3000 = "), 210 * fy + vy%, 111 * fx + vx% + TxtLen("4000 + 3000 = "), 228 * fy + vy%     ' 6.
  Box 97 * fx + vx% + TxtLen("4000 + 3000 = "), 366 * fy + vy%, 111 * fx + vx% + TxtLen("4000 + 3000 = "), 384 * fy + vy%    ' 12.
  Box 97 * fx + vx% + TxtLen("4000 + 3000 = "), 392 * fy + vy%, 111 * fx + vx% + TxtLen("4000 + 3000 = "), 410 * fy + vy%    ' 13.
  SetFont schrift0%
  Color RGB(0, 170, 0) ' grün
'##B#
  a% = 100 * fx + vx%
'##B#
  b% = 83 * fy + vy%
'##B#
  c% = 5 * fx
  For i% = 0 To 10
    If i% <> 5
      PBox a%, b%, a% + 3 * fx, b% + 3 * fy
    EndIf
    Add a%, c%
  Next i%
  Color RGB(0, 0, 235) ' blau
'##B#
  b% = 91 * fy + vy%
'##B#
  c% = 5 * fx
  For j% = 0 To 1
'##B#
    a% = 100 * fx + vx%
    For i% = 0 To 10
      If i% <> 5
        PBox a%, b%, a% + 3 * fx, b% + 3 * fy
      EndIf
      Add a%, c%
    Next i%
    Add b%, c%
  Next j%
  DefLine 0, 1
Return
>Procedure menue_masse
  Repeat
    PeekEvent
  Until MouseK = 0
  Output = Win_2
  GraphMode R2_COPYPEN, TRANSPARENT
  stufe1| = stufe|
  Clr stufealt|, altwahl|, wahl|, stufe|
  menue0
  weiter| = 1
  DefLine 0, fy
  Color RGB(0, 0, 0) ' schwarz
  SetFont schrift0%
  Text 563 * fx + vx%, 40 * fy + vy%, "Maße"
  Color RGB(0, 0, 235) ' blau
  SetFont schrift1%
  Text 130 * fx + vx%, 43 * fy + vy%, "Stufe 1"
  Text 292 * fx + vx%, 43 * fy + vy%, "Stufe 2"
  Text 454 * fx + vx%, 43 * fy + vy%, "Stufe 3"
  Color RGB(255, 255, 255)     ' weiß
  SetFont schrift0%
  Text Int((_X - vx% - TxtLen(nam$)) / 2), 464 * fy + vy%, nam$
  Text 555 * fx + vx% - TxtLen("Schriftliches Rechnen mit    Kommazahlen"), 20 * fy + vy%, "Schriftliches Rechnen mit    Kommazahlen"
  Color RGB(255, 0, 0)             ' rot
  laenge| = TxtLen("Kommazahlen")
  SetFont schriftw2%
  Text 539 * fx + vx% - laenge|, 19 * fy + vy%, "ò"                   'Pfeil
  Clr laenge|
  Color RGB(0, 190, 255) ' hell blaugrün
  PBox 12 * fx + vx%, 77 * fy + vy%, 624 * fx + vx%, 100 * fy + vy%
  PBox 12 * fx + vx%, 129 * fy + vy%, 624 * fx + vx%, 152 * fy + vy%
  PBox 12 * fx + vx%, 285 * fy + vy%, 624 * fx + vx%, 308 * fy + vy%
  PBox 12 * fx + vx%, 363 * fy + vy%, 624 * fx + vx%, 386 * fy + vy%
  Color RGB(0, 0, 235) ' blau
  SetFont schrift3%
  Text 96 * fx + vx%, 78 * fy + vy%, "Geld:                                  "  ' 1.
  Text 96 * fx + vx%, 104 * fy + vy%, "DM - Pf  "                                ' 2.
  Text 96 * fx + vx%, 130 * fy + vy%, "Längenmaße:        "                     ' 3.
  Text 96 * fx + vx%, 156 * fy + vy%, "cm - mm      Zentimeter - Millimeter   " ' 4.
  Text 96 * fx + vx%, 182 * fy + vy%, " m - cm      Meter      - Zentimeter   " ' 5.
  Text 96 * fx + vx%, 208 * fy + vy%, " m - mm      Meter      - Millimeter   " ' 6.
  Text 96 * fx + vx%, 234 * fy + vy%, "km -  m      Kilometer  - Meter        " ' 7.
  Text 96 * fx + vx%, 260 * fy + vy%, "km - 100 m   Kilometer  - 100 Meter    " ' 8.
  Text 96 * fx + vx%, 286 * fy + vy%, "Gewichte:                              " ' 9.
  Text 96 * fx + vx%, 312 * fy + vy%, "kg -  g      Kilogramm  - Gramm        " ' 10.
  Text 96 * fx + vx%, 338 * fy + vy%, " t - kg      Tonnen     - Kilogramm "    ' 11.
  Text 96 * fx + vx%, 364 * fy + vy%, "Hohlmaße:                       "        ' 12.
  Text 96 * fx + vx%, 390 * fy + vy%, " l - ml      Liter      - Milliliter  "  ' 13.
  Color RGB(255, 0, 0) ' rot
  Text 96 * fx + vx%, 104 * fy + vy%, "          oder "  ' 2.
  Color RGB(0, 0, 235) ' blau
  Text 96 * fx + vx%, 104 * fy + vy%, "                 € - ct   Euro - Cent  "  ' 2.
  Get 0, 0, _X, _Y, fenster$
  Output = Win_1
  Put 0, 0, fenster$
  Clr fenster$
  DefMouse 0
  Do
    Repeat
      Sleep
      Mouse x%, y%, k%
      ink$ = InKey$
    Until (Len(ink$) > 1 And Asc(Right$(ink$)) = 119) Or k% > 0  ' F8
    Repeat
      PeekEvent
    Until InKey$ = ""
    If Len(ink$) > 1 And Asc(Right$(ink$)) = 119 ' F8
      DefMouse V:aaa%(0)        ' transparente Mausform
      hauptmenue
    EndIf
    xx% = Int((x% - vx%) / fx)
    yy% = Int((y% - vy%) / fy)
    Repeat
      PeekEvent
    Until MouseK = 0
    Exit If k% = 2
    Clr stufealt|
    Select yy%
    Case 40 To 61
      Select xx%
      Case 103 To 209
        Select stufe|
        Case 2, 3
          stufealt| = stufe|
          stufe| = 1
        Case 1
          stufealt| = 1
        Case 0
          stufe| = 1
        EndSelect
      Case 265 To 371
        Select stufe|
        Case 1, 3
          stufealt| = stufe|
          stufe| = 2
        Case 2
          stufealt| = 2
        Case 0
          stufe| = 2
        EndSelect
      Case 427 To 533
        Select stufe|
        Case 1, 2
          stufealt| = stufe|
          stufe| = 3
        Case 3
          stufealt| = 3
        Case 0
          stufe| = 3
        EndSelect
      Default
        GoTo falsch1
      EndSelect
      If stufe| <> stufealt| Or stufe| = 0
        invertstufe
      EndIf
    Case 77 To 415
      DefLine 0, 1
      For i% = 51 To 408 Step 26
        SetFont schrift3%
        If yy% > i% And yy% < i% + 26
          wahl| = Int(i% / 26) - 1
          If altwahl| > 0
            inv| = altwahl|
            Color RGB(255, 255, 198) ' creme
            PBox 12 * fx + vx%, 51 * fy + vy% + altwahl| * 26 * fy, 626 * fx + vx%, Ceil(74 * fy + vy%) + altwahl| * 26 * fy
            Color RGB(0, 0, 0)  'schwarz
            Text 45 * fx + vx% - TxtLen(Trim$(Str$(altwahl|))), 52 * fy + vy% + altwahl| * 26 * fy, Trim$(Str$(altwahl|)) + "."
            Color RGB(0, 0, 235) ' blau
            invert6
          EndIf
          inv| = wahl|
          If wahl| <> 1 And wahl| <> 3 And wahl| <> 9 And wahl| <> 12
            Color RGB(0, 0, 235) ' blau
            PBox 12 * fx + vx%, 51 * fy + vy% + wahl| * 26 * fy, 626 * fx + vx%, Ceil(74 * fy + vy%) + wahl| * 26 * fy
            Color RGB(255, 255, 198) ' creme
            Text 45 * fx + vx% - TxtLen(Trim$(Str$(wahl|))), 52 * fy + vy% + wahl| * 26 * fy, Trim$(Str$(wahl|)) + "."
            invert6
            altwahl| = wahl|
          Else
            wahl| = altwahl|
            Clr altwahl|
          EndIf
          Clr inv|
        EndIf
      Next i%
    EndSelect
    falsch1:
  Loop
  If wahl| = 0
    wahl| = 2
  EndIf
  If wahl| = 2 ' DM / Euro
    al$ = "Arbeit mit DM/Pf oder mit Euro/Cent?"
    al1$ = "DM"
    al2$ = "Euro"
    alert2(al$, al1$, al2$)
    If alertf| = 1
      geldwahl| = 1 ' DM
    Else If alertf| = 2
      geldwahl| = 2 ' Euro
    EndIf
  EndIf
  If stufe| = 0
    If stufe1| <> 0
      stufe| = stufe1|
    Else
      stufe| = 1
    EndIf
  EndIf
  Clr stufe1|
  DefMouse V:aaa%(0)        ' transparente Mausform
  Repeat
    PeekEvent
    k% = MouseK
  Until k% = 0 And _Mess = 0
  If stufe| = 3 And beginn| = 0
    DefMouse 0
    Repeat
      PeekEvent
    Until _Mess = 0
    GraphMode R2_COPYPEN, TRANSPARENT
    DefLine 0, fy
    Color RGB(100, 0, 0) ' dunkelbraun
    PBox (319 - 244) * fx + vx%, (239 - 64) * fy + vy%, (319 + 244) * fx + vx%, (239 + 64) * fy + vy%
    Color RGB(255, 0, 0) ' rot
    Box (319 - 241) * fx + vx%, (239 - 61) * fy + vy%, (319 + 241) * fx + vx%, (239 + 61) * fy + vy%
    Color RGB(255, 255, 198) ' creme
    PBox (319 - 232) * fx + vx%, (239 - 52) * fy + vy%, (319 + 232) * fx + vx%, (239 + 52) * fy + vy%
    Color RGB(0, 0, 0) ' schwarz
    SetFont schrift1%
    Text (319 - 220) * fx + vx%, (239 - 24) * fy + vy%, "Welche Rechenart?"
    DefLine 0, 2 * fy
    Color RGB(190, 225, 255) ' hellblau
    PBox (319 - 195) * fx + vx%, (239 + 19) * fy + vy%, (319 - 120) * fx + vx%, (239 + 41) * fy + vy%
    PBox (319 - 90) * fx + vx%, (239 + 19) * fy + vy%, (319 - 15) * fx + vx%, (239 + 41) * fy + vy%
    PBox (319 + 15) * fx + vx%, (239 + 19) * fy + vy%, (319 + 90) * fx + vx%, (239 + 41) * fy + vy%
    PBox (319 + 120) * fx + vx%, (239 + 19) * fy + vy%, (319 + 195) * fx + vx%, (239 + 41) * fy + vy%
    Color RGB(100, 0, 0) ' dunkelbraun
    Box (319 - 195) * fx + vx%, (239 + 19) * fy + vy%, (319 - 120) * fx + vx%, (239 + 41) * fy + vy%
    Box (319 - 90) * fx + vx%, (239 + 19) * fy + vy%, (319 - 15) * fx + vx%, (239 + 41) * fy + vy%
    Box (319 + 15) * fx + vx%, (239 + 19) * fy + vy%, (319 + 90) * fx + vx%, (239 + 41) * fy + vy%
    Box (319 + 120) * fx + vx%, (239 + 19) * fy + vy%, (319 + 195) * fx + vx%, (239 + 41) * fy + vy%
    DefLine 0, fy
    Stretch (319 + 170) * fx + vx%, (239 - 44) * fy + vy%, grins, 50 * fx, 56 * fy
    SetFont schrift1%
    Text (319 - 185) * fx + vx%, (239 + 19) * fy + vy%, "plus"
    Text (319 - 80) * fx + vx%, (239 + 19) * fy + vy%, "minus"
    Text (319 + 25) * fx + vx%, (239 + 19) * fy + vy%, "mal"
    Text (319 + 130) * fx + vx%, (239 + 19) * fy + vy%, "geteilt"
    Clr k%
    Repeat
      PeekEvent
      Mouse x%, y%, k%
    Until k% = 1 And ((x% > (319 - 195) * fx + vx% And x% < (319 - 120) * fx + vx%) Or (x% > (319 - 90) * fx + vx% And x% < (319 - 15) * fx + vx%) Or (x% > (319 + 15) * fx + vx% And x% < (319 + 90) * fx + vx%) Or (x% > (319 + 120) * fx + vx% And x% < (319 + 195) * fx + vx%)) And y% > (239 + 20) * fy + vy% And y% < (239 + 40) * fy + vy%
    If x% < (319 - 120) * fx + vx%
      komma| = 1
    Else If x% < (319 - 15) * fx + vx%
      komma| = 2
    Else If x% < (319 + 90) * fx + vx%
      komma| = 3
    Else
      komma| = 4
    EndIf
    If komma| < 4
      If einzelner| = 1
        alert2("Willst du die Merkzahlen auswendig behalten?", "ja", "nein")
      Else
        alert2("Wollt ihr die Merkzahlen auswendig behalten?", "ja", "nein")
      EndIf
      uebertr| = alertf|
    EndIf
    Color RGB(190, 225, 255) ' hellblau
    PBox 35 * fx + vx%, 280 * fy + vy%, 505 * fx + vx%, 360 * fy + vy%
    SetFont schrift1%
    Color RGB(0, 0, 0) ' schwarz
    Text 42 * fx + vx%, 300 * fy + vy%, "1. Eingeben der Zahl mit dem Komma, dann Fertig-Taste"
    Text 42 * fx + vx%, 325 * fy + vy%, "2. Eingeben der Benennung, dann wieder Fertig-Taste"
    Repeat
      PeekEvent
    Until _Mess = 0
    SetFont schrift3%
    DefMouse V:aaa%(0)        ' transparente Mausform
  EndIf
  DefLine 0, 1
Return
>Procedure menue_geld_uhr
  Repeat
    PeekEvent
  Until MouseK = 0
  GraphMode R2_COPYPEN, TRANSPARENT
  menue0
  weiter| = 1
  DefLine 0, fy
  Color RGB(0, 0, 0) ' schwarz
  SetFont schrift0%
  Text 565 * fx + vx%, 33 * fy + vy%, "Geld"
  Text 569 * fx + vx%, 48 * fy + vy%, "Zeit"
  Color RGB(0, 0, 235) ' blau
  SetFont schrift1%
  Text 130 * fx + vx%, 43 * fy + vy%, "Stufe 1"
  Text 292 * fx + vx%, 43 * fy + vy%, "Stufe 2"
  Text 454 * fx + vx%, 43 * fy + vy%, "Stufe 3"
  Color RGB(255, 255, 255) ' weiß
  SetFont schrift0%
  Text Int((_X  - vx% - TxtLen(nam$)) / 2), 464 * fy + vy%, nam$
  If einzelner| = 1
    Text 60 * fx + vx%, 20 * fy + vy%, "Hier kannst du auswählen:"
  Else
    Text 60 * fx + vx%, 20 * fy + vy%, "Hier könnt ihr auswählen:"
  EndIf
  Color RGB(0, 0, 235) ' blau
  SetFont schrift3%
  Text 66 * fx + vx%, 78 * fy + vy%, "Cent oder Pfennige bezahlen                      "  ' 1.
  Text 66 * fx + vx%, 104 * fy + vy%, "Euro oder DM bezahlen                           "  ' 2.
  Text 66 * fx + vx%, 130 * fy + vy%, "€/ct oder DM/Pf bezahlen"                ' 3.
  Text 66 * fx + vx%, 156 * fy + vy%, "ct oder Pf herausgeben (auf 10|20|100)   " ' 4.
  Text 66 * fx + vx%, 182 * fy + vy%, "€ oder DM herausgeben (auf 20|100|1000)   " ' 5.
  Text 66 * fx + vx%, 208 * fy + vy%, "€/ct - DM/Pf herausgeben (auf 10|20|100)   " ' 6.
  Text 66 * fx + vx%, 234 * fy + vy%, "Uhr anhalten (12 h)                    " ' 7.
  Text 66 * fx + vx%, 260 * fy + vy%, "Uhr anhalten (24 h)                    " ' 8.
  Text 66 * fx + vx%, 286 * fy + vy%, "von 4.10 Uhr bis  4.30 Uhr             " ' 9.
  Text 66 * fx + vx%, 312 * fy + vy%, "von 4.10 Uhr bis  5.20 Uhr             " ' 10.
  Text 66 * fx + vx%, 338 * fy + vy%, "von 4.00 Uhr bis 18.00 Uhr          "    ' 11.
  Text 66 * fx + vx%, 364 * fy + vy%, "vom 7.12.2000 bis zum 25.12.2000"        ' 12.
  Text 66 * fx + vx%, 390 * fy + vy%, "vom 5. 8.2000 bis zum  5. 8.2023      "  ' 13.
  Get 0, 0, _X, _Y, fenster$
  Output = Win_1
  Put 0, 0, fenster$
  Clr fenster$
  Clr altwahl|, stufealt|
  DefMouse 0
  Do
    Repeat
      Sleep
      Mouse x%, y%, k%
      ink$ = InKey$
    Until (Len(ink$) > 1 And Asc(Right$(ink$)) = 119) Or k% > 0
    Repeat
      PeekEvent
    Until InKey$ = ""
    If Len(ink$) > 1 And Asc(Right$(ink$)) = 119
      DefMouse V:aaa%(0)        ' transparente Mausform
      hauptmenue
    EndIf
'##B#
    xx% = Int((x% - vx%) / fx)
'##B#
    yy% = Int((y% - vy%) / fy)
    Repeat
      PeekEvent
    Until _Mess = 0 And MouseK = 0
    Exit If k% = 2
    Clr stufealt|
    Select yy%
    Case 40 To 61
      Select xx%
      Case 103 To 209
        Select stufe|
        Case 2, 3
          stufealt| = stufe|
          stufe| = 1
        Case 1
          stufealt| = 1
        Case 0
          stufe| = 1
        EndSelect
      Case 265 To 371
        Select stufe|
        Case 1, 3
          stufealt| = stufe|
          stufe| = 2
        Case 2
          stufealt| = 2
        Case 0
          stufe| = 2
        EndSelect
      Case 427 To 533
        Select stufe|
        Case 1, 2
          stufealt| = stufe|
          stufe| = 3
        Case 3
          stufealt| = 3
        Case 0
          stufe| = 3
        EndSelect
      Default
        GoTo falsch2
      EndSelect
      If stufe| <> stufealt| Or stufe| = 0
        invertstufe
      EndIf
    Case 77 To 415
      DefLine 0, 1
      For i% = 51 To 408 Step 26
        If yy% > i% And yy% < i% + 26
          wahl| = Int(i% / 26) - 1
          SetFont schrift3%
          If altwahl| > 0
            inv| = altwahl|
            Color RGB(255, 255, 198) ' creme
            PBox 12 * fx + vx%, 51 * fy + vy% + altwahl| * 26 * fy, 626 * fx + vx%, Ceil(74 * fy + vy%) + altwahl| * 26 * fy
            Color RGB(0, 0, 0)  'schwarz
            Text 45 * fx + vx% - TxtLen(Trim$(Str$(altwahl|))), 52 * fy + vy% + altwahl| * 26 * fy, Trim$(Str$(altwahl|)) + "."
            Color RGB(0, 0, 235) ' blau
            invert5
          EndIf
          Color RGB(0, 0, 235) ' blau
          PBox 12 * fx + vx%, 51 * fy + vy% + wahl| * 26 * fy, 626 * fx + vx%, Ceil(74 * fy + vy%) + wahl| * 26 * fy
          Color RGB(255, 255, 198) ' creme
          Text 45 * fx + vx% - TxtLen(Trim$(Str$(wahl|))), 52 * fy + vy% + wahl| * 26 * fy, Trim$(Str$(wahl|)) + "."
          inv| = wahl|
          invert5
          Clr inv|
          altwahl| = wahl|
        EndIf
      Next i%
    EndSelect
    falsch2:
  Loop
  If stufe| = 0
    Inc stufe|
  EndIf
  If wahl| = 0
    wahl| = 1
  EndIf
  Repeat
    k% = MouseK
    PeekEvent
  Until k% = 0 And _Mess = 0
  If wahl| < 7
    al$ = "Arbeit mit DM oder mit Euro?"
    al1$ = "DM"
    al2$ = "Euro"
    alert2(al$, al1$, al2$)
    If alertf| = 1
      geldwahl| = 1 ' DM
    Else
      geldwahl| = 2 ' Euro
    EndIf
  EndIf
  DefMouse V:aaa%(0)        ' transparente Mausform
  DefLine 0, 1
Return
>Procedure menueabfrage                  ' Rechnen 1 bis Rechnen 4
  Repeat
    PeekEvent
  Until MouseK = 0
  GraphMode R2_COPYPEN, TRANSPARENT
  DefMouse 0
  Do
    Repeat
      Sleep
      Mouse x%, y%, k%
      ink$ = InKey$
    Until (Len(ink$) > 1 And Asc(Right$(ink$)) = 119) Or k% > 0
    Repeat
      PeekEvent
    Until InKey$ = "" And MouseK = 0
    Exit If k% = 2
    If Len(ink$) > 1 And Asc(Right$(ink$)) = 119  ' F8
      DefMouse V:aaa%(0)        ' transparente Mausform
      hauptmenue
    EndIf
    xx% = Int((x% - vx%) / fx)
    yy% = Int((y% - vy%) / fy)
    Clr stufealt|
    Select yy%
    Case 40 To 61              ' Stufe ermitteln
      Select xx%
      Case 103 To 209
        Select stufe|
        Case 2, 3
          stufealt| = stufe|
          stufe| = 1
        Case 1
          stufealt| = 1
        Case 0
          stufe| = 1
        EndSelect
      Case 265 To 371
        Select stufe|
        Case 1, 3
          stufealt| = stufe|
          stufe| = 2
        Case 2
          stufealt| = 2
        Case 0
          stufe| = 2
        EndSelect
      Case 427 To 533
        Select stufe|
        Case 1, 2
          stufealt| = stufe|
          stufe| = 3
        Case 3
          stufealt| = 3
        Case 0
          stufe| = 3
        EndSelect
      Default
        GoTo falsch3
      EndSelect
      If stufe| <> stufealt| Or stufe| = 0
        invertstufe
      EndIf
    Case 77 To 415            ' Aufgabenart ermitteln (jeweils 13)
      DefLine 0, 2
      For iii% = 51 To 408 Step 26
        If yy% > iii% And yy% < iii% + 26
          SetFont schrift3%
          art| = Int(iii% / 26) - 1
          If altart| > 0
            Color RGB(255, 255, 198) ' creme
            PBox 12 * fx + vx%, 51 * fy + vy% + altart| * 26 * fy, 626 * fx + vx%, Ceil(74 * fy + vy%) + altart| * 26 * fy
            Color RGB(0, 0, 0)  'schwarz
            Text 45 * fx + vx% - TxtLen(Trim$(Str$(altart|))), 52 * fy + vy% + altart| * 26 * fy, Trim$(Str$(altart|)) + "."
            Color RGB(0, 0, 235) ' blau
            inv| = altart|
            Select rechnen|
            Case 1
              invert1
            Case 2
              invert2
            Case 3
              invert3
            Case 4
              invert4
            EndSelect
          EndIf
          Color RGB(0, 0, 235) ' blau
          PBox 12 * fx + vx%, 51 * fy + vy% + art| * 26 * fy, 626 * fx + vx%, Ceil(74 * fy + vy%) + art| * 26 * fy
          Color RGB(255, 255, 198) ' creme
          Text 45 * fx + vx% - TxtLen(Trim$(Str$(art|))), 52 * fy + vy% + art| * 26 * fy, Trim$(Str$(art|)) + "."
          inv| = art|
          v| = 1      ' Farbwechsel
          Select rechnen|
          Case 1
            invert1
          Case 2
            invert2
          Case 3
            invert3
          Case 4
            invert4
          EndSelect
          Clr inv|, v|
          altart| = art|
        EndIf
      Next iii%
    EndSelect
    falsch3:
  Loop
  If art| = 0
    Inc art|
  EndIf
  If stufe| = 0
    Inc stufe|
  EndIf
  If rechnen| = 2
    Add art|, 13
  EndIf
  If rechnen| = 3
    Add art|, 26
  EndIf
  If rechnen| = 4
    Add art|, 39
  EndIf
  zahlenraum
  DefMouse V:aaa%(0)        ' transparente Mausform
Return
>Procedure invertstufe
  SetFont schrift1%
  Color RGB(0, 0, 235) ' blau
  Select stufe|
    DefLine 0, 1
  Case 1
    PBox 104 * fx + vx%, 42 * fy + vy%, 208 * fx + vx%, 61 * fy + vy%
    Color RGB(255, 255, 198) ' creme
    If rechnen| = 1
      Text 134 * fx + vx%, 43 * fy + vy%, "bis 10"
    Else
      Text 130 * fx + vx%, 43 * fy + vy%, "Stufe 1"
    EndIf
  Case 2
    PBox 265 * fx + vx%, 42 * fy + vy%, 370 * fx + vx%, 61 * fy + vy%
    Color RGB(255, 255, 198) ' creme
    If rechnen| = 1
      Text 296 * fx + vx%, 43 * fy + vy%, "bis 20"
    Else
      Text 292 * fx + vx%, 43 * fy + vy%, "Stufe 2"
    EndIf
  Case 3
    PBox 428 * fx + vx%, 42 * fy + vy%, 532 * fx + vx%, 61 * fy + vy%
    Color RGB(255, 255, 198) ' creme
    If rechnen| = 1
      Text 454 * fx + vx%, 43 * fy + vy%, "bis 100"
    Else
      Text 454 * fx + vx%, 43 * fy + vy%, "Stufe 3"
    EndIf
  EndSelect
  Color RGB(255, 255, 198) ' creme
  Select stufealt|
  Case 1
    PBox 104 * fx + vx%, 42 * fy + vy%, 208 * fx + vx%, 61 * fy + vy%
    Color RGB(0, 0, 235) ' blau
    If rechnen| = 1
      Text 134 * fx + vx%, 43 * fy + vy%, "bis 10"
    Else
      Text 130 * fx + vx%, 43 * fy + vy%, "Stufe 1"
    EndIf
  Case 2
    PBox 265 * fx + vx%, 42 * fy + vy%, 370 * fx + vx%, 61 * fy + vy%
    Color RGB(0, 0, 235) ' blau
    If rechnen| = 1
      Text 296 * fx + vx%, 43 * fy + vy%, "bis 20"
    Else
      Text 292 * fx + vx%, 43 * fy + vy%, "Stufe 2"
    EndIf
  Case 3
    PBox 428 * fx + vx%, 42 * fy + vy%, 532 * fx + vx%, 61 * fy + vy%
    Color RGB(0, 0, 235) ' blau
    If rechnen| = 1
      Text 454 * fx + vx%, 43 * fy + vy%, "bis 100"
    Else
      Text 454 * fx + vx%, 43 * fy + vy%, "Stufe 3"
    EndIf
  EndSelect
Return
>Procedure invert1
  Select inv|
  Case 1
    For i% = 121 To 185 Step 16
      PCircle i% * fx + vx%, 91 * fy + vy%, 5 * fx
    Next i%
    PCircle 215 * fx + vx%, 91 * fy + vy%, 5 * fx
    If v| = 0
      Color RGB(255, 0, 0) ' rot
    EndIf
    Box 117 * fx + vx% + TxtLen("4                "), 80 * fy + vy%, 131 * fx + vx% + TxtLen("4                "), 98 * fy + vy%     ' 1.
  Case 2
    If v| = 0
      Color RGB(255, 0, 0) ' rot
    EndIf
    SetFont schriftw3%
    Text 116 * fx + vx% + zeichenbr% * 17, 105 * fy + vy%, "ò"                             ' 2.
    Text 116 * fx + vx% + zeichenbr% * 22, 105 * fy + vy%, "ò"                             ' 2.
    If v| = 0
      Color RGB(0, 0, 235) ' blau
    EndIf
    SetFont schrift3%
    Text 116 * fx + vx%, 104 * fy + vy%, "7                  Z,   E"     ' 2.
  Case 3
    Text 116 * fx + vx%, 130 * fy + vy%, "4 + 1 =  "                     ' 3.
    If v| = 0
      Color RGB(255, 0, 0) ' rot
    EndIf
    Box 117 * fx + vx% + TxtLen("4 + 1 = "), 132 * fy + vy%,  131 * fx + vx% + TxtLen("4 + 1 = "), 150 * fy + vy%          ' 3.
  Case 4
    Text 116 * fx + vx%, 156 * fy + vy%, "5 - 1 =  "                     ' 4.
    If v| = 0
      Color RGB(255, 0, 0) ' rot
    EndIf
    Box 117 * fx + vx% + TxtLen("4 + 1 = "), 158 * fy + vy%, 131 * fx + vx% + TxtLen("4 + 1 = "), 176 * fy + vy%           ' 4.
  Case 5
    Text 116 * fx + vx%, 182 * fy + vy%, "3 +   = 4"                     ' 5.
    If v| = 0
      Color RGB(255, 0, 0) ' rot
    EndIf
    Box 117 * fx + vx% + TxtLen("4 + "), 184 * fy + vy%, 131 * fx + vx% + TxtLen("4 + "), 202 * fy + vy%                        ' 5.
  Case 6
    Text 116 * fx + vx%, 208 * fy + vy%, "6 -   = 5"                     ' 6.
    If v| = 0
      Color RGB(255, 0, 0) ' rot
    EndIf
    Box 117 * fx + vx% + TxtLen("4 + "), 210 * fy + vy%, 131 * fx + vx% + TxtLen("4 + "), 228 * fy + vy%                        ' 6.
  Case 7
    Text 116 * fx + vx%, 234 * fy + vy%, "6 +   ="                       ' 7.
    If v| = 0
      Color RGB(255, 0, 0) ' rot
    EndIf
    Text 116 * fx + vx%, 234 * fy + vy%, "        10"                              ' 7.
    Box 117 * fx + vx% + TxtLen("4 + "), 236 * fy + vy%, 131 * fx + vx% + TxtLen("4 + "), 254 * fy + vy%                       ' 7."
  Case 8
    Text 116 * fx + vx%, 260 * fy + vy%, "  - 3 =  "                     ' 8.
    If v| = 0
      Color RGB(255, 0, 0) ' rot
    EndIf
    Text 116 * fx + vx% - TxtLen("0"), 260 * fy + vy%, "10       "         ' 8.
    Box 117 * fx + vx% + TxtLen("4 + 1 = "), 262 * fy + vy%, 131 * fx + vx% + TxtLen("4 + 1 = "), 280 * fy + vy%          ' 8."
  Case 9
    Text 116 * fx + vx%, 286 * fy + vy%, "  + 3 =  "                     ' 9.
    If v| = 0
      Color RGB(255, 0, 0) ' rot
    EndIf
    Text 116 * fx + vx%, 286 * fy + vy%, "0       "                                  ' 9.
    Box 117 * fx + vx% + TxtLen("4 + 1 = "), 288 * fy + vy%, 131 * fx + vx% + TxtLen("4 + 1 = "), 306 * fy + vy%          ' 9.
  Case 10
    Text 116 * fx + vx%, 312 * fy + vy%, "4 + 2 =  "                     ' 10.
    If v| = 0
      Color RGB(255, 0, 0) ' rot
    EndIf
    Box 117 * fx + vx% + TxtLen("4 + 1 = "), 314 * fy + vy%, 131 * fx + vx% + TxtLen("4 + 1 = "), 332 * fy + vy%        ' 10."
  Case 11
    Text 116 * fx + vx%, 338 * fy + vy%, "7 - 4 =  "                     ' 11.
    If v| = 0
      Color RGB(255, 0, 0) ' rot
    EndIf
    Box 117 * fx + vx% + TxtLen("4 + 1 = "), 340 * fy + vy%, 131 * fx + vx% + TxtLen("4 + 1 = "), 358 * fy + vy%        ' 11.
  Case 12
    Text 116 * fx + vx%, 364 * fy + vy%, "2 · 4 =          das Doppelte" ' 12.
    If v| = 0
      Color RGB(255, 0, 0) ' rot
    EndIf
    Box 117 * fx + vx% + TxtLen("4 + 1 = "), 366 * fy + vy%, 131 * fx + vx% + TxtLen("4 + 1 = "), 384 * fy + vy%        ' 12.
  Case 13
    Text 116 * fx + vx%, 390 * fy + vy%, "8 : 2 =          die Hälfte"   ' 13.
    If v| = 0
