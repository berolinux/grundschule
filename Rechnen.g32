        PBox 288 + vx%, 556, 331 + vx%, 556 + zeichenh%
        PBox 386 + vx%, 556, 429, 556 + vx% + zeichenh%
        Color RGB(255, 0, 0) ' rot
        Text 232 + vx% - TxtLen("700"), 557, "700"
        Text 330 + vx% - TxtLen(Trim$(Str$(i%))), 557, Trim$(Str$(i%))
      EndIf
      If i% > 800 And i% < 901
        PBox 288 + vx%, 556, 331 + vx%, 556 + zeichenh%
        PBox 386 + vx%, 556, 429 + vx%, 556 + zeichenh%
        PBox 470 + vx%, 556, 527 + vx%, 556 + zeichenh%
        Color RGB(255, 0, 0) ' rot
        Text 330 + vx% - TxtLen("800"), 557, "800"
        Text 428 + vx% - TxtLen(Trim$(Str$(i%))), 557, Trim$(Str$(i%))
      EndIf
      If i% > 900 And i% < 1001
        PBox 386 + vx%, 556, 429 + vx%, 556 + zeichenh%
        PBox 470 + vx%, 556, 527 + vx%, 556 + zeichenh%
        Color RGB(255, 0, 0) ' rot
        Text 428 + vx% - TxtLen("900"), 557, "900"
        Text 526 + vx% - TxtLen(Trim$(Str$(i%))), 557, Trim$(Str$(i%))
      EndIf
    Else If _Y < 769                                         ' 1024 * 768
      If i% < 101
        PBox 116 + vx%, 554, 171 + vx%, 554 + zeichenh%
        PBox 239 + vx%, 554, 294 + vx%, 554 + zeichenh%
        Color RGB(255, 0, 0) ' rot
        Text 170 + vx% - TxtLen(Trim$(Str$(i%))), 555, Trim$(Str$(i%))
      EndIf
      If i% > 100 And i% < 201
        PBox 116 + vx%, 554, 171 + vx%, 554 + zeichenh%
        PBox 239 + vx%, 554, 294 + vx%, 554 + zeichenh%
        PBox 362 + vx%, 554, 417 + vx%, 554 + zeichenh%
        Color RGB(255, 0, 0) ' rot
        Text 170 + vx% - TxtLen("100"), 555, "100"
        Text 293 + vx% - TxtLen(Trim$(Str$(i%))), 555, Trim$(Str$(i%))
      EndIf
      If i% > 200 And i% < 301
        PBox 239 + vx%, 554, 294 + vx%, 554 + zeichenh%
        PBox 362 + vx%, 554, 417 + vx%, 554 + zeichenh%
        PBox 485 + vx%, 554, 540 + vx%, 554 + zeichenh%
        Color RGB(255, 0, 0) ' rot
        Text 293 + vx% - TxtLen("200"), 555, "200"
        Text 416 + vx% - TxtLen(Trim$(Str$(i%))), 555, Trim$(Str$(i%))
      EndIf
      If i% > 300 And i% < 401
        PBox 362 + vx%, 554, 417 + vx%, 554 + zeichenh%
        PBox 485 + vx%, 554, 540 + vx%, 554 + zeichenh%
        PBox 608 + vx%, 554, 663 + vx%, 554 + zeichenh%
        Color RGB(255, 0, 0) ' rot
        Text 416 + vx% - TxtLen("300"), 555, "300"
        Text 539 + vx% - TxtLen(Trim$(Str$(i%))), 555, Trim$(Str$(i%))
      EndIf
      If i% > 400 And i% < 501
        PBox 485 + vx%, 554, 540 + vx%, 554 + zeichenh%
        PBox 608 + vx%, 554, 663 + vx%, 554 + zeichenh%
        PBox 116 + vx%, 707, 171 + vx%, 707 + zeichenh%
        Color RGB(255, 0, 0) ' rot
        Text 539 + vx% - TxtLen("400"), 555, "400"
        Text 662 + vx% - TxtLen(Trim$(Str$(i%))), 555, Trim$(Str$(i%))
      EndIf
      If i% > 500 And i% < 601
        PBox 608 + vx%, 554, 663 + vx%, 554 + zeichenh%
        PBox 116 + vx%, 707, 171 + vx%, 707 + zeichenh%
        PBox 239 + vx%, 707, 294 + vx%, 707 + zeichenh%
        Color RGB(255, 0, 0) ' rot
        Text 662 + vx% - TxtLen("500"), 555, "500"
        Text 170 + vx% - TxtLen(Trim$(Str$(i%))), 708, Trim$(Str$(i%))
      EndIf
      If i% > 600 And i% < 701
