' ***************************************************************************
' *****                         Geburtstagsrechner
' *****      von Rudolf Rosenkränzer, Auf der Hard 3, 54456 Tawern
' *****                      Telefon 06501/180202
' ***************************************************************************
Global anfjahr%, endjahr%, anfmon%, endmon%, anftag%, endtag%, anfh%, endh%, anfmin%, endmin%, anfsec%, endsec%  'Anfangs- und Enddatum
Global fehler%, wechsel%, drucken%, wochentag%, tjahr%, tmon%, ttag%, wjahr%, wmonat%, walter% ' w... zur Berechnung des Wochentags
Global jahr%, monat%, j%, m%, alter%, stu%, minu#, seku#   ' Alter, alter% = Alter in Tagen
Global normalmonat%, normaltag%  '  "normal..." für Altersangabe in Spalte  "Jahre/Monate/Tage"
Global i%, a%, b%, c%, mm%, unterschied%, unterschiedsec%, anfschalt%, endschalt%
LoadForm Hinweise Hidden
Hinweise.AutoRedraw = 1
LoadForm Geburtstagsrechner
Geburtstagsrechner.AutoRedraw = 1
Output = Me
ah = "0"
anfh% = 0
eh = "0"
endh% = 0
amin = "0"
anfmin% = 0
emin = "0"
endmin% = 0
asec = "0"
anfsec% = 0
'##E#
esec = "0"
endsec% = 0
tjahr% = 1988
tmon% = 2
ttag% = 15      ' ein Montag, an dem das erste Kalenderprogramm fertig wurde
spalte_2_aus
bezeichnung.ToolTipText = "Auf Wunsch Eingabe des Namens einer Person oder der Bezeichnung für einen Zeitabschnitt."
ajahr.ToolTipText = "Eingabe einer Jahreszahl von -5000 (= 5000 v. Chr.) bis 2201. Weiter mit Return."
amon.ToolTipText = "Eingabe des Monats nur als Zahl - ohne Punkt. Weiter mit Return."
atag.ToolTipText = "Eingabe des Tages nur als Zahl - ohne Punkt. Weiter mit Return."
ah.ToolTipText = "Auf Wunsch Eingabe einer genauen Uhrzeit. Weiter mit Return."
amin.ToolTipText = "Auf Wunsch Eingabe einer genauen Uhrzeit. Weiter mit Return."
asec.ToolTipText = "Auf Wunsch Eingabe einer genauen Uhrzeit. Weiter mit Return."
awochtag.ToolTipText = "Nach Eingabe des Datums erscheint hier der Wochentag."
Neu.ToolTipText = "Beginn einer neuen Berechnung."
Do
  Sleep
Until Me Is Nothing

>Sub Geburtstagsrechner_Load
  Neu.SetFocus
Return

>Procedure altersberechnung
  If anfjahr% Mod 4 = 0
    If anfjahr% Mod 100 = 0 And anfjahr% Mod 400 <> 0 And anfjahr% > 1582
      anfschalt% = 0
    Else
      anfschalt% = 1
    EndIf
  Else
    anfschalt% = 0
  EndIf
  If endjahr% Mod 4 = 0
    If endjahr% Mod 100 = 0 And endjahr% Mod 400 <> 0 And endjahr% > 1582
      endschalt% = 0
    Else
      endschalt% = 1
    EndIf
  Else
    endschalt% = 0
  EndIf
  wechsel% = 0     '     Altersberechnung in Tagen
  If endjahr% = anfjahr%  And endmon% = anfmon% And endtag% = anftag%
    alter% = 0
    normaltag% = 0
    GoTo alterw
  Else If endjahr% < anfjahr% Or (endjahr% = anfjahr% And endmon% < anfmon%) Or (endjahr% = anfjahr% And endmon% = anfmon% And endtag% < anftag%)
    wechsel% = 1
    a% = endtag%
    endtag% = anftag%
    anftag% = a%
    a% = endmon%
    endmon% = anfmon%
    anfmon% = a%
    a% = endjahr%
    endjahr% = anfjahr%
    anfjahr% = a%
  EndIf
  jahr% = endjahr% - anfjahr%   ' Alter in Jahren
  If endjahr% > 0 And anfjahr% < 0
    jahr% = jahr% - 1
  EndIf
  If anfmon% > endmon% Or (anfmon% = endmon% And anftag% > endtag%)
    jahr% = jahr% - 1
  EndIf
  monat% = jahr% * 12   ' Alter in Monaten
  If endmon% > anfmon%
    monat% = monat% + endmon% - anfmon%
  Else
    If endmon% = anfmon% And endtag% < anftag%
      monat% = monat% + 12
    EndIf
    If endmon% < anfmon%
      monat% = monat% + 12 - anfmon% + endmon%
    EndIf
  EndIf
  If anftag% > endtag%
    monat% = monat% - 1
  EndIf
  alter% = 0    ' Alter in Tagen
  j% = anfjahr%
  m% = anfmon%
  If j% < endjahr%
    mm% = 12
  EndIf
  If j% = endjahr%
    mm% = endmon% - 1
  EndIf
  alter% = alter% - anftag%
  While j% <= endjahr%
    If j% <> 0
      While m% <= mm%
        Select m%
        Case 1, 3, 5, 7, 8, 12
          alter% = alter% + 31
        Case 2
          If j% > 0
            If j% Mod 4 = 0
              If j% Mod 100 = 0 And j% Mod 400 <> 0 And j% > 1582
                alter% = alter% + 28
              Else
                alter% = alter% + 29
              EndIf
            Else
              alter% = alter% + 28
            EndIf
          Else If j% < 0
            If (j% + 1) Mod 4 = 0
              alter% = alter% + 29
            Else
              alter% = alter% + 28
            EndIf
          EndIf
        Case 4, 6, 9, 11
          alter% = alter% + 30
        Case 10
          If j% = 1582
            alter% = alter% - 10
          EndIf
          alter% = alter% + 31
        EndSelect
        m% = m% + 1
      Wend
    EndIf
    j% = j% + 1
    If j% < endjahr%
      m% = 1
      mm% = 12
    EndIf
    If j% = endjahr%
      m% = 1
      mm% = endmon% - 1
    EndIf
  Wend
  alter% = alter% + endtag%
  If endjahr% = 1582 And endmon% = 10 And endtag% > 14
    alter% = alter% - 10
  EndIf
  If wechsel% = 1
    a% = endtag%
    endtag% = anftag%
    anftag% = a%
    a% = endmon%
    endmon% = anfmon%
    anfmon% = a%
    a% = endjahr%
    endjahr% = anfjahr%
    anfjahr% = a%
    wechsel% = 0
  EndIf
  normalmonat% = monat% - jahr% * 12   ' für Altersangabe "Jahre/Monate/Tage"
  If endtag% >= anftag%
    If endjahr% = 1582 And endmon% = 10 And anftag% < 5 And endtag% > 14
      normaltag% = endtag% - anftag% - 10
    Else
      normaltag% = endtag% - anftag%
    EndIf
  Else
    Select endmon%
    Case 1, 2, 4, 6, 8, 9', 13
      normaltag% = 31 - anftag% + endtag%
    Case 3
      If endjahr% > 0
        If endjahr% Mod 4 = 0
          If endjahr% Mod 100 = 0 And endjahr% Mod 400 <> 0 And endjahr% > 1582
            normaltag% = 28 - anftag% + endtag%
          Else
            normaltag% = 29 - anftag% + endtag%
          EndIf
        Else
          normaltag% = 28 - anftag% + endtag%
        EndIf
      Else If endjahr% < 0
        If (endjahr% + 1) Mod 4 = 0
          normaltag% = 29 - anftag% + endtag%
        Else
          normaltag% = 28 - anftag% + endtag%
        EndIf
      EndIf
    Case 5, 7, 12
      normaltag% = 30 - anftag% + endtag%
    Case 10
      If endjahr% = 1582 And endtag% > 14
        normaltag% = 20 - anftag% + endtag%
      Else
        normaltag% = 30 - anftag% + endtag%
      EndIf
    Case 11
      If endjahr% = 1582 And anftag% < 5
        normaltag% = 21 - anftag% + endtag%
      Else
        normaltag% = 31 - anftag% + endtag%
      EndIf
    EndSelect
  EndIf
  If anftag% = 29
    If anfmon% = 2 And endmon% = 2 And endschalt% = 0 And endtag% = 28     ' Monatsende anpassen
      normaltag% = 0
      normalmonat% = 0
      jahr% = jahr% + 1
      monat% = monat% + 1
    Else If anfmon% = 2  And endmon% = 3 And endtag% < 29 And endschalt% = 0
      If endtag% < 28
        normaltag% = normaltag% + 1
      Else If endtag% = 28
        normaltag% = 28
      EndIf
    Else If endmon% = 2 And endschalt% = 0 And endtag% = 28
      normaltag% = 0
      normalmonat% = normalmonat% + 1
      monat% = monat% + 1
    Else If endmon% = 3 And endschalt% = 0 And endtag% < 29
      normaltag% = normaltag% + 1
    EndIf
  Else If anftag% = 30
    If endmon% = 2
      If (endschalt% = 1 And endtag% = 29) Or (endschalt% = 0 And endtag% = 28)
        normaltag% = 0
        normalmonat% = normalmonat% + 1
        monat% = monat% + 1
      EndIf
    Else If endmon% = 3 And endtag% < 30
      If endschalt% = 1
        If anftag% = 30
          normaltag% = normaltag% + 1
        EndIf
      Else
        If anftag% = 30
          normaltag% = normaltag% + 2
        EndIf
      EndIf
    EndIf
  Else  If anftag% = 31
    If endtag% = 30 And (endmon% = 4 Or endmon% = 6 Or endmon% = 9 Or endmon% = 11)
      normaltag% = 0
      normalmonat% = normalmonat% + 1
      monat% = monat% + 1
    Else If endmon% = 2
      If endschalt% = 1
        If endtag% = 29
          normaltag% = 0
          normalmonat% = normalmonat% + 1
          monat% = monat% + 1
        EndIf
      Else If endschalt% = 0
        If endtag% = 28
          normaltag% = 0
          normalmonat% = normalmonat% + 1
          monat% = monat% + 1
        EndIf
      EndIf
    Else If endmon% = 3 And endtag% < 30
      If endschalt% = 1
        normaltag% = normaltag% + 2
      Else
        normaltag% = normaltag% + 3
      EndIf
    Else If endtag% < 31 And (endmon% = 5 Or endmon% = 7 Or endmon% = 10 Or endmon% = 12)
      normaltag% = normaltag% + 1
    EndIf
  EndIf
  alterw:
  wechsel% = 0                                                                                    ' Berechnung des Wochentags
  If tjahr% = endjahr%  And tmon% = endmon% And ttag% = endtag%
    walter% = 0                 ' Alter ab Testtag zur Wochentagsberechnung
    GoTo alter0
  Else If tjahr% < endjahr% Or (tjahr% = endjahr% And tmon% < endmon%) Or (tjahr% = endjahr% And tmon% = endmon% And ttag% < endtag%)
    wechsel% = 1
    a% = ttag%
    ttag% = endtag%
    endtag% = a%
    a% = tmon%
    tmon% = endmon%
    endmon% = a%
    a% = tjahr%
    tjahr% = endjahr%
    endjahr% = a%
  EndIf
  wjahr% = tjahr% - endjahr%   ' Alter in Jahren
  If tjahr% > 0 And endjahr% < 0
    wjahr% = wjahr% - 1
  EndIf
  If endmon% > tmon% Or (endmon% = tmon% And endtag% > ttag%)
    wjahr% = wjahr% - 1
  EndIf
  wmonat% = wjahr% * 12   ' Alter in Monaten
  If tmon% > endmon%
    wmonat% = wmonat% + tmon% - endmon%
  Else
    If tmon% = endmon% And ttag% < endtag%
      wmonat% = wmonat% + 12
    EndIf
    If tmon% < endmon%
      wmonat% = wmonat% + 12 - endmon% + tmon%
    EndIf
  EndIf
  If endtag% > ttag%
    wmonat% = wmonat% - 1
  EndIf
  walter% = 0    ' Alter in Tagen
  j% = endjahr%
  m% = endmon%
  If j% < tjahr%
    mm% = 12
  EndIf
  If j% = tjahr%
    mm% = tmon% - 1
  EndIf
  walter% = walter% - endtag%
  While j% <= tjahr%
    If j% <> 0
      While m% <= mm%
        Select m%
        Case 1, 3, 5, 7, 8, 12
          walter% = walter% + 31
        Case 2
          If j% > 0
            If j% Mod 4 = 0
              If j% Mod 100 = 0 And j% Mod 400 <> 0 And j% > 1582
                walter% = walter% + 28
              Else
                walter% = walter% + 29
              EndIf
            Else
              walter% = walter% + 28
            EndIf
          Else If j% < 0
            If (j% + 1) Mod 4 = 0
              walter% = walter% + 29
            Else
              walter% = walter% + 28
            EndIf
          EndIf
        Case 4, 6, 9, 11
          walter% = walter% + 30
        Case 10
          If j% = 1582
            walter% = walter% - 10
          EndIf
          walter% = walter% + 31
        EndSelect
        m% = m% + 1
      Wend
    EndIf
    j% = j% + 1
    If j% < tjahr%
      m% = 1
      mm% = 12
    EndIf
    If j% = tjahr%
      m% = 1
      mm% = tmon% - 1
    EndIf
  Wend
  walter% = walter% + ttag%
  If tjahr% = 1582 And tmon% = 10 And ttag% > 14
    walter% = walter% - 10
  EndIf
  If endjahr% = 1582 And endmon% = 10 And endtag% > 14
    walter% = walter% + 10
  EndIf
  alter0:
  wochentag% = walter% Mod 7
  wochentag% = wochentag% + 1
  If wechsel% = 0 And wochentag% > 1
    wochentag% = 9 - wochentag%
  EndIf
  If wechsel% = 1
    a% = ttag%
    ttag% = endtag%
    endtag% = a%
    a% = tmon%
    tmon% = endmon%
    endmon% = a%
    a% = tjahr%
    tjahr% = endjahr%
    endjahr% = a%
    wechsel% = 0
  EndIf
  Select wochentag%
  Case 1
    ewochtag = "Montag"
  Case 2
    ewochtag = "Dienstag"
  Case 3
    ewochtag = "Mittwoch"
  Case 4
    ewochtag = "Donnerstag"
  Case 5
    ewochtag = "Freitag"
  Case 6
    ewochtag = "Samstag"
  Case 7
    ewochtag = "Sonntag"
  EndSelect
Return

>Procedure anzeige
  seku# = Fix(alter% * 86400) + (endh% - anfh%) * 3600 + (endmin% - anfmin%) * 60 + endsec% - anfsec%
  sekund = Str$(seku#)
  sekund.Text = Format$(Str$(seku#), "##,###,###,###")
  minu# = Fix(seku# / 60)
  minut = Str$(minu#)
  minut.Text = Format$(Str$(minu#), "#,###,###,###")
  stu% = Fix(seku# / 3600)
  stunde = Str$(stu%)
  stunde.Text = Format$(Str$(stu%), "##,###,###")
  tag = Str$(Fix(seku# / 86400))
  tag.Text = Format$(Str$(Fix(seku# / 86400)), "#,###,###")
  woche = Fix(seku# / 604800)
  woche.Text = Format$(Str$(Fix(seku# / 604800)), "###,###")
  monat = Str$(monat%)
  monat.Text = Format$(Str$(monat%), "##,###")
  jahr = Str$(jahr%)
  jahr.Text = Format$(Str$(jahr%), "#,###")
  ntag = Str$(normaltag%)
  nmon = Str$(normalmonat%)
  njahr = Str$(jahr%)
Return

>Procedure plustage
  For i% = 1 To unterschied%
    If endjahr% = 1582 And endmon% = 10 And endtag% = 4
      endtag% = 14
      etag = Str$(endtag%)
    EndIf
    Select endtag%
    Case <28
      endtag% = endtag% + 1
      etag = Str$(endtag%)
    Case 28
      If endjahr% > 0
        If endjahr% Mod 4 = 0
          If endjahr% Mod 100 = 0 And endjahr% Mod 400 <> 0 And endjahr% > 1582 And endmon% = 2
            endtag% = 1
            etag = Str$(endtag%)
            endmon% = 3
            emon = Str$(endmon%)
          Else
            endtag% = endtag% + 1
            etag = Str$(endtag%)
          EndIf
        Else If endmon% = 2
          endtag% = 1
          etag = Str$(endtag%)
          endmon% = 3
          emon = Str$(endmon%)
        Else
          endtag% = endtag% + 1
          etag = Str$(endtag%)
        EndIf
      Else If endjahr% < 0
        If (endjahr% + 1) Mod 4 = 0 And endmon% = 2
          endtag% = endtag% + 1
          etag = Str$(endtag%)
        Else If endmon% = 2
          endtag% = 1
          etag = Str$(endtag%)
          endmon% = 3
          emon = Str$(endmon%)
        Else
          endtag% = endtag% + 1
          etag = Str$(endtag%)
        EndIf
      EndIf
    Case 29
      If endmon% = 2
        endtag% = 1
        etag = Str$(endtag%)
        endmon% = 3
        emon = Str$(endmon%)
      Else
        endtag% = endtag% + 1
        etag = Str$(endtag%)
      EndIf
    Case 30
      If endmon% = 4 Or endmon% = 6 Or endmon% = 9 Or endmon% = 11
        endtag% = 1
        etag = Str$(endtag%)
        endmon% = endmon% + 1
        emon = Str$(endmon%)
      Else
        endtag% = endtag% + 1
        etag = Str$(endtag%)
      EndIf
    Case 31
      endtag% = 1
      etag = Str$(endtag%)
      If endmon% = 12
        If endjahr% = -1
          endjahr% = 1
          endmon% = 1
        Else
          endjahr% = endjahr% + 1
          endmon% = 1
        EndIf
      Else
        endmon% = endmon% + 1
      EndIf
      emon = Str$(endmon%)
      ejahr = Str$(endjahr%)
    EndSelect
  Next i%
  alter% = alter% + unterschied%
  altersberechnung
  anzeige
Return

>Procedure minustage
  If alter% - unterschied% >= 0
    For i% = 1 To unterschied%
      If endjahr% = 1582 And endmon% = 10 And endtag% = 15
        endtag% = 5
        etag = Str$(endtag%)
      EndIf
      If endtag% > 1
        endtag% = endtag% - 1
        etag = Str$(endtag%)
      Else
        Select endmon%
        Case 1
          endtag% = 31
          etag = Str$(endtag%)
          endmon% = 12
          emon = Str$(endmon%)
          If endjahr% > 1 Or endjahr% < 0
            endjahr% = endjahr% - 1
          Else
            endjahr% = -1
          EndIf
          ejahr = Str$(endjahr%)
        Case 2, 4, 6, 8, 9, 11
          endtag% = 31
          etag = Str$(endtag%)
          endmon% = endmon% - 1
          emon = Str$(endmon%)
        Case 3
          endmon% = 2
          emon = Str$(endmon%)
          If endjahr% > 0
            If endjahr% Mod 4 = 0
              If endjahr% Mod 100 = 0 And endjahr% Mod 400 <> 0 And endjahr% > 1582
                endtag% = 28
                etag = Str$(endtag%)
              Else
                endtag% = 29
                etag = Str$(endtag%)
              EndIf
            Else
              endtag% = 28
              etag = Str$(endtag%)
            EndIf
          Else If endjahr% < 0
            If (endjahr% + 1) Mod 4 = 0
              endtag% = 29
              etag = Str$(endtag%)
            Else
              endtag% = 28
              etag = Str$(endtag%)
            EndIf
          EndIf
        Case 5, 7, 10, 12
          endtag% = 30
          etag = Str$(endtag%)
          endmon% = endmon% - 1
          emon = Str$(endmon%)
        EndSelect
      EndIf
    Next i%
    alter% = alter% - unterschied%
    altersberechnung
    anzeige
  Else
    Alert 4 , "   Das Ende kann nicht vor dem Beginn liegen!   ", 1, "OK" , a%
    Do
      Sleep
    Loop Until Me Is Nothing
  EndIf
Return

>Procedure plussekunden
  For i% = 1 To unterschiedsec%
    endsec% = endsec% + 1
    seku# = seku# + 1
    If endsec% = 60
      endsec% = 0
      endmin% = endmin% + 1
      If endmin% = 60
        endmin% = 0
        endh% = endh% + 1
        If endh% = 24
          endh% = 0
          eh = "0"
          Select endtag%
          Case <28
            endtag% = endtag% + 1
          Case 28
            If endjahr% > 0
              If endjahr% Mod 4 = 0
                If endjahr% Mod 100 = 0 And endjahr% Mod 400 <> 0 And endjahr% > 1582 And endmon% = 2
                  endtag% = 1
                  endmon% = 3
                Else
                  endtag% = endtag% + 1
                EndIf
              Else If endmon% = 2
                endtag% = 1
                endmon% = 3
              EndIf
            Else If endjahr% < 0
              If (endjahr% + 1) Mod 4 = 0 And endmon% = 2
                endtag% = endtag% + 1
              Else If endmon% = 2
                endtag% = 1
                endmon% = 3
              Else
                endtag% = endtag% + 1
              EndIf
            EndIf
          Case 29
            If endmon% = 2
              endtag% = 1
              endmon% = 3
            Else
              endtag% = endtag% + 1
            EndIf
          Case 30
            If endmon% = 4 Or endmon% = 6 Or endmon% = 9 Or endmon% = 11
              endtag% = 1
              endmon% = endmon% + 1
            Else
              endtag% = endtag% + 1
            EndIf
          Case 31
            endtag% = 1
            If endmon% = 12
              If endjahr% > 0 Or endjahr% < -1
                endjahr% = endjahr% + 1
              Else
                endjahr% = 1
              EndIf
              endmon% = 1
            Else
              endmon% = endmon% + 1
            EndIf
          EndSelect
          If endjahr% = 1582 And endmon% = 10 And endtag% = 5
            endtag% = 15
          EndIf
        EndIf
      EndIf
    EndIf
    If endsec% = anfsec%
      minu# = Fix(seku# / 60)
      minut = Str$(minu#)
      minut.Text = Format$(Str$(minu#), "#,###,###,###")
      If endmin% = anfmin%
        stu% = Fix(seku# / 3600)
        stunde = Str$(stu%)
        stunde.Text = Format$(Str$(stu%), "##,###,###")
        If endh% = anfh%
          tag = Str$(Fix(seku# / 86400))
          tag.Text = Format$(Str$(Fix(seku# / 86400)), "#,###,###")
        EndIf
      EndIf
    EndIf
  Next i%
  esec = Str$(endsec%)
  emin = Str$(endmin%)
  eh = Str$(endh%)
  etag = Str$(endtag%)
  emon = Str$(endmon%)
  ejahr = Str$(endjahr%)
  altersberechnung
  anzeige
Return

>Procedure minussekunden
  If seku# - unterschiedsec% >= 0
    For i% = 1 To unterschiedsec%
      endsec% = endsec% - 1
      esec = Str$(endsec%)
      seku# = seku# - 1
      If endsec% = -1
        endsec% = 59
        endmin% = endmin% - 1
        minu# = minu# - 1
        If endmin% = -1
          endmin% = 59
          endh% = endh% - 1
          stu% = stu% - 1
          If endh% = -1
            endh% = 23
            eh = "23"
            normaltag% = normaltag% - 1
            If endjahr% = 1582 And endmon% = 10 And endtag% = 15
              endtag% = 5
            EndIf
            If endtag% > 1
              endtag% = endtag% - 1
            Else
              Select endmon%
              Case 1
                endtag% = 31
                endmon% = 12
                emon = Str$(endmon%)
                If endjahr% > 1 Or endjahr% < 0
                  endjahr% = endjahr% - 1
                Else
                  endjahr% = -1
                EndIf
                ejahr = Str$(endjahr%)
              Case 2, 4, 6, 8, 9, 11
                endtag% = 31
                endmon% = endmon% - 1
              Case 3
                endmon% = 2
                If endjahr% > 0
                  If endjahr% Mod 4 = 0
                    If endjahr% Mod 100 = 0 And endjahr% Mod 400 <> 0 And endjahr% > 1582
                      endtag% = 28
                    Else
                      endtag% = 29
                    EndIf
                  Else
                    endtag% = 28
                  EndIf
                Else If endjahr% < 0
                  If (endjahr% + 1) Mod 4 = 0
                    endtag% = 29
                  Else
                    endtag% = 28
                  EndIf
                EndIf
              Case 5, 7, 10, 12
                endtag% = 30
                endmon% = endmon% - 1
              EndSelect
            EndIf
          EndIf
        EndIf
      EndIf
      If endsec% = anfsec%
        minu# = Fix(seku# / 60)
        minut = Str$(minu#)
        minut.Text = Format$(Str$(minu#), "#,###,###,###")
        If endmin% = anfmin%
          stu% = Fix(seku# / 3600)
          stunde = Str$(stu%)
          stunde.Text = Format$(Str$(stu%), "##,###,###")
          If endh% = anfh%
            tag = Str$(Fix(seku# / 86400))
            tag.Text = Format$(Str$(Fix(seku# / 86400)), "#,###,###")
          EndIf
        EndIf
      EndIf
    Next i%
    esec = Str$(endsec%)
    emin = Str$(endmin%)
    eh = Str$(endh%)
    etag = Str$(endtag%)
    emon = Str$(endmon%)
    ejahr = Str$(endjahr%)
    altersberechnung
    anzeige
  Else
    Alert 4 , "   Das Ende kann nicht vor dem Beginn liegen!   ", 1, "OK" , a%
    Do
      Sleep
    Loop Until Me Is Nothing
  EndIf
Return

>Procedure spalte_1_an
  atag.Enabled = 1
  amon.Enabled = 1
  ajahr.Enabled = 1
  ah.Enabled = 1
  amin.Enabled = 1
  asec.Enabled = 1
