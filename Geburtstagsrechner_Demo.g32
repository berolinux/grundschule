  emin = amin
  endmin% = anfmin%
  esec = asec
  endsec% = anfsec%
  löschen
  If endjahr% <> 0
    emon.SetFocus
  Else
    Alert 4 , "   Bitte zuerst das Jahr eingeben.   ", 1, "OK" , a%
    ejahr.SetFocus
  EndIf
  Do
