  Loop Until Me Is Nothing
Return

>Sub emon_Change
  endmon% = Val(emon)
Return

>Sub atag_GotFocus
  atag = ""
  awochtag = ""
  If anfjahr% = 0 Or anfmon% = 0
    Alert 4 , "   Bitte zuerst Jahr und Monat eingeben.   ", 1, "OK" , a%
    Do
      Sleep
    Loop Until Me Is Nothing
    If anfjahr% = 0
      ajahr.SetFocus
      Do
        Sleep
      Loop Until Me Is Nothing
    Else
      amon.SetFocus
    EndIf
  Else
    atag.SetFocus
    Do
      Sleep
    Loop Until Me Is Nothing
  EndIf
  Do
    Sleep
  Loop Until Me Is Nothing
Return

>Sub atag_KeyPress(Ascii&)
  abfrage(Ascii&)
  If atag <> "" And (anftag% < 1 Or anftag% > 31)
    Alert 4 , "   Diesen Tag gibt es nicht.   ", 1, "OK" , a%
    atag = ""
    atag.SetFocus
    Do
      Sleep
    Loop Until Me Is Nothing
  Else If anfjahr% = 1582 And anfmon% = 10 And anftag% > 4 And anftag% < 15
    Alert 4 , "   Im Jahr 1582 wurde der Kalender reformiert.10 Tage fielen aus:   |   Auf den 4.10.1582 folgte sofort der 15.10.1582.   ", 1, "OK" , a%
    atag = ""
    atag.SetFocus
    Do
      Sleep
    Loop Until Me Is Nothing
  Else If (anfmon% = 4 Or anfmon% = 6 Or anfmon% = 9 Or anfmon% = 11) And anftag% = 31
    Alert 4 , "   Diesen Tag gibt es nicht.   ", 1, "OK" , a%
    atag = ""
    atag.SetFocus
    Do
      Sleep
    Loop Until Me Is Nothing
  Else If anfmon% = 2 And anftag% > 29
    Alert 4 , "   Diesen Tag gibt es nicht.   ", 1, "OK" , a%
    atag = ""
    atag.SetFocus
    Do
      Sleep
    Loop Until Me Is Nothing
  Else If anfmon% = 2 And anftag% = 29
    If anfjahr% > 0
      If anfjahr% Mod 4 = 0
        If anfjahr% Mod 100 = 0 And anfjahr% Mod 400 <> 0 And anfjahr% > 1582
          Alert 4 , "   Diesen Tag gibt es nicht. Das Jahr " + ajahr + " ist kein Schaltjahr.   ", 1, "OK" , a%
          atag = ""
          atag.SetFocus
          Do
            Sleep
          Loop Until Me Is Nothing
        EndIf
      Else
        Alert 4 , "   Diesen Tag gibt es nicht. Das Jahr " + ajahr + " ist kein Schaltjahr.   ", 1, "OK" , a%
        atag = ""
        atag.SetFocus
        Do
          Sleep
        Loop Until Me Is Nothing
      EndIf
    Else If anfjahr% < 0
      If (anfjahr% + 1) Mod 4 <> 0
        Alert 4 , "   Diesen Tag gibt es nicht. Das Jahr " + ajahr + " ist kein Schaltjahr.   ", 1, "OK" , a%
        atag = ""
        atag.SetFocus
        Do
          Sleep
        Loop Until Me Is Nothing
      EndIf
    EndIf
  EndIf
  If Ascii& = 13 And anftag% <> 0 And anfmon% <> 0 And anfjahr% <> 0  ' Return
    wechsel% = 0
    If tjahr% = anfjahr%  And tmon% = anfmon% And ttag% = anftag%
      walter% = 0
      GoTo alter0
    Else If tjahr% < anfjahr% Or (tjahr% = anfjahr% And tmon% < anfmon%) Or (tjahr% = anfjahr% And tmon% = anfmon% And ttag% < anftag%)
      wechsel% = 1
      a% = ttag%
      ttag% = anftag%
      anftag% = a%
      a% = tmon%
      tmon% = anfmon%
      anfmon% = a%
      a% = tjahr%
      tjahr% = anfjahr%
      anfjahr% = a%
    EndIf
    wjahr% = tjahr% - anfjahr%   ' Alter in Jahren zur Wochentagsberechnung
    If tjahr% > 0 And anfjahr% < 0
      wjahr% = wjahr% - 1
    EndIf
    If anfmon% > tmon% Or (anfmon% = tmon% And anftag% > ttag%)
      wjahr% = wjahr% - 1
    EndIf
    wmonat% = wjahr% * 12   ' Alter in Monaten
    If tmon% > anfmon%
      wmonat% = wmonat% + tmon% - anfmon%
    Else
      If tmon% = anfmon% And ttag% < anftag%
        wmonat% = wmonat% + 12
      EndIf
      If tmon% < anfmon%
        wmonat% = wmonat% + 12 - anfmon% + tmon%
      EndIf
    EndIf
    If anftag% > ttag%
      wmonat% = wmonat% - 1
    EndIf
    walter% = 0    ' Alter in Tagen
    j% = anfjahr%
    m% = anfmon%
    If j% < tjahr%
      mm% = 12
    EndIf
    If j% = tjahr%
      mm% = tmon% - 1
    EndIf
    walter% = walter% - anftag%
    While j% <= tjahr%
      If j% <> 0
        While m% <= mm%
          Select m%
          Case 1, 3, 5, 7, 8, 12
            walter% = walter% + 31
          Case 2
            If j% > 0
              If j% Mod 4 = 0
                If j% Mod 100 = 0 And j% Mod 400 <> 0 And j% > 1582
                  walter% = walter% + 28
                Else
                  walter% = walter% + 29
                EndIf
              Else
                walter% = walter% + 28
              EndIf
            Else If j% < 0
              If (j% + 1) Mod 4 = 0
                walter% = walter% + 29
              Else
                walter% = walter% + 28
              EndIf
            EndIf
          Case 4, 6, 9, 11
            walter% = walter% + 30
          Case 10
            If j% = 1582
              walter% = walter% - 10
            EndIf
            walter% = walter% + 31
          EndSelect
          m% = m% + 1
        Wend
      EndIf
      j% = j% + 1
      If j% < tjahr%
        m% = 1
        mm% = 12
      EndIf
      If j% = tjahr%
        m% = 1
        mm% = tmon% - 1
      EndIf
    Wend
    walter% = walter% + ttag%
    If tjahr% = 1582 And tmon% = 10 And ttag% > 14
      walter% = walter% - 10
    EndIf
    If anfjahr% = 1582 And anfmon% = 10 And anftag% > 14
      walter% = walter% + 10
    EndIf
    alter0:
    wochentag% = walter% Mod 7
    wochentag% = wochentag% + 1
    If wechsel% = 0 And wochentag% > 1
      wochentag% = 9 - wochentag%
    EndIf
    If wechsel% = 1
      a% = ttag%
      ttag% = anftag%
      anftag% = a%
      a% = tmon%
      tmon% = anfmon%
      anfmon% = a%
      a% = tjahr%
      tjahr% = anfjahr%
      anfjahr% = a%
      wechsel% = 0
    EndIf
    Select wochentag%
    Case 1
      awochtag = "Montag"
    Case 2
      awochtag = "Dienstag"
    Case 3
      awochtag = "Mittwoch"
    Case 4
      awochtag = "Donnerstag"
    Case 5
      awochtag = "Freitag"
    Case 6
      awochtag = "Samstag"
    Case 7
      awochtag = "Sonntag"
    EndSelect
    ah.SetFocus
  EndIf
Return

>Sub atag_MouseDown(Button&, Shift&, x!, y!)
  atag = ""
  anftag% = 0
  ejahr = ""
  endjahr% = 0
  emon = ""
  endmon% = 0
  etag = ""
  endmon% = 0
  löschen
  If anfjahr% = 0 Or anfmon% = 0
    Alert 4 , "   Bitte zuerst Jahr und Monat eingeben.   ", 1, "OK" , a%
    Do
      Sleep
    Loop Until Me Is Nothing
    If anfjahr% = 0
      ajahr.SetFocus
    Else If anfmon% = 0
      amon.SetFocus
    EndIf
  Else
    atag.SetFocus
  EndIf
  Do
    Sleep
  Loop Until Me Is Nothing
Return

>Sub atag_Change
  anftag% = Val(atag)
Return

>Sub etag_GotFocus
  etag = ""
  ewochtag = ""
  tag = ""
  If endjahr% = 0 Or endmon% = 0
    Alert 4 , "   Bitte zuerst Jahr und Monat eingeben.   ", 1, "OK" , a%
    Do
      Sleep
    Loop Until Me Is Nothing
    If endjahr% = 0
      ejahr.SetFocus
      Do
        Sleep
      Loop Until Me Is Nothing
    Else
      emon.SetFocus
    EndIf
  Else
    etag.SetFocus
  EndIf
  Do
    Sleep
  Loop Until Me Is Nothing
Return

>Sub etag_KeyPress(Ascii&)
  abfrage(Ascii&)
  If etag <> "" And (endtag% < 1 Or endtag% > 31)
    Alert 4 , "   Diesen Tag gibt es nicht.   ", 1, "OK" , a%
    etag = ""
    etag.SetFocus
    Do
      Sleep
    Loop Until Me Is Nothing
  Else If endjahr% = 1582 And endmon% = 10 And endtag% > 4 And endtag% < 15
    Alert 4 , "   Im Jahr 1582 wurde der Kalender reformiert.10 Tage fielen aus:   |   Auf den 4.10.1582 folgte sofort der 15.10.1582.   ", 1, "OK" , a%
    etag = ""
    etag.SetFocus
    Do
      Sleep
    Loop Until Me Is Nothing
  Else If (endmon% = 4 Or endmon% = 6 Or endmon% = 9 Or endmon% = 11) And endtag% = 31
    Alert 4 , "   Diesen Tag gibt es nicht.   ", 1, "OK" , a%
    etag = ""
    etag.SetFocus
    Do
      Sleep
    Loop Until Me Is Nothing
  Else If endmon% = 2 And endtag% > 29
    Alert 4 , "   Diesen Tag gibt es nicht.   ", 1, "OK" , a%
    etag = ""
    etag.SetFocus
    Do
      Sleep
    Loop Until Me Is Nothing
  Else If endmon% = 2 And endtag% = 29
    If endjahr% > 0
      If endjahr% Mod 4 = 0
        If endjahr% Mod 100 = 0 And endjahr% Mod 400 <> 0 And endjahr% > 1582
          Alert 4 , "   Diesen Tag gibt es nicht. Das Jahr " + ejahr + " ist kein Schaltjahr.   ", 1, "OK" , a%
          endtag% = 0
          etag = ""
          etag.SetFocus
          Do
            Sleep
          Loop Until Me Is Nothing
        EndIf
      Else
        Alert 4 , "   Diesen Tag gibt es nicht. Das Jahr " + ejahr + " ist kein Schaltjahr.   ", 1, "OK" , a%
        etag = ""
        etag.SetFocus
        Do
          Sleep
        Loop Until Me Is Nothing
      EndIf
    Else If endjahr% < 0
      If (endjahr% + 1) Mod 4 <> 0
        Alert 4 , "   Diesen Tag gibt es nicht. Das Jahr " + ejahr + " ist kein Schaltjahr.   ", 1, "OK" , a%
        etag = ""
        etag.SetFocus
        Do
          Sleep
        Loop Until Me Is Nothing
      EndIf
    EndIf
  Else If anfjahr% > endjahr% Or (anfjahr% = endjahr% And anfmon% > endmon%) Or (anfjahr% = endjahr% And anfmon% = endmon% And anftag% > endtag% And Len(etag) >= Len(atag))
    Alert 4 , "   Das Ende kann nicht vor dem Beginn liegen!   ", 1, "OK" , a%
    etag = ""
    etag.SetFocus
    Do
      Sleep
    Loop Until Me Is Nothing
  EndIf
  If anfjahr% <> 0 And anfmon% <> 0 And anftag% <> 0 And endjahr% <> 0 And endmon% <> 0 And endtag% <> 0 And Ascii& = 13  ' Return
    If endtag% >= anftag% And Len(etag) >= Len(atag) Or endmon% > anfmon% Or endjahr% > anfjahr%
      altersberechnung
      If anfh% = endh%
        If anfmin% = endmin%
          If anfsec% = endsec%
            '        seku# = Fix(alter% * 86400)
          Else If anfsec% > endsec%
            '        seku# = Fix(alter% * 86400) + (endh% - anfh%) * 3600 + (endmin% - anfmin%) * 60 + endsec% - anfsec%
          Else   ' anfsec% < endsec%
            seku# = Fix(alter% * 86400) + (endh% - anfh%) * 3600 + (endmin% - anfmin%) * 60 + endsec% - anfsec%
          EndIf
        Else   ' anfmin% > endmin%
          If anfsec% = endsec%
            '       seku# = Fix(alter% * 86400) + (endh% - anfh%) * 3600 + (endmin% - anfmin%) * 60 + endsec% - anfsec%
          Else If anfsec% > endsec%
            '        seku# = Fix(alter% * 86400) + (endh% - anfh%) * 3600 + (endmin% - anfmin%) * 60 + endsec% - anfsec%
          Else   ' anfsec% < endsec%
            '        seku# = Fix(alter% * 86400) + (endh% - anfh%) * 3600 + (endmin% - anfmin%) * 60 + endsec% - anfsec%
          EndIf
        EndIf
      Else If anfh% > endh%
        If anfmin% = endmin%
          If anfsec% = endsec%
            '       seku# = Fix(alter% * 86400) + (endh% - anfh%) * 3600 + (endmin% - anfmin%) * 60 + endsec% - anfsec%
          Else If anfsec% > endsec%
            '       seku# = Fix(alter% * 86400) + (endh% - anfh%) * 3600 + (endmin% - anfmin%) * 60 + endsec% - anfsec%
          Else   ' anfsec% < endsec%
            '       seku# = Fix(alter% * 86400) + (endh% - anfh%) * 3600 + (endmin% - anfmin%) * 60 + endsec% - anfsec%
          EndIf
        Else   ' anfmin% > endmin%
          If anfsec% = endsec%
            '       seku# = Fix(alter% * 86400) + (endh% - anfh%) * 3600 + (endmin% - anfmin%) * 60 + endsec% - anfsec%
          Else If anfsec% > endsec%
            '       seku# = Fix(alter% * 86400) + (endh% - anfh%) * 3600 + (endmin% - anfmin%) * 60 + endsec% - anfsec%
          Else   ' anfsec% < endsec%
            '       seku# = Fix(alter% * 86400) + (endh% - anfh%) * 3600 + (endmin% - anfmin%) * 60 + endsec% - anfsec%
          EndIf
        EndIf
      Else   ' anfh% < endh%
        If anfmin% = endmin%
          If anfsec% = endsec%
            '       seku# = Fix(alter% * 86400) + (endh% - anfh%) * 3600 + (endmin% - anfmin%) * 60 + endsec% - anfsec%
          Else If anfsec% > endsec%
            '       seku# = Fix(alter% * 86400) + (endh% - anfh%) * 3600 + (endmin% - anfmin%) * 60 + endsec% - anfsec%
          Else   ' anfsec% < endsec%
            '        seku# = Fix(alter% * 86400) + (endh% - anfh%) * 3600 + (endmin% - anfmin%) * 60 + endsec% - anfsec%
          EndIf
        Else   ' anfmin% > endmin%
          If anfsec% = endsec%
            '       seku# = Fix(alter% * 86400) + (endh% - anfh%) * 3600 + (endmin% - anfmin%) * 60 + endsec% - anfsec%
          Else If anfsec% > endsec%
            '       seku# = Fix(alter% * 86400) + (endh% - anfh%) * 3600 + (endmin% - anfmin%) * 60 + endsec% - anfsec%
          Else   ' anfsec% < endsec%
            '       seku# = Fix(alter% * 86400) + (endh% - anfh%) * 3600 + (endmin% - anfmin%) * 60 + endsec% - anfsec%
          EndIf
        EndIf
      EndIf
      seku# = Fix(alter% * 86400) + (endh% - anfh%) * 3600 + (endmin% - anfmin%) * 60 + endsec% - anfsec%
      sekund = Str$(seku#)
      sekund.Text = Format$(Str$(seku#), "##,###,###,###")
      minu# = Fix(seku# / 60)
      minut = Str$(minu#)
      minut.Text = Format$(Str$(minu#), "#,###,###,###")
      stu% = Fix(seku# / 3600)
      stunde = Str$(stu%)
      stunde.Text = Format$(Str$(stu%), "##,###,###")
      tag = Str$(Fix(seku# / 86400))
      tag.Text = Format$(Str$(Fix(seku# / 86400)), "#,###,###")
      woche = Fix(seku# / 604800)
      woche.Text = Format$(Str$(Fix(seku# / 604800)), "###,###")
      monat = Str$(monat%)
      monat.Text = Format$(Str$(monat%), "##,###")
      jahr = Str$(jahr%)
      jahr.Text = Format$(Str$(jahr%), "#,###")
      ntag = Str$(normaltag%)
      nmon = Str$(normalmonat%)
      njahr = Str$(jahr%)
      minus100tage.Enabled = 1
      minus10tage.Enabled = 1
      minus1tag.Enabled = 1
      minus1h.Enabled = 1
      minus10min.Enabled = 1
      minus1min.Enabled = 1
      minus10sec.Enabled = 1
      minus1sec.Enabled = 1
      plus100tage.Enabled = 1
      plus10tage.Enabled = 1
      plus1tag.Enabled = 1
      plus1h.Enabled = 1
      plus10min.Enabled = 1
      plus1min.Enabled = 1
      plus10sec.Enabled = 1
      plus1sec.Enabled = 1
      dauer.ForeColor = $0000ff
      lbl15.ForeColor = $0000ff
      lbl16.ForeColor = $0000ff
      lbl17.ForeColor = $0000ff
      lbl18.ForeColor = $0000ff
      lbl19.ForeColor = $0000ff
      lbl20.ForeColor = $0000ff
      lbl21.ForeColor = $0000ff
      lbl24.ForeColor = $80000008
      lbl25.ForeColor = $80000008
      lbl26.ForeColor = $80000008
      lbl27.ForeColor = $80000008
      lbl30.ForeColor = $ff0000
      lbl31.ForeColor = $ff0000
      lbl32.ForeColor = $ff0000
      lbl33.ForeColor = $ff0000
      lbl34.ForeColor = $ff0000
      lbl35.ForeColor = $ff0000
      lbl36.ForeColor = $ff0000
      lbl37.ForeColor = $ff0000
    EndIf
  Else
    löschen
  EndIf
Return

>Sub etag_MouseDown(Button&, Shift&, x!, y!)
  ejahr.ReadOnly = 0
  emon.ReadOnly = 0
  etag.ReadOnly = 0
  etag = ""
  endtag% = 0
  eh = ah
  endh% = anfh%
  emin = amin
  endmin% = anfmin%
  esec = asec
  endsec% = anfsec%
  löschen
  If endjahr% = 0 Or endmon% = 0
    Alert 4 , "   Bitte zuerst Jahr und Monat eingeben.   ", 1, "OK" , a%
    Do
      Sleep
    Loop Until Me Is Nothing
    If endjahr% = 0
      ejahr.SetFocus
    Else If endmon% = 0
      emon.SetFocus
    EndIf
  Else
    etag.SetFocus
  EndIf
Return

>Sub etag_Change
  endtag% = Val(etag)
Return

>Sub ah_KeyPress(Ascii&)
  abfrage(Ascii&)
  If ah <> "" And anfh% < 0 Or anfh% > 23
    Alert 4 , "   Falsche Eingabe!   ", 1, "OK" , a%
    ah = ""
    anfh% = 0
    ah.SetFocus
    Do
      Sleep
    Loop Until Me Is Nothing
  Else If Ascii& = 13
    amin.SetFocus
  EndIf
Return

>Sub ah_Change
  anfh% = Val(ah)
  eh = ah
  endh% = Val(eh)
Return

>Sub amin_KeyPress(Ascii&)
  abfrage(Ascii&)
  If amin <> "" And anfmin% < 0 Or anfmin% > 60
    Alert 4 , "   Falsche Eingabe!   ", 1, "OK" , a%
    amin = ""
    anfmin% = 0
    amin.SetFocus
    Do
      Sleep
    Loop Until Me Is Nothing
  Else If Ascii& = 13
    asec.SetFocus
  EndIf
Return

>Sub amin_Change
  anfmin% = Val(amin)
  emin = amin
  endmin% = Val(emin)
Return

>Sub asec_KeyPress(Ascii&)
  abfrage(Ascii&)
  If asec <> "" And anfsec% < 0 Or anfsec% > 60
    Alert 4 , "   Falsche Eingabe!   ", 1, "OK" , a%
    asec = ""
    anfsec% = 0
    asec.SetFocus
    Do
      Sleep
    Loop Until Me Is Nothing
  Else If Ascii& = 13
    spalte_2_an
    ejahr.SetFocus
    spalte_1_aus
  EndIf
Return

>Sub asec_Change
  anfsec% = Val(asec)
  esec = asec
  endsec% = Val(esec)
Return


>Sub sekund_Change
  If tag <> ""
    minu# = Fix(seku# / 60)
    minut = Str$(minu#)
    minut.Text = Format$(Str$(minu#), "#,###,###,###")
    stu% = Fix(seku# / 3600)
    stunde = Str$(stu%)
    stunde.Text = Format$(Str$(stu%), "##,###,###")
    tag = Str$(Fix(seku# / 86400))
    tag.Text = Format$(Str$(Fix(seku# / 86400)), "#,###,###")
    woche = Fix(seku# / 604800)
    woche.Text = Format$(Str$(Fix(seku# / 604800)), "###,###")
    monat = Str$(monat%)
    monat.Text = Format$(Str$(monat%), "##,###")
    jahr = Str$(jahr%)
    jahr.Text = Format$(Str$(jahr%), "#,###")
    ntag = Str$(normaltag%)
    nmon = Str$(normalmonat%)
    njahr = Str$(jahr%)
  EndIf
Return

>Sub Drucken_Click
  Alert 2, "   Was soll gedruckt werden?   ", 1, "Bild|Text|nichts", a%
  If a% = 1
    Geburtstagsrechner.PrintForm
  Else If a% = 2
    drucken
  EndIf
Return

>Sub Neu_Click
  awochtag = ""
  spalte_1_an
  spalte_2_aus
  ajahr.SetFocus
  ejahr.ReadOnly = 0
  emon.ReadOnly = 0
  etag.ReadOnly = 0
  löschen
  anfh% = 0
  ah = "0"
  anfmin% = 0
  amin = "0"
  anfsec% = 0
  asec = "0"
  endh% = 0
  eh = "0"
  endmin% = 0
  emin = "0"
  endsec% = 0
  esec = "0"
Return

>Sub löschen
  ewochtag = ""
  njahr = ""
  jahr% = 0
  nmon = ""
  normalmonat% = 0
  ntag = ""
  normaltag% = 0
  jahr = ""
  monat = ""
  monat% = 0
  woche = ""
  tag = ""
  alter% = 0
  stunde = ""
  stu% = 0
  minut = ""
  minu# = 0
  sekund = ""
  seku# = 0
Return

>Sub Beenden_Click
  Alert 2, "   Wirklich beenden?   ", 1, "ja|nein", a%
  If a% = 1
    PostMessage Hinweise.hWnd, WM_CLOSE, 0, 0
    PostMessage Geburtstagsrechner.hWnd, WM_CLOSE, 0, 0
  EndIf
  Repeat
    Sleep
  Until Me Is Nothing
Return

