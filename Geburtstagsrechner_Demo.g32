>Sub Hilfe_Click
  Geburtstagsrechner.Hide
  Hinweise.Show
  lbl22.Text = "Auf welchen Wochentag fällt mein Geburtstag oder ein beliebiger Termin zwischen 5000 v. Chr. und 2201 n. Chr.?"
  lbl23.Text = "1. Klick auf 'Neu'"
  lbl29.Text = "2. Eingabe des Geburtsjahres (Jahres) – Return – Eingabe des Monats (nur Zahl ohne Punkt!) – Return – Eingabe des Tages (nur Zahl!) – Return"
  lbl38.Text = "Wie alt bin ich an einem bestimmten Tag? – Wie lange dauert eine Zeitspanne?"
  lbl39.Text = "1. Eingabe des Geburtsdatums (des Beginns) wie oben. Die zusätzliche Eingabe der genauen Uhrzeit ist möglich. Bitte jedes Feld mit 'Return' verlassen,"
  lbl40.Text = "auch die Felder der Uhrzeit, wenn sie ohne Veränderung übernommen werden sollen."
  lbl41.Text = "2. Eingabe des Enddatums in gleicher Weise. Die Uhrzeit des Geburtsdatums wird automatisch übernommen und kann zunächst nicht verändert werden."
  lbl42.Text = "3. Nach dem Abschluss mit 'Return' berechnet das Programm das Alter in Jahren, Monaten, Wochen, Tagen, Stunden, Minuten und Sekunden."
  lbl43.Text = "Wie kann ich jetzt besondere Geburtstage finden?"
  lbl44.Text = "Nach diesen Eingaben werden die Tasten '+' und '–' in der rechten Spalte aktiv. Mit ihnen kann das Enddatum so lange verändert werden, bis in einer Spalte"
  lbl45.Text = "eine runde Zahl erscheint. Nach einigen Versuchen wird schnell deutlich, welcher Wert sich bald zu einer interessanten Zahl verändern lässt."
  lbl46.Text = "Wie kann ich das Ergebnis ausdrucken?"
  lbl47.Text = "Klick auf die Taste 'Drucken', dann  Auswahl von 'Text' für eine Urkunde oder Wahl von 'Bild' für den Ausdruck des Programmfensters."
  lbl48.Text = "Beispiele:"
  lbl49.Text = "Für jedes Lebensjahr gibt es interessante 'Geburtstage', mit 6 Jahren z. B. 60.000 Stunden, mit 7 Jahren 4.000.000 Minuten, mit 9 Jahren 500 Wochen, mit"
  lbl50.Text = "18 Jahren 6666 Tage, mit 19 Jahren 10.000.000 Minuten, mit 39 Jahren 1.234.567.890 Sekunden, mit 54 Jahren 20.000 Tage, mit 83 Jahren 1000 Monate."
  lbl51.Text = "Wichtiger Hinweis:"
  lbl52.Text = "Jeder Mensch ist ein Jahr lang z. B. 40 Jahre alt, er ist eine Woche lang 1000 Wochen alt. Gefeiert wird nur am ersten Tag – vielleicht auch in der ersten Se-"
  lbl53.Text = "kunde – dieses 'Jubläums'. Deshalb muss das Alter durch Minus-Tasten so weit verringert werden, bis man durch '+ 1 Sekunde' das Jubiläum wieder erreicht."
  lbl54.Text = "Schaltsekunden:"
  lbl55.Text = "Seit 1972 wurde zu Jahresbeginn oder in der Jahresmitte 22-mal eine Schaltsekunde eingefügt, um unsere Zeit mit der Erdumdrehung in Einklang zu halten."
  lbl56.Text = "Diese Sekunden berücksichtigt das Programm nicht, weil sie zwischen die normalen Sekunden als 61-ste Sekunde einer Stunde eingefügt werden."
  lbl57.Text = "Wer einen dieser Termine erlebt, ist also eigentlich eine Sekunde älter als berechnet. Die Jahre, in denen Schaltsekunden eingefügt wurden:"
  lbl58.Text = "alle von 1972 bis 1983, 1985, 1988, alle von 1990 bis 1994, 1996, 1997, 1999 (Stand Mitte 2005)"
  lbl59.Text = "Dieses Programm wurde mit GFA-Basic erstellt von Rudolf Rosenkränzer, 54456 Tawern, Tel. 06501/180202 "
Return

>Sub Schließen_Click
  Hinweise.Hide
  Geburtstagsrechner.Show
Return

>Sub Hilfedruck_Click
  Local seitenh&, zeilenh&, seite&, stelle&, schriftdr%, schriftdr1%, ja$, mo$, ta$
  Output = Printer
  Printer.Orientation = 2 ' Querformat
  Printer.StartDoc "Geburtstag"
  Printer.StartPage
  seitenh& = GetDevCaps(VERTRES)
  zeilenh& = 12 * seitenh& / 640
  Font "arial", CharSet ANSI_CHARSET, Family FF_DONTCARE, Weight 400, Width zeilenh& * 0.4, Height zeilenh& * 0.9, To schriftdr%
  Font "arial", CharSet ANSI_CHARSET, Family FF_DONTCARE, Weight 600, Width zeilenh& * 0.5, Height zeilenh& * 1.2, To schriftdr1%
  SetFont schriftdr1%
  seite& = zeilenh& * 4   'Abstand vom oberen Seitenrand
  Text zeilenh& * 3, seite&,  "Auf welchen Wochentag fällt mein Geburtstag oder ein beliebiger Termin zwischen 5000 v. Chr. und 2201 n. Chr.?"
  Add seite&, zeilenh& * 1.9
  SetFont schriftdr%
  Text zeilenh& * 5, seite&, "1. Klick auf 'Neu'"
  Add seite&, zeilenh& * 1.5
  Text zeilenh& * 5, seite&, "2. Eingabe des Geburtsjahres (Jahres) – Return – Eingabe des Monats (nur Zahl ohne Punkt!) – Return – Eingabe des Tages (nur Zahl!) – Return"
  Add seite&, zeilenh& * 2.4
  SetFont schriftdr1%
  Text zeilenh& * 3, seite&, "Wie alt bin ich an einem bestimmten Tag? – Wie lange dauert eine Zeitspanne?"
  Add seite&, zeilenh& * 1.9
  SetFont schriftdr%
  Text zeilenh& * 5, seite&, "1. Eingabe des Geburtsdatums (des Beginns) wie oben. Die zusätzliche Eingabe der genauen Uhrzeit ist möglich. Bitte jedes Feld mit 'Return' verlassen,"
  Add seite&, zeilenh& * 1.2
  Text zeilenh& * 7, seite&,  "auch die Felder der Uhrzeit, wenn sie ohne Veränderung übernommen werden sollen."
  Add seite&, zeilenh& * 1.5
  Text zeilenh& * 5, seite&, "2. Eingabe des Enddatums in gleicher Weise. Die Uhrzeit des Geburtsdatums wird automatisch übernommen und kann zunächst nicht verändert werden."
  Add seite&, zeilenh& * 1.5
  Text zeilenh& * 5, seite&,  "3. Nach dem Abschluss mit 'Return' berechnet das Programm das Alter in Jahren, Monaten, Wochen, Tagen, Stunden, Minuten und Sekunden."
  Add seite&, zeilenh& * 2.4
  SetFont schriftdr1%
  Text zeilenh& * 3, seite&, "Wie kann ich jetzt besondere Geburtstage finden?"
  SetFont schriftdr%
  Add seite&, zeilenh& * 1.9
  Text zeilenh& * 5, seite&, "Nach diesen Eingaben werden die Tasten '+' und '–' in der rechten Spalte aktiv. Mit ihnen kann das Enddatum so lange verändert werden, bis in einer Spalte"
  Add seite&, zeilenh& * 1.2
  Text zeilenh& * 7, seite&, "eine runde Zahl erscheint. Nach einigen Versuchen wird schnell deutlich, welcher Wert sich bald zu einer interessanten Zahl verändern lässt."
  Add seite&, zeilenh& * 2.4
  SetFont schriftdr1%
  Text zeilenh& * 3, seite&, "Wie kann ich das Ergebnis ausdrucken?"
  SetFont schriftdr%
  Add seite&, zeilenh& * 1.9
  Text zeilenh& * 5, seite&, "Klick auf die Taste 'Drucken', dann  Auswahl von 'Text' für eine Urkunde oder Wahl von 'Bild' für den Ausdruck des Programmfensters."
  Add seite&, zeilenh& * 2.4
  SetFont schriftdr1%
  Text zeilenh& * 3, seite&, "Beispiele:"
  SetFont schriftdr%
  Add seite&, zeilenh& * 1.9
  Text zeilenh& * 5, seite&, "Für jedes Lebensjahr gibt es interessante 'Geburtstage', mit 6 Jahren z. B. 60.000 Stunden, mit 7 Jahren 4.000.000 Minuten, mit 9 Jahren 500 Wochen, mit"
  Add seite&, zeilenh& * 1.2
  Text zeilenh& * 7, seite&,  "18 Jahren 6666 Tage, mit 19 Jahren 10.000.000 Minuten, mit 39 Jahren 1.234.567.890 Sekunden, mit 54 Jahren 20.000 Tage, mit 83 Jahren 1000 Monate."
  Add seite&, zeilenh& * 2.4
  SetFont schriftdr1%
  Text zeilenh& * 3, seite&, "Wichtiger Hinweis:"
  SetFont schriftdr%
  Add seite&, zeilenh& * 1.9
  Text zeilenh& * 5, seite&, "Jeder Mensch ist ein Jahr lang z. B. 40 Jahre alt, er ist eine Woche lang 1000 Wochen alt. Gefeiert wird nur am ersten Tag – vielleicht auch in der ersten"
  Add seite&, zeilenh& * 1.2
  Text zeilenh& * 7, seite&, "Sekunde – dieses 'Jubläums'. Deshalb muss das Alter durch Minus-Tasten so weit verringert werden, bis man durch '+ 1 Sekunde' das Jubiläum wieder erreicht."
  Add seite&, zeilenh& * 2.4
  SetFont schriftdr1%
  Text zeilenh& * 3, seite&, "Schaltsekunden:"
  SetFont schriftdr%
  Add seite&, zeilenh& * 1.9
  Text zeilenh& * 5, seite&, "Seit 1972 wurde zu Jahresbeginn oder in der Jahresmitte 22-mal eine Schaltsekunde eingefügt, um unsere Zeit mit der Erdumdrehung in Einklang zu halten."
  Add seite&, zeilenh& * 1.2
  Text zeilenh& * 7, seite&,  "Diese Sekunden berücksichtigt das Programm nicht, weil sie zwischen die normalen Sekunden als 61-ste Sekunde einer Stunde eingefügt werden."
  Add seite&, zeilenh& * 1.5
  Text zeilenh& * 5, seite&, "Wer einen dieser Termine erlebt, ist also eigentlich eine Sekunde älter als berechnet. Die Jahre, in denen Schaltsekunden eingefügt wurden:"
  Add seite&, zeilenh& * 1.2
  Text zeilenh& * 7, seite&,  "alle von 1972 bis 1983, 1985, 1988, alle von 1990 bis 1994, 1996, 1997, 1999 (Stand Mitte 2005)"
  Add seite&, zeilenh& * 1.9
  Text zeilenh& * 3, seite&, "Dieses Programm wurde mit GFA-Basic erstellt von Rudolf Rosenkränzer, 54456 Tawern, Tel. 06501/180202 "
  Printer.EndDoc
  FreeFont schriftdr%
  FreeFont schriftdr1%
  Output = Me
  Repeat
    Sleep
  Until Me Is Nothing
Return
