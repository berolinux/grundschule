Return

>Procedure drucken
  Local seitenh&, zeilenh&, seite&, stelle&, schriftdr%, schriftdr1%, ja$, mo$, ta$
  Output = Printer
  Printer.Orientation = 1 ' Hochformat
  Printer.StartDoc "Geburtstag"
  Printer.StartPage
  seitenh& = GetDevCaps(VERTRES)
  zeilenh& = 12 * seitenh& / 640
  Font "times new roman", CharSet ANSI_CHARSET, Family FF_DONTCARE, Weight 600, Width zeilenh& * 0.4, Height zeilenh&, To schriftdr%
  Font "times new roman", CharSet ANSI_CHARSET, Family FF_DONTCARE, Weight 800, Width zeilenh& * 0.7, Height zeilenh& * 1.7, To schriftdr1%
  SetFont schriftdr1%
  seite& = zeilenh& * 4   'Abstand vom oberen Seitenrand
  Text zeilenh& * 3, seite&, "Urkunde"
  Add seite&, zeilenh& * 4
  SetFont schriftdr%
  Text zeilenh& * 3, seite&, "für " + bezeichnung + ","
  Add seite&, zeilenh& * 1.6
  Text zeilenh& * 3, seite&, "geboren am " + awochtag + ", " + atag + ". " + amon + ". " + ajahr + ", um " + ah + " Uhr, " + amin + " Minuten und " + asec + " Sekunden:"
  Add seite&, zeilenh& * 3
  Text zeilenh& * 3, seite&, "Alter am " + ewochtag + ", " + etag + ". " + emon + ". " + ejahr + ", um " + eh + " Uhr, " + emin + " Minuten und " + esec + " Sekunden:"
  Add seite&, zeilenh& * 2.3
  If Val(njahr) = 1
    ja$ = " Jahr, "
  Else
    ja$ = " Jahre, "
  EndIf
  If Val(nmon) = 1
    mo$ = " Monat und "
  Else
    mo$ = " Monate und "
  EndIf
  If Val(ntag) = 1
    ta$ = " Tag "
  Else
    ta$ = " Tage "
  EndIf
  Text zeilenh& * 6, seite&, njahr + ja$ + nmon + mo$ + ntag + ta$
  Add seite&, zeilenh& * 2.3
  Text zeilenh& * 6, seite&, " Das sind:"
  If Val(jahr) = 1
    Text zeilenh& * 20 - TxtLen(jahr), seite&,  jahr + "  Jahr"
  Else
    Text zeilenh& * 20 - TxtLen(jahr), seite&,  jahr + "  Jahre"
  EndIf
  Add seite&, zeilenh& * 1.6
  Text zeilenh& * 8, seite&, "oder"
  If Val(monat) = 1
    Text zeilenh& * 20 - TxtLen(monat), seite&,  monat + "  Monat"
  Else
    Text zeilenh& * 20 - TxtLen(monat), seite&,  monat + "  Monate"
  EndIf
  Add seite&, zeilenh& * 1.6
  Text zeilenh& * 8, seite&, "oder"
  If Val(woche) = 1
    Text zeilenh& * 20 - TxtLen(woche), seite&,  woche + "  Woche"
  Else
    Text zeilenh& * 20 - TxtLen(woche), seite&,  woche + "  Wochen"
  EndIf
  Add seite&, zeilenh& * 1.6
  Text zeilenh& * 8, seite&, "oder"
  If Val(tag) = 1
    Text zeilenh& * 20 - TxtLen(tag), seite&, tag + "  Tag"
  Else
    Text zeilenh& * 20 - TxtLen(tag), seite&, tag + "  Tage"
  EndIf
  Add seite&, zeilenh& * 1.6
  Text zeilenh& * 8, seite&, "oder"
  If Val(stunde) = 1
    Text zeilenh& * 20 - TxtLen(stunde), seite&,  stunde + "  Stunde"
  Else
    Text zeilenh& * 20 - TxtLen(stunde), seite&,  stunde + "  Stunden"
  EndIf
  Add seite&, zeilenh& * 1.6
  Text zeilenh& * 8, seite&, "oder"
  If Val(minut) = 1
    Text zeilenh& * 20 - TxtLen(minut), seite&,  minut + "  Minute"
  Else
    Text zeilenh& * 20 - TxtLen(minut), seite&,  minut + "  Minuten"
  EndIf
  Add seite&, zeilenh& * 1.6
  Text zeilenh& * 8, seite&, "oder"
  If Val(sekund) = 1
    Text zeilenh& * 20 - TxtLen(sekund), seite&,  sekund + "  Sekunde"
  Else
    Text zeilenh& * 20 - TxtLen(sekund), seite&,  sekund + "  Sekunden"
  EndIf
  Printer.EndPage
  Printer.EndDoc
  FreeFont schriftdr%
  FreeFont schriftdr1%
  Output = Me
  Repeat
    Sleep
  Until Me Is Nothing
Return

>Procedure abfrage(ByRef Ascii&) ' Variable wird selbst übergeben und geändert, nicht nur der Wert
  If (Ascii& < Asc("0") Or Ascii& > Asc("9")) And Ascii& <> 8 And Ascii& <> 13 And Ascii& <> 46 And Ascii& <> 45 ' nur Zahlen, Backspace, Return, Entfernen, Bindestrich, Minus
    Ascii& = 0
    Do
      Sleep
    Loop Until Me Is Nothing
  EndIf
Return

>Sub ajahr_GotFocus
  ajahr = ""
  amon = ""
  atag = ""
  awochtag = ""
  ejahr = ""
  emon = ""
  etag = ""
  anfh% = 0
  ah = "0"
  anfmin% = 0
  amin = "0"
  anfsec% = 0
  asec = "0"
  endh% = 0
  eh = "0"
  endmin% = 0
  emin = "0"
  endsec% = 0
  esec = "0"
  löschen
Return

>Sub ajahr_KeyPress(Ascii&)
  abfrage(Ascii&)
  If ajahr <> "" And (anfjahr% < 2004 Or anfjahr% > 2201) And Len(ajahr) = 4
    Alert 4 , "   In der Demoversion können nur Jahre von 2004 bis 2201 eingegeben werden!|   Die Originalversion reicht von 5000 v. Chr. bis 2201.   ", 1, "OK" , a%
    ajahr = ""
    ajahr.SetFocus
    Do
      Sleep
    Loop Until Me Is Nothing
  Else If ajahr <> "" And (anfjahr% < -5000 Or anfjahr% > 2201)
    Alert 4 , "   Bitte nur Jahre von -5000 bis 2201 eingeben!   ", 1, "OK" , a%
    ajahr = ""
    ajahr.SetFocus
    Do
      Sleep
    Loop Until Me Is Nothing
  Else If ajahr = "0"
    Alert 4 , "   Das Jahr 0 hat es nie gegeben. Auf das Jahr 1 v. Chr. folgte das Jahr 1 n. Chr.   ", 1, "OK" , a%
    ajahr = ""
    ajahr.SetFocus
    Do
      Sleep
    Loop Until Me Is Nothing
  EndIf
  If Ascii& = 13 And ajahr <> ""  ' Return
    amon.SetFocus
  EndIf
Return

