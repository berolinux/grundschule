Return

>Sub emon_KeyPress(Ascii&)
  abfrage(Ascii&)
  If emon <> "" And (endmon% < 1 Or endmon% > 12)
    Alert 4 , "   Bitte nur die Nummer des Monats eingeben: eine Zahl von 1 bis 12 ohne Punkt.   ", 1, "OK" , a%
    emon = ""
    endmon% = 0
    emon.SetFocus
    Do
      Sleep
    Loop Until Me Is Nothing
  Else If anfjahr% > endjahr% Or (anfjahr% = endjahr% And anfmon% > endmon% And Len(emon) = Len(amon))
    Alert 4 , "   Das Ende kann nicht vor dem Beginn liegen!   ", 1, "OK" , a%
    emon = ""
    endmon% = 0
    emon.SetFocus
    Do
      Sleep
    Loop Until Me Is Nothing
  Else If Ascii& = 13 And emon <> ""  ' Return
    etag.SetFocus
  EndIf
Return

>Sub emon_MouseDown(Button&, Shift&, x!, y!)
  ejahr.ReadOnly = 0
  emon.ReadOnly = 0
  etag.ReadOnly = 0
  emon = ""
  endmon% = 0
  etag = ""
  endtag% = 0
  eh = ah
