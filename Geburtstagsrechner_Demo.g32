>Sub ejahr_KeyPress(Ascii&)
  abfrage(Ascii&)
  If ejahr <> "" And (endjahr% < -5000 Or endjahr% > 2201)
    Alert 4 , "Bitte nur Jahre von -5000 bis 2201 eingeben!", 1, "OK" , a%
    ejahr = ""
    ejahr.SetFocus
    Do
      Sleep
    Loop Until Me Is Nothing
  Else If ejahr = "0"
    Alert 4 , "   Das Jahr 0 hat es nie gegeben. Auf das Jahr 1 v. Chr. folgte das Jahr 1 n. Chr.   ", 1, "OK" , a%
    ejahr = ""
    ejahr.SetFocus
    Do
      Sleep
    Loop Until Me Is Nothing
  EndIf
  If Ascii& = 13 And endjahr% <> 0  ' Return
    If anfjahr% > endjahr% And Len(ejahr) = Len(ajahr)
      Alert 4 , "   Das Ende kann nicht vor dem Beginn liegen!   ", 1, "OK" , a%
      ejahr = ""
      ejahr.SetFocus
      Do
        Sleep
      Loop Until Me Is Nothing
    Else
      emon.SetFocus
    EndIf
  EndIf
Return

